# Keep Entropy and source diffs stable across platforms.
# Line-ending normalization must not turn a checkout into thousands of changes.
Codespace/Cosmeron/** text eol=lf

# GitHub Linguist language overrides: mark C source and header files explicitly as C
*.c linguist-language=C
*.h linguist-language=C
*.inc linguist-language=C
*.impl linguist-language=C
*.space linguist-language=C
