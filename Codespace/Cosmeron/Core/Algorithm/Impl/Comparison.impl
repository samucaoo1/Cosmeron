#pragma once

#define COMPARISON_TYPED_IMPLEMENT(TYPE, SUFFIX)                               \
  COMPARISON_TYPED_PROTOTYPE(TYPE, SUFFIX) {                                   \
    return left < right                                                        \
               ? COMPARISON_CONST(LOWER)                                       \
               : (left > right ? COMPARISON_CONST(HIGHER)                      \
                               : COMPARISON_CONST(EQUAL));                      \
  }

#define COMPARISON_STRING_IMPLEMENT(TYPE, SUFFIX, FUNCTION)                    \
  COMPARISON_STRING_PROTOTYPE(TYPE, SUFFIX) {                                  \
    int result = FUNCTION(left, right);                                         \
    return result < 0                                                          \
               ? COMPARISON_CONST(LOWER)                                       \
               : (result > 0 ? COMPARISON_CONST(HIGHER)                        \
                             : COMPARISON_CONST(EQUAL));                        \
  }

COMPARISON_BYTES_PROTOTYPE {
  size_t minimumSize = leftSize < rightSize ? leftSize : rightSize;
  int result = memcmp(left, right, minimumSize);

  if (result < 0)
    return COMPARISON_CONST(LOWER);
  if (result > 0)
    return COMPARISON_CONST(HIGHER);
  if (leftSize < rightSize)
    return COMPARISON_CONST(LOWER);
  if (leftSize > rightSize)
    return COMPARISON_CONST(HIGHER);

  return COMPARISON_CONST(EQUAL);
}

COMPARISON_INVOKE_PROTOTYPE {
  return comparator(left, right);
}

COMPARISON_TYPED_IMPLEMENT(int, int)
COMPARISON_TYPED_IMPLEMENT(float, float)
COMPARISON_TYPED_IMPLEMENT(double, double)
COMPARISON_TYPED_IMPLEMENT(long double, LongDouble)
COMPARISON_STRING_IMPLEMENT(const char *, CString, strcmp)

#undef COMPARISON_TYPED_IMPLEMENT
#undef COMPARISON_STRING_IMPLEMENT
/* EOF */
