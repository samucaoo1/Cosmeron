#pragma once

#include <string.h>

#define COMPARISON_PRIMITIVE_IMPLEMENT(ROW)                                    \
  FUNCTION(CMPOUT, PRIMITIVE_TYPE_GET(NAME, ROW),                              \
           (PRIMITIVE_TYPE_GET(TYPE, ROW) left,                                \
            PRIMITIVE_TYPE_GET(TYPE, ROW) right), {                            \
    bool leftNan = (left != left);                                             \
    bool rightNan = (right != right);                                          \
    if (leftNan || rightNan) {                                                 \
      if (leftNan && rightNan)                                                 \
        return COMPARISON_CONST(EQUAL);                                        \
      return leftNan ? COMPARISON_CONST(HIGHER) : COMPARISON_CONST(LOWER);     \
    }                                                                          \
    return left < right                                                        \
               ? COMPARISON_CONST(LOWER)                                       \
               : (left > right ? COMPARISON_CONST(HIGHER)                      \
                               : COMPARISON_CONST(EQUAL));                     \
  }),

#define COMPARISON_COMPLEX_IMPL(NAME_VAL, COMPLEX_TYPE, REAL_TYPE)             \
  FUNCTION(CMPOUT, NAME_VAL, (COMPLEX_TYPE left, COMPLEX_TYPE right), {        \
    union {                                                                    \
      COMPLEX_TYPE value;                                                      \
      REAL_TYPE parts[2];                                                      \
    } lhs = {.value = left}, rhs = {.value = right};                           \
    for (size_t i = 0U; i < 2U; ++i) {                                         \
      bool leftNan = (lhs.parts[i] != lhs.parts[i]);                           \
      bool rightNan = (rhs.parts[i] != rhs.parts[i]);                         \
      if (leftNan || rightNan) {                                               \
        if (leftNan && rightNan)                                               \
          continue;                                                            \
        return leftNan ? COMPARISON_CONST(HIGHER) : COMPARISON_CONST(LOWER);   \
      }                                                                        \
      if (lhs.parts[i] < rhs.parts[i])                                         \
        return COMPARISON_CONST(LOWER);                                        \
      if (lhs.parts[i] > rhs.parts[i])                                         \
        return COMPARISON_CONST(HIGHER);                                       \
    }                                                                          \
    return COMPARISON_CONST(EQUAL);                                            \
  }),

#if !COMPILER_MSVC
#define COMPARISON_COMPLEX_IMPLEMENT_ALL()                                     \
  COMPARISON_COMPLEX_IMPL(FloatComplex, float _Complex, float)                 \
  COMPARISON_COMPLEX_IMPL(DoubleComplex, double _Complex, double)              \
  COMPARISON_COMPLEX_IMPL(LongDoubleComplex, long double _Complex, long double)
#else
#define COMPARISON_COMPLEX_IMPLEMENT_ALL()
#endif

MODULE_IMPLEMENT(DOMAIN(Core), Algorithm,
  PACKAGE(Comparison,
    PRIMITIVE_TYPE_TABLE_ORDERED(COMPARISON_PRIMITIVE_IMPLEMENT)
    COMPARISON_COMPLEX_IMPLEMENT_ALL()
    FUNCTION(CMPOUT, CString, (const char *left, const char *right), {
      if (left == right)
        return COMPARISON_CONST(EQUAL);
      if (!left)
        return COMPARISON_CONST(LOWER);
      if (!right)
        return COMPARISON_CONST(HIGHER);
      int result = strcmp(left, right);
      return result < 0                                                        \
                 ? COMPARISON_CONST(LOWER)                                     \
                 : (result > 0 ? COMPARISON_CONST(HIGHER)                      \
                               : COMPARISON_CONST(EQUAL));                     \
    }),

    FUNCTION(CMPOUT, Bytes,
             (const void *left, size_t leftSize,
              const void *right, size_t rightSize), {
      if (left == right && leftSize == rightSize)
        return COMPARISON_CONST(EQUAL);
      if (!left && !right)
        return leftSize < rightSize ? COMPARISON_CONST(LOWER)                  \
                                    : (leftSize > rightSize                    \
                                           ? COMPARISON_CONST(HIGHER)          \
                                           : COMPARISON_CONST(EQUAL));         \
      if (!left)
        return COMPARISON_CONST(LOWER);
      if (!right)
        return COMPARISON_CONST(HIGHER);

      size_t minimumSize = leftSize < rightSize ? leftSize : rightSize;
      int result = minimumSize > 0U ? memcmp(left, right, minimumSize) : 0;

      if (result < 0)
        return COMPARISON_CONST(LOWER);
      if (result > 0)
        return COMPARISON_CONST(HIGHER);
      if (leftSize < rightSize)
        return COMPARISON_CONST(LOWER);
      if (leftSize > rightSize)
        return COMPARISON_CONST(HIGHER);

      return COMPARISON_CONST(EQUAL);
    })
  )
);

#undef COMPARISON_PRIMITIVE_IMPLEMENT
#undef COMPARISON_COMPLEX_IMPL
#undef COMPARISON_COMPLEX_IMPLEMENT_ALL

/* EOF */
