#pragma once

#include <string.h>

#define ALGORITHM_COMPARISON_INTERNAL_COL_NAME(NAME, VALUE) NAME
#define ALGORITHM_COMPARISON_INTERNAL_COL_VALUE(NAME, VALUE) VALUE
#define ALGORITHM_COMPARISON_INTERNAL_GET(FIELD, ROW)                          \
  PP_OP_CAT2(ALGORITHM_COMPARISON_INTERNAL_COL_, FIELD) ROW

#define ALGORITHM_COMPARISON_INTERNAL_TABLE(X) X((COMPLEX_PART_COUNT, 2U))

IENUM_DEF(Algorithm_Comparison, Config, ALGORITHM_COMPARISON_INTERNAL_TABLE)

#define COSMERON_MACRO_INTERNAL_COMPARISON_PRIMITIVE_IMPL(ROW)                 \
  FUNCTION(CMPOUT, PRIMITIVE_TYPE_GET(NAME, ROW),                              \
           (PRIMITIVE_TYPE_GET(C_TYPE, ROW) left,                                \
            PRIMITIVE_TYPE_GET(C_TYPE, ROW) right), {                            \
    bool leftNan = (left != left);                                             \
    bool rightNan = (right != right);                                          \
    if (leftNan || rightNan) {                                                 \
      if (leftNan && rightNan)                                                 \
        return COMPARISON_CONST(EQUAL);                                        \
      return leftNan ? COMPARISON_CONST(HIGHER) : COMPARISON_CONST(LOWER);     \
    }                                                                          \
    return left < right                                                        \
               ? COMPARISON_CONST(LOWER)                                       \
               : (left > right ? COMPARISON_CONST(HIGHER)                      \
                               : COMPARISON_CONST(EQUAL));                     \
  }),

#define COSMERON_MACRO_INTERNAL_COMPARISON_COMPLEX_IMPL(NAME_VAL, COMPLEX_TYPE, REAL_TYPE) \
  FUNCTION(CMPOUT, NAME_VAL, (COMPLEX_TYPE left, COMPLEX_TYPE right), {        \
    union {                                                                    \
      COMPLEX_TYPE value;                                                      \
      REAL_TYPE parts[CNS(Algorithm, Comparison, Internal, COMPLEX_PART_COUNT)]; \
    } lhs = {.value = left}, rhs = {.value = right};                           \
    for (size_t i = 0U;                                                        \
         i < (size_t)CNS(Algorithm, Comparison, Internal, COMPLEX_PART_COUNT); \
         ++i) {                                                                \
      bool leftNan = (lhs.parts[i] != lhs.parts[i]);                           \
      bool rightNan = (rhs.parts[i] != rhs.parts[i]);                         \
      if (leftNan || rightNan) {                                               \
        if (leftNan && rightNan)                                               \
          continue;                                                            \
        return leftNan ? COMPARISON_CONST(HIGHER) : COMPARISON_CONST(LOWER);   \
      }                                                                        \
      if (lhs.parts[i] < rhs.parts[i])                                         \
        return COMPARISON_CONST(LOWER);                                        \
      if (lhs.parts[i] > rhs.parts[i])                                         \
        return COMPARISON_CONST(HIGHER);                                       \
    }                                                                          \
    return COMPARISON_CONST(EQUAL);                                            \
  }),

#if !COMPILER_MSVC
#define COSMERON_MACRO_INTERNAL_COMPARISON_COMPLEX_ALL()                       \
  COSMERON_MACRO_INTERNAL_COMPARISON_COMPLEX_IMPL(FloatComplex, float _Complex, float) \
  COSMERON_MACRO_INTERNAL_COMPARISON_COMPLEX_IMPL(DoubleComplex, double _Complex, double) \
  COSMERON_MACRO_INTERNAL_COMPARISON_COMPLEX_IMPL(LongDoubleComplex, long double _Complex, long double)
#else
#define COSMERON_MACRO_INTERNAL_COMPARISON_COMPLEX_ALL()
#endif

MODULE_IMPLEMENT(DOMAIN(Core), Algorithm,
  INTERNAL_EX(Comparison,
    FUNCTION(CMPOUT, FromInt, (int value), {
      return value < 0
                 ? COMPARISON_CONST(LOWER)
                 : (value > 0 ? COMPARISON_CONST(HIGHER)
                              : COMPARISON_CONST(EQUAL));
    }),

    FUNCTION(CMPOUT, CompareSize, (size_t left, size_t right), {
      return left < right
                 ? COMPARISON_CONST(LOWER)
                 : (left > right ? COMPARISON_CONST(HIGHER)
                                 : COMPARISON_CONST(EQUAL));
    })
  ),

  PACKAGE(Comparison,
    PRIMITIVE_TYPE_TABLE_ORDERED(COSMERON_MACRO_INTERNAL_COMPARISON_PRIMITIVE_IMPL)
    COSMERON_MACRO_INTERNAL_COMPARISON_COMPLEX_ALL()
    FUNCTION(CMPOUT, CString, (const char *left, const char *right), {
      if (left == right)
        return COMPARISON_CONST(EQUAL);
      if (!left)
        return COMPARISON_CONST(LOWER);
      if (!right)
        return COMPARISON_CONST(HIGHER);
      return MODULE_IFUNC(Algorithm, Comparison, FromInt)(strcmp(left, right));
    }),

    FUNCTION(CMPOUT, Bytes,
             (const void *left, size_t leftSize,
              const void *right, size_t rightSize), {
      if (left == right && leftSize == rightSize)
        return COMPARISON_CONST(EQUAL);
      if (!left && !right)
        return MODULE_IFUNC(Algorithm, Comparison, CompareSize)(leftSize,
                                                                rightSize);
      if (!left)
        return COMPARISON_CONST(LOWER);
      if (!right)
        return COMPARISON_CONST(HIGHER);

      size_t minimumSize = leftSize < rightSize ? leftSize : rightSize;
      int result = minimumSize > 0U ? memcmp(left, right, minimumSize) : 0;

      if (result != 0)
        return MODULE_IFUNC(Algorithm, Comparison, FromInt)(result);

      return MODULE_IFUNC(Algorithm, Comparison, CompareSize)(leftSize,
                                                              rightSize);
    })
  )
);

#undef COSMERON_MACRO_INTERNAL_COMPARISON_PRIMITIVE_IMPL
#undef COSMERON_MACRO_INTERNAL_COMPARISON_COMPLEX_IMPL
#undef COSMERON_MACRO_INTERNAL_COMPARISON_COMPLEX_ALL

/* EOF */
