#pragma once

#include <string.h>

/* ========================================================================== */
/* 1. Primitive Value Repetition Macro                                        */
/* ========================================================================== */

#define COSMERON_MACRO_INTERNAL_REPEAT_FILL_IMPL(NAME_VAL, VAL_TYPE)           \
  OPERATION(NAME_VAL,                                                          \
            (VAL_TYPE * destination, VAL_TYPE value, size_t count), {          \
    if (count == 0U)                                                           \
      return STATUS_CONST(SUCCESS);                                            \
    if (!destination)                                                          \
      return STATUS_CONST(INVALID_ARGUMENT);                                   \
    if (count > SIZE_MAX / sizeof(VAL_TYPE))                                   \
      return STATUS_CONST(ARITHMETIC_OVERFLOW);                                \
    for (size_t i = 0U; i < count; ++i) {                                      \
      destination[i] = value;                                                  \
    }                                                                          \
    return STATUS_CONST(SUCCESS);                                              \
  })

#define COSMERON_MACRO_INTERNAL_REPEAT_PRIMITIVE_IMPL(ROW)                     \
  COSMERON_MACRO_INTERNAL_REPEAT_FILL_IMPL(PRIMITIVE_TYPE_GET(NAME, ROW),      \
                                           PRIMITIVE_TYPE_GET(C_TYPE, ROW)),

/* ========================================================================== */
/* 2. Declarative Implementation: Algorithm_Repeat                            */
/* ========================================================================== */

MODULE_IMPLEMENT(DOMAIN(Core), Algorithm,
  PACKAGE(Repeat,
    VARIANT(Procedure,
      PROCEDURE((size_t count,
                 MODULE_DELEGATE(Algorithm, Repeat, Procedure) action), {
        if (count == 0U || !DELEGATE_IS_VALID(action))
          return;

        for (size_t i = 0U; i < count; ++i) {
          DELEGATE_CALL(action);
        }
      }),
      PROCEDURE(Indexed,
                (size_t count,
                 MODULE_DELEGATE(Algorithm, Repeat, ProcedureIndexed) action), {
        if (count == 0U || !DELEGATE_IS_VALID(action))
          return;

        for (size_t i = 0U; i < count; ++i) {
          DELEGATE_CALL(action, i);
        }
      })
    ),

    VARIANT(Operation,
      OPERATION((size_t count,
                 MODULE_DELEGATE(Algorithm, Repeat, Operation) operation), {
        if (count == 0U)
          return STATUS_CONST(SUCCESS);
        if (!DELEGATE_IS_VALID(operation))
          return STATUS_CONST(INVALID_ARGUMENT);

        for (size_t i = 0U; i < count; ++i) {
          OPSTATUS status = DELEGATE_CALL(operation);
          if (status != STATUS_CONST(SUCCESS))
            return status;
        }

        return STATUS_CONST(SUCCESS);
      }),
      OPERATION(Indexed,
                (size_t count,
                 MODULE_DELEGATE(Algorithm, Repeat, OperationIndexed) operation), {
        if (count == 0U)
          return STATUS_CONST(SUCCESS);
        if (!DELEGATE_IS_VALID(operation))
          return STATUS_CONST(INVALID_ARGUMENT);

        for (size_t i = 0U; i < count; ++i) {
          OPSTATUS status = DELEGATE_CALL(operation, i);
          if (status != STATUS_CONST(SUCCESS))
            return status;
        }

        return STATUS_CONST(SUCCESS);
      })
    ),

    VARIANT(Predicate,
      PREDICATE((size_t count,
                 MODULE_DELEGATE(Algorithm, Repeat, Predicate) predicate), {
        if (count == 0U)
          return true;
        if (!DELEGATE_IS_VALID(predicate))
          return false;

        for (size_t i = 0U; i < count; ++i) {
          if (!DELEGATE_CALL(predicate))
            return false;
        }

        return true;
      }),
      PREDICATE(Indexed,
                (size_t count,
                 MODULE_DELEGATE(Algorithm, Repeat, PredicateIndexed) predicate), {
        if (count == 0U)
          return true;
        if (!DELEGATE_IS_VALID(predicate))
          return false;

        for (size_t i = 0U; i < count; ++i) {
          if (!DELEGATE_CALL(predicate, i))
            return false;
        }

        return true;
      })
    ),

    OPERATION(Bytes,
              (void *destination, const void *pattern,
               size_t patternSize, size_t count), {
      if (count == 0U || patternSize == 0U)
        return STATUS_CONST(SUCCESS);
      if (!destination || !pattern)
        return STATUS_CONST(INVALID_ARGUMENT);
      if (count > SIZE_MAX / patternSize)
        return STATUS_CONST(ARITHMETIC_OVERFLOW);

      {
        size_t totalSize = count * patternSize;
        uintptr_t destAddress = (uintptr_t)destination;
        uintptr_t patternAddress = (uintptr_t)pattern;

        if (totalSize > (size_t)(UINTPTR_MAX - destAddress) ||
            patternSize > (size_t)(UINTPTR_MAX - patternAddress))
          return STATUS_CONST(OUT_OF_RANGE);

        if (destAddress < patternAddress + patternSize &&
            patternAddress < destAddress + totalSize)
          return STATUS_CONST(INVALID_ARGUMENT);
      }

      {
        unsigned char *destBytes = (unsigned char *)destination;
        for (size_t i = 0U; i < count; ++i) {
          memcpy(destBytes + (i * patternSize), pattern, patternSize);
        }
      }

      return STATUS_CONST(SUCCESS);
    }),

    PRIMITIVE_TYPE_TABLE(COSMERON_MACRO_INTERNAL_REPEAT_PRIMITIVE_IMPL)

    COSMERON_MACRO_INTERNAL_REPEAT_FILL_IMPL(CString, const char *)
  )
);

#undef COSMERON_MACRO_INTERNAL_REPEAT_FILL_IMPL
#undef COSMERON_MACRO_INTERNAL_REPEAT_PRIMITIVE_IMPL

/* EOF */
