/* Repeat.def - Dual Mode Engine (Zero Duplication) */

#ifndef TEMPLATE_Algorithm_Repeat
#define TEMPLATE_Algorithm_Repeat(SUFFIX, TYPE)                                 \
  TEMPLATE_PACKAGE(Algorithm, Repeat, SUFFIX,                                   \
      CLOSURE(                                                                 \
          FUNCTION(TYPE, Generator, ()),                                       \
          FUNCTION(TYPE, GeneratorIndexed, (size_t index)),                     \
          FUNCTION(TYPE, IndexedGenerator, (size_t index))),                    \
      OPERATION_INLINE(Fill, (TYPE * destination, TYPE value, size_t count), {  \
          if (count == 0U)                                                      \
            return STATUS_CONST(SUCCESS);                                       \
          if (!destination)                                                     \
            return STATUS_CONST(INVALID_ARGUMENT);                              \
          if (sizeof(TYPE) != 0U && count > SIZE_MAX / sizeof(TYPE))            \
            return STATUS_CONST(ARITHMETIC_OVERFLOW);                           \
          for (size_t i = 0U; i < count; ++i) {                                 \
            destination[i] = value;                                             \
          }                                                                     \
          return STATUS_CONST(SUCCESS);                                         \
      }),                                                                       \
      VARIANT(Generate,                                                         \
          OPERATION_INLINE(                                                     \
              (TYPE * destination, size_t count,                                \
               MODULE_CLOSURE(Algorithm, Repeat, SUFFIX, Generator) generator),\
              {                                                                 \
                if (count == 0U)                                                \
                  return STATUS_CONST(SUCCESS);                                 \
                if (!destination || !CLOSURE_IS_VALID(generator))               \
                  return STATUS_CONST(INVALID_ARGUMENT);                        \
                if (sizeof(TYPE) != 0U && count > SIZE_MAX / sizeof(TYPE))      \
                  return STATUS_CONST(ARITHMETIC_OVERFLOW);                     \
                for (size_t i = 0U; i < count; ++i) {                           \
                  destination[i] = CLOSURE_CALL(generator);                     \
                }                                                               \
                return STATUS_CONST(SUCCESS);                                   \
              }),                                                               \
          OPERATION_INLINE(                                                     \
              Indexed,                                                          \
              (TYPE * destination, size_t count,                                \
               MODULE_CLOSURE(Algorithm, Repeat, SUFFIX, GeneratorIndexed) generator),\
              {                                                                 \
                if (count == 0U)                                                \
                  return STATUS_CONST(SUCCESS);                                 \
                if (!destination || !CLOSURE_IS_VALID(generator))               \
                  return STATUS_CONST(INVALID_ARGUMENT);                        \
                if (sizeof(TYPE) != 0U && count > SIZE_MAX / sizeof(TYPE))      \
                  return STATUS_CONST(ARITHMETIC_OVERFLOW);                     \
                for (size_t i = 0U; i < count; ++i) {                           \
                  destination[i] = CLOSURE_CALL(generator, i);                  \
                }                                                               \
                return STATUS_CONST(SUCCESS);                                   \
              })                                                                \
      )                                                                         \
  )
#define TEMPLATE_Repeat(SUFFIX, TYPE) TEMPLATE_Algorithm_Repeat(SUFFIX, TYPE)
#endif

/* Mode 2 (Direct Include): Auto-instantiates and cleans up environment */
#if defined(SUFFIX) && defined(TYPE)
  TEMPLATE_Algorithm_Repeat(SUFFIX, TYPE);
  #undef SUFFIX
  #undef TYPE
#endif

