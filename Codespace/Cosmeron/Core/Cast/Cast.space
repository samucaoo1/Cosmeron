#pragma once

#include "../Module/Namespace.h"

#define CAST_MOD Cast
#define CAST_CMOD CAST

#define CAST_NS(NAME) NS(LIB_PREFIX(CAST_MOD), NAME)
#define CAST_CNS(NAME) CNS(LIB_PREFIX_CONST(CAST_CMOD), NAME)
#define CAST_INS(NAME) NS(LIB_PREFIX(CAST_MOD), Internal, NAME)
#define CAST_CINS(NAME) CNS(LIB_PREFIX_CONST(CAST_CMOD), INTERNAL, NAME)

#define CAST_TYPE(NAME) CAST_NS(NAME)
#define CAST_FUNC(NAME) CAST_NS(NAME)
#define CAST_CONST(NAME) CAST_CNS(NAME)

#define CAST_TYPE_TO_STRUCT(SUFFIX, TYPE)                                      \
  NS(LIB_PREFIX(CAST_MOD), SUFFIX, To, TYPE)
#define CAST_STRUCT_TO_TYPE(TYPE, SUFFIX)                                      \
  NS(LIB_PREFIX(CAST_MOD), TYPE, To, SUFFIX)
/* EOF */
