#pragma once

#define CAST_UNSIGNED_DOWNCAST_IMPLEMENT(FROM_NAME, TO_NAME, FROM_TYPE, TO_TYPE, TO_MAX) \
  CAST_CONVERT_PROTOTYPE(FROM_NAME, TO_NAME, FROM_TYPE, TO_TYPE) {             \
    if (!outValue)                                                             \
      return STATUS_CONST(INVALID_ARGUMENT);                                   \
    if (inValue > (FROM_TYPE)(TO_MAX))                                         \
      return STATUS_CONST(ARITHMETIC_OVERFLOW);                                \
    *outValue = (TO_TYPE)inValue;                                              \
    return STATUS_CONST(SUCCESS);                                              \
  }

#define CAST_SIGNED_DOWNCAST_IMPLEMENT(FROM_NAME, TO_NAME, FROM_TYPE, TO_TYPE, TO_MIN, TO_MAX) \
  CAST_CONVERT_PROTOTYPE(FROM_NAME, TO_NAME, FROM_TYPE, TO_TYPE) {             \
    if (!outValue)                                                             \
      return STATUS_CONST(INVALID_ARGUMENT);                                   \
    if (inValue < (FROM_TYPE)(TO_MIN) || inValue > (FROM_TYPE)(TO_MAX))       \
      return STATUS_CONST(ARITHMETIC_OVERFLOW);                                \
    *outValue = (TO_TYPE)inValue;                                              \
    return STATUS_CONST(SUCCESS);                                              \
  }

#define CAST_SIGNED_TO_SAME_OR_WIDER_UNSIGNED_IMPLEMENT(FROM_NAME, TO_NAME, FROM_TYPE, TO_TYPE) \
  CAST_CONVERT_PROTOTYPE(FROM_NAME, TO_NAME, FROM_TYPE, TO_TYPE) {             \
    if (!outValue)                                                             \
      return STATUS_CONST(INVALID_ARGUMENT);                                   \
    if (inValue < 0)                                                           \
      return STATUS_CONST(ARITHMETIC_OVERFLOW);                                \
    *outValue = (TO_TYPE)inValue;                                              \
    return STATUS_CONST(SUCCESS);                                              \
  }

#define CAST_SIGNED_TO_NARROWER_UNSIGNED_IMPLEMENT(FROM_NAME, TO_NAME, FROM_TYPE, TO_TYPE, TO_MAX) \
  CAST_CONVERT_PROTOTYPE(FROM_NAME, TO_NAME, FROM_TYPE, TO_TYPE) {             \
    if (!outValue)                                                             \
      return STATUS_CONST(INVALID_ARGUMENT);                                   \
    if (inValue < 0 || (uint64_t)inValue > (uint64_t)(TO_MAX))                 \
      return STATUS_CONST(ARITHMETIC_OVERFLOW);                                \
    *outValue = (TO_TYPE)inValue;                                              \
    return STATUS_CONST(SUCCESS);                                              \
  }

#define CAST_UNSIGNED_TO_WIDER_SIGNED_IMPLEMENT(FROM_NAME, TO_NAME, FROM_TYPE, TO_TYPE) \
  CAST_CONVERT_PROTOTYPE(FROM_NAME, TO_NAME, FROM_TYPE, TO_TYPE) {             \
    if (!outValue)                                                             \
      return STATUS_CONST(INVALID_ARGUMENT);                                   \
    *outValue = (TO_TYPE)inValue;                                              \
    return STATUS_CONST(SUCCESS);                                              \
  }

#define CAST_UNSIGNED_TO_SAME_OR_NARROWER_SIGNED_IMPLEMENT(FROM_NAME, TO_NAME, FROM_TYPE, TO_TYPE, TO_MAX) \
  CAST_CONVERT_PROTOTYPE(FROM_NAME, TO_NAME, FROM_TYPE, TO_TYPE) {             \
    if (!outValue)                                                             \
      return STATUS_CONST(INVALID_ARGUMENT);                                   \
    if ((uint64_t)inValue > (uint64_t)(TO_MAX))                                \
      return STATUS_CONST(ARITHMETIC_OVERFLOW);                                \
    *outValue = (TO_TYPE)inValue;                                              \
    return STATUS_CONST(SUCCESS);                                              \
  }

/* Unsigned downcasts */
CAST_UNSIGNED_DOWNCAST_IMPLEMENT(UInt64, UInt32, uint64_t, uint32_t, UINT32_MAX)
CAST_UNSIGNED_DOWNCAST_IMPLEMENT(UInt64, UInt16, uint64_t, uint16_t, UINT16_MAX)
CAST_UNSIGNED_DOWNCAST_IMPLEMENT(UInt64, UInt8, uint64_t, uint8_t, UINT8_MAX)
CAST_UNSIGNED_DOWNCAST_IMPLEMENT(UInt32, UInt16, uint32_t, uint16_t, UINT16_MAX)
CAST_UNSIGNED_DOWNCAST_IMPLEMENT(UInt32, UInt8, uint32_t, uint8_t, UINT8_MAX)
CAST_UNSIGNED_DOWNCAST_IMPLEMENT(UInt16, UInt8, uint16_t, uint8_t, UINT8_MAX)

/* Signed downcasts */
CAST_SIGNED_DOWNCAST_IMPLEMENT(Int64, Int32, int64_t, int32_t, INT32_MIN, INT32_MAX)
CAST_SIGNED_DOWNCAST_IMPLEMENT(Int64, Int16, int64_t, int16_t, INT16_MIN, INT16_MAX)
CAST_SIGNED_DOWNCAST_IMPLEMENT(Int64, Int8, int64_t, int8_t, INT8_MIN, INT8_MAX)
CAST_SIGNED_DOWNCAST_IMPLEMENT(Int32, Int16, int32_t, int16_t, INT16_MIN, INT16_MAX)
CAST_SIGNED_DOWNCAST_IMPLEMENT(Int32, Int8, int32_t, int8_t, INT8_MIN, INT8_MAX)
CAST_SIGNED_DOWNCAST_IMPLEMENT(Int16, Int8, int16_t, int8_t, INT8_MIN, INT8_MAX)

/* Signed to unsigned conversions */
CAST_SIGNED_TO_SAME_OR_WIDER_UNSIGNED_IMPLEMENT(Int64, UInt64, int64_t, uint64_t)
CAST_SIGNED_TO_NARROWER_UNSIGNED_IMPLEMENT(Int64, UInt32, int64_t, uint32_t, UINT32_MAX)
CAST_SIGNED_TO_NARROWER_UNSIGNED_IMPLEMENT(Int64, UInt16, int64_t, uint16_t, UINT16_MAX)
CAST_SIGNED_TO_NARROWER_UNSIGNED_IMPLEMENT(Int64, UInt8, int64_t, uint8_t, UINT8_MAX)

CAST_SIGNED_TO_SAME_OR_WIDER_UNSIGNED_IMPLEMENT(Int32, UInt64, int32_t, uint64_t)
CAST_SIGNED_TO_SAME_OR_WIDER_UNSIGNED_IMPLEMENT(Int32, UInt32, int32_t, uint32_t)
CAST_SIGNED_TO_NARROWER_UNSIGNED_IMPLEMENT(Int32, UInt16, int32_t, uint16_t, UINT16_MAX)
CAST_SIGNED_TO_NARROWER_UNSIGNED_IMPLEMENT(Int32, UInt8, int32_t, uint8_t, UINT8_MAX)

CAST_SIGNED_TO_SAME_OR_WIDER_UNSIGNED_IMPLEMENT(Int16, UInt64, int16_t, uint64_t)
CAST_SIGNED_TO_SAME_OR_WIDER_UNSIGNED_IMPLEMENT(Int16, UInt32, int16_t, uint32_t)
CAST_SIGNED_TO_SAME_OR_WIDER_UNSIGNED_IMPLEMENT(Int16, UInt16, int16_t, uint16_t)
CAST_SIGNED_TO_NARROWER_UNSIGNED_IMPLEMENT(Int16, UInt8, int16_t, uint8_t, UINT8_MAX)

CAST_SIGNED_TO_SAME_OR_WIDER_UNSIGNED_IMPLEMENT(Int8, UInt64, int8_t, uint64_t)
CAST_SIGNED_TO_SAME_OR_WIDER_UNSIGNED_IMPLEMENT(Int8, UInt32, int8_t, uint32_t)
CAST_SIGNED_TO_SAME_OR_WIDER_UNSIGNED_IMPLEMENT(Int8, UInt16, int8_t, uint16_t)
CAST_SIGNED_TO_SAME_OR_WIDER_UNSIGNED_IMPLEMENT(Int8, UInt8, int8_t, uint8_t)

/* Unsigned to signed conversions */
CAST_UNSIGNED_TO_SAME_OR_NARROWER_SIGNED_IMPLEMENT(UInt64, Int64, uint64_t, int64_t, INT64_MAX)
CAST_UNSIGNED_TO_SAME_OR_NARROWER_SIGNED_IMPLEMENT(UInt64, Int32, uint64_t, int32_t, INT32_MAX)
CAST_UNSIGNED_TO_SAME_OR_NARROWER_SIGNED_IMPLEMENT(UInt64, Int16, uint64_t, int16_t, INT16_MAX)
CAST_UNSIGNED_TO_SAME_OR_NARROWER_SIGNED_IMPLEMENT(UInt64, Int8, uint64_t, int8_t, INT8_MAX)

CAST_UNSIGNED_TO_WIDER_SIGNED_IMPLEMENT(UInt32, Int64, uint32_t, int64_t)
CAST_UNSIGNED_TO_SAME_OR_NARROWER_SIGNED_IMPLEMENT(UInt32, Int32, uint32_t, int32_t, INT32_MAX)
CAST_UNSIGNED_TO_SAME_OR_NARROWER_SIGNED_IMPLEMENT(UInt32, Int16, uint32_t, int16_t, INT16_MAX)
CAST_UNSIGNED_TO_SAME_OR_NARROWER_SIGNED_IMPLEMENT(UInt32, Int8, uint32_t, int8_t, INT8_MAX)

CAST_UNSIGNED_TO_WIDER_SIGNED_IMPLEMENT(UInt16, Int64, uint16_t, int64_t)
CAST_UNSIGNED_TO_WIDER_SIGNED_IMPLEMENT(UInt16, Int32, uint16_t, int32_t)
CAST_UNSIGNED_TO_SAME_OR_NARROWER_SIGNED_IMPLEMENT(UInt16, Int16, uint16_t, int16_t, INT16_MAX)
CAST_UNSIGNED_TO_SAME_OR_NARROWER_SIGNED_IMPLEMENT(UInt16, Int8, uint16_t, int8_t, INT8_MAX)

CAST_UNSIGNED_TO_WIDER_SIGNED_IMPLEMENT(UInt8, Int64, uint8_t, int64_t)
CAST_UNSIGNED_TO_WIDER_SIGNED_IMPLEMENT(UInt8, Int32, uint8_t, int32_t)
CAST_UNSIGNED_TO_WIDER_SIGNED_IMPLEMENT(UInt8, Int16, uint8_t, int16_t)
CAST_UNSIGNED_TO_SAME_OR_NARROWER_SIGNED_IMPLEMENT(UInt8, Int8, uint8_t, int8_t, INT8_MAX)

/* Size conversions */
CAST_CONVERT_PROTOTYPE(Size, UInt64, size_t, uint64_t) {
  if (!outValue)
    return STATUS_CONST(INVALID_ARGUMENT);
#if SIZE_MAX > UINT64_MAX
  if (inValue > UINT64_MAX)
    return STATUS_CONST(ARITHMETIC_OVERFLOW);
#endif
  *outValue = (uint64_t)inValue;
  return STATUS_CONST(SUCCESS);
}

CAST_CONVERT_PROTOTYPE(Size, UInt32, size_t, uint32_t) {
  if (!outValue)
    return STATUS_CONST(INVALID_ARGUMENT);
  if (inValue > (size_t)UINT32_MAX)
    return STATUS_CONST(ARITHMETIC_OVERFLOW);
  *outValue = (uint32_t)inValue;
  return STATUS_CONST(SUCCESS);
}

CAST_CONVERT_PROTOTYPE(Size, UInt16, size_t, uint16_t) {
  if (!outValue)
    return STATUS_CONST(INVALID_ARGUMENT);
  if (inValue > (size_t)UINT16_MAX)
    return STATUS_CONST(ARITHMETIC_OVERFLOW);
  *outValue = (uint16_t)inValue;
  return STATUS_CONST(SUCCESS);
}

CAST_CONVERT_PROTOTYPE(Size, UInt8, size_t, uint8_t) {
  if (!outValue)
    return STATUS_CONST(INVALID_ARGUMENT);
  if (inValue > (size_t)UINT8_MAX)
    return STATUS_CONST(ARITHMETIC_OVERFLOW);
  *outValue = (uint8_t)inValue;
  return STATUS_CONST(SUCCESS);
}

CAST_CONVERT_PROTOTYPE(Size, Int64, size_t, int64_t) {
  if (!outValue)
    return STATUS_CONST(INVALID_ARGUMENT);
  if ((uint64_t)inValue > (uint64_t)INT64_MAX)
    return STATUS_CONST(ARITHMETIC_OVERFLOW);
  *outValue = (int64_t)inValue;
  return STATUS_CONST(SUCCESS);
}

CAST_CONVERT_PROTOTYPE(Size, Int32, size_t, int32_t) {
  if (!outValue)
    return STATUS_CONST(INVALID_ARGUMENT);
  if ((uint64_t)inValue > (uint64_t)INT32_MAX)
    return STATUS_CONST(ARITHMETIC_OVERFLOW);
  *outValue = (int32_t)inValue;
  return STATUS_CONST(SUCCESS);
}

CAST_CONVERT_PROTOTYPE(UInt64, Size, uint64_t, size_t) {
  if (!outValue)
    return STATUS_CONST(INVALID_ARGUMENT);
  if (inValue > (uint64_t)SIZE_MAX)
    return STATUS_CONST(ARITHMETIC_OVERFLOW);
  *outValue = (size_t)inValue;
  return STATUS_CONST(SUCCESS);
}

CAST_CONVERT_PROTOTYPE(Int64, Size, int64_t, size_t) {
  if (!outValue)
    return STATUS_CONST(INVALID_ARGUMENT);
  if (inValue < 0)
    return STATUS_CONST(ARITHMETIC_OVERFLOW);
  if ((uint64_t)inValue > (uint64_t)SIZE_MAX)
    return STATUS_CONST(ARITHMETIC_OVERFLOW);
  *outValue = (size_t)inValue;
  return STATUS_CONST(SUCCESS);
}

CAST_CONVERT_PROTOTYPE(Int32, Size, int32_t, size_t) {
  if (!outValue)
    return STATUS_CONST(INVALID_ARGUMENT);
  if (inValue < 0)
    return STATUS_CONST(ARITHMETIC_OVERFLOW);
  if ((uint64_t)inValue > (uint64_t)SIZE_MAX)
    return STATUS_CONST(ARITHMETIC_OVERFLOW);
  *outValue = (size_t)inValue;
  return STATUS_CONST(SUCCESS);
}
/* EOF */
