#pragma once

#include "../Namespace.h"
#include "../Outcome/Status.h"
#include "../Diagnostic/Context.h"
#include "../Diagnostic/Stacktrace.h"
#include "../Preprocessor/Compiling.inc"
#include "../Preprocessor/Operations.h"

#define CONDITION_MOD Condition
#define CONDITION_CMOD CONDITION

#define CONDITION_NS(NAME) GNS2(LIB_PREFIX(CONDITION_MOD), NAME)
#define CONDITION_CNS(NAME) CNS2(LIB_PREFIX_CONST(CONDITION_CMOD), NAME)
#define CONDITION_INS(NAME) GNS3(LIB_PREFIX(CONDITION_MOD), Internal, NAME)
#define CONDITION_CINS(NAME) CNS3(LIB_PREFIX_CONST(CONDITION_CMOD), INTERNAL, NAME)

#define CONDITION_TYPE(SUFFIX) PP_OP_CAT3(T, CONDITION_MOD, SUFFIX)
#define CONDITION_FUNC(NAME) CONDITION_NS(NAME)
#define CONDITION_CONST(NAME) CONDITION_CNS(NAME)

#define ERROR_MOD Error
#define ERROR_CMOD ERROR

#define ERROR_NS(NAME) GNS3(LIB_PREFIX(CONDITION_MOD), Error, NAME)
#define ERROR_CNS(NAME) CNS3(LIB_PREFIX_CONST(CONDITION_CMOD), ERROR, NAME)
#define ERROR_INS(NAME) GNS4(LIB_PREFIX(CONDITION_MOD), Error, Internal, NAME)
#define ERROR_CINS(NAME) CNS4(LIB_PREFIX_CONST(CONDITION_CMOD), ERROR, INTERNAL, NAME)

#define ERROR_TYPE(NAME) PP_OP_CAT2(T, NAME)
#define ERROR_FUNC(NAME) GNS2(ERROR_TYPE(Error), NAME)
#define ERROR_CONST(NAME) ERROR_CNS(NAME)

#define ERROR_CONFIG_COL_NAME(NAME, VALUE) NAME
#define ERROR_CONFIG_COL_VALUE(NAME, VALUE) VALUE
#define ERROR_CONFIG_GET(FIELD, ROW)                                           \
  PP_OP_CAT2(ERROR_CONFIG_COL_, FIELD) ROW

#define ERROR_CONFIG_TABLE(X)                                                  \
  X((MAX_CHAIN_DEPTH, 16))

enum ERROR_CNS(Config) {
#define ERROR_CONFIG_ENUM_ITEM(ROW)                                            \
  ERROR_CONST(ERROR_CONFIG_GET(NAME, ROW)) = ERROR_CONFIG_GET(VALUE, ROW),
  ERROR_CONFIG_TABLE(ERROR_CONFIG_ENUM_ITEM)
#undef ERROR_CONFIG_ENUM_ITEM
};
/* EOF */

