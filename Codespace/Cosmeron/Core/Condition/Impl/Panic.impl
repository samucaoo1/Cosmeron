#pragma once

#include <stdio.h>
#include <stdlib.h>

#define CONDITION_PANIC_INTERNAL_COL_NAME(NAME, VALUE) NAME
#define CONDITION_PANIC_INTERNAL_COL_VALUE(NAME, VALUE) VALUE
#define CONDITION_PANIC_INTERNAL_GET(FIELD, ROW)                               \
  PP_OP_CAT2(CONDITION_PANIC_INTERNAL_COL_, FIELD) ROW

#define CONDITION_PANIC_INTERNAL_TABLE(X)                                      \
  X((STACKTRACE_SKIP_FRAMES, 1U))                                              \
  X((STACKTRACE_MAX_FRAMES, 16U))                                              \
  X((STACKTRACE_BUFFER_SIZE, 1024U))

IENUM_DEF(Condition_Panic, Config, CONDITION_PANIC_INTERNAL_TABLE)

#define COSMERON_MACRO_INTERNAL_PANIC_KIND_CASE(ROW)                           \
  case MODULE_CONST(Condition, PANIC_KIND_GET(NAME, ROW)):                     \
    return PP_OP_STRING(PANIC_KIND_GET(NAME, ROW));

static _Thread_local MODULE_DELEGATE(Condition, Panic, Handler)
    MODULE_IFUNC(Condition, Panic_CustomHandler) = DELEGATE_EMPTY;

MODULE_IMPLEMENT(DOMAIN(Core), Condition,
  PACKAGE(Panic,
    FUNCTION(const char *, KindName, (MODULE_ENUM(Condition, PanicKind) kind), {
      switch (kind) {
      PANIC_KIND_TABLE(COSMERON_MACRO_INTERNAL_PANIC_KIND_CASE)
      default:
        return "PANIC";
      }
    }),

    PROCEDURE(SetHandler,
              (MODULE_DELEGATE(Condition, Panic, Handler) handler), {
      MODULE_IFUNC(Condition, Panic_CustomHandler) = handler;
    }),

    PROCEDURE(ResetHandler, (), {
      MODULE_IFUNC(Condition, Panic_CustomHandler).function = NULL;
      MODULE_IFUNC(Condition, Panic_CustomHandler).context = NULL;
    }),

    FUNCTION(MODULE_DELEGATE(Condition, Panic, Handler), GetHandler, (), {
      return MODULE_IFUNC(Condition, Panic_CustomHandler);
    }),

    PROCEDURE(Trigger,
              (MODULE_ENUM(Condition, PanicKind) kind, const char *message,
               const char *expression, const char *file, uint32_t line,
               const char *function), {
      MODULE_TYPE(Condition, Panic_Info) info;
      info.kind = kind;
      info.message = message;
      info.expression = expression;
      info.file = file;
      info.line = line;
      info.function = function;

      if (DELEGATE_IS_VALID(MODULE_IFUNC(Condition, Panic_CustomHandler))) {
        DELEGATE_CALL(MODULE_IFUNC(Condition, Panic_CustomHandler), &info);
        return;
      }

      fprintf(stderr, "\n*** PANIC [%s] ***\n",
              MODULE_FUNC(Condition, Panic, KindName)(kind));
      fprintf(stderr, "Message:  %s\n", info.message ? info.message : "<none>");
      if (info.expression != NULL) {
        fprintf(stderr, "Expr:     %s\n", info.expression);
      }
      fprintf(stderr, "Location: %s:%u (in %s)\n",
              info.file ? info.file : "<unknown>", info.line,
              info.function ? info.function : "<unknown>");

      MODULE_TYPE(Diagnostic, Stacktrace) st;
      MODULE_FUNC(Diagnostic, Stacktrace, Init)(&st);
      if (OBJECT_CALL(&st, Capture,
                      CNS(Condition, Panic, Internal, STACKTRACE_SKIP_FRAMES),
                      CNS(Condition, Panic, Internal, STACKTRACE_MAX_FRAMES)) ==
              STATUS_CONST(SUCCESS) &&
          OBJECT_CALL_0(&st, FrameCount) > 0U) {
        char stBuffer[CNS(Condition, Panic, Internal, STACKTRACE_BUFFER_SIZE)];
        size_t written = 0U;
        if (OBJECT_CALL(&st, Format, stBuffer, sizeof(stBuffer), &written) ==
            STATUS_CONST(SUCCESS)) {
          fprintf(stderr, "Stacktrace:\n%s\n", stBuffer);
        }
      }

      fflush(stderr);
      abort();
    }),

    PROCEDURE(Now, (const char *message), {
      PANIC(message);
    })
  )
);

#undef COSMERON_MACRO_INTERNAL_PANIC_KIND_CASE

/* EOF */

