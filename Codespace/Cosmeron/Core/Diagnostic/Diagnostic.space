#pragma once

#include "../Namespace.h"
#include "../Outcome/Status.h"
#include "../Preprocessor/Compiling.inc"
#include "../Preprocessor/Operations.h"

#define DIAGNOSTIC_MOD Diagnostic
#define DIAGNOSTIC_CMOD DIAGNOSTIC

#define DIAGNOSTIC_NS(NAME) GNS2(LIB_PREFIX(DIAGNOSTIC_MOD), NAME)
#define DIAGNOSTIC_CNS(NAME) CNS2(LIB_PREFIX_CONST(DIAGNOSTIC_CMOD), NAME)
#define DIAGNOSTIC_INS(NAME) GNS3(LIB_PREFIX(DIAGNOSTIC_MOD), Internal, NAME)
#define DIAGNOSTIC_CINS(NAME) CNS3(LIB_PREFIX_CONST(DIAGNOSTIC_CMOD), INTERNAL, NAME)

#define DIAGNOSTIC_TYPE(SUFFIX) PP_OP_CAT3(T, DIAGNOSTIC_MOD, SUFFIX)
#define DIAGNOSTIC_FUNC(NAME) DIAGNOSTIC_NS(NAME)
#define DIAGNOSTIC_CONST(NAME) DIAGNOSTIC_CNS(NAME)
