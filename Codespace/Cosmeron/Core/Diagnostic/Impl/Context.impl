#pragma once

MODULE_IMPLEMENT(DOMAIN(Core), Diagnostic,
  OBJECT(Context,
    OPERATION(Create,
              (const char *file, uint32_t line,
               const char *function, const char *description,
               const void *userData), {
      if (!self)
        return STATUS_CONST(INVALID_ARGUMENT);
      MODULE_FUNC(Diagnostic, Context, Init)(self);
      self->file = file;
      self->line = line;
      self->function = function;
      self->description = description;
      self->userData = userData;
      return STATUS_CONST(SUCCESS);
    }),

    PROCEDURE(Clear, (), {
      if (!self)
        return;
      self->file = NULL;
      self->line = 0U;
      self->function = NULL;
      self->description = NULL;
      self->userData = NULL;
    })
  )
);

/* EOF */
