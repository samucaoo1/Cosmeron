#pragma once

#include "../Common.inc"
#include "../../Preprocessor/Detect.h"

#if OS_WINDOWS
  #define WIN32_LEAN_AND_MEAN
  #include <windows.h>
#elif (OS_LINUX && LIBC_GLIBC) || OS_MAC || OS_BSD
  #include <execinfo.h>
#endif

#if OS_WINDOWS
static inline size_t MODULE_IFUNC(Diagnostic, Stacktrace_CaptureRaw)(
    void **frames, size_t limit, size_t skipFrames) {
  void *tempFrames[MODULE_CONST(Diagnostic, Stacktrace, MAX_FRAMES) + 16U];
  DWORD toCapture = (DWORD)(limit + skipFrames + 1U);
  if (toCapture > (DWORD)(sizeof(tempFrames) / sizeof(tempFrames[0])))
    toCapture = (DWORD)(sizeof(tempFrames) / sizeof(tempFrames[0]));
  USHORT captured = CaptureStackBackTrace(
      (DWORD)(skipFrames + 1U), (DWORD)limit, frames, NULL);
  return (size_t)captured;
}
#elif (OS_LINUX && LIBC_GLIBC) || OS_MAC || OS_BSD
static inline size_t MODULE_IFUNC(Diagnostic, Stacktrace_CaptureRaw)(
    void **frames, size_t limit, size_t skipFrames) {
  void *tempFrames[MODULE_CONST(Diagnostic, Stacktrace, MAX_FRAMES) + 16U];
  size_t totalToCapture = limit + skipFrames + 1U;
  if (totalToCapture > sizeof(tempFrames) / sizeof(tempFrames[0]))
    totalToCapture = sizeof(tempFrames) / sizeof(tempFrames[0]);
  int captured = backtrace(tempFrames, (int)totalToCapture);
  if (captured <= 0)
    return 0U;

  size_t startIndex = skipFrames + 1U;
  size_t outIdx = 0U;
  for (size_t i = startIndex; i < (size_t)captured && outIdx < limit; ++i)
    frames[outIdx++] = tempFrames[i];
  return outIdx;
}
#else
static inline size_t MODULE_IFUNC(Diagnostic, Stacktrace_CaptureRaw)(
    void **frames, size_t limit, size_t skipFrames) {
  (void)frames;
  (void)limit;
  (void)skipFrames;
  return 0U;
}
#endif

MODULE_IMPLEMENT(DOMAIN(Core), Diagnostic,
  OBJECT(Stacktrace,
    OPERATION(Capture, (size_t skipFrames, size_t maxFrames), {
      if (!self)
        return STATUS_CONST(INVALID_ARGUMENT);

      self->frameCount = 0U;
      size_t limit = MODULE_CONST(Diagnostic, Stacktrace, MAX_FRAMES);
      if (maxFrames > 0U && maxFrames < limit)
        limit = maxFrames;

      for (size_t i = 0U; i < MODULE_CONST(Diagnostic, Stacktrace, MAX_FRAMES); ++i)
        self->frames[i] = NULL;

      self->frameCount = MODULE_IFUNC(Diagnostic, Stacktrace_CaptureRaw)(
          self->frames, limit, skipFrames);
      return STATUS_CONST(SUCCESS);
    }),

    PROCEDURE(Clear, (), {
      if (!self)
        return;
      for (size_t i = 0U; i < MODULE_CONST(Diagnostic, Stacktrace, MAX_FRAMES); ++i)
        self->frames[i] = NULL;
      self->frameCount = 0U;
    }),

    CONST_OPERATION(FrameAt, (size_t index, void **outAddress), {
      if (!self || !outAddress)
        return STATUS_CONST(INVALID_ARGUMENT);
      if (index >= self->frameCount)
        return STATUS_CONST(OUT_OF_RANGE);
      *outAddress = self->frames[index];
      return STATUS_CONST(SUCCESS);
    }),

    CONST_OPERATION(Format, (char *outBuffer, size_t capacity, size_t *outWritten), {
      if (!self || !outBuffer || capacity == 0U)
        return STATUS_CONST(INVALID_ARGUMENT);

      MODULE_ITYPE(Diagnostic, FormatWriter) w;
      MODULE_IFUNC(Diagnostic, FormatWriter_Init)(&w, outBuffer, capacity);

      if (self->frameCount == 0U) {
        MODULE_IFUNC(Diagnostic, FormatWriter_AppendStr)(&w, "<empty stacktrace>");
      } else {
        for (size_t i = 0U; i < self->frameCount; ++i) {
          if (i > 0U)
            MODULE_IFUNC(Diagnostic, FormatWriter_AppendChar)(&w, '\n');
          MODULE_IFUNC(Diagnostic, FormatWriter_AppendChar)(&w, '#');
          if (i < 10U)
            MODULE_IFUNC(Diagnostic, FormatWriter_AppendChar)(&w, '0');
          MODULE_IFUNC(Diagnostic, FormatWriter_AppendUint)(&w, i);
          MODULE_IFUNC(Diagnostic, FormatWriter_AppendStr)(&w, "  ");
          MODULE_IFUNC(Diagnostic, FormatWriter_AppendHex)(&w, (uintptr_t)self->frames[i]);
        }
      }

      if (outWritten != NULL)
        *outWritten = w.written;
      return w.overflow ? STATUS_CONST(INSUFFICIENT_SPACE) : STATUS_CONST(SUCCESS);
    })
  )
);

/* EOF */
