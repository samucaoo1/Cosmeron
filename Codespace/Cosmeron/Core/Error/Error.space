#pragma once

#include "../Namespace.h"

#define ERROR_MOD Error
#define ERROR_CMOD ERROR

#define ERROR_NS(NAME) GNS2(LIB_PREFIX(ERROR_MOD), NAME)
#define ERROR_CNS(NAME) CNS2(LIB_PREFIX_CONST(ERROR_CMOD), NAME)
#define ERROR_INS(NAME) GNS3(LIB_PREFIX(ERROR_MOD), Internal, NAME)
#define ERROR_CINS(NAME) CNS3(LIB_PREFIX_CONST(ERROR_CMOD), INTERNAL, NAME)

#define ERROR_TYPE(NAME) ERROR_NS(NAME)
#define ERROR_FUNC(NAME) ERROR_NS(NAME)
#define ERROR_CONST(NAME) ERROR_CNS(NAME)
