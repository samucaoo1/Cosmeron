#pragma once

#if OS_WINDOWS
#include <windows.h>
#include "StacktraceWindows.inc"
#elif OS_MAC || (OS_LINUX && LIBC_GLIBC)
/* execinfo/backtrace may need a separate link library on BSD and musl.
 * Retain it only where it is known to satisfy the zero-link policy. */
#include <execinfo.h>
#include "StacktraceUnix.inc"
#else
PANIC_STACKTRACE_PROTOTYPE {
  fprintf(stderr, "stacktrace unavailable (no zero-link platform backend)\n");
}
#endif

PANIC_TRIGGER_PROTOTYPE {
  fprintf(stderr, "\n");
  fprintf(stderr, "============== PANIC ==============\n");
  fprintf(stderr, "message : %s\n", message ? message : "unknown");
  fprintf(stderr, "file    : %s\n", file);
  fprintf(stderr, "line    : %d\n", line);
  fprintf(stderr, "function: %s\n", function);
  fprintf(stderr, "\nStacktrace:\n");

  PANIC_INTERNAL_FUNC(Stacktrace)();

  fprintf(stderr, "===================================\n");
  abort();
}

PANIC_NOW_PROTOTYPE {
  PANIC_INTERNAL_FUNC(Trigger)(message, "unknown", 0, "unknown");
}
/* EOF */
