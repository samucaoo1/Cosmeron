#pragma once

#include "../Preprocessor/Compiling.inc"
#include "Error.space"
#include "StatusTable/StatusTable.h"

#define STATUS_MOD Status
#define STATUS_CMOD STATUS

#define STATUS_NS(NAME) GNS2(LIB_PREFIX(STATUS_MOD), NAME)
#define STATUS_CNS(NAME) CNS2(LIB_PREFIX_CONST(STATUS_CMOD), NAME)
#define STATUS_INS(NAME) GNS3(LIB_PREFIX(STATUS_MOD), Internal, NAME)
#define STATUS_CINS(NAME) CNS3(LIB_PREFIX_CONST(STATUS_CMOD), INTERNAL, NAME)

#define STATUS_CATEGORY_CNS(NAME)                                              \
  CNS3(LIB_PREFIX_CONST(STATUS_CMOD), CATEGORY, NAME)
#define STATUS_CATEGORY_CONST(NAME) STATUS_CATEGORY_CNS(NAME)

#define STATUS_TYPE(NAME) STATUS_NS(NAME)
#define STATUS_FUNC(NAME) STATUS_NS(NAME)
#define STATUS_CONST(NAME) STATUS_CNS(NAME)

#define OPSTATUS STATUS_TYPE(Status)

typedef enum STATUS_TYPE(Category) {
#define STATUS_CATEGORY_ENUM_ITEM(ROW)                                         \
  STATUS_CATEGORY_CONST(STATUS_CATEGORY_GET(NAME, ROW)),
  STATUS_CATEGORY_TABLE(STATUS_CATEGORY_ENUM_ITEM)
#undef STATUS_CATEGORY_ENUM_ITEM
} STATUS_TYPE(Category);

typedef enum STATUS_TYPE(Status) {
#define STATUS_ENUM_ITEM(ROW) STATUS_CONST(STATUS_GET(NAME, ROW)),
  STATUS_TABLE(STATUS_ENUM_ITEM)
#undef STATUS_ENUM_ITEM
} OPSTATUS;
/* EOF */

