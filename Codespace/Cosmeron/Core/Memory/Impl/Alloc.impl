#pragma once

MODULE_IMPLEMENT(DOMAIN(Core), Memory,
  PACKAGE(Alloc,
    OPERATION(Bytes, (void *outPointerObject, size_t size), {
      if (!outPointerObject) {
        return STATUS_CONST(INVALID_ARGUMENT);
      }

      if (size == 0U) {
        MODULE_IFUNC(Memory, WritePointer)(outPointerObject, NULL);
        return STATUS_CONST(SUCCESS);
      }

      void *allocated = malloc(size);
      if (!allocated) {
        return STATUS_CONST(OUT_OF_MEMORY);
      }

      MODULE_IFUNC(Memory, WritePointer)(outPointerObject, allocated);
      return STATUS_CONST(SUCCESS);
    }),

    OPERATION(Array, (void *outPointerObject, size_t count, size_t elementSize), {
      if (!outPointerObject) {
        return STATUS_CONST(INVALID_ARGUMENT);
      }

      size_t size = 0U;
      OPSTATUS status =
          MODULE_IFUNC(Memory, CheckedMultiplySize)(count, elementSize, &size);
      if (status != STATUS_CONST(SUCCESS)) {
        return status;
      }

      return MODULE_FUNC(Memory, Alloc, Bytes)(outPointerObject, size);
    }),

    VARIANT(Zero,
      OPERATION(Bytes, (void *outPointerObject, size_t size), {
        if (!outPointerObject) {
          return STATUS_CONST(INVALID_ARGUMENT);
        }

        if (size == 0U) {
          MODULE_IFUNC(Memory, WritePointer)(outPointerObject, NULL);
          return STATUS_CONST(SUCCESS);
        }

        void *allocated = calloc(1U, size);
        if (!allocated) {
          return STATUS_CONST(OUT_OF_MEMORY);
        }

        MODULE_IFUNC(Memory, WritePointer)(outPointerObject, allocated);
        return STATUS_CONST(SUCCESS);
      }),

      OPERATION(Array, (void *outPointerObject, size_t count, size_t elementSize), {
        if (!outPointerObject) {
          return STATUS_CONST(INVALID_ARGUMENT);
        }

        size_t size = 0U;
        OPSTATUS status =
            MODULE_IFUNC(Memory, CheckedMultiplySize)(count, elementSize, &size);
        if (status != STATUS_CONST(SUCCESS)) {
          return status;
        }

        return MODULE_FUNC(Memory, Alloc, ZeroBytes)(outPointerObject, size);
      })
    ),

    VARIANT(Realloc,
      OPERATION(Bytes, (void *inoutPointerObject, size_t newSize), {
        if (!inoutPointerObject) {
          return STATUS_CONST(INVALID_ARGUMENT);
        }

        void *current = MODULE_IFUNC(Memory, ReadPointer)(inoutPointerObject);

        if (newSize == 0U) {
          free(current);
          MODULE_IFUNC(Memory, WritePointer)(inoutPointerObject, NULL);
          return STATUS_CONST(SUCCESS);
        }

        void *reallocated = realloc(current, newSize);
        if (!reallocated) {
          return STATUS_CONST(OUT_OF_MEMORY);
        }

        MODULE_IFUNC(Memory, WritePointer)(inoutPointerObject, reallocated);
        return STATUS_CONST(SUCCESS);
      }),

      OPERATION(Array, (void *inoutPointerObject, size_t count, size_t elementSize), {
        if (!inoutPointerObject) {
          return STATUS_CONST(INVALID_ARGUMENT);
        }

        size_t size = 0U;
        OPSTATUS status =
            MODULE_IFUNC(Memory, CheckedMultiplySize)(count, elementSize, &size);
        if (status != STATUS_CONST(SUCCESS)) {
          return status;
        }

        return MODULE_FUNC(Memory, Alloc, ReallocBytes)(inoutPointerObject, size);
      })
    ),

    OPERATION(Free, (void *inoutPointerObject), {
      if (!inoutPointerObject) {
        return STATUS_CONST(INVALID_ARGUMENT);
      }

      void *current = MODULE_IFUNC(Memory, ReadPointer)(inoutPointerObject);
      free(current);
      MODULE_IFUNC(Memory, WritePointer)(inoutPointerObject, NULL);
      return STATUS_CONST(SUCCESS);
    })
  )
);

/* EOF */
