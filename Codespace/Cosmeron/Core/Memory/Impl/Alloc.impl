#pragma once

#include <stdint.h>

PACKAGE_SCOPE(Memory, Alloc)

#define SCOPE_TARGET MODULE_NS(Memory, Alloc)

SCOPE_PKG_OPERATION(Bytes, (void *outPointerObject, size_t size)) {
  void *allocated = NULL;

  if (!outPointerObject)
    return STATUS_CONST(INVALID_ARGUMENT);

  if (size == 0U) {
    MODULE_IFUNC(Memory, WritePointer)(outPointerObject, NULL);
    return STATUS_CONST(SUCCESS);
  }

  allocated = malloc(size);
  if (!allocated)
    return STATUS_CONST(OUT_OF_MEMORY);

  MODULE_IFUNC(Memory, WritePointer)(outPointerObject, allocated);
  return STATUS_CONST(SUCCESS);
}

SCOPE_PKG_OPERATION(ZeroBytes, (void *outPointerObject, size_t size)) {
  void *allocated = NULL;

  if (!outPointerObject)
    return STATUS_CONST(INVALID_ARGUMENT);

  if (size == 0U) {
    MODULE_IFUNC(Memory, WritePointer)(outPointerObject, NULL);
    return STATUS_CONST(SUCCESS);
  }

  allocated = calloc(1U, size);
  if (!allocated)
    return STATUS_CONST(OUT_OF_MEMORY);

  MODULE_IFUNC(Memory, WritePointer)(outPointerObject, allocated);
  return STATUS_CONST(SUCCESS);
}

SCOPE_PKG_OPERATION(Array, (void *outPointerObject, size_t count, size_t elementSize)) {
  size_t size = 0U;
  OPSTATUS status;

  if (!outPointerObject)
    return STATUS_CONST(INVALID_ARGUMENT);

  status = MODULE_IFUNC(Memory, CheckedMultiplySize)(count, elementSize, &size);
  if (status != STATUS_CONST(SUCCESS))
    return status;

  return MODULE_FUNC(Memory, Alloc, Bytes)(outPointerObject, size);
}

SCOPE_PKG_OPERATION(ZeroArray, (void *outPointerObject, size_t count, size_t elementSize)) {
  void *allocated = NULL;

  if (!outPointerObject)
    return STATUS_CONST(INVALID_ARGUMENT);

  if (count == 0U || elementSize == 0U) {
    MODULE_IFUNC(Memory, WritePointer)(outPointerObject, NULL);
    return STATUS_CONST(SUCCESS);
  }

  if (count > SIZE_MAX / elementSize)
    return STATUS_CONST(ARITHMETIC_OVERFLOW);

  allocated = calloc(count, elementSize);
  if (!allocated)
    return STATUS_CONST(OUT_OF_MEMORY);

  MODULE_IFUNC(Memory, WritePointer)(outPointerObject, allocated);
  return STATUS_CONST(SUCCESS);
}

SCOPE_PKG_OPERATION(ReallocBytes, (void *inoutPointerObject, size_t newSize)) {
  void *current = NULL;
  void *reallocated = NULL;

  if (!inoutPointerObject)
    return STATUS_CONST(INVALID_ARGUMENT);

  current = MODULE_IFUNC(Memory, ReadPointer)(inoutPointerObject);

  if (newSize == 0U) {
    free(current);
    MODULE_IFUNC(Memory, WritePointer)(inoutPointerObject, NULL);
    return STATUS_CONST(SUCCESS);
  }

  reallocated = realloc(current, newSize);
  if (!reallocated)
    return STATUS_CONST(OUT_OF_MEMORY);

  MODULE_IFUNC(Memory, WritePointer)(inoutPointerObject, reallocated);
  return STATUS_CONST(SUCCESS);
}

SCOPE_PKG_OPERATION(ReallocArray, (void *inoutPointerObject, size_t count, size_t elementSize)) {
  size_t size = 0U;
  OPSTATUS status;

  if (!inoutPointerObject)
    return STATUS_CONST(INVALID_ARGUMENT);

  status = MODULE_IFUNC(Memory, CheckedMultiplySize)(count, elementSize, &size);
  if (status != STATUS_CONST(SUCCESS))
    return status;

  return MODULE_FUNC(Memory, Alloc, ReallocBytes)(inoutPointerObject, size);
}

SCOPE_PKG_OPERATION(Free, (void *inoutPointerObject)) {
  void *current = NULL;

  if (!inoutPointerObject)
    return STATUS_CONST(INVALID_ARGUMENT);

  current = MODULE_IFUNC(Memory, ReadPointer)(inoutPointerObject);
  free(current);
  MODULE_IFUNC(Memory, WritePointer)(inoutPointerObject, NULL);
  return STATUS_CONST(SUCCESS);
}

#undef SCOPE_TARGET

PACKAGE_SCOPE_END()

/* EOF */
