#pragma once

#include <stdint.h>
#include <string.h>

static const size_t MODULE_INS(Memory, Heap, SizeClassTable)[MODULE_CONST(MEMORY, HEAP, SIZE_CLASS_COUNT)] = {
    16U,   32U,   48U,   64U,   80U,   96U,   112U,  128U,
    160U,  192U,  224U,  256U,  320U,  384U,  448U,  512U,
    640U,  768U,  896U,  1024U, 1280U, 1536U, 1792U, 2048U
};

#if !defined(OBJECT_DISABLE_FUNCTION_TABLE) && !defined(MODULE_DISABLE_FUNCTION_TABLE)
#define HEAP_INIT_SELF(self) do { const void *api = (self)->api; memset((self), 0, sizeof(*(self))); (self)->api = api; } while (0)
#else
#define HEAP_INIT_SELF(self) do { memset((self), 0, sizeof(*(self))); } while (0)
#endif

/* ========================================================================== */
/* TMemoryHeap Method Implementations                                         */
/* ========================================================================== */

MODULE_IMPLEMENT(DOMAIN(Core), Memory,
  INTERNAL_EX(Heap,
    OPERATION(SizeToClassIndex, (size_t size, size_t *outIndex), {
      if (!outIndex)
        return STATUS_CONST(INVALID_ARGUMENT);

      for (size_t i = 0U; i < MODULE_CONST(MEMORY, HEAP, SIZE_CLASS_COUNT); ++i) {
        if (size <= MODULE_INS(Memory, Heap, SizeClassTable)[i]) {
          *outIndex = i;
          return STATUS_CONST(SUCCESS);
        }
      }
      return STATUS_CONST(OUT_OF_RANGE);
    }),

    FUNCTION(uintptr_t, RadixHash, (uintptr_t key), {
      key = (key ^ (key >> 16U)) * 0x45d9f3bU;
      key = (key ^ (key >> 16U)) * 0x45d9f3bU;
      key = key ^ (key >> 16U);
      return key % MODULE_CONST(MEMORY, HEAP, RADIX_BUCKETS_COUNT);
    }),

    FUNCTION(MODULE_ITYPE(Memory, HeapRadixLevel2) *, GetOrCreateRadixL2, (MODULE_TYPE(Memory, Heap) *self, uintptr_t l1Key), {
      uintptr_t bucket = MODULE_IFUNC(Memory, Heap, RadixHash)(l1Key);
      MODULE_ITYPE(Memory, HeapRadixLevel2) *node = self->radixBuckets[bucket];

      while (node) {
        if (node->l1Key == l1Key)
          return node;
        node = node->next;
      }

      void *raw = NULL;
      if (MODULE_FUNC(Memory, Alloc, Bytes)(&raw, sizeof(MODULE_ITYPE(Memory, HeapRadixLevel2))) != STATUS_CONST(SUCCESS) || !raw)
        return NULL;

      node = (MODULE_ITYPE(Memory, HeapRadixLevel2) *)raw;
      node->l1Key = l1Key;
      memset(node->pages, 0, sizeof(node->pages));
      node->next = self->radixBuckets[bucket];
      self->radixBuckets[bucket] = node;
      return node;
    }),

    OPERATION(RadixMapPage, (MODULE_TYPE(Memory, Heap) *self, uintptr_t pageIndex, void *entry), {
      uintptr_t l1Key = pageIndex >> MODULE_CONST(MEMORY, HEAP, RADIX_LEVEL2_BITS);
      uintptr_t l2Index = pageIndex & ((1U << MODULE_CONST(MEMORY, HEAP, RADIX_LEVEL2_BITS)) - 1U);
      MODULE_ITYPE(Memory, HeapRadixLevel2) *l2 = MODULE_IFUNC(Memory, Heap, GetOrCreateRadixL2)(self, l1Key);
      if (!l2)
        return STATUS_CONST(OUT_OF_MEMORY);

      l2->pages[l2Index] = entry;
      return STATUS_CONST(SUCCESS);
    }),

    FUNCTION(void *, RadixLookupPage, (const MODULE_TYPE(Memory, Heap) *self, uintptr_t pageIndex), {
      uintptr_t l1Key = pageIndex >> MODULE_CONST(MEMORY, HEAP, RADIX_LEVEL2_BITS);
      uintptr_t l2Index = pageIndex & ((1U << MODULE_CONST(MEMORY, HEAP, RADIX_LEVEL2_BITS)) - 1U);
      uintptr_t bucket = MODULE_IFUNC(Memory, Heap, RadixHash)(l1Key);
      MODULE_ITYPE(Memory, HeapRadixLevel2) *node = self->radixBuckets[bucket];

      while (node) {
        if (node->l1Key == l1Key)
          return node->pages[l2Index];
        node = node->next;
      }
      return NULL;
    }),

    OPERATION(AllocAlignedPage, (void **outAligned, void **outRaw, size_t numPages), {
      size_t totalBytes = numPages * MODULE_CONST(MEMORY, HEAP, PAGE_SIZE);
      size_t allocSize = totalBytes + MODULE_CONST(MEMORY, HEAP, PAGE_SIZE);
      void *raw = NULL;
      OPSTATUS status = MODULE_FUNC(Memory, Alloc, Bytes)(&raw, allocSize);
      if (status != STATUS_CONST(SUCCESS) || !raw)
        return STATUS_CONST(OUT_OF_MEMORY);

      uintptr_t rawAddr = (uintptr_t)raw;
      uintptr_t alignedAddr = (rawAddr + (MODULE_CONST(MEMORY, HEAP, PAGE_SIZE) - 1U)) & ~(uintptr_t)(MODULE_CONST(MEMORY, HEAP, PAGE_SIZE) - 1U);

      *outAligned = (void *)alignedAddr;
      *outRaw = raw;
      return STATUS_CONST(SUCCESS);
    })
  ),

  OBJECT(Heap,
    OPERATION(Create, (size_t initialPages), {
      if (!self)
        return STATUS_CONST(INVALID_ARGUMENT);

      HEAP_INIT_SELF(self);
      self->minAddress = UINTPTR_MAX;
      self->maxAddress = 0U;

      for (size_t i = 0U; i < MODULE_CONST(MEMORY, HEAP, SIZE_CLASS_COUNT); ++i) {
        self->classes[i].elementSize = MODULE_INS(Memory, Heap, SizeClassTable)[i];
        self->classes[i].activePages = NULL;
        self->classes[i].fullPages = NULL;
      }

      (void)initialPages;
      return STATUS_CONST(SUCCESS);
    }),

    OPERATION(Destroy, (), {
      if (!self)
        return STATUS_CONST(INVALID_ARGUMENT);

      for (size_t i = 0U; i < MODULE_CONST(MEMORY, HEAP, SIZE_CLASS_COUNT); ++i) {
        MODULE_ITYPE(Memory, HeapPageHeader) *page = self->classes[i].activePages;
        while (page) {
          MODULE_ITYPE(Memory, HeapPageHeader) *next = page->next;
          void *raw = page->rawBlock;
          MODULE_FUNC(Memory, Alloc, Free)(&raw);
          page = next;
        }
        page = self->classes[i].fullPages;
        while (page) {
          MODULE_ITYPE(Memory, HeapPageHeader) *next = page->next;
          void *raw = page->rawBlock;
          MODULE_FUNC(Memory, Alloc, Free)(&raw);
          page = next;
        }
        self->classes[i].activePages = NULL;
        self->classes[i].fullPages = NULL;
      }

      MODULE_ITYPE(Memory, HeapPageHeader) *freePage = self->freePages;
      while (freePage) {
        MODULE_ITYPE(Memory, HeapPageHeader) *next = freePage->next;
        void *raw = freePage->rawBlock;
        MODULE_FUNC(Memory, Alloc, Free)(&raw);
        freePage = next;
      }
      self->freePages = NULL;

      MODULE_ITYPE(Memory, HeapSpan) *span = self->largeObjects;
      while (span) {
        MODULE_ITYPE(Memory, HeapSpan) *next = span->next;
        void *raw = span->rawBlock;
        MODULE_FUNC(Memory, Alloc, Free)(&raw);
        span = next;
      }
      self->largeObjects = NULL;

      for (size_t i = 0U; i < MODULE_CONST(MEMORY, HEAP, RADIX_BUCKETS_COUNT); ++i) {
        MODULE_ITYPE(Memory, HeapRadixLevel2) *node = self->radixBuckets[i];
        while (node) {
          MODULE_ITYPE(Memory, HeapRadixLevel2) *next = node->next;
          void *raw = (void *)node;
          MODULE_FUNC(Memory, Alloc, Free)(&raw);
          node = next;
        }
        self->radixBuckets[i] = NULL;
      }

      self->minAddress = UINTPTR_MAX;
      self->maxAddress = 0U;
      self->totalAllocatedBytes = 0U;
      self->liveBytes = 0U;
      self->pageCount = 0U;
      self->blacklistedCount = 0U;

      return STATUS_CONST(SUCCESS);
    }),

    VARIANT(Alloc,
      OPERATION((void *outPointerObject, size_t size, uint8_t policy, const void *descriptor), {
        if (!self || !outPointerObject || size == 0U)
          return STATUS_CONST(INVALID_ARGUMENT);

        if (size <= MODULE_CONST(MEMORY, HEAP, MAX_SMALL_SIZE)) {
          size_t classIdx = 0U;
          OPSTATUS status = MODULE_IFUNC(Memory, Heap, SizeToClassIndex)(size, &classIdx);
          if (status != STATUS_CONST(SUCCESS))
            return status;
          return MODULE_FUNC(Memory, Heap, AllocSmall)(self, outPointerObject, classIdx, policy, descriptor);
        }

        return MODULE_FUNC(Memory, Heap, AllocLarge)(self, outPointerObject, size, policy, descriptor);
      }),

      OPERATION(Small,
          (void *outPointerObject, size_t sizeClassIndex, uint8_t policy, const void *descriptor), {
        if (!self || !outPointerObject || sizeClassIndex >= MODULE_CONST(MEMORY, HEAP, SIZE_CLASS_COUNT))
          return STATUS_CONST(INVALID_ARGUMENT);

        MODULE_ITYPE(Memory, HeapSizeClass) *sc = &self->classes[sizeClassIndex];
        MODULE_ITYPE(Memory, HeapPageHeader) *page = sc->activePages;

        /* Check if current page matches policy/descriptor; find one that does or has capacity */
        while (page) {
          if (page->freeCellCount > 0U && page->policy == policy && page->descriptor == descriptor)
            break;
          page = page->next;
        }

        if (!page) {
          /* Allocate a new page */
          void *pageMem = NULL;
          void *rawMem = NULL;
          OPSTATUS status = MODULE_IFUNC(Memory, Heap, AllocAlignedPage)(&pageMem, &rawMem, 1U);
          if (status != STATUS_CONST(SUCCESS))
            return status;

          page = (MODULE_ITYPE(Memory, HeapPageHeader) *)pageMem;
          memset(page, 0, MODULE_CONST(MEMORY, HEAP, PAGE_HEADER_SIZE));
          page->isLargeSpan = 0U;
          page->policy = policy;
          page->state = MODULE_CONST(MEMORY, HEAP, PAGE_STATE, ACTIVE);
          page->sizeClassIndex = (uint16_t)sizeClassIndex;
          page->elementSize = (uint16_t)sc->elementSize;
          page->rawBlock = rawMem;
          page->descriptor = descriptor;

          size_t availableBytes = MODULE_CONST(MEMORY, HEAP, PAGE_SIZE) - MODULE_CONST(MEMORY, HEAP, PAGE_HEADER_SIZE);
          size_t cells = availableBytes / sc->elementSize;
          if (cells > 256U)
            cells = 256U;

          page->cellCount = (uint16_t)cells;
          page->freeCellCount = (uint16_t)cells;
          page->firstFreeCell = 0U;

          uintptr_t pageIndex = ((uintptr_t)pageMem) >> MODULE_CONST(MEMORY, HEAP, PAGE_SHIFT);
          status = MODULE_IFUNC(Memory, Heap, RadixMapPage)(self, pageIndex, page);
          if (status != STATUS_CONST(SUCCESS)) {
            MODULE_FUNC(Memory, Alloc, Free)(&rawMem);
            return status;
          }

          uintptr_t startAddr = (uintptr_t)page->payload;
          uintptr_t endAddr = startAddr + (cells * sc->elementSize);
          if (startAddr < self->minAddress)
            self->minAddress = startAddr;
          if (endAddr > self->maxAddress)
            self->maxAddress = endAddr;

          page->next = sc->activePages;
          if (page->next)
            page->next->prev = page;
          page->prev = NULL;
          sc->activePages = page;
          self->pageCount++;
        }

        /* Find first free bit in allocBitmap */
        uint16_t cellIndex = 0U;
        bool found = false;
        for (size_t w = 0U; w < MODULE_CONST(MEMORY, HEAP, BITMAP_WORDS); ++w) {
          if (page->allocBitmap[w] != UINT64_MAX) {
            for (uint8_t b = 0U; b < 64U; ++b) {
              uint16_t idx = (uint16_t)((w * 64U) + b);
              if (idx >= page->cellCount)
                break;
              if ((page->allocBitmap[w] & (1ULL << b)) == 0ULL) {
                page->allocBitmap[w] |= (1ULL << b);
                cellIndex = idx;
                found = true;
                break;
              }
            }
            if (found)
              break;
          }
        }

        if (!found)
          return STATUS_CONST(OUT_OF_MEMORY);

        page->freeCellCount--;
        if (page->freeCellCount == 0U) {
          page->state = MODULE_CONST(MEMORY, HEAP, PAGE_STATE, FULL);
          /* Move to fullPages */
          if (page->prev)
            page->prev->next = page->next;
          else
            sc->activePages = page->next;
          if (page->next)
            page->next->prev = page->prev;

          page->next = sc->fullPages;
          if (page->next)
            page->next->prev = page;
          page->prev = NULL;
          sc->fullPages = page;
        }

        void *cellPtr = page->payload + ((size_t)cellIndex * sc->elementSize);
        memset(cellPtr, 0, sc->elementSize);

        self->totalAllocatedBytes += sc->elementSize;
        self->liveBytes += sc->elementSize;

        MODULE_IFUNC(Memory, WritePointer)(outPointerObject, cellPtr);
        return STATUS_CONST(SUCCESS);
      }),

      OPERATION(Large,
          (void *outPointerObject, size_t size, uint8_t policy, const void *descriptor), {
        if (!self || !outPointerObject || size == 0U)
          return STATUS_CONST(INVALID_ARGUMENT);

        size_t headerSize = sizeof(MODULE_ITYPE(Memory, HeapSpan));
        size_t totalBytes = headerSize + size;
        size_t numPages = (totalBytes + MODULE_CONST(MEMORY, HEAP, PAGE_SIZE) - 1U) >> MODULE_CONST(MEMORY, HEAP, PAGE_SHIFT);

        void *alignedMem = NULL;
        void *rawMem = NULL;
        OPSTATUS status = MODULE_IFUNC(Memory, Heap, AllocAlignedPage)(&alignedMem, &rawMem, numPages);
        if (status != STATUS_CONST(SUCCESS))
          return status;

        MODULE_ITYPE(Memory, HeapSpan) *span = (MODULE_ITYPE(Memory, HeapSpan) *)alignedMem;
        span->isLargeSpan = 1U;
        span->policy = policy;
        span->isMarked = 0U;
        span->_reserved = 0U;
        span->pageCount = numPages;
        span->size = size;
        span->descriptor = descriptor;
        span->rawBlock = rawMem;

        uintptr_t basePageIndex = ((uintptr_t)alignedMem) >> MODULE_CONST(MEMORY, HEAP, PAGE_SHIFT);
        for (size_t p = 0U; p < numPages; ++p) {
          status = MODULE_IFUNC(Memory, Heap, RadixMapPage)(self, basePageIndex + p, span);
          if (status != STATUS_CONST(SUCCESS)) {
            MODULE_FUNC(Memory, Alloc, Free)(&rawMem);
            return status;
          }
        }

        uintptr_t startAddr = (uintptr_t)span->data;
        uintptr_t endAddr = startAddr + size;
        if (startAddr < self->minAddress)
          self->minAddress = startAddr;
        if (endAddr > self->maxAddress)
          self->maxAddress = endAddr;

        span->next = self->largeObjects;
        if (span->next)
          span->next->prev = span;
        span->prev = NULL;
        self->largeObjects = span;

        self->pageCount += numPages;
        self->totalAllocatedBytes += size;
        self->liveBytes += size;

        memset(span->data, 0, size);
        MODULE_IFUNC(Memory, WritePointer)(outPointerObject, span->data);
        return STATUS_CONST(SUCCESS);
      })
    ),

    OPERATION(FreeCell, (void *ptr), {
      if (!self || !ptr)
        return STATUS_CONST(INVALID_ARGUMENT);

      uintptr_t pageIndex = ((uintptr_t)ptr) >> MODULE_CONST(MEMORY, HEAP, PAGE_SHIFT);
      void *entry = MODULE_IFUNC(Memory, Heap, RadixLookupPage)(self, pageIndex);
      if (!entry)
        return STATUS_CONST(INVALID_ARGUMENT);

      uint8_t isLarge = *(uint8_t *)entry;
      if (isLarge) {
        MODULE_ITYPE(Memory, HeapSpan) *span = (MODULE_ITYPE(Memory, HeapSpan) *)entry;
        if (ptr != (void *)span->data)
          return STATUS_CONST(INVALID_ARGUMENT);

        /* Unlink span */
        if (span->prev)
          span->prev->next = span->next;
        else
          self->largeObjects = span->next;
        if (span->next)
          span->next->prev = span->prev;

        self->liveBytes = (self->liveBytes >= span->size) ? (self->liveBytes - span->size) : 0U;
        self->pageCount = (self->pageCount >= span->pageCount) ? (self->pageCount - span->pageCount) : 0U;

        for (size_t p = 0U; p < span->pageCount; ++p) {
          MODULE_IFUNC(Memory, Heap, RadixMapPage)(self, pageIndex + p, NULL);
        }

        void *raw = span->rawBlock;
        MODULE_FUNC(Memory, Alloc, Free)(&raw);
        return STATUS_CONST(SUCCESS);
      }

      MODULE_ITYPE(Memory, HeapPageHeader) *page = (MODULE_ITYPE(Memory, HeapPageHeader) *)entry;
      uintptr_t offset = (uintptr_t)ptr - (uintptr_t)page->payload;
      if (offset >= (size_t)page->cellCount * page->elementSize)
        return STATUS_CONST(INVALID_ARGUMENT);

      uint16_t cellIndex = (uint16_t)(offset / page->elementSize);
      size_t w = cellIndex / 64U;
      uint64_t mask = 1ULL << (cellIndex % 64U);

      if ((page->allocBitmap[w] & mask) == 0ULL)
        return STATUS_CONST(INVALID_ARGUMENT);

      page->allocBitmap[w] &= ~mask;
      page->markBitmap[w] &= ~mask;
      page->freeCellCount++;
      self->liveBytes = (self->liveBytes >= page->elementSize) ? (self->liveBytes - page->elementSize) : 0U;

      if (page->state == MODULE_CONST(MEMORY, HEAP, PAGE_STATE, FULL)) {
        /* Move back from fullPages to activePages */
        MODULE_ITYPE(Memory, HeapSizeClass) *sc = &self->classes[page->sizeClassIndex];
        if (page->prev)
          page->prev->next = page->next;
        else
          sc->fullPages = page->next;
        if (page->next)
          page->next->prev = page->prev;

        page->next = sc->activePages;
        if (page->next)
          page->next->prev = page;
        page->prev = NULL;
        sc->activePages = page;
        page->state = MODULE_CONST(MEMORY, HEAP, PAGE_STATE, ACTIVE);
      }

      return STATUS_CONST(SUCCESS);
    }),

    OPERATION(BlacklistPage, (uintptr_t pageIndex), {
      if (!self)
        return STATUS_CONST(INVALID_ARGUMENT);

      for (size_t i = 0U; i < self->blacklistedCount; ++i) {
        if (self->blacklistedPages[i] == pageIndex)
          return STATUS_CONST(SUCCESS);
      }

      if (self->blacklistedCount < MODULE_CONST(MEMORY, HEAP, MAX_BLACKLISTED)) {
        self->blacklistedPages[self->blacklistedCount++] = pageIndex;
        return STATUS_CONST(SUCCESS);
      }
      return STATUS_CONST(OUT_OF_RANGE);
    }),

    CONST_PREDICATE(IsBlacklisted, (uintptr_t pageIndex), {
      if (!self)
        return false;

      for (size_t i = 0U; i < self->blacklistedCount; ++i) {
        if (self->blacklistedPages[i] == pageIndex)
          return true;
      }
      return false;
    }),

    CONST_FUNCTION(void *, LookupEntry, (const void *ptr), {
      if (!self || !ptr)
        return NULL;

      uintptr_t pageIndex = ((uintptr_t)ptr) >> MODULE_CONST(MEMORY, HEAP, PAGE_SHIFT);
      return MODULE_IFUNC(Memory, Heap, RadixLookupPage)(self, pageIndex);
    }),

    CONST_PREDICATE(ResolvePointer,
        (const void *interiorPtr, void **outBasePtr, size_t *outSize, uint8_t *outPolicy), {
      if (!self || !interiorPtr || !outBasePtr)
        return false;

      uintptr_t addr = (uintptr_t)interiorPtr;
      if (addr < self->minAddress || addr >= self->maxAddress)
        return false;

      void *entry = MODULE_FUNC(Memory, Heap, LookupEntry)(self, interiorPtr);
      if (!entry)
        return false;

      uint8_t isLarge = *(uint8_t *)entry;
      if (isLarge) {
        MODULE_ITYPE(Memory, HeapSpan) *span = (MODULE_ITYPE(Memory, HeapSpan) *)entry;
        uintptr_t start = (uintptr_t)span->data;
        if (addr >= start && addr < start + span->size) {
          *outBasePtr = (void *)start;
          if (outSize)
            *outSize = span->size;
          if (outPolicy)
            *outPolicy = span->policy;
          return true;
        }
        return false;
      }

      MODULE_ITYPE(Memory, HeapPageHeader) *page = (MODULE_ITYPE(Memory, HeapPageHeader) *)entry;
      uintptr_t payloadStart = (uintptr_t)page->payload;
      uintptr_t payloadEnd = payloadStart + ((size_t)page->cellCount * page->elementSize);

      if (addr >= payloadStart && addr < payloadEnd) {
        uint16_t cellIndex = (uint16_t)((addr - payloadStart) / page->elementSize);
        size_t w = cellIndex / 64U;
        uint64_t mask = 1ULL << (cellIndex % 64U);

        if ((page->allocBitmap[w] & mask) != 0ULL) {
          *outBasePtr = page->payload + ((size_t)cellIndex * page->elementSize);
          if (outSize)
            *outSize = page->elementSize;
          if (outPolicy)
            *outPolicy = page->policy;
          return true;
        }
      }

      return false;
    }),

    OPERATION(SweepPage,
        (MODULE_ITYPE(Memory, HeapPageHeader) *page, bool *outIsPageEmpty), {
      if (!self || !page || !outIsPageEmpty)
        return STATUS_CONST(INVALID_ARGUMENT);

      uint16_t reclaimed = 0U;
      uint16_t totalActive = 0U;

      for (size_t w = 0U; w < MODULE_CONST(MEMORY, HEAP, BITMAP_WORDS); ++w) {
        uint64_t dead = page->allocBitmap[w] & ~page->markBitmap[w];
        if (dead != 0ULL) {
          for (uint8_t b = 0U; b < 64U; ++b) {
            if ((dead & (1ULL << b)) != 0ULL)
              reclaimed++;
          }
          page->allocBitmap[w] &= page->markBitmap[w];
        }
        for (uint8_t b = 0U; b < 64U; ++b) {
          if ((page->allocBitmap[w] & (1ULL << b)) != 0ULL)
            totalActive++;
        }
      }

      page->freeCellCount = page->cellCount - totalActive;
      self->liveBytes = (self->liveBytes >= (size_t)reclaimed * page->elementSize)
                            ? (self->liveBytes - (size_t)reclaimed * page->elementSize)
                            : 0U;

      *outIsPageEmpty = (totalActive == 0U);
      return STATUS_CONST(SUCCESS);
    }),

    OPERATION(LazySweepClass, (size_t sizeClassIndex), {
      if (!self || sizeClassIndex >= MODULE_CONST(MEMORY, HEAP, SIZE_CLASS_COUNT))
        return STATUS_CONST(INVALID_ARGUMENT);

      MODULE_ITYPE(Memory, HeapSizeClass) *sc = &self->classes[sizeClassIndex];
      MODULE_ITYPE(Memory, HeapPageHeader) *page = sc->fullPages;

      while (page) {
        MODULE_ITYPE(Memory, HeapPageHeader) *next = page->next;
        bool isEmpty = false;
        MODULE_FUNC(Memory, Heap, SweepPage)(self, page, &isEmpty);

        if (page->freeCellCount > 0U) {
          /* Unlink from fullPages */
          if (page->prev)
            page->prev->next = page->next;
          else
            sc->fullPages = page->next;
          if (page->next)
            page->next->prev = page->prev;

          /* Link into activePages */
          page->next = sc->activePages;
          if (page->next)
            page->next->prev = page;
          page->prev = NULL;
          sc->activePages = page;
          page->state = MODULE_CONST(MEMORY, HEAP, PAGE_STATE, ACTIVE);
        }
        page = next;
      }

      return STATUS_CONST(SUCCESS);
    }),

    CONST_PREDICATE(Contains, (const void *ptr), {
      void *basePtr = NULL;
      return MODULE_FUNC(Memory, Heap, ResolvePointer)(self, ptr, &basePtr, NULL, NULL);
    })
  )
);

#undef HEAP_INIT_SELF

/* EOF */
