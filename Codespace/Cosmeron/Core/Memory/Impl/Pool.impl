#pragma once

#include <stdint.h>

static inline size_t POOL_INS(AlignedChunkSize)(size_t elementSize) {
  size_t nodeSize = sizeof(POOL_INS(Node));
  size_t maxAlign = MEMORY_INS(MaxAlignment)();
  size_t size = elementSize > nodeSize ? elementSize : nodeSize;
  size_t rem = size % maxAlign;
  if (rem != 0U) {
    size += (maxAlign - rem);
  }
  return size;
}

/* ============================================================
 * TMemoryPool Method Implementations
 * ============================================================ */

OBJECT_OPERATION_IMPLEMENT_EX(POOL_TYPE(TMemoryPool), Create, (size_t elementSize, size_t elementCount)) {
  if (!self || elementSize == 0U || elementCount == 0U)
    return STATUS_CONST(INVALID_ARGUMENT);

  size_t chunkSize = POOL_INS(AlignedChunkSize)(elementSize);
  if (elementCount > SIZE_MAX / chunkSize)
    return STATUS_CONST(ARITHMETIC_OVERFLOW);

  size_t totalBytes = chunkSize * elementCount;
  void *buf = NULL;
  OPSTATUS status = ALLOC_FUNC(Bytes)(&buf, totalBytes);
  if (status != STATUS_CONST(SUCCESS))
    return status;

  self->buffer = buf;
  self->capacity = totalBytes;
  self->elementSize = chunkSize;
  self->elementCount = elementCount;
  self->allocatedCount = 0U;
  self->isOwned = true;
  self->freeList = NULL;

  uint8_t *ptr = (uint8_t *)self->buffer;
  for (size_t i = 0U; i < elementCount; ++i) {
    POOL_INS(Node) *node = (POOL_INS(Node) *)(ptr + (i * chunkSize));
    node->next = self->freeList;
    self->freeList = node;
  }

  return STATUS_CONST(SUCCESS);
}

OBJECT_OPERATION_IMPLEMENT_EX(POOL_TYPE(TMemoryPool), CreateBuffer, (void *buffer, size_t bufferSize, size_t elementSize)) {
  if (!self || !buffer || elementSize == 0U)
    return STATUS_CONST(INVALID_ARGUMENT);

  size_t chunkSize = POOL_INS(AlignedChunkSize)(elementSize);
  size_t count = bufferSize / chunkSize;
  if (count == 0U)
    return STATUS_CONST(INVALID_ARGUMENT);

  self->buffer = buffer;
  self->capacity = count * chunkSize;
  self->elementSize = chunkSize;
  self->elementCount = count;
  self->allocatedCount = 0U;
  self->isOwned = false;
  self->freeList = NULL;

  uint8_t *ptr = (uint8_t *)self->buffer;
  for (size_t i = 0U; i < count; ++i) {
    POOL_INS(Node) *node = (POOL_INS(Node) *)(ptr + (i * chunkSize));
    node->next = self->freeList;
    self->freeList = node;
  }

  return STATUS_CONST(SUCCESS);
}

OBJECT_OPERATION_IMPLEMENT_EX(POOL_TYPE(TMemoryPool), Alloc, (void *outPointerObject)) {
  if (!self || !outPointerObject)
    return STATUS_CONST(INVALID_ARGUMENT);

  if (self->freeList == NULL) {
    MEMORY_INS(WritePointer)(outPointerObject, NULL);
    return STATUS_CONST(OUT_OF_MEMORY);
  }

  POOL_INS(Node) *node = self->freeList;
  self->freeList = node->next;
  self->allocatedCount++;

  MEMORY_INS(WritePointer)(outPointerObject, node);
  return STATUS_CONST(SUCCESS);
}

OBJECT_OPERATION_IMPLEMENT_EX(POOL_TYPE(TMemoryPool), Free, (void *ptr)) {
  if (!self || !ptr)
    return STATUS_CONST(INVALID_ARGUMENT);

  uint8_t *bytePtr = (uint8_t *)ptr;
  uint8_t *base = (uint8_t *)self->buffer;
  if (bytePtr < base || bytePtr >= base + self->capacity)
    return STATUS_CONST(INVALID_ARGUMENT);

  size_t offset = (size_t)(bytePtr - base);
  if (offset % self->elementSize != 0U)
    return STATUS_CONST(INVALID_ARGUMENT);

  POOL_INS(Node) *node = (POOL_INS(Node) *)ptr;
  node->next = self->freeList;
  self->freeList = node;
  if (self->allocatedCount > 0U)
    self->allocatedCount--;

  return STATUS_CONST(SUCCESS);
}

OBJECT_OPERATION_IMPLEMENT_EX(POOL_TYPE(TMemoryPool), FreePointer, (void *inoutPointerObject)) {
  void *ptr = NULL;
  OPSTATUS status;

  if (!self || !inoutPointerObject)
    return STATUS_CONST(INVALID_ARGUMENT);

  ptr = MEMORY_INS(ReadPointer)(inoutPointerObject);
  status = POOL_FUNC(Free)(self, ptr);
  if (status == STATUS_CONST(SUCCESS)) {
    MEMORY_INS(WritePointer)(inoutPointerObject, NULL);
  }
  return status;
}

OBJECT_OPERATION_IMPLEMENT_EX(POOL_TYPE(TMemoryPool), Reset, ()) {
  if (!self)
    return STATUS_CONST(INVALID_ARGUMENT);

  self->freeList = NULL;
  self->allocatedCount = 0U;

  if (self->buffer && self->elementSize > 0U) {
    uint8_t *ptr = (uint8_t *)self->buffer;
    for (size_t i = 0U; i < self->elementCount; ++i) {
      POOL_INS(Node) *node = (POOL_INS(Node) *)(ptr + (i * self->elementSize));
      node->next = self->freeList;
      self->freeList = node;
    }
  }

  return STATUS_CONST(SUCCESS);
}

OBJECT_OPERATION_IMPLEMENT_EX(POOL_TYPE(TMemoryPool), Destroy, ()) {
  if (!self)
    return STATUS_CONST(INVALID_ARGUMENT);

  if (self->buffer && self->isOwned) {
    void *buf = self->buffer;
    ALLOC_FUNC(Free)(&buf);
  }
  self->buffer = NULL;

  self->capacity = 0U;
  self->elementSize = 0U;
  self->elementCount = 0U;
  self->allocatedCount = 0U;
  self->isOwned = false;
  self->freeList = NULL;

  return STATUS_CONST(SUCCESS);
}

OBJECT_PREDICATE_IMPLEMENT_EX(POOL_TYPE(TMemoryPool), Contains, (const void *ptr)) {
  if (!self || !ptr || !self->buffer)
    return false;

  const uint8_t *bytePtr = (const uint8_t *)ptr;
  const uint8_t *base = (const uint8_t *)self->buffer;
  if (bytePtr < base || bytePtr >= base + self->capacity)
    return false;

  size_t offset = (size_t)(bytePtr - base);
  return (offset % self->elementSize == 0U);
}

OBJECT_IMPLEMENT(POOL_TYPE(TMemoryPool));

/* EOF */
