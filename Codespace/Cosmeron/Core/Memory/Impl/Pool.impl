#pragma once

#include <stdint.h>

/* ========================================================================== */
/* TMemoryPool Method Implementations                                         */
/* ========================================================================== */

MODULE_IMPLEMENT(DOMAIN(Core), Memory,
  INTERNAL_EX(Pool,
    FUNCTION(size_t, AlignedChunkSize, (size_t elementSize), {
      size_t nodeSize = sizeof(MODULE_ITYPE(Memory, PoolNode));
      size_t maxAlign = MODULE_IFUNC(Memory, MaxAlignment)();
      size_t size = elementSize > nodeSize ? elementSize : nodeSize;
      size_t rem = size % maxAlign;
      if (rem != 0U) {
        size += (maxAlign - rem);
      }
      return size;
    })
  ),

  OBJECT(Pool,
    VARIANT(Create,
      OPERATION((size_t elementSize, size_t elementCount), {
        if (!self || elementSize == 0U || elementCount == 0U)
          return STATUS_CONST(INVALID_ARGUMENT);

        size_t chunkSize = MODULE_IFUNC(Memory, Pool, AlignedChunkSize)(elementSize);
        if (elementCount > SIZE_MAX / chunkSize)
          return STATUS_CONST(ARITHMETIC_OVERFLOW);

        size_t totalBytes = chunkSize * elementCount;
        void *buf = NULL;
        OPSTATUS status = MODULE_FUNC(Memory, Alloc, Bytes)(&buf, totalBytes);
        if (status != STATUS_CONST(SUCCESS))
          return status;

        self->buffer = buf;
        self->capacity = totalBytes;
        self->elementSize = chunkSize;
        self->elementCount = elementCount;
        self->allocatedCount = 0U;
        self->isOwned = true;
        self->freeList = NULL;

        uint8_t *ptr = (uint8_t *)self->buffer;
        for (size_t i = 0U; i < elementCount; ++i) {
          MODULE_ITYPE(Memory, PoolNode) *node = (MODULE_ITYPE(Memory, PoolNode) *)(ptr + (i * chunkSize));
          node->next = self->freeList;
          self->freeList = node;
        }

        return STATUS_CONST(SUCCESS);
      }),
      OPERATION(Buffer, (void *buffer, size_t bufferSize, size_t elementSize), {
        if (!self || !buffer || elementSize == 0U)
          return STATUS_CONST(INVALID_ARGUMENT);

        size_t chunkSize = MODULE_IFUNC(Memory, Pool, AlignedChunkSize)(elementSize);
        size_t count = bufferSize / chunkSize;
        if (count == 0U)
          return STATUS_CONST(INVALID_ARGUMENT);

        self->buffer = buffer;
        self->capacity = count * chunkSize;
        self->elementSize = chunkSize;
        self->elementCount = count;
        self->allocatedCount = 0U;
        self->isOwned = false;
        self->freeList = NULL;

        uint8_t *ptr = (uint8_t *)self->buffer;
        for (size_t i = 0U; i < count; ++i) {
          MODULE_ITYPE(Memory, PoolNode) *node = (MODULE_ITYPE(Memory, PoolNode) *)(ptr + (i * chunkSize));
          node->next = self->freeList;
          self->freeList = node;
        }

        return STATUS_CONST(SUCCESS);
      })
    ),

    OPERATION(Alloc, (void *outPointerObject), {
      if (!self || !outPointerObject)
        return STATUS_CONST(INVALID_ARGUMENT);

      if (self->freeList == NULL) {
        MODULE_IFUNC(Memory, WritePointer)(outPointerObject, NULL);
        return STATUS_CONST(OUT_OF_MEMORY);
      }

      MODULE_ITYPE(Memory, PoolNode) *node = self->freeList;
      self->freeList = node->next;
      self->allocatedCount++;

      MODULE_IFUNC(Memory, WritePointer)(outPointerObject, node);
      return STATUS_CONST(SUCCESS);
    }),

    VARIANT(Free,
      OPERATION((void *ptr), {
        if (!self || !ptr)
          return STATUS_CONST(INVALID_ARGUMENT);

        uint8_t *bytePtr = (uint8_t *)ptr;
        uint8_t *base = (uint8_t *)self->buffer;
        if (bytePtr < base || bytePtr >= base + self->capacity)
          return STATUS_CONST(INVALID_ARGUMENT);

        size_t offset = (size_t)(bytePtr - base);
        if (offset % self->elementSize != 0U)
          return STATUS_CONST(INVALID_ARGUMENT);

        MODULE_ITYPE(Memory, PoolNode) *node = (MODULE_ITYPE(Memory, PoolNode) *)ptr;
        node->next = self->freeList;
        self->freeList = node;
        if (self->allocatedCount > 0U)
          self->allocatedCount--;

        return STATUS_CONST(SUCCESS);
      }),
      OPERATION(Pointer, (void *inoutPointerObject), {
        void *ptr = NULL;
        OPSTATUS status;

        if (!self || !inoutPointerObject)
          return STATUS_CONST(INVALID_ARGUMENT);

        ptr = MODULE_IFUNC(Memory, ReadPointer)(inoutPointerObject);
        status = MODULE_FUNC(Memory, Pool, Free)(self, ptr);
        if (status == STATUS_CONST(SUCCESS)) {
          MODULE_IFUNC(Memory, WritePointer)(inoutPointerObject, NULL);
        }
        return status;
      })
    ),

    OPERATION(Reset, (), {
      if (!self)
        return STATUS_CONST(INVALID_ARGUMENT);

      self->freeList = NULL;
      self->allocatedCount = 0U;

      if (self->buffer && self->elementSize > 0U) {
        uint8_t *ptr = (uint8_t *)self->buffer;
        for (size_t i = 0U; i < self->elementCount; ++i) {
          MODULE_ITYPE(Memory, PoolNode) *node = (MODULE_ITYPE(Memory, PoolNode) *)(ptr + (i * self->elementSize));
          node->next = self->freeList;
          self->freeList = node;
        }
      }

      return STATUS_CONST(SUCCESS);
    }),

    OPERATION(Destroy, (), {
      if (!self)
        return STATUS_CONST(INVALID_ARGUMENT);

      if (self->buffer && self->isOwned) {
        void *buf = self->buffer;
        MODULE_FUNC(Memory, Alloc, Free)(&buf);
      }
      self->buffer = NULL;

      self->capacity = 0U;
      self->elementSize = 0U;
      self->elementCount = 0U;
      self->allocatedCount = 0U;
      self->isOwned = false;
      self->freeList = NULL;

      return STATUS_CONST(SUCCESS);
    }),

    CONST_PREDICATE(Contains, (const void *ptr), {
      if (!self || !ptr || !self->buffer)
        return false;

      const uint8_t *bytePtr = (const uint8_t *)ptr;
      const uint8_t *base = (const uint8_t *)self->buffer;
      if (bytePtr < base || bytePtr >= base + self->capacity)
        return false;

      size_t offset = (size_t)(bytePtr - base);
      return (offset % self->elementSize == 0U);
    })
  )
);

/* EOF */
