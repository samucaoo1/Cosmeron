#pragma once

OBJECT_OPERATION_IMPLEMENT_EX(STREAM_TYPE(TStream), InitRead, (const void *buffer, size_t size)) {
  if (!self || (!buffer && size > 0U))
    return STATUS_CONST(INVALID_ARGUMENT);

  self->data = (uint8_t *)(uintptr_t)buffer;
  self->capacity = size;
  self->offset = 0U;
  self->bitOffset = 0U;
  self->isReadOnly = true;
  return STATUS_CONST(SUCCESS);
}

OBJECT_OPERATION_IMPLEMENT_EX(STREAM_TYPE(TStream), InitWrite, (void *buffer, size_t capacity)) {
  if (!self || (!buffer && capacity > 0U))
    return STATUS_CONST(INVALID_ARGUMENT);

  self->data = (uint8_t *)buffer;
  self->capacity = capacity;
  self->offset = 0U;
  self->bitOffset = 0U;
  self->isReadOnly = false;
  return STATUS_CONST(SUCCESS);
}

OBJECT_OPERATION_IMPLEMENT_EX(STREAM_TYPE(TStream), AlignToByte, ()) {
  if (!self)
    return STATUS_CONST(INVALID_ARGUMENT);

  if (self->bitOffset > 0U) {
    if (self->offset >= self->capacity)
      return STATUS_CONST(OUT_OF_RANGE);
    self->offset++;
    self->bitOffset = 0U;
  }
  return STATUS_CONST(SUCCESS);
}

OBJECT_OPERATION_IMPLEMENT_EX(STREAM_TYPE(TStream), Seek, (int64_t offset, STREAM_TYPE(SeekOrigin) origin)) {
  if (!self)
    return STATUS_CONST(INVALID_ARGUMENT);

  self->bitOffset = 0U;

  switch (origin) {
  case STREAM_CONST(SEEK_BEGIN):
    if (offset < 0 || (uint64_t)offset > self->capacity)
      return STATUS_CONST(OUT_OF_RANGE);
    self->offset = (size_t)offset;
    return STATUS_CONST(SUCCESS);

  case STREAM_CONST(SEEK_CURRENT):
    if (offset < 0) {
      size_t backward = (size_t)(-offset);
      if (backward > self->offset)
        return STATUS_CONST(OUT_OF_RANGE);
      self->offset -= backward;
    } else {
      size_t forward = (size_t)offset;
      if (forward > self->capacity - self->offset)
        return STATUS_CONST(OUT_OF_RANGE);
      self->offset += forward;
    }
    return STATUS_CONST(SUCCESS);

  case STREAM_CONST(SEEK_END):
    if (offset > 0)
      return STATUS_CONST(OUT_OF_RANGE);
    {
      size_t backward = (size_t)(-offset);
      if (backward > self->capacity)
        return STATUS_CONST(OUT_OF_RANGE);
      self->offset = self->capacity - backward;
    }
    return STATUS_CONST(SUCCESS);

  default:
    return STATUS_CONST(INVALID_ARGUMENT);
  }
}

OBJECT_OPERATION_IMPLEMENT_EX(STREAM_TYPE(TStream), Skip, (size_t count)) {
  OPSTATUS status;
  if (!self)
    return STATUS_CONST(INVALID_ARGUMENT);

  status = STREAM_FUNC(AlignToByte)(self);
  if (status != STATUS_CONST(SUCCESS))
    return status;

  if (count > STREAM_FUNC(Remaining)(self))
    return STATUS_CONST(OUT_OF_RANGE);

  self->offset += count;
  return STATUS_CONST(SUCCESS);
}

OBJECT_OPERATION_IMPLEMENT_EX(STREAM_TYPE(TStream), Rewind, ()) {
  if (!self)
    return STATUS_CONST(INVALID_ARGUMENT);

  self->offset = 0U;
  self->bitOffset = 0U;
  return STATUS_CONST(SUCCESS);
}

OBJECT_OPERATION_IMPLEMENT_EX(STREAM_TYPE(TStream), Slice, (size_t size, STREAM_TYPE(TStream) *outSubStream)) {
  if (!self || !outSubStream)
    return STATUS_CONST(INVALID_ARGUMENT);
  if (self->bitOffset != 0U)
    return STATUS_CONST(INVALID_ARGUMENT);
  if (size > STREAM_FUNC(Remaining)(self))
    return STATUS_CONST(OUT_OF_RANGE);

  STREAM_FUNC(Init)(outSubStream);
  outSubStream->data = self->data ? (self->data + self->offset) : NULL;
  outSubStream->capacity = size;
  outSubStream->offset = 0U;
  outSubStream->bitOffset = 0U;
  outSubStream->isReadOnly = self->isReadOnly;
  return STATUS_CONST(SUCCESS);
}

OBJECT_OPERATION_IMPLEMENT_EX(STREAM_TYPE(TStream), ReadSlice, (size_t size, STREAM_TYPE(TStream) *outSubStream)) {
  OPSTATUS status = STREAM_FUNC(Slice)(self, size, outSubStream);
  if (status != STATUS_CONST(SUCCESS))
    return status;

  self->offset += size;
  return STATUS_CONST(SUCCESS);
}

OBJECT_OPERATION_IMPLEMENT_EX(STREAM_TYPE(TStream), ReadBytes, (void *destination, size_t size)) {
  OPSTATUS status;
  if (!self || (!destination && size > 0U))
    return STATUS_CONST(INVALID_ARGUMENT);

  status = STREAM_FUNC(AlignToByte)(self);
  if (status != STATUS_CONST(SUCCESS))
    return status;

  if (size > STREAM_FUNC(Remaining)(self))
    return STATUS_CONST(OUT_OF_RANGE);

  if (size > 0U)
    memcpy(destination, self->data + self->offset, size);
  self->offset += size;
  return STATUS_CONST(SUCCESS);
}

OBJECT_OPERATION_IMPLEMENT_EX(STREAM_TYPE(TStream), PeekBytes, (void *destination, size_t size)) {
  if (!self || (!destination && size > 0U))
    return STATUS_CONST(INVALID_ARGUMENT);
  if (self->bitOffset != 0U)
    return STATUS_CONST(INVALID_ARGUMENT);
  if (size > STREAM_FUNC(Remaining)(self))
    return STATUS_CONST(OUT_OF_RANGE);

  if (size > 0U)
    memcpy(destination, self->data + self->offset, size);
  return STATUS_CONST(SUCCESS);
}

OBJECT_OPERATION_IMPLEMENT_EX(STREAM_TYPE(TStream), ReadBits, (uint8_t bitCount, uint64_t *outValue)) {
  uint64_t result = 0U;
  if (!self || !outValue || bitCount == 0U || bitCount > 64U)
    return STATUS_CONST(INVALID_ARGUMENT);

  if (!STREAM_FUNC(HasRemainingBits)(self, bitCount))
    return STATUS_CONST(OUT_OF_RANGE);

  for (uint8_t i = 0U; i < bitCount; ++i) {
    uint8_t byteVal = self->data[self->offset];
    uint8_t bit = (uint8_t)((byteVal >> (7U - self->bitOffset)) & 1U);
    result = (result << 1U) | (uint64_t)bit;

    self->bitOffset++;
    if (self->bitOffset == 8U) {
      self->offset++;
      self->bitOffset = 0U;
    }
  }

  *outValue = result;
  return STATUS_CONST(SUCCESS);
}

OBJECT_OPERATION_IMPLEMENT_EX(STREAM_TYPE(TStream), WriteBits, (uint64_t value, uint8_t bitCount)) {
  if (!self || bitCount == 0U || bitCount > 64U)
    return STATUS_CONST(INVALID_ARGUMENT);
  if (self->isReadOnly)
    return STATUS_CONST(NOT_SUPPORTED);

  if (!STREAM_FUNC(HasRemainingBits)(self, bitCount))
    return STATUS_CONST(INSUFFICIENT_SPACE);

  for (uint8_t i = 0U; i < bitCount; ++i) {
    uint8_t shift = (uint8_t)(bitCount - 1U - i);
    uint8_t bit = (uint8_t)((value >> shift) & 1U);

    if (self->bitOffset == 0U)
      self->data[self->offset] = 0U;

    self->data[self->offset] |= (uint8_t)(bit << (7U - self->bitOffset));

    self->bitOffset++;
    if (self->bitOffset == 8U) {
      self->offset++;
      self->bitOffset = 0U;
    }
  }

  return STATUS_CONST(SUCCESS);
}

OBJECT_OPERATION_IMPLEMENT_EX(STREAM_TYPE(TStream), WriteBytes, (const void *source, size_t size)) {
  OPSTATUS status;
  if (!self || (!source && size > 0U))
    return STATUS_CONST(INVALID_ARGUMENT);
  if (self->isReadOnly)
    return STATUS_CONST(NOT_SUPPORTED);

  status = STREAM_FUNC(AlignToByte)(self);
  if (status != STATUS_CONST(SUCCESS))
    return status;

  if (size > STREAM_FUNC(Remaining)(self))
    return STATUS_CONST(INSUFFICIENT_SPACE);

  if (size > 0U)
    memcpy(self->data + self->offset, source, size);
  self->offset += size;
  return STATUS_CONST(SUCCESS);
}

OBJECT_OPERATION_IMPLEMENT_EX(STREAM_TYPE(TStream), ReadUInt8, (uint8_t *outValue)) {
  OPSTATUS status;
  if (!self || !outValue)
    return STATUS_CONST(INVALID_ARGUMENT);

  status = STREAM_FUNC(AlignToByte)(self);
  if (status != STATUS_CONST(SUCCESS))
    return status;

  if (self->offset >= self->capacity)
    return STATUS_CONST(OUT_OF_RANGE);

  *outValue = self->data[self->offset++];
  return STATUS_CONST(SUCCESS);
}

OBJECT_OPERATION_IMPLEMENT_EX(STREAM_TYPE(TStream), ReadInt8, (int8_t *outValue)) {
  uint8_t rawVal = 0U;
  OPSTATUS status;
  if (!outValue)
    return STATUS_CONST(INVALID_ARGUMENT);

  status = STREAM_FUNC(ReadUInt8)(self, &rawVal);
  if (status != STATUS_CONST(SUCCESS))
    return status;

  *outValue = (int8_t)rawVal;
  return STATUS_CONST(SUCCESS);
}

OBJECT_OPERATION_IMPLEMENT_EX(STREAM_TYPE(TStream), PeekUInt8, (uint8_t *outValue)) {
  if (!self || !outValue)
    return STATUS_CONST(INVALID_ARGUMENT);
  if (self->bitOffset != 0U)
    return STATUS_CONST(INVALID_ARGUMENT);
  if (self->offset >= self->capacity)
    return STATUS_CONST(OUT_OF_RANGE);

  *outValue = self->data[self->offset];
  return STATUS_CONST(SUCCESS);
}

OBJECT_OPERATION_IMPLEMENT_EX(STREAM_TYPE(TStream), WriteUInt8, (uint8_t value)) {
  OPSTATUS status;
  if (!self)
    return STATUS_CONST(INVALID_ARGUMENT);
  if (self->isReadOnly)
    return STATUS_CONST(NOT_SUPPORTED);

  status = STREAM_FUNC(AlignToByte)(self);
  if (status != STATUS_CONST(SUCCESS))
    return status;

  if (self->offset >= self->capacity)
    return STATUS_CONST(INSUFFICIENT_SPACE);

  self->data[self->offset++] = value;
  return STATUS_CONST(SUCCESS);
}

OBJECT_OPERATION_IMPLEMENT_EX(STREAM_TYPE(TStream), WriteInt8, (int8_t value)) {
  return STREAM_FUNC(WriteUInt8)(self, (uint8_t)value);
}

/* Multi-byte scalar implementation */
#define STREAM_IMPL_SCALAR_LE_BE(UTYPE, ITYPE, SUFFIX)                         \
  OBJECT_OPERATION_IMPLEMENT_EX(STREAM_TYPE(TStream), PP_OP_CAT3(ReadUInt, SUFFIX, LE), (UTYPE *outValue)) { \
    const uint8_t *b;                                                          \
    UTYPE val = 0U;                                                            \
    if (!self || !outValue) return STATUS_CONST(INVALID_ARGUMENT);             \
    if (STREAM_FUNC(AlignToByte)(self) != STATUS_CONST(SUCCESS)) return STATUS_CONST(OUT_OF_RANGE); \
    if (STREAM_FUNC(Remaining)(self) < sizeof(UTYPE)) return STATUS_CONST(OUT_OF_RANGE); \
    b = self->data + self->offset;                                             \
    for (size_t i = 0U; i < sizeof(UTYPE); ++i) {                              \
      val |= ((UTYPE)b[i]) << (i * 8U);                                        \
    }                                                                          \
    *outValue = val;                                                           \
    self->offset += sizeof(UTYPE);                                             \
    return STATUS_CONST(SUCCESS);                                              \
  }                                                                            \
  OBJECT_OPERATION_IMPLEMENT_EX(STREAM_TYPE(TStream), PP_OP_CAT3(ReadUInt, SUFFIX, BE), (UTYPE *outValue)) { \
    const uint8_t *b;                                                          \
    UTYPE val = 0U;                                                            \
    if (!self || !outValue) return STATUS_CONST(INVALID_ARGUMENT);             \
    if (STREAM_FUNC(AlignToByte)(self) != STATUS_CONST(SUCCESS)) return STATUS_CONST(OUT_OF_RANGE); \
    if (STREAM_FUNC(Remaining)(self) < sizeof(UTYPE)) return STATUS_CONST(OUT_OF_RANGE); \
    b = self->data + self->offset;                                             \
    for (size_t i = 0U; i < sizeof(UTYPE); ++i) {                              \
      val = (UTYPE)((val << 8U) | (UTYPE)b[i]);                               \
    }                                                                          \
    *outValue = val;                                                           \
    self->offset += sizeof(UTYPE);                                             \
    return STATUS_CONST(SUCCESS);                                              \
  }                                                                            \
  OBJECT_OPERATION_IMPLEMENT_EX(STREAM_TYPE(TStream), PP_OP_CAT3(ReadInt, SUFFIX, LE), (ITYPE *outValue)) { \
    UTYPE rawVal = 0U;                                                         \
    OPSTATUS status;                                                           \
    if (!outValue) return STATUS_CONST(INVALID_ARGUMENT);                      \
    status = STREAM_FUNC(PP_OP_CAT3(ReadUInt, SUFFIX, LE))(self, &rawVal);     \
    if (status != STATUS_CONST(SUCCESS)) return status;                        \
    *outValue = (ITYPE)rawVal;                                                 \
    return STATUS_CONST(SUCCESS);                                              \
  }                                                                            \
  OBJECT_OPERATION_IMPLEMENT_EX(STREAM_TYPE(TStream), PP_OP_CAT3(ReadInt, SUFFIX, BE), (ITYPE *outValue)) { \
    UTYPE rawVal = 0U;                                                         \
    OPSTATUS status;                                                           \
    if (!outValue) return STATUS_CONST(INVALID_ARGUMENT);                      \
    status = STREAM_FUNC(PP_OP_CAT3(ReadUInt, SUFFIX, BE))(self, &rawVal);     \
    if (status != STATUS_CONST(SUCCESS)) return status;                        \
    *outValue = (ITYPE)rawVal;                                                 \
    return STATUS_CONST(SUCCESS);                                              \
  }                                                                            \
  OBJECT_OPERATION_IMPLEMENT_EX(STREAM_TYPE(TStream), PP_OP_CAT3(WriteUInt, SUFFIX, LE), (UTYPE value)) { \
    uint8_t *b;                                                                \
    if (!self) return STATUS_CONST(INVALID_ARGUMENT);                          \
    if (self->isReadOnly) return STATUS_CONST(NOT_SUPPORTED);                  \
    if (STREAM_FUNC(AlignToByte)(self) != STATUS_CONST(SUCCESS)) return STATUS_CONST(INSUFFICIENT_SPACE); \
    if (STREAM_FUNC(Remaining)(self) < sizeof(UTYPE)) return STATUS_CONST(INSUFFICIENT_SPACE); \
    b = self->data + self->offset;                                             \
    for (size_t i = 0U; i < sizeof(UTYPE); ++i) {                              \
      b[i] = (uint8_t)((value >> (i * 8U)) & 0xFFU);                           \
    }                                                                          \
    self->offset += sizeof(UTYPE);                                             \
    return STATUS_CONST(SUCCESS);                                              \
  }                                                                            \
  OBJECT_OPERATION_IMPLEMENT_EX(STREAM_TYPE(TStream), PP_OP_CAT3(WriteUInt, SUFFIX, BE), (UTYPE value)) { \
    uint8_t *b;                                                                \
    if (!self) return STATUS_CONST(INVALID_ARGUMENT);                          \
    if (self->isReadOnly) return STATUS_CONST(NOT_SUPPORTED);                  \
    if (STREAM_FUNC(AlignToByte)(self) != STATUS_CONST(SUCCESS)) return STATUS_CONST(INSUFFICIENT_SPACE); \
    if (STREAM_FUNC(Remaining)(self) < sizeof(UTYPE)) return STATUS_CONST(INSUFFICIENT_SPACE); \
    b = self->data + self->offset;                                             \
    for (size_t i = 0U; i < sizeof(UTYPE); ++i) {                              \
      size_t shift = (sizeof(UTYPE) - 1U - i) * 8U;                            \
      b[i] = (uint8_t)((value >> shift) & 0xFFU);                              \
    }                                                                          \
    self->offset += sizeof(UTYPE);                                             \
    return STATUS_CONST(SUCCESS);                                              \
  }                                                                            \
  OBJECT_OPERATION_IMPLEMENT_EX(STREAM_TYPE(TStream), PP_OP_CAT3(WriteInt, SUFFIX, LE), (ITYPE value)) { \
    return STREAM_FUNC(PP_OP_CAT3(WriteUInt, SUFFIX, LE))(self, (UTYPE)value); \
  }                                                                            \
  OBJECT_OPERATION_IMPLEMENT_EX(STREAM_TYPE(TStream), PP_OP_CAT3(WriteInt, SUFFIX, BE), (ITYPE value)) { \
    return STREAM_FUNC(PP_OP_CAT3(WriteUInt, SUFFIX, BE))(self, (UTYPE)value); \
  }

STREAM_IMPL_SCALAR_LE_BE(uint16_t, int16_t, 16)
STREAM_IMPL_SCALAR_LE_BE(uint32_t, int32_t, 32)
STREAM_IMPL_SCALAR_LE_BE(uint64_t, int64_t, 64)

OBJECT_IMPLEMENT(STREAM_TYPE(TStream));

/* EOF */
