/* IntrusivePtr.def - Dual Mode Engine (Zero Duplication) */

#ifndef INTRUSIVE_REF_COUNT_FIELD
#define INTRUSIVE_REF_COUNT_FIELD size_t refCount;
#endif

#ifndef TEMPLATE_Memory_IntrusivePtr
#define TEMPLATE_Memory_IntrusivePtr(SUFFIX, TYPE)                              \
  TEMPLATE_OBJECT(Memory, IntrusivePtr, SUFFIX,                                 \
      FIELDS(                                                                   \
          TYPE *ptr;                                                            \
      ),                                                                        \
                                                                                \
      PROCEDURE_INLINE(Free, (), {                                              \
        if (self && self->ptr != NULL) {                                        \
          if (self->ptr->refCount > 0U) {                                       \
            self->ptr->refCount--;                                              \
          }                                                                     \
          if (self->ptr->refCount == 0U) {                                      \
            void *raw = (void *)self->ptr;                                      \
            self->ptr = NULL;                                                   \
            MODULE_FUNC(Memory, Alloc, Free)(&raw);                             \
          }                                                                     \
          self->ptr = NULL;                                                     \
        }                                                                       \
      }),                                                                       \
                                                                                \
      OPERATION_INLINE(FromPointer, (TYPE * rawPtr), {                          \
        if (!self)                                                              \
          return STATUS_CONST(INVALID_ARGUMENT);                                \
        MODULE_FUNC(Memory, IntrusivePtr, SUFFIX, Init)(self);                  \
        if (rawPtr != NULL) {                                                   \
          rawPtr->refCount = 1U;                                                \
          self->ptr = rawPtr;                                                   \
        }                                                                       \
        return STATUS_CONST(SUCCESS);                                           \
      }),                                                                       \
                                                                                \
      OPERATION_INLINE(FromExistingPointer, (TYPE * rawPtr), {                  \
        if (!self)                                                              \
          return STATUS_CONST(INVALID_ARGUMENT);                                \
        MODULE_FUNC(Memory, IntrusivePtr, SUFFIX, Init)(self);                  \
        if (rawPtr != NULL) {                                                   \
          rawPtr->refCount++;                                                   \
          self->ptr = rawPtr;                                                   \
        }                                                                       \
        return STATUS_CONST(SUCCESS);                                           \
      }),                                                                       \
                                                                                \
      CONST_OPERATION_INLINE(Clone,                                             \
                       (struct MODULE_TYPED(Memory, IntrusivePtr, SUFFIX) *     \
                        outIntrusive),                                          \
                       {                                                        \
                         if (!self || !outIntrusive)                            \
                           return STATUS_CONST(INVALID_ARGUMENT);               \
                         MODULE_FUNC(Memory, IntrusivePtr, SUFFIX, Init)(       \
                             outIntrusive);                                     \
                         if (self->ptr != NULL) {                               \
                           self->ptr->refCount++;                               \
                           outIntrusive->ptr = self->ptr;                       \
                         }                                                      \
                         return STATUS_CONST(SUCCESS);                          \
                       }),                                                      \
                                                                                \
      OPERATION_INLINE(Reset, (TYPE * newPtr), {                                \
        if (!self)                                                              \
          return STATUS_CONST(INVALID_ARGUMENT);                                \
        MODULE_FUNC(Memory, IntrusivePtr, SUFFIX, Free)(self);                  \
        return MODULE_FUNC(Memory, IntrusivePtr, SUFFIX, FromPointer)(self,     \
                                                                      newPtr);  \
      }),                                                                       \
                                                                                \
      OPERATION_INLINE(Move,                                                    \
                       (struct MODULE_TYPED(Memory, IntrusivePtr, SUFFIX) *     \
                        other),                                                 \
                       {                                                        \
                         if (!self || !other)                                   \
                           return STATUS_CONST(INVALID_ARGUMENT);               \
                         if (self == other)                                     \
                           return STATUS_CONST(SUCCESS);                        \
                         MODULE_FUNC(Memory, IntrusivePtr, SUFFIX, Free)(       \
                             self);                                             \
                         self->ptr = other->ptr;                                \
                         other->ptr = NULL;                                     \
                         return STATUS_CONST(SUCCESS);                          \
                       }),                                                      \
                                                                                \
      OPERATION_INLINE(Release, (TYPE * *outPtr), {                             \
        if (!self || !outPtr)                                                   \
          return STATUS_CONST(INVALID_ARGUMENT);                                \
        *outPtr = self->ptr;                                                    \
        self->ptr = NULL;                                                       \
        return STATUS_CONST(SUCCESS);                                           \
      }),                                                                       \
                                                                                \
      CONST_PREDICATE_INLINE(IsValid, (), {                                     \
        return (self && self->ptr != NULL && self->ptr->refCount > 0U);         \
      }),                                                                       \
                                                                                \
      CONST_FUNCTION_INLINE(const TYPE *, Get, (), {                            \
        return self ? self->ptr : NULL;                                         \
      }),                                                                       \
                                                                                \
      FUNCTION_INLINE(TYPE *, GetMutable, (), {                                 \
        return self ? self->ptr : NULL;                                         \
      }),                                                                       \
                                                                                \
      CONST_FUNCTION_INLINE(size_t, UseCount, (), {                             \
        return (self && self->ptr) ? self->ptr->refCount : 0U;                  \
      }),                                                                       \
                                                                                \
      CONST_PREDICATE_INLINE(Unique, (), {                                      \
        return (self && self->ptr && self->ptr->refCount == 1U);                \
      }),                                                                       \
                                                                                \
      PROCEDURE_INLINE(Swap,                                                    \
                       (struct MODULE_TYPED(Memory, IntrusivePtr, SUFFIX) *     \
                        other),                                                 \
                       {                                                        \
                         if (!self || !other || self == other)                  \
                           return;                                              \
                         TYPE *temporary = self->ptr;                           \
                         self->ptr = other->ptr;                                \
                         other->ptr = temporary;                                \
                       })                                                       \
  )
#define TEMPLATE_IntrusivePtr(SUFFIX, TYPE)                                    \
  TEMPLATE_Memory_IntrusivePtr(SUFFIX, TYPE)
#endif

/* Mode 2 (Direct Include): Auto-instantiates and cleans up environment */
#if defined(SUFFIX) && defined(TYPE)
  TEMPLATE_Memory_IntrusivePtr(SUFFIX, TYPE);
  #undef SUFFIX
  #undef TYPE
#endif
