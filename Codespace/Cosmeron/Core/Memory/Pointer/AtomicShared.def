/* AtomicShared.def - Dual Mode Engine (Zero Duplication) */

#include "Impl/Common.inc"
#define COSMERON_INTERNAL_NO_AUTO_INSTANTIATE 1
#include "AtomicWeak.def"
#undef COSMERON_INTERNAL_NO_AUTO_INSTANTIATE

#ifndef TEMPLATE_Pointer_AtomicShared
#define TEMPLATE_Pointer_AtomicShared(SUFFIX, TYPE)                           \
  FORWARD_TEMPLATE_OBJECT(Pointer, AtomicWeak, SUFFIX);                       \
  TEMPLATE_OBJECT(Pointer, AtomicShared, SUFFIX,                              \
      FIELDS(                                                                   \
          TYPE *ptr;                                                            \
          MODULE_ITYPE(Memory, SharedControlBlockAtomic) *control;              \
      ),                                                                        \
                                                                                \
      VARIANT(From,                                                             \
          OPERATION_INLINE(Pointer, (TYPE *rawPtr), {                           \
            if (!self) {                                                        \
              return STATUS_CONST(INVALID_ARGUMENT);                            \
            }                                                                   \
            MODULE_FUNC(Pointer, AtomicShared, SUFFIX, Init)(self);           \
            MODULE_ITYPE(Memory, SharedControlBlockAtomic) *cb = NULL;          \
            OPSTATUS status = MODULE_IFUNC(Memory, AtomicControlCreate)(        \
                (void *)rawPtr, &cb);                                           \
            if (status != STATUS_CONST(SUCCESS)) {                              \
              return status;                                                    \
            }                                                                   \
            self->ptr = rawPtr;                                                 \
            self->control = cb;                                                 \
            return STATUS_CONST(SUCCESS);                                       \
          }),                                                                   \
                                                                                \
          OPERATION_INLINE(                                                     \
              Weak,                                                             \
              (const struct MODULE_TYPED(Pointer, AtomicWeak, SUFFIX) *weak), \
              {                                                                 \
                if (!self || !weak) {                                           \
                  return STATUS_CONST(INVALID_ARGUMENT);                        \
                }                                                               \
                MODULE_FUNC(Pointer, AtomicShared, SUFFIX, Init)(self);       \
                void *rawPtr = NULL;                                            \
                OPSTATUS status = MODULE_IFUNC(Memory, AtomicControlTryUpgrade)(\
                    weak->control, &rawPtr);                                    \
                if (status != STATUS_CONST(SUCCESS)) {                          \
                  return status;                                                \
                }                                                               \
                self->ptr = (TYPE *)rawPtr;                                     \
                self->control = weak->control;                                  \
                return STATUS_CONST(SUCCESS);                                   \
              })                                                                \
      ),                                                                        \
                                                                                \
      VARIANT(Reset,                                                            \
          OPERATION_INLINE((), {                                                \
            if (!self) {                                                        \
              return STATUS_CONST(INVALID_ARGUMENT);                            \
            }                                                                   \
            if (self->control != NULL) {                                        \
              MODULE_IFUNC(Memory, AtomicControlReleaseStrong)(self->control);  \
              self->ptr = NULL;                                                 \
              self->control = NULL;                                             \
            }                                                                   \
            return STATUS_CONST(SUCCESS);                                       \
          }),                                                                   \
                                                                                \
          OPERATION_INLINE(WithPointer, (TYPE *newPtr), {                       \
            if (!self) {                                                        \
              return STATUS_CONST(INVALID_ARGUMENT);                            \
            }                                                                   \
            MODULE_FUNC(Pointer, AtomicShared, SUFFIX, Reset)(self);          \
            return MODULE_FUNC(Pointer, AtomicShared, SUFFIX, FromPointer)(   \
                self, newPtr);                                                  \
          })                                                                    \
      ),                                                                        \
                                                                                \
      PROCEDURE_INLINE(Free, (), {                                              \
        if (self) {                                                             \
          MODULE_FUNC(Pointer, AtomicShared, SUFFIX, Reset)(self);            \
        }                                                                       \
      }),                                                                       \
                                                                                \
      VARIANT(Alloc,                                                            \
          OPERATION_INLINE((TYPE value), {                                      \
            if (!self) {                                                        \
              return STATUS_CONST(INVALID_ARGUMENT);                            \
            }                                                                   \
            void *valRaw = NULL;                                                \
            OPSTATUS status =                                                   \
                MODULE_FUNC(Memory, Alloc, Bytes)(&valRaw, sizeof(TYPE));       \
            if (status != STATUS_CONST(SUCCESS)) {                              \
              return status;                                                    \
            }                                                                   \
            *(TYPE *)valRaw = value;                                            \
            status = MODULE_FUNC(Pointer, AtomicShared, SUFFIX, FromPointer)( \
                self, (TYPE *)valRaw);                                          \
            if (status != STATUS_CONST(SUCCESS)) {                              \
              MODULE_FUNC(Memory, Alloc, Free)(&valRaw);                        \
              return status;                                                    \
            }                                                                   \
            return STATUS_CONST(SUCCESS);                                       \
          }),                                                                   \
                                                                                \
          OPERATION_INLINE(Zero, (), {                                          \
            if (!self) {                                                        \
              return STATUS_CONST(INVALID_ARGUMENT);                            \
            }                                                                   \
            void *valRaw = NULL;                                                \
            OPSTATUS status =                                                   \
                MODULE_FUNC(Memory, Alloc, ZeroBytes)(&valRaw, sizeof(TYPE));   \
            if (status != STATUS_CONST(SUCCESS)) {                              \
              return status;                                                    \
            }                                                                   \
            status = MODULE_FUNC(Pointer, AtomicShared, SUFFIX, FromPointer)( \
                self, (TYPE *)valRaw);                                          \
            if (status != STATUS_CONST(SUCCESS)) {                              \
              MODULE_FUNC(Memory, Alloc, Free)(&valRaw);                        \
              return status;                                                    \
            }                                                                   \
            return STATUS_CONST(SUCCESS);                                       \
          })                                                                    \
      ),                                                                        \
                                                                                \
      CONST_OPERATION_INLINE(                                                   \
          Clone,                                                                \
          (struct MODULE_TYPED(Pointer, AtomicShared, SUFFIX) *outShared),    \
          {                                                                     \
            if (!self || !outShared) {                                          \
              return STATUS_CONST(INVALID_ARGUMENT);                            \
            }                                                                   \
            MODULE_FUNC(Pointer, AtomicShared, SUFFIX, Init)(outShared);      \
            if (self->control != NULL) {                                        \
              MODULE_IFUNC(Memory, AtomicControlRetainStrong)(self->control);   \
              outShared->ptr = self->ptr;                                       \
              outShared->control = self->control;                               \
            }                                                                   \
            return STATUS_CONST(SUCCESS);                                       \
          }),                                                                   \
                                                                                \
      OPERATION_INLINE(                                                         \
          Move,                                                                 \
          (struct MODULE_TYPED(Pointer, AtomicShared, SUFFIX) *other),        \
          {                                                                     \
            if (!self || !other) {                                              \
              return STATUS_CONST(INVALID_ARGUMENT);                            \
            }                                                                   \
            if (self == other) {                                                \
              return STATUS_CONST(SUCCESS);                                     \
            }                                                                   \
            MODULE_FUNC(Pointer, AtomicShared, SUFFIX, Free)(self);           \
            self->ptr = other->ptr;                                             \
            self->control = other->control;                                     \
            other->ptr = NULL;                                                  \
            other->control = NULL;                                              \
            return STATUS_CONST(SUCCESS);                                       \
          }),                                                                   \
                                                                                \
      CONST_PREDICATE_INLINE(IsValid, (), {                                     \
        if (!self || !self->ptr) {                                              \
          return false;                                                         \
        }                                                                       \
        return MODULE_IFUNC(Memory, AtomicControlStrongCount)(self->control) >  \
               0U;                                                              \
      }),                                                                       \
                                                                                \
      VARIANT(Get,                                                              \
          CONST_FUNCTION_INLINE(const TYPE *, (), {                             \
            return self ? self->ptr : NULL;                                     \
          }),                                                                   \
                                                                                \
          FUNCTION_INLINE(TYPE *, Mutable, (), {                                \
            return self ? self->ptr : NULL;                                     \
          })                                                                    \
      ),                                                                        \
                                                                                \
      CONST_FUNCTION_INLINE(size_t, UseCount, (), {                             \
        return MODULE_IFUNC(Memory, AtomicControlStrongCount)(                  \
            self ? self->control : NULL);                                       \
      }),                                                                       \
                                                                                \
      CONST_PREDICATE_INLINE(Unique, (), {                                      \
        return MODULE_FUNC(Pointer, AtomicShared, SUFFIX, UseCount)(self) ==  \
               1U;                                                              \
      }),                                                                       \
                                                                                \
      CONST_OPERATION_INLINE(                                                   \
          Downgrade,                                                            \
          (struct MODULE_TYPED(Pointer, AtomicWeak, SUFFIX) *outWeak),        \
          {                                                                     \
            if (!self || !outWeak) {                                            \
              return STATUS_CONST(INVALID_ARGUMENT);                            \
            }                                                                   \
            MODULE_FUNC(Pointer, AtomicWeak, SUFFIX, Init)(outWeak);          \
            if (!self->control) {                                               \
              return STATUS_CONST(SUCCESS);                                     \
            }                                                                   \
            MODULE_IFUNC(Memory, AtomicControlRetainWeak)(self->control);       \
            outWeak->ptr = self->ptr;                                           \
            outWeak->control = self->control;                                   \
            return STATUS_CONST(SUCCESS);                                       \
          }),                                                                   \
                                                                                \
      PROCEDURE_INLINE(                                                         \
          Swap,                                                                 \
          (struct MODULE_TYPED(Pointer, AtomicShared, SUFFIX) *other),        \
          {                                                                     \
            if (!self || !other || self == other) {                             \
              return;                                                           \
            }                                                                   \
            TYPE *tempPtr = self->ptr;                                          \
            MODULE_ITYPE(Memory, SharedControlBlockAtomic) *tempCb =            \
                self->control;                                                  \
            self->ptr = other->ptr;                                             \
            self->control = other->control;                                     \
            other->ptr = tempPtr;                                               \
            other->control = tempCb;                                            \
          })                                                                    \
  );                                                                            \
  OBJECT_OPERATION_IMPLEMENT_EX(                                                \
      MODULE_NS(Pointer, AtomicWeak, SUFFIX), Upgrade,                        \
      (struct MODULE_TYPED(Pointer, AtomicShared, SUFFIX) *outShared)) {      \
    return MODULE_FUNC(Pointer, AtomicShared, SUFFIX, FromWeak)(outShared,    \
                                                                  self);        \
  }                                                                             \
  typedef int NS(_cosmeron_semi_shared_atomic_, SUFFIX, __LINE__)
#define TEMPLATE_AtomicShared(SUFFIX, TYPE)                                  \
  TEMPLATE_Pointer_AtomicShared(SUFFIX, TYPE);
#endif

/* Mode 2 (Direct Include): Auto-instantiates and cleans up environment */
#if (!defined(COSMERON_INTERNAL_NO_AUTO_INSTANTIATE) && !defined(COSMERON_INTERNAL_IN_COMMON_INC)) && defined(SUFFIX) && defined(TYPE)
  TEMPLATE_Pointer_AtomicShared(SUFFIX, TYPE);
  #undef SUFFIX
  #undef TYPE
#endif
