/* SharedPtr.def - Dual Mode Engine (Zero Duplication) */

#ifndef TEMPLATE_Memory_SharedPtr
#define TEMPLATE_Memory_SharedPtr(SUFFIX, TYPE)                                 \
  FORWARD_TEMPLATE_OBJECT(Memory, WeakPtr, SUFFIX);                             \
  TEMPLATE_OBJECT(Memory, SharedPtr, SUFFIX,                                    \
      FIELDS(                                                                   \
          TYPE *ptr;                                                            \
          MODULE_ITYPE(Memory, SharedControlBlock) *control;                    \
      ),                                                                        \
                                                                                \
      OPERATION_INLINE(Reset, (), {                                             \
        if (!self)                                                              \
          return STATUS_CONST(INVALID_ARGUMENT);                                \
        if (self->control != NULL) {                                            \
          if (self->control->strongCount > 0U) {                                \
            self->control->strongCount--;                                       \
          }                                                                     \
          if (self->control->strongCount == 0U) {                               \
            void *rawPtr = self->control->managedPointer;                       \
            self->control->managedPointer = NULL;                               \
            if (rawPtr != NULL) {                                               \
              MODULE_FUNC(Memory, Alloc, Free)(&rawPtr);                        \
            }                                                                   \
            if (self->control->weakCount == 0U) {                               \
              void *cbRaw = (void *)self->control;                              \
              self->control = NULL;                                             \
              MODULE_FUNC(Memory, Alloc, Free)(&cbRaw);                         \
            }                                                                   \
          }                                                                     \
          self->ptr = NULL;                                                     \
          self->control = NULL;                                                 \
        }                                                                       \
        return STATUS_CONST(SUCCESS);                                           \
      }),                                                                       \
                                                                                \
      PROCEDURE_INLINE(Free, (), {                                              \
        if (self) {                                                             \
          MODULE_FUNC(Memory, SharedPtr, SUFFIX, Reset)(self);                  \
        }                                                                       \
      }),                                                                       \
                                                                                \
      OPERATION_INLINE(FromPointer, (TYPE * rawPtr), {                          \
        if (!self)                                                              \
          return STATUS_CONST(INVALID_ARGUMENT);                                \
        MODULE_FUNC(Memory, SharedPtr, SUFFIX, Init)(self);                     \
        void *cbRaw = NULL;                                                     \
        OPSTATUS status = MODULE_FUNC(Memory, Alloc, Bytes)(                    \
            &cbRaw, sizeof(MODULE_ITYPE(Memory, SharedControlBlock)));          \
        if (status != STATUS_CONST(SUCCESS))                                    \
          return status;                                                        \
        MODULE_ITYPE(Memory, SharedControlBlock) *cb =                          \
            (MODULE_ITYPE(Memory, SharedControlBlock) *)cbRaw;                  \
        cb->strongCount = 1U;                                                   \
        cb->weakCount = 0U;                                                     \
        cb->managedPointer = (void *)rawPtr;                                    \
        self->ptr = rawPtr;                                                     \
        self->control = cb;                                                     \
        return STATUS_CONST(SUCCESS);                                           \
      }),                                                                       \
                                                                                \
      OPERATION_INLINE(Alloc, (TYPE value), {                                   \
        if (!self)                                                              \
          return STATUS_CONST(INVALID_ARGUMENT);                                \
        MODULE_FUNC(Memory, SharedPtr, SUFFIX, Init)(self);                     \
        void *valRaw = NULL;                                                    \
        OPSTATUS status =                                                       \
            MODULE_FUNC(Memory, Alloc, Bytes)(&valRaw, sizeof(TYPE));           \
        if (status != STATUS_CONST(SUCCESS))                                    \
          return status;                                                        \
        *(TYPE *)valRaw = value;                                                \
        status = MODULE_FUNC(Memory, SharedPtr, SUFFIX, FromPointer)(           \
            self, (TYPE *)valRaw);                                              \
        if (status != STATUS_CONST(SUCCESS)) {                                  \
          MODULE_FUNC(Memory, Alloc, Free)(&valRaw);                            \
          return status;                                                        \
        }                                                                       \
        return STATUS_CONST(SUCCESS);                                           \
      }),                                                                       \
                                                                                \
      OPERATION_INLINE(AllocZero, (), {                                         \
        if (!self)                                                              \
          return STATUS_CONST(INVALID_ARGUMENT);                                \
        MODULE_FUNC(Memory, SharedPtr, SUFFIX, Init)(self);                     \
        void *valRaw = NULL;                                                    \
        OPSTATUS status =                                                       \
            MODULE_FUNC(Memory, Alloc, ZeroBytes)(&valRaw, sizeof(TYPE));       \
        if (status != STATUS_CONST(SUCCESS))                                    \
          return status;                                                        \
        status = MODULE_FUNC(Memory, SharedPtr, SUFFIX, FromPointer)(           \
            self, (TYPE *)valRaw);                                              \
        if (status != STATUS_CONST(SUCCESS)) {                                  \
          MODULE_FUNC(Memory, Alloc, Free)(&valRaw);                            \
          return status;                                                        \
        }                                                                       \
        return STATUS_CONST(SUCCESS);                                           \
      }),                                                                       \
                                                                                \
      CONST_OPERATION_INLINE(Clone,                                             \
                       (struct MODULE_TYPED(Memory, SharedPtr, SUFFIX) *        \
                        outShared),                                             \
                       {                                                        \
                         if (!self || !outShared)                               \
                           return STATUS_CONST(INVALID_ARGUMENT);               \
                         MODULE_FUNC(Memory, SharedPtr, SUFFIX, Init)(          \
                             outShared);                                        \
                         if (self->control != NULL) {                           \
                           self->control->strongCount++;                        \
                           outShared->ptr = self->ptr;                          \
                           outShared->control = self->control;                  \
                         }                                                      \
                         return STATUS_CONST(SUCCESS);                          \
                       }),                                                      \
                                                                                \
      OPERATION_INLINE(Move,                                                    \
                       (struct MODULE_TYPED(Memory, SharedPtr, SUFFIX) *        \
                        other),                                                 \
                       {                                                        \
                         if (!self || !other)                                   \
                           return STATUS_CONST(INVALID_ARGUMENT);               \
                         if (self == other)                                     \
                           return STATUS_CONST(SUCCESS);                        \
                         MODULE_FUNC(Memory, SharedPtr, SUFFIX, Free)(self);    \
                         self->ptr = other->ptr;                                \
                         self->control = other->control;                        \
                         other->ptr = NULL;                                     \
                         other->control = NULL;                                 \
                         return STATUS_CONST(SUCCESS);                          \
                       }),                                                      \
                                                                                \
      OPERATION_INLINE(ResetWithPointer, (TYPE * newPtr), {                     \
        if (!self)                                                              \
          return STATUS_CONST(INVALID_ARGUMENT);                                \
        MODULE_FUNC(Memory, SharedPtr, SUFFIX, Reset)(self);                    \
        return MODULE_FUNC(Memory, SharedPtr, SUFFIX, FromPointer)(self,        \
                                                                    newPtr);    \
      }),                                                                       \
                                                                                \
      CONST_PREDICATE_INLINE(IsValid, (), {                                     \
        return (self && self->ptr != NULL && self->control != NULL &&           \
                self->control->strongCount > 0U);                               \
      }),                                                                       \
                                                                                \
      CONST_FUNCTION_INLINE(const TYPE *, Get, (), {                            \
        return self ? self->ptr : NULL;                                         \
      }),                                                                       \
                                                                                \
      FUNCTION_INLINE(TYPE *, GetMutable, (), {                                 \
        return self ? self->ptr : NULL;                                         \
      }),                                                                       \
                                                                                \
      CONST_FUNCTION_INLINE(size_t, UseCount, (), {                             \
        return (self && self->control) ? self->control->strongCount : 0U;       \
      }),                                                                       \
                                                                                \
      CONST_PREDICATE_INLINE(Unique, (), {                                      \
        return (self && self->control && self->control->strongCount == 1U);     \
      }),                                                                       \
                                                                                \
      CONST_OPERATION_INLINE(                                                   \
          Downgrade,                                                            \
          (struct MODULE_TYPED(Memory, WeakPtr, SUFFIX) * outWeak),             \
          {                                                                     \
            if (!self || !outWeak)                                              \
              return STATUS_CONST(INVALID_ARGUMENT);                            \
            MODULE_FUNC(Memory, WeakPtr, SUFFIX, Init)(outWeak);                \
            if (!self->control)                                                 \
              return STATUS_CONST(SUCCESS);                                     \
            self->control->weakCount++;                                         \
            outWeak->ptr = self->ptr;                                           \
            outWeak->control = self->control;                                   \
            return STATUS_CONST(SUCCESS);                                       \
          }),                                                                   \
                                                                                \
      OPERATION_INLINE(                                                         \
          FromWeak,                                                             \
          (const struct MODULE_TYPED(Memory, WeakPtr, SUFFIX) * weak),          \
          {                                                                     \
            if (!self || !weak)                                                 \
              return STATUS_CONST(INVALID_ARGUMENT);                            \
            MODULE_FUNC(Memory, SharedPtr, SUFFIX, Init)(self);                 \
            if (!weak->control || weak->control->strongCount == 0U) {           \
              return STATUS_CONST(NOT_FOUND);                                   \
            }                                                                   \
            weak->control->strongCount++;                                       \
            self->ptr = (TYPE *)weak->control->managedPointer;                  \
            self->control = weak->control;                                      \
            return STATUS_CONST(SUCCESS);                                       \
          }),                                                                   \
                                                                                \
      PROCEDURE_INLINE(Swap,                                                    \
                       (struct MODULE_TYPED(Memory, SharedPtr, SUFFIX) *        \
                        other),                                                 \
                       {                                                        \
                         if (!self || !other || self == other)                  \
                           return;                                              \
                         TYPE *tempPtr = self->ptr;                             \
                         MODULE_ITYPE(Memory, SharedControlBlock) *tempCb =     \
                             self->control;                                     \
                         self->ptr = other->ptr;                                \
                         self->control = other->control;                        \
                         other->ptr = tempPtr;                                  \
                         other->control = tempCb;                               \
                       })                                                       \
  );                                                                            \
  static inline OPSTATUS MODULE_FUNC(Memory, WeakPtr, SUFFIX, Upgrade)(         \
      const struct MODULE_TYPED(Memory, WeakPtr, SUFFIX) * self,                \
      struct MODULE_TYPED(Memory, SharedPtr, SUFFIX) * outShared) {             \
    return MODULE_FUNC(Memory, SharedPtr, SUFFIX, FromWeak)(outShared, self);  \
  }                                                                             \
  static inline OPSTATUS MODULE_FUNC(Memory, WeakPtr, SUFFIX, FromShared)(       \
      struct MODULE_TYPED(Memory, WeakPtr, SUFFIX) * self,                      \
      const struct MODULE_TYPED(Memory, SharedPtr, SUFFIX) * shared) {          \
    return MODULE_FUNC(Memory, SharedPtr, SUFFIX, Downgrade)(shared, self);     \
  }                                                                             \
  typedef int NS(_cosmeron_semi_shared_, SUFFIX, __LINE__)
#define TEMPLATE_SharedPtr(SUFFIX, TYPE) TEMPLATE_Memory_SharedPtr(SUFFIX, TYPE)
#endif

/* Mode 2 (Direct Include): Auto-instantiates and cleans up environment */
#if defined(SUFFIX) && defined(TYPE)
  TEMPLATE_Memory_SharedPtr(SUFFIX, TYPE);
  #undef SUFFIX
  #undef TYPE
#endif
