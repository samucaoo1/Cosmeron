#pragma once

#include "../../Namespace.h"

#define CALL_MOD Call
#define CALL_CMOD CALL

#define CALL_NS(NAME) GNS2(LIB_PREFIX(CALL_MOD), NAME)
#define CALL_CNS(NAME) CNS2(LIB_PREFIX_CONST(CALL_CMOD), NAME)
#define CALL_INS(NAME) GNS3(LIB_PREFIX(CALL_MOD), Internal, NAME)
#define CALL_CINS(NAME) CNS3(LIB_PREFIX_CONST(CALL_CMOD), INTERNAL, NAME)

#define CALL_TYPE(NAME) CALL_NS(NAME)
#define CALL_FUNC(NAME) CALL_NS(NAME)
#define CALL_CONST(NAME) CALL_CNS(NAME)
