#pragma once

/*
 * Typed, non-owning function/context pairs.
 *
 * Each declaration creates a distinct callback signature and uses the
 * Core/Module PACKAGE DSL to declare Bind, IsValid, and Invoke.
 *
 * PARAMETERS and ARGUMENTS are parenthesized tuples. The callback receives
 * void *context as its final parameter; Invoke forwards the stored context.
 *
 * The context is borrowed. Call never allocates, copies, or releases it.
 * The caller must keep it alive and must not invoke an unbound callable.
 */

#define CALL_DECLARE(NAME, RETURN_TYPE, PARAMETERS, ARGUMENTS)                \
  typedef RETURN_TYPE (*GNS2(CALL_TYPE(NAME), Function))(                      \
      PP_UNWRAP PARAMETERS, void *context);                                    \
  typedef struct CALL_TYPE(NAME) {                                             \
    GNS2(CALL_TYPE(NAME), Function) function;                                  \
    void *context;                                                             \
  } CALL_TYPE(NAME);                                                           \
  PACKAGE(CALL_TYPE(NAME),                                                     \
      FUNCTION_INLINE(CALL_TYPE(NAME), Bind,                                   \
          (GNS2(CALL_TYPE(NAME), Function) function, void *context), {         \
            CALL_TYPE(NAME) call;                                              \
            call.function = function;                                          \
            call.context = context;                                            \
            return call;                                                       \
          }),                                                                  \
      PREDICATE_INLINE(IsValid, (CALL_TYPE(NAME) call), {                      \
        return call.function != NULL;                                          \
      }),                                                                      \
      FUNCTION_INLINE(RETURN_TYPE, Invoke,                                     \
          (CALL_TYPE(NAME) call, PP_UNWRAP PARAMETERS), {                      \
            return call.function(PP_UNWRAP ARGUMENTS, call.context);           \
          })                                                                   \
  )

#define CALL_DECLARE_PROCEDURE(NAME, PARAMETERS, ARGUMENTS)                   \
  typedef void (*GNS2(CALL_TYPE(NAME), Function))(                             \
      PP_UNWRAP PARAMETERS, void *context);                                    \
  typedef struct CALL_TYPE(NAME) {                                             \
    GNS2(CALL_TYPE(NAME), Function) function;                                  \
    void *context;                                                             \
  } CALL_TYPE(NAME);                                                           \
  PACKAGE(CALL_TYPE(NAME),                                                     \
      FUNCTION_INLINE(CALL_TYPE(NAME), Bind,                                   \
          (GNS2(CALL_TYPE(NAME), Function) function, void *context), {         \
            CALL_TYPE(NAME) call;                                              \
            call.function = function;                                          \
            call.context = context;                                            \
            return call;                                                       \
          }),                                                                  \
      PREDICATE_INLINE(IsValid, (CALL_TYPE(NAME) call), {                      \
        return call.function != NULL;                                          \
      }),                                                                      \
      PROCEDURE_INLINE(Invoke, (CALL_TYPE(NAME) call, PP_UNWRAP PARAMETERS), {  \
        call.function(PP_UNWRAP ARGUMENTS, call.context);                      \
      })                                                                       \
  )

#define CALL_DECLARE_NULLARY(NAME, RETURN_TYPE)                                \
  typedef RETURN_TYPE (*GNS2(CALL_TYPE(NAME), Function))(void *context);       \
  typedef struct CALL_TYPE(NAME) {                                             \
    GNS2(CALL_TYPE(NAME), Function) function;                                  \
    void *context;                                                             \
  } CALL_TYPE(NAME);                                                           \
  PACKAGE(CALL_TYPE(NAME),                                                     \
      FUNCTION_INLINE(CALL_TYPE(NAME), Bind,                                   \
          (GNS2(CALL_TYPE(NAME), Function) function, void *context), {         \
            CALL_TYPE(NAME) call;                                              \
            call.function = function;                                          \
            call.context = context;                                            \
            return call;                                                       \
          }),                                                                  \
      PREDICATE_INLINE(IsValid, (CALL_TYPE(NAME) call), {                      \
        return call.function != NULL;                                          \
      }),                                                                      \
      FUNCTION_INLINE(RETURN_TYPE, Invoke, (CALL_TYPE(NAME) call), {           \
        return call.function(call.context);                                    \
      })                                                                       \
  )

#define CALL_DECLARE_NULLARY_PROCEDURE(NAME)                                   \
  typedef void (*GNS2(CALL_TYPE(NAME), Function))(void *context);              \
  typedef struct CALL_TYPE(NAME) {                                             \
    GNS2(CALL_TYPE(NAME), Function) function;                                  \
    void *context;                                                             \
  } CALL_TYPE(NAME);                                                           \
  PACKAGE(CALL_TYPE(NAME),                                                     \
      FUNCTION_INLINE(CALL_TYPE(NAME), Bind,                                   \
          (GNS2(CALL_TYPE(NAME), Function) function, void *context), {         \
            CALL_TYPE(NAME) call;                                              \
            call.function = function;                                          \
            call.context = context;                                            \
            return call;                                                       \
          }),                                                                  \
      PREDICATE_INLINE(IsValid, (CALL_TYPE(NAME) call), {                      \
        return call.function != NULL;                                          \
      }),                                                                      \
      PROCEDURE_INLINE(Invoke, (CALL_TYPE(NAME) call), {                       \
        call.function(call.context);                                           \
      })                                                                       \
  )
/* EOF */
