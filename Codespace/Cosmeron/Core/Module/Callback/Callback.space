#pragma once

#include "../../Namespace.h"

#define CALLBACK_MOD Callback
#define CALLBACK_CMOD CALLBACK

#define CALLBACK_NS(NAME) GNS2(LIB_PREFIX(CALLBACK_MOD), NAME)
#define CALLBACK_CNS(NAME) CNS2(LIB_PREFIX_CONST(CALLBACK_CMOD), NAME)
#define CALLBACK_INS(NAME) GNS3(LIB_PREFIX(CALLBACK_MOD), Internal, NAME)
#define CALLBACK_CINS(NAME) CNS3(LIB_PREFIX_CONST(CALLBACK_CMOD), INTERNAL, NAME)

#define CALLBACK_TYPE(NAME) CALLBACK_NS(NAME)
#define CALLBACK_FUNC(NAME) CALLBACK_NS(NAME)
#define CALLBACK_CONST(NAME) CALLBACK_CNS(NAME)
