         COSMERON_INTERNAL_OP_DISP_1)(__VA_ARGS__)

#define COSMERON_INTERNAL_CONST_OP_DECL_0(PARAMS)                             \
  (1, 0, OPSTATUS, _COSMERON_BASE_, PARAMS, { return STATUS_CONST(SUCCESS); })
#define COSMERON_INTERNAL_CONST_OP_IMPL_0(PARAMS, ...)                         \
