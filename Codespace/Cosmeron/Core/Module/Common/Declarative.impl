/* 5. Comparisons */
#define COSMERON_INTERNAL_CMP_DECL_0(PARAMS)                                  \
  (1, 0, CMPOUT, _COSMERON_BASE_, PARAMS, { return COMPARISON_CONST(EQUAL); })
#define COSMERON_INTERNAL_CMP_IMPL_0(PARAMS, ...)                             \
  (1, 1, CMPOUT, _COSMERON_BASE_, PARAMS, __VA_ARGS__)
#define COSMERON_INTERNAL_CMP_DISP_0(...)                                     \
  PP_IIF(PP_HAS_COMMA(__VA_ARGS__),                                           \
         COSMERON_INTERNAL_CMP_IMPL_0,                                         \
         COSMERON_INTERNAL_CMP_DECL_0)(__VA_ARGS__)

#define COSMERON_INTERNAL_CMP_DECL_1(NAME, PARAMS)                            \
  (1, 0, CMPOUT, NAME, PARAMS, { return COMPARISON_CONST(EQUAL); })
#define COSMERON_INTERNAL_CMP_IMPL_1(NAME, PARAMS, ...)                        \
  (1, 1, CMPOUT, NAME, PARAMS, __VA_ARGS__)
#define COSMERON_INTERNAL_CMP_DISP_1(...)                                     \
  PP_IIF(PP_HAS_COMMA(PP_SEQ_REST(__VA_ARGS__)),                              \
         COSMERON_INTERNAL_CMP_IMPL_1,                                         \
         COSMERON_INTERNAL_CMP_DECL_1)(__VA_ARGS__)

