#pragma once

#include "../Namespace.h"
#include "../../Preprocessor/Detect.h"
#include "../../Preprocessor/Arguments.h"
#include "../../Preprocessor/Foreach.h"
#include "../../Preprocessor/Map.h"
#include "../../Preprocessor/Operations.h"
#include "../../Preprocessor/Sequence.h"
#include "Tuple.impl"
#include "FunctionTable.impl"
#include "ComparisonEx.impl"
#include "../Callback/Callback.h"
#include "../Closure/Closure.h"

/* ============================================================
 * Declarative Module Engine (Core/Module/Common/Declarative.impl)
 * Implements next-generation MODULE(...), OBJECT(...), PACKAGE(...),
 * SPACE(...), VARIANT(...), ENUM(...), and template modules.
 * ============================================================ */

/* Optional organizational metadata descriptor (does not alter semantic module identity) */
#define COSMERON_DOMAIN_TAG 801
#define PROBE_801 ,
#define DOMAIN(D) (COSMERON_DOMAIN_TAG, D)

#ifndef COSMERON_INTERNAL_SCOPE_PUSH_DIAGNOSTICS
#if COMPILER_CLANG
#define COSMERON_INTERNAL_SCOPE_PUSH_DIAGNOSTICS()                             \
  _Pragma("clang diagnostic push")                                             \
  _Pragma("clang diagnostic ignored \"-Wunused-function\"")                    \
  _Pragma("clang diagnostic ignored \"-Wunused-parameter\"")                   \
  _Pragma("clang diagnostic ignored \"-Wunused-variable\"")

#define COSMERON_INTERNAL_SCOPE_POP_DIAGNOSTICS()                              \
  _Pragma("clang diagnostic pop")
#elif COMPILER_GCC
#define COSMERON_INTERNAL_SCOPE_PUSH_DIAGNOSTICS()                             \
  _Pragma("GCC diagnostic push")                                               \
  _Pragma("GCC diagnostic ignored \"-Wunused-function\"")                      \
  _Pragma("GCC diagnostic ignored \"-Wunused-parameter\"")                     \
  _Pragma("GCC diagnostic ignored \"-Wunused-variable\"")

#define COSMERON_INTERNAL_SCOPE_POP_DIAGNOSTICS()                              \
  _Pragma("GCC diagnostic pop")
#else
#define COSMERON_INTERNAL_SCOPE_PUSH_DIAGNOSTICS()
#define COSMERON_INTERNAL_SCOPE_POP_DIAGNOSTICS()
#endif
#endif

#ifndef COSMERON_MAYBE_UNUSED
#if COMPILER_GCC || COMPILER_CLANG
#define COSMERON_MAYBE_UNUSED __attribute__((unused))
#else
#define COSMERON_MAYBE_UNUSED
#endif
#endif

/* --- Declarative Tag Constants --- */
#define COSMERON_DECL_TAG_OBJECT 101
#define COSMERON_DECL_TAG_PACKAGE 102
#define COSMERON_DECL_TAG_ENUM 103
#define COSMERON_DECL_TAG_TPL_OBJECT 104
#define COSMERON_DECL_TAG_TPL_PACKAGE 105
#define COSMERON_DECL_TAG_TABLE 106
#define COSMERON_DECL_TAG_SPACE 107
#define COSMERON_DECL_TAG_VARIANT 108
#define COSMERON_DECL_TAG_STRUCT 110
#define COSMERON_DECL_TAG_TPL_STRUCT 111
#define COSMERON_DECL_TAG_ISTRUCT 112
#define COSMERON_DECL_TAG_TPL_ISTRUCT 113
#define COSMERON_DECL_TAG_INTERNAL 114
#define COSMERON_DECL_TAG_CALLBACK 115
#define COSMERON_DECL_TAG_CLOSURE 116

/* --- Inheritance and Fields Descriptors --- */
#define COSMERON_EXTENDS_TAG 901
#define COSMERON_FIELDS_TAG 902

#define PROBE_EXT_901 ,
#define PROBE_FLD_902 ,

#define EXTENDS(BASE) (COSMERON_EXTENDS_TAG, BASE)

#undef FIELDS
#define FIELDS(...) (COSMERON_FIELDS_TAG, (__VA_ARGS__))

#define COSMERON_IS_OBJ_EXT(item)                                              \
  PP_HAS_COMMA(PP_OP_CAT2(PROBE_EXT_, PP_SEQ_GET_1 item))
#define COSMERON_IS_OBJ_FLD(item)                                              \
  PP_HAS_COMMA(PP_OP_CAT2(PROBE_FLD_, PP_SEQ_GET_1 item))

/* --- Object Descriptor Generator --- */
#define COSMERON_INTERNAL_OBJ_EXT_FLD(NAME, EXT, FLD, ...)                    \
  (COSMERON_DECL_TAG_OBJECT, NAME, (1, PP_SEQ_GET_2 EXT), FLD, (__VA_ARGS__))

#define COSMERON_INTERNAL_OBJ_EXT_NOFLD(NAME, EXT, ...)                        \
  (COSMERON_DECL_TAG_OBJECT, NAME, (1, PP_SEQ_GET_2 EXT),                      \
   (COSMERON_FIELDS_TAG, ()), (__VA_ARGS__))

#define COSMERON_INTERNAL_OBJ_NOEXT_FLD(NAME, FLD, ...)                        \
  (COSMERON_DECL_TAG_OBJECT, NAME, (0, ~), FLD, (__VA_ARGS__))

#define COSMERON_INTERNAL_OBJ_NOEXT_NOFLD(NAME, ...)                           \
  (COSMERON_DECL_TAG_OBJECT, NAME, (0, ~), (COSMERON_FIELDS_TAG, ()),          \
   (__VA_ARGS__))

#define COSMERON_INTERNAL_OBJ_DISPATCH_EXT_1(NAME, EXT, FIRST_AFTER, ...)     \
  PP_IIF(COSMERON_IS_OBJ_FLD(FIRST_AFTER),                                     \
         COSMERON_INTERNAL_OBJ_EXT_FLD,                                        \
         COSMERON_INTERNAL_OBJ_EXT_NOFLD)(NAME, EXT, FIRST_AFTER, __VA_ARGS__)

#define COSMERON_INTERNAL_OBJ_DISPATCH_EXT_0(NAME, FIRST_ITEM, ...)            \
  PP_IIF(COSMERON_IS_OBJ_FLD(FIRST_ITEM),                                      \
         COSMERON_INTERNAL_OBJ_NOEXT_FLD,                                       \
         COSMERON_INTERNAL_OBJ_NOEXT_NOFLD)(NAME, FIRST_ITEM, __VA_ARGS__)

#undef OBJECT
#define OBJECT(NAME, ...)                                                      \
  PP_IIF(COSMERON_IS_OBJ_EXT(PP_SEQ_FIRST(__VA_ARGS__)),                       \
         COSMERON_INTERNAL_OBJ_DISPATCH_EXT_1,                                 \
         COSMERON_INTERNAL_OBJ_DISPATCH_EXT_0)(NAME, __VA_ARGS__)

/* --- Package Descriptor Generator --- */
#undef PACKAGE
#define PACKAGE(NAME, ...)                                                     \
  (COSMERON_DECL_TAG_PACKAGE, NAME, (0, ~), (~), (__VA_ARGS__))

/* --- Internal Scope Descriptor Generator --- */
#define COSMERON_INTERNAL_SCOPE_DISPATCH_1(...)                                  (COSMERON_DECL_TAG_INTERNAL, 0, _cosmeron_root, (__VA_ARGS__))

#define COSMERON_INTERNAL_SCOPE_DISPATCH_0(NAME, ...)                            (COSMERON_DECL_TAG_INTERNAL, 1, NAME, (__VA_ARGS__))

#undef INTERNAL
#define INTERNAL(...)                                                            PP_OP_CAT2(COSMERON_INTERNAL_SCOPE_DISPATCH_,                                             PP_IS_PAREN(PP_SEQ_FIRST(__VA_ARGS__)))(__VA_ARGS__)

#undef INTERNAL_EX
#define INTERNAL_EX(NAME, ...)                                                   (COSMERON_DECL_TAG_INTERNAL, 1, NAME, (__VA_ARGS__))

/* --- Internal Scope Descriptor Generator --- */
#define COSMERON_INTERNAL_SCOPE_DISPATCH_1(...)                                \
  (COSMERON_DECL_TAG_INTERNAL, 0, _cosmeron_root, (__VA_ARGS__))

#define COSMERON_INTERNAL_SCOPE_DISPATCH_0(NAME, ...)                          \
  (COSMERON_DECL_TAG_INTERNAL, 1, NAME, (__VA_ARGS__))

#undef INTERNAL
#define INTERNAL(...)                                                          \
  PP_OP_CAT2(COSMERON_INTERNAL_SCOPE_DISPATCH_,                                \
             PP_IS_PAREN(PP_SEQ_FIRST(__VA_ARGS__)))(__VA_ARGS__)

#undef INTERNAL_EX
#define INTERNAL_EX(NAME, ...)                                                 \
  (COSMERON_DECL_TAG_INTERNAL, 1, NAME, (__VA_ARGS__))

/* --- Variant Descriptors --- */

#define VARIANT(FAMILY, ...)                                                   \
  (COSMERON_DECL_TAG_VARIANT, FAMILY, (__VA_ARGS__))

/* --- Enum Descriptor Generator --- */
#define COSMERON_INTERNAL_ENUM_2(NAME, TABLE)                                  \
  (COSMERON_DECL_TAG_ENUM, NAME, TABLE, COSMERON_INTERNAL_ENUM_DISP_PLAIN)
#define COSMERON_INTERNAL_ENUM_3(NAME, TABLE, DISP)                            \
  (COSMERON_DECL_TAG_ENUM, NAME, TABLE, DISP)

#undef ENUM
#define ENUM(...)                                                              \
  PP_OP_CAT2(COSMERON_INTERNAL_ENUM_, PP_ARG_COUNT(__VA_ARGS__))(__VA_ARGS__)

#undef ENUM_EX
#define ENUM_EX(NAME, TABLE, DISP)                                             \
  (COSMERON_DECL_TAG_ENUM, NAME, TABLE, DISP)

/* --- Template Descriptors --- */
#define TEMPLATE_OBJECT(NAME, ARGS, ...)                                       \
  (COSMERON_DECL_TAG_TPL_OBJECT, NAME, ARGS, (~), (__VA_ARGS__))

#define TEMPLATE_PACKAGE(NAME, ARGS, ...)                                      \
  (COSMERON_DECL_TAG_TPL_PACKAGE, NAME, ARGS, (~), (__VA_ARGS__))

/* --- Struct Descriptors --- */
#define COSMERON_INTERNAL_STRUCT_2(NAME, FIELDS_DECL)                          \
  (COSMERON_DECL_TAG_STRUCT, NAME, FIELDS_DECL)
#define COSMERON_INTERNAL_STRUCT_3(MOD, NAME, FIELDS_DECL)                     \
  STRUCT_DEF(MOD, NAME, FIELDS_DECL)

#undef STRUCT
#define STRUCT(...)                                                            \
  PP_OP_CAT2(COSMERON_INTERNAL_STRUCT_, PP_ARG_COUNT(__VA_ARGS__))(__VA_ARGS__)

/* --- Template Struct Descriptor Generator --- */
#define COSMERON_INTERNAL_TPL_STRUCT_DISPATCH_1(NAME, ARGS, FIELDS_DECL)      \
  (COSMERON_DECL_TAG_TPL_STRUCT, NAME, ARGS, FIELDS_DECL)
#define COSMERON_INTERNAL_TPL_STRUCT_DISPATCH_0(MOD, NAME, SUFFIX, FIELDS_DECL)\
  TEMPLATE_STRUCT_DEF(MOD, NAME, SUFFIX, FIELDS_DECL)

#undef TEMPLATE_STRUCT
#define TEMPLATE_STRUCT(A, B, ...)                                             \
  PP_OP_CAT2(COSMERON_INTERNAL_TPL_STRUCT_DISPATCH_,                          \
             PP_IS_PAREN(B))(A, B, __VA_ARGS__)

/* --- Internal Struct Descriptors --- */
#define COSMERON_INTERNAL_ISTRUCT_2(NAME, FIELDS_DECL)                         \
  (COSMERON_DECL_TAG_ISTRUCT, NAME, FIELDS_DECL)
#define COSMERON_INTERNAL_ISTRUCT_3(MOD, NAME, FIELDS_DECL)                    \
  ISTRUCT_DEF(MOD, NAME, FIELDS_DECL)

#undef ISTRUCT
#define ISTRUCT(...)                                                           \
  PP_OP_CAT2(COSMERON_INTERNAL_ISTRUCT_, PP_ARG_COUNT(__VA_ARGS__))(__VA_ARGS__)

/* --- Template Internal Struct Descriptor Generator --- */
#define COSMERON_INTERNAL_TPL_ISTRUCT_DISPATCH_1(NAME, ARGS, FIELDS_DECL)     \
  (COSMERON_DECL_TAG_TPL_ISTRUCT, NAME, ARGS, FIELDS_DECL)
#define COSMERON_INTERNAL_TPL_ISTRUCT_DISPATCH_0(MOD, NAME, SUFFIX, FIELDS_DECL)\
  TEMPLATE_ISTRUCT_DEF(MOD, NAME, SUFFIX, FIELDS_DECL)

#undef TEMPLATE_ISTRUCT
#define TEMPLATE_ISTRUCT(A, B, ...)                                            \
  PP_OP_CAT2(COSMERON_INTERNAL_TPL_ISTRUCT_DISPATCH_,                         \
             PP_IS_PAREN(B))(A, B, __VA_ARGS__)

/* --- Overloaded Method Descriptors (Supporting VARIANT Arities & Implementations) --- */

/* 1. Functions */
#define COSMERON_INTERNAL_FN_DECL_0(RET, PARAMS)                              \
  (0, 0, RET, _COSMERON_BASE_, PARAMS, { (void)0; })
#define COSMERON_INTERNAL_FN_IMPL_0(RET, PARAMS, ...)                         \
  (0, 1, RET, _COSMERON_BASE_, PARAMS, __VA_ARGS__)
#define COSMERON_INTERNAL_FN_DISP_0(RET, ...)                                 \
  PP_IIF(PP_HAS_COMMA(__VA_ARGS__),                                           \
         COSMERON_INTERNAL_FN_IMPL_0,                                          \
         COSMERON_INTERNAL_FN_DECL_0)(RET, __VA_ARGS__)

#define COSMERON_INTERNAL_FN_DECL_1(RET, NAME, PARAMS)                        \
  (0, 0, RET, NAME, PARAMS, { (void)0; })
#define COSMERON_INTERNAL_FN_IMPL_1(RET, NAME, PARAMS, ...)                   \
  (0, 1, RET, NAME, PARAMS, __VA_ARGS__)
#define COSMERON_INTERNAL_FN_DISP_1(RET, ...)                                 \
  PP_IIF(PP_HAS_COMMA(PP_SEQ_REST(__VA_ARGS__)),                              \
         COSMERON_INTERNAL_FN_IMPL_1,                                          \
         COSMERON_INTERNAL_FN_DECL_1)(RET, __VA_ARGS__)

#undef FUNCTION
#define FUNCTION(...)                                                          \
  PP_IIF(PP_IS_PAREN(PP_SEQ_GET_2(__VA_ARGS__)),                               \
         COSMERON_INTERNAL_FN_DISP_0,                                          \
         COSMERON_INTERNAL_FN_DISP_1)(__VA_ARGS__)

#define COSMERON_INTERNAL_CONST_FN_DECL_0(RET, PARAMS)                        \
  (1, 0, RET, _COSMERON_BASE_, PARAMS, { (void)0; })
#define COSMERON_INTERNAL_CONST_FN_IMPL_0(RET, PARAMS, ...)                   \
  (1, 1, RET, _COSMERON_BASE_, PARAMS, __VA_ARGS__)
#define COSMERON_INTERNAL_CONST_FN_DISP_0(RET, ...)                           \
  PP_IIF(PP_HAS_COMMA(__VA_ARGS__),                                           \
         COSMERON_INTERNAL_CONST_FN_IMPL_0,                                    \
         COSMERON_INTERNAL_CONST_FN_DECL_0)(RET, __VA_ARGS__)

#define COSMERON_INTERNAL_CONST_FN_DECL_1(RET, NAME, PARAMS)                  \
  (1, 0, RET, NAME, PARAMS, { (void)0; })
#define COSMERON_INTERNAL_CONST_FN_IMPL_1(RET, NAME, PARAMS, ...)             \
  (1, 1, RET, NAME, PARAMS, __VA_ARGS__)
#define COSMERON_INTERNAL_CONST_FN_DISP_1(RET, ...)                           \
  PP_IIF(PP_HAS_COMMA(PP_SEQ_REST(__VA_ARGS__)),                              \
         COSMERON_INTERNAL_CONST_FN_IMPL_1,                                    \
         COSMERON_INTERNAL_CONST_FN_DECL_1)(RET, __VA_ARGS__)

#undef CONST_FUNCTION
#define CONST_FUNCTION(...)                                                    \
  PP_IIF(PP_IS_PAREN(PP_SEQ_GET_2(__VA_ARGS__)),                               \
         COSMERON_INTERNAL_CONST_FN_DISP_0,                                    \
         COSMERON_INTERNAL_CONST_FN_DISP_1)(__VA_ARGS__)

