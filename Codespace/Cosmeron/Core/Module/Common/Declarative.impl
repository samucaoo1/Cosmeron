         COSMERON_INTERNAL_CONST_OP_IMPL_1,                                    \
         COSMERON_INTERNAL_CONST_OP_DECL_1)(__VA_ARGS__)

#undef CONST_OPERATION
#define CONST_OPERATION(...)                                                   \
