#define COSMERON_INTERNAL_OP_DECL_0(PARAMS)                                   \
  (0, 0, OPSTATUS, _COSMERON_BASE_, PARAMS, { return STATUS_CONST(SUCCESS); })
#define COSMERON_INTERNAL_OP_IMPL_0(PARAMS, ...)                               \
