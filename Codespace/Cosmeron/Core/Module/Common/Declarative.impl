         COSMERON_INTERNAL_CMP_DISP_0,                                         \
         COSMERON_INTERNAL_CMP_DISP_1)(__VA_ARGS__)

#undef CONST_COMPARISON
#define CONST_COMPARISON(...) COMPARISON(__VA_ARGS__)

#undef FUNCTION_INLINE
#define FUNCTION_INLINE(...)                                                   \
  PP_OP_CAT2(COSMERON_INTERNAL_FN_INL_, PP_ARG_COUNT(__VA_ARGS__))(__VA_ARGS__)
#define COSMERON_INTERNAL_FN_INL_3(RET, PARAMS, BODY)                          \
  (0, 1, RET, _COSMERON_BASE_, PARAMS, BODY)
#define COSMERON_INTERNAL_FN_INL_4(RET, NAME, PARAMS, BODY)                     \
  (0, 1, RET, NAME, PARAMS, BODY)

#undef CONST_FUNCTION_INLINE
#define CONST_FUNCTION_INLINE(...)                                             \
  PP_OP_CAT2(COSMERON_INTERNAL_CONST_FN_INL_, PP_ARG_COUNT(__VA_ARGS__))(__VA_ARGS__)
#define COSMERON_INTERNAL_CONST_FN_INL_3(RET, PARAMS, BODY)                     \
  (1, 1, RET, _COSMERON_BASE_, PARAMS, BODY)
#define COSMERON_INTERNAL_CONST_FN_INL_4(RET, NAME, PARAMS, BODY)              \
  (1, 1, RET, NAME, PARAMS, BODY)

#undef OPERATION_INLINE
#define OPERATION_INLINE(...)                                                  \
  PP_OP_CAT2(COSMERON_INTERNAL_OP_INL_, PP_ARG_COUNT(__VA_ARGS__))(__VA_ARGS__)
#define COSMERON_INTERNAL_OP_INL_2(PARAMS, BODY)                                \
  (0, 1, OPSTATUS, _COSMERON_BASE_, PARAMS, BODY)
#define COSMERON_INTERNAL_OP_INL_3(NAME, PARAMS, BODY)                          \
  (0, 1, OPSTATUS, NAME, PARAMS, BODY)

#undef CONST_OPERATION_INLINE
#define CONST_OPERATION_INLINE(...)                                            \
  PP_OP_CAT2(COSMERON_INTERNAL_CONST_OP_INL_, PP_ARG_COUNT(__VA_ARGS__))(__VA_ARGS__)
#define COSMERON_INTERNAL_CONST_OP_INL_2(PARAMS, BODY)                         \
  (1, 1, OPSTATUS, _COSMERON_BASE_, PARAMS, BODY)
#define COSMERON_INTERNAL_CONST_OP_INL_3(NAME, PARAMS, BODY)                   \
  (1, 1, OPSTATUS, NAME, PARAMS, BODY)

#undef PREDICATE_INLINE
#define PREDICATE_INLINE(...)                                                  \
  PP_OP_CAT2(COSMERON_INTERNAL_PRED_INL_, PP_ARG_COUNT(__VA_ARGS__))(__VA_ARGS__)
#define COSMERON_INTERNAL_PRED_INL_2(PARAMS, BODY)                              \
  (0, 1, bool, _COSMERON_BASE_, PARAMS, BODY)
#define COSMERON_INTERNAL_PRED_INL_3(NAME, PARAMS, BODY)                        \
  (0, 1, bool, NAME, PARAMS, BODY)

#undef CONST_PREDICATE_INLINE
#define CONST_PREDICATE_INLINE(...)                                            \
  PP_OP_CAT2(COSMERON_INTERNAL_CONST_PRED_INL_, PP_ARG_COUNT(__VA_ARGS__))(__VA_ARGS__)
#define COSMERON_INTERNAL_CONST_PRED_INL_2(PARAMS, BODY)                        \
  (1, 1, bool, _COSMERON_BASE_, PARAMS, BODY)
#define COSMERON_INTERNAL_CONST_PRED_INL_3(NAME, PARAMS, BODY)                  \
  (1, 1, bool, NAME, PARAMS, BODY)

#undef PROCEDURE_INLINE
#define PROCEDURE_INLINE(...)                                                  \
  PP_OP_CAT2(COSMERON_INTERNAL_PROC_INL_, PP_ARG_COUNT(__VA_ARGS__))(__VA_ARGS__)
#define COSMERON_INTERNAL_PROC_INL_2(PARAMS, BODY)                             \
  (0, 1, void, _COSMERON_BASE_, PARAMS, BODY)
#define COSMERON_INTERNAL_PROC_INL_3(NAME, PARAMS, BODY)                       \
  (0, 1, void, NAME, PARAMS, BODY)

#undef CONST_PROCEDURE_INLINE
#define CONST_PROCEDURE_INLINE(...)                                            \
  PP_OP_CAT2(COSMERON_INTERNAL_CONST_PROC_INL_, PP_ARG_COUNT(__VA_ARGS__))(__VA_ARGS__)
#define COSMERON_INTERNAL_CONST_PROC_INL_2(PARAMS, BODY)                        \
  (1, 1, void, _COSMERON_BASE_, PARAMS, BODY)
#define COSMERON_INTERNAL_CONST_PROC_INL_3(NAME, PARAMS, BODY)                 \
  (1, 1, void, NAME, PARAMS, BODY)

/* ============================================================
 * Tuple Invocation Dispatcher
 * Dispatches directly to COSMERON_EMIT_DECL_<TAG> based on tuple tag.
 * ============================================================ */

#define COSMERON_DISPATCH_DECL_EXPAND(MACRO, MOD, ...) MACRO(MOD, __VA_ARGS__)
#define COSMERON_DISPATCH_DECL_INVOKE(MACRO, MOD, TUPLE)                       \
  COSMERON_DISPATCH_DECL_EXPAND(MACRO, MOD, PP_UNWRAP TUPLE)

#define COSMERON_DISPATCH_DECL(MOD, ITEM)                                      \
  COSMERON_DISPATCH_DECL_INVOKE(                                               \
      PP_OP_CAT2(COSMERON_EMIT_DECL_, PP_SEQ_GET_1 ITEM), MOD, ITEM)

/* ============================================================
 * 0.5 ENUM Engine & Dispatch Presets
 * ============================================================ */

/* PLAIN: Emits CNS(TARGET, NAME) = VALUE, (or CNS(TARGET, NAME), if 1 col) */
#define COSMERON_ENUM_COL_PLAIN_1(TARGET, ENUM_NAME, ROW)                      \
  CNS(TARGET, PP_SEQ_GET_1 ROW),
#define COSMERON_ENUM_COL_PLAIN_2(TARGET, ENUM_NAME, ROW)                      \
  CNS(TARGET, PP_SEQ_GET_1 ROW) = PP_SEQ_GET_2 ROW,
#define COSMERON_ENUM_COL_PLAIN_3(TARGET, ENUM_NAME, ROW)                      \
  CNS(TARGET, PP_SEQ_GET_1 ROW) = PP_SEQ_GET_2 ROW,
#define COSMERON_ENUM_COL_PLAIN_4(TARGET, ENUM_NAME, ROW)                      \
  CNS(TARGET, PP_SEQ_GET_1 ROW) = PP_SEQ_GET_2 ROW,
#define COSMERON_ENUM_COL_PLAIN_5(TARGET, ENUM_NAME, ROW)                      \
  CNS(TARGET, PP_SEQ_GET_1 ROW) = PP_SEQ_GET_2 ROW,
#define COSMERON_ENUM_COL_PLAIN_6(TARGET, ENUM_NAME, ROW)                      \
  CNS(TARGET, PP_SEQ_GET_1 ROW) = PP_SEQ_GET_2 ROW,
#define COSMERON_ENUM_COL_PLAIN_7(TARGET, ENUM_NAME, ROW)                      \
  CNS(TARGET, PP_SEQ_GET_1 ROW) = PP_SEQ_GET_2 ROW,
#define COSMERON_ENUM_COL_PLAIN_8(TARGET, ENUM_NAME, ROW)                      \
  CNS(TARGET, PP_SEQ_GET_1 ROW) = PP_SEQ_GET_2 ROW,

#define COSMERON_INTERNAL_ENUM_DISP_PLAIN(TARGET, ENUM_NAME, ROW)              \
  PP_OP_CAT2(COSMERON_ENUM_COL_PLAIN_,                                         \
             PP_ARG_COUNT(PP_UNWRAP ROW))(TARGET, ENUM_NAME, ROW)

/* NAME_ONLY: Emits CNS(TARGET, NAME), (always without value, for any column count) */
#define COSMERON_INTERNAL_ENUM_DISP_NAME_ONLY(TARGET, ENUM_NAME, ROW)          \
  CNS(TARGET, PP_SEQ_GET_1 ROW),

/* QUALIFIED: Emits CNS(TARGET, ENUM_NAME, NAME) = VALUE, (or CNS(TARGET, ENUM_NAME, NAME), if 1 col) */
#define COSMERON_ENUM_COL_QUAL_1(TARGET, ENUM_NAME, ROW)                       \
  CNS(TARGET, ENUM_NAME, PP_SEQ_GET_1 ROW),
#define COSMERON_ENUM_COL_QUAL_2(TARGET, ENUM_NAME, ROW)                       \
  CNS(TARGET, ENUM_NAME, PP_SEQ_GET_1 ROW) = PP_SEQ_GET_2 ROW,
#define COSMERON_ENUM_COL_QUAL_3(TARGET, ENUM_NAME, ROW)                       \
  CNS(TARGET, ENUM_NAME, PP_SEQ_GET_1 ROW) = PP_SEQ_GET_2 ROW,
#define COSMERON_ENUM_COL_QUAL_4(TARGET, ENUM_NAME, ROW)                       \
  CNS(TARGET, ENUM_NAME, PP_SEQ_GET_1 ROW) = PP_SEQ_GET_2 ROW,
#define COSMERON_ENUM_COL_QUAL_5(TARGET, ENUM_NAME, ROW)                       \
  CNS(TARGET, ENUM_NAME, PP_SEQ_GET_1 ROW) = PP_SEQ_GET_2 ROW,
#define COSMERON_ENUM_COL_QUAL_6(TARGET, ENUM_NAME, ROW)                       \
  CNS(TARGET, ENUM_NAME, PP_SEQ_GET_1 ROW) = PP_SEQ_GET_2 ROW,
#define COSMERON_ENUM_COL_QUAL_7(TARGET, ENUM_NAME, ROW)                       \
  CNS(TARGET, ENUM_NAME, PP_SEQ_GET_1 ROW) = PP_SEQ_GET_2 ROW,
#define COSMERON_ENUM_COL_QUAL_8(TARGET, ENUM_NAME, ROW)                       \
  CNS(TARGET, ENUM_NAME, PP_SEQ_GET_1 ROW) = PP_SEQ_GET_2 ROW,

#define COSMERON_INTERNAL_ENUM_DISP_QUALIFIED(TARGET, ENUM_NAME, ROW)          \
  PP_OP_CAT2(COSMERON_ENUM_COL_QUAL_,                                          \
             PP_ARG_COUNT(PP_UNWRAP ROW))(TARGET, ENUM_NAME, ROW)

/* QUALIFIED_NAME: Emits CNS(TARGET, ENUM_NAME, NAME), (always without value) */
#define COSMERON_INTERNAL_ENUM_DISP_QUALIFIED_NAME(TARGET, ENUM_NAME, ROW)     \
  CNS(TARGET, ENUM_NAME, PP_SEQ_GET_1 ROW),

#define PLAIN COSMERON_INTERNAL_ENUM_DISP_PLAIN
#define NAME_VALUE COSMERON_INTERNAL_ENUM_DISP_PLAIN
#define NAME_ONLY COSMERON_INTERNAL_ENUM_DISP_NAME_ONLY
#define QUALIFIED COSMERON_INTERNAL_ENUM_DISP_QUALIFIED
#define QUALIFIED_NAME COSMERON_INTERNAL_ENUM_DISP_QUALIFIED_NAME

#define COSMERON_COMMA_ROW(ROW) ROW,

#define COSMERON_INTERNAL_ENUM_ROW_DISPATCH(CTX, ROW)                         \
  PP_OP_CAT2(COSMERON_ENUM_ROW_CASE_, PP_IS_PAREN(ROW))(CTX, ROW)

#define COSMERON_ENUM_ROW_CASE_1(CTX, ROW)                                     \
  PP_SEQ_GET_3 CTX(PP_SEQ_GET_1 CTX, PP_SEQ_GET_2 CTX, ROW)

#define COSMERON_ENUM_ROW_CASE_0(CTX, ROW) /* Sentinel ignored */

#define COSMERON_EXPAND_ENUM_INVOKE(m, ctx, ...) m(ctx, __VA_ARGS__)

#define COSMERON_INTERNAL_EXPAND_ENUM(TARGET, NAME, DISP, TABLE)               \
  COSMERON_EXPAND_ENUM_INVOKE(PP_MAP_NONE_CTX,                                \
                              COSMERON_INTERNAL_ENUM_ROW_DISPATCH,             \
                              (TARGET, NAME, DISP),                            \
                              TABLE(COSMERON_COMMA_ROW) ~)

#define COSMERON_INTERNAL_EMIT_ENUM_DEF(TARGET, NAME, TABLE, DISP)             \
  typedef enum NS(TARGET, NAME) {                                              \
    COSMERON_INTERNAL_EXPAND_ENUM(TARGET, NAME, DISP, TABLE)                   \
  } NS(TARGET, NAME);

#define ENUM_DEF(TARGET, NAME, TABLE)                                          \
  COSMERON_INTERNAL_EMIT_ENUM_DEF(TARGET, NAME, TABLE, PLAIN)

#define ENUM_DEF_EX(TARGET, NAME, TABLE, DISP)                                 \
  COSMERON_INTERNAL_EMIT_ENUM_DEF(TARGET, NAME, TABLE, DISP)

/* ============================================================
 * 1. OBJECT Emitter
 * ============================================================ */

#define COSMERON_INTERNAL_EXT_FIELD_1(MOD, BASE)                              \
  MODULE_TYPE(MOD, BASE) base;
#define COSMERON_INTERNAL_EXT_FIELD_0(MOD, BASE)

#define COSMERON_INTERNAL_EXT_FIELD(MOD, TUPLE)                               \
  PP_OP_CAT2(COSMERON_INTERNAL_EXT_FIELD_, PP_SEQ_GET_1 TUPLE)(                \
      MOD, PP_SEQ_GET_2 TUPLE)

#ifndef COSMERON_INTERNAL_UNWRAP_FIELDS
#define COSMERON_INTERNAL_UNWRAP_FIELDS_HELPER(TAG, BODY) PP_UNWRAP BODY
#define COSMERON_INTERNAL_UNWRAP_FIELDS(DECL)                                  \
  COSMERON_INTERNAL_UNWRAP_FIELDS_HELPER DECL
#endif

/* Prototype emission for Object methods */
#define COSMERON_INTERNAL_SELF_TYPE_0(T) T
#define COSMERON_INTERNAL_SELF_TYPE_1(T) const T
#define COSMERON_INTERNAL_SELF_TYPE(C, T)                                      \
  PP_OP_CAT2(COSMERON_INTERNAL_SELF_TYPE_, C)(T)

#define COSMERON_INTERNAL_OBJ_BODY_0(B) ;
#define COSMERON_INTERNAL_OBJ_BODY_1(B) B

#define COSMERON_INTERNAL_OBJ_MEMBER_I(CTX, C, I, R, N, P, ...)                \
  typedef R NS(PP_SEQ_GET_1 CTX, N, ret_t);                                  \
  typedef COSMERON_INTERNAL_SELF_TYPE(C, PP_SEQ_GET_2 CTX)                     \
      NS(PP_SEQ_GET_1 CTX, N, self_t);                                      \
  struct NS(PP_SEQ_GET_1 CTX, N, sig) {                                     \
    int _unused;                                                               \
  };                                                                           \
  static inline COSMERON_MAYBE_UNUSED R NS(PP_SEQ_GET_1 CTX, N)              \
      COSMERON_MACRO_INTERNAL_OBJ_EMIT_PARAMS(PP_SEQ_GET_2 CTX, C, P)         \
      PP_OP_CAT2(COSMERON_INTERNAL_OBJ_BODY_, I)(__VA_ARGS__)

#define COSMERON_INTERNAL_OBJ_VAR_PROTO(CTX, M)                                \
  COSMERON_MACRO_INTERNAL_UNWRAP_MEMBER(                                       \
      COSMERON_INTERNAL_OBJ_VAR_PROTO_I, CTX, M)

#define COSMERON_INTERNAL_OBJ_VAR_PROTO_I(CTX, C, I, R, N, P, ...)             \
  typedef R NS(PP_SEQ_GET_1 CTX, COSMERON_VAR_RESOLVE_NAME(PP_SEQ_GET_3 CTX, N), ret_t); \
  typedef COSMERON_INTERNAL_SELF_TYPE(C, PP_SEQ_GET_2 CTX)                     \
      NS(PP_SEQ_GET_1 CTX, COSMERON_VAR_RESOLVE_NAME(PP_SEQ_GET_3 CTX, N), self_t); \
  struct NS(PP_SEQ_GET_1 CTX, COSMERON_VAR_RESOLVE_NAME(PP_SEQ_GET_3 CTX, N), sig) { \
    int _unused;                                                               \
  };                                                                           \
  static inline COSMERON_MAYBE_UNUSED R                                        \
      NS(PP_SEQ_GET_1 CTX, COSMERON_VAR_RESOLVE_NAME(PP_SEQ_GET_3 CTX, N))     \
      COSMERON_MACRO_INTERNAL_OBJ_EMIT_PARAMS(PP_SEQ_GET_2 CTX, C, P)         \
      PP_OP_CAT2(COSMERON_INTERNAL_OBJ_BODY_, I)(__VA_ARGS__)

#define COSMERON_INTERNAL_SCOPE_CB_MEMBER(SCOPE, M)                            \
  COSMERON_MACRO_INTERNAL_UNWRAP_MEMBER(                                       \
      COSMERON_INTERNAL_SCOPE_CB_MEMBER_I, SCOPE, M)

#define COSMERON_INTERNAL_SCOPE_CB_MEMBER_I(SCOPE, C, I, R, N, P, ...)          \
  COSMERON_MACRO_INTERNAL_CB_SCOPED_GEN(SCOPE, N, R, P)

#define COSMERON_INTERNAL_SCOPE_CL_MEMBER(SCOPE, M)                            \
  COSMERON_MACRO_INTERNAL_UNWRAP_MEMBER(                                       \
      COSMERON_INTERNAL_SCOPE_CL_MEMBER_I, SCOPE, M)

#define COSMERON_INTERNAL_SCOPE_CL_MEMBER_I(SCOPE, C, I, R, N, P, ...)          \
  COSMERON_MACRO_INTERNAL_CL_SCOPED_GEN(SCOPE, N, R, P)

#define COSMERON_INTERNAL_OBJ_MEMBER_EXPAND(MACRO, CTX, ...)                   \
  MACRO(CTX, __VA_ARGS__)

#define COSMERON_INTERNAL_OBJ_MEMBER_INVOKE(MACRO, CTX, TUPLE)                 \
  COSMERON_INTERNAL_OBJ_MEMBER_EXPAND(MACRO, CTX, PP_UNWRAP TUPLE)

#define COSMERON_INTERNAL_OBJ_MEMBER_TAG_0(CTX, C, I, R, N, P, ...)            \
  COSMERON_INTERNAL_OBJ_MEMBER_I(CTX, C, I, R, N, P, __VA_ARGS__)
#define COSMERON_INTERNAL_OBJ_MEMBER_TAG_1(CTX, C, I, R, N, P, ...)            \
  COSMERON_INTERNAL_OBJ_MEMBER_I(CTX, C, I, R, N, P, __VA_ARGS__)
#define COSMERON_INTERNAL_OBJ_MEMBER_TAG_2(CTX, C, I, R, N, P, B)              \
  CALLBACK_FUNCTION(R, NS(PP_SEQ_GET_1 CTX, N), P);
#define COSMERON_INTERNAL_OBJ_MEMBER_TAG_103(CTX, TAG, NAME, TABLE, DISP)
#define COSMERON_INTERNAL_OBJ_MEMBER_TAG_107(CTX, TAG, SUBSPACE, METHODS)
#define COSMERON_INTERNAL_OBJ_MEMBER_TAG_108(CTX, TAG, FAMILY, VARIANTS)       \
  COSMERON_EXPAND_INNER_MEMBERS(COSMERON_INTERNAL_OBJ_VAR_PROTO,               \
                                (PP_SEQ_GET_1 CTX, PP_SEQ_GET_2 CTX, FAMILY),  \
                                PP_UNWRAP VARIANTS)
#define COSMERON_INTERNAL_OBJ_MEMBER_TAG_109(CTX, TAG, NAME, TABLE)
#define COSMERON_INTERNAL_OBJ_MEMBER_TAG_110(CTX, ...)
#define COSMERON_INTERNAL_OBJ_MEMBER_TAG_111(CTX, ...)
#define COSMERON_INTERNAL_OBJ_MEMBER_TAG_112(CTX, ...)
#define COSMERON_INTERNAL_OBJ_MEMBER_TAG_113(CTX, ...)
#define COSMERON_INTERNAL_OBJ_MEMBER_TAG_114(CTX, ...)
#define COSMERON_INTERNAL_OBJ_MEMBER_TAG_115(CTX, TAG, MEMBERS)                \
  PP_FOREACH_D3_CTX(COSMERON_INTERNAL_SCOPE_CB_MEMBER, PP_SEQ_GET_1 CTX,        \
                    PP_UNWRAP MEMBERS)
#define COSMERON_INTERNAL_OBJ_MEMBER_TAG_116(CTX, TAG, MEMBERS)                \
  PP_FOREACH_D3_CTX(COSMERON_INTERNAL_SCOPE_CL_MEMBER, PP_SEQ_GET_1 CTX,        \
                    PP_UNWRAP MEMBERS)

#define COSMERON_INTERNAL_OBJ_ENUM_MEMBER_EXPAND(MACRO, CTX, ...)              \
  MACRO(CTX, __VA_ARGS__)
#define COSMERON_INTERNAL_OBJ_ENUM_MEMBER_INVOKE(MACRO, CTX, TUPLE)            \
  COSMERON_INTERNAL_OBJ_ENUM_MEMBER_EXPAND(MACRO, CTX, PP_UNWRAP TUPLE)
#define COSMERON_INTERNAL_OBJ_ENUM_MEMBER(CTX, M)                              \
  COSMERON_INTERNAL_OBJ_ENUM_MEMBER_INVOKE(                                    \
      PP_OP_CAT2(COSMERON_INTERNAL_OBJ_ENUM_TAG_, PP_SEQ_GET_1 M),            \
      CTX, M)

#define COSMERON_INTERNAL_OBJ_ENUM_TAG_0(CTX, ...)
#define COSMERON_INTERNAL_OBJ_ENUM_TAG_1(CTX, ...)
#define COSMERON_INTERNAL_OBJ_ENUM_TAG_2(CTX, ...)
#define COSMERON_INTERNAL_OBJ_ENUM_TAG_107(CTX, ...)
#define COSMERON_INTERNAL_OBJ_ENUM_TAG_108(CTX, ...)
#define COSMERON_INTERNAL_OBJ_ENUM_TAG_109(CTX, ...)
#define COSMERON_INTERNAL_OBJ_ENUM_TAG_110(CTX, ...)
#define COSMERON_INTERNAL_OBJ_ENUM_TAG_111(CTX, ...)
#define COSMERON_INTERNAL_OBJ_ENUM_TAG_112(CTX, ...)
#define COSMERON_INTERNAL_OBJ_ENUM_TAG_113(CTX, ...)
#define COSMERON_INTERNAL_OBJ_ENUM_TAG_114(CTX, ...)
#define COSMERON_INTERNAL_OBJ_ENUM_TAG_115(CTX, ...)
#define COSMERON_INTERNAL_OBJ_ENUM_TAG_116(CTX, ...)
#define COSMERON_INTERNAL_OBJ_ENUM_TAG_103(CTX, TAG, NAME, TABLE, DISP)        \
  COSMERON_INTERNAL_EMIT_ENUM_DEF(PP_SEQ_GET_1 CTX, NAME, TABLE, DISP)

#define COSMERON_INTERNAL_OBJ_GEN_ENUMS(CTX, METHODS)                         \
  PP_FOREACH_D2_CTX(COSMERON_INTERNAL_OBJ_ENUM_MEMBER, CTX,                   \
                    PP_UNWRAP METHODS)

#define COSMERON_INTERNAL_OBJ_MEMBER(CTX, M)                                  \
  COSMERON_INTERNAL_OBJ_MEMBER_INVOKE(                                         \
      PP_OP_CAT2(COSMERON_INTERNAL_OBJ_MEMBER_TAG_, PP_SEQ_GET_1 M),            \
      CTX, M)

#define COSMERON_EXPAND_OBJ_MEMBERS(m, ctx, ...)                              \
  PP_FOREACH_D2_CTX(m, ctx, __VA_ARGS__)

#define COSMERON_INTERNAL_OBJ_GEN_MEMBERS(CTX, METHODS)                      \
  COSMERON_EXPAND_OBJ_MEMBERS(COSMERON_INTERNAL_OBJ_MEMBER, CTX,               \
                              PP_UNWRAP METHODS)

#if !defined(OBJECT_DISABLE_FUNCTION_TABLE) && !defined(MODULE_DISABLE_FUNCTION_TABLE)

#define COSMERON_EMIT_DECL_101(MOD, TAG, NAME, BASE, FIELDS_DECL, METHODS)    \
  typedef struct MODULE_TYPE(MOD, NAME) MODULE_TYPE(MOD, NAME);                \
  typedef struct NS(LIB_PREFIX(MOD), NAME, FunctionTable)                    \
      NS(LIB_PREFIX(MOD), NAME, FunctionTable);                             \
  COSMERON_INTERNAL_OBJ_GEN_ENUMS(                                             \
      (NS(LIB_PREFIX(MOD), NAME), MODULE_TYPE(MOD, NAME)), METHODS)          \
  struct MODULE_TYPE(MOD, NAME) {                                              \
    const struct NS(LIB_PREFIX(MOD), NAME, FunctionTable) * api;             \
    COSMERON_INTERNAL_EXT_FIELD(MOD, BASE)                                     \
    COSMERON_INTERNAL_UNWRAP_FIELDS(FIELDS_DECL)                               \
  };                                                                           \
  static inline COSMERON_MAYBE_UNUSED OPSTATUS NS(LIB_PREFIX(MOD), NAME, Init)(\
      MODULE_TYPE(MOD, NAME) * self);                                          \
  COSMERON_INTERNAL_OBJ_GEN_MEMBERS(                                           \
      (NS(LIB_PREFIX(MOD), NAME), MODULE_TYPE(MOD, NAME)), METHODS)          \
  struct NS(LIB_PREFIX(MOD), NAME, FunctionTable) {                          \
    int _reserved;                                                             \
    PP_FOREACH_D2_CTX(COSMERON_MACRO_INTERNAL_OBJ_FT_FIELD,                   \
                      MODULE_TYPE(MOD, NAME), PP_UNWRAP METHODS)               \
  };                                                                           \
  static inline COSMERON_MAYBE_UNUSED                                          \
  const struct NS(LIB_PREFIX(MOD), NAME, FunctionTable) *                    \
  NS(LIB_PREFIX(MOD), NAME, GetFunctionTable)(void) {                        \
    static const COSMERON_MAYBE_UNUSED                                         \
    struct NS(LIB_PREFIX(MOD), NAME, FunctionTable) table = {                \
        ._reserved = 0,                                                        \
        PP_FOREACH_D2_CTX(COSMERON_MACRO_INTERNAL_OBJ_FT_ENTRY,                \
                          NS(LIB_PREFIX(MOD), NAME), PP_UNWRAP METHODS)       \
    };                                                                         \
    return &table;                                                             \
  }                                                                            \
  static inline COSMERON_MAYBE_UNUSED OPSTATUS NS(LIB_PREFIX(MOD), NAME, Init)(\
      MODULE_TYPE(MOD, NAME) * self) {                                         \
    if (!self)                                                                 \
      return STATUS_CONST(INVALID_ARGUMENT);                                   \
    self->api = NS(LIB_PREFIX(MOD), NAME, GetFunctionTable)();               \
    return STATUS_CONST(SUCCESS);                                              \
  }                                                                            \
  typedef int NS(_cosmeron_decl_obj_semi, MOD, NAME, __LINE__);

#else

#define COSMERON_EMIT_DECL_101(MOD, TAG, NAME, BASE, FIELDS_DECL, METHODS)    \
  typedef struct MODULE_TYPE(MOD, NAME) MODULE_TYPE(MOD, NAME);                \
  COSMERON_INTERNAL_OBJ_GEN_ENUMS(                                             \
      (NS(LIB_PREFIX(MOD), NAME), MODULE_TYPE(MOD, NAME)), METHODS)          \
  struct MODULE_TYPE(MOD, NAME) {                                              \
    COSMERON_INTERNAL_EXT_FIELD(MOD, BASE)                                     \
    COSMERON_INTERNAL_UNWRAP_FIELDS(FIELDS_DECL)                               \
  };                                                                           \
  static inline COSMERON_MAYBE_UNUSED OPSTATUS NS(LIB_PREFIX(MOD), NAME, Init)(\
      MODULE_TYPE(MOD, NAME) * self);                                          \
  COSMERON_INTERNAL_OBJ_GEN_MEMBERS(                                           \
      (NS(LIB_PREFIX(MOD), NAME), MODULE_TYPE(MOD, NAME)), METHODS)          \
  static inline COSMERON_MAYBE_UNUSED OPSTATUS NS(LIB_PREFIX(MOD), NAME, Init)(\
      MODULE_TYPE(MOD, NAME) * self) {                                         \
    if (!self)                                                                 \
      return STATUS_CONST(INVALID_ARGUMENT);                                   \
    return STATUS_CONST(SUCCESS);                                              \
  }                                                                            \
  typedef int NS(_cosmeron_decl_obj_semi, MOD, NAME, __LINE__);

#endif

/* ============================================================
 * 2.5 INTERNAL Emitter
 * ============================================================ */

#define COSMERON_INTERNAL_TARGET_0(MOD, NAME) NS(LIB_PREFIX(MOD), Internal)
#define COSMERON_INTERNAL_TARGET_1(MOD, NAME) NS(LIB_PREFIX(MOD), NAME, Internal)
#define COSMERON_INTERNAL_TARGET(MOD, HAS_NAME, NAME)                          \
  PP_OP_CAT2(COSMERON_INTERNAL_TARGET_, HAS_NAME)(MOD, NAME)

#define COSMERON_EMIT_DECL_114(MOD, TAG, HAS_NAME, NAME, METHODS)             \
  COSMERON_INTERNAL_PKG_GEN_ENUMS(                                             \
      COSMERON_INTERNAL_TARGET(MOD, HAS_NAME, NAME), METHODS)                 \
  COSMERON_INTERNAL_PKG_GEN_MEMBERS(                                           \
      COSMERON_INTERNAL_TARGET(MOD, HAS_NAME, NAME), METHODS)                 \
  typedef int NS(_cosmeron_decl_internal_semi, MOD, HAS_NAME, NAME, __LINE__);

/* ============================================================
 * 2. PACKAGE Emitter
 * ============================================================ */

/* Variant Detection: Base vs Suffixed */
#define PROBE_VAR_BASE__COSMERON_BASE_ ,
#define COSMERON_IS_VAR_BASE(x) PP_ARG_COUNT(PP_OP_CAT2(PROBE_VAR_BASE_, x))

#define COSMERON_INTERNAL_VAR_PROTO(CTX, M)                                    \
  COSMERON_MACRO_INTERNAL_UNWRAP_MEMBER(                                       \
      COSMERON_INTERNAL_VAR_PROTO_I, CTX, M)

#define COSMERON_INTERNAL_VAR_PROTO_I(CTX, C, I, R, N, P, ...)                 \
  PP_OP_CAT2(COSMERON_INTERNAL_VAR_FN_, COSMERON_IS_VAR_BASE(N))(               \
      PP_SEQ_GET_1 CTX, PP_SEQ_GET_2 CTX, I, __VA_ARGS__, R, N, P)

#define COSMERON_INTERNAL_VAR_FN_2(CLASS, FAMILY, I, B, R, N, P)               \
  static inline COSMERON_MAYBE_UNUSED R NS(CLASS, FAMILY)                    \
      COSMERON_MACRO_INTERNAL_PKG_EMIT_PARAMS(P)                              \
      PP_OP_CAT2(COSMERON_INTERNAL_PKG_BODY_, I)(B)

#define COSMERON_INTERNAL_VAR_FN_1(CLASS, FAMILY, I, B, R, N, P)               \
  static inline COSMERON_MAYBE_UNUSED R NS(CLASS, PP_OP_CAT2(FAMILY, N))    \
      COSMERON_MACRO_INTERNAL_PKG_EMIT_PARAMS(P)                              \
      PP_OP_CAT2(COSMERON_INTERNAL_PKG_BODY_, I)(B)

/* Space Prototypes */
#define COSMERON_INTERNAL_SPACE_PROTO(SPACE_CLASS, M)                          \
  COSMERON_MACRO_INTERNAL_UNWRAP_MEMBER(                                       \
      COSMERON_INTERNAL_SPACE_PROTO_I, SPACE_CLASS, M)

#define COSMERON_INTERNAL_SPACE_PROTO_I(SPACE_CLASS, C, I, R, N, P, ...)       \
  static inline COSMERON_MAYBE_UNUSED R NS(SPACE_CLASS, N)                   \
      COSMERON_MACRO_INTERNAL_PKG_EMIT_PARAMS(P);

/* Package Member Dispatcher: normal methods (0/1), callbacks (2), SPACE (107), VARIANT (108) */
#define COSMERON_INTERNAL_PKG_MEMBER_EXPAND(MACRO, CLASS, ...)                 \
  MACRO(CLASS, __VA_ARGS__)

#define COSMERON_INTERNAL_PKG_MEMBER_INVOKE(MACRO, CLASS, TUPLE)               \
  COSMERON_INTERNAL_PKG_MEMBER_EXPAND(MACRO, CLASS, PP_UNWRAP TUPLE)

#define COSMERON_INTERNAL_PKG_MEMBER(CLASS, M)                                 \
  COSMERON_INTERNAL_PKG_MEMBER_INVOKE(                                         \
      PP_OP_CAT2(COSMERON_INTERNAL_PKG_MEMBER_TAG_, PP_SEQ_GET_1 M),            \
      CLASS, M)

#define COSMERON_INTERNAL_PKG_BODY_0(B) ;
#define COSMERON_INTERNAL_PKG_BODY_1(...) __VA_ARGS__

#define COSMERON_INTERNAL_PKG_MEMBER_TAG_0(CLASS, C, I, R, N, P, ...)          \
  static inline COSMERON_MAYBE_UNUSED R NS(CLASS, N)                         \
      COSMERON_MACRO_INTERNAL_PKG_EMIT_PARAMS(P)                              \
      PP_OP_CAT2(COSMERON_INTERNAL_PKG_BODY_, I)(__VA_ARGS__)

#define COSMERON_INTERNAL_PKG_MEMBER_TAG_1(CLASS, C, I, R, N, P, ...)          \
  static inline COSMERON_MAYBE_UNUSED R NS(CLASS, N)                         \
      COSMERON_MACRO_INTERNAL_PKG_EMIT_PARAMS(P)                              \
      PP_OP_CAT2(COSMERON_INTERNAL_PKG_BODY_, I)(__VA_ARGS__)

#define COSMERON_INTERNAL_PKG_MEMBER_TAG_2(CLASS, C, I, R, N, P, B)            \
  CALLBACK_FUNCTION(R, NS(CLASS, N), P);
#define COSMERON_INTERNAL_PKG_MEMBER_TAG_103(CLASS, TAG, NAME, TABLE, DISP)

#define COSMERON_EXPAND_INNER_MEMBERS(m, ctx, ...)                            \
  PP_FOREACH_D3_CTX(m, ctx, __VA_ARGS__)

#define COSMERON_INTERNAL_PKG_MEMBER_TAG_107(CLASS, TAG, SUBSPACE, METHODS)    \
  COSMERON_EXPAND_INNER_MEMBERS(COSMERON_INTERNAL_SPACE_PROTO,                 \
                                NS(CLASS, SUBSPACE), PP_UNWRAP METHODS)

#define COSMERON_INTERNAL_PKG_MEMBER_TAG_108(CLASS, TAG, FAMILY, VARIANTS)     \
  COSMERON_EXPAND_INNER_MEMBERS(COSMERON_INTERNAL_VAR_PROTO,                   \
                                (CLASS, FAMILY), PP_UNWRAP VARIANTS)
#define COSMERON_INTERNAL_PKG_MEMBER_TAG_109(CLASS, ...)
#define COSMERON_INTERNAL_PKG_MEMBER_TAG_110(CLASS, ...)
#define COSMERON_INTERNAL_PKG_MEMBER_TAG_111(CLASS, ...)
#define COSMERON_INTERNAL_PKG_MEMBER_TAG_112(CLASS, ...)
#define COSMERON_INTERNAL_PKG_MEMBER_TAG_113(CLASS, ...)
#define COSMERON_INTERNAL_PKG_MEMBER_TAG_114(CLASS, ...)
#define COSMERON_INTERNAL_PKG_MEMBER_TAG_115(CLASS, TAG, MEMBERS)              \
  PP_FOREACH_D3_CTX(COSMERON_INTERNAL_SCOPE_CB_MEMBER, CLASS,                  \
                    PP_UNWRAP MEMBERS)
#define COSMERON_INTERNAL_PKG_MEMBER_TAG_116(CLASS, TAG, MEMBERS)              \
  PP_FOREACH_D3_CTX(COSMERON_INTERNAL_SCOPE_CL_MEMBER, CLASS,                  \
                    PP_UNWRAP MEMBERS)

#define COSMERON_INTERNAL_PKG_ENUM_MEMBER_EXPAND(MACRO, CLASS, ...)            \
  MACRO(CLASS, __VA_ARGS__)
#define COSMERON_INTERNAL_PKG_ENUM_MEMBER_INVOKE(MACRO, CLASS, TUPLE)          \
  COSMERON_INTERNAL_PKG_ENUM_MEMBER_EXPAND(MACRO, CLASS, PP_UNWRAP TUPLE)
#define COSMERON_INTERNAL_PKG_ENUM_MEMBER(CLASS, M)                            \
  COSMERON_INTERNAL_PKG_ENUM_MEMBER_INVOKE(                                    \
      PP_OP_CAT2(COSMERON_INTERNAL_PKG_ENUM_TAG_, PP_SEQ_GET_1 M),            \
      CLASS, M)

#define COSMERON_INTERNAL_PKG_ENUM_TAG_0(CLASS, ...)
#define COSMERON_INTERNAL_PKG_ENUM_TAG_1(CLASS, ...)
#define COSMERON_INTERNAL_PKG_ENUM_TAG_2(CLASS, ...)
#define COSMERON_INTERNAL_PKG_ENUM_TAG_107(CLASS, ...)
#define COSMERON_INTERNAL_PKG_ENUM_TAG_108(CLASS, ...)
#define COSMERON_INTERNAL_PKG_ENUM_TAG_109(CLASS, ...)
#define COSMERON_INTERNAL_PKG_ENUM_TAG_110(CLASS, ...)
#define COSMERON_INTERNAL_PKG_ENUM_TAG_111(CLASS, ...)
#define COSMERON_INTERNAL_PKG_ENUM_TAG_112(CLASS, ...)
#define COSMERON_INTERNAL_PKG_ENUM_TAG_113(CLASS, ...)
#define COSMERON_INTERNAL_PKG_ENUM_TAG_114(CLASS, ...)
#define COSMERON_INTERNAL_PKG_ENUM_TAG_115(CLASS, ...)
#define COSMERON_INTERNAL_PKG_ENUM_TAG_116(CLASS, ...)
#define COSMERON_INTERNAL_PKG_ENUM_TAG_103(CLASS, TAG, NAME, TABLE, DISP)      \
  COSMERON_INTERNAL_EMIT_ENUM_DEF(CLASS, NAME, TABLE, DISP)

#define COSMERON_INTERNAL_PKG_GEN_ENUMS(CLASS, METHODS)                       \
  PP_FOREACH_D2_CTX(COSMERON_INTERNAL_PKG_ENUM_MEMBER, CLASS,                 \
                    PP_UNWRAP METHODS)

#define COSMERON_EXPAND_PKG_MEMBERS(m, ctx, ...)                              \
  PP_FOREACH_D2_CTX(m, ctx, __VA_ARGS__)

#define COSMERON_INTERNAL_PKG_GEN_MEMBERS(CLASS, METHODS)                     \
  COSMERON_EXPAND_PKG_MEMBERS(COSMERON_INTERNAL_PKG_MEMBER, CLASS,              \
                              PP_UNWRAP METHODS)

#if !defined(PACKAGE_DISABLE_FUNCTION_TABLE) && !defined(MODULE_DISABLE_FUNCTION_TABLE)

#define COSMERON_EMIT_DECL_102(MOD, TAG, NAME, BASE, FIELDS_DECL, METHODS)    \
  typedef struct NS(LIB_PREFIX(MOD), NAME, FunctionTable)                    \
      NS(LIB_PREFIX(MOD), NAME, FunctionTable);                             \
  COSMERON_INTERNAL_PKG_GEN_ENUMS(                                             \
      NS(LIB_PREFIX(MOD), NAME), METHODS)                                    \
  COSMERON_INTERNAL_PKG_GEN_MEMBERS(                                           \
      NS(LIB_PREFIX(MOD), NAME), METHODS)                                    \
  struct NS(LIB_PREFIX(MOD), NAME, FunctionTable) {                          \
    int _reserved;                                                             \
    PP_FOREACH_D2_CTX(COSMERON_MACRO_INTERNAL_PKG_FT_FIELD,                   \
                      NS(LIB_PREFIX(MOD), NAME), PP_UNWRAP METHODS)           \
  };                                                                           \
  static inline COSMERON_MAYBE_UNUSED                                          \
  const struct NS(LIB_PREFIX(MOD), NAME, FunctionTable) *                    \
  NS(LIB_PREFIX(MOD), NAME, GetFunctionTable)(void) {                        \
    static const COSMERON_MAYBE_UNUSED                                         \
    struct NS(LIB_PREFIX(MOD), NAME, FunctionTable) table = {                \
        ._reserved = 0,                                                        \
        PP_FOREACH_D2_CTX(COSMERON_MACRO_INTERNAL_PKG_FT_ENTRY,                \
                          NS(LIB_PREFIX(MOD), NAME), PP_UNWRAP METHODS)       \
    };                                                                         \
    return &table;                                                             \
  }                                                                            \
  typedef int NS(_cosmeron_decl_pkg_semi, MOD, NAME, __LINE__);

#else

#define COSMERON_EMIT_DECL_102(MOD, TAG, NAME, BASE, FIELDS_DECL, METHODS)    \
  COSMERON_INTERNAL_PKG_GEN_ENUMS(                                             \
      NS(LIB_PREFIX(MOD), NAME), METHODS)                                    \
  COSMERON_INTERNAL_PKG_GEN_MEMBERS(                                           \
      NS(LIB_PREFIX(MOD), NAME), METHODS)                                    \
  typedef int NS(_cosmeron_decl_pkg_semi, MOD, NAME, __LINE__);

#endif

/* ============================================================
 * 2.5 INTERNAL Emitter
 * ============================================================ */

#define COSMERON_INTERNAL_TARGET_0(MOD, NAME) NS(LIB_PREFIX(MOD), Internal)
#define COSMERON_INTERNAL_TARGET_1(MOD, NAME) NS(LIB_PREFIX(MOD), NAME, Internal)
#define COSMERON_INTERNAL_TARGET(MOD, HAS_NAME, NAME)                            PP_OP_CAT2(COSMERON_INTERNAL_TARGET_, HAS_NAME)(MOD, NAME)

#define COSMERON_EMIT_DECL_114(MOD, TAG, HAS_NAME, NAME, METHODS)               COSMERON_INTERNAL_PKG_GEN_ENUMS(                                                   COSMERON_INTERNAL_TARGET(MOD, HAS_NAME, NAME), METHODS)                   COSMERON_INTERNAL_PKG_GEN_MEMBERS(                                                 COSMERON_INTERNAL_TARGET(MOD, HAS_NAME, NAME), METHODS)                   typedef int NS(_cosmeron_decl_internal_semi, MOD, HAS_NAME, NAME, __LINE__);

/* ============================================================
 * 2.5 INTERNAL Emitter
 * ============================================================ */

#define COSMERON_INTERNAL_TARGET_0(MOD, NAME) NS(LIB_PREFIX(MOD), Internal)
#define COSMERON_INTERNAL_TARGET_1(MOD, NAME) NS(LIB_PREFIX(MOD), NAME, Internal)
