  PP_OP_CAT2(COSMERON_INTERNAL_TARGET_, HAS_NAME)(MOD, NAME)

#define COSMERON_EMIT_DECL_114(MOD, TAG, HAS_NAME, NAME, METHODS)             \
  COSMERON_INTERNAL_PKG_GEN_ENUMS(                                             \
      COSMERON_INTERNAL_TARGET(MOD, HAS_NAME, NAME), METHODS)                 \
  COSMERON_INTERNAL_PKG_GEN_MEMBERS(                                           \
      COSMERON_INTERNAL_TARGET(MOD, HAS_NAME, NAME), METHODS)                 \
  typedef int NS(_cosmeron_decl_internal_semi, MOD, HAS_NAME, NAME, __LINE__);

/* ============================================================
 * 3. ENUM Emitter (Top-Level MODULE)
 * ============================================================ */

#define COSMERON_EMIT_DECL_103(MOD, TAG, NAME, TABLE, DISP)                   \
  COSMERON_INTERNAL_EMIT_ENUM_DEF(LIB_PREFIX(MOD), NAME, TABLE, DISP)          \
  typedef int NS(_cosmeron_decl_enum_semi, MOD, NAME, __LINE__);

/* ============================================================
 * 3.5 STRUCT Emitter
 * ============================================================ */

#define STRUCT_DEF(MOD, NAME, FIELDS_DECL)                                    \
  typedef struct MODULE_TYPE(MOD, NAME) MODULE_TYPE(MOD, NAME);                \
  struct MODULE_TYPE(MOD, NAME) {                                              \
    COSMERON_INTERNAL_UNWRAP_FIELDS(FIELDS_DECL)                               \
  };                                                                           \
  typedef int NS(_cosmeron_decl_struct_semi, MOD, NAME, __LINE__)

#define COSMERON_EMIT_DECL_110(MOD, TAG, NAME, FIELDS_DECL)                   \
  STRUCT_DEF(MOD, NAME, FIELDS_DECL);

#define ISTRUCT_DEF(MOD, NAME, FIELDS_DECL)                                  \
  typedef struct MODULE_ITYPE(MOD, NAME) MODULE_ITYPE(MOD, NAME);             \
  struct MODULE_ITYPE(MOD, NAME) {                                            \
    COSMERON_INTERNAL_UNWRAP_FIELDS(FIELDS_DECL)                              \
  };                                                                          \
  typedef int NS(_cosmeron_decl_istruct_semi, MOD, NAME, __LINE__)

#define COSMERON_EMIT_DECL_112(MOD, TAG, NAME, FIELDS_DECL)                  \
  ISTRUCT_DEF(MOD, NAME, FIELDS_DECL);

#define COSMERON_EMIT_DECL_115(MOD, TAG, MEMBERS)                             \
  PP_FOREACH_D2_CTX(COSMERON_INTERNAL_SCOPE_CB_MEMBER, LIB_PREFIX(MOD),        \
                    PP_UNWRAP MEMBERS)

#define COSMERON_EMIT_DECL_116(MOD, TAG, MEMBERS)                             \
  PP_FOREACH_D2_CTX(COSMERON_INTERNAL_SCOPE_CL_MEMBER, LIB_PREFIX(MOD),        \
                    PP_UNWRAP MEMBERS)

/* ============================================================
 * 4. TEMPLATE Emitters
 * ============================================================ */

#if !defined(OBJECT_DISABLE_FUNCTION_TABLE) && !defined(MODULE_DISABLE_FUNCTION_TABLE)

#define TEMPLATE_OBJECT_DEF(MOD, NAME, SUFFIX, FIELDS_DECL, ...)               \
  typedef struct MODULE_TYPED(MOD, NAME, SUFFIX)                              \
      MODULE_TYPED(MOD, NAME, SUFFIX);                                         \
  typedef struct NS(LIB_PREFIX(MOD), NAME, SUFFIX, FunctionTable)             \
      NS(LIB_PREFIX(MOD), NAME, SUFFIX, FunctionTable);                      \
  COSMERON_INTERNAL_OBJ_GEN_ENUMS(                                             \
      (NS(LIB_PREFIX(MOD), NAME, SUFFIX), MODULE_TYPED(MOD, NAME, SUFFIX)),   \
      (__VA_ARGS__))                                                           \
  struct MODULE_TYPED(MOD, NAME, SUFFIX) {                                     \
    const struct NS(LIB_PREFIX(MOD), NAME, SUFFIX, FunctionTable) * api;      \
    COSMERON_INTERNAL_UNWRAP_FIELDS(FIELDS_DECL)                               \
  };                                                                           \
  static inline COSMERON_MAYBE_UNUSED OPSTATUS NS(LIB_PREFIX(MOD), NAME,       \
                                                  SUFFIX, Init)(               \
      MODULE_TYPED(MOD, NAME, SUFFIX) * self);                                 \
  COSMERON_INTERNAL_OBJ_GEN_MEMBERS(                                           \
      (NS(LIB_PREFIX(MOD), NAME, SUFFIX), MODULE_TYPED(MOD, NAME, SUFFIX)),   \
      (__VA_ARGS__))                                                           \
  struct NS(LIB_PREFIX(MOD), NAME, SUFFIX, FunctionTable) {                   \
    int _reserved;                                                             \
    PP_FOREACH_D2_CTX(COSMERON_MACRO_INTERNAL_OBJ_FT_FIELD,                   \
                      MODULE_TYPED(MOD, NAME, SUFFIX), __VA_ARGS__)           \
  };                                                                           \
  static inline COSMERON_MAYBE_UNUSED                                          \
  const struct NS(LIB_PREFIX(MOD), NAME, SUFFIX, FunctionTable) *             \
  NS(LIB_PREFIX(MOD), NAME, SUFFIX, GetFunctionTable)(void) {                 \
    static const COSMERON_MAYBE_UNUSED                                         \
    struct NS(LIB_PREFIX(MOD), NAME, SUFFIX, FunctionTable) table = {         \
        ._reserved = 0,                                                        \
        PP_FOREACH_D2_CTX(COSMERON_MACRO_INTERNAL_OBJ_FT_ENTRY,                \
                          NS(LIB_PREFIX(MOD), NAME, SUFFIX), __VA_ARGS__)      \
    };                                                                         \
    return &table;                                                             \
  }                                                                            \
  static inline COSMERON_MAYBE_UNUSED OPSTATUS NS(LIB_PREFIX(MOD), NAME,       \
                                                  SUFFIX, Init)(               \
      MODULE_TYPED(MOD, NAME, SUFFIX) * self) {                                \
    if (!self)                                                                 \
      return STATUS_CONST(INVALID_ARGUMENT);                                   \
    self->api = NS(LIB_PREFIX(MOD), NAME, SUFFIX, GetFunctionTable)();        \
    return STATUS_CONST(SUCCESS);                                              \
  }                                                                            \
  typedef int NS(_cosmeron_tpl_obj_semi, MOD, NAME, SUFFIX, __LINE__)

#else

#define TEMPLATE_OBJECT_DEF(MOD, NAME, SUFFIX, FIELDS_DECL, ...)               \
  typedef struct MODULE_TYPED(MOD, NAME, SUFFIX)                              \
      MODULE_TYPED(MOD, NAME, SUFFIX);                                         \
  COSMERON_INTERNAL_OBJ_GEN_ENUMS(                                             \
      (NS(LIB_PREFIX(MOD), NAME, SUFFIX), MODULE_TYPED(MOD, NAME, SUFFIX)),   \
      (__VA_ARGS__))                                                           \
  struct MODULE_TYPED(MOD, NAME, SUFFIX) {                                     \
    COSMERON_INTERNAL_UNWRAP_FIELDS(FIELDS_DECL)                               \
  };                                                                           \
  static inline COSMERON_MAYBE_UNUSED OPSTATUS NS(LIB_PREFIX(MOD), NAME,       \
                                                  SUFFIX, Init)(               \
      MODULE_TYPED(MOD, NAME, SUFFIX) * self);                                 \
  COSMERON_INTERNAL_OBJ_GEN_MEMBERS(                                           \
      (NS(LIB_PREFIX(MOD), NAME, SUFFIX), MODULE_TYPED(MOD, NAME, SUFFIX)),   \
      (__VA_ARGS__))                                                           \
  static inline COSMERON_MAYBE_UNUSED OPSTATUS NS(LIB_PREFIX(MOD), NAME,       \
                                                  SUFFIX, Init)(               \
      MODULE_TYPED(MOD, NAME, SUFFIX) * self) {                                \
    if (!self)                                                                 \
      return STATUS_CONST(INVALID_ARGUMENT);                                   \
    return STATUS_CONST(SUCCESS);                                              \
  }                                                                            \
  typedef int NS(_cosmeron_tpl_obj_semi, MOD, NAME, SUFFIX, __LINE__)

#endif

/* ============================================================
 * 2.5 INTERNAL Emitter
