#define TEMPLATE_STRUCT_DEF(MOD, NAME, SUFFIX, FIELDS_DECL)                   \
  typedef struct MODULE_TYPED(MOD, NAME, SUFFIX)                              \
      MODULE_TYPED(MOD, NAME, SUFFIX);                                         \
  struct MODULE_TYPED(MOD, NAME, SUFFIX) {                                     \
    COSMERON_INTERNAL_UNWRAP_FIELDS(FIELDS_DECL)                               \
  };                                                                           \
  typedef int NS(_cosmeron_tpl_struct_semi, MOD, NAME, SUFFIX, __LINE__)

#define COSMERON_EMIT_DECL_111(MOD, TAG, NAME, ARGS, FIELDS_DECL)             \
  typedef int NS(_cosmeron_decl_tpl_struct_semi, MOD, NAME, __LINE__);

#define TEMPLATE_ISTRUCT_DEF(MOD, NAME, SUFFIX, FIELDS_DECL)                  \
  typedef struct MODULE_ITYPED(MOD, NAME, SUFFIX)                             \
      MODULE_ITYPED(MOD, NAME, SUFFIX);                                        \
  struct MODULE_ITYPED(MOD, NAME, SUFFIX) {                                    \
    COSMERON_INTERNAL_UNWRAP_FIELDS(FIELDS_DECL)                               \
  };                                                                           \
  typedef int NS(_cosmeron_tpl_istruct_semi, MOD, NAME, SUFFIX, __LINE__)

#define COSMERON_EMIT_DECL_113(MOD, TAG, NAME, ARGS, FIELDS_DECL)            \
  typedef int NS(_cosmeron_decl_tpl_istruct_semi, MOD, NAME, __LINE__);

/* ============================================================
 * 5. Direct Free Functions on Pure Module (Section 4.3)
 * Functions have first token 0 or 1 from Tuple.impl.
 * ============================================================ */

#define COSMERON_EMIT_DECL_0(MOD, TAG, CONST_TAG, RET, NAME, PARAMS, BODY)    \
  static inline COSMERON_MAYBE_UNUSED RET NS(LIB_PREFIX(MOD), NAME)          \
      COSMERON_MACRO_INTERNAL_PKG_EMIT_PARAMS(PARAMS);

#define COSMERON_EMIT_DECL_1(MOD, TAG, CONST_TAG, RET, NAME, PARAMS, BODY)    \
  static inline COSMERON_MAYBE_UNUSED RET NS(LIB_PREFIX(MOD), NAME)          \
      COSMERON_MACRO_INTERNAL_PKG_EMIT_PARAMS(PARAMS);

/* ============================================================
 * 6. TABLE Policy Emitter (Section 6.2)
 * ============================================================ */

#define COSMERON_EMIT_DECL_106(MOD, TAG, MODE)                                \
  typedef int NS(_cosmeron_decl_table_semi, MOD, MODE, __LINE__);

/* ============================================================
 * 7. Top-Level MODULE Declarator
 * Supports standalone: MODULE(ModuleName, ...)
 * and drawer/metadata: MODULE(DOMAIN(DomainName), ModuleName, ...)
 * Module is the fundamental semantic unit; domain is organizational grouping.
 * ============================================================ */

#define COSMERON_IS_DOMAIN_PAREN_1(first)                                      \
  PP_ARG_COUNT(PP_OP_CAT2(PROBE_, PP_SEQ_GET_1 first))
#define COSMERON_IS_DOMAIN_PAREN_0(first) 1

#define COSMERON_IS_DOMAIN(first)                                              \
  PP_OP_CAT2(COSMERON_IS_DOMAIN_PAREN_, PP_IS_PAREN(first))(first)

#define COSMERON_INTERNAL_MODULE_2(DOM_DECL, MOD, ...)                         \
  PP_FOREACH_CTX(COSMERON_DISPATCH_DECL, MOD, __VA_ARGS__)                     \
  typedef int NS(_cosmeron_module_semi, MOD, __LINE__)

#define COSMERON_INTERNAL_MODULE_1(MOD, ...)                                  \
  PP_FOREACH_CTX(COSMERON_DISPATCH_DECL, MOD, __VA_ARGS__)                     \
  typedef int NS(_cosmeron_module_semi, MOD, __LINE__)

#define MODULE(...)                                                            \
  PP_OP_CAT2(COSMERON_INTERNAL_MODULE_,                                        \
             COSMERON_IS_DOMAIN(PP_SEQ_FIRST(__VA_ARGS__)))(__VA_ARGS__)

/* EOF */
