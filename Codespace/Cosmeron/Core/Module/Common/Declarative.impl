    struct NS(LIB_PREFIX(MOD), NAME, SUFFIX, FunctionTable) table = {         \
        ._reserved = 0,                                                        \
        PP_FOREACH_D2_CTX(COSMERON_MACRO_INTERNAL_PKG_FT_ENTRY,                \
                          NS(LIB_PREFIX(MOD), NAME, SUFFIX), __VA_ARGS__)      \
    };                                                                         \
    return &table;                                                             \
  }                                                                            \
  typedef int NS(_cosmeron_tpl_pkg_semi, MOD, NAME, SUFFIX, __LINE__)

#else

#define TEMPLATE_PACKAGE_DEF(MOD, NAME, SUFFIX, ...)                           \
  COSMERON_INTERNAL_PKG_GEN_ENUMS(                                             \
      NS(LIB_PREFIX(MOD), NAME, SUFFIX), (__VA_ARGS__))                       \
  COSMERON_INTERNAL_PKG_GEN_MEMBERS(                                           \
      NS(LIB_PREFIX(MOD), NAME, SUFFIX), (__VA_ARGS__))                        \
  typedef int NS(_cosmeron_tpl_pkg_semi, MOD, NAME, SUFFIX, __LINE__)

