/* ============================================================
 * 2.5 INTERNAL Emitter
 * ============================================================ */

#define COSMERON_INTERNAL_TARGET_0(MOD, NAME) NS(LIB_PREFIX(MOD), Internal)
#define COSMERON_INTERNAL_TARGET_1(MOD, NAME) NS(LIB_PREFIX(MOD), NAME, Internal)
#define COSMERON_INTERNAL_TARGET(MOD, HAS_NAME, NAME)                          \
  PP_OP_CAT2(COSMERON_INTERNAL_TARGET_, HAS_NAME)(MOD, NAME)

#define COSMERON_EMIT_DECL_114(MOD, TAG, HAS_NAME, NAME, METHODS)             \
  COSMERON_INTERNAL_PKG_GEN_ENUMS(                                             \
      COSMERON_INTERNAL_TARGET(MOD, HAS_NAME, NAME), METHODS)                 \
  COSMERON_INTERNAL_PKG_GEN_MEMBERS(                                           \
      COSMERON_INTERNAL_TARGET(MOD, HAS_NAME, NAME), METHODS)                 \
  typedef int NS(_cosmeron_decl_internal_semi, MOD, HAS_NAME, NAME, __LINE__);

#define COSMERON_INTERNAL_TPL_OBJ_DISPATCH_1(NAME, ARGS, ...)                 \
  (COSMERON_DECL_TAG_TPL_OBJECT, NAME, ARGS, (~), (__VA_ARGS__))

#define COSMERON_INTERNAL_TPL_OBJ_DISPATCH_0(MOD, NAME, SUFFIX, ...)          \
  TEMPLATE_OBJECT_DEF(MOD, NAME, SUFFIX, __VA_ARGS__)

#undef TEMPLATE_OBJECT
#define TEMPLATE_OBJECT(A, B, ...)                                             \
  PP_OP_CAT2(COSMERON_INTERNAL_TPL_OBJ_DISPATCH_,                             \
             PP_IS_PAREN(B))(A, B, __VA_ARGS__)

#define COSMERON_INTERNAL_TPL_PKG_DISPATCH_1(NAME, ARGS, ...)                 \
  (COSMERON_DECL_TAG_TPL_PACKAGE, NAME, ARGS, (~), (__VA_ARGS__))

#define COSMERON_INTERNAL_TPL_PKG_DISPATCH_0(MOD, NAME, SUFFIX, ...)          \
  TEMPLATE_PACKAGE_DEF(MOD, NAME, SUFFIX, __VA_ARGS__)

#undef TEMPLATE_PACKAGE
#define TEMPLATE_PACKAGE(A, B, ...)                                            \
  PP_OP_CAT2(COSMERON_INTERNAL_TPL_PKG_DISPATCH_,                             \
             PP_IS_PAREN(B))(A, B, __VA_ARGS__)

#define COSMERON_EMIT_DECL_104(MOD, TAG, NAME, ARGS, FIELDS_DECL, METHODS)    \
  _Static_assert(0, "Declaring TEMPLATE_OBJECT inside MODULE(...) is prohibited. Define templates in canonical .def files.");

#define COSMERON_EMIT_DECL_105(MOD, TAG, NAME, ARGS, FIELDS_DECL, METHODS)    \
  _Static_assert(0, "Declaring TEMPLATE_PACKAGE inside MODULE(...) is prohibited. Define templates in canonical .def files.");

#define TEMPLATE_STRUCT_DEF(MOD, NAME, SUFFIX, FIELDS_DECL)                   \
  typedef struct MODULE_TYPED(MOD, NAME, SUFFIX)                              \
      MODULE_TYPED(MOD, NAME, SUFFIX);                                         \
  struct MODULE_TYPED(MOD, NAME, SUFFIX) {                                     \
    COSMERON_INTERNAL_UNWRAP_FIELDS(FIELDS_DECL)                               \
  };                                                                           \
  typedef int NS(_cosmeron_tpl_struct_semi, MOD, NAME, SUFFIX, __LINE__)

#define COSMERON_EMIT_DECL_111(MOD, TAG, NAME, ARGS, FIELDS_DECL)             \
  _Static_assert(0, "Declaring TEMPLATE_STRUCT inside MODULE(...) is prohibited. Define templates in canonical .def files.");

#define TEMPLATE_ISTRUCT_DEF(MOD, NAME, SUFFIX, FIELDS_DECL)                  \
  typedef struct MODULE_ITYPED(MOD, NAME, SUFFIX)                             \
      MODULE_ITYPED(MOD, NAME, SUFFIX);                                        \
  struct MODULE_ITYPED(MOD, NAME, SUFFIX) {                                    \
    COSMERON_INTERNAL_UNWRAP_FIELDS(FIELDS_DECL)                               \
  };                                                                           \
  typedef int NS(_cosmeron_tpl_istruct_semi, MOD, NAME, SUFFIX, __LINE__)

#define COSMERON_EMIT_DECL_113(MOD, TAG, NAME, ARGS, FIELDS_DECL)            \
  _Static_assert(0, "Declaring TEMPLATE_ISTRUCT inside MODULE(...) is prohibited. Define templates in canonical .def files.");

/* ============================================================
 * 5. Direct Free Functions on Pure Module (Section 4.3)
 * Functions have first token 0 or 1 from Tuple.impl.
 * ============================================================ */

#define COSMERON_EMIT_DECL_0(MOD, TAG, CONST_TAG, RET, NAME, PARAMS, BODY)    \
  static inline COSMERON_MAYBE_UNUSED RET NS(LIB_PREFIX(MOD), NAME)          \
      COSMERON_MACRO_INTERNAL_PKG_EMIT_PARAMS(PARAMS);

#define COSMERON_EMIT_DECL_1(MOD, TAG, CONST_TAG, RET, NAME, PARAMS, BODY)    \
  static inline COSMERON_MAYBE_UNUSED RET NS(LIB_PREFIX(MOD), NAME)          \
      COSMERON_MACRO_INTERNAL_PKG_EMIT_PARAMS(PARAMS);

/* ============================================================
 * 6. Top-Level MODULE Declarator
 * Supports standalone: MODULE(ModuleName, ...)
 * and drawer/metadata: MODULE(DOMAIN(DomainName), ModuleName, ...)
 * Module is the fundamental semantic unit; domain is organizational grouping.
 * ============================================================ */

#define COSMERON_IS_DOMAIN_PAREN_1(first)                                      \
  PP_ARG_COUNT(PP_OP_CAT2(PROBE_, PP_SEQ_GET_1 first))
#define COSMERON_IS_DOMAIN_PAREN_0(first) 1

#define COSMERON_IS_DOMAIN(first)                                              \
  PP_OP_CAT2(COSMERON_IS_DOMAIN_PAREN_, PP_IS_PAREN(first))(first)

#define COSMERON_INTERNAL_MODULE_2(DOM_DECL, MOD, ...)                         \
  PP_FOREACH_CTX(COSMERON_DISPATCH_DECL, MOD, __VA_ARGS__)                     \
  typedef int NS(_cosmeron_module_semi, MOD, __LINE__)

#define COSMERON_INTERNAL_MODULE_1(MOD, ...)                                  \
  PP_FOREACH_CTX(COSMERON_DISPATCH_DECL, MOD, __VA_ARGS__)                     \
  typedef int NS(_cosmeron_module_semi, MOD, __LINE__)

#define MODULE(...)                                                            \
  PP_OP_CAT2(COSMERON_INTERNAL_MODULE_,                                        \
             COSMERON_IS_DOMAIN(PP_SEQ_FIRST(__VA_ARGS__)))(__VA_ARGS__)

/* ============================================================
 * 8. Implementation Dispatch Engine (MODULE_IMPLEMENT)
 * ============================================================ */

/* Object Implementation */
#define COSMERON_INTERNAL_OBJ_IMPL_BODY_0(CTX, R, N, P, ...)
#define COSMERON_INTERNAL_OBJ_IMPL_BODY_1(CTX, R, N, P, ...)                   \
  static inline COSMERON_MAYBE_UNUSED R NS(PP_SEQ_GET_1 CTX, N)               \
      COSMERON_MACRO_INTERNAL_OBJ_PROTOEX_EMIT_PARAMS(PP_SEQ_GET_1 CTX, N, P) \
      __VA_ARGS__

#define COSMERON_INTERNAL_OBJ_IMPL_MEMBER_I(CTX, C, I, R, N, P, ...)           \
  PP_OP_CAT2(COSMERON_INTERNAL_OBJ_IMPL_BODY_, I)(CTX, R, N, P, __VA_ARGS__)

#define COSMERON_INTERNAL_OBJ_IMPL_MEMBER_EXPAND(MACRO, CTX, ...)              \
  MACRO(CTX, __VA_ARGS__)
#define COSMERON_INTERNAL_OBJ_IMPL_MEMBER_INVOKE(MACRO, CTX, TUPLE)            \
  COSMERON_INTERNAL_OBJ_IMPL_MEMBER_EXPAND(MACRO, CTX, PP_UNWRAP TUPLE)

#define COSMERON_INTERNAL_OBJ_IMPL_MEMBER(CTX, M)                              \
  COSMERON_INTERNAL_OBJ_IMPL_MEMBER_INVOKE(                                    \
      PP_OP_CAT2(COSMERON_INTERNAL_OBJ_IMPL_TAG_, PP_SEQ_GET_1 M),             \
      CTX, M)

#define COSMERON_INTERNAL_OBJ_IMPL_TAG_0(CTX, C, I, R, N, P, ...)             \
  COSMERON_INTERNAL_OBJ_IMPL_MEMBER_I(CTX, C, I, R, N, P, __VA_ARGS__)
#define COSMERON_INTERNAL_OBJ_IMPL_TAG_1(CTX, C, I, R, N, P, ...)             \
  COSMERON_INTERNAL_OBJ_IMPL_MEMBER_I(CTX, C, I, R, N, P, __VA_ARGS__)
#define COSMERON_INTERNAL_OBJ_IMPL_TAG_2(CTX, ...)
#define COSMERON_INTERNAL_OBJ_IMPL_TAG_3(CTX, ...)
#define COSMERON_INTERNAL_OBJ_IMPL_TAG_4(CTX, ...)
#define COSMERON_INTERNAL_OBJ_IMPL_TAG_103(CTX, ...)
#define COSMERON_INTERNAL_OBJ_IMPL_TAG_107(CTX, TAG, SPACE_NAME, METHODS)     \
  PP_FOREACH_D2_CTX(COSMERON_INTERNAL_OBJ_IMPL_MEMBER,                        \
                    (NS(PP_SEQ_GET_1 CTX, SPACE_NAME), PP_SEQ_GET_2 CTX),      \
                    PP_UNWRAP METHODS)

#define COSMERON_INTERNAL_OBJ_VAR_IMPL(CTX, M)                                \
  COSMERON_MACRO_INTERNAL_UNWRAP_MEMBER(                                       \
      COSMERON_INTERNAL_OBJ_VAR_IMPL_I, CTX, M)

#define COSMERON_INTERNAL_OBJ_VAR_IMPL_I(CTX, C, I, R, N, P, ...)             \
  PP_OP_CAT2(COSMERON_INTERNAL_OBJ_IMPL_BODY_, I)(                             \
      CTX, R, COSMERON_VAR_RESOLVE_NAME(PP_SEQ_GET_3 CTX, N), P, __VA_ARGS__)

#define COSMERON_INTERNAL_OBJ_IMPL_TAG_108(CTX, TAG, FAMILY, VARIANTS)        \
  COSMERON_EXPAND_INNER_MEMBERS(COSMERON_INTERNAL_OBJ_VAR_IMPL,               \
                                (PP_SEQ_GET_1 CTX, PP_SEQ_GET_2 CTX, FAMILY), \
                                PP_UNWRAP VARIANTS)
#define COSMERON_INTERNAL_OBJ_IMPL_TAG_109(CTX, ...)
#define COSMERON_INTERNAL_OBJ_IMPL_TAG_110(CTX, ...)
#define COSMERON_INTERNAL_OBJ_IMPL_TAG_111(CTX, ...)
#define COSMERON_INTERNAL_OBJ_IMPL_TAG_112(CTX, ...)
#define COSMERON_INTERNAL_OBJ_IMPL_TAG_113(CTX, ...)
#define COSMERON_INTERNAL_OBJ_IMPL_TAG_114(CTX, ...)
#define COSMERON_INTERNAL_OBJ_IMPL_TAG_115(CTX, ...)
#define COSMERON_INTERNAL_OBJ_IMPL_TAG_116(CTX, ...)
#define COSMERON_INTERNAL_OBJ_IMPL_TAG_901(CTX, ...)
#define COSMERON_INTERNAL_OBJ_IMPL_TAG_902(CTX, ...)

#define COSMERON_EMIT_IMPL_101(MOD, TAG, NAME, BASE, FIELDS_DECL, METHODS)    \
  PP_FOREACH_D2_CTX(COSMERON_INTERNAL_OBJ_IMPL_MEMBER,                        \
                    (NS(LIB_PREFIX(MOD), NAME), MODULE_TYPE(MOD, NAME)),      \
                    PP_UNWRAP METHODS)

/* Package Implementation */
#define COSMERON_INTERNAL_PKG_IMPL_BODY_0(PKG, R, N, P, ...)
#define COSMERON_INTERNAL_PKG_IMPL_BODY_1(PKG, R, N, P, ...)                   \
  static inline COSMERON_MAYBE_UNUSED R NS(PKG, N)                            \
      COSMERON_MACRO_INTERNAL_PKG_EMIT_PARAMS(P)                              \
      __VA_ARGS__

#define COSMERON_INTERNAL_PKG_IMPL_MEMBER_I(PKG, C, I, R, N, P, ...)           \
  PP_OP_CAT2(COSMERON_INTERNAL_PKG_IMPL_BODY_, I)(PKG, R, N, P, __VA_ARGS__)

#define COSMERON_INTERNAL_PKG_IMPL_MEMBER_EXPAND(MACRO, PKG, ...)              \
  MACRO(PKG, __VA_ARGS__)
#define COSMERON_INTERNAL_PKG_IMPL_MEMBER_INVOKE(MACRO, PKG, TUPLE)            \
  COSMERON_INTERNAL_PKG_IMPL_MEMBER_EXPAND(MACRO, PKG, PP_UNWRAP TUPLE)

#define COSMERON_INTERNAL_PKG_IMPL_MEMBER(PKG, M)                              \
  COSMERON_INTERNAL_PKG_IMPL_MEMBER_INVOKE(                                    \
      PP_OP_CAT2(COSMERON_INTERNAL_PKG_IMPL_TAG_, PP_SEQ_GET_1 M),            \
      PKG, M)

#define COSMERON_INTERNAL_PKG_IMPL_TAG_0(PKG, C, I, R, N, P, ...)             \
  COSMERON_INTERNAL_PKG_IMPL_MEMBER_I(PKG, C, I, R, N, P, __VA_ARGS__)
#define COSMERON_INTERNAL_PKG_IMPL_TAG_1(PKG, C, I, R, N, P, ...)             \
  COSMERON_INTERNAL_PKG_IMPL_MEMBER_I(PKG, C, I, R, N, P, __VA_ARGS__)
#define COSMERON_INTERNAL_PKG_IMPL_TAG_2(PKG, ...)
#define COSMERON_INTERNAL_PKG_IMPL_TAG_3(PKG, ...)
#define COSMERON_INTERNAL_PKG_IMPL_TAG_4(PKG, ...)
#define COSMERON_INTERNAL_PKG_IMPL_TAG_103(PKG, ...)
#define COSMERON_INTERNAL_PKG_IMPL_TAG_107(PKG, TAG, SPACE_NAME, METHODS)     \
  PP_FOREACH_D2_CTX(COSMERON_INTERNAL_PKG_IMPL_MEMBER,                        \
                    NS(PKG, SPACE_NAME), PP_UNWRAP METHODS)

#define COSMERON_INTERNAL_PKG_VAR_IMPL(CTX, M)                                \
  COSMERON_MACRO_INTERNAL_UNWRAP_MEMBER(                                       \
      COSMERON_INTERNAL_PKG_VAR_IMPL_I, CTX, M)

#define COSMERON_INTERNAL_PKG_VAR_IMPL_I(CTX, C, I, R, N, P, ...)             \
  PP_OP_CAT2(COSMERON_INTERNAL_PKG_IMPL_BODY_, I)(                             \
      PP_SEQ_GET_1 CTX, R,                                                     \
      COSMERON_VAR_RESOLVE_NAME(PP_SEQ_GET_2 CTX, N), P, __VA_ARGS__)

#define COSMERON_INTERNAL_PKG_IMPL_TAG_108(PKG, TAG, FAMILY, VARIANTS)        \
  COSMERON_EXPAND_INNER_MEMBERS(COSMERON_INTERNAL_PKG_VAR_IMPL,                \
                                (PKG, FAMILY), PP_UNWRAP VARIANTS)
#define COSMERON_INTERNAL_PKG_IMPL_TAG_109(PKG, ...)
#define COSMERON_INTERNAL_PKG_IMPL_TAG_110(PKG, ...)
#define COSMERON_INTERNAL_PKG_IMPL_TAG_111(PKG, ...)
#define COSMERON_INTERNAL_PKG_IMPL_TAG_112(PKG, ...)
#define COSMERON_INTERNAL_PKG_IMPL_TAG_113(PKG, ...)
#define COSMERON_INTERNAL_PKG_IMPL_TAG_114(PKG, ...)
#define COSMERON_INTERNAL_PKG_IMPL_TAG_115(PKG, ...)
#define COSMERON_INTERNAL_PKG_IMPL_TAG_116(PKG, ...)

#define COSMERON_EMIT_IMPL_102(MOD, TAG, NAME, BASE, FIELDS_DECL, METHODS)    \
  PP_FOREACH_D2_CTX(COSMERON_INTERNAL_PKG_IMPL_MEMBER,                        \
                    NS(LIB_PREFIX(MOD), NAME), PP_UNWRAP METHODS)

/* Direct module functions */
#define COSMERON_EMIT_IMPL_0(MOD, TAG, CONST_TAG, RET, NAME, PARAMS, ...)     \
  static inline COSMERON_MAYBE_UNUSED RET NS(LIB_PREFIX(MOD), NAME)           \
      COSMERON_MACRO_INTERNAL_PKG_EMIT_PARAMS(PARAMS)                         \
      __VA_ARGS__

#define COSMERON_EMIT_IMPL_1(MOD, TAG, CONST_TAG, RET, NAME, PARAMS, ...)     \
  static inline COSMERON_MAYBE_UNUSED RET NS(LIB_PREFIX(MOD), NAME)           \
      COSMERON_MACRO_INTERNAL_PKG_EMIT_PARAMS(PARAMS)                         \
      __VA_ARGS__

#define COSMERON_EMIT_IMPL_103(MOD, ...)
#define COSMERON_EMIT_IMPL_106(MOD, ...)
#define COSMERON_EMIT_IMPL_110(MOD, ...)
#define COSMERON_EMIT_IMPL_111(MOD, ...)
#define COSMERON_EMIT_IMPL_112(MOD, ...)
#define COSMERON_EMIT_IMPL_113(MOD, ...)
#define COSMERON_EMIT_IMPL_115(MOD, ...)
#define COSMERON_EMIT_IMPL_116(MOD, ...)

#define COSMERON_EMIT_IMPL_114(MOD, TAG, HAS_NAME, NAME, METHODS)               PP_FOREACH_D2_CTX(COSMERON_INTERNAL_PKG_IMPL_MEMBER,                                            COSMERON_INTERNAL_TARGET(MOD, HAS_NAME, NAME),                                 PP_UNWRAP METHODS)

#define COSMERON_DISPATCH_IMPL_EXPAND(MACRO, MOD, ...) MACRO(MOD, __VA_ARGS__)
#define COSMERON_DISPATCH_IMPL_INVOKE(MACRO, MOD, TUPLE)                       \
  COSMERON_DISPATCH_IMPL_EXPAND(MACRO, MOD, PP_UNWRAP TUPLE)

#define COSMERON_DISPATCH_IMPL(MOD, ITEM)                                      \
  COSMERON_DISPATCH_IMPL_INVOKE(                                               \
      PP_OP_CAT2(COSMERON_EMIT_IMPL_, PP_SEQ_GET_1 ITEM), MOD, ITEM)

#define COSMERON_INTERNAL_MODULE_IMPL_2(DOM_DECL, MOD, ...)                   \
  COSMERON_INTERNAL_SCOPE_PUSH_DIAGNOSTICS()                                   \
  PP_FOREACH_CTX(COSMERON_DISPATCH_IMPL, MOD, __VA_ARGS__)                     \
  COSMERON_INTERNAL_SCOPE_POP_DIAGNOSTICS()                                    \
  typedef int NS(_cosmeron_module_impl_semi, MOD, __LINE__)

#define COSMERON_INTERNAL_MODULE_IMPL_1(MOD, ...)                              \
  COSMERON_INTERNAL_SCOPE_PUSH_DIAGNOSTICS()                                   \
  PP_FOREACH_CTX(COSMERON_DISPATCH_IMPL, MOD, __VA_ARGS__)                     \
  COSMERON_INTERNAL_SCOPE_POP_DIAGNOSTICS()                                    \
  typedef int NS(_cosmeron_module_impl_semi, MOD, __LINE__)

#define MODULE_IMPLEMENT(...)                                                  \
  PP_OP_CAT2(COSMERON_INTERNAL_MODULE_IMPL_,                                   \
             COSMERON_IS_DOMAIN(PP_SEQ_FIRST(__VA_ARGS__)))(__VA_ARGS__)

#define OBJECT_IMPLEMENT_EX(MOD, OBJ, ...)                                     \
  COSMERON_INTERNAL_SCOPE_PUSH_DIAGNOSTICS()                                   \
  COSMERON_EMIT_IMPL_101(MOD, 101, OBJ, (0, ~), (COSMERON_FIELDS_TAG, ()),     \
                         (__VA_ARGS__))                                        \
  COSMERON_INTERNAL_SCOPE_POP_DIAGNOSTICS()                                    \
  typedef int NS(_cosmeron_obj_impl_semi, MOD, OBJ, __LINE__)

#define PACKAGE_IMPLEMENT_EX(MOD, PKG, ...)                                    \
  COSMERON_INTERNAL_SCOPE_PUSH_DIAGNOSTICS()                                   \
  COSMERON_EMIT_IMPL_102(MOD, 102, PKG, (0, ~), (~), (__VA_ARGS__))           \
  COSMERON_INTERNAL_SCOPE_POP_DIAGNOSTICS()                                    \
  typedef int NS(_cosmeron_pkg_impl_semi, MOD, PKG, __LINE__)

#define INTERNAL_DEF(MOD, ...)                                                   COSMERON_EMIT_DECL_114(MOD, 114, 0, _cosmeron_root, (__VA_ARGS__))

#define INTERNAL_DEF_EX(MOD, NAME, ...)                                          COSMERON_EMIT_DECL_114(MOD, 114, 1, NAME, (__VA_ARGS__))

#define INTERNAL_IMPLEMENT(MOD, ...)                                             COSMERON_INTERNAL_SCOPE_PUSH_DIAGNOSTICS()                                     COSMERON_EMIT_IMPL_114(MOD, 114, 0, _cosmeron_root, (__VA_ARGS__))            COSMERON_INTERNAL_SCOPE_POP_DIAGNOSTICS()                                      typedef int NS(_cosmeron_internal_impl_semi, MOD, __LINE__)

#define INTERNAL_IMPLEMENT_EX(MOD, NAME, ...)                                    COSMERON_INTERNAL_SCOPE_PUSH_DIAGNOSTICS()                                     COSMERON_EMIT_IMPL_114(MOD, 114, 1, NAME, (__VA_ARGS__))                       COSMERON_INTERNAL_SCOPE_POP_DIAGNOSTICS()                                      typedef int NS(_cosmeron_internal_impl_semi, MOD, NAME, __LINE__)

