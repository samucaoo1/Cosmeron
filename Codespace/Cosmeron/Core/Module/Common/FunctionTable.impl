#define COSMERON_MACRO_INTERNAL_PKG_FT_ENTRY_TAG_109(PKG, M)
#define COSMERON_MACRO_INTERNAL_PKG_FT_ENTRY_TAG_110(PKG, M)
#define COSMERON_MACRO_INTERNAL_PKG_FT_ENTRY_TAG_111(PKG, M)
#define COSMERON_MACRO_INTERNAL_PKG_FT_ENTRY_TAG_112(PKG, M)
