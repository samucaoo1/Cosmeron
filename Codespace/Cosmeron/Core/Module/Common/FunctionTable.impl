#pragma once

#include "Tuple.impl"

/* ============================================================
 * FunctionTable Generator Engine
 * Generates FunctionTable struct, designated initializer,
 * and singleton table accessor GetFunctionTable().
 * Supports normal methods, events, and VARIANT member families.
 * ============================================================ */

/* ------------------------------------------------------------
 * 1. Object FunctionTable Generators
 * ------------------------------------------------------------ */

#define COSMERON_MACRO_INTERNAL_OBJ_FT_FIELD_C_0(CLASS, R, N, P)               \
  R (*N) COSMERON_MACRO_INTERNAL_OBJ_EMIT_PARAMS(CLASS, 0, P);
#define COSMERON_MACRO_INTERNAL_OBJ_FT_FIELD_C_1(CLASS, R, N, P)               \
  R (*N) COSMERON_MACRO_INTERNAL_OBJ_EMIT_PARAMS(CLASS, 1, P);
#define COSMERON_MACRO_INTERNAL_OBJ_FT_FIELD_C_2(CLASS, R, N, P)
#define COSMERON_MACRO_INTERNAL_OBJ_FT_FIELD_C_3(CLASS, R, N, P)               \
  OPSTATUS (*NS(N, Subscribe))(CLASS * self, TDELEGATE(NS(CLASS, N)) listener);\
  OPSTATUS (*NS(N, Unsubscribe))(CLASS * self, TDELEGATE(NS(CLASS, N)) listener);\
  void (*NS(N, Emit)) COSMERON_MACRO_INTERNAL_OBJ_EMIT_PARAMS(CLASS, 0, P);    \
  OPSTATUS (*NS(N, Clear))(CLASS * self);                                      \
  uint8_t (*NS(N, Count))(const CLASS * self);                                 \
  uint8_t (*NS(N, Capacity))(const CLASS * self);
#define COSMERON_MACRO_INTERNAL_OBJ_FT_FIELD_C_4(CLASS, R, N, P)               \
  OPSTATUS (*NS(N, Subscribe))(CLASS * self, TDELEGATE(NS(CLASS, N)) listener);\
  OPSTATUS (*NS(N, Unsubscribe))(CLASS * self, TDELEGATE(NS(CLASS, N)) listener);\
  OPSTATUS (*NS(N, Emit)) COSMERON_MACRO_INTERNAL_OBJ_EMIT_PARAMS(CLASS, 0, P);\
  OPSTATUS (*NS(N, Clear))(CLASS * self);                                      \
  uint8_t (*NS(N, Count))(const CLASS * self);                                 \
  uint8_t (*NS(N, Capacity))(const CLASS * self);

#define COSMERON_MACRO_INTERNAL_OBJ_FT_FIELD_I(CLASS, C, I, R, N, P, B)        \
  PP_OP_CAT2(COSMERON_MACRO_INTERNAL_OBJ_FT_FIELD_C_, C)(CLASS, R, N, P)

/* Object Variant FT Field Generator */
#define COSMERON_INTERNAL_OBJ_FT_FIELD_VAR_ITEM(CTX, V)                        \
  COSMERON_MACRO_INTERNAL_UNWRAP_MEMBER(                                       \
      COSMERON_INTERNAL_OBJ_FT_FIELD_VAR_ITEM_I, CTX, V)

#define COSMERON_INTERNAL_OBJ_FT_FIELD_VAR_ITEM_I(CTX, C, I, R, N, P, B)       \
  R (*COSMERON_VAR_RESOLVE_NAME(PP_SEQ_GET_2 CTX, N))                          \
      COSMERON_MACRO_INTERNAL_OBJ_EMIT_PARAMS(PP_SEQ_GET_1 CTX, C, P);

#define COSMERON_INTERNAL_OBJ_FT_FIELD_VAR(CLASS, FAMILY, VARIANTS)            \
  PP_FOREACH_D3_CTX(COSMERON_INTERNAL_OBJ_FT_FIELD_VAR_ITEM,                   \
                    (CLASS, FAMILY), PP_UNWRAP VARIANTS)

#define COSMERON_MACRO_INTERNAL_OBJ_FT_FIELD_TAG_0(CLASS, M)                   \
  COSMERON_MACRO_INTERNAL_UNWRAP_MEMBER(                                       \
      COSMERON_MACRO_INTERNAL_OBJ_FT_FIELD_I, CLASS, M)
#define COSMERON_MACRO_INTERNAL_OBJ_FT_FIELD_TAG_1(CLASS, M)                   \
  COSMERON_MACRO_INTERNAL_UNWRAP_MEMBER(                                       \
      COSMERON_MACRO_INTERNAL_OBJ_FT_FIELD_I, CLASS, M)
#define COSMERON_MACRO_INTERNAL_OBJ_FT_FIELD_TAG_2(CLASS, M)
#define COSMERON_MACRO_INTERNAL_OBJ_FT_FIELD_TAG_103(CLASS, M)
#define COSMERON_MACRO_INTERNAL_OBJ_FT_FIELD_TAG_3(CLASS, M)                   \
  COSMERON_MACRO_INTERNAL_UNWRAP_MEMBER(                                       \
      COSMERON_MACRO_INTERNAL_OBJ_FT_FIELD_I, CLASS, M)
#define COSMERON_MACRO_INTERNAL_OBJ_FT_FIELD_TAG_4(CLASS, M)                   \
  COSMERON_MACRO_INTERNAL_UNWRAP_MEMBER(                                       \
      COSMERON_MACRO_INTERNAL_OBJ_FT_FIELD_I, CLASS, M)
#define COSMERON_MACRO_INTERNAL_OBJ_FT_FIELD_TAG_107(CLASS, M)
#define COSMERON_MACRO_INTERNAL_OBJ_FT_FIELD_TAG_108(CLASS, M)                 \
  COSMERON_INTERNAL_OBJ_FT_FIELD_VAR(CLASS, PP_SEQ_GET_2 M, PP_SEQ_GET_3 M)
#define COSMERON_MACRO_INTERNAL_OBJ_FT_FIELD_TAG_109(CLASS, M)
#define COSMERON_MACRO_INTERNAL_OBJ_FT_FIELD_TAG_110(CLASS, M)
#define COSMERON_MACRO_INTERNAL_OBJ_FT_FIELD_TAG_111(CLASS, M)
#define COSMERON_MACRO_INTERNAL_OBJ_FT_FIELD_TAG_112(CLASS, M)
#define COSMERON_MACRO_INTERNAL_OBJ_FT_FIELD_TAG_113(CLASS, M)
#define COSMERON_MACRO_INTERNAL_OBJ_FT_FIELD_TAG_114(CLASS, M)
#define COSMERON_MACRO_INTERNAL_OBJ_FT_FIELD_TAG_115(CLASS, M)
#define COSMERON_MACRO_INTERNAL_OBJ_FT_FIELD_TAG_116(CLASS, M)
#define COSMERON_MACRO_INTERNAL_OBJ_FT_FIELD_TAG_117(CLASS, M)

#define COSMERON_MACRO_INTERNAL_OBJ_FT_FIELD(CLASS, M)                         \
  PP_OP_CAT2(COSMERON_MACRO_INTERNAL_OBJ_FT_FIELD_TAG_, PP_SEQ_GET_1 M)(CLASS, M)

#define COSMERON_MACRO_INTERNAL_OBJ_FT_ENTRY_C_0(CLASS, N) .N = NS(CLASS, N),
#define COSMERON_MACRO_INTERNAL_OBJ_FT_ENTRY_C_1(CLASS, N) .N = NS(CLASS, N),
#define COSMERON_MACRO_INTERNAL_OBJ_FT_ENTRY_C_2(CLASS, N)
#define COSMERON_MACRO_INTERNAL_OBJ_FT_ENTRY_C_3(CLASS, N)                     \
  .NS(N, Subscribe) = NS(CLASS, N, Subscribe),                                 \
  .NS(N, Unsubscribe) = NS(CLASS, N, Unsubscribe),                             \
  .NS(N, Emit) = NS(CLASS, N, Emit),                                           \
  .NS(N, Clear) = NS(CLASS, N, Clear),                                         \
  .NS(N, Count) = NS(CLASS, N, Count),                                         \
  .NS(N, Capacity) = NS(CLASS, N, Capacity),
#define COSMERON_MACRO_INTERNAL_OBJ_FT_ENTRY_C_4(CLASS, N)                     \
  COSMERON_MACRO_INTERNAL_OBJ_FT_ENTRY_C_3(CLASS, N)

#define COSMERON_MACRO_INTERNAL_OBJ_FT_ENTRY_I(CLASS, C, I, R, N, P, B)        \
  PP_OP_CAT2(COSMERON_MACRO_INTERNAL_OBJ_FT_ENTRY_C_, C)(CLASS, N)

/* Object Variant FT Entry Generator */
#define COSMERON_INTERNAL_OBJ_FT_ENTRY_VAR_ITEM(CTX, V)                        \
  COSMERON_MACRO_INTERNAL_UNWRAP_MEMBER(                                       \
      COSMERON_INTERNAL_OBJ_FT_ENTRY_VAR_ITEM_I, CTX, V)

#define COSMERON_INTERNAL_OBJ_FT_ENTRY_VAR_ITEM_I(CTX, C, I, R, N, P, B)       \
  .COSMERON_VAR_RESOLVE_NAME(PP_SEQ_GET_2 CTX, N) =                            \
      NS(PP_SEQ_GET_1 CTX, COSMERON_VAR_RESOLVE_NAME(PP_SEQ_GET_2 CTX, N)),

#define COSMERON_INTERNAL_OBJ_FT_ENTRY_VAR(CLASS, FAMILY, VARIANTS)            \
  PP_FOREACH_D3_CTX(COSMERON_INTERNAL_OBJ_FT_ENTRY_VAR_ITEM,                   \
                    (CLASS, FAMILY), PP_UNWRAP VARIANTS)

#define COSMERON_MACRO_INTERNAL_OBJ_FT_ENTRY_TAG_0(CLASS, M)                   \
  COSMERON_MACRO_INTERNAL_UNWRAP_MEMBER(                                       \
      COSMERON_MACRO_INTERNAL_OBJ_FT_ENTRY_I, CLASS, M)
#define COSMERON_MACRO_INTERNAL_OBJ_FT_ENTRY_TAG_1(CLASS, M)                   \
  COSMERON_MACRO_INTERNAL_UNWRAP_MEMBER(                                       \
      COSMERON_MACRO_INTERNAL_OBJ_FT_ENTRY_I, CLASS, M)
#define COSMERON_MACRO_INTERNAL_OBJ_FT_ENTRY_TAG_2(CLASS, M)
#define COSMERON_MACRO_INTERNAL_OBJ_FT_ENTRY_TAG_103(CLASS, M)
#define COSMERON_MACRO_INTERNAL_OBJ_FT_ENTRY_TAG_3(CLASS, M)                   \
  COSMERON_MACRO_INTERNAL_UNWRAP_MEMBER(                                       \
      COSMERON_MACRO_INTERNAL_OBJ_FT_ENTRY_I, CLASS, M)
#define COSMERON_MACRO_INTERNAL_OBJ_FT_ENTRY_TAG_4(CLASS, M)                   \
  COSMERON_MACRO_INTERNAL_UNWRAP_MEMBER(                                       \
      COSMERON_MACRO_INTERNAL_OBJ_FT_ENTRY_I, CLASS, M)
#define COSMERON_MACRO_INTERNAL_OBJ_FT_ENTRY_TAG_107(CLASS, M)
#define COSMERON_MACRO_INTERNAL_OBJ_FT_ENTRY_TAG_108(CLASS, M)                 \
  COSMERON_INTERNAL_OBJ_FT_ENTRY_VAR(CLASS, PP_SEQ_GET_2 M, PP_SEQ_GET_3 M)
#define COSMERON_MACRO_INTERNAL_OBJ_FT_ENTRY_TAG_109(CLASS, M)
#define COSMERON_MACRO_INTERNAL_OBJ_FT_ENTRY_TAG_110(CLASS, M)
#define COSMERON_MACRO_INTERNAL_OBJ_FT_ENTRY_TAG_111(CLASS, M)
#define COSMERON_MACRO_INTERNAL_OBJ_FT_ENTRY_TAG_112(CLASS, M)
#define COSMERON_MACRO_INTERNAL_OBJ_FT_ENTRY_TAG_113(CLASS, M)
#define COSMERON_MACRO_INTERNAL_OBJ_FT_ENTRY_TAG_114(CLASS, M)
#define COSMERON_MACRO_INTERNAL_OBJ_FT_ENTRY_TAG_115(CLASS, M)
#define COSMERON_MACRO_INTERNAL_OBJ_FT_ENTRY_TAG_116(CLASS, M)
#define COSMERON_MACRO_INTERNAL_OBJ_FT_ENTRY_TAG_117(CLASS, M)

#define COSMERON_MACRO_INTERNAL_OBJ_FT_ENTRY(CLASS, M)                         \
  PP_OP_CAT2(COSMERON_MACRO_INTERNAL_OBJ_FT_ENTRY_TAG_, PP_SEQ_GET_1 M)(CLASS, M)

/* ------------------------------------------------------------
 * 2. Package FunctionTable Generators
 * ------------------------------------------------------------ */

#define COSMERON_MACRO_INTERNAL_PKG_FT_FIELD_C_0(PKG, R, N, P)                 \
  R (*N) COSMERON_MACRO_INTERNAL_PKG_EMIT_PARAMS(P);
#define COSMERON_MACRO_INTERNAL_PKG_FT_FIELD_C_1(PKG, R, N, P)                 \
  R (*N) COSMERON_MACRO_INTERNAL_PKG_EMIT_PARAMS(P);
#define COSMERON_MACRO_INTERNAL_PKG_FT_FIELD_C_2(PKG, R, N, P)
#define COSMERON_MACRO_INTERNAL_PKG_FT_FIELD_C_3(PKG, R, N, P)                 \
  OPSTATUS (*NS(N, Subscribe))(TDELEGATE(NS(PKG, N)) listener);                \
  OPSTATUS (*NS(N, Unsubscribe))(TDELEGATE(NS(PKG, N)) listener);              \
  void (*NS(N, Emit)) COSMERON_MACRO_INTERNAL_PKG_EMIT_PARAMS(P);              \
  OPSTATUS (*NS(N, Clear))(void);                                              \
  uint8_t (*NS(N, Count))(void);                                               \
  uint8_t (*NS(N, Capacity))(void);
#define COSMERON_MACRO_INTERNAL_PKG_FT_FIELD_C_4(PKG, R, N, P)                 \
  OPSTATUS (*NS(N, Subscribe))(TDELEGATE(NS(PKG, N)) listener);                \
  OPSTATUS (*NS(N, Unsubscribe))(TDELEGATE(NS(PKG, N)) listener);              \
  OPSTATUS (*NS(N, Emit)) COSMERON_MACRO_INTERNAL_PKG_EMIT_PARAMS(P);          \
  OPSTATUS (*NS(N, Clear))(void);                                              \
  uint8_t (*NS(N, Count))(void);                                               \
  uint8_t (*NS(N, Capacity))(void);

#define COSMERON_MACRO_INTERNAL_PKG_FT_FIELD_I(PKG, C, I, R, N, P, B)          \
  PP_OP_CAT2(COSMERON_MACRO_INTERNAL_PKG_FT_FIELD_C_, C)(PKG, R, N, P)

/* Package Variant FT Field Generator */
#define COSMERON_INTERNAL_PKG_FT_FIELD_VAR_ITEM(CTX, V)                        \
  COSMERON_MACRO_INTERNAL_UNWRAP_MEMBER(                                       \
      COSMERON_INTERNAL_PKG_FT_FIELD_VAR_ITEM_I, CTX, V)

#define COSMERON_INTERNAL_PKG_FT_FIELD_VAR_ITEM_I(CTX, C, I, R, N, P, B)       \
  R (*COSMERON_VAR_RESOLVE_NAME(PP_SEQ_GET_2 CTX, N))                          \
      COSMERON_MACRO_INTERNAL_PKG_EMIT_PARAMS(P);

#define COSMERON_INTERNAL_PKG_FT_FIELD_VAR(PKG, FAMILY, VARIANTS)              \
  PP_FOREACH_D3_CTX(COSMERON_INTERNAL_PKG_FT_FIELD_VAR_ITEM,                   \
                    (PKG, FAMILY), PP_UNWRAP VARIANTS)

#define COSMERON_MACRO_INTERNAL_PKG_FT_FIELD_TAG_0(PKG, M)                     \
  COSMERON_MACRO_INTERNAL_UNWRAP_MEMBER(                                       \
      COSMERON_MACRO_INTERNAL_PKG_FT_FIELD_I, PKG, M)
#define COSMERON_MACRO_INTERNAL_PKG_FT_FIELD_TAG_1(PKG, M)                     \
  COSMERON_MACRO_INTERNAL_UNWRAP_MEMBER(                                       \
      COSMERON_MACRO_INTERNAL_PKG_FT_FIELD_I, PKG, M)
#define COSMERON_MACRO_INTERNAL_PKG_FT_FIELD_TAG_2(PKG, M)
#define COSMERON_MACRO_INTERNAL_PKG_FT_FIELD_TAG_103(PKG, M)
#define COSMERON_MACRO_INTERNAL_PKG_FT_FIELD_TAG_3(PKG, M)                     \
  COSMERON_MACRO_INTERNAL_UNWRAP_MEMBER(                                       \
      COSMERON_MACRO_INTERNAL_PKG_FT_FIELD_I, PKG, M)
#define COSMERON_MACRO_INTERNAL_PKG_FT_FIELD_TAG_4(PKG, M)                     \
  COSMERON_MACRO_INTERNAL_UNWRAP_MEMBER(                                       \
      COSMERON_MACRO_INTERNAL_PKG_FT_FIELD_I, PKG, M)
#define COSMERON_MACRO_INTERNAL_PKG_FT_FIELD_TAG_107(PKG, M)
#define COSMERON_MACRO_INTERNAL_PKG_FT_FIELD_TAG_108(PKG, M)                   \
  COSMERON_INTERNAL_PKG_FT_FIELD_VAR(PKG, PP_SEQ_GET_2 M, PP_SEQ_GET_3 M)
#define COSMERON_MACRO_INTERNAL_PKG_FT_FIELD_TAG_109(PKG, M)
#define COSMERON_MACRO_INTERNAL_PKG_FT_FIELD_TAG_110(PKG, M)
#define COSMERON_MACRO_INTERNAL_PKG_FT_FIELD_TAG_111(PKG, M)
#define COSMERON_MACRO_INTERNAL_PKG_FT_FIELD_TAG_112(PKG, M)
#define COSMERON_MACRO_INTERNAL_PKG_FT_FIELD_TAG_113(PKG, M)
#define COSMERON_MACRO_INTERNAL_PKG_FT_FIELD_TAG_114(PKG, M)
#define COSMERON_MACRO_INTERNAL_PKG_FT_FIELD_TAG_115(PKG, M)
#define COSMERON_MACRO_INTERNAL_PKG_FT_FIELD_TAG_116(PKG, M)
#define COSMERON_MACRO_INTERNAL_PKG_FT_FIELD_TAG_117(PKG, M)

#define COSMERON_MACRO_INTERNAL_PKG_FT_FIELD(PKG, M)                           \
  PP_OP_CAT2(COSMERON_MACRO_INTERNAL_PKG_FT_FIELD_TAG_, PP_SEQ_GET_1 M)(PKG, M)

#define COSMERON_MACRO_INTERNAL_PKG_FT_ENTRY_C_0(PKG, N) .N = NS(PKG, N),
#define COSMERON_MACRO_INTERNAL_PKG_FT_ENTRY_C_1(PKG, N) .N = NS(PKG, N),
#define COSMERON_MACRO_INTERNAL_PKG_FT_ENTRY_C_2(PKG, N)
#define COSMERON_MACRO_INTERNAL_PKG_FT_ENTRY_C_3(PKG, N)                       \
  .NS(N, Subscribe) = NS(PKG, N, Subscribe),                                   \
  .NS(N, Unsubscribe) = NS(PKG, N, Unsubscribe),                               \
  .NS(N, Emit) = NS(PKG, N, Emit),                                             \
  .NS(N, Clear) = NS(PKG, N, Clear),                                           \
  .NS(N, Count) = NS(PKG, N, Count),                                           \
  .NS(N, Capacity) = NS(PKG, N, Capacity),
#define COSMERON_MACRO_INTERNAL_PKG_FT_ENTRY_C_4(PKG, N)                       \
  COSMERON_MACRO_INTERNAL_PKG_FT_ENTRY_C_3(PKG, N)

#define COSMERON_MACRO_INTERNAL_PKG_FT_ENTRY_I(PKG, C, I, R, N, P, B)          \
  PP_OP_CAT2(COSMERON_MACRO_INTERNAL_PKG_FT_ENTRY_C_, C)(PKG, N)

/* Package Variant FT Entry Generator */
#define COSMERON_INTERNAL_PKG_FT_ENTRY_VAR_ITEM(CTX, V)                        \
  COSMERON_MACRO_INTERNAL_UNWRAP_MEMBER(                                       \
      COSMERON_INTERNAL_PKG_FT_ENTRY_VAR_ITEM_I, CTX, V)

#define COSMERON_INTERNAL_PKG_FT_ENTRY_VAR_ITEM_I(CTX, C, I, R, N, P, B)       \
  .COSMERON_VAR_RESOLVE_NAME(PP_SEQ_GET_2 CTX, N) =                            \
      NS(PP_SEQ_GET_1 CTX, COSMERON_VAR_RESOLVE_NAME(PP_SEQ_GET_2 CTX, N)),

#define COSMERON_INTERNAL_PKG_FT_ENTRY_VAR(PKG, FAMILY, VARIANTS)              \
  PP_FOREACH_D3_CTX(COSMERON_INTERNAL_PKG_FT_ENTRY_VAR_ITEM,                   \
                    (PKG, FAMILY), PP_UNWRAP VARIANTS)

#define COSMERON_MACRO_INTERNAL_PKG_FT_ENTRY_TAG_0(PKG, M)                     \
  COSMERON_MACRO_INTERNAL_UNWRAP_MEMBER(                                       \
      COSMERON_MACRO_INTERNAL_PKG_FT_ENTRY_I, PKG, M)
#define COSMERON_MACRO_INTERNAL_PKG_FT_ENTRY_TAG_1(PKG, M)                     \
  COSMERON_MACRO_INTERNAL_UNWRAP_MEMBER(                                       \
      COSMERON_MACRO_INTERNAL_PKG_FT_ENTRY_I, PKG, M)
#define COSMERON_MACRO_INTERNAL_PKG_FT_ENTRY_TAG_2(PKG, M)
#define COSMERON_MACRO_INTERNAL_PKG_FT_ENTRY_TAG_103(PKG, M)
#define COSMERON_MACRO_INTERNAL_PKG_FT_ENTRY_TAG_3(PKG, M)                     \
  COSMERON_MACRO_INTERNAL_UNWRAP_MEMBER(                                       \
      COSMERON_MACRO_INTERNAL_PKG_FT_ENTRY_I, PKG, M)
#define COSMERON_MACRO_INTERNAL_PKG_FT_ENTRY_TAG_4(PKG, M)                     \
  COSMERON_MACRO_INTERNAL_UNWRAP_MEMBER(                                       \
      COSMERON_MACRO_INTERNAL_PKG_FT_ENTRY_I, PKG, M)
#define COSMERON_MACRO_INTERNAL_PKG_FT_ENTRY_TAG_107(PKG, M)
#define COSMERON_MACRO_INTERNAL_PKG_FT_ENTRY_TAG_108(PKG, M)                   \
  COSMERON_INTERNAL_PKG_FT_ENTRY_VAR(PKG, PP_SEQ_GET_2 M, PP_SEQ_GET_3 M)
#define COSMERON_MACRO_INTERNAL_PKG_FT_ENTRY_TAG_109(PKG, M)
#define COSMERON_MACRO_INTERNAL_PKG_FT_ENTRY_TAG_110(PKG, M)
#define COSMERON_MACRO_INTERNAL_PKG_FT_ENTRY_TAG_111(PKG, M)
#define COSMERON_MACRO_INTERNAL_PKG_FT_ENTRY_TAG_112(PKG, M)
#define COSMERON_MACRO_INTERNAL_PKG_FT_ENTRY_TAG_113(PKG, M)
#define COSMERON_MACRO_INTERNAL_PKG_FT_ENTRY_TAG_114(PKG, M)
#define COSMERON_MACRO_INTERNAL_PKG_FT_ENTRY_TAG_115(PKG, M)
#define COSMERON_MACRO_INTERNAL_PKG_FT_ENTRY_TAG_116(PKG, M)
#define COSMERON_MACRO_INTERNAL_PKG_FT_ENTRY_TAG_117(PKG, M)

#define COSMERON_MACRO_INTERNAL_PKG_FT_ENTRY(PKG, M)                           \
  PP_OP_CAT2(COSMERON_MACRO_INTERNAL_PKG_FT_ENTRY_TAG_, PP_SEQ_GET_1 M)(PKG, M)

/* ------------------------------------------------------------
 * 3. Expansion-Time & Intrinsic FunctionTable Policy Helpers
 * ------------------------------------------------------------ */

#define COSMERON_DECL_TAG_NO_FUNCTION_TABLE 117
#define NO_FUNCTION_TABLE (COSMERON_DECL_TAG_NO_FUNCTION_TABLE, 0)

#define COSMERON_INTERNAL_FT_CHECK_N(x, n, ...) n
#define COSMERON_INTERNAL_FT_CHECK(...)                                        \
  COSMERON_INTERNAL_FT_CHECK_N(__VA_ARGS__, 0, )
#define COSMERON_INTERNAL_FT_PROBE(x) x, 1,

#define COSMERON_INTERNAL_FT_FLAG_VAL_1 COSMERON_INTERNAL_FT_PROBE(~)

#define COSMERON_INTERNAL_FT_FLAG_NONEMPTY(FLAG)                               \
  COSMERON_INTERNAL_FT_CHECK(PP_OP_CAT2(COSMERON_INTERNAL_FT_FLAG_VAL_, FLAG))
#define COSMERON_INTERNAL_FT_FLAG_IS_SET_1(FLAG) 1
#define COSMERON_INTERNAL_FT_FLAG_IS_SET_0(FLAG)                               \
  COSMERON_INTERNAL_FT_FLAG_NONEMPTY(FLAG)
#define COSMERON_INTERNAL_FT_FLAG_IS_SET(FLAG)                                 \
  PP_OP_CAT2(COSMERON_INTERNAL_FT_FLAG_IS_SET_, PP_IS_EMPTY(FLAG))(FLAG)

#define COSMERON_INTERNAL_PROBE_FT_TAG_117 ,
#define COSMERON_INTERNAL_PROBE_NO_FT_ITEM(M)                                  \
  PP_OP_CAT2(COSMERON_INTERNAL_PROBE_FT_TAG_, PP_SEQ_GET_1 M)

#define COSMERON_INTERNAL_HAS_NO_FT_TAG_1(METHODS) 0
#define COSMERON_INTERNAL_HAS_NO_FT_TAG_0(METHODS)                             \
  PP_HAS_COMMA(                                                                \
      PP_FOREACH_D2(COSMERON_INTERNAL_PROBE_NO_FT_ITEM, PP_UNWRAP METHODS))
#define COSMERON_INTERNAL_HAS_NO_FT_TAG(METHODS)                               \
  PP_OP_CAT2(COSMERON_INTERNAL_HAS_NO_FT_TAG_,                                 \
             PP_IS_EMPTY_PARAMS(METHODS))(METHODS)

#define COSMERON_INTERNAL_FT_OR3(A, B, C)                                      \
  PP_BOOL_OR(PP_BOOL_OR(A, B), C)

#define COSMERON_INTERNAL_PKG_FT_DISABLED(MOD, NAME, METHODS)                  \
  PP_BOOL_OR(                                                                  \
      COSMERON_INTERNAL_FT_OR3(                                                \
          COSMERON_INTERNAL_FT_FLAG_IS_SET(MODULE_DISABLE_FUNCTION_TABLE),     \
          COSMERON_INTERNAL_FT_FLAG_IS_SET(PACKAGE_DISABLE_FUNCTION_TABLE),    \
          COSMERON_INTERNAL_FT_FLAG_IS_SET(PP_OP_CAT2(COSMERON_DISABLE_FT_, MOD))), \
      COSMERON_INTERNAL_FT_OR3(                                                \
          COSMERON_INTERNAL_FT_FLAG_IS_SET(                                    \
              PP_OP_CAT2(MOD, _DISABLE_FUNCTION_TABLE)),                       \
          COSMERON_INTERNAL_FT_OR3(                                            \
              COSMERON_INTERNAL_FT_FLAG_IS_SET(                                \
                  PP_OP_CAT4(COSMERON_DISABLE_FT_, MOD, _, NAME)),             \
              COSMERON_INTERNAL_FT_FLAG_IS_SET(                                \
                  PP_OP_CAT4(MOD, _, NAME, _DISABLE_FUNCTION_TABLE)),          \
              0),                                                              \
          COSMERON_INTERNAL_HAS_NO_FT_TAG(METHODS)))

#define COSMERON_INTERNAL_OBJ_FT_DISABLED(MOD, NAME, METHODS)                  \
  PP_BOOL_OR(                                                                  \
      COSMERON_INTERNAL_FT_OR3(                                                \
          COSMERON_INTERNAL_FT_FLAG_IS_SET(MODULE_DISABLE_FUNCTION_TABLE),     \
          COSMERON_INTERNAL_FT_FLAG_IS_SET(OBJECT_DISABLE_FUNCTION_TABLE),     \
          COSMERON_INTERNAL_FT_FLAG_IS_SET(PP_OP_CAT2(COSMERON_DISABLE_FT_, MOD))), \
      COSMERON_INTERNAL_FT_OR3(                                                \
          COSMERON_INTERNAL_FT_FLAG_IS_SET(                                    \
              PP_OP_CAT2(MOD, _DISABLE_FUNCTION_TABLE)),                       \
          COSMERON_INTERNAL_FT_OR3(                                            \
              COSMERON_INTERNAL_FT_FLAG_IS_SET(                                \
                  PP_OP_CAT4(COSMERON_DISABLE_FT_, MOD, _, NAME)),             \
              COSMERON_INTERNAL_FT_FLAG_IS_SET(                                \
                  PP_OP_CAT4(MOD, _, NAME, _DISABLE_FUNCTION_TABLE)),          \
              0),                                                              \
          COSMERON_INTERNAL_HAS_NO_FT_TAG(METHODS)))

#define COSMERON_INTERNAL_PKG_FT_DISABLED_DOM(DOM, MOD, NAME, METHODS)         \
  PP_BOOL_OR(                                                                  \
      COSMERON_INTERNAL_PKG_FT_DISABLED(MOD, NAME, METHODS),                   \
      PP_BOOL_OR(                                                              \
          COSMERON_INTERNAL_FT_FLAG_IS_SET(                                    \
              PP_OP_CAT2(COSMERON_DISABLE_FT_, DOM)),                          \
          COSMERON_INTERNAL_FT_FLAG_IS_SET(                                    \
              PP_OP_CAT4(COSMERON_DISABLE_FT_, DOM, _, MOD))))

#define COSMERON_INTERNAL_OBJ_FT_DISABLED_DOM(DOM, MOD, NAME, METHODS)         \
  PP_BOOL_OR(                                                                  \
      COSMERON_INTERNAL_OBJ_FT_DISABLED(MOD, NAME, METHODS),                   \
      PP_BOOL_OR(                                                              \
          COSMERON_INTERNAL_FT_FLAG_IS_SET(                                    \
              PP_OP_CAT2(COSMERON_DISABLE_FT_, DOM)),                          \
          COSMERON_INTERNAL_FT_FLAG_IS_SET(                                    \
              PP_OP_CAT4(COSMERON_DISABLE_FT_, DOM, _, MOD))))

#define COSMERON_INTERNAL_STANDALONE_PKG_FT_DISABLED(PKG, ITEMS)               \
  PP_BOOL_OR(                                                                  \
      COSMERON_INTERNAL_FT_OR3(                                                \
          COSMERON_INTERNAL_FT_FLAG_IS_SET(MODULE_DISABLE_FUNCTION_TABLE),     \
          COSMERON_INTERNAL_FT_FLAG_IS_SET(PACKAGE_DISABLE_FUNCTION_TABLE),    \
          COSMERON_INTERNAL_FT_FLAG_IS_SET(PP_OP_CAT2(COSMERON_DISABLE_FT_, PKG))), \
      PP_BOOL_OR(                                                              \
          COSMERON_INTERNAL_FT_FLAG_IS_SET(                                    \
              PP_OP_CAT2(PKG, _DISABLE_FUNCTION_TABLE)),                       \
          COSMERON_INTERNAL_HAS_NO_FT_TAG(ITEMS)))

#define COSMERON_INTERNAL_STANDALONE_OBJ_FT_DISABLED(CLASS, ITEMS)             \
  PP_BOOL_OR(                                                                  \
      COSMERON_INTERNAL_FT_OR3(                                                \
          COSMERON_INTERNAL_FT_FLAG_IS_SET(MODULE_DISABLE_FUNCTION_TABLE),     \
          COSMERON_INTERNAL_FT_FLAG_IS_SET(OBJECT_DISABLE_FUNCTION_TABLE),     \
          COSMERON_INTERNAL_FT_FLAG_IS_SET(                                    \
              PP_OP_CAT2(COSMERON_DISABLE_FT_, CLASS))),                       \
      PP_BOOL_OR(                                                              \
          COSMERON_INTERNAL_FT_FLAG_IS_SET(                                    \
              PP_OP_CAT2(CLASS, _DISABLE_FUNCTION_TABLE)),                     \
          COSMERON_INTERNAL_HAS_NO_FT_TAG(ITEMS)))

