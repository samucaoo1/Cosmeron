#pragma once

#include "Tuple.impl"

/* ============================================================
 * FunctionTable Generator Engine
 * Generates FunctionTable struct, designated initializer,
 * and singleton table accessor GetFunctionTable().
 * ============================================================ */

/* ------------------------------------------------------------
 * 1. Object FunctionTable Generators
 * ------------------------------------------------------------ */

#define COSMERON_MACRO_INTERNAL_OBJ_FT_FIELD_C_0(CLASS, R, N, P)               \
  R (*N) COSMERON_MACRO_INTERNAL_OBJ_EMIT_PARAMS(CLASS, 0, P);
#define COSMERON_MACRO_INTERNAL_OBJ_FT_FIELD_C_1(CLASS, R, N, P)               \
  R (*N) COSMERON_MACRO_INTERNAL_OBJ_EMIT_PARAMS(CLASS, 1, P);
#define COSMERON_MACRO_INTERNAL_OBJ_FT_FIELD_C_2(CLASS, R, N, P)

#define COSMERON_MACRO_INTERNAL_OBJ_FT_FIELD_I(CLASS, C, I, R, N, P, B)        \
  PP_OP_CAT2(COSMERON_MACRO_INTERNAL_OBJ_FT_FIELD_C_, C)(CLASS, R, N, P)

#define COSMERON_MACRO_INTERNAL_OBJ_FT_FIELD(CLASS, M) \
  COSMERON_MACRO_INTERNAL_UNWRAP_MEMBER(COSMERON_MACRO_INTERNAL_OBJ_FT_FIELD_I, CLASS, M)

#define COSMERON_MACRO_INTERNAL_OBJ_FT_ENTRY_C_0(CLASS, N) .N = GNS2(CLASS, N),
#define COSMERON_MACRO_INTERNAL_OBJ_FT_ENTRY_C_1(CLASS, N) .N = GNS2(CLASS, N),
#define COSMERON_MACRO_INTERNAL_OBJ_FT_ENTRY_C_2(CLASS, N)

#define COSMERON_MACRO_INTERNAL_OBJ_FT_ENTRY_I(CLASS, C, I, R, N, P, B)        \
  PP_OP_CAT2(COSMERON_MACRO_INTERNAL_OBJ_FT_ENTRY_C_, C)(CLASS, N)

#define COSMERON_MACRO_INTERNAL_OBJ_FT_ENTRY(CLASS, M) \
  COSMERON_MACRO_INTERNAL_UNWRAP_MEMBER(COSMERON_MACRO_INTERNAL_OBJ_FT_ENTRY_I, CLASS, M)

/* ------------------------------------------------------------
 * 2. Package FunctionTable Generators
 * ------------------------------------------------------------ */

#define COSMERON_MACRO_INTERNAL_PKG_FT_FIELD_C_0(PKG, R, N, P)                 \
  R (*N) COSMERON_MACRO_INTERNAL_PKG_EMIT_PARAMS(P);
#define COSMERON_MACRO_INTERNAL_PKG_FT_FIELD_C_1(PKG, R, N, P)                 \
  R (*N) COSMERON_MACRO_INTERNAL_PKG_EMIT_PARAMS(P);
#define COSMERON_MACRO_INTERNAL_PKG_FT_FIELD_C_2(PKG, R, N, P)

#define COSMERON_MACRO_INTERNAL_PKG_FT_FIELD_I(PKG, C, I, R, N, P, B)          \
  PP_OP_CAT2(COSMERON_MACRO_INTERNAL_PKG_FT_FIELD_C_, C)(PKG, R, N, P)

#define COSMERON_MACRO_INTERNAL_PKG_FT_FIELD(PKG, M) \
  COSMERON_MACRO_INTERNAL_UNWRAP_MEMBER(COSMERON_MACRO_INTERNAL_PKG_FT_FIELD_I, PKG, M)

#define COSMERON_MACRO_INTERNAL_PKG_FT_ENTRY_C_0(PKG, N) .N = GNS2(PKG, N),
#define COSMERON_MACRO_INTERNAL_PKG_FT_ENTRY_C_1(PKG, N) .N = GNS2(PKG, N),
#define COSMERON_MACRO_INTERNAL_PKG_FT_ENTRY_C_2(PKG, N)

#define COSMERON_MACRO_INTERNAL_PKG_FT_ENTRY_I(PKG, C, I, R, N, P, B)          \
