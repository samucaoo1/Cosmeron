      COSMERON_INTERNAL_PKG_FT_FIELD_VAR_ITEM_I, CTX, V)

#define COSMERON_INTERNAL_PKG_FT_FIELD_VAR_ITEM_I(CTX, C, I, R, N, P, B)       \
  R (*COSMERON_VAR_RESOLVE_NAME(PP_SEQ_GET_2 CTX, N))                          \
