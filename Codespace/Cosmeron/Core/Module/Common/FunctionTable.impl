#define COSMERON_INTERNAL_PKG_FT_FIELD_VAR(PKG, FAMILY, VARIANTS)              \
  PP_FOREACH_D3_CTX(COSMERON_INTERNAL_PKG_FT_FIELD_VAR_ITEM,                   \
                    (PKG, FAMILY), PP_UNWRAP VARIANTS)

#define COSMERON_MACRO_INTERNAL_PKG_FT_FIELD_TAG_0(PKG, M)                     \
  COSMERON_MACRO_INTERNAL_UNWRAP_MEMBER(                                       \
      COSMERON_MACRO_INTERNAL_PKG_FT_FIELD_I, PKG, M)
#define COSMERON_MACRO_INTERNAL_PKG_FT_FIELD_TAG_1(PKG, M)                     \
  COSMERON_MACRO_INTERNAL_UNWRAP_MEMBER(                                       \
      COSMERON_MACRO_INTERNAL_PKG_FT_FIELD_I, PKG, M)
#define COSMERON_MACRO_INTERNAL_PKG_FT_FIELD_TAG_2(PKG, M)
#define COSMERON_MACRO_INTERNAL_PKG_FT_FIELD_TAG_103(PKG, M)
#define COSMERON_MACRO_INTERNAL_PKG_FT_FIELD_TAG_3(PKG, M)                     \
  COSMERON_MACRO_INTERNAL_UNWRAP_MEMBER(                                       \
