#define COSMERON_MACRO_INTERNAL_PKG_FT_FIELD_TAG_4(PKG, M)                     \
  COSMERON_MACRO_INTERNAL_UNWRAP_MEMBER(                                       \
      COSMERON_MACRO_INTERNAL_PKG_FT_FIELD_I, PKG, M)
#define COSMERON_MACRO_INTERNAL_PKG_FT_FIELD_TAG_107(PKG, M)
#define COSMERON_MACRO_INTERNAL_PKG_FT_FIELD_TAG_108(PKG, M)                   \
  COSMERON_INTERNAL_PKG_FT_FIELD_VAR(PKG, PP_SEQ_GET_2 M, PP_SEQ_GET_3 M)
#define COSMERON_MACRO_INTERNAL_PKG_FT_FIELD_TAG_109(PKG, M)
#define COSMERON_MACRO_INTERNAL_PKG_FT_FIELD_TAG_110(PKG, M)
#define COSMERON_MACRO_INTERNAL_PKG_FT_FIELD_TAG_111(PKG, M)
#define COSMERON_MACRO_INTERNAL_PKG_FT_FIELD_TAG_112(PKG, M)
#define COSMERON_MACRO_INTERNAL_PKG_FT_FIELD_TAG_113(PKG, M)
#define COSMERON_MACRO_INTERNAL_PKG_FT_FIELD_TAG_114(PKG, M)
#define COSMERON_MACRO_INTERNAL_PKG_FT_FIELD_TAG_115(PKG, M)
#define COSMERON_MACRO_INTERNAL_PKG_FT_FIELD_TAG_116(PKG, M)

#define COSMERON_MACRO_INTERNAL_PKG_FT_FIELD(PKG, M)                           \
  PP_OP_CAT2(COSMERON_MACRO_INTERNAL_PKG_FT_FIELD_TAG_, PP_SEQ_GET_1 M)(PKG, M)

#define COSMERON_MACRO_INTERNAL_PKG_FT_ENTRY_C_0(PKG, N) .N = NS(PKG, N),
#define COSMERON_MACRO_INTERNAL_PKG_FT_ENTRY_C_1(PKG, N) .N = NS(PKG, N),
#define COSMERON_MACRO_INTERNAL_PKG_FT_ENTRY_C_2(PKG, N)
#define COSMERON_MACRO_INTERNAL_PKG_FT_ENTRY_C_3(PKG, N)                       \
  .NS(N, Subscribe) = NS(PKG, N, Subscribe),                                   \
  .NS(N, Unsubscribe) = NS(PKG, N, Unsubscribe),                               \
  .NS(N, Emit) = NS(PKG, N, Emit),                                             \
  .NS(N, Clear) = NS(PKG, N, Clear),                                           \
  .NS(N, Count) = NS(PKG, N, Count),                                           \
  .NS(N, Capacity) = NS(PKG, N, Capacity),
#define COSMERON_MACRO_INTERNAL_PKG_FT_ENTRY_C_4(PKG, N)                       \
  COSMERON_MACRO_INTERNAL_PKG_FT_ENTRY_C_3(PKG, N)

#define COSMERON_MACRO_INTERNAL_PKG_FT_ENTRY_I(PKG, C, I, R, N, P, B)          \
  PP_OP_CAT2(COSMERON_MACRO_INTERNAL_PKG_FT_ENTRY_C_, C)(PKG, N)

/* Package Variant FT Entry Generator */
#define COSMERON_INTERNAL_PKG_FT_ENTRY_VAR_ITEM(CTX, V)                        \
  COSMERON_MACRO_INTERNAL_UNWRAP_MEMBER(                                       \
      COSMERON_INTERNAL_PKG_FT_ENTRY_VAR_ITEM_I, CTX, V)

#define COSMERON_INTERNAL_PKG_FT_ENTRY_VAR_ITEM_I(CTX, C, I, R, N, P, B)       \
  .COSMERON_VAR_RESOLVE_NAME(PP_SEQ_GET_2 CTX, N) =                            \
      NS(PP_SEQ_GET_1 CTX, COSMERON_VAR_RESOLVE_NAME(PP_SEQ_GET_2 CTX, N)),

#define COSMERON_INTERNAL_PKG_FT_ENTRY_VAR(PKG, FAMILY, VARIANTS)              \
  PP_FOREACH_D3_CTX(COSMERON_INTERNAL_PKG_FT_ENTRY_VAR_ITEM,                   \
