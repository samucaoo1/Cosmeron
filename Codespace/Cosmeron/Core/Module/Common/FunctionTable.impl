#pragma once

#include "Tuple.impl"

/* ============================================================
 * FunctionTable Generator Engine
 * Generates FunctionTable struct, designated initializer,
 * and singleton table accessor GetFunctionTable().
 * Supports normal methods, events, and VARIANT member families.
 * ============================================================ */

/* ------------------------------------------------------------
 * 1. Object FunctionTable Generators
 * ------------------------------------------------------------ */

#define COSMERON_MACRO_INTERNAL_OBJ_FT_FIELD_C_0(CLASS, R, N, P)               \
  R (*N) COSMERON_MACRO_INTERNAL_OBJ_EMIT_PARAMS(CLASS, 0, P);
#define COSMERON_MACRO_INTERNAL_OBJ_FT_FIELD_C_1(CLASS, R, N, P)               \
  R (*N) COSMERON_MACRO_INTERNAL_OBJ_EMIT_PARAMS(CLASS, 1, P);
#define COSMERON_MACRO_INTERNAL_OBJ_FT_FIELD_C_2(CLASS, R, N, P)
#define COSMERON_MACRO_INTERNAL_OBJ_FT_FIELD_C_3(CLASS, R, N, P)               \
  OPSTATUS (*NS(N, Subscribe))(CLASS * self, TCLOSURE(NS(CLASS, N)) listener); \
  OPSTATUS (*NS(N, Unsubscribe))(CLASS * self, TCLOSURE(NS(CLASS, N)) listener);\
  void (*NS(N, Emit)) COSMERON_MACRO_INTERNAL_OBJ_EMIT_PARAMS(CLASS, 0, P);    \
  OPSTATUS (*NS(N, Clear))(CLASS * self);                                      \
  uint8_t (*NS(N, Count))(const CLASS * self);                                 \
  uint8_t (*NS(N, Capacity))(const CLASS * self);
#define COSMERON_MACRO_INTERNAL_OBJ_FT_FIELD_C_4(CLASS, R, N, P)               \
  OPSTATUS (*NS(N, Subscribe))(CLASS * self, TCLOSURE(NS(CLASS, N)) listener); \
  OPSTATUS (*NS(N, Unsubscribe))(CLASS * self, TCLOSURE(NS(CLASS, N)) listener);\
  OPSTATUS (*NS(N, Emit)) COSMERON_MACRO_INTERNAL_OBJ_EMIT_PARAMS(CLASS, 0, P);\
  OPSTATUS (*NS(N, Clear))(CLASS * self);                                      \
  uint8_t (*NS(N, Count))(const CLASS * self);                                 \
  uint8_t (*NS(N, Capacity))(const CLASS * self);

#define COSMERON_MACRO_INTERNAL_OBJ_FT_FIELD_I(CLASS, C, I, R, N, P, B)        \
  PP_OP_CAT2(COSMERON_MACRO_INTERNAL_OBJ_FT_FIELD_C_, C)(CLASS, R, N, P)

/* Object Variant FT Field Generator */
#define COSMERON_INTERNAL_OBJ_FT_FIELD_VAR_ITEM(CTX, V)                        \
  COSMERON_MACRO_INTERNAL_UNWRAP_MEMBER(                                       \
      COSMERON_INTERNAL_OBJ_FT_FIELD_VAR_ITEM_I, CTX, V)

#define COSMERON_INTERNAL_OBJ_FT_FIELD_VAR_ITEM_I(CTX, C, I, R, N, P, B)       \
  R (*COSMERON_VAR_RESOLVE_NAME(PP_SEQ_GET_2 CTX, N))                          \
      COSMERON_MACRO_INTERNAL_OBJ_EMIT_PARAMS(PP_SEQ_GET_1 CTX, C, P);

#define COSMERON_INTERNAL_OBJ_FT_FIELD_VAR(CLASS, FAMILY, VARIANTS)            \
  PP_FOREACH_D3_CTX(COSMERON_INTERNAL_OBJ_FT_FIELD_VAR_ITEM,                   \
                    (CLASS, FAMILY), PP_UNWRAP VARIANTS)

#define COSMERON_MACRO_INTERNAL_OBJ_FT_FIELD_TAG_0(CLASS, M)                   \
  COSMERON_MACRO_INTERNAL_UNWRAP_MEMBER(                                       \
      COSMERON_MACRO_INTERNAL_OBJ_FT_FIELD_I, CLASS, M)
#define COSMERON_MACRO_INTERNAL_OBJ_FT_FIELD_TAG_1(CLASS, M)                   \
  COSMERON_MACRO_INTERNAL_UNWRAP_MEMBER(                                       \
      COSMERON_MACRO_INTERNAL_OBJ_FT_FIELD_I, CLASS, M)
#define COSMERON_MACRO_INTERNAL_OBJ_FT_FIELD_TAG_2(CLASS, M)
#define COSMERON_MACRO_INTERNAL_OBJ_FT_FIELD_TAG_103(CLASS, M)
#define COSMERON_MACRO_INTERNAL_OBJ_FT_FIELD_TAG_3(CLASS, M)                   \
  COSMERON_MACRO_INTERNAL_UNWRAP_MEMBER(                                       \
      COSMERON_MACRO_INTERNAL_OBJ_FT_FIELD_I, CLASS, M)
#define COSMERON_MACRO_INTERNAL_OBJ_FT_FIELD_TAG_4(CLASS, M)                   \
  COSMERON_MACRO_INTERNAL_UNWRAP_MEMBER(                                       \
      COSMERON_MACRO_INTERNAL_OBJ_FT_FIELD_I, CLASS, M)
#define COSMERON_MACRO_INTERNAL_OBJ_FT_FIELD_TAG_107(CLASS, M)
#define COSMERON_MACRO_INTERNAL_OBJ_FT_FIELD_TAG_108(CLASS, M)                 \
  COSMERON_INTERNAL_OBJ_FT_FIELD_VAR(CLASS, PP_SEQ_GET_2 M, PP_SEQ_GET_3 M)
#define COSMERON_MACRO_INTERNAL_OBJ_FT_FIELD_TAG_109(CLASS, M)
#define COSMERON_MACRO_INTERNAL_OBJ_FT_FIELD_TAG_110(CLASS, M)
#define COSMERON_MACRO_INTERNAL_OBJ_FT_FIELD_TAG_111(CLASS, M)
#define COSMERON_MACRO_INTERNAL_OBJ_FT_FIELD_TAG_112(CLASS, M)
#define COSMERON_MACRO_INTERNAL_OBJ_FT_FIELD_TAG_113(CLASS, M)
#define COSMERON_MACRO_INTERNAL_OBJ_FT_FIELD_TAG_114(CLASS, M)
#define COSMERON_MACRO_INTERNAL_OBJ_FT_FIELD_TAG_115(CLASS, M)
#define COSMERON_MACRO_INTERNAL_OBJ_FT_FIELD_TAG_116(CLASS, M)

#define COSMERON_MACRO_INTERNAL_OBJ_FT_FIELD(CLASS, M)                         \
  PP_OP_CAT2(COSMERON_MACRO_INTERNAL_OBJ_FT_FIELD_TAG_, PP_SEQ_GET_1 M)(CLASS, M)

#define COSMERON_MACRO_INTERNAL_OBJ_FT_ENTRY_C_0(CLASS, N) .N = NS(CLASS, N),
#define COSMERON_MACRO_INTERNAL_OBJ_FT_ENTRY_C_1(CLASS, N) .N = NS(CLASS, N),
#define COSMERON_MACRO_INTERNAL_OBJ_FT_ENTRY_C_2(CLASS, N)
#define COSMERON_MACRO_INTERNAL_OBJ_FT_ENTRY_C_3(CLASS, N)                     \
  .NS(N, Subscribe) = NS(CLASS, N, Subscribe),                                 \
  .NS(N, Unsubscribe) = NS(CLASS, N, Unsubscribe),                             \
  .NS(N, Emit) = NS(CLASS, N, Emit),                                           \
  .NS(N, Clear) = NS(CLASS, N, Clear),                                         \
  .NS(N, Count) = NS(CLASS, N, Count),                                         \
  .NS(N, Capacity) = NS(CLASS, N, Capacity),
#define COSMERON_MACRO_INTERNAL_OBJ_FT_ENTRY_C_4(CLASS, N)                     \
  COSMERON_MACRO_INTERNAL_OBJ_FT_ENTRY_C_3(CLASS, N)

#define COSMERON_MACRO_INTERNAL_OBJ_FT_ENTRY_I(CLASS, C, I, R, N, P, B)        \
  PP_OP_CAT2(COSMERON_MACRO_INTERNAL_OBJ_FT_ENTRY_C_, C)(CLASS, N)

/* Object Variant FT Entry Generator */
#define COSMERON_INTERNAL_OBJ_FT_ENTRY_VAR_ITEM(CTX, V)                        \
  COSMERON_MACRO_INTERNAL_UNWRAP_MEMBER(                                       \
      COSMERON_INTERNAL_OBJ_FT_ENTRY_VAR_ITEM_I, CTX, V)

#define COSMERON_INTERNAL_OBJ_FT_ENTRY_VAR_ITEM_I(CTX, C, I, R, N, P, B)       \
  .COSMERON_VAR_RESOLVE_NAME(PP_SEQ_GET_2 CTX, N) =                            \
      NS(PP_SEQ_GET_1 CTX, COSMERON_VAR_RESOLVE_NAME(PP_SEQ_GET_2 CTX, N)),

#define COSMERON_INTERNAL_OBJ_FT_ENTRY_VAR(CLASS, FAMILY, VARIANTS)            \
  PP_FOREACH_D3_CTX(COSMERON_INTERNAL_OBJ_FT_ENTRY_VAR_ITEM,                   \
                    (CLASS, FAMILY), PP_UNWRAP VARIANTS)

#define COSMERON_MACRO_INTERNAL_OBJ_FT_ENTRY_TAG_0(CLASS, M)                   \
  COSMERON_MACRO_INTERNAL_UNWRAP_MEMBER(                                       \
      COSMERON_MACRO_INTERNAL_OBJ_FT_ENTRY_I, CLASS, M)
#define COSMERON_MACRO_INTERNAL_OBJ_FT_ENTRY_TAG_1(CLASS, M)                   \
  COSMERON_MACRO_INTERNAL_UNWRAP_MEMBER(                                       \
      COSMERON_MACRO_INTERNAL_OBJ_FT_ENTRY_I, CLASS, M)
#define COSMERON_MACRO_INTERNAL_OBJ_FT_ENTRY_TAG_2(CLASS, M)
#define COSMERON_MACRO_INTERNAL_OBJ_FT_ENTRY_TAG_103(CLASS, M)
#define COSMERON_MACRO_INTERNAL_OBJ_FT_ENTRY_TAG_3(CLASS, M)                   \
  COSMERON_MACRO_INTERNAL_UNWRAP_MEMBER(                                       \
      COSMERON_MACRO_INTERNAL_OBJ_FT_ENTRY_I, CLASS, M)
#define COSMERON_MACRO_INTERNAL_OBJ_FT_ENTRY_TAG_4(CLASS, M)                   \
  COSMERON_MACRO_INTERNAL_UNWRAP_MEMBER(                                       \
      COSMERON_MACRO_INTERNAL_OBJ_FT_ENTRY_I, CLASS, M)
#define COSMERON_MACRO_INTERNAL_OBJ_FT_ENTRY_TAG_107(CLASS, M)
#define COSMERON_MACRO_INTERNAL_OBJ_FT_ENTRY_TAG_108(CLASS, M)                 \
  COSMERON_INTERNAL_OBJ_FT_ENTRY_VAR(CLASS, PP_SEQ_GET_2 M, PP_SEQ_GET_3 M)
#define COSMERON_MACRO_INTERNAL_OBJ_FT_ENTRY_TAG_109(CLASS, M)
#define COSMERON_MACRO_INTERNAL_OBJ_FT_ENTRY_TAG_110(CLASS, M)
#define COSMERON_MACRO_INTERNAL_OBJ_FT_ENTRY_TAG_111(CLASS, M)
#define COSMERON_MACRO_INTERNAL_OBJ_FT_ENTRY_TAG_112(CLASS, M)
#define COSMERON_MACRO_INTERNAL_OBJ_FT_ENTRY_TAG_113(CLASS, M)
#define COSMERON_MACRO_INTERNAL_OBJ_FT_ENTRY_TAG_114(CLASS, M)
#define COSMERON_MACRO_INTERNAL_OBJ_FT_ENTRY_TAG_115(CLASS, M)
#define COSMERON_MACRO_INTERNAL_OBJ_FT_ENTRY_TAG_116(CLASS, M)

#define COSMERON_MACRO_INTERNAL_OBJ_FT_ENTRY(CLASS, M)                         \
  PP_OP_CAT2(COSMERON_MACRO_INTERNAL_OBJ_FT_ENTRY_TAG_, PP_SEQ_GET_1 M)(CLASS, M)

/* ------------------------------------------------------------
 * 2. Package FunctionTable Generators
 * ------------------------------------------------------------ */

#define COSMERON_MACRO_INTERNAL_PKG_FT_FIELD_C_0(PKG, R, N, P)                 \
  R (*N) COSMERON_MACRO_INTERNAL_PKG_EMIT_PARAMS(P);
#define COSMERON_MACRO_INTERNAL_PKG_FT_FIELD_C_1(PKG, R, N, P)                 \
  R (*N) COSMERON_MACRO_INTERNAL_PKG_EMIT_PARAMS(P);
#define COSMERON_MACRO_INTERNAL_PKG_FT_FIELD_C_2(PKG, R, N, P)
#define COSMERON_MACRO_INTERNAL_PKG_FT_FIELD_C_3(PKG, R, N, P)                 \
  OPSTATUS (*NS(N, Subscribe))(TCLOSURE(NS(PKG, N)) listener);                 \
  OPSTATUS (*NS(N, Unsubscribe))(TCLOSURE(NS(PKG, N)) listener);               \
  void (*NS(N, Emit)) COSMERON_MACRO_INTERNAL_PKG_EMIT_PARAMS(P);              \
  OPSTATUS (*NS(N, Clear))(void);                                              \
  uint8_t (*NS(N, Count))(void);                                               \
  uint8_t (*NS(N, Capacity))(void);
#define COSMERON_MACRO_INTERNAL_PKG_FT_FIELD_C_4(PKG, R, N, P)                 \
  OPSTATUS (*NS(N, Subscribe))(TCLOSURE(NS(PKG, N)) listener);                 \
  OPSTATUS (*NS(N, Unsubscribe))(TCLOSURE(NS(PKG, N)) listener);               \
  OPSTATUS (*NS(N, Emit)) COSMERON_MACRO_INTERNAL_PKG_EMIT_PARAMS(P);          \
  OPSTATUS (*NS(N, Clear))(void);                                              \
  uint8_t (*NS(N, Count))(void);                                               \
  uint8_t (*NS(N, Capacity))(void);

#define COSMERON_MACRO_INTERNAL_PKG_FT_FIELD_I(PKG, C, I, R, N, P, B)          \
  PP_OP_CAT2(COSMERON_MACRO_INTERNAL_PKG_FT_FIELD_C_, C)(PKG, R, N, P)

