  X((NOT_FOUND, GENERIC, "Not found"))                                         \
  X((ALREADY_EXISTS, GENERIC, "Already exists"))                               \
  X((NOT_SUPPORTED, GENERIC, "Not supported"))                                 \
  X((NOT_AVAILABLE, GENERIC, "Not available"))
