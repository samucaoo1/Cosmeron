/* ========================================================================== */
/* 1. Internal Helpers & Trait Adapters                                       */
/* ========================================================================== */

MODULE(DOMAIN(Core), Primitive,
  INTERNAL_EX(TaggedUnion,
    COMPARISON(Compare_ByteSlice, (const void *left, const void *right), {
      const MODULE_TYPE(Primitive, ByteSlice) *a =
          (const MODULE_TYPE(Primitive, ByteSlice) *)left;
      const MODULE_TYPE(Primitive, ByteSlice) *b =
          (const MODULE_TYPE(Primitive, ByteSlice) *)right;
      return MODULE_FUNC(Algorithm, Comparison, Bytes)(
          a->data, a->size, b->data, b->size);
    }),

    FUNCTION(size_t, Hash_ByteSlice, (const void *instance), {
      if (!instance)
        return 0U;
      const MODULE_TYPE(Primitive, ByteSlice) *slice =
          (const MODULE_TYPE(Primitive, ByteSlice) *)instance;
      return MODULE_FUNC(Primitive, Traits, HashBytes)(slice->data,
                                                       slice->size);
    }),

    COMPARISON(Compare_RawPointer, (const void *left, const void *right), {
      const void *const *a = (const void *const *)left;
      const void *const *b = (const void *const *)right;
      uintptr_t ua = (uintptr_t)(*a);
      uintptr_t ub = (uintptr_t)(*b);
      if (ua < ub)
        return COMPARISON_CONST(LOWER);
      if (ua > ub)
        return COMPARISON_CONST(HIGHER);
      return COMPARISON_CONST(EQUAL);
    }),

    FUNCTION(size_t, Hash_RawPointer, (const void *instance), {
      if (!instance)
        return 0U;
      return MODULE_FUNC(Primitive, Traits, HashBytes)(instance,
                                                       sizeof(void *));
    }),

    COMPARISON(Compare_Self, (const void *left, const void *right), {
      return MODULE_FUNC(Primitive, TaggedUnion, Compare)(
          (const MODULE_TYPE(Primitive, TaggedUnion) *)left,
          (const MODULE_TYPE(Primitive, TaggedUnion) *)right);
    }),

    FUNCTION(size_t, Hash_Self, (const void *instance), {
      return MODULE_FUNC(Primitive, TaggedUnion, Hash)(
          (const MODULE_TYPE(Primitive, TaggedUnion) *)instance);
    }),

    FUNCTION(const MODULE_TYPE(Primitive, Traits) *, ByteSliceTraits, (void), {
      static const MODULE_TYPE(Primitive, Traits) descriptor = {
          .name = "Primitive_TByteSlice",
          .size = sizeof(MODULE_TYPE(Primitive, ByteSlice)),
          .alignment = _Alignof(MODULE_TYPE(Primitive, ByteSlice)),
          .category = MODULE_CONST(Primitive, COMPOSITE),
          .flags = MODULE_CONST(Primitive, TraitFlag, TRIVIAL_COPY),
          .init = NULL,
          .dispose = NULL,
          .copy = NULL,
          .move = NULL,
          .compare = MODULE_IFUNC(Primitive, TaggedUnion, Compare_ByteSlice),
          .hash = MODULE_IFUNC(Primitive, TaggedUnion, Hash_ByteSlice)};
      return &descriptor;
    }),

    FUNCTION(const MODULE_TYPE(Primitive, Traits) *, RawPointerTraits, (void), {
      static const MODULE_TYPE(Primitive, Traits) descriptor = {
          .name = "void*",
          .size = sizeof(void *),
          .alignment = _Alignof(void *),
          .category = MODULE_CONST(Primitive, PTR),
          .flags = MODULE_CONST(Primitive, TraitFlag, TRIVIAL_COPY) |
                   MODULE_CONST(Primitive, TraitFlag, TRIVIAL_COMPARE),
          .init = NULL,
          .dispose = NULL,
          .copy = NULL,
          .move = NULL,
          .compare = MODULE_IFUNC(Primitive, TaggedUnion, Compare_RawPointer),
          .hash = MODULE_IFUNC(Primitive, TaggedUnion, Hash_RawPointer)};
      return &descriptor;
    })
  )
);

