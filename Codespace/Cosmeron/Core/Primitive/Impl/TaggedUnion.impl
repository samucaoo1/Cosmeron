          return STATUS_CONST(SUCCESS);
        case MODULE_CONST(Primitive, Tag, Char32):
          *outValue = (double)self->value.as.Char32;
          return STATUS_CONST(SUCCESS);
        case MODULE_CONST(Primitive, Tag, Float32):
          *outValue = (double)self->value.as.Float32;
          return STATUS_CONST(SUCCESS);
        case MODULE_CONST(Primitive, Tag, Float):
          *outValue = (double)self->value.as.Float;
          return STATUS_CONST(SUCCESS);
        case MODULE_CONST(Primitive, Tag, Float64):
          *outValue = self->value.as.Float64;
          return STATUS_CONST(SUCCESS);
        case MODULE_CONST(Primitive, Tag, Double):
          *outValue = self->value.as.Double;
          return STATUS_CONST(SUCCESS);
        case MODULE_CONST(Primitive, Tag, LongDouble):
          *outValue = (double)self->value.as.LongDouble;
          return STATUS_CONST(SUCCESS);
        default:
          return STATUS_CONST(NOT_SUPPORTED);
      }
    }),

    PREDICATE(IsEmpty, (const MODULE_TYPE(Primitive, TaggedUnion) * self), {
      return !self || self->tag == MODULE_CONST(Primitive, Tag, NONE);
    }),

    PREDICATE(IsTag, (const MODULE_TYPE(Primitive, TaggedUnion) * self,
                      MODULE_ENUM(Primitive, Tag) tag), {
      if (!self)
        return tag == MODULE_CONST(Primitive, Tag, NONE);
      return self->tag == tag;
    }),

    PREDICATE(IsNumeric, (const MODULE_TYPE(Primitive, TaggedUnion) * self), {
      const MODULE_TYPE(Primitive, Traits) *traits =
          MODULE_FUNC(Primitive, TaggedUnion, TraitsOf)(self);
      return MODULE_FUNC(Primitive, Traits, IsNumeric)(traits);
    }),

    PREDICATE(IsInteger, (const MODULE_TYPE(Primitive, TaggedUnion) * self), {
      const MODULE_TYPE(Primitive, Traits) *traits =
          MODULE_FUNC(Primitive, TaggedUnion, TraitsOf)(self);
      return MODULE_FUNC(Primitive, Traits, IsInteger)(traits);
    }),

    PREDICATE(IsSigned, (const MODULE_TYPE(Primitive, TaggedUnion) * self), {
      const MODULE_TYPE(Primitive, Traits) *traits =
          MODULE_FUNC(Primitive, TaggedUnion, TraitsOf)(self);
      return MODULE_FUNC(Primitive, Traits, IsSigned)(traits);
    }),

    PREDICATE(IsFloat, (const MODULE_TYPE(Primitive, TaggedUnion) * self), {
      const MODULE_TYPE(Primitive, Traits) *traits =
          MODULE_FUNC(Primitive, TaggedUnion, TraitsOf)(self);
      return MODULE_FUNC(Primitive, Traits, IsFloat)(traits);
    }),

    FUNCTION(const char *, TagName, (MODULE_ENUM(Primitive, Tag) tag), {
      switch (tag) {
        PRIMITIVE_TAG_TABLE(COSMERON_MACRO_INTERNAL_TU_TAG_NAME_CASE)
        default:
          return "Unknown";
      }
    }),

    FUNCTION(MODULE_ENUM(Primitive, Category), CategoryOf,
             (const MODULE_TYPE(Primitive, TaggedUnion) * self), {
      if (!self)
        return MODULE_CONST(Primitive, OBJECT);
      switch (self->tag) {
        PRIMITIVE_TAG_TABLE(COSMERON_MACRO_INTERNAL_TU_CATEGORY_CASE)
        default:
          return MODULE_CONST(Primitive, OBJECT);
      }
    }),

    FUNCTION(const MODULE_TYPE(Primitive, Traits) *, TraitsOf,
             (const MODULE_TYPE(Primitive, TaggedUnion) * self), {
      if (!self)
        return NULL;
      switch (self->tag) {
        case MODULE_CONST(Primitive, Tag, NONE):
          return NULL;
        case MODULE_CONST(Primitive, Tag, CSTRING):
          return MODULE_FUNC(Primitive, Traits, CString)();
        case MODULE_CONST(Primitive, Tag, BYTES):
          return MODULE_IFUNC(Primitive, TaggedUnion, ByteSliceTraits)();
        case MODULE_CONST(Primitive, Tag, RAW_POINTER):
          return MODULE_IFUNC(Primitive, TaggedUnion, RawPointerTraits)();
        PRIMITIVE_TYPE_TABLE(COSMERON_MACRO_INTERNAL_TU_TRAITS_CASE)
        default:
          return NULL;
      }
    }),

    FUNCTION(const void *, PayloadPointer,
             (const MODULE_TYPE(Primitive, TaggedUnion) * self), {
      if (!self)
        return NULL;
      switch (self->tag) {
        case MODULE_CONST(Primitive, Tag, NONE):
          return NULL;
        case MODULE_CONST(Primitive, Tag, CSTRING):
          return &self->value.as.cString;
        case MODULE_CONST(Primitive, Tag, BYTES):
          return &self->value.as.bytes;
        case MODULE_CONST(Primitive, Tag, RAW_POINTER):
          return &self->value.as.rawPointer;
        PRIMITIVE_TYPE_TABLE(COSMERON_MACRO_INTERNAL_TU_PAYLOAD_PTR_CASE)
        default:
          return NULL;
      }
    }),

    COMPARISON(Compare, (const MODULE_TYPE(Primitive, TaggedUnion) * left,
                         const MODULE_TYPE(Primitive, TaggedUnion) * right), {
      if (left == right)
        return COMPARISON_CONST(EQUAL);
      if (!left)
        return COMPARISON_CONST(LOWER);
      if (!right)
        return COMPARISON_CONST(HIGHER);
      if (left->tag != right->tag) {
        return left->tag < right->tag ? COMPARISON_CONST(LOWER)
                                      : COMPARISON_CONST(HIGHER);
      }
      switch (left->tag) {
        case MODULE_CONST(Primitive, Tag, NONE):
          return COMPARISON_CONST(EQUAL);
        case MODULE_CONST(Primitive, Tag, CSTRING):
          return MODULE_FUNC(Algorithm, Comparison, CString)(
              left->value.as.cString, right->value.as.cString);
        case MODULE_CONST(Primitive, Tag, BYTES):
          return MODULE_FUNC(Algorithm, Comparison, Bytes)(
              left->value.as.bytes.data, left->value.as.bytes.size,
              right->value.as.bytes.data, right->value.as.bytes.size);
        case MODULE_CONST(Primitive, Tag, RAW_POINTER):
          return MODULE_IFUNC(Primitive, TaggedUnion, Compare_RawPointer)(
              &left->value.as.rawPointer, &right->value.as.rawPointer);
        PRIMITIVE_TYPE_TABLE(COSMERON_MACRO_INTERNAL_TU_COMPARE_CASE)
        default:
          return COMPARISON_CONST(EQUAL);
      }
    }),

    PREDICATE(Equals, (const MODULE_TYPE(Primitive, TaggedUnion) * left,
                       const MODULE_TYPE(Primitive, TaggedUnion) * right), {
      return MODULE_FUNC(Primitive, TaggedUnion, Compare)(left, right) ==
             COMPARISON_CONST(EQUAL);
    }),

    FUNCTION(size_t, Hash, (const MODULE_TYPE(Primitive, TaggedUnion) * self), {
      if (!self || self->tag == MODULE_CONST(Primitive, Tag, NONE))
        return 0U;
      size_t tagHash = MODULE_FUNC(Primitive, Traits, HashBytes)(
          &self->tag, sizeof(self->tag));
      const MODULE_TYPE(Primitive, Traits) *traits =
          MODULE_FUNC(Primitive, TaggedUnion, TraitsOf)(self);
      const void *payload =
          MODULE_FUNC(Primitive, TaggedUnion, PayloadPointer)(self);
      size_t valHash = MODULE_FUNC(Primitive, Traits, Hash)(traits, payload);
      return tagHash ^ (valHash + 0x9e3779b9U + (tagHash << 6U) + (tagHash >> 2U));
    }),

    FUNCTION(const MODULE_TYPE(Primitive, Traits) *, Traits, (void), {
      static const MODULE_TYPE(Primitive, Traits) descriptor = {
          .name = "Primitive_TTaggedUnion",
          .size = sizeof(MODULE_TYPE(Primitive, TaggedUnion)),
          .alignment = _Alignof(MODULE_TYPE(Primitive, TaggedUnion)),
          .category = MODULE_CONST(Primitive, COMPOSITE),
          .flags = MODULE_CONST(Primitive, TraitFlag, TRIVIAL_COPY),
          .init = NULL,
          .dispose = NULL,
          .copy = NULL,
          .move = NULL,
          .compare = MODULE_IFUNC(Primitive, TaggedUnion, Compare_Self),
          .hash = MODULE_IFUNC(Primitive, TaggedUnion, Hash_Self)};
      return &descriptor;
    })
  )
);

#undef COSMERON_MACRO_INTERNAL_TU_PRIMITIVE_IMPL
#undef COSMERON_MACRO_INTERNAL_TU_TAG_NAME_CASE
#undef COSMERON_MACRO_INTERNAL_TU_CATEGORY_CASE
#undef COSMERON_MACRO_INTERNAL_TU_TRAITS_CASE
#undef COSMERON_MACRO_INTERNAL_TU_PAYLOAD_PTR_CASE
#undef COSMERON_MACRO_INTERNAL_TU_COMPARE_CASE

/* EOF */

