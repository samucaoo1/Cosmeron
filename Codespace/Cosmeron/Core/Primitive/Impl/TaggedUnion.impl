MODULE_IMPLEMENT(DOMAIN(Core), Primitive,
  PACKAGE(TaggedUnion,
    PROCEDURE(Init, (MODULE_TYPE(Primitive, TaggedUnion) * self), {
      if (!self)
        return;
      memset(self, 0, sizeof(*self));
      self->tag = MODULE_CONST(Primitive, Tag, NONE);
    }),

    PROCEDURE(Clear, (MODULE_TYPE(Primitive, TaggedUnion) * self), {
      MODULE_FUNC(Primitive, TaggedUnion, Init)(self);
    }),

    PRIMITIVE_TYPE_TABLE(COSMERON_MACRO_INTERNAL_TU_PRIMITIVE_IMPL)

    OPERATION(Set_CString, (MODULE_TYPE(Primitive, TaggedUnion) * self,
                            const char *value), {
      if (!self)
        return STATUS_CONST(INVALID_ARGUMENT);
      memset(self, 0, sizeof(*self));
      self->tag = MODULE_CONST(Primitive, Tag, CSTRING);
      self->value.as.cString = value;
      return STATUS_CONST(SUCCESS);
    }),

    FUNCTION(MODULE_TYPE(Primitive, TaggedUnion), From_CString,
             (const char *value), {
      MODULE_TYPE(Primitive, TaggedUnion) result;
      memset(&result, 0, sizeof(result));
      result.tag = MODULE_CONST(Primitive, Tag, CSTRING);
      result.value.as.cString = value;
      return result;
    }),

    OPERATION(Get_CString, (const MODULE_TYPE(Primitive, TaggedUnion) * self,
                            const char **outValue), {
      if (!self || !outValue)
        return STATUS_CONST(INVALID_ARGUMENT);
      if (self->tag != MODULE_CONST(Primitive, Tag, CSTRING))
        return STATUS_CONST(INVALID_ARGUMENT);
      *outValue = self->value.as.cString;
      return STATUS_CONST(SUCCESS);
    }),

    OPERATION(Set_Bytes, (MODULE_TYPE(Primitive, TaggedUnion) * self,
                          const void *data, size_t size), {
      if (!self || (size > 0U && !data))
        return STATUS_CONST(INVALID_ARGUMENT);
      memset(self, 0, sizeof(*self));
      self->tag = MODULE_CONST(Primitive, Tag, BYTES);
      self->value.as.bytes.data = data;
      self->value.as.bytes.size = size;
      return STATUS_CONST(SUCCESS);
    }),

    FUNCTION(MODULE_TYPE(Primitive, TaggedUnion), From_Bytes,
             (const void *data, size_t size), {
      MODULE_TYPE(Primitive, TaggedUnion) result;
      memset(&result, 0, sizeof(result));
      if (size > 0U && !data) {
        result.tag = MODULE_CONST(Primitive, Tag, NONE);
        return result;
      }
      result.tag = MODULE_CONST(Primitive, Tag, BYTES);
      result.value.as.bytes.data = data;
      result.value.as.bytes.size = size;
      return result;
    }),

    OPERATION(Get_Bytes, (const MODULE_TYPE(Primitive, TaggedUnion) * self,
                          MODULE_TYPE(Primitive, ByteSlice) * outValue), {
      if (!self || !outValue)
        return STATUS_CONST(INVALID_ARGUMENT);
      if (self->tag != MODULE_CONST(Primitive, Tag, BYTES))
        return STATUS_CONST(INVALID_ARGUMENT);
      *outValue = self->value.as.bytes;
      return STATUS_CONST(SUCCESS);
    }),

    OPERATION(Set_RawPointer, (MODULE_TYPE(Primitive, TaggedUnion) * self,
                               void *pointer), {
      if (!self)
        return STATUS_CONST(INVALID_ARGUMENT);
      memset(self, 0, sizeof(*self));
      self->tag = MODULE_CONST(Primitive, Tag, RAW_POINTER);
      self->value.as.rawPointer = pointer;
      return STATUS_CONST(SUCCESS);
    }),

    FUNCTION(MODULE_TYPE(Primitive, TaggedUnion), From_RawPointer,
             (void *pointer), {
      MODULE_TYPE(Primitive, TaggedUnion) result;
      memset(&result, 0, sizeof(result));
      result.tag = MODULE_CONST(Primitive, Tag, RAW_POINTER);
      result.value.as.rawPointer = pointer;
      return result;
    }),

    OPERATION(Get_RawPointer, (const MODULE_TYPE(Primitive, TaggedUnion) * self,
                               void **outValue), {
      if (!self || !outValue)
        return STATUS_CONST(INVALID_ARGUMENT);
      if (self->tag != MODULE_CONST(Primitive, Tag, RAW_POINTER))
        return STATUS_CONST(INVALID_ARGUMENT);
      *outValue = self->value.as.rawPointer;
      return STATUS_CONST(SUCCESS);
    }),

    OPERATION(CoerceInt64, (const MODULE_TYPE(Primitive, TaggedUnion) * self,
                            int64_t *outValue), {
      if (!self || !outValue)
        return STATUS_CONST(INVALID_ARGUMENT);

      switch (self->tag) {
        case MODULE_CONST(Primitive, Tag, Boolean):
          *outValue = self->value.as.Boolean ? 1 : 0;
          return STATUS_CONST(SUCCESS);
        case MODULE_CONST(Primitive, Tag, Int8):
          *outValue = (int64_t)self->value.as.Int8;
          return STATUS_CONST(SUCCESS);
        case MODULE_CONST(Primitive, Tag, Int16):
          *outValue = (int64_t)self->value.as.Int16;
          return STATUS_CONST(SUCCESS);
        case MODULE_CONST(Primitive, Tag, Int32):
          *outValue = (int64_t)self->value.as.Int32;
          return STATUS_CONST(SUCCESS);
        case MODULE_CONST(Primitive, Tag, Int64):
          *outValue = self->value.as.Int64;
          return STATUS_CONST(SUCCESS);
        case MODULE_CONST(Primitive, Tag, Int):
          *outValue = (int64_t)self->value.as.Int;
          return STATUS_CONST(SUCCESS);
        case MODULE_CONST(Primitive, Tag, PtrDiff):
          *outValue = (int64_t)self->value.as.PtrDiff;
          return STATUS_CONST(SUCCESS);
        case MODULE_CONST(Primitive, Tag, IntPtr):
          *outValue = (int64_t)self->value.as.IntPtr;
          return STATUS_CONST(SUCCESS);
        case MODULE_CONST(Primitive, Tag, UInt8):
          *outValue = (int64_t)self->value.as.UInt8;
          return STATUS_CONST(SUCCESS);
        case MODULE_CONST(Primitive, Tag, UInt16):
          *outValue = (int64_t)self->value.as.UInt16;
          return STATUS_CONST(SUCCESS);
        case MODULE_CONST(Primitive, Tag, UInt32):
          *outValue = (int64_t)self->value.as.UInt32;
          return STATUS_CONST(SUCCESS);
        case MODULE_CONST(Primitive, Tag, UInt64):
          if (self->value.as.UInt64 > (uint64_t)INT64_MAX)
            return STATUS_CONST(ARITHMETIC_OVERFLOW);
          *outValue = (int64_t)self->value.as.UInt64;
          return STATUS_CONST(SUCCESS);
        case MODULE_CONST(Primitive, Tag, UInt):
          if ((uint64_t)self->value.as.UInt > (uint64_t)INT64_MAX)
            return STATUS_CONST(ARITHMETIC_OVERFLOW);
          *outValue = (int64_t)self->value.as.UInt;
          return STATUS_CONST(SUCCESS);
        case MODULE_CONST(Primitive, Tag, Size):
          if ((uint64_t)self->value.as.Size > (uint64_t)INT64_MAX)
            return STATUS_CONST(ARITHMETIC_OVERFLOW);
          *outValue = (int64_t)self->value.as.Size;
          return STATUS_CONST(SUCCESS);
        case MODULE_CONST(Primitive, Tag, UIntPtr):
          if ((uint64_t)self->value.as.UIntPtr > (uint64_t)INT64_MAX)
            return STATUS_CONST(ARITHMETIC_OVERFLOW);
          *outValue = (int64_t)self->value.as.UIntPtr;
          return STATUS_CONST(SUCCESS);
        case MODULE_CONST(Primitive, Tag, Char):
          *outValue = (int64_t)self->value.as.Char;
          return STATUS_CONST(SUCCESS);
        case MODULE_CONST(Primitive, Tag, Char8):
          *outValue = (int64_t)self->value.as.Char8;
          return STATUS_CONST(SUCCESS);
        case MODULE_CONST(Primitive, Tag, Char16):
          *outValue = (int64_t)self->value.as.Char16;
          return STATUS_CONST(SUCCESS);
        case MODULE_CONST(Primitive, Tag, Char32):
          *outValue = (int64_t)self->value.as.Char32;
          return STATUS_CONST(SUCCESS);
        case MODULE_CONST(Primitive, Tag, Float32):
        case MODULE_CONST(Primitive, Tag, Float): {
          double v = (self->tag == MODULE_CONST(Primitive, Tag, Float32))
                         ? (double)self->value.as.Float32
                         : (double)self->value.as.Float;
          if (!isfinite(v))
            return STATUS_CONST(OUT_OF_RANGE);
          if (v < (double)INT64_MIN || v >= 9223372036854775808.0)
            return STATUS_CONST(ARITHMETIC_OVERFLOW);
          *outValue = (int64_t)v;
          return STATUS_CONST(SUCCESS);
        }
        case MODULE_CONST(Primitive, Tag, Float64):
        case MODULE_CONST(Primitive, Tag, Double): {
          double v = (self->tag == MODULE_CONST(Primitive, Tag, Float64))
                         ? self->value.as.Float64
                         : self->value.as.Double;
          if (!isfinite(v))
            return STATUS_CONST(OUT_OF_RANGE);
          if (v < (double)INT64_MIN || v >= 9223372036854775808.0)
            return STATUS_CONST(ARITHMETIC_OVERFLOW);
          *outValue = (int64_t)v;
          return STATUS_CONST(SUCCESS);
        }
        case MODULE_CONST(Primitive, Tag, LongDouble): {
          long double v = self->value.as.LongDouble;
          if (!isfinite(v))
            return STATUS_CONST(OUT_OF_RANGE);
          if (v < (long double)INT64_MIN || v >= 9223372036854775808.0L)
            return STATUS_CONST(ARITHMETIC_OVERFLOW);
          *outValue = (int64_t)v;
          return STATUS_CONST(SUCCESS);
        }
        default:
          return STATUS_CONST(NOT_SUPPORTED);
      }
    }),

