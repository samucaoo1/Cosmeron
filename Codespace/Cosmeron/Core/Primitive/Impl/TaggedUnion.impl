#define COSMERON_MACRO_INTERNAL_TU_PRIMITIVE_IMPL(ROW)                         \
  OPERATION(PP_OP_CAT2(Set_, PRIMITIVE_TYPE_GET(NAME, ROW)),                   \
            (MODULE_TYPE(Primitive, TaggedUnion) * self,                       \
             PRIMITIVE_TYPE_GET(TYPE, ROW) value), {                           \
    if (!self)                                                                 \
      return STATUS_CONST(INVALID_ARGUMENT);                                   \
    memset(self, 0, sizeof(*self));                                            \
    self->tag = MODULE_CONST(Primitive, Tag, PRIMITIVE_TYPE_GET(NAME, ROW));   \
    self->value.as.PRIMITIVE_TYPE_GET(NAME, ROW) = value;                      \
    return STATUS_CONST(SUCCESS);                                              \
  }),                                                                          \
  FUNCTION(MODULE_TYPE(Primitive, TaggedUnion),                                \
           PP_OP_CAT2(From_, PRIMITIVE_TYPE_GET(NAME, ROW)),                   \
           (PRIMITIVE_TYPE_GET(TYPE, ROW) value), {                            \
    MODULE_TYPE(Primitive, TaggedUnion) result;                                \
    memset(&result, 0, sizeof(result));                                        \
    result.tag = MODULE_CONST(Primitive, Tag, PRIMITIVE_TYPE_GET(NAME, ROW));  \
    result.value.as.PRIMITIVE_TYPE_GET(NAME, ROW) = value;                     \
    return result;                                                             \
  }),                                                                          \
  OPERATION(PP_OP_CAT2(Get_, PRIMITIVE_TYPE_GET(NAME, ROW)),                   \
            (const MODULE_TYPE(Primitive, TaggedUnion) * self,                 \
             PRIMITIVE_TYPE_GET(TYPE, ROW) * outValue), {                      \
    if (!self || !outValue)                                                    \
      return STATUS_CONST(INVALID_ARGUMENT);                                   \
    if (self->tag !=                                                           \
        MODULE_CONST(Primitive, Tag, PRIMITIVE_TYPE_GET(NAME, ROW)))           \
      return STATUS_CONST(INVALID_ARGUMENT);                                   \
    *outValue = self->value.as.PRIMITIVE_TYPE_GET(NAME, ROW);                  \
    return STATUS_CONST(SUCCESS);                                              \
  }),

#define COSMERON_MACRO_INTERNAL_TU_TAG_NAME_CASE(ROW)                          \
  case MODULE_CONST(Primitive, Tag, PRIMITIVE_TAG_GET(NAME, ROW)):             \
    return PRIMITIVE_TAG_GET(DESC, ROW);

#define COSMERON_MACRO_INTERNAL_TU_CATEGORY_CASE(ROW)                          \
  case MODULE_CONST(Primitive, Tag, PRIMITIVE_TAG_GET(NAME, ROW)):             \
    return MODULE_CONST(Primitive, PRIMITIVE_TAG_GET(CATEGORY, ROW));

#define COSMERON_MACRO_INTERNAL_TU_TRAITS_CASE(ROW)                            \
  case MODULE_CONST(Primitive, Tag, PRIMITIVE_TYPE_GET(NAME, ROW)):            \
    return MODULE_FUNC(Primitive, Traits, PRIMITIVE_TYPE_GET(NAME, ROW))();

#define COSMERON_MACRO_INTERNAL_TU_PAYLOAD_PTR_CASE(ROW)                       \
  case MODULE_CONST(Primitive, Tag, PRIMITIVE_TYPE_GET(NAME, ROW)):            \
    return &self->value.as.PRIMITIVE_TYPE_GET(NAME, ROW);

#define COSMERON_MACRO_INTERNAL_TU_COMPARE_CASE(ROW)                           \
  case MODULE_CONST(Primitive, Tag, PRIMITIVE_TYPE_GET(NAME, ROW)):            \
    return MODULE_FUNC(Algorithm, Comparison, PRIMITIVE_TYPE_GET(NAME, ROW))(  \
        left->value.as.PRIMITIVE_TYPE_GET(NAME, ROW),                          \
        right->value.as.PRIMITIVE_TYPE_GET(NAME, ROW));

