#pragma once

#include <string.h>

/* ========================================================================== */
/* 1. Internal Helpers & Primitive Trait Adapter Generation                   */
/* ========================================================================== */

#if PROCESSOR_X64 || PROCESSOR_ARM64 || PROCESSOR_PPC64 || PROCESSOR_LOONGARCH64 || PROCESSOR_S390X
#define COSMERON_MACRO_INTERNAL_TRAIT_FNV_OFFSET ((size_t)14695981039346656037ULL)
#define COSMERON_MACRO_INTERNAL_TRAIT_FNV_PRIME ((size_t)1099511628211ULL)
#else
#define COSMERON_MACRO_INTERNAL_TRAIT_FNV_OFFSET ((size_t)2166136261UL)
#define COSMERON_MACRO_INTERNAL_TRAIT_FNV_PRIME ((size_t)16777619UL)
#endif

#define COSMERON_MACRO_INTERNAL_TRAIT_PRIMITIVE_INTERNAL_FN(ROW)               \
  COMPARISON(PP_OP_CAT2(Compare_, PRIMITIVE_TYPE_GET(NAME, ROW)),              \
             (const void *left, const void *right), {                          \
               if (left == right)                                              \
                 return COMPARISON_CONST(EQUAL);                               \
               if (!left)                                                      \
                 return COMPARISON_CONST(LOWER);                               \
               if (!right)                                                     \
                 return COMPARISON_CONST(HIGHER);                              \
               return MODULE_FUNC(Algorithm, Comparison,                       \
                                  PRIMITIVE_TYPE_GET(NAME, ROW))(              \
                   *(const PRIMITIVE_TYPE_GET(TYPE, ROW) *)left,               \
                   *(const PRIMITIVE_TYPE_GET(TYPE, ROW) *)right);             \
             }),                                                               \
  FUNCTION(size_t, PP_OP_CAT2(Hash_, PRIMITIVE_TYPE_GET(NAME, ROW)),           \
           (const void *instance), {                                           \
             if (!instance)                                                    \
               return 0U;                                                      \
             return MODULE_IFUNC(Primitive, Traits, Fnv1aBytes)(               \
                 instance, sizeof(PRIMITIVE_TYPE_GET(TYPE, ROW)));             \
           }),

MODULE(DOMAIN(Core), Primitive,
  INTERNAL_EX(Traits,
    FUNCTION(size_t, Fnv1aBytes, (const void *data, size_t size), {
      if (!data || size == 0U)
        return 0U;
      const unsigned char *bytes = (const unsigned char *)data;
      size_t hash = COSMERON_MACRO_INTERNAL_TRAIT_FNV_OFFSET;
      const size_t prime = COSMERON_MACRO_INTERNAL_TRAIT_FNV_PRIME;
      for (size_t i = 0U; i < size; ++i) {
        hash ^= (size_t)bytes[i];
        hash *= prime;
      }
      return hash;
    }),

    OPERATION(CheckedMultiplySize,
              (size_t count, size_t elementSize, size_t *outTotal), {
      if (!outTotal)
        return STATUS_CONST(INVALID_ARGUMENT);
      if (elementSize != 0U && count > SIZE_MAX / elementSize)
        return STATUS_CONST(ARITHMETIC_OVERFLOW);
      *outTotal = count * elementSize;
      return STATUS_CONST(SUCCESS);
    }),

    COMPARISON(Compare_CString, (const void *left, const void *right), {
      if (left == right)
        return COMPARISON_CONST(EQUAL);
      if (!left)
        return COMPARISON_CONST(LOWER);
      if (!right)
        return COMPARISON_CONST(HIGHER);
      const char *const *leftStr = (const char *const *)left;
      const char *const *rightStr = (const char *const *)right;
      return MODULE_FUNC(Algorithm, Comparison, CString)(*leftStr, *rightStr);
    }),

    FUNCTION(size_t, Hash_CString, (const void *instance), {
      if (!instance)
        return 0U;
      const char *const *strPtr = (const char *const *)instance;
      if (!*strPtr)
        return 0U;
      return MODULE_IFUNC(Primitive, Traits, Fnv1aBytes)(
          *strPtr, strlen(*strPtr));
    }),

    PRIMITIVE_TYPE_TABLE(COSMERON_MACRO_INTERNAL_TRAIT_PRIMITIVE_INTERNAL_FN)

    FUNCTION(int, UnusedSentinel_, (void), { return 0; })
  )
);

#undef COSMERON_MACRO_INTERNAL_TRAIT_PRIMITIVE_INTERNAL_FN

/* ========================================================================== */
/* 2. Package Implementation: Primitive_Traits                                */
/* ========================================================================== */

#define COSMERON_MACRO_INTERNAL_TRAIT_FLAG_BOOL()                              \
  (MODULE_CONST(Primitive, TraitFlag, TRIVIAL_COPY) |                          \
   MODULE_CONST(Primitive, TraitFlag, TRIVIAL_COMPARE))
#define COSMERON_MACRO_INTERNAL_TRAIT_FLAG_INT()                               \
  (MODULE_CONST(Primitive, TraitFlag, TRIVIAL_COPY) |                          \
   MODULE_CONST(Primitive, TraitFlag, TRIVIAL_COMPARE) |                       \
   MODULE_CONST(Primitive, TraitFlag, IS_NUMERIC) |                            \
   MODULE_CONST(Primitive, TraitFlag, IS_SIGNED) |                             \
   MODULE_CONST(Primitive, TraitFlag, IS_INTEGER))
#define COSMERON_MACRO_INTERNAL_TRAIT_FLAG_UINT()                              \
  (MODULE_CONST(Primitive, TraitFlag, TRIVIAL_COPY) |                          \
   MODULE_CONST(Primitive, TraitFlag, TRIVIAL_COMPARE) |                       \
   MODULE_CONST(Primitive, TraitFlag, IS_NUMERIC) |                            \
   MODULE_CONST(Primitive, TraitFlag, IS_INTEGER))
#define COSMERON_MACRO_INTERNAL_TRAIT_FLAG_CHAR()                              \
  (MODULE_CONST(Primitive, TraitFlag, TRIVIAL_COPY) |                          \
   MODULE_CONST(Primitive, TraitFlag, TRIVIAL_COMPARE))
#define COSMERON_MACRO_INTERNAL_TRAIT_FLAG_FLOAT()                             \
  (MODULE_CONST(Primitive, TraitFlag, TRIVIAL_COPY) |                          \
   MODULE_CONST(Primitive, TraitFlag, IS_NUMERIC) |                            \
   MODULE_CONST(Primitive, TraitFlag, IS_SIGNED) |                             \
   MODULE_CONST(Primitive, TraitFlag, IS_FLOAT))
#define COSMERON_MACRO_INTERNAL_TRAIT_FLAG_PTR()                               \
  (MODULE_CONST(Primitive, TraitFlag, TRIVIAL_COPY) |                          \
   MODULE_CONST(Primitive, TraitFlag, TRIVIAL_COMPARE))

#define COSMERON_MACRO_INTERNAL_TRAIT_CAT_FLAGS(CAT)                           \
  PP_OP_CAT2(COSMERON_MACRO_INTERNAL_TRAIT_FLAG_, CAT)()

#define COSMERON_MACRO_INTERNAL_TRAIT_PRIMITIVE_GETTER_IMPL(ROW)               \
  FUNCTION(const MODULE_TYPE(Primitive, Traits) *,                             \
           PRIMITIVE_TYPE_GET(NAME, ROW), (void), {                            \
    static const MODULE_TYPE(Primitive, Traits) descriptor = {                 \
        .name = PP_OP_STRING(PRIMITIVE_TYPE_GET(T_NAME, ROW)),                 \
        .size = sizeof(PRIMITIVE_TYPE_GET(TYPE, ROW)),                         \
        .alignment = _Alignof(PRIMITIVE_TYPE_GET(TYPE, ROW)),                  \
        .category = MODULE_CONST(Primitive, PRIMITIVE_TYPE_GET(CATEGORY, ROW)),\
        .flags = COSMERON_MACRO_INTERNAL_TRAIT_CAT_FLAGS(                      \
            PRIMITIVE_TYPE_GET(CATEGORY, ROW)),                                \
        .init = NULL,                                                          \
        .dispose = NULL,                                                       \
        .copy = NULL,                                                          \
        .move = NULL,                                                          \
        .compare = MODULE_IFUNC(Primitive, Traits,                             \
                                PP_OP_CAT2(Compare_,                           \
                                           PRIMITIVE_TYPE_GET(NAME, ROW))),    \
        .hash = MODULE_IFUNC(Primitive, Traits,                                \
                             PP_OP_CAT2(Hash_,                                 \
                                        PRIMITIVE_TYPE_GET(NAME, ROW)))};      \
    return &descriptor;                                                        \
  }),

MODULE_IMPLEMENT(DOMAIN(Core), Primitive,
  PACKAGE(Traits,
    PREDICATE(IsValid, (const MODULE_TYPE(Primitive, Traits) * traits), {
      return traits != NULL && traits->name != NULL && traits->size > 0U &&
             traits->alignment > 0U;
    }),

    PREDICATE(IsEqual, (const MODULE_TYPE(Primitive, Traits) * left,
                        const MODULE_TYPE(Primitive, Traits) * right), {
      if (!left || !right)
        return false;
      return left == right;
    }),

    PREDICATE(HasFlags, (const MODULE_TYPE(Primitive, Traits) * traits,
                         uint32_t mask), {
      if (!traits || mask == 0U)
        return false;
      return (traits->flags & mask) == mask;
    }),

    PREDICATE(IsTrivial, (const MODULE_TYPE(Primitive, Traits) * traits), {
      if (!traits)
        return false;
      const uint32_t required =
          MODULE_CONST(Primitive, TraitFlag, TRIVIAL_COPY);
      const uint32_t forbidden =
          MODULE_CONST(Primitive, TraitFlag, NEEDS_DISPOSE) |
          MODULE_CONST(Primitive, TraitFlag, IS_DYNAMIC);
      return ((traits->flags & required) == required) &&
             ((traits->flags & forbidden) == 0U) &&
             (traits->init == NULL) && (traits->dispose == NULL);
    }),

    PREDICATE(IsTrivialCopy, (const MODULE_TYPE(Primitive, Traits) * traits), {
      return MODULE_FUNC(Primitive, Traits, HasFlags)(
          traits, MODULE_CONST(Primitive, TraitFlag, TRIVIAL_COPY));
    }),

    PREDICATE(IsTrivialCompare, (const MODULE_TYPE(Primitive, Traits) * traits), {
      return MODULE_FUNC(Primitive, Traits, HasFlags)(
          traits, MODULE_CONST(Primitive, TraitFlag, TRIVIAL_COMPARE));
    }),

    PREDICATE(NeedsDispose, (const MODULE_TYPE(Primitive, Traits) * traits), {
      if (!traits)
        return false;
      return (traits->dispose != NULL) ||
             MODULE_FUNC(Primitive, Traits, HasFlags)(
                 traits, MODULE_CONST(Primitive, TraitFlag, NEEDS_DISPOSE));
    }),

    PREDICATE(IsNumeric, (const MODULE_TYPE(Primitive, Traits) * traits), {
      return MODULE_FUNC(Primitive, Traits, HasFlags)(
          traits, MODULE_CONST(Primitive, TraitFlag, IS_NUMERIC));
    }),

    PREDICATE(IsSigned, (const MODULE_TYPE(Primitive, Traits) * traits), {
      return MODULE_FUNC(Primitive, Traits, HasFlags)(
          traits, MODULE_CONST(Primitive, TraitFlag, IS_SIGNED));
    }),

    PREDICATE(IsInteger, (const MODULE_TYPE(Primitive, Traits) * traits), {
      return MODULE_FUNC(Primitive, Traits, HasFlags)(
          traits, MODULE_CONST(Primitive, TraitFlag, IS_INTEGER));
    }),

    PREDICATE(IsFloat, (const MODULE_TYPE(Primitive, Traits) * traits), {
      return MODULE_FUNC(Primitive, Traits, HasFlags)(
          traits, MODULE_CONST(Primitive, TraitFlag, IS_FLOAT));
    }),

    PREDICATE(IsDynamic, (const MODULE_TYPE(Primitive, Traits) * traits), {
      return MODULE_FUNC(Primitive, Traits, HasFlags)(
          traits, MODULE_CONST(Primitive, TraitFlag, IS_DYNAMIC));
    }),

    OPERATION(Init, (const MODULE_TYPE(Primitive, Traits) * traits,
                     void *instance), {
      if (!MODULE_FUNC(Primitive, Traits, IsValid)(traits) || !instance)
        return STATUS_CONST(INVALID_ARGUMENT);
      if (traits->init)
        return traits->init(instance);
      memset(instance, 0, traits->size);
      return STATUS_CONST(SUCCESS);
    }),

    OPERATION(InitArray, (const MODULE_TYPE(Primitive, Traits) * traits,
                          void *array, size_t count), {
      if (!MODULE_FUNC(Primitive, Traits, IsValid)(traits))
        return STATUS_CONST(INVALID_ARGUMENT);
      if (count == 0U)
        return STATUS_CONST(SUCCESS);
      if (!array)
        return STATUS_CONST(INVALID_ARGUMENT);

      size_t totalBytes = 0U;
      OPSTATUS status = MODULE_IFUNC(Primitive, Traits, CheckedMultiplySize)(
          count, traits->size, &totalBytes);
      if (status != STATUS_CONST(SUCCESS))
        return status;

      if (!traits->init) {
        memset(array, 0, totalBytes);
        return STATUS_CONST(SUCCESS);
      }

      unsigned char *cursor = (unsigned char *)array;
      for (size_t i = 0U; i < count; ++i) {
        status = traits->init(cursor + (i * traits->size));
        if (status != STATUS_CONST(SUCCESS)) {
          if (traits->dispose) {
            for (size_t j = 0U; j < i; ++j) {
              traits->dispose(cursor + (j * traits->size));
            }
          }
          return status;
        }
      }
      return STATUS_CONST(SUCCESS);
    }),

    PROCEDURE(Dispose, (const MODULE_TYPE(Primitive, Traits) * traits,
                        void *instance), {
      if (!traits || !instance)
        return;
      if (traits->dispose)
        traits->dispose(instance);
    }),

    PROCEDURE(DisposeArray, (const MODULE_TYPE(Primitive, Traits) * traits,
                             void *array, size_t count), {
      if (!traits || !array || count == 0U || !traits->dispose)
        return;
      unsigned char *cursor = (unsigned char *)array;
      for (size_t i = 0U; i < count; ++i) {
        traits->dispose(cursor + (i * traits->size));
      }
    }),

    OPERATION(Copy, (const MODULE_TYPE(Primitive, Traits) * traits,
                     void *destination, const void *source), {
      if (!MODULE_FUNC(Primitive, Traits, IsValid)(traits) || !destination ||
          !source)
        return STATUS_CONST(INVALID_ARGUMENT);
      if (destination == source)
        return STATUS_CONST(SUCCESS);

      if (traits->copy)
        return traits->copy(destination, source);

      if (MODULE_FUNC(Primitive, Traits, IsTrivialCopy)(traits)) {
        memcpy(destination, source, traits->size);
        return STATUS_CONST(SUCCESS);
      }

      return STATUS_CONST(NOT_SUPPORTED);
    }),

    OPERATION(CopyArray, (const MODULE_TYPE(Primitive, Traits) * traits,
                          void *destination, const void *source,
                          size_t count), {
      if (!MODULE_FUNC(Primitive, Traits, IsValid)(traits))
        return STATUS_CONST(INVALID_ARGUMENT);
      if (count == 0U)
        return STATUS_CONST(SUCCESS);
      if (!destination || !source)
        return STATUS_CONST(INVALID_ARGUMENT);
      if (destination == source)
        return STATUS_CONST(SUCCESS);

      size_t totalBytes = 0U;
      OPSTATUS status = MODULE_IFUNC(Primitive, Traits, CheckedMultiplySize)(
          count, traits->size, &totalBytes);
      if (status != STATUS_CONST(SUCCESS))
        return status;

      if (!traits->copy &&
          MODULE_FUNC(Primitive, Traits, IsTrivialCopy)(traits)) {
        memcpy(destination, source, totalBytes);
        return STATUS_CONST(SUCCESS);
      }

      if (!traits->copy)
        return STATUS_CONST(NOT_SUPPORTED);

      unsigned char *destCursor = (unsigned char *)destination;
      const unsigned char *srcCursor = (const unsigned char *)source;
      for (size_t i = 0U; i < count; ++i) {
        status = traits->copy(destCursor + (i * traits->size),
                              srcCursor + (i * traits->size));
        if (status != STATUS_CONST(SUCCESS)) {
          if (traits->dispose) {
            for (size_t j = 0U; j < i; ++j) {
              traits->dispose(destCursor + (j * traits->size));
            }
          }
          return status;
        }
      }
      return STATUS_CONST(SUCCESS);
    }),

    OPERATION(Move, (const MODULE_TYPE(Primitive, Traits) * traits,
                     void *destination, void *source), {
      if (!MODULE_FUNC(Primitive, Traits, IsValid)(traits) || !destination ||
          !source)
        return STATUS_CONST(INVALID_ARGUMENT);
      if (destination == source)
        return STATUS_CONST(SUCCESS);

      if (traits->move) {
        traits->move(destination, source);
        return STATUS_CONST(SUCCESS);
      }

      if (MODULE_FUNC(Primitive, Traits, IsTrivialCopy)(traits)) {
        memmove(destination, source, traits->size);
        return STATUS_CONST(SUCCESS);
      }

      /* Fallback: shallow transfer + zero source if no custom move hook */
      memcpy(destination, source, traits->size);
      memset(source, 0, traits->size);
      return STATUS_CONST(SUCCESS);
    }),

    OPERATION(MoveArray, (const MODULE_TYPE(Primitive, Traits) * traits,
                          void *destination, void *source, size_t count), {
      if (!MODULE_FUNC(Primitive, Traits, IsValid)(traits))
        return STATUS_CONST(INVALID_ARGUMENT);
      if (count == 0U)
        return STATUS_CONST(SUCCESS);
      if (!destination || !source)
        return STATUS_CONST(INVALID_ARGUMENT);
      if (destination == source)
        return STATUS_CONST(SUCCESS);

      size_t totalBytes = 0U;
      OPSTATUS status = MODULE_IFUNC(Primitive, Traits, CheckedMultiplySize)(
          count, traits->size, &totalBytes);
      if (status != STATUS_CONST(SUCCESS))
        return status;

      if (!traits->move &&
          MODULE_FUNC(Primitive, Traits, IsTrivialCopy)(traits)) {
        memmove(destination, source, totalBytes);
        return STATUS_CONST(SUCCESS);
      }

      unsigned char *destCursor = (unsigned char *)destination;
      unsigned char *srcCursor = (unsigned char *)source;
      for (size_t i = 0U; i < count; ++i) {
        status = MODULE_FUNC(Primitive, Traits, Move)(
            traits, destCursor + (i * traits->size),
            srcCursor + (i * traits->size));
        if (status != STATUS_CONST(SUCCESS))
          return status;
      }
      return STATUS_CONST(SUCCESS);
    }),

    OPERATION(Swap, (const MODULE_TYPE(Primitive, Traits) * traits,
                     void *left, void *right), {
      if (!MODULE_FUNC(Primitive, Traits, IsValid)(traits) || !left || !right)
        return STATUS_CONST(INVALID_ARGUMENT);
      if (left == right)
        return STATUS_CONST(SUCCESS);

      unsigned char temporary[MODULE_CONST(Primitive, Traits, SWAP_BUFFER_SIZE)];
      if (traits->move &&
          traits->size <= MODULE_CONST(Primitive, Traits, SWAP_BUFFER_SIZE)) {
        traits->move(temporary, left);
        traits->move(left, right);
        traits->move(right, temporary);
        return STATUS_CONST(SUCCESS);
      }

      unsigned char *leftBytes = (unsigned char *)left;
      unsigned char *rightBytes = (unsigned char *)right;
      size_t remaining = traits->size;
      while (remaining > 0U) {
        size_t chunk =
            remaining > MODULE_CONST(Primitive, Traits, SWAP_BUFFER_SIZE)
                ? MODULE_CONST(Primitive, Traits, SWAP_BUFFER_SIZE)
                : remaining;
        memcpy(temporary, leftBytes, chunk);
        memcpy(leftBytes, rightBytes, chunk);
        memcpy(rightBytes, temporary, chunk);
        leftBytes += chunk;
        rightBytes += chunk;
        remaining -= chunk;
      }
      return STATUS_CONST(SUCCESS);
    }),

    COMPARISON(Compare, (const MODULE_TYPE(Primitive, Traits) * traits,
                         const void *left, const void *right), {
      if (left == right)
        return COMPARISON_CONST(EQUAL);
      if (!left)
        return COMPARISON_CONST(LOWER);
      if (!right)
        return COMPARISON_CONST(HIGHER);
      if (!MODULE_FUNC(Primitive, Traits, IsValid)(traits))
        return COMPARISON_CONST(EQUAL);

      if (traits->compare)
        return traits->compare(left, right);

      if (MODULE_FUNC(Primitive, Traits, IsTrivialCompare)(traits)) {
        return MODULE_FUNC(Algorithm, Comparison, Bytes)(
            left, traits->size, right, traits->size);
      }

      return COMPARISON_CONST(EQUAL);
    }),

    PREDICATE(Equals, (const MODULE_TYPE(Primitive, Traits) * traits,
                       const void *left, const void *right), {
      if (!MODULE_FUNC(Primitive, Traits, IsValid)(traits))
        return false;
      if (left == right)
        return left != NULL;
      if (!left || !right)
        return false;

      if (traits->compare)
        return traits->compare(left, right) == COMPARISON_CONST(EQUAL);

      if (MODULE_FUNC(Primitive, Traits, IsTrivialCompare)(traits))
        return memcmp(left, right, traits->size) == 0;

      return false;
    }),

    FUNCTION(size_t, Hash, (const MODULE_TYPE(Primitive, Traits) * traits,
                            const void *instance), {
      if (!MODULE_FUNC(Primitive, Traits, IsValid)(traits) || !instance)
        return 0U;
      if (traits->hash)
        return traits->hash(instance);
      if (MODULE_FUNC(Primitive, Traits, IsTrivialCompare)(traits))
        return MODULE_IFUNC(Primitive, Traits, Fnv1aBytes)(instance,
                                                           traits->size);
      return 0U;
    }),

    FUNCTION(size_t, HashBytes, (const void *data, size_t size), {
      return MODULE_IFUNC(Primitive, Traits, Fnv1aBytes)(data, size);
    }),

    PRIMITIVE_TYPE_TABLE(COSMERON_MACRO_INTERNAL_TRAIT_PRIMITIVE_GETTER_IMPL)

    FUNCTION(const MODULE_TYPE(Primitive, Traits) *, CString, (void), {
      static const MODULE_TYPE(Primitive, Traits) descriptor = {
          .name = "CString",
          .size = sizeof(const char *),
          .alignment = _Alignof(const char *),
          .category = MODULE_CONST(Primitive, PTR),
          .flags = MODULE_CONST(Primitive, TraitFlag, TRIVIAL_COPY),
          .init = NULL,
          .dispose = NULL,
          .copy = NULL,
          .move = NULL,
          .compare = MODULE_IFUNC(Primitive, Traits, Compare_CString),
          .hash = MODULE_IFUNC(Primitive, Traits, Hash_CString)};
      return &descriptor;
    })
  )
);

#undef COSMERON_MACRO_INTERNAL_TRAIT_PRIMITIVE_GETTER_IMPL
#undef COSMERON_MACRO_INTERNAL_TRAIT_CAT_FLAGS
#undef COSMERON_MACRO_INTERNAL_TRAIT_FLAG_BOOL
#undef COSMERON_MACRO_INTERNAL_TRAIT_FLAG_INT
#undef COSMERON_MACRO_INTERNAL_TRAIT_FLAG_UINT
#undef COSMERON_MACRO_INTERNAL_TRAIT_FLAG_CHAR
#undef COSMERON_MACRO_INTERNAL_TRAIT_FLAG_FLOAT
#undef COSMERON_MACRO_INTERNAL_TRAIT_FLAG_PTR
#undef COSMERON_MACRO_INTERNAL_TRAIT_FNV_OFFSET
#undef COSMERON_MACRO_INTERNAL_TRAIT_FNV_PRIME

/* EOF */
