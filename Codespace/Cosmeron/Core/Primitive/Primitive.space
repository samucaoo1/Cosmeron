#pragma once

#include "../Namespace.h"

#define PRIMITIVE_MOD Primitive
#define PRIMITIVE_CMOD PRIMITIVE

#define PRIMITIVE_NS(NAME) GNS2(LIB_PREFIX(PRIMITIVE_MOD), NAME)
#define PRIMITIVE_CNS(NAME) CNS2(LIB_PREFIX_CONST(PRIMITIVE_CMOD), NAME)
#define PRIMITIVE_INS(NAME) GNS3(LIB_PREFIX(PRIMITIVE_MOD), Internal, NAME)
#define PRIMITIVE_CINS(NAME) CNS3(LIB_PREFIX_CONST(PRIMITIVE_CMOD), INTERNAL, NAME)

#define PRIMITIVE_TYPE(NAME) PRIMITIVE_NS(NAME)
#define PRIMITIVE_FUNC(NAME) PRIMITIVE_NS(NAME)
#define PRIMITIVE_CONST(NAME) PRIMITIVE_CNS(NAME)
/* EOF */
