/* ByteTag.def - Dual Mode Engine (Zero Duplication) */

#include "Impl/Common.inc"

#ifndef TEMPLATE_Type_ByteTag
#define TEMPLATE_Type_ByteTag(SUFFIX, UINT_TYPE)                               \
  TEMPLATE_WIDTH_OBJECT(Type, ByteTag, SUFFIX,                                       \
      FIELDS(                                                                  \
          UINT_TYPE value;                                                     \
          char text[((SUFFIX) / CNS(Bit, Internal, BITS_PER_BYTE)) + 1U];      \
      ),                                                                       \
      VARIANT(From,                                                            \
          OPERATION_INLINE(String, (const char *chars), {                      \
            if (!self || !chars) {                                             \
              return STATUS_CONST(INVALID_ARGUMENT);                           \
            }                                                                  \
            const size_t byteCount =                                           \
                (size_t)(SUFFIX) / CNS(Bit, Internal, BITS_PER_BYTE);          \
            self->value = (UINT_TYPE)MODULE_IFUNC(Type, ByteTag, PackBE)(      \
                (const uint8_t *)chars, strlen(chars), byteCount, ' ',         \
                self->text);                                                   \
            return STATUS_CONST(SUCCESS);                                      \
          }),                                                                  \
          OPERATION_INLINE(UInt, (UINT_TYPE value), {                          \
            if (!self) {                                                       \
              return STATUS_CONST(INVALID_ARGUMENT);                           \
            }                                                                  \
            const size_t byteCount =                                           \
                (size_t)(SUFFIX) / CNS(Bit, Internal, BITS_PER_BYTE);          \
            self->value = value;                                               \
            MODULE_IFUNC(Type, ByteTag, UnpackText)(                           \
                (uint64_t)value, byteCount, self->text);                       \
            return STATUS_CONST(SUCCESS);                                      \
          }),                                                                  \
          OPERATION_INLINE(Bytes, (const void *bytes, size_t length), {        \
            if (!self || (!bytes && length > 0U)) {                            \
              return STATUS_CONST(INVALID_ARGUMENT);                           \
            }                                                                  \
            const size_t byteCount =                                           \
                (size_t)(SUFFIX) / CNS(Bit, Internal, BITS_PER_BYTE);          \
            self->value = (UINT_TYPE)MODULE_IFUNC(Type, ByteTag, PackBE)(      \
                (const uint8_t *)bytes, length, byteCount, ' ', self->text);   \
            return STATUS_CONST(SUCCESS);                                      \
          })                                                                   \
      ),                                                                       \
      VARIANT(Read,                                                            \
          OPERATION_INLINE(BE, (const void *src), {                            \
            if (!self || !src) {                                               \
              return STATUS_CONST(INVALID_ARGUMENT);                           \
            }                                                                  \
            const size_t byteCount =                                           \
                (size_t)(SUFFIX) / CNS(Bit, Internal, BITS_PER_BYTE);          \
            self->value = (UINT_TYPE)MODULE_IFUNC(Type, ByteTag, PackBE)(      \
                (const uint8_t *)src, byteCount, byteCount, '\0', self->text); \
            return STATUS_CONST(SUCCESS);                                      \
          }),                                                                  \
          OPERATION_INLINE(LE, (const void *src), {                            \
            if (!self || !src) {                                               \
              return STATUS_CONST(INVALID_ARGUMENT);                           \
            }                                                                  \
            const size_t byteCount =                                           \
                (size_t)(SUFFIX) / CNS(Bit, Internal, BITS_PER_BYTE);          \
            const uint64_t val = MODULE_IFUNC(Type, ByteTag, PackLE)(          \
                (const uint8_t *)src, byteCount);                              \
            self->value = (UINT_TYPE)val;                                      \
            MODULE_IFUNC(Type, ByteTag, UnpackText)(val, byteCount,            \
                                                    self->text);               \
            return STATUS_CONST(SUCCESS);                                      \
          })                                                                   \
      ),                                                                       \
      VARIANT(Write,                                                           \
          CONST_OPERATION_INLINE(BE, (void *dest), {                           \
            if (!self || !dest) {                                              \
              return STATUS_CONST(INVALID_ARGUMENT);                           \
            }                                                                  \
            const size_t byteCount =                                           \
                (size_t)(SUFFIX) / CNS(Bit, Internal, BITS_PER_BYTE);          \
            MODULE_IFUNC(Type, ByteTag, WriteBytes)(                           \
                (uint64_t)self->value, byteCount, dest, true);                 \
            return STATUS_CONST(SUCCESS);                                      \
          }),                                                                  \
          CONST_OPERATION_INLINE(LE, (void *dest), {                           \
            if (!self || !dest) {                                              \
              return STATUS_CONST(INVALID_ARGUMENT);                           \
            }                                                                  \
            const size_t byteCount =                                           \
                (size_t)(SUFFIX) / CNS(Bit, Internal, BITS_PER_BYTE);          \
            MODULE_IFUNC(Type, ByteTag, WriteBytes)(                           \
                (uint64_t)self->value, byteCount, dest, false);                \
            return STATUS_CONST(SUCCESS);                                      \
          })                                                                   \
      ),                                                                       \
      VARIANT(To,                                                              \
          CONST_OPERATION_INLINE(String, (char *dest, size_t destCapacity), {  \
            if (!self || !dest || destCapacity == 0U) {                        \
              return STATUS_CONST(INVALID_ARGUMENT);                           \
            }                                                                  \
            const size_t byteCount =                                           \
                (size_t)(SUFFIX) / CNS(Bit, Internal, BITS_PER_BYTE);          \
            if (destCapacity < (byteCount + 1U)) {                             \
              return STATUS_CONST(INSUFFICIENT_SPACE);                         \
            }                                                                  \
            MODULE_IFUNC(Type, ByteTag, FormatPrintable)(                      \
                self->text, byteCount, dest);                                  \
            return STATUS_CONST(SUCCESS);                                      \
          }),                                                                  \
          CONST_FUNCTION_INLINE(UINT_TYPE, UInt, (), {                         \
            return self ? self->value : (UINT_TYPE)0U;                         \
          })                                                                   \
      ),                                                                       \
      CONST_FUNCTION_INLINE(const char *, Text, (), {                          \
        return self ? self->text : "";                                         \
      }),                                                                      \
      CONST_PREDICATE_INLINE(IsPrintable, (), {                                \
        if (!self) {                                                           \
          return false;                                                        \
        }                                                                      \
        const size_t byteCount =                                               \
            (size_t)(SUFFIX) / CNS(Bit, Internal, BITS_PER_BYTE);              \
        return MODULE_IFUNC(Type, ByteTag, IsPrintableText)(                   \
            self->text, byteCount);                                            \
      }),                                                                      \
      CONST_PREDICATE_INLINE(                                                  \
          Equal, (const MODULE_TYPE(Type, PP_OP_CAT2(ByteTag, SUFFIX)) *other), {         \
            if (!self || !other) {                                             \
              return self == other;                                            \
            }                                                                  \
            return self->value == other->value;                                \
          }),                                                                  \
      CONST_OPERATION_INLINE(                                                  \
          Compare,                                                             \
          (const MODULE_TYPE(Type, PP_OP_CAT2(ByteTag, SUFFIX)) *other, CMPOUT *result),  \
          {                                                                    \
            if (!self || !other || !result) {                                  \
              return STATUS_CONST(INVALID_ARGUMENT);                           \
            }                                                                  \
            if (self->value < other->value) {                                  \
              *result = COMPARISON_CONST(LOWER);                               \
            } else if (self->value > other->value) {                           \
              *result = COMPARISON_CONST(HIGHER);                              \
            } else {                                                           \
              *result = COMPARISON_CONST(EQUAL);                               \
            }                                                                  \
            return STATUS_CONST(SUCCESS);                                      \
          })                                                                   \
  )
#endif

/* Mode 2 (Direct Include): Auto-instantiates and cleans up environment */
#if (!defined(COSMERON_INTERNAL_NO_AUTO_INSTANTIATE) && !defined(COSMERON_INTERNAL_IN_COMMON_INC)) && defined(SUFFIX) && defined(TYPE)
  TEMPLATE_Type_ByteTag(SUFFIX, TYPE);
  #undef SUFFIX
  #undef TYPE
#endif
