/* Optional.def - Dual Mode Engine (Zero Duplication) */

#include "../Module/Delegate/Delegate.h"
#include "Impl/Common.inc"

#ifndef TEMPLATE_Optional
#define TEMPLATE_Optional(SUFFIX, TYPE)                                   \
  TEMPLATE_OBJECT_ROOT(Optional, SUFFIX,                                      \
      FIELDS(                                                                  \
          bool hasValue;                                                       \
          TYPE value;                                                          \
      ),                                                                       \
                                                                               \
      DELEGATE(                                                                \
          FUNCTION(TYPE, MapFunction, (TYPE value)),                           \
          OPERATION(                                                           \
              BindFunction,                                                    \
              (TYPE value,                                                     \
               struct MODULE_TYPED(Optional, SUFFIX) * outOptional)),          \
          PREDICATE(FilterPredicate, (TYPE value))),                           \
                                                                               \
      PROCEDURE_INLINE(Clear, (), {                                            \
        if (self) {                                                            \
          self->hasValue = false;                                              \
          memset(&self->value, 0, sizeof(TYPE));                               \
        }                                                                      \
      }),                                                                      \
                                                                               \
      OPERATION_INLINE(Some, (TYPE value), {                                   \
        if (!self) {                                                           \
          return STATUS_CONST(INVALID_ARGUMENT);                               \
        }                                                                      \
        MODULE_FUNC(Optional, SUFFIX, Init)(self);                       \
        self->hasValue = true;                                                 \
        self->value = value;                                                   \
        return STATUS_CONST(SUCCESS);                                          \
      }),                                                                      \
                                                                               \
      OPERATION_INLINE(None, (), {                                             \
        if (!self) {                                                           \
          return STATUS_CONST(INVALID_ARGUMENT);                               \
        }                                                                      \
        MODULE_FUNC(Optional, SUFFIX, Init)(self);                       \
        MODULE_FUNC(Optional, SUFFIX, Clear)(self);                      \
        return STATUS_CONST(SUCCESS);                                          \
      }),                                                                      \
                                                                               \
      OPERATION_INLINE(FromPointer, (const TYPE *ptr), {                       \
        if (!self) {                                                           \
          return STATUS_CONST(INVALID_ARGUMENT);                               \
        }                                                                      \
        return (ptr != NULL)                                                   \
                   ? MODULE_FUNC(Optional, SUFFIX, Some)(self, *ptr)     \
                   : MODULE_FUNC(Optional, SUFFIX, None)(self);          \
      }),                                                                      \
                                                                               \
      CONST_PREDICATE_INLINE(HasValue, (), {                                   \
        return self ? self->hasValue : false;                                  \
      }),                                                                      \
                                                                               \
      VARIANT(Is,                                                              \
          CONST_PREDICATE_INLINE(Some, (), {                                   \
            return self ? self->hasValue : false;                              \
          }),                                                                  \
          CONST_PREDICATE_INLINE(None, (), {                                   \
            return self ? !self->hasValue : true;                              \
          })                                                                   \
      ),                                                                       \
                                                                               \
      VARIANT(Value,                                                           \
          CONST_OPERATION_INLINE((TYPE *outValue), {                           \
            if (!self || !outValue) {                                          \
              return STATUS_CONST(INVALID_ARGUMENT);                           \
            }                                                                  \
            if (!self->hasValue) {                                             \
              return STATUS_CONST(NOT_FOUND);                                  \
            }                                                                  \
            *outValue = self->value;                                           \
            return STATUS_CONST(SUCCESS);                                      \
          }),                                                                  \
          CONST_FUNCTION_INLINE(TYPE, Or, (TYPE fallback), {                   \
            return (self && self->hasValue) ? self->value : fallback;          \
          }),                                                                  \
          CONST_FUNCTION_INLINE(const TYPE *, Pointer, (), {                   \
            return (self && self->hasValue) ? &self->value : NULL;             \
          })                                                                   \
      ),                                                                       \
                                                                               \
      FUNCTION_INLINE(TYPE *, MutablePointer, (), {                            \
        return (self && self->hasValue) ? &self->value : NULL;                 \
      }),                                                                      \
                                                                               \
      CONST_OPERATION_INLINE(                                                  \
          Map,                                                                 \
          (MODULE_DELEGATE(Optional, SUFFIX, MapFunction) mapper,              \
           struct MODULE_TYPED(Optional, SUFFIX) * outOptional),               \
          {                                                                    \
            if (!self || !outOptional || !DELEGATE_IS_VALID(mapper)) {         \
              return STATUS_CONST(INVALID_ARGUMENT);                           \
            }                                                                  \
            if (!self->hasValue) {                                             \
              return MODULE_FUNC(Optional, SUFFIX, None)(outOptional);   \
            }                                                                  \
            const TYPE mapped = DELEGATE_CALL(mapper, self->value);            \
            return MODULE_FUNC(Optional, SUFFIX, Some)(outOptional,      \
                                                             mapped);          \
          }),                                                                  \
                                                                               \
      CONST_OPERATION_INLINE(                                                  \
          AndThen,                                                             \
          (MODULE_DELEGATE(Optional, SUFFIX, BindFunction) binder,             \
           struct MODULE_TYPED(Optional, SUFFIX) * outOptional),               \
          {                                                                    \
            if (!self || !outOptional || !DELEGATE_IS_VALID(binder)) {         \
              return STATUS_CONST(INVALID_ARGUMENT);                           \
            }                                                                  \
            if (!self->hasValue) {                                             \
              return MODULE_FUNC(Optional, SUFFIX, None)(outOptional);   \
            }                                                                  \
            MODULE_FUNC(Optional, SUFFIX, Init)(outOptional);            \
            return DELEGATE_CALL(binder, self->value, outOptional);            \
          }),                                                                  \
                                                                               \
      CONST_OPERATION_INLINE(                                                  \
          Filter,                                                              \
          (MODULE_DELEGATE(Optional, SUFFIX, FilterPredicate) predicate,       \
           struct MODULE_TYPED(Optional, SUFFIX) * outOptional),               \
          {                                                                    \
            if (!self || !outOptional || !DELEGATE_IS_VALID(predicate)) {      \
              return STATUS_CONST(INVALID_ARGUMENT);                           \
            }                                                                  \
            if (!self->hasValue || !DELEGATE_CALL(predicate, self->value)) {   \
              return MODULE_FUNC(Optional, SUFFIX, None)(outOptional);   \
            }                                                                  \
            return MODULE_FUNC(Optional, SUFFIX, Some)(outOptional,      \
                                                             self->value);     \
          })                                                                   \
  )
#endif

/* Mode 2 (Direct Include): Auto-instantiates and cleans up environment */
#if (!defined(COSMERON_INTERNAL_NO_AUTO_INSTANTIATE) && !defined(COSMERON_INTERNAL_IN_COMMON_INC)) && defined(SUFFIX) && defined(TYPE)
  TEMPLATE_Optional(SUFFIX, TYPE);
  #undef SUFFIX
  #undef TYPE
#endif
