/* Result.def - Dual Mode Engine (Zero Duplication) */

#include "../Condition/Error.h"
#include "../Module/Closure/Closure.h"
#include "Impl/Common.inc"

#ifndef TEMPLATE_Result
#define TEMPLATE_Result(SUFFIX, TYPE)                                     \
  TEMPLATE_OBJECT_ROOT(Result, SUFFIX,                                        \
      FIELDS(                                                                  \
          bool isOk;                                                           \
          union {                                                              \
            TYPE value;                                                        \
            MODULE_TYPE(Condition, Error) error;                               \
          } storage;                                                           \
      ),                                                                       \
                                                                               \
      CLOSURE(                                                                 \
          FUNCTION(TYPE, MapFunction, (TYPE value)),                           \
          OPERATION(                                                           \
              BindFunction,                                                    \
              (TYPE value,                                                     \
               struct MODULE_TYPED(Result, SUFFIX) * outResult))),       \
                                                                               \
      OPERATION_INLINE(Ok, (TYPE value), {                                     \
        if (!self) {                                                           \
          return STATUS_CONST(INVALID_ARGUMENT);                               \
        }                                                                      \
        MODULE_FUNC(Result, SUFFIX, Init)(self);                         \
        self->isOk = true;                                                     \
        self->storage.value = value;                                           \
        return STATUS_CONST(SUCCESS);                                          \
      }),                                                                      \
                                                                               \
      OPERATION_INLINE(Err, (const MODULE_TYPE(Condition, Error) * error), {   \
        if (!self || !error) {                                                 \
          return STATUS_CONST(INVALID_ARGUMENT);                               \
        }                                                                      \
        MODULE_FUNC(Result, SUFFIX, Init)(self);                         \
        self->isOk = false;                                                    \
        self->storage.error = *error;                                          \
        return STATUS_CONST(SUCCESS);                                          \
      }),                                                                      \
                                                                               \
      OPERATION_INLINE(FromStatus, (OPSTATUS status), {                        \
        if (!self) {                                                           \
          return STATUS_CONST(INVALID_ARGUMENT);                               \
        }                                                                      \
        if (status == STATUS_CONST(SUCCESS)) {                                 \
          MODULE_FUNC(Result, SUFFIX, Init)(self);                       \
          self->isOk = true;                                                   \
          return STATUS_CONST(SUCCESS);                                        \
        }                                                                      \
        MODULE_TYPE(Condition, Error) err;                                     \
        MODULE_FUNC(Condition, Error, FromStatus)(&err, status);               \
        return MODULE_FUNC(Result, SUFFIX, Err)(self, &err);             \
      }),                                                                      \
                                                                               \
      VARIANT(Is,                                                              \
          CONST_PREDICATE_INLINE(Ok, (), {                                     \
            return self ? self->isOk : false;                                  \
          }),                                                                  \
          CONST_PREDICATE_INLINE(Error, (), {                                  \
            return self ? !self->isOk : true;                                  \
          })                                                                   \
      ),                                                                       \
                                                                               \
      VARIANT(Value,                                                           \
          CONST_OPERATION_INLINE((TYPE * outValue), {                          \
            if (!self || !outValue) {                                          \
              return STATUS_CONST(INVALID_ARGUMENT);                           \
            }                                                                  \
            if (!self->isOk) {                                                 \
              return self->storage.error.code;                                 \
            }                                                                  \
            *outValue = self->storage.value;                                   \
            return STATUS_CONST(SUCCESS);                                      \
          }),                                                                  \
          CONST_FUNCTION_INLINE(TYPE, Or, (TYPE fallback), {                   \
            return (self && self->isOk) ? self->storage.value : fallback;      \
          })                                                                   \
      ),                                                                       \
                                                                               \
      CONST_OPERATION_INLINE(Error, (MODULE_TYPE(Condition, Error) * outError),\
                             {                                                 \
        if (!self || !outError || self->isOk) {                                \
          return STATUS_CONST(INVALID_ARGUMENT);                               \
        }                                                                      \
        *outError = self->storage.error;                                       \
        return STATUS_CONST(SUCCESS);                                          \
      }),                                                                      \
                                                                               \
      CONST_OPERATION_INLINE(                                                  \
          Map,                                                                 \
          (MODULE_CLOSURE(Result, SUFFIX, MapFunction) mapper,           \
           struct MODULE_TYPED(Result, SUFFIX) * outResult),             \
          {                                                                    \
            if (!self || !outResult || !CLOSURE_IS_VALID(mapper)) {            \
              return STATUS_CONST(INVALID_ARGUMENT);                           \
            }                                                                  \
            if (!self->isOk) {                                                 \
              return MODULE_FUNC(Result, SUFFIX, Err)(                   \
                  outResult, &self->storage.error);                            \
            }                                                                  \
            const TYPE mapped = CLOSURE_CALL(mapper, self->storage.value);     \
            return MODULE_FUNC(Result, SUFFIX, Ok)(outResult, mapped);   \
          }),                                                                  \
                                                                               \
      CONST_OPERATION_INLINE(                                                  \
          AndThen,                                                             \
          (MODULE_CLOSURE(Result, SUFFIX, BindFunction) binder,          \
           struct MODULE_TYPED(Result, SUFFIX) * outResult),             \
          {                                                                    \
            if (!self || !outResult || !CLOSURE_IS_VALID(binder)) {            \
              return STATUS_CONST(INVALID_ARGUMENT);                           \
            }                                                                  \
            if (!self->isOk) {                                                 \
              return MODULE_FUNC(Result, SUFFIX, Err)(                   \
                  outResult, &self->storage.error);                            \
            }                                                                  \
            MODULE_FUNC(Result, SUFFIX, Init)(outResult);                \
            return CLOSURE_CALL(binder, self->storage.value, outResult);       \
          })                                                                   \
  )
#endif

/* Mode 2 (Direct Include): Auto-instantiates and cleans up environment */
#if (!defined(COSMERON_INTERNAL_NO_AUTO_INSTANTIATE) && !defined(COSMERON_INTERNAL_IN_COMMON_INC)) && defined(SUFFIX) && defined(TYPE)
  TEMPLATE_Result(SUFFIX, TYPE);
  #undef SUFFIX
  #undef TYPE
#endif
