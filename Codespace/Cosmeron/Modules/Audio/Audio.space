#pragma once

#include "../../Core/Error/Status.h"
#include "../../Core/Namespace.h"
#include <float.h>
#include <stdbool.h>
#include <stddef.h>
#include <stdint.h>
#include <stdlib.h>
#include <string.h>

#define AUDIO_MOD Audio
#define AUDIO_CMOD AUDIO
#define AUDIO_NS(NAME) GNS2(LIB_PREFIX(AUDIO_MOD), NAME)
#define AUDIO_CNS(NAME) CNS2(LIB_PREFIX_CONST(AUDIO_CMOD), NAME)
#define AUDIO_INS(NAME) GNS3(LIB_PREFIX(AUDIO_MOD), Internal, NAME)
#define AUDIO_CINS(NAME) CNS3(LIB_PREFIX_CONST(AUDIO_CMOD), INTERNAL, NAME)
#define AUDIO_TYPE(NAME) AUDIO_NS(NAME)
#define AUDIO_FUNC(NAME) AUDIO_NS(NAME)
#define AUDIO_CONST(NAME) AUDIO_CNS(NAME)

enum {
  AUDIO_CONST(DEFAULT_SAMPLE_RATE) = 48000,
  AUDIO_CONST(MAX_SAMPLE_RATE) = 384000,
  AUDIO_CONST(MAX_CHANNELS) = 8,
  AUDIO_CONST(MONO) = 1,
  AUDIO_CONST(STEREO) = 2,
  AUDIO_CONST(DEFAULT_BPM) = 120,
  AUDIO_CONST(DEFAULT_OCTAVE) = 4,
  AUDIO_CONST(TICKS_PER_QUARTER) = 960,
  AUDIO_CONST(MIDI_NOTE_COUNT) = 128,
  AUDIO_CONST(RENDER_BLOCK_FRAMES) = 512
};

static inline bool AUDIO_INS(Finite)(double value) {
  return value >= -DBL_MAX && value <= DBL_MAX;
}
static inline bool AUDIO_INS(ValidFormat)(uint32_t rate, uint32_t channels) {
  return rate > 0 && rate <= AUDIO_CONST(MAX_SAMPLE_RATE) && channels > 0 &&
         channels <= AUDIO_CONST(MAX_CHANNELS);
}
static inline float AUDIO_INS(Clamp)(float value) {
  return value < -1.0f ? -1.0f : (value > 1.0f ? 1.0f : value);
}

