/* Implementation included by Codec.h. */

typedef struct AUDIO_INS(Decoder) {
  cosmeron_audio_vendor_ma_decoder native;
  AUDIO_CODEC_TYPE(TReader) reader;
  AUDIO_INS(TWAVView) wav;
  uint64_t wavCursor, wavDataOffset;
  FILE *ownedFile;
  bool nativeWav, wavStreaming;
} AUDIO_INS(Decoder);

#include "WAVReader.inc"
static cosmeron_audio_vendor_ma_result
AUDIO_INS(DecoderRead)(cosmeron_audio_vendor_ma_decoder *decoder, void *buffer,
                       size_t capacity, size_t *outCount) {
  AUDIO_INS(Decoder) *value = (AUDIO_INS(Decoder) *)decoder->pUserData;
  size_t count = 0;
  OPSTATUS result =
      value->reader.read(value->reader.userData, buffer, capacity, &count);
  if (count > capacity)
    return cosmeron_audio_vendor_MA_INVALID_DATA;
  *outCount = count;
  if (result != STATUS_CONST(SUCCESS))
    return cosmeron_audio_vendor_MA_IO_ERROR;
  return count == 0 ? cosmeron_audio_vendor_MA_AT_END
                    : cosmeron_audio_vendor_MA_SUCCESS;
}
static cosmeron_audio_vendor_ma_result
AUDIO_INS(DecoderSeek)(cosmeron_audio_vendor_ma_decoder *decoder,
                       cosmeron_audio_vendor_ma_int64 offset,
                       cosmeron_audio_vendor_ma_seek_origin origin) {
  AUDIO_INS(Decoder) *value = (AUDIO_INS(Decoder) *)decoder->pUserData;
  AUDIO_CODEC_TYPE(TSeekOrigin) mapped;
  switch (origin) {
  case cosmeron_audio_vendor_ma_seek_origin_start:
    mapped = AUDIO_CODEC_CONST(SEEK_START);
    break;
  case cosmeron_audio_vendor_ma_seek_origin_current:
    mapped = AUDIO_CODEC_CONST(SEEK_CURRENT);
    break;
  case cosmeron_audio_vendor_ma_seek_origin_end:
    mapped = AUDIO_CODEC_CONST(SEEK_END);
    break;
  default:
    return cosmeron_audio_vendor_MA_INVALID_ARGS;
  }
  return value->reader.seek(value->reader.userData, offset, mapped) ==
                 STATUS_CONST(SUCCESS)
             ? cosmeron_audio_vendor_MA_SUCCESS
             : cosmeron_audio_vendor_MA_BAD_SEEK;
}
AUDIO_CODEC_OPEN_FILE_PROTOTYPE {
  AUDIO_INS(Decoder) * value;
  cosmeron_audio_vendor_ma_result result;
  cosmeron_audio_vendor_ma_decoder_config config;
  if (decoder == NULL || path == NULL)
    return STATUS_CONST(INVALID_ARGUMENT);
  if (decoder->internal != NULL)
    return STATUS_CONST(BUSY);
  {
    FILE *file = fopen(path, "rb");
    if (file) {
      AUDIO_CODEC_TYPE(TReader) reader;
      AUDIO_INS(TWAVView) wav = {0};
      uint64_t dataOffset = 0;
      OPSTATUS status;
      reader.userData = file;
      reader.read = AUDIO_INS(WAV_FileRead);
      reader.seek = AUDIO_INS(WAV_FileSeek);
      status = AUDIO_INS(WAV_ParseReader)(&reader, &wav, &dataOffset);
      if (status == STATUS_CONST(SUCCESS)) {
        value = (AUDIO_INS(Decoder) *)calloc(1, sizeof(*value));
        if (!value) { fclose(file); return STATUS_CONST(OUT_OF_MEMORY); }
        value->reader = reader;
        value->wav = wav;
        value->wavDataOffset = dataOffset;
        value->ownedFile = file;
        value->nativeWav = true;
        value->wavStreaming = true;
        decoder->internal = value;
        return STATUS_CONST(SUCCESS);
      }
      fclose(file);
      if (status != STATUS_CONST(NOT_SUPPORTED) &&
          status != STATUS_CONST(OUT_OF_RANGE))
        return status;
    }
  }
  if (!AUDIO_INS(PrepareMath)())
    return STATUS_CONST(NOT_AVAILABLE);
  value = (AUDIO_INS(Decoder) *)calloc(1, sizeof(*value));
  if (value == NULL)
    return STATUS_CONST(OUT_OF_MEMORY);
  config = cosmeron_audio_vendor_ma_decoder_config_init(
      cosmeron_audio_vendor_ma_format_f32, 0, 0);
  result =
      cosmeron_audio_vendor_ma_decoder_init_file(path, &config, &value->native);
  if (result != cosmeron_audio_vendor_MA_SUCCESS) {
    free(value);
    return AUDIO_INS(BackendStatus)(result);
  }
  decoder->internal = value;
  return STATUS_CONST(SUCCESS);
}

AUDIO_CODEC_OPEN_MEMORY_PROTOTYPE {
  AUDIO_INS(Decoder) * value;
  cosmeron_audio_vendor_ma_result result;
  cosmeron_audio_vendor_ma_decoder_config config;
  if (decoder == NULL || data == NULL || size == 0)
    return STATUS_CONST(INVALID_ARGUMENT);
  if (decoder->internal != NULL)
    return STATUS_CONST(BUSY);
  if (size >= 12 && !memcmp(data, "RIFF", 4) &&
      !memcmp((const unsigned char *)data + 8, "WAVE", 4)) {
    AUDIO_INS(TWAVView) view;
    OPSTATUS status = AUDIO_INS(WAV_Parse)(data, size, &view);
    if (status != STATUS_CONST(SUCCESS)) return status;
    value = (AUDIO_INS(Decoder) *)calloc(1, sizeof(*value));
    if (!value) return STATUS_CONST(OUT_OF_MEMORY);
    value->nativeWav = true;
    value->wav = view;
    decoder->internal = value;
    return STATUS_CONST(SUCCESS);
  }
  if (!AUDIO_INS(PrepareMath)())
    return STATUS_CONST(NOT_AVAILABLE);
  value = (AUDIO_INS(Decoder) *)calloc(1, sizeof(*value));
  if (value == NULL)
    return STATUS_CONST(OUT_OF_MEMORY);
  config = cosmeron_audio_vendor_ma_decoder_config_init(
      cosmeron_audio_vendor_ma_format_f32, 0, 0);
  result = cosmeron_audio_vendor_ma_decoder_init_memory(data, size, &config,
                                                        &value->native);
  if (result != cosmeron_audio_vendor_MA_SUCCESS) {
    free(value);
    return AUDIO_INS(BackendStatus)(result);
  }
  decoder->internal = value;
  return STATUS_CONST(SUCCESS);
}

AUDIO_CODEC_OPEN_READER_PROTOTYPE {
  AUDIO_INS(Decoder) * value;
  cosmeron_audio_vendor_ma_result result;
  cosmeron_audio_vendor_ma_decoder_config config;
  if (decoder == NULL || reader == NULL || reader->read == NULL ||
      reader->seek == NULL)
    return STATUS_CONST(INVALID_ARGUMENT);
  if (decoder->internal != NULL)
    return STATUS_CONST(BUSY);
  {
    AUDIO_INS(TWAVView) wav = {0};
    uint64_t offset = 0;
    OPSTATUS status = AUDIO_INS(WAV_ParseReader)(reader, &wav, &offset);
    if (status == STATUS_CONST(SUCCESS)) {
      value = (AUDIO_INS(Decoder) *)calloc(1, sizeof(*value));
      if (!value) return STATUS_CONST(OUT_OF_MEMORY);
      value->reader = *reader;
      value->wav = wav;
      value->wavDataOffset = offset;
      value->nativeWav = true;
      value->wavStreaming = true;
      decoder->internal = value;
      return STATUS_CONST(SUCCESS);
    }
    if (status != STATUS_CONST(NOT_SUPPORTED))
      return status;
    status = reader->seek(reader->userData, 0, AUDIO_CODEC_CONST(SEEK_START));
    if (status != STATUS_CONST(SUCCESS)) return status;
  }
  if (!AUDIO_INS(PrepareMath)())
    return STATUS_CONST(NOT_AVAILABLE);
  value = (AUDIO_INS(Decoder) *)calloc(1, sizeof(*value));
  if (value == NULL)
    return STATUS_CONST(OUT_OF_MEMORY);
  value->reader = *reader;
  config = cosmeron_audio_vendor_ma_decoder_config_init(
      cosmeron_audio_vendor_ma_format_f32, 0, 0);
  result = cosmeron_audio_vendor_ma_decoder_init(AUDIO_INS(DecoderRead),
                                                 AUDIO_INS(DecoderSeek), value,
                                                 &config, &value->native);
  if (result != cosmeron_audio_vendor_MA_SUCCESS) {
    free(value);
    return AUDIO_INS(BackendStatus)(result);
  }
  decoder->internal = value;
  return STATUS_CONST(SUCCESS);
}

AUDIO_CODEC_GET_INFO_PROTOTYPE {
  AUDIO_INS(Decoder) * value;
  AUDIO_CODEC_TYPE(TInfo) info = {0};
  cosmeron_audio_vendor_ma_uint64 length = 0;
  if (decoder == NULL || decoder->internal == NULL || outInfo == NULL)
    return STATUS_CONST(INVALID_ARGUMENT);
  value = (AUDIO_INS(Decoder) *)decoder->internal;
  if (value->nativeWav) {
    info.channels = value->wav.channels;
    info.sampleRate = value->wav.sampleRate;
    info.frameCount = value->wav.frameCount;
    info.lengthKnown = true;
    *outInfo = info;
    return STATUS_CONST(SUCCESS);
  }
  info.channels = value->native.outputChannels;
  info.sampleRate = value->native.outputSampleRate;
  info.lengthKnown =
      cosmeron_audio_vendor_ma_decoder_get_length_in_pcm_frames(
          &value->native, &length) == cosmeron_audio_vendor_MA_SUCCESS;
  info.frameCount = length;
  *outInfo = info;
  return STATUS_CONST(SUCCESS);
}

AUDIO_CODEC_READ_FRAMES_PROTOTYPE {
  AUDIO_INS(Decoder) * value;
  cosmeron_audio_vendor_ma_uint64 count = 0;
  cosmeron_audio_vendor_ma_result result;
  if (decoder == NULL || decoder->internal == NULL || outSamples == NULL ||
      outFrames == NULL)
    return STATUS_CONST(INVALID_ARGUMENT);
  value = (AUDIO_INS(Decoder) *)decoder->internal;
  if (value->nativeWav) {
    size_t frames = 0;
    OPSTATUS status = value->wavStreaming ?
        AUDIO_INS(WAV_StreamFrames)(value, outSamples, frameCapacity, &frames) :
        AUDIO_INS(WAV_ReadRange)(&value->wav, value->wavCursor,
                                outSamples, frameCapacity, &frames);
    if (status == STATUS_CONST(SUCCESS) && !value->wavStreaming)
      value->wavCursor += frames;
    *outFrames = frames;
    return status;
  }
  if (value->native.outputChannels == 0 ||
      frameCapacity > SIZE_MAX / value->native.outputChannels / sizeof(float))
    return STATUS_CONST(ARITHMETIC_OVERFLOW);
  if (frameCapacity == 0) {
    *outFrames = 0;
    return STATUS_CONST(SUCCESS);
  }
  result = cosmeron_audio_vendor_ma_decoder_read_pcm_frames(
      &value->native, outSamples, frameCapacity, &count);
  /* Streaming exception: partial PCM and its count are exposed even on error.
   */
  *outFrames = (size_t)count;
  if (result == cosmeron_audio_vendor_MA_AT_END)
    return STATUS_CONST(SUCCESS);
  return AUDIO_INS(BackendStatus)(result);
}

AUDIO_CODEC_SEEK_FRAME_PROTOTYPE {
  AUDIO_INS(Decoder) * value;
  if (decoder == NULL || decoder->internal == NULL)
    return STATUS_CONST(INVALID_ARGUMENT);
  value = (AUDIO_INS(Decoder) *)decoder->internal;
  if (value->nativeWav) {
    if (frameIndex > value->wav.frameCount)
      return STATUS_CONST(OUT_OF_RANGE);
    value->wavCursor = frameIndex;
    return STATUS_CONST(SUCCESS);
  }
  return AUDIO_INS(BackendStatus)(
      cosmeron_audio_vendor_ma_decoder_seek_to_pcm_frame(&value->native,
                                                         frameIndex));
}

AUDIO_CODEC_CLOSE_PROTOTYPE {
  if (decoder != NULL && decoder->internal != NULL) {
    AUDIO_INS(Decoder) *value = (AUDIO_INS(Decoder) *)decoder->internal;
    decoder->internal = NULL;
    if (!value->nativeWav)
      cosmeron_audio_vendor_ma_decoder_uninit(&value->native);
    if (value->ownedFile) fclose(value->ownedFile);
    free(value);
  }
}

AUDIO_CODEC_WRITE_WAV_PROTOTYPE {
  return AUDIO_CODEC_FUNC(WAV_WriteFile)(path, buffer);
}
