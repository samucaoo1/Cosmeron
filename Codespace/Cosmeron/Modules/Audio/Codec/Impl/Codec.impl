/* Implementation included by Codec.h. */
#include "FLACFrame.inc"

typedef struct AUDIO_INS(TFLACSeekPoint) { uint64_t frame; size_t byte; } AUDIO_INS(TFLACSeekPoint);

typedef struct AUDIO_INS(Decoder) {
#if !defined(AUDIO_CODEC_NATIVE_ONLY)
  cosmeron_audio_vendor_ma_decoder native;
#endif
  AUDIO_CODEC_TYPE(TReader) reader;
  AUDIO_INS(TWAVView) wav;
  uint64_t wavCursor, wavDataOffset;
  FILE *ownedFile;
  bool nativeWav, wavStreaming, nativeFlac, flacStreaming;
#if defined(AUDIO_CODEC_EXPERIMENTAL_NATIVE_MP3)
  bool nativeMp3Streaming;
  struct AUDIO_INS(TMP3ReaderStream) *mp3Stream;
#endif
#if defined(AUDIO_CODEC_EXPERIMENTAL_NATIVE_MP3)
  bool nativeMp3;
  AUDIO_CODEC_TYPE(TMP3Memory) mp3;
#endif
  AUDIO_INS(TFLACStreamInfo) flac;
  const unsigned char *flacBytes;
  size_t flacSize, flacOffset, flacBlockFrames, flacBlockOffset;
  uint64_t flacCursor;
  AUDIO_INS(TFLACMD5) *flacDigest;
  float *flacBlock;
  unsigned char *flacEncoded;
  size_t flacEncodedCapacity;
  AUDIO_INS(TFLACSeekPoint) *flacIndex;
  size_t flacIndexCount, flacIndexCapacity;
} AUDIO_INS(Decoder);

/* Lazy frame index shared by memory and seekable readers. No PCM is retained.
 * A bounded index is optional: allocation failure never interrupts decoding. */
static inline void AUDIO_INS(FLAC_Remember)(AUDIO_INS(Decoder) *s) {
  AUDIO_INS(TFLACSeekPoint) *index;
  size_t n = s->flacIndexCount;
  if (n && s->flacIndex[n-1].frame >= s->flacCursor) return;
  if (n >= 65536) return;
  if (n == s->flacIndexCapacity) {
    size_t capacity = s->flacIndexCapacity ? s->flacIndexCapacity * 2 : 64;
    index = (AUDIO_INS(TFLACSeekPoint) *)realloc(s->flacIndex, capacity * sizeof *index);
    if (!index) return;
    s->flacIndex = index;
    s->flacIndexCapacity = capacity;
  }
  s->flacIndex[n].frame = s->flacCursor;
  s->flacIndex[n].byte = s->flacOffset;
  ++s->flacIndexCount;
}
#include "WAVReader.inc"
#include "FLACReader.inc"
#if defined(AUDIO_CODEC_EXPERIMENTAL_NATIVE_MP3)
#include "MP3Reader.inc"
#endif
#if !defined(AUDIO_CODEC_NATIVE_ONLY)
static cosmeron_audio_vendor_ma_result
AUDIO_INS(DecoderRead)(cosmeron_audio_vendor_ma_decoder *decoder, void *buffer,
                       size_t capacity, size_t *outCount) {
  AUDIO_INS(Decoder) *value = (AUDIO_INS(Decoder) *)decoder->pUserData;
  size_t count = 0;
  OPSTATUS result =
      value->reader.read(value->reader.userData, buffer, capacity, &count);
  if (count > capacity)
    return cosmeron_audio_vendor_MA_INVALID_DATA;
  *outCount = count;
  if (result != STATUS_CONST(SUCCESS))
    return cosmeron_audio_vendor_MA_IO_ERROR;
  return count == 0 ? cosmeron_audio_vendor_MA_AT_END
                    : cosmeron_audio_vendor_MA_SUCCESS;
}
static cosmeron_audio_vendor_ma_result
AUDIO_INS(DecoderSeek)(cosmeron_audio_vendor_ma_decoder *decoder,
                       cosmeron_audio_vendor_ma_int64 offset,
                       cosmeron_audio_vendor_ma_seek_origin origin) {
  AUDIO_INS(Decoder) *value = (AUDIO_INS(Decoder) *)decoder->pUserData;
  AUDIO_CODEC_TYPE(TSeekOrigin) mapped;
  switch (origin) {
  case cosmeron_audio_vendor_ma_seek_origin_start:
    mapped = AUDIO_CODEC_CONST(SEEK_START);
    break;
  case cosmeron_audio_vendor_ma_seek_origin_current:
    mapped = AUDIO_CODEC_CONST(SEEK_CURRENT);
    break;
  case cosmeron_audio_vendor_ma_seek_origin_end:
    mapped = AUDIO_CODEC_CONST(SEEK_END);
    break;
  default:
    return cosmeron_audio_vendor_MA_INVALID_ARGS;
  }
  return value->reader.seek(value->reader.userData, offset, mapped) ==
                 STATUS_CONST(SUCCESS)
             ? cosmeron_audio_vendor_MA_SUCCESS
             : cosmeron_audio_vendor_MA_BAD_SEEK;
}
#endif
AUDIO_CODEC_OPEN_FILE_PROTOTYPE {
  AUDIO_INS(Decoder) * value;
#if !defined(AUDIO_CODEC_NATIVE_ONLY)
  cosmeron_audio_vendor_ma_result result;
  cosmeron_audio_vendor_ma_decoder_config config;
#endif
  if (decoder == NULL || path == NULL)
    return STATUS_CONST(INVALID_ARGUMENT);
  if (decoder->internal != NULL)
    return STATUS_CONST(BUSY);
  {
    FILE *file = fopen(path, "rb");
    if (file) {
      AUDIO_CODEC_TYPE(TReader) reader;
      AUDIO_INS(TWAVView) wav = {0};
      uint64_t dataOffset = 0;
      OPSTATUS status;
      reader.userData = file;
      reader.read = AUDIO_INS(WAV_FileRead);
      reader.seek = AUDIO_INS(WAV_FileSeek);
      status = AUDIO_INS(WAV_ParseReader)(&reader, &wav, &dataOffset);
      if (status == STATUS_CONST(SUCCESS)) {
        value = (AUDIO_INS(Decoder) *)calloc(1, sizeof(*value));
        if (!value) { fclose(file); return STATUS_CONST(OUT_OF_MEMORY); }
        value->reader = reader;
        value->wav = wav;
        value->wavDataOffset = dataOffset;
        value->ownedFile = file;
        value->nativeWav = true;
        value->wavStreaming = true;
        decoder->internal = value;
        return STATUS_CONST(SUCCESS);
      }
      if (status == STATUS_CONST(NOT_SUPPORTED)) {
        AUDIO_INS(TFLACStreamInfo) flac = {0};
        status = AUDIO_INS(FLAC_ParseReader)(&reader, &flac);
        if (status == STATUS_CONST(SUCCESS)) {
          OPSTATUS opened = AUDIO_INS(FLAC_OpenReader)(
              decoder, &reader, &flac, file);
          if (opened == STATUS_CONST(SUCCESS)) return opened;
          fclose(file);
          return opened;
        }
      }
#if defined(AUDIO_CODEC_EXPERIMENTAL_NATIVE_MP3)
      if (status == STATUS_CONST(NOT_SUPPORTED)) {
        status = AUDIO_INS(MP3_ReaderOpen)(decoder, &reader, file);
        if (status == STATUS_CONST(SUCCESS)) return status;
      }
#endif
      fclose(file);
      if (status != STATUS_CONST(NOT_SUPPORTED) &&
          status != STATUS_CONST(OUT_OF_RANGE))
        return status;
    }
  }
#if !defined(AUDIO_CODEC_NATIVE_ONLY)
  if (!AUDIO_INS(PrepareMath)())
    return STATUS_CONST(NOT_AVAILABLE);
  value = (AUDIO_INS(Decoder) *)calloc(1, sizeof(*value));
  if (value == NULL)
    return STATUS_CONST(OUT_OF_MEMORY);
  config = cosmeron_audio_vendor_ma_decoder_config_init(
      cosmeron_audio_vendor_ma_format_f32, 0, 0);
  result =
      cosmeron_audio_vendor_ma_decoder_init_file(path, &config, &value->native);
  if (result != cosmeron_audio_vendor_MA_SUCCESS) {
    free(value);
    return AUDIO_INS(BackendStatus)(result);
  }
  decoder->internal = value;
  return STATUS_CONST(SUCCESS);
#else
  return STATUS_CONST(NOT_SUPPORTED);
#endif
}

AUDIO_CODEC_OPEN_MEMORY_PROTOTYPE {
  AUDIO_INS(Decoder) * value;
#if !defined(AUDIO_CODEC_NATIVE_ONLY)
  cosmeron_audio_vendor_ma_result result;
  cosmeron_audio_vendor_ma_decoder_config config;
#endif
  if (decoder == NULL || data == NULL || size == 0)
    return STATUS_CONST(INVALID_ARGUMENT);
  if (decoder->internal != NULL)
    return STATUS_CONST(BUSY);
  if (size >= 12 && !memcmp(data, "RIFF", 4) &&
      !memcmp((const unsigned char *)data + 8, "WAVE", 4)) {
    AUDIO_INS(TWAVView) view;
    OPSTATUS status = AUDIO_INS(WAV_Parse)(data, size, &view);
    if (status != STATUS_CONST(SUCCESS)) return status;
    value = (AUDIO_INS(Decoder) *)calloc(1, sizeof(*value));
    if (!value) return STATUS_CONST(OUT_OF_MEMORY);
    value->nativeWav = true;
    value->wav = view;
    decoder->internal = value;
    return STATUS_CONST(SUCCESS);
  }
  if (size >= 4 && !memcmp(data, "fLaC", 4)) {
    AUDIO_INS(TFLACStreamInfo) info = {0};
    OPSTATUS status = AUDIO_INS(FLAC_ParseMetadata)(data, size, &info);
    if (status == STATUS_CONST(SUCCESS)) {
      size_t sampleCapacity;
      if (info.maximumBlockSize > SIZE_MAX / info.channels / sizeof(float))
        return STATUS_CONST(ARITHMETIC_OVERFLOW);
      sampleCapacity = info.maximumBlockSize * info.channels;
      value = (AUDIO_INS(Decoder) *)calloc(1, sizeof(*value));
      if (!value) return STATUS_CONST(OUT_OF_MEMORY);
      value->flacBlock = (float *)malloc(sampleCapacity * sizeof(float));
      if (!value->flacBlock) {
        free(value);
        return STATUS_CONST(OUT_OF_MEMORY);
      }
      value->nativeFlac = true;
      value->flac = info;
      value->flacBytes = (const unsigned char *)data;
      value->flacSize = size;
      value->flacOffset = info.frameOffset;
      decoder->internal = value;
      return STATUS_CONST(SUCCESS);
    }
    if (status != STATUS_CONST(NOT_SUPPORTED)) return status;
  }
#if defined(AUDIO_CODEC_EXPERIMENTAL_NATIVE_MP3)
  /* Opt-in whole-memory MP3 stream: borrow the caller's buffer exactly
   * like native memory WAV/FLAC. Do not alter file/reader defaults. */
  {
    size_t mp3Start = 0;
    AUDIO_CODEC_TYPE(TMP3FrameInfo) first;
    OPSTATUS detected = AUDIO_CODEC_FUNC(MP3_FindFrame)(
        data, size, 0, &mp3Start, &first);
    /* A recognized ID3v2 prefix must not bypass native validation by
     * silently falling through to the vendor decoder on malformed tags. */
    if (size >= 3 && !memcmp(data, "ID3", 3) &&
        detected != STATUS_CONST(SUCCESS) &&
        detected != STATUS_CONST(NOT_FOUND))
      return detected;
    if (detected == STATUS_CONST(SUCCESS)) {
      AUDIO_CODEC_TYPE(TMP3Memory) stream = {0};
      OPSTATUS status = AUDIO_CODEC_FUNC(MP3_MemoryOpen)(
          &stream, data, size);
      if (status != STATUS_CONST(SUCCESS)) return status;
      value = (AUDIO_INS(Decoder) *)calloc(1, sizeof(*value));
      if (!value) {
        AUDIO_CODEC_FUNC(MP3_MemoryClose)(&stream);
        return STATUS_CONST(OUT_OF_MEMORY);
      }
      value->mp3 = stream;
      value->nativeMp3 = true;
      decoder->internal = value;
      return STATUS_CONST(SUCCESS);
    }
  }
#endif
#if !defined(AUDIO_CODEC_NATIVE_ONLY)
  if (!AUDIO_INS(PrepareMath)())
    return STATUS_CONST(NOT_AVAILABLE);
  value = (AUDIO_INS(Decoder) *)calloc(1, sizeof(*value));
  if (value == NULL)
    return STATUS_CONST(OUT_OF_MEMORY);
  config = cosmeron_audio_vendor_ma_decoder_config_init(
      cosmeron_audio_vendor_ma_format_f32, 0, 0);
  result = cosmeron_audio_vendor_ma_decoder_init_memory(data, size, &config,
                                                        &value->native);
  if (result != cosmeron_audio_vendor_MA_SUCCESS) {
    free(value);
    return AUDIO_INS(BackendStatus)(result);
  }
  decoder->internal = value;
  return STATUS_CONST(SUCCESS);
#else
  return STATUS_CONST(NOT_SUPPORTED);
#endif
}

AUDIO_CODEC_OPEN_READER_PROTOTYPE {
  AUDIO_INS(Decoder) * value;
#if !defined(AUDIO_CODEC_NATIVE_ONLY)
  cosmeron_audio_vendor_ma_result result;
  cosmeron_audio_vendor_ma_decoder_config config;
#endif
  if (decoder == NULL || reader == NULL || reader->read == NULL)
    return STATUS_CONST(INVALID_ARGUMENT);
  if (decoder->internal != NULL)
    return STATUS_CONST(BUSY);
#if defined(AUDIO_CODEC_EXPERIMENTAL_NATIVE_MP3)
  if (!reader->seek) return AUDIO_INS(MP3_SequentialOpen)(decoder, reader);
#else
  if (!reader->seek) return STATUS_CONST(NOT_SUPPORTED);
#endif
  {
    AUDIO_INS(TWAVView) wav = {0};
    uint64_t offset = 0;
    OPSTATUS status = AUDIO_INS(WAV_ParseReader)(reader, &wav, &offset);
    if (status == STATUS_CONST(SUCCESS)) {
      value = (AUDIO_INS(Decoder) *)calloc(1, sizeof(*value));
      if (!value) return STATUS_CONST(OUT_OF_MEMORY);
      value->reader = *reader;
      value->wav = wav;
      value->wavDataOffset = offset;
      value->nativeWav = true;
      value->wavStreaming = true;
      decoder->internal = value;
      return STATUS_CONST(SUCCESS);
    }
    if (status == STATUS_CONST(NOT_SUPPORTED)) {
      AUDIO_INS(TFLACStreamInfo) flac = {0};
      status = AUDIO_INS(FLAC_ParseReader)(reader, &flac);
      if (status == STATUS_CONST(SUCCESS))
        return AUDIO_INS(FLAC_OpenReader)(decoder, reader, &flac, NULL);
    }
    if (status != STATUS_CONST(NOT_SUPPORTED))
      return status;
#if defined(AUDIO_CODEC_EXPERIMENTAL_NATIVE_MP3)
    status = AUDIO_INS(MP3_ReaderOpen)(decoder, reader, NULL);
    if (status == STATUS_CONST(SUCCESS)) return status;
    if (status != STATUS_CONST(NOT_SUPPORTED)) return status;
#endif
    status = reader->seek(reader->userData, 0, AUDIO_CODEC_CONST(SEEK_START));
    if (status != STATUS_CONST(SUCCESS)) return status;
  }
#if !defined(AUDIO_CODEC_NATIVE_ONLY)
  if (!AUDIO_INS(PrepareMath)())
    return STATUS_CONST(NOT_AVAILABLE);
  value = (AUDIO_INS(Decoder) *)calloc(1, sizeof(*value));
  if (value == NULL)
    return STATUS_CONST(OUT_OF_MEMORY);
  value->reader = *reader;
  config = cosmeron_audio_vendor_ma_decoder_config_init(
      cosmeron_audio_vendor_ma_format_f32, 0, 0);
  result = cosmeron_audio_vendor_ma_decoder_init(AUDIO_INS(DecoderRead),
                                                 AUDIO_INS(DecoderSeek), value,
                                                 &config, &value->native);
  if (result != cosmeron_audio_vendor_MA_SUCCESS) {
    free(value);
    return AUDIO_INS(BackendStatus)(result);
  }
  decoder->internal = value;
  return STATUS_CONST(SUCCESS);
#else
  return STATUS_CONST(NOT_SUPPORTED);
#endif
}

AUDIO_CODEC_GET_INFO_PROTOTYPE {
  AUDIO_INS(Decoder) * value;
  AUDIO_CODEC_TYPE(TInfo) info = {0};
#if !defined(AUDIO_CODEC_NATIVE_ONLY)
  cosmeron_audio_vendor_ma_uint64 length = 0;
#endif
  if (decoder == NULL || decoder->internal == NULL || outInfo == NULL)
    return STATUS_CONST(INVALID_ARGUMENT);
  value = (AUDIO_INS(Decoder) *)decoder->internal;
#if defined(AUDIO_CODEC_EXPERIMENTAL_NATIVE_MP3)
  if (value->nativeMp3Streaming) {
    info.sampleRate = value->mp3Stream->rate;
    info.channels = value->mp3Stream->channels;
    info.lengthKnown = value->mp3Stream->lengthKnown;
    info.frameCount = info.lengthKnown ? value->mp3Stream->frameCount : 0;
    *outInfo = info;
    return STATUS_CONST(SUCCESS);
  }
  if (value->nativeMp3) {
    OPSTATUS status = AUDIO_CODEC_FUNC(MP3_MemoryInfo)(
        &value->mp3, &info.sampleRate, &info.channels, &info.frameCount);
    if (status != STATUS_CONST(SUCCESS)) return status;
    info.lengthKnown = true;
    *outInfo = info;
    return STATUS_CONST(SUCCESS);
  }
#endif
  if (value->nativeFlac) {
    info.channels = value->flac.channels;
    info.sampleRate = value->flac.sampleRate;
    info.frameCount = value->flac.totalSamples;
    info.lengthKnown = value->flac.totalSamples != 0;
    *outInfo = info;
    return STATUS_CONST(SUCCESS);
  }
  if (value->nativeWav) {
    info.channels = value->wav.channels;
    info.sampleRate = value->wav.sampleRate;
    info.frameCount = value->wav.frameCount;
    info.lengthKnown = true;
    *outInfo = info;
    return STATUS_CONST(SUCCESS);
  }
#if !defined(AUDIO_CODEC_NATIVE_ONLY)
  info.channels = value->native.outputChannels;
  info.sampleRate = value->native.outputSampleRate;
  info.lengthKnown =
      cosmeron_audio_vendor_ma_decoder_get_length_in_pcm_frames(
          &value->native, &length) == cosmeron_audio_vendor_MA_SUCCESS;
  info.frameCount = length;
  *outInfo = info;
  return STATUS_CONST(SUCCESS);
#else
  return STATUS_CONST(NOT_SUPPORTED);
#endif
}

AUDIO_CODEC_READ_FRAMES_PROTOTYPE {
  AUDIO_INS(Decoder) * value;
#if !defined(AUDIO_CODEC_NATIVE_ONLY)
  cosmeron_audio_vendor_ma_uint64 count = 0;
  cosmeron_audio_vendor_ma_result result;
#endif
  if (decoder == NULL || decoder->internal == NULL || outSamples == NULL ||
      outFrames == NULL)
    return STATUS_CONST(INVALID_ARGUMENT);
  value = (AUDIO_INS(Decoder) *)decoder->internal;
#if defined(AUDIO_CODEC_EXPERIMENTAL_NATIVE_MP3)
  if (value->nativeMp3Streaming)
    return AUDIO_INS(MP3_ReaderConsume)(
        &value->reader, value->mp3Stream,
        outSamples, frameCapacity, outFrames);
  if (value->nativeMp3)
    return AUDIO_CODEC_FUNC(MP3_MemoryRead)(
        &value->mp3, outSamples, frameCapacity, outFrames);
#endif
  if (value->nativeWav) {
    size_t frames = 0;
    OPSTATUS status = value->wavStreaming ?
        AUDIO_INS(WAV_StreamFrames)(value, outSamples, frameCapacity, &frames) :
        AUDIO_INS(WAV_ReadRange)(&value->wav, value->wavCursor,
                                outSamples, frameCapacity, &frames);
    if (status == STATUS_CONST(SUCCESS) && !value->wavStreaming)
      value->wavCursor += frames;
    *outFrames = frames;
    return status;
  }
  if (value->nativeFlac) {
    size_t completed = 0;
    if (frameCapacity > SIZE_MAX / value->flac.channels / sizeof(float))
      return STATUS_CONST(ARITHMETIC_OVERFLOW);
    while (completed < frameCapacity) {
      size_t n;
      if (value->flac.totalSamples && value->flacCursor >= value->flac.totalSamples)
        break;
      if (value->flacBlockOffset == value->flacBlockFrames) {
        size_t frames = 0, next = 0;
        OPSTATUS status;
        AUDIO_INS(FLAC_Remember)(value);
        if (value->flacStreaming) {
          status = AUDIO_INS(FLAC_StreamNextFrame)(value, &frames);
          if (status == STATUS_CONST(SUCCESS) && !frames) {
            if (value->flac.totalSamples &&
                value->flacCursor != value->flac.totalSamples) {
              *outFrames = completed;
              return STATUS_CONST(INCOMPLETE_SEQUENCE);
            }
            break;
          }
        } else {
          if (value->flacOffset == value->flacSize) break;
          status = AUDIO_INS(FLAC_DecodeFrameDigest)(value->flacBytes,
              value->flacSize, &value->flac, value->flacOffset,
              value->flacBlock, value->flac.maximumBlockSize, &frames, &next, value->flacDigest);
        }
        if (status != STATUS_CONST(SUCCESS)) {
          *outFrames = completed;
          return status;
        }
        if (!frames || (!value->flacStreaming && next <= value->flacOffset)) {
          *outFrames = completed;
          return STATUS_CONST(INVALID_SEQUENCE);
        }
        if (!value->flacStreaming) value->flacOffset = next;
        value->flacBlockFrames = frames;
        value->flacBlockOffset = 0;
      }
      n = value->flacBlockFrames - value->flacBlockOffset;
      if (n > frameCapacity - completed) n = frameCapacity - completed;
      if (value->flac.totalSamples && n > value->flac.totalSamples - value->flacCursor)
        n = (size_t)(value->flac.totalSamples - value->flacCursor);
      if (!n) break;
      memcpy(outSamples + completed * value->flac.channels,
          value->flacBlock + value->flacBlockOffset * value->flac.channels,
          n * value->flac.channels * sizeof(float));
      value->flacBlockOffset += n;
      value->flacCursor += n;
      completed += n;
    }
    *outFrames = completed;
    return STATUS_CONST(SUCCESS);
  }
#if !defined(AUDIO_CODEC_NATIVE_ONLY)
  if (value->native.outputChannels == 0 ||
      frameCapacity > SIZE_MAX / value->native.outputChannels / sizeof(float))
    return STATUS_CONST(ARITHMETIC_OVERFLOW);
  if (frameCapacity == 0) {
    *outFrames = 0;
    return STATUS_CONST(SUCCESS);
  }
  result = cosmeron_audio_vendor_ma_decoder_read_pcm_frames(
      &value->native, outSamples, frameCapacity, &count);
  /* Streaming exception: partial PCM and its count are exposed even on error.
   */
  *outFrames = (size_t)count;
  if (result == cosmeron_audio_vendor_MA_AT_END)
    return STATUS_CONST(SUCCESS);
  return AUDIO_INS(BackendStatus)(result);
#else
  return STATUS_CONST(NOT_SUPPORTED);
#endif
}

AUDIO_CODEC_SEEK_FRAME_PROTOTYPE {
  AUDIO_INS(Decoder) * value;
  if (decoder == NULL || decoder->internal == NULL)
    return STATUS_CONST(INVALID_ARGUMENT);
  value = (AUDIO_INS(Decoder) *)decoder->internal;
#if defined(AUDIO_CODEC_EXPERIMENTAL_NATIVE_MP3)
  if (value->nativeMp3Streaming)
    return AUDIO_INS(MP3_ReaderSeek)(value, frameIndex);
  if (value->nativeMp3)
    return AUDIO_CODEC_FUNC(MP3_MemorySeek)(&value->mp3, frameIndex);
#endif
  if (value->nativeFlac) {
    if (value->flac.totalSamples && frameIndex > value->flac.totalSamples)
      return STATUS_CONST(OUT_OF_RANGE);
    if (frameIndex < value->flacCursor) {
      value->flacOffset = value->flac.frameOffset;
      value->flacCursor = 0;
      value->flacBlockFrames = 0;
      value->flacBlockOffset = 0;
    }
    if (value->flacIndexCount) {
      size_t lo = 0, hi = value->flacIndexCount;
      while (lo < hi) {
        size_t mid = lo + (hi-lo)/2;
        if (value->flacIndex[mid].frame <= frameIndex) lo = mid+1;
        else hi = mid;
      }
      if (lo && value->flacIndex[lo-1].frame > value->flacCursor) {
        value->flacCursor = value->flacIndex[lo-1].frame;
        value->flacOffset = value->flacIndex[lo-1].byte;
        value->flacBlockFrames = value->flacBlockOffset = 0;
      }
    }
    while (value->flacCursor < frameIndex) {
      size_t available, step;
      if (value->flacBlockOffset == value->flacBlockFrames) {
        size_t frames = 0, next = 0;
        OPSTATUS status;
        AUDIO_INS(FLAC_Remember)(value);
        if (value->flacStreaming) {
          status = AUDIO_INS(FLAC_StreamNextFrame)(value, &frames);
        } else {
          if (value->flacOffset == value->flacSize)
            return STATUS_CONST(OUT_OF_RANGE);
          status = AUDIO_INS(FLAC_DecodeFrameDigest)(value->flacBytes,
              value->flacSize, &value->flac, value->flacOffset,
              value->flacBlock, value->flac.maximumBlockSize, &frames, &next, value->flacDigest);
        }
        if (status != STATUS_CONST(SUCCESS)) return status;
        if (!frames || (!value->flacStreaming && next <= value->flacOffset))
          return STATUS_CONST(INVALID_SEQUENCE);
        if (!value->flacStreaming) value->flacOffset = next;
        value->flacBlockFrames = frames;
        value->flacBlockOffset = 0;
      }
      available = value->flacBlockFrames - value->flacBlockOffset;
      step = frameIndex - value->flacCursor > available ?
          available : (size_t)(frameIndex - value->flacCursor);
      value->flacBlockOffset += step;
      value->flacCursor += step;
    }
    return STATUS_CONST(SUCCESS);
  }
  if (value->nativeWav) {
    if (frameIndex > value->wav.frameCount)
      return STATUS_CONST(OUT_OF_RANGE);
    value->wavCursor = frameIndex;
    return STATUS_CONST(SUCCESS);
  }
#if !defined(AUDIO_CODEC_NATIVE_ONLY)
  return AUDIO_INS(BackendStatus)(
      cosmeron_audio_vendor_ma_decoder_seek_to_pcm_frame(&value->native,
                                                         frameIndex));
#else
  return STATUS_CONST(NOT_SUPPORTED);
#endif
}

AUDIO_CODEC_CLOSE_PROTOTYPE {
  if (decoder != NULL && decoder->internal != NULL) {
    AUDIO_INS(Decoder) *value = (AUDIO_INS(Decoder) *)decoder->internal;
    decoder->internal = NULL;
#if defined(AUDIO_CODEC_EXPERIMENTAL_NATIVE_MP3)
    if (value->nativeMp3)
      AUDIO_CODEC_FUNC(MP3_MemoryClose)(&value->mp3);
    else if (value->nativeMp3Streaming) {
      AUDIO_INS(TMP3ReaderStream_Forget)(value->mp3Stream);
      free(value->mp3Stream);
    }
    else
#endif
    if (!value->nativeWav && !value->nativeFlac) {
#if !defined(AUDIO_CODEC_NATIVE_ONLY)
      cosmeron_audio_vendor_ma_decoder_uninit(&value->native);
#endif
    }
    free(value->flacIndex);
    free(value->flacBlock);
    free(value->flacEncoded);
    if (value->ownedFile) fclose(value->ownedFile);
    free(value);
  }
}

AUDIO_CODEC_WRITE_WAV_PROTOTYPE {
  return AUDIO_CODEC_FUNC(WAV_WriteFile)(path, buffer);
}

/* Explicit full-stream FLAC MD5 pass. Playback position is restored, and
 * failed verification remains observable even if restoration succeeds. */
AUDIO_CODEC_VERIFY_INTEGRITY_PROTOTYPE {
  AUDIO_INS(Decoder) *s;
  AUDIO_INS(TFLACMD5) digest;
  unsigned char actual[16], zero[16] = {0};
  float scratch[256*8];
  uint64_t saved;
  OPSTATUS status, restored;
  if (!decoder || !decoder->internal) return STATUS_CONST(INVALID_ARGUMENT);
  s = (AUDIO_INS(Decoder) *)decoder->internal;
  if (!s->nativeFlac) return STATUS_CONST(NOT_SUPPORTED);
  if (!memcmp(s->flac.md5, zero, 16)) return STATUS_CONST(NOT_AVAILABLE);
  saved = s->flacCursor;
  /* Bypass the index for a complete integrity pass. */
  s->flacOffset = s->flac.frameOffset;
  s->flacCursor = 0;
  s->flacBlockFrames = s->flacBlockOffset = 0;
  AUDIO_INS(FLAC_MD5Init)(&digest);
  s->flacDigest = &digest;
  for (;;) {
    size_t got = 0;
    status = AUDIO_CODEC_FUNC(ReadFrames)(decoder, scratch, 256, &got);
    if (status != STATUS_CONST(SUCCESS) || !got) break;
  }
  s->flacDigest = NULL;
  if (status == STATUS_CONST(SUCCESS)) {
    AUDIO_INS(FLAC_MD5Final)(&digest, actual);
    if (memcmp(actual, s->flac.md5, 16)) status = STATUS_CONST(INVALID_SEQUENCE);
  }
  s->flacOffset = s->flac.frameOffset;
  s->flacCursor = 0;
  s->flacBlockFrames = s->flacBlockOffset = 0;
  restored = AUDIO_CODEC_FUNC(SeekFrame)(decoder, saved);
  return status == STATUS_CONST(SUCCESS) ? restored : status;
}

/* Optional one-pass index preparation for workloads dominated by random
 * seeks. Normal playback also populates indices lazily. */
AUDIO_CODEC_BUILD_SEEK_INDEX_PROTOTYPE {
  AUDIO_INS(Decoder) *s;
  uint64_t saved;
  float scratch[256*8];
  OPSTATUS status, restored;
  if (!decoder || !decoder->internal) return STATUS_CONST(INVALID_ARGUMENT);
  s=(AUDIO_INS(Decoder) *)decoder->internal;
  if (s->nativeFlac) saved=s->flacCursor;
#if defined(AUDIO_CODEC_EXPERIMENTAL_NATIVE_MP3)
  else if (s->nativeMp3) saved=((AUDIO_INS(TMP3MemoryDecoder) *)s->mp3.internal)->presented;
  else if (s->nativeMp3Streaming) {
    if (s->mp3Stream->sequential) return STATUS_CONST(NOT_SUPPORTED);
    saved=s->mp3Stream->presented;
  }
#endif
  else return STATUS_CONST(NOT_SUPPORTED);
  status=AUDIO_CODEC_FUNC(SeekFrame)(decoder,0);
  if (status!=STATUS_CONST(SUCCESS)) return status;
  for (;;) {
    size_t got=0;
    status=AUDIO_CODEC_FUNC(ReadFrames)(decoder,scratch,256,&got);
    if (status!=STATUS_CONST(SUCCESS) || !got) break;
  }
  restored=AUDIO_CODEC_FUNC(SeekFrame)(decoder,saved);
  return status==STATUS_CONST(SUCCESS) ? restored : status;
}
