/* Implementation included by Device.h. */

typedef struct AUDIO_INS(Device) {
  AUDIO_INS(TNativeDevice) *nativeDevice;
  AUDIO_INS(TCallbackGuard) callback;
#if AUDIO_DEVICE_MINIAUDIO_FALLBACK
  cosmeron_audio_vendor_ma_device native;
#endif
  AUDIO_DEVICE_TYPE(TConfig) config;
} AUDIO_INS(Device);
#if AUDIO_DEVICE_MINIAUDIO_FALLBACK
static void
AUDIO_INS(DeviceRender)(cosmeron_audio_vendor_ma_device *native, void *output,
                        const void *input,
                        cosmeron_audio_vendor_ma_uint32 frameCount) {
  AUDIO_INS(Device) *device = (AUDIO_INS(Device) *)native->pUserData;
  size_t i, count = (size_t)frameCount * device->config.channels;
  float *samples = (float *)output;
  (void)input;
  memset(samples, 0, count * sizeof(float));
  AUDIO_INS(CallbackGuardSet)(&device->callback,true);
  device->config.render(device->config.userData, samples, frameCount,
                        device->config.channels);
  AUDIO_INS(CallbackGuardSet)(&device->callback,false);
  for (i = 0; i < count; ++i)
    samples[i] =
        AUDIO_INS(Finite)(samples[i]) ? AUDIO_INS(Clamp)(samples[i]) : 0.0f;
}
#endif
AUDIO_DEVICE_OPEN_PROTOTYPE {
  return AUDIO_DEVICE_FUNC(OpenNamed)(device, config, NULL);
}
AUDIO_DEVICE_OPEN_NAMED_PROTOTYPE {
  AUDIO_INS(Device) * value;
  OPSTATUS status;
#if AUDIO_DEVICE_MINIAUDIO_FALLBACK
  cosmeron_audio_vendor_ma_device_config native;
  cosmeron_audio_vendor_ma_result result;
#endif
  if (device == NULL || config == NULL || config->render == NULL ||
      !AUDIO_INS(ValidFormat)(config->sampleRate, config->channels))
    return STATUS_CONST(INVALID_ARGUMENT);
  if (device->internal != NULL)
    return STATUS_CONST(BUSY);

  value = (AUDIO_INS(Device) *)calloc(1, sizeof(*value));
  if (value == NULL)
    return STATUS_CONST(OUT_OF_MEMORY);
  AUDIO_INS(CallbackGuardZero)(&value->callback);
  value->config = *config;
  status = AUDIO_INS(NativeDeviceOpen)(&value->nativeDevice, config, id);
  if (status == STATUS_CONST(SUCCESS)) {
    device->internal = value;
    return status;
  }
  if (status != STATUS_CONST(NOT_AVAILABLE) || (id && strcmp(id,"default"))) {
    free(value); return status;
  }
#if AUDIO_DEVICE_MINIAUDIO_FALLBACK
  if (!AUDIO_INS(PrepareMath)()) { free(value); return STATUS_CONST(NOT_AVAILABLE); }
  if (!AUDIO_INS(CallbackGuardOpen)(&value->callback)) { free(value); return STATUS_CONST(NOT_AVAILABLE); }
  native = cosmeron_audio_vendor_ma_device_config_init(
      cosmeron_audio_vendor_ma_device_type_playback);
  native.playback.format = cosmeron_audio_vendor_ma_format_f32;
  native.playback.channels = config->channels;
  native.sampleRate = config->sampleRate;
  native.dataCallback = AUDIO_INS(DeviceRender);
  native.pUserData = value;
  result = cosmeron_audio_vendor_ma_device_init(NULL, &native, &value->native);
  if (result != cosmeron_audio_vendor_MA_SUCCESS) {
    AUDIO_INS(CallbackGuardRelease)(&value->callback);
    free(value);
    return AUDIO_INS(BackendStatus)(result);
  }
  device->internal = value;
  return STATUS_CONST(SUCCESS);
#else
  free(value); return status;
#endif
}

AUDIO_DEVICE_START_PROTOTYPE {
  if (device == NULL || device->internal == NULL)
    return STATUS_CONST(INVALID_ARGUMENT);
  if (((AUDIO_INS(Device) *)device->internal)->nativeDevice)
    return AUDIO_INS(NativeDeviceStart)(((AUDIO_INS(Device) *)device->internal)->nativeDevice);
#if AUDIO_DEVICE_MINIAUDIO_FALLBACK
  if (AUDIO_INS(InCallback)(&((AUDIO_INS(Device) *)device->internal)->callback)) return STATUS_CONST(BUSY);
  return AUDIO_INS(BackendStatus)(cosmeron_audio_vendor_ma_device_start(
      &((AUDIO_INS(Device) *)device->internal)->native));
#else
  return STATUS_CONST(NOT_AVAILABLE);
#endif
}

AUDIO_DEVICE_STOP_PROTOTYPE {
  if (device == NULL || device->internal == NULL)
    return STATUS_CONST(INVALID_ARGUMENT);
  if (((AUDIO_INS(Device) *)device->internal)->nativeDevice)
    return AUDIO_INS(NativeDeviceStop)(((AUDIO_INS(Device) *)device->internal)->nativeDevice);
#if AUDIO_DEVICE_MINIAUDIO_FALLBACK
  if (AUDIO_INS(InCallback)(&((AUDIO_INS(Device) *)device->internal)->callback)) return STATUS_CONST(BUSY);
  return AUDIO_INS(BackendStatus)(cosmeron_audio_vendor_ma_device_stop(
      &((AUDIO_INS(Device) *)device->internal)->native));
#else
  return STATUS_CONST(NOT_AVAILABLE);
#endif
}


AUDIO_DEVICE_IS_STARTED_PROTOTYPE {
  const AUDIO_INS(Device) *s;
  if (!device || !device->internal) return false;
  s=(const AUDIO_INS(Device) *)device->internal;
  if (s->nativeDevice) return AUDIO_DEVICE_LOAD(&s->nativeDevice->started)!=0;
#if AUDIO_DEVICE_MINIAUDIO_FALLBACK
  return cosmeron_audio_vendor_ma_device_is_started(&s->native)!=0;
#else
  return false;
#endif
}
AUDIO_DEVICE_GET_STATUS_PROTOTYPE {
  const AUDIO_INS(Device) *s;
  if (!device || !device->internal) return STATUS_CONST(INVALID_ARGUMENT);
  s=(const AUDIO_INS(Device) *)device->internal;
  return s->nativeDevice ? (OPSTATUS)AUDIO_DEVICE_LOAD(&s->nativeDevice->status) : STATUS_CONST(SUCCESS);
}
AUDIO_DEVICE_GET_FORMAT_PROTOTYPE {
  const AUDIO_INS(Device) *s;
  if (!device || !device->internal || !outRate || !outChannels) return STATUS_CONST(INVALID_ARGUMENT);
  s=(const AUDIO_INS(Device) *)device->internal;
  *outRate=s->config.sampleRate; *outChannels=s->config.channels;
  return STATUS_CONST(SUCCESS);
}
AUDIO_DEVICE_CLOSE_PROTOTYPE {
  if (device && device->internal) {
    AUDIO_INS(Device) *s=(AUDIO_INS(Device) *)device->internal;
#if AUDIO_DEVICE_MINIAUDIO_FALLBACK
    if (AUDIO_INS(InCallback)(&s->callback)) return;
#endif
    if (s->nativeDevice) {
      /* A callback may request stop, but destruction must be completed by
       * the owning thread: never join or dispose the current callback. */
      if (AUDIO_INS(NativeDeviceStop)(s->nativeDevice)!=STATUS_CONST(SUCCESS)) return;
      AUDIO_INS(NativeDeviceRelease)(s->nativeDevice);
    }
#if AUDIO_DEVICE_MINIAUDIO_FALLBACK
    else cosmeron_audio_vendor_ma_device_uninit(&s->native);
#endif
    AUDIO_INS(CallbackGuardRelease)(&s->callback);
    device->internal=NULL; free(s);
  }
}
