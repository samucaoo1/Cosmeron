#define BIT_IMPLEMENT_SET(TYPE, SUFFIX, LITERAL)                              \
    BIT_SET_PROTOTYPE(TYPE, SUFFIX) {                                \
        if (bit < SUFFIX)\
        *value |= (TYPE)(LITERAL << bit);                                           \
    }


#define BIT_IMPLEMENT_CLEAR(TYPE, SUFFIX, LITERAL)                            \
    BIT_CLEAR_PROTOTYPE(TYPE, SUFFIX) {                              \
        if (bit < SUFFIX)\
        *value &= (TYPE)~(TYPE)(LITERAL << bit);                                          \
    }


#define BIT_IMPLEMENT_FLIP(TYPE, SUFFIX, LITERAL)                             \
    BIT_FLIP_PROTOTYPE(TYPE, SUFFIX) {                               \
        if (bit < SUFFIX)\
        *value ^= (TYPE)(LITERAL << bit);                                           \
    }


#define BIT_IMPLEMENT_CHECK(TYPE, SUFFIX, LITERAL)                            \
    BIT_CHECK_PROTOTYPE(TYPE, SUFFIX) {                              \
        return bit < SUFFIX && (*value & (TYPE)(LITERAL << bit)) != 0;                              \
    }


#define BIT_IMPLEMENT_MASK_SET(TYPE, SUFFIX)                                  \
    BIT_MASK_SET_PROTOTYPE(TYPE, SUFFIX) {                           \
        *value |= mask;                                                       \
    }


#define BIT_IMPLEMENT_MASK_CLEAR(TYPE, SUFFIX)                                \
    BIT_MASK_CLEAR_PROTOTYPE(TYPE, SUFFIX) {                         \
        *value &= ~mask;                                                      \
    }


#define BIT_IMPLEMENT_MASK_FLIP(TYPE, SUFFIX)                                 \
    BIT_MASK_FLIP_PROTOTYPE(TYPE, SUFFIX) {                          \
        *value ^= mask;                                                       \
    }


#define BIT_IMPLEMENT_MASK_CHECK_ALL(TYPE, SUFFIX)                            \
    BIT_MASK_CHECK_ALL_PROTOTYPE(TYPE, SUFFIX) {                     \
        return (*value & mask) == mask;                                       \
    }


#define BIT_IMPLEMENT_MASK_CHECK_ANY(TYPE, SUFFIX)                            \
    BIT_MASK_CHECK_ANY_PROTOTYPE(TYPE, SUFFIX) {                     \
        return (*value & mask) != 0;                                          \
    }
/* EOF */
