#pragma once

#define BIT_SET_IMPLEMENT(TYPE, SUFFIX, LITERAL)                               \
  BIT_SET_PROTOTYPE(TYPE, SUFFIX) {                                            \
    if (value == NULL)                                                         \
      return STATUS_CONST(INVALID_ARGUMENT);                                   \
    if (bit >= SUFFIX)                                                         \
      return STATUS_CONST(OUT_OF_RANGE);                                       \
    *value |= (TYPE)(LITERAL << bit);                                          \
    return STATUS_CONST(SUCCESS);                                              \
  }

#define BIT_CLEAR_IMPLEMENT(TYPE, SUFFIX, LITERAL)                             \
  BIT_CLEAR_PROTOTYPE(TYPE, SUFFIX) {                                          \
    if (value == NULL)                                                         \
      return STATUS_CONST(INVALID_ARGUMENT);                                   \
    if (bit >= SUFFIX)                                                         \
      return STATUS_CONST(OUT_OF_RANGE);                                       \
    *value &= (TYPE)~(TYPE)(LITERAL << bit);                                   \
    return STATUS_CONST(SUCCESS);                                              \
  }

#define BIT_FLIP_IMPLEMENT(TYPE, SUFFIX, LITERAL)                              \
  BIT_FLIP_PROTOTYPE(TYPE, SUFFIX) {                                           \
    if (value == NULL)                                                         \
      return STATUS_CONST(INVALID_ARGUMENT);                                   \
    if (bit >= SUFFIX)                                                         \
      return STATUS_CONST(OUT_OF_RANGE);                                       \
    *value ^= (TYPE)(LITERAL << bit);                                          \
    return STATUS_CONST(SUCCESS);                                              \
  }

#define BIT_CHECK_IMPLEMENT(TYPE, SUFFIX, LITERAL)                             \
  BIT_CHECK_PROTOTYPE(TYPE, SUFFIX) {                                          \
    return bit < SUFFIX && (value & (TYPE)(LITERAL << bit)) != 0;             \
  }

#define BIT_MASK_SET_IMPLEMENT(TYPE, SUFFIX)                                   \
  BIT_MASK_SET_PROTOTYPE(TYPE, SUFFIX) {                                       \
    if (value != NULL)                                                         \
      *value |= mask;                                                          \
  }

#define BIT_MASK_CLEAR_IMPLEMENT(TYPE, SUFFIX)                                 \
  BIT_MASK_CLEAR_PROTOTYPE(TYPE, SUFFIX) {                                     \
    if (value != NULL)                                                         \
      *value &= (TYPE)~mask;                                                   \
  }

#define BIT_MASK_FLIP_IMPLEMENT(TYPE, SUFFIX)                                  \
  BIT_MASK_FLIP_PROTOTYPE(TYPE, SUFFIX) {                                      \
    if (value != NULL)                                                         \
      *value ^= mask;                                                          \
  }

#define BIT_MASK_CHECK_ALL_IMPLEMENT(TYPE, SUFFIX)                             \
  BIT_MASK_CHECK_ALL_PROTOTYPE(TYPE, SUFFIX) {                                 \
    return (value & mask) == mask;                                             \
  }

#define BIT_MASK_CHECK_ANY_IMPLEMENT(TYPE, SUFFIX)                             \
  BIT_MASK_CHECK_ANY_PROTOTYPE(TYPE, SUFFIX) {                                 \
    return (value & mask) != 0;                                                \
  }
/* EOF */
