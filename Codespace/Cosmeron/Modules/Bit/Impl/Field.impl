#pragma once

#define BIT_EXTRACT_IMPLEMENT(TYPE, SUFFIX, LITERAL)                           \
  BIT_EXTRACT_PROTOTYPE(TYPE, SUFFIX) {                                        \
    if (outField == NULL)                                                      \
      return STATUS_CONST(INVALID_ARGUMENT);                                   \
    if (high < low || low >= SUFFIX || high >= SUFFIX)                        \
      return STATUS_CONST(OUT_OF_RANGE);                                       \
    uint8_t width = (uint8_t)(high - low + 1U);                                \
    TYPE result;                                                               \
    if (width == SUFFIX) {                                                     \
      result = value;                                                          \
    } else {                                                                   \
      TYPE mask = (TYPE)(((TYPE)(LITERAL) << width) - (TYPE)(LITERAL));        \
      result = (TYPE)((value >> low) & mask);                                  \
    }                                                                          \
    *outField = result;                                                        \
    return STATUS_CONST(SUCCESS);                                              \
  }

#define BIT_INSERT_IMPLEMENT(TYPE, SUFFIX, LITERAL)                            \
  BIT_INSERT_PROTOTYPE(TYPE, SUFFIX) {                                         \
    if (value == NULL)                                                         \
      return STATUS_CONST(INVALID_ARGUMENT);                                   \
    if (high < low || low >= SUFFIX || high >= SUFFIX)                        \
      return STATUS_CONST(OUT_OF_RANGE);                                       \
    uint8_t width = (uint8_t)(high - low + 1U);                                \
    if (width == SUFFIX) {                                                     \
      *value = fieldValue;                                                     \
      return STATUS_CONST(SUCCESS);                                            \
    }                                                                          \
    TYPE mask = (TYPE)(((TYPE)(LITERAL) << width) - (TYPE)(LITERAL));          \
    fieldValue &= mask;                                                        \
    TYPE shiftedMask = (TYPE)(mask << low);                                    \
    TYPE cleared = (TYPE)(*value & (TYPE)~shiftedMask);                        \
    *value = (TYPE)(cleared | (TYPE)(fieldValue << low));                      \
    return STATUS_CONST(SUCCESS);                                              \
  }
/* EOF */
