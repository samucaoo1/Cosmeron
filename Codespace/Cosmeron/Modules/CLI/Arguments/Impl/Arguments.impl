#pragma once
CLI_ARGUMENTS_CREATE_PROTOTYPE {
  CLI_TYPE(TArguments) arguments;
  arguments.argc = argc;
  arguments.argv = argv;
  return arguments;
}

CLI_ARGUMENTS_COUNT_PROTOTYPE {
  size_t count = 0, length;
  int i;
  if (!CLI_INS(ArgumentsValid)(arguments) || !name || name[0] != '-' || !name[1]) return 0;
  length = strlen(name);
  for (i = 1; i < arguments->argc; ++i) {
    const char *argument = arguments->argv[i];
    if (!strcmp(argument, "--")) break;
    if (!strcmp(argument, name) || (name[1] == '-' && !strncmp(argument, name, length) && argument[length] == '=')) ++count;
    else if (name[1] != '-' && !name[2] && argument[0] == '-' && argument[1] == name[1]) ++count;
  }
  return count;
}

CLI_ARGUMENTS_HAS_PROTOTYPE {
  return CLI_FUNC(Arguments_Count)(arguments, name) != 0;
}

CLI_ARGUMENTS_STRING_AT_PROTOTYPE {
  int i;
  size_t length;
  if (!CLI_INS(ArgumentsValid)(arguments) || !name || name[0] != '-' || !name[1] || !outValue) return STATUS_CONST(INVALID_ARGUMENT);
  length = strlen(name);
  for (i = 1; i < arguments->argc; ++i) {
    const char *argument = arguments->argv[i], *value = NULL;
    if (!strcmp(argument, "--")) break;
    if (!strcmp(argument, name)) {
      if (i + 1 >= arguments->argc || !strcmp(arguments->argv[i+1], "--")) return STATUS_CONST(INCOMPLETE_SEQUENCE);
      value = arguments->argv[++i];
    } else if (name[1] == '-' && !strncmp(argument, name, length) && argument[length] == '=') value = argument + length + 1;
    else if (name[1] != '-' && !name[2] && argument[0] == '-' && argument[1] == name[1] && argument[2]) value = argument + 2;
    if (value && occurrence-- == 0) {
      *outValue = value;
      return STATUS_CONST(SUCCESS);
    }
  }
  return STATUS_CONST(NOT_FOUND);
}

CLI_ARGUMENTS_STRING_PROTOTYPE {
  return CLI_FUNC(Arguments_StringAt)(arguments, name, 0, outValue);
}
CLI_ARGUMENTS_I64_PROTOTYPE {
  const char *text;
  OPSTATUS status;
  if (!outValue) return STATUS_CONST(INVALID_ARGUMENT);
  status = CLI_FUNC(Arguments_String)(arguments, name, &text);
  return status == STATUS_CONST(SUCCESS) ? PARSING_FUNC(Slice_I64)(PARSING_INS(Slice)(text, strlen(text)), outValue) : status;
}
CLI_ARGUMENTS_U64_PROTOTYPE {
  const char *text;
  OPSTATUS status;
  if (!outValue) return STATUS_CONST(INVALID_ARGUMENT);
  status = CLI_FUNC(Arguments_String)(arguments, name, &text);
  return status == STATUS_CONST(SUCCESS) ? PARSING_FUNC(Slice_U64)(PARSING_INS(Slice)(text, strlen(text)), outValue) : status;
}
CLI_ARGUMENTS_F64_PROTOTYPE {
  const char *text;
  OPSTATUS status;
  if (!outValue) return STATUS_CONST(INVALID_ARGUMENT);
  status = CLI_FUNC(Arguments_String)(arguments, name, &text);
  return status == STATUS_CONST(SUCCESS) ? PARSING_FUNC(Slice_F64)(PARSING_INS(Slice)(text, strlen(text)), outValue) : status;
}
