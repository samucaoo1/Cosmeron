            OPERATION(CivilOffset,
                      (const char *text,
                       MODULE_TYPE(Chrono, CivilOffset) *value), {
              if (text == NULL || value == NULL) {
                return STATUS_CONST(INVALID_ARGUMENT);
              }
              MODULE_TYPE(Chrono, CalendarPolicy) gregorian =
                  MODULE_FUNC(Chrono, Calendar, GregorianPolicy)();
              const char *cursor = text;
              MODULE_TYPE(Chrono, CivilOffset) parsed = {0};
              OPSTATUS status = MODULE_IFUNC(Chrono, Format, ParseDatePrefix)(
                  &cursor, &gregorian, &parsed.local.date);
              if (status != STATUS_CONST(SUCCESS)) {
                return status;
