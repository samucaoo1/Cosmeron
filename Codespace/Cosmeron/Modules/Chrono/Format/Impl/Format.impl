                  Chrono, Format, FromISOCivilOffset)(text, &parsed);
              if (status != STATUS_CONST(SUCCESS)) {
                return status;
              }
              return MODULE_FUNC(Chrono, Timezone, ToUTC)(parsed, value);
            }),

            OPERATION(Span,
                      (const char *text, MODULE_TYPE(Chrono, Span) *value), {
              if (text == NULL || value == NULL) {
                return STATUS_CONST(INVALID_ARGUMENT);
              }
              const char *cursor = text;
              bool negative = false;
              if (*cursor == '-' || *cursor == '+') {
                negative = (*cursor == '-');
                ++cursor;
              }
              if (*cursor != 'P') {
                return STATUS_CONST(OUT_OF_RANGE);
              }
              ++cursor;
              bool hasComponent = false;
              uint64_t totalNs = 0U;
              const uint64_t nsPerSec = (uint64_t)MODULE_CONST(
                  Chrono, Math, NANOSECONDS_PER_SECOND);
              const uint64_t secPerDay =
                  (uint64_t)MODULE_CONST(Chrono, Math, SECONDS_PER_DAY);
              const uint64_t secPerHour =
                  (uint64_t)MODULE_CONST(Chrono, Math, SECONDS_PER_HOUR);
              const uint64_t secPerMin =
                  (uint64_t)MODULE_CONST(Chrono, Math, SECONDS_PER_MINUTE);
              if (*cursor >= '0' && *cursor <= '9') {
                uint64_t days = 0U;
                if (!MODULE_IFUNC(Chrono, Format, ParseUnsigned64)(&cursor,
                                                                   &days) ||
                    *cursor != 'D') {
                  return STATUS_CONST(OUT_OF_RANGE);
                }
                ++cursor;
                if (days > UINT64_MAX / (secPerDay * nsPerSec)) {
                  return STATUS_CONST(ARITHMETIC_OVERFLOW);
                }
                totalNs += days * secPerDay * nsPerSec;
                hasComponent = true;
              }
              if (*cursor == 'T') {
                ++cursor;
                bool hasTimeComp = false;
                while (*cursor >= '0' && *cursor <= '9') {
                  uint64_t part = 0U;
                  if (!MODULE_IFUNC(Chrono, Format, ParseUnsigned64)(&cursor,
                                                                     &part)) {
                    return STATUS_CONST(OUT_OF_RANGE);
                  }
                  if (*cursor == 'H') {
                    ++cursor;
                    uint64_t mult = secPerHour * nsPerSec;
                    if (part > (UINT64_MAX - totalNs) / mult) {
                      return STATUS_CONST(ARITHMETIC_OVERFLOW);
                    }
                    totalNs += part * mult;
                    hasTimeComp = true;
                  } else if (*cursor == 'M') {
                    ++cursor;
                    uint64_t mult = secPerMin * nsPerSec;
                    if (part > (UINT64_MAX - totalNs) / mult) {
                      return STATUS_CONST(ARITHMETIC_OVERFLOW);
                    }
                    totalNs += part * mult;
                    hasTimeComp = true;
                  } else if (*cursor == 'S' || *cursor == '.') {
                    if (part > (UINT64_MAX - totalNs) / nsPerSec) {
                      return STATUS_CONST(ARITHMETIC_OVERFLOW);
                    }
                    totalNs += part * nsPerSec;
                    if (*cursor == '.') {
                      ++cursor;
                      if (*cursor < '0' || *cursor > '9') {
                        return STATUS_CONST(OUT_OF_RANGE);
                      }
                      uint64_t fracNs = 0U;
                      size_t fracDigits = 0U;
                      const uint64_t base = (uint64_t)CNS(
                          Chrono, Format, Internal, DECIMAL_BASE);
                      const size_t maxDigits =
                          (size_t)CNS(Chrono, Format, Internal, NANOS_DIGITS);
                      while (*cursor >= '0' && *cursor <= '9') {
                        if (fracDigits >= maxDigits) {
                          return STATUS_CONST(OUT_OF_RANGE);
                        }
                        fracNs = fracNs * base + (uint64_t)(*cursor - '0');
                        ++fracDigits;
                        ++cursor;
                      }
                      for (size_t i = fracDigits; i < maxDigits; ++i) {
                        fracNs *= base;
                      }
                      if (fracNs > UINT64_MAX - totalNs) {
                        return STATUS_CONST(ARITHMETIC_OVERFLOW);
                      }
                      totalNs += fracNs;
                    }
                    if (*cursor != 'S') {
                      return STATUS_CONST(OUT_OF_RANGE);
                    }
                    ++cursor;
                    hasTimeComp = true;
                    break;
                  } else {
                    return STATUS_CONST(OUT_OF_RANGE);
                  }
                }
                if (!hasTimeComp) {
                  return STATUS_CONST(OUT_OF_RANGE);
                }
                hasComponent = true;
              }
              if (!hasComponent || *cursor != '\0') {
                return STATUS_CONST(OUT_OF_RANGE);
              }
              if (negative) {
                if (totalNs > (uint64_t)INT64_MAX + 1ULL) {
                  return STATUS_CONST(ARITHMETIC_OVERFLOW);
                }
                value->nanoseconds = totalNs == (uint64_t)INT64_MAX + 1ULL
                                         ? INT64_MIN
                                         : -(int64_t)totalNs;
              } else {
                if (totalNs > (uint64_t)INT64_MAX) {
                  return STATUS_CONST(ARITHMETIC_OVERFLOW);
                }
                value->nanoseconds = (int64_t)totalNs;
              }
              return STATUS_CONST(SUCCESS);
            })
        ),

        OPERATION(ToRFC3339,
                  (MODULE_TYPE(Chrono, CivilOffset) value, char *buffer,
                   size_t capacity), {
          if (buffer == NULL || capacity == 0U) {
            return STATUS_CONST(INVALID_ARGUMENT);
          }
          MODULE_TYPE(Chrono, CalendarPolicy) gregorian =
              MODULE_FUNC(Chrono, Calendar, GregorianPolicy)();
          if (!MODULE_FUNC(Chrono, Civil, IsValid)(&gregorian, value.local) ||
              !MODULE_FUNC(Chrono, Timezone, Offset, IsValid)(value.offset) ||
              value.local.date.year < 0 ||
              value.local.date.year >
                  CNS(Chrono, Format, Internal, ISO_FOUR_DIGIT_YEAR_MAX)) {
            return STATUS_CONST(OUT_OF_RANGE);
          }
          size_t offset = 0U;
          if (!MODULE_IFUNC(Chrono, Format, WriteDatePart)(
                  buffer, capacity, &offset, value.local.date) ||
              !MODULE_IFUNC(Chrono, Format, WriteChar)(buffer, capacity,
                                                       &offset, 'T') ||
              !MODULE_IFUNC(Chrono, Format, WriteHmsPart)(
                  buffer, capacity, &offset, value.local.time)) {
            return STATUS_CONST(OUT_OF_RANGE);
          }
          if (value.local.time.millisecond != 0U) {
            const size_t three =
                (size_t)CNS(Chrono, Format, Internal, MILLIS_DIGITS);
            if (!MODULE_IFUNC(Chrono, Format, WriteChar)(buffer, capacity,
                                                         &offset, '.') ||
                !MODULE_IFUNC(Chrono, Format, WriteFixedDigits)(
                    buffer, capacity, &offset, value.local.time.millisecond,
                    three)) {
              return STATUS_CONST(OUT_OF_RANGE);
            }
          }
          if (!MODULE_IFUNC(Chrono, Format, WriteOffsetPart)(
                  buffer, capacity, &offset, value.offset, true, true) ||
              !MODULE_IFUNC(Chrono, Format, FinalizeBuffer)(buffer, capacity,
                                                            offset)) {
            return STATUS_CONST(OUT_OF_RANGE);
          }
          return STATUS_CONST(SUCCESS);
        }),

        OPERATION(FromRFC3339,
                  (const char *text,
                   MODULE_TYPE(Chrono, CivilOffset) *outValue), {
          if (text == NULL || outValue == NULL) {
            return STATUS_CONST(INVALID_ARGUMENT);
          }
          const char *cursor = text;
          int year = 0;
          int month = 0;
          int day = 0;
          const size_t four =
              (size_t)CNS(Chrono, Format, Internal, YEAR_MIN_DIGITS);
          const size_t two = (size_t)CNS(Chrono, Format, Internal, TWO_DIGITS);
          if (!MODULE_IFUNC(Chrono, Format, ParseFixedDigits)(&cursor, four,
                                                              &year) ||
              *cursor != '-') {
            return STATUS_CONST(OUT_OF_RANGE);
          }
          ++cursor;
          if (!MODULE_IFUNC(Chrono, Format, ParseFixedDigits)(&cursor, two,
                                                              &month) ||
              *cursor != '-') {
            return STATUS_CONST(OUT_OF_RANGE);
          }
          ++cursor;
          if (!MODULE_IFUNC(Chrono, Format, ParseFixedDigits)(&cursor, two,
                                                              &day)) {
            return STATUS_CONST(OUT_OF_RANGE);
          }
          MODULE_TYPE(Chrono, CalendarPolicy) gregorian =
              MODULE_FUNC(Chrono, Calendar, GregorianPolicy)();
          MODULE_TYPE(Chrono, Date) parsedDate = {
              (int32_t)year, (uint8_t)month, (uint8_t)day};
          if (!MODULE_FUNC(Chrono, Calendar, Date, IsValid)(&gregorian,
                                                            parsedDate)) {
            return STATUS_CONST(OUT_OF_RANGE);
          }
          if (*cursor != 'T' && *cursor != 't' && *cursor != ' ') {
            return STATUS_CONST(OUT_OF_RANGE);
          }
          ++cursor;
          int hour = 0;
          int minute = 0;
          int second = 0;
          int millisecond = 0;
          if (!MODULE_IFUNC(Chrono, Format, ParseFixedDigits)(&cursor, two,
                                                              &hour) ||
              *cursor != ':') {
            return STATUS_CONST(OUT_OF_RANGE);
          }
          ++cursor;
          if (!MODULE_IFUNC(Chrono, Format, ParseFixedDigits)(&cursor, two,
                                                              &minute) ||
              *cursor != ':') {
            return STATUS_CONST(OUT_OF_RANGE);
          }
          ++cursor;
          if (!MODULE_IFUNC(Chrono, Format, ParseFixedDigits)(&cursor, two,
                                                              &second)) {
            return STATUS_CONST(OUT_OF_RANGE);
          }
          if (*cursor == '.') {
            ++cursor;
            if (*cursor < '0' || *cursor > '9') {
              return STATUS_CONST(OUT_OF_RANGE);
            }
            size_t digits = 0U;
            const size_t millisWidth =
                (size_t)CNS(Chrono, Format, Internal, MILLIS_DIGITS);
            const size_t maxFrac =
                (size_t)CNS(Chrono, Format, Internal, NANOS_DIGITS);
            const int base = CNS(Chrono, Format, Internal, DECIMAL_BASE);
            while (*cursor >= '0' && *cursor <= '9') {
              if (digits >= maxFrac) {
                return STATUS_CONST(OUT_OF_RANGE);
              }
              if (digits < millisWidth) {
                millisecond = millisecond * base + (*cursor - '0');
              }
              ++digits;
              ++cursor;
            }
            for (size_t i = digits; i < millisWidth; ++i) {
              millisecond *= base;
            }
          }
          if (hour >= MODULE_CONST(Chrono, Math, HOURS_PER_DAY) ||
              minute >= MODULE_CONST(Chrono, Math, MINUTES_PER_HOUR) ||
              second >= MODULE_CONST(Chrono, Math, SECONDS_PER_MINUTE)) {
            return STATUS_CONST(OUT_OF_RANGE);
          }
          MODULE_TYPE(Chrono, TimeOfDay) parsedTime = {
              .millisecond = (uint16_t)millisecond,
              .second = (uint8_t)second,
              .minute = (uint8_t)minute,
              .hour = (uint8_t)hour};
          MODULE_TYPE(Chrono, UtcOffset) parsedOffset = {0};
          OPSTATUS status = MODULE_IFUNC(Chrono, Format, ParseOffsetSuffix)(
              &cursor, &parsedOffset);
          if (status != STATUS_CONST(SUCCESS)) {
            return status;
          }
          if (*cursor != '\0') {
            return STATUS_CONST(OUT_OF_RANGE);
          }
          *outValue = (MODULE_TYPE(Chrono, CivilOffset)){
              .local = {.date = parsedDate, .time = parsedTime},
              .offset = parsedOffset,
              .daylightSavings = false};
          return STATUS_CONST(SUCCESS);
        }),

        OPERATION(ToRFC2822,
                  (MODULE_TYPE(Chrono, CivilOffset) value, char *buffer,
                   size_t capacity), {
          if (buffer == NULL || capacity == 0U) {
            return STATUS_CONST(INVALID_ARGUMENT);
          }
          MODULE_TYPE(Chrono, CalendarPolicy) gregorian =
              MODULE_FUNC(Chrono, Calendar, GregorianPolicy)();
          if (!MODULE_FUNC(Chrono, Civil, IsValid)(&gregorian, value.local) ||
              !MODULE_FUNC(Chrono, Timezone, Offset, IsValid)(value.offset) ||
              value.local.date.year < 0 ||
              value.local.date.year >
                  CNS(Chrono, Format, Internal, ISO_FOUR_DIGIT_YEAR_MAX)) {
            return STATUS_CONST(OUT_OF_RANGE);
          }
          MODULE_ENUM(Chrono, Calendar, Weekday) weekday = 0;
          OPSTATUS status = MODULE_FUNC(Chrono, Calendar, Date, DayOfWeek)(
              &gregorian, value.local.date, &weekday);
          if (status != STATUS_CONST(SUCCESS)) {
            return status;
          }
          size_t offset = 0U;
          const size_t two = (size_t)CNS(Chrono, Format, Internal, TWO_DIGITS);
          const size_t four =
              (size_t)CNS(Chrono, Format, Internal, YEAR_MIN_DIGITS);
          const char *wdStr = MODULE_IFUNC(
              Chrono, Format,
              WeekdayShortNames)[weekday -
                                 MODULE_CONST(Chrono, Calendar, MONDAY)];
          const char *moStr = MODULE_IFUNC(
              Chrono, Format,
              MonthShortNames)[value.local.date.month -
                               MODULE_CONST(Chrono, Calendar, JANUARY)];
          if (!MODULE_IFUNC(Chrono, Format, WriteCString)(buffer, capacity,
                                                          &offset, wdStr) ||
              !MODULE_IFUNC(Chrono, Format, WriteCString)(buffer, capacity,
                                                          &offset, ", ") ||
              !MODULE_IFUNC(Chrono, Format, WriteFixedDigits)(
                  buffer, capacity, &offset, value.local.date.day, two) ||
              !MODULE_IFUNC(Chrono, Format, WriteChar)(buffer, capacity,
                                                       &offset, ' ') ||
              !MODULE_IFUNC(Chrono, Format, WriteCString)(buffer, capacity,
                                                          &offset, moStr) ||
              !MODULE_IFUNC(Chrono, Format, WriteChar)(buffer, capacity,
                                                       &offset, ' ') ||
              !MODULE_IFUNC(Chrono, Format, WriteFixedDigits)(
                  buffer, capacity, &offset, (uint64_t)value.local.date.year,
                  four) ||
              !MODULE_IFUNC(Chrono, Format, WriteChar)(buffer, capacity,
                                                       &offset, ' ') ||
              !MODULE_IFUNC(Chrono, Format, WriteHmsPart)(
                  buffer, capacity, &offset, value.local.time) ||
              !MODULE_IFUNC(Chrono, Format, WriteChar)(buffer, capacity,
                                                       &offset, ' ') ||
              !MODULE_IFUNC(Chrono, Format, WriteOffsetPart)(
                  buffer, capacity, &offset, value.offset, false, false) ||
              !MODULE_IFUNC(Chrono, Format, FinalizeBuffer)(buffer, capacity,
                                                            offset)) {
            return STATUS_CONST(OUT_OF_RANGE);
          }
          return STATUS_CONST(SUCCESS);
        }),

        OPERATION(Pattern,
                  (char *buffer, size_t capacity, size_t *outWritten,
                   const char *pattern,
                   MODULE_TYPE(Chrono, CivilOffset) value), {
          if (pattern == NULL || (buffer == NULL && capacity > 0U)) {
            return STATUS_CONST(INVALID_ARGUMENT);
          }
          MODULE_TYPE(Chrono, CalendarPolicy) gregorian =
              MODULE_FUNC(Chrono, Calendar, GregorianPolicy)();
          if (!MODULE_FUNC(Chrono, Civil, IsValid)(&gregorian, value.local) ||
              !MODULE_FUNC(Chrono, Timezone, Offset, IsValid)(value.offset)) {
            return STATUS_CONST(OUT_OF_RANGE);
          }
          MODULE_ENUM(Chrono, Calendar, Weekday) weekday = 0;
          uint16_t dayOfYear = 0U;
          OPSTATUS status = MODULE_FUNC(Chrono, Calendar, Date, DayOfWeek)(
              &gregorian, value.local.date, &weekday);
          if (status != STATUS_CONST(SUCCESS)) {
            return status;
          }
          status = MODULE_FUNC(Chrono, Calendar, DayOfYear)(
              &gregorian, value.local.date, &dayOfYear);
          if (status != STATUS_CONST(SUCCESS)) {
            return status;
          }
          const size_t two = (size_t)CNS(Chrono, Format, Internal, TWO_DIGITS);
          const size_t three =
              (size_t)CNS(Chrono, Format, Internal, MILLIS_DIGITS);
          MODULE_ITYPE(Chrono, FormatSink) sink = {buffer, capacity, 0U};
          const char *p = pattern;
          while (*p != '\0') {
            if (*p != '%') {
              MODULE_IFUNC(Chrono, Format, SinkPutChar)(&sink, *p++);
              continue;
            }
            ++p;
            if (*p == '\0') {
              MODULE_IFUNC(Chrono, Format, SinkPutChar)(&sink, '%');
              break;
            }
            if (*p == ':' && p[1] == 'z') {
              p += 2;
              MODULE_IFUNC(Chrono, Format, SinkPutOffset)(
                  &sink, value.offset, true, false);
              continue;
            }
            char spec = *p++;
            switch (spec) {
            case '%':
              MODULE_IFUNC(Chrono, Format, SinkPutChar)(&sink, '%');
              break;
            case 'Y':
              MODULE_IFUNC(Chrono, Format, SinkPutYear)(&sink,
                                                        value.local.date.year);
              break;
            case 'y': {
              int32_t y = value.local.date.year;
              uint64_t mag = y < 0 ? (uint64_t)(-(int64_t)y) : (uint64_t)y;
              MODULE_IFUNC(Chrono, Format, SinkPutFixedDigits)(
                  &sink,
                  mag % (uint64_t)CNS(Chrono, Format, Internal,
                                      TWO_DIGIT_YEAR_MOD),
                  two);
              break;
            }
            case 'm':
              MODULE_IFUNC(Chrono, Format, SinkPutFixedDigits)(
                  &sink, value.local.date.month, two);
              break;
            case 'd':
              MODULE_IFUNC(Chrono, Format, SinkPutFixedDigits)(
                  &sink, value.local.date.day, two);
              break;
            case 'j':
              MODULE_IFUNC(Chrono, Format, SinkPutFixedDigits)(
                  &sink, dayOfYear, three);
              break;
            case 'u':
              MODULE_IFUNC(Chrono, Format, SinkPutFixedDigits)(
                  &sink, (uint64_t)weekday, 1U);
              break;
            case 'a':
              MODULE_IFUNC(Chrono, Format, SinkPutCString)(
                  &sink,
                  MODULE_IFUNC(Chrono, Format,
                               WeekdayShortNames)[weekday -
                                                  MODULE_CONST(Chrono, Calendar,
                                                               MONDAY)]);
              break;
            case 'b':
              MODULE_IFUNC(Chrono, Format, SinkPutCString)(
                  &sink,
                  MODULE_IFUNC(Chrono, Format,
                               MonthShortNames)[value.local.date.month -
                                                MODULE_CONST(Chrono, Calendar,
                                                             JANUARY)]);
              break;
            case 'H':
              MODULE_IFUNC(Chrono, Format, SinkPutFixedDigits)(
                  &sink, value.local.time.hour, two);
              break;
            case 'I': {
              uint8_t h12 = (uint8_t)(value.local.time.hour %
                                      CNS(Chrono, Format, Internal,
                                          TWELVE_HOUR_BASE));
              if (h12 == 0U) {
                h12 = (uint8_t)CNS(Chrono, Format, Internal, TWELVE_HOUR_BASE);
              }
              MODULE_IFUNC(Chrono, Format, SinkPutFixedDigits)(&sink, h12, two);
              break;
            }
            case 'p':
              MODULE_IFUNC(Chrono, Format, SinkPutCString)(
                  &sink,
                  value.local.time.hour <
                          CNS(Chrono, Format, Internal, TWELVE_HOUR_BASE)
                      ? "AM"
                      : "PM");
              break;
            case 'M':
              MODULE_IFUNC(Chrono, Format, SinkPutFixedDigits)(
                  &sink, value.local.time.minute, two);
              break;
            case 'S':
              MODULE_IFUNC(Chrono, Format, SinkPutFixedDigits)(
                  &sink, value.local.time.second, two);
              break;
            case 'f':
              MODULE_IFUNC(Chrono, Format, SinkPutFixedDigits)(
                  &sink, value.local.time.millisecond, three);
              break;
            case 'z':
              MODULE_IFUNC(Chrono, Format, SinkPutOffset)(
                  &sink, value.offset, false, false);
              break;
            case 'Z':
              MODULE_IFUNC(Chrono, Format, SinkPutOffset)(
                  &sink, value.offset, true, true);
              break;
            default:
              MODULE_IFUNC(Chrono, Format, SinkPutChar)(&sink, '%');
              MODULE_IFUNC(Chrono, Format, SinkPutChar)(&sink, spec);
              break;
            }
          }
          MODULE_IFUNC(Chrono, Format, SinkFinish)(&sink);
          if (outWritten != NULL) {
            *outWritten = sink.written;
          }
          if (capacity > 0U && sink.written >= capacity) {
            return STATUS_CONST(INSUFFICIENT_SPACE);
          }
          return STATUS_CONST(SUCCESS);
        }),

        OPERATION(ToHumanSpan,
                  (MODULE_TYPE(Chrono, Span) value, char *buffer,
                   size_t capacity), {
          if (buffer == NULL || capacity == 0U) {
            return STATUS_CONST(INVALID_ARGUMENT);
          }
          size_t offset = 0U;
          if (value.nanoseconds == 0) {
            if (!MODULE_IFUNC(Chrono, Format, WriteCString)(
                    buffer, capacity, &offset, "0ns") ||
                !MODULE_IFUNC(Chrono, Format, FinalizeBuffer)(
                    buffer, capacity, offset)) {
              return STATUS_CONST(OUT_OF_RANGE);
            }
            return STATUS_CONST(SUCCESS);
          }
          if (value.nanoseconds < 0 &&
              !MODULE_IFUNC(Chrono, Format, WriteChar)(buffer, capacity,
                                                       &offset, '-')) {
            return STATUS_CONST(OUT_OF_RANGE);
          }
          uint64_t totalNs =
              value.nanoseconds < 0
                  ? ((uint64_t)(-(value.nanoseconds + 1)) + 1ULL)
                  : (uint64_t)value.nanoseconds;
          const uint64_t nsPerUs = (uint64_t)MODULE_CONST(
              Chrono, Math, NANOSECONDS_PER_MICROSECOND);
          const uint64_t nsPerMs = (uint64_t)MODULE_CONST(
              Chrono, Math, NANOSECONDS_PER_MILLISECOND);
          const uint64_t nsPerSec =
              (uint64_t)MODULE_CONST(Chrono, Math, NANOSECONDS_PER_SECOND);
          const uint64_t secPerMin =
              (uint64_t)MODULE_CONST(Chrono, Math, SECONDS_PER_MINUTE);
          const uint64_t secPerHour =
              (uint64_t)MODULE_CONST(Chrono, Math, SECONDS_PER_HOUR);
          const uint64_t secPerDay =
              (uint64_t)MODULE_CONST(Chrono, Math, SECONDS_PER_DAY);

          uint64_t totalSec = totalNs / nsPerSec;
          uint64_t remNs = totalNs % nsPerSec;
          uint64_t days = totalSec / secPerDay;
          uint64_t remSec = totalSec % secPerDay;
          uint64_t hours = remSec / secPerHour;
          remSec %= secPerHour;
          uint64_t minutes = remSec / secPerMin;
          uint64_t seconds = remSec % secPerMin;
          uint64_t millis = remNs / nsPerMs;
          uint64_t micros = (remNs % nsPerMs) / nsPerUs;
          uint64_t nanos = remNs % nsPerUs;

          bool hasPart = false;
          if (totalSec > 0U) {
            if ((days > 0U &&
                 !MODULE_IFUNC(Chrono, Format, AppendHumanPart)(
                     buffer, capacity, &offset, &hasPart, days, "d")) ||
                (hours > 0U &&
                 !MODULE_IFUNC(Chrono, Format, AppendHumanPart)(
                     buffer, capacity, &offset, &hasPart, hours, "h")) ||
                (minutes > 0U &&
                 !MODULE_IFUNC(Chrono, Format, AppendHumanPart)(
                     buffer, capacity, &offset, &hasPart, minutes, "m")) ||
                (seconds > 0U &&
                 !MODULE_IFUNC(Chrono, Format, AppendHumanPart)(
                     buffer, capacity, &offset, &hasPart, seconds, "s")) ||
                (millis > 0U &&
                 !MODULE_IFUNC(Chrono, Format, AppendHumanPart)(
                     buffer, capacity, &offset, &hasPart, millis, "ms"))) {
              return STATUS_CONST(OUT_OF_RANGE);
            }
          } else if (millis > 0U) {
            if (!MODULE_IFUNC(Chrono, Format, AppendHumanPart)(
                    buffer, capacity, &offset, &hasPart, millis, "ms") ||
                (micros > 0U &&
                 !MODULE_IFUNC(Chrono, Format, AppendHumanPart)(
                     buffer, capacity, &offset, &hasPart, micros, "us"))) {
              return STATUS_CONST(OUT_OF_RANGE);
            }
          } else if (micros > 0U) {
            if (!MODULE_IFUNC(Chrono, Format, AppendHumanPart)(
                    buffer, capacity, &offset, &hasPart, micros, "us") ||
                (nanos > 0U &&
                 !MODULE_IFUNC(Chrono, Format, AppendHumanPart)(
                     buffer, capacity, &offset, &hasPart, nanos, "ns"))) {
              return STATUS_CONST(OUT_OF_RANGE);
            }
          } else {
            if (!MODULE_IFUNC(Chrono, Format, AppendHumanPart)(
                    buffer, capacity, &offset, &hasPart, nanos, "ns")) {
              return STATUS_CONST(OUT_OF_RANGE);
            }
          }
          if (!MODULE_IFUNC(Chrono, Format, FinalizeBuffer)(buffer, capacity,
                                                            offset)) {
            return STATUS_CONST(OUT_OF_RANGE);
          }
          return STATUS_CONST(SUCCESS);
        })
    )
);

/* EOF */
