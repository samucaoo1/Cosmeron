              if (*cursor != 'T') {
                return STATUS_CONST(OUT_OF_RANGE);
              }
              ++cursor;
              status = MODULE_IFUNC(Chrono, Format, ParseTimePrefix)(
                  &cursor, &parsed.local.time);
              if (status != STATUS_CONST(SUCCESS)) {
                return status;
              }
              status = MODULE_IFUNC(Chrono, Format, ParseOffsetSuffix)(
                  &cursor, &parsed.offset);
              if (status != STATUS_CONST(SUCCESS)) {
                return status;
              }
              if (*cursor != '\0') {
                return STATUS_CONST(OUT_OF_RANGE);
