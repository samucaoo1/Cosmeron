#pragma once

#include <limits.h>
#if OS_WINDOWS
#include <windows.h>
#elif OS_MAC
#include <mach/mach_time.h>
#else
#include <time.h>
#endif

/* ========================================================================== */
/* 1. Platform Monotonic Clock Backend (Detect.h + INTERNAL_EX)               */
/* ========================================================================== */

#if OS_WINDOWS
MODULE(DOMAIN(Modules), Chronometry,
    INTERNAL_EX(Clock,
        OPERATION(ReadMonotonic, (uint64_t *outNanoseconds), {
          LARGE_INTEGER counter;
          LARGE_INTEGER frequency;
          if (!QueryPerformanceCounter(&counter) ||
              !QueryPerformanceFrequency(&frequency) ||
              frequency.QuadPart <= 0) {
            return STATUS_CONST(GENERIC_ERROR);
          }
          const uint64_t nsPerSec = (uint64_t)MODULE_CONST(
              Chronometry, Duration, NANOSECONDS_PER_SECOND);
          uint64_t ticks = (uint64_t)counter.QuadPart;
          uint64_t hz = (uint64_t)frequency.QuadPart;
          *outNanoseconds =
              (ticks / hz) * nsPerSec + ((ticks % hz) * nsPerSec) / hz;
          return STATUS_CONST(SUCCESS);
        })
    )
);
#elif OS_MAC
MODULE(DOMAIN(Modules), Chronometry,
    INTERNAL_EX(Clock,
        OPERATION(ReadMonotonic, (uint64_t *outNanoseconds), {
          mach_timebase_info_data_t timebase;
          uint64_t ticks = mach_absolute_time();
          if (mach_timebase_info(&timebase) != KERN_SUCCESS ||
              timebase.denom == 0) {
            return STATUS_CONST(GENERIC_ERROR);
          }
          *outNanoseconds =
              (ticks / timebase.denom) * timebase.numer +
              ((ticks % timebase.denom) * timebase.numer) / timebase.denom;
          return STATUS_CONST(SUCCESS);
        })
    )
);
#else
MODULE(DOMAIN(Modules), Chronometry,
    INTERNAL_EX(Clock,
        OPERATION(ReadMonotonic, (uint64_t *outNanoseconds), {
          struct timespec value;
          if (clock_gettime(CLOCK_MONOTONIC, &value) != 0) {
            return STATUS_CONST(GENERIC_ERROR);
          }
          const uint64_t nsPerSec = (uint64_t)MODULE_CONST(
              Chronometry, Duration, NANOSECONDS_PER_SECOND);
          *outNanoseconds =
              (uint64_t)value.tv_sec * nsPerSec + (uint64_t)value.tv_nsec;
          return STATUS_CONST(SUCCESS);
        })
    )
);
#endif

/* ========================================================================== */
/* 2. Package Implementation: Chronometry_Clock                               */
/* ========================================================================== */

MODULE_IMPLEMENT(DOMAIN(Modules), Chronometry,
    PACKAGE(Clock,
        OPERATION(Now, (MODULE_TYPE(Chronometry, ClockTimePoint) *outResult), {
          if (outResult == NULL) {
            return STATUS_CONST(INVALID_ARGUMENT);
          }
          return MODULE_IFUNC(Chronometry, Clock, ReadMonotonic)(
              &outResult->nanoseconds);
        }),

        OPERATION(DurationBetween,
                  (MODULE_TYPE(Chronometry, ClockTimePoint) start,
                   MODULE_TYPE(Chronometry, ClockTimePoint) end,
                   MODULE_TYPE(Chronometry, Duration) *outResult), {
          if (outResult == NULL) {
            return STATUS_CONST(INVALID_ARGUMENT);
          }
          bool negative = end.nanoseconds < start.nanoseconds;
          uint64_t difference = negative
                                    ? (start.nanoseconds - end.nanoseconds)
                                    : (end.nanoseconds - start.nanoseconds);
          if (difference > (uint64_t)INT64_MAX) {
            return STATUS_CONST(ARITHMETIC_OVERFLOW);
          }
          outResult->nanoseconds =
              negative ? -(int64_t)difference : (int64_t)difference;
          return STATUS_CONST(SUCCESS);
        })
    )
);

/* EOF */
