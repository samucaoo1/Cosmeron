#pragma once

#include <limits.h>
#if OS_WINDOWS
#include <windows.h>
#elif OS_MAC
#include <mach/mach_time.h>
#else
#include <time.h>
#endif

CHRONOMETRY_CLOCK_NOW_PROTOTYPE {
  if (result == NULL)
    return STATUS_CONST(INVALID_ARGUMENT);
#if OS_WINDOWS
  LARGE_INTEGER counter;
  LARGE_INTEGER frequency;
  if (!QueryPerformanceCounter(&counter) ||
      !QueryPerformanceFrequency(&frequency) || frequency.QuadPart <= 0)
    return STATUS_CONST(GENERIC_ERROR);
  uint64_t ticks = (uint64_t)counter.QuadPart;
  uint64_t hz = (uint64_t)frequency.QuadPart;
  result->nanoseconds =
      (ticks / hz) * (uint64_t)CHRONOMETRY_NANOSECONDS_PER_SECOND +
      ((ticks % hz) * (uint64_t)CHRONOMETRY_NANOSECONDS_PER_SECOND) / hz;
#elif OS_MAC
  mach_timebase_info_data_t timebase;
  uint64_t ticks = mach_absolute_time();
  if (mach_timebase_info(&timebase) != KERN_SUCCESS || timebase.denom == 0)
    return STATUS_CONST(GENERIC_ERROR);
  result->nanoseconds = (ticks / timebase.denom) * timebase.numer +
      ((ticks % timebase.denom) * timebase.numer) / timebase.denom;
#else
  struct timespec value;
  if (clock_gettime(CLOCK_MONOTONIC, &value) != 0)
    return STATUS_CONST(GENERIC_ERROR);
  result->nanoseconds =
      (uint64_t)value.tv_sec *
          (uint64_t)CHRONOMETRY_NANOSECONDS_PER_SECOND +
      (uint64_t)value.tv_nsec;
#endif
  return STATUS_CONST(SUCCESS);
}

CHRONOMETRY_CLOCK_DURATION_BETWEEN_PROTOTYPE {
  uint64_t difference;
  if (result == NULL)
    return STATUS_CONST(INVALID_ARGUMENT);
  if (end.nanoseconds >= start.nanoseconds) {
    difference = end.nanoseconds - start.nanoseconds;
    if (difference > INT64_MAX)
      return STATUS_CONST(ARITHMETIC_OVERFLOW);
    result->nanoseconds = (int64_t)difference;
  } else {
    difference = start.nanoseconds - end.nanoseconds;
    if (difference > (uint64_t)INT64_MAX)
      return STATUS_CONST(ARITHMETIC_OVERFLOW);
    result->nanoseconds = -(int64_t)difference;
  }
  return STATUS_CONST(SUCCESS);
}
