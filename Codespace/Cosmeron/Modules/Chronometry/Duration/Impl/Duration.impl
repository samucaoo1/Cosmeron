#pragma once

#include <limits.h>

CHRONOMETRY_DURATION_FROM_NANOSECONDS_PROTOTYPE {
  return (CHRONOMETRY_TYPE(Duration)){nanoseconds};
}

CHRONOMETRY_DURATION_FROM_SECONDS_PROTOTYPE {
  if (outResult == NULL)
    return STATUS_CONST(INVALID_ARGUMENT);
  if (seconds > INT64_MAX / DURATION_CONST(NANOSECONDS_PER_SECOND) ||
      seconds < INT64_MIN / DURATION_CONST(NANOSECONDS_PER_SECOND))
    return STATUS_CONST(ARITHMETIC_OVERFLOW);
  outResult->nanoseconds = seconds * DURATION_CONST(NANOSECONDS_PER_SECOND);
  return STATUS_CONST(SUCCESS);
}

CHRONOMETRY_DURATION_ADD_PROTOTYPE {
  if (outResult == NULL)
    return STATUS_CONST(INVALID_ARGUMENT);
  if ((right.nanoseconds > 0 &&
       left.nanoseconds > INT64_MAX - right.nanoseconds) ||
      (right.nanoseconds < 0 &&
       left.nanoseconds < INT64_MIN - right.nanoseconds))
    return STATUS_CONST(ARITHMETIC_OVERFLOW);
  outResult->nanoseconds = left.nanoseconds + right.nanoseconds;
  return STATUS_CONST(SUCCESS);
}

CHRONOMETRY_DURATION_SUBTRACT_PROTOTYPE {
  if (outResult == NULL)
    return STATUS_CONST(INVALID_ARGUMENT);
  if ((right.nanoseconds < 0 &&
       left.nanoseconds > INT64_MAX + right.nanoseconds) ||
      (right.nanoseconds > 0 &&
       left.nanoseconds < INT64_MIN + right.nanoseconds))
    return STATUS_CONST(ARITHMETIC_OVERFLOW);
  outResult->nanoseconds = left.nanoseconds - right.nanoseconds;
  return STATUS_CONST(SUCCESS);
}

CHRONOMETRY_DURATION_COMPARE_PROTOTYPE {
  if (left.nanoseconds < right.nanoseconds)
    return COMPARISON_LOWER_CONST;
  if (left.nanoseconds > right.nanoseconds)
    return COMPARISON_HIGHER_CONST;
  return COMPARISON_EQUAL_CONST;
}

CHRONOMETRY_DURATION_ABSOLUTE_PROTOTYPE {
  if (outResult == NULL)
    return STATUS_CONST(INVALID_ARGUMENT);
  if (value.nanoseconds == INT64_MIN)
    return STATUS_CONST(ARITHMETIC_OVERFLOW);
  outResult->nanoseconds = value.nanoseconds < 0 ? -value.nanoseconds
                                              : value.nanoseconds;
  return STATUS_CONST(SUCCESS);
}
