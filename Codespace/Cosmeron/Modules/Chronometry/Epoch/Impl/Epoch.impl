#pragma once

#define COSMERON_MACRO_INTERNAL_CHRONOMETRY_UNIX_EPOCH_JDN INT64_C(2440588)
#define COSMERON_MACRO_INTERNAL_CHRONOMETRY_RATA_DIE_JDN INT64_C(1721426)

CHRONOMETRY_EPOCH_DATE_TO_JDN_PROTOTYPE {
  return CALENDAR_FUNC(DateToOrdinal)(policy, date, julianDayNumber);
}

CHRONOMETRY_EPOCH_DATE_FROM_JDN_PROTOTYPE {
  return CALENDAR_FUNC(DateFromOrdinal)(policy, julianDayNumber, date);
}

CHRONOMETRY_EPOCH_DATE_TO_RATA_DIE_PROTOTYPE {
  CALENDAR_TYPE(Policy) gregorian =
      CALENDAR_FUNC(SystemPolicy)(CALENDAR_CONST(GREGORIAN));
  int64_t jdn;
  if (rataDie == NULL)
    return STATUS_CONST(INVALID_ARGUMENT);
  if (CALENDAR_FUNC(DateToOrdinal)(&gregorian, date, &jdn) != STATUS_CONST(SUCCESS))
    return STATUS_CONST(OUT_OF_RANGE);
  *rataDie = jdn - COSMERON_MACRO_INTERNAL_CHRONOMETRY_RATA_DIE_JDN + 1;
  return STATUS_CONST(SUCCESS);
}

CHRONOMETRY_EPOCH_DATETIME_TO_UNIX_PROTOTYPE {
  CALENDAR_TYPE(Policy) gregorian =
      CALENDAR_FUNC(SystemPolicy)(CALENDAR_CONST(GREGORIAN));
  int64_t jdn, days, seconds;
  if (instant == NULL || !DATETIME_FUNC(IsValid)(&gregorian, value))
    return STATUS_CONST(INVALID_ARGUMENT);
  CALENDAR_FUNC(DateToOrdinal)(&gregorian, value.date, &jdn);
  days = jdn - COSMERON_MACRO_INTERNAL_CHRONOMETRY_UNIX_EPOCH_JDN;
  seconds = days * CHRONOMETRY_SECONDS_PER_DAY + value.time.hour * CHRONOMETRY_SECONDS_PER_HOUR +
            value.time.minute * CHRONOMETRY_SECONDS_PER_MINUTE + value.time.second;
  instant->seconds = seconds;
  instant->nanoseconds =
      (uint32_t)value.time.millisecond * ((uint32_t)CHRONOMETRY_NANOSECONDS_PER_MILLISECOND);
  return STATUS_CONST(SUCCESS);
}

CHRONOMETRY_EPOCH_DATETIME_FROM_UNIX_PROTOTYPE {
  CALENDAR_TYPE(Policy) gregorian =
      CALENDAR_FUNC(SystemPolicy)(CALENDAR_CONST(GREGORIAN));
  int64_t days, seconds;
  if (value == NULL || instant.nanoseconds >= ((uint32_t)CHRONOMETRY_NANOSECONDS_PER_SECOND))
    return STATUS_CONST(INVALID_ARGUMENT);
  days = CALENDAR_FUNC(_FloorDiv)(instant.seconds, CHRONOMETRY_SECONDS_PER_DAY);
  seconds = instant.seconds - days * CHRONOMETRY_SECONDS_PER_DAY;
  if (CALENDAR_FUNC(DateFromOrdinal)(&gregorian,
          COSMERON_MACRO_INTERNAL_CHRONOMETRY_UNIX_EPOCH_JDN + days, &value->date) != STATUS_CONST(SUCCESS))
    return STATUS_CONST(OUT_OF_RANGE);
  value->time.hour = (uint8_t)(seconds / CHRONOMETRY_SECONDS_PER_HOUR);
  seconds %= CHRONOMETRY_SECONDS_PER_HOUR;
  value->time.minute = (uint8_t)(seconds / CHRONOMETRY_SECONDS_PER_MINUTE);
  value->time.second = (uint8_t)(seconds % CHRONOMETRY_SECONDS_PER_MINUTE);
  value->time.millisecond = (uint16_t)(instant.nanoseconds / ((uint32_t)CHRONOMETRY_NANOSECONDS_PER_MILLISECOND));
  return STATUS_CONST(SUCCESS);
}

#undef COSMERON_MACRO_INTERNAL_CHRONOMETRY_RATA_DIE_JDN
#undef COSMERON_MACRO_INTERNAL_CHRONOMETRY_UNIX_EPOCH_JDN
