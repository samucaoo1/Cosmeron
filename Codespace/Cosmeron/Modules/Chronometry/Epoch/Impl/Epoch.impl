#pragma once

#include "LeapSeconds.inc"
#include <limits.h>

/* ========================================================================== */
/* 1. Internal Epoch Constants & Leap Second Table (Row-Tuple Pattern)        */
/* ========================================================================== */

#define CHRONOMETRY_EPOCH_INTERNAL_COL_NAME(NAME, VALUE) NAME
#define CHRONOMETRY_EPOCH_INTERNAL_COL_VALUE(NAME, VALUE) VALUE
#define CHRONOMETRY_EPOCH_INTERNAL_GET(FIELD, ROW)                             \
  PP_OP_CAT2(CHRONOMETRY_EPOCH_INTERNAL_COL_, FIELD) ROW

#define CHRONOMETRY_EPOCH_INTERNAL_TABLE(X)                                    \
  X((UNIX_EPOCH_JDN, 2440588))                                                 \
  X((RATA_DIE_JDN, 1721426))                                                   \
  X((TAI_EPOCH_UNIX_SECONDS, 63072000))                                        \
  X((TAI_INITIAL_OFFSET_SECONDS, 10))

#define CHRONOMETRY_EPOCH_LEAP_COL_UNIX(UNIX_SEC, TAI_MINUS_UTC) UNIX_SEC
#define CHRONOMETRY_EPOCH_LEAP_COL_OFFSET(UNIX_SEC, TAI_MINUS_UTC) TAI_MINUS_UTC
#define CHRONOMETRY_EPOCH_LEAP_GET(FIELD, ROW)                                 \
  PP_OP_CAT2(CHRONOMETRY_EPOCH_LEAP_COL_, FIELD) ROW

#define COSMERON_MACRO_INTERNAL_CHRONOMETRY_LEAP_ENTRY(ROW)                    \
  {CHRONOMETRY_EPOCH_LEAP_GET(UNIX, ROW),                                      \
   CHRONOMETRY_EPOCH_LEAP_GET(OFFSET, ROW)},

MODULE(DOMAIN(Modules), Chronometry,
    ISTRUCT(LeapSecondEntry,
        FIELDS(
            int64_t unixSeconds;
            int32_t taiMinusUtc;
        )
    ),

    INTERNAL_EX(Epoch,
        ENUM(Const, CHRONOMETRY_EPOCH_INTERNAL_TABLE)
    )
);

static const MODULE_ITYPE(Chronometry, LeapSecondEntry)
    MODULE_IFUNC(Chronometry, Epoch, LeapSeconds)[] = {
        CHRONOMETRY_EPOCH_LEAP_SECOND_TABLE(
            COSMERON_MACRO_INTERNAL_CHRONOMETRY_LEAP_ENTRY)
};

#undef COSMERON_MACRO_INTERNAL_CHRONOMETRY_LEAP_ENTRY

/* ========================================================================== */
/* 2. Package Implementation: Chronometry_Epoch                               */
/* ========================================================================== */

MODULE_IMPLEMENT(DOMAIN(Modules), Chronometry,
    PACKAGE(Epoch,
        OPERATION(DateToJulianDayNumber,
                  (const MODULE_TYPE(Chronometry, CalendarPolicy) *policy,
                   MODULE_TYPE(Chronometry, Date) date,
                   int64_t *julianDayNumber), {
          return MODULE_FUNC(Chronometry, Calendar, Date, ToOrdinal)(
              policy, date, julianDayNumber);
        }),

        OPERATION(DateFromJulianDayNumber,
                  (const MODULE_TYPE(Chronometry, CalendarPolicy) *policy,
                   int64_t julianDayNumber,
                   MODULE_TYPE(Chronometry, Date) *date), {
          return MODULE_FUNC(Chronometry, Calendar, Date, FromOrdinal)(
              policy, julianDayNumber, date);
        }),

        OPERATION(DateToRataDie,
                  (MODULE_TYPE(Chronometry, Date) date, int64_t *rataDie), {
          if (rataDie == NULL) {
            return STATUS_CONST(INVALID_ARGUMENT);
          }
          MODULE_TYPE(Chronometry, CalendarPolicy) gregorian =
              MODULE_FUNC(Chronometry, Calendar, GregorianPolicy)();
          int64_t jdn = 0;
          if (MODULE_FUNC(Chronometry, Calendar, Date, ToOrdinal)(
                  &gregorian, date, &jdn) != STATUS_CONST(SUCCESS)) {
            return STATUS_CONST(OUT_OF_RANGE);
          }
          *rataDie =
              jdn -
              (int64_t)CNS(Chronometry, Epoch, Internal, RATA_DIE_JDN) + 1;
          return STATUS_CONST(SUCCESS);
        }),

        OPERATION(DateFromRataDie,
                  (int64_t rataDie, MODULE_TYPE(Chronometry, Date) *date), {
          if (date == NULL) {
            return STATUS_CONST(INVALID_ARGUMENT);
          }
          const int64_t offset =
              (int64_t)CNS(Chronometry, Epoch, Internal, RATA_DIE_JDN) - 1;
          if (rataDie > INT64_MAX - offset) {
            return STATUS_CONST(ARITHMETIC_OVERFLOW);
          }
          MODULE_TYPE(Chronometry, CalendarPolicy) gregorian =
              MODULE_FUNC(Chronometry, Calendar, GregorianPolicy)();
          return MODULE_FUNC(Chronometry, Calendar, Date, FromOrdinal)(
              &gregorian, rataDie + offset, date);
        }),

        OPERATION(TimestampToUnix,
                  (MODULE_TYPE(Chronometry, Timestamp) value,
                   MODULE_TYPE(Chronometry, Instant) *instant), {
          if (instant == NULL) {
            return STATUS_CONST(INVALID_ARGUMENT);
          }
          MODULE_TYPE(Chronometry, CalendarPolicy) gregorian =
              MODULE_FUNC(Chronometry, Calendar, GregorianPolicy)();
          if (!MODULE_FUNC(Chronometry, Timestamp, IsValid)(&gregorian, value)) {
            return STATUS_CONST(INVALID_ARGUMENT);
          }
          int64_t jdn = 0;
          if (MODULE_FUNC(Chronometry, Calendar, Date, ToOrdinal)(
                  &gregorian, value.date, &jdn) != STATUS_CONST(SUCCESS)) {
            return STATUS_CONST(OUT_OF_RANGE);
          }
          int64_t days =
              jdn - (int64_t)CNS(Chronometry, Epoch, Internal, UNIX_EPOCH_JDN);
          int64_t seconds =
              days * MODULE_CONST(Chronometry, Duration, SECONDS_PER_DAY) +
              (int64_t)value.time.hour *
                  MODULE_CONST(Chronometry, Duration, SECONDS_PER_HOUR) +
              (int64_t)value.time.minute *
                  MODULE_CONST(Chronometry, Duration, SECONDS_PER_MINUTE) +
              (int64_t)value.time.second;
          instant->seconds = seconds;
          instant->nanoseconds =
              (uint32_t)value.time.millisecond *
              (uint32_t)MODULE_CONST(Chronometry, Duration,
                                     NANOSECONDS_PER_MILLISECOND);
          return STATUS_CONST(SUCCESS);
        }),

        OPERATION(TimestampFromUnix,
                  (MODULE_TYPE(Chronometry, Instant) instant,
                   MODULE_TYPE(Chronometry, Timestamp) *value), {
          if (value == NULL ||
              instant.nanoseconds >=
                  (uint32_t)MODULE_CONST(Chronometry, Duration,
                                         NANOSECONDS_PER_SECOND)) {
            return STATUS_CONST(INVALID_ARGUMENT);
          }
          MODULE_TYPE(Chronometry, CalendarPolicy) gregorian =
              MODULE_FUNC(Chronometry, Calendar, GregorianPolicy)();
          const int64_t secPerDay =
              MODULE_CONST(Chronometry, Duration, SECONDS_PER_DAY);
          int64_t days =
              MODULE_IFUNC(Chronometry, FloorDiv)(instant.seconds, secPerDay);
          int64_t seconds = instant.seconds - days * secPerDay;
          if (MODULE_FUNC(Chronometry, Calendar, Date, FromOrdinal)(
                  &gregorian,
                  (int64_t)CNS(Chronometry, Epoch, Internal, UNIX_EPOCH_JDN) +
                      days,
                  &value->date) != STATUS_CONST(SUCCESS)) {
            return STATUS_CONST(OUT_OF_RANGE);
          }
          const int64_t secPerHour =
              MODULE_CONST(Chronometry, Duration, SECONDS_PER_HOUR);
          const int64_t secPerMin =
              MODULE_CONST(Chronometry, Duration, SECONDS_PER_MINUTE);
          value->time.hour = (uint8_t)(seconds / secPerHour);
          seconds %= secPerHour;
          value->time.minute = (uint8_t)(seconds / secPerMin);
          value->time.second = (uint8_t)(seconds % secPerMin);
          value->time.millisecond = (uint16_t)(instant.nanoseconds /
              (uint32_t)MODULE_CONST(Chronometry, Duration,
                                     NANOSECONDS_PER_MILLISECOND));
          return STATUS_CONST(SUCCESS);
        }),

        OPERATION(TaiMinusUtcSeconds,
                  (MODULE_TYPE(Chronometry, Instant) utc,
                   int32_t *outSeconds), {
          if (outSeconds == NULL ||
              !MODULE_FUNC(Chronometry, Instant, IsValid)(utc)) {
            return STATUS_CONST(INVALID_ARGUMENT);
          }
          const int64_t taiStart = (int64_t)CNS(
              Chronometry, Epoch, Internal, TAI_EPOCH_UNIX_SECONDS);
          if (utc.seconds < taiStart) {
            return STATUS_CONST(OUT_OF_RANGE);
          }
          int32_t offset = (int32_t)CNS(
              Chronometry, Epoch, Internal, TAI_INITIAL_OFFSET_SECONDS);
          const size_t count =
              sizeof(MODULE_IFUNC(Chronometry, Epoch, LeapSeconds)) /
              sizeof(MODULE_IFUNC(Chronometry, Epoch, LeapSeconds)[0]);
          for (size_t i = 0U; i < count; ++i) {
            if (utc.seconds <
                MODULE_IFUNC(Chronometry, Epoch, LeapSeconds)[i].unixSeconds) {
              break;
            }
            offset =
                MODULE_IFUNC(Chronometry, Epoch, LeapSeconds)[i].taiMinusUtc;
          }
          *outSeconds = offset;
          return STATUS_CONST(SUCCESS);
        }),

        OPERATION(UtcToTai,
                  (MODULE_TYPE(Chronometry, Instant) utc,
                   MODULE_TYPE(Chronometry, Instant) *outTai), {
          if (outTai == NULL) {
            return STATUS_CONST(INVALID_ARGUMENT);
          }
          int32_t offset = 0;
          OPSTATUS status = MODULE_FUNC(
              Chronometry, Epoch, TaiMinusUtcSeconds)(utc, &offset);
          if (status != STATUS_CONST(SUCCESS)) {
            return status;
          }
          if (utc.seconds > INT64_MAX - offset) {
            return STATUS_CONST(ARITHMETIC_OVERFLOW);
          }
          *outTai = (MODULE_TYPE(Chronometry, Instant)){
              utc.seconds + offset, utc.nanoseconds};
          return STATUS_CONST(SUCCESS);
        }),

        OPERATION(TaiToUtc,
                  (MODULE_TYPE(Chronometry, Instant) tai,
                   MODULE_TYPE(Chronometry, Instant) *outUtc), {
          if (outUtc == NULL ||
              !MODULE_FUNC(Chronometry, Instant, IsValid)(tai)) {
            return STATUS_CONST(INVALID_ARGUMENT);
          }
          const int64_t taiStart =
              (int64_t)CNS(Chronometry, Epoch, Internal,
                           TAI_EPOCH_UNIX_SECONDS) +
              (int64_t)CNS(Chronometry, Epoch, Internal,
                           TAI_INITIAL_OFFSET_SECONDS);
          if (tai.seconds < taiStart) {
            return STATUS_CONST(OUT_OF_RANGE);
          }
          int32_t offset = (int32_t)CNS(
              Chronometry, Epoch, Internal, TAI_INITIAL_OFFSET_SECONDS);
          const size_t count =
              sizeof(MODULE_IFUNC(Chronometry, Epoch, LeapSeconds)) /
              sizeof(MODULE_IFUNC(Chronometry, Epoch, LeapSeconds)[0]);
          for (size_t i = 0U; i < count; ++i) {
            const int64_t transitionTai =
                MODULE_IFUNC(Chronometry, Epoch, LeapSeconds)[i].unixSeconds +
                MODULE_IFUNC(Chronometry, Epoch, LeapSeconds)[i].taiMinusUtc;
            if (tai.seconds < transitionTai) {
              break;
            }
            offset =
                MODULE_IFUNC(Chronometry, Epoch, LeapSeconds)[i].taiMinusUtc;
          }
          *outUtc = (MODULE_TYPE(Chronometry, Instant)){
              tai.seconds - offset, tai.nanoseconds};
          return STATUS_CONST(SUCCESS);
        })
    )
);

/* EOF */
