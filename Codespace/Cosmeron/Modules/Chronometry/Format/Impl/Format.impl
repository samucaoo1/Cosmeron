#pragma once

#include <stdio.h>

CHRONOMETRY_FORMAT_DATE_ISO_PROTOTYPE {
  int written;
  if (buffer == NULL || capacity == 0)
    return STATUS_CONST(INVALID_ARGUMENT);
  written = snprintf(buffer, capacity, "%+05d-%02u-%02u", date.year,
                     (unsigned)date.month, (unsigned)date.day);
  return written < 0 || (size_t)written >= capacity ? STATUS_CONST(OUT_OF_RANGE)
                                                     : STATUS_CONST(SUCCESS);
}

CHRONOMETRY_FORMAT_DATETIME_ISO_PROTOTYPE {
  int written;
  if (buffer == NULL || capacity == 0)
    return STATUS_CONST(INVALID_ARGUMENT);
  written = snprintf(buffer, capacity,
                     "%+05d-%02u-%02uT%02u:%02u:%02u.%03u", value.date.year,
                     (unsigned)value.date.month, (unsigned)value.date.day,
                     (unsigned)value.time.hour, (unsigned)value.time.minute,
                     (unsigned)value.time.second,
                     (unsigned)value.time.millisecond);
  return written < 0 || (size_t)written >= capacity ? STATUS_CONST(OUT_OF_RANGE)
                                                     : STATUS_CONST(SUCCESS);
}

CHRONOMETRY_PARSE_DATE_ISO_PROTOTYPE {
  int year, month, day, consumed = 0;
  if (text == NULL || date == NULL)
    return STATUS_CONST(INVALID_ARGUMENT);
  if (sscanf(text, "%d-%d-%d%n", &year, &month, &day, &consumed) != 3 ||
      text[consumed] != '\0' || month < CALENDAR_CONST(JANUARY) || month > CALENDAR_CONST(DECEMBER) || day <= 0 || day > CALENDAR_MONTH_LENGTH_CONST(JANUARY))
    return STATUS_CONST(OUT_OF_RANGE);
  *date = (CHRONOMETRY_TYPE(Date)){year, (uint8_t)month, (uint8_t)day};
  return STATUS_CONST(SUCCESS);
}

CHRONOMETRY_PARSE_DATETIME_ISO_PROTOTYPE {
  int year, month, day, hour, minute, second, millisecond, consumed = 0;
  if (text == NULL || value == NULL)
    return STATUS_CONST(INVALID_ARGUMENT);
  if (sscanf(text, "%d-%d-%dT%d:%d:%d.%d%n", &year, &month, &day, &hour,
             &minute, &second, &millisecond, &consumed) != 7 ||
      text[consumed] != '\0' || month < CALENDAR_CONST(JANUARY) || month > CALENDAR_CONST(DECEMBER) || day <= 0 || day > CALENDAR_MONTH_LENGTH_CONST(JANUARY) ||
      hour < 0 || hour >= DURATION_CONST(HOURS_PER_DAY) || minute < 0 ||
      minute >= DURATION_CONST(MINUTES_PER_HOUR) || second < 0 ||
      second >= DURATION_CONST(SECONDS_PER_MINUTE) || millisecond < 0 ||
      millisecond >= DURATION_CONST(MILLISECONDS_PER_SECOND))
    return STATUS_CONST(OUT_OF_RANGE);
  value->date = (CHRONOMETRY_TYPE(Date)){year, (uint8_t)month, (uint8_t)day};
  value->time = (CHRONOMETRY_TYPE(TimeOfDay)){(uint16_t)millisecond,
      (uint8_t)second, (uint8_t)minute, (uint8_t)hour};
  return STATUS_CONST(SUCCESS);
}
