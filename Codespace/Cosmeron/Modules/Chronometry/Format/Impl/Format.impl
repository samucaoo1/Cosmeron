#pragma once

#include <limits.h>
#include <string.h>

/* ========================================================================== */
/* 1. Internal Format Constants & Freestanding Writers/Parsers                */
/* ========================================================================== */

#define CHRONOMETRY_FORMAT_INTERNAL_COL_NAME(NAME, VALUE) NAME
#define CHRONOMETRY_FORMAT_INTERNAL_COL_VALUE(NAME, VALUE) VALUE
#define CHRONOMETRY_FORMAT_INTERNAL_GET(FIELD, ROW)                            \
  PP_OP_CAT2(CHRONOMETRY_FORMAT_INTERNAL_COL_, FIELD) ROW

#define CHRONOMETRY_FORMAT_INTERNAL_TABLE(X)                                   \
  X((DATE_YEAR_MIN, -4194304))                                                 \
  X((DATE_YEAR_MAX, 4194303))                                                  \
  X((ISO_FOUR_DIGIT_YEAR_MAX, 9999))                                           \
  X((YEAR_MIN_DIGITS, 4))                                                      \
  X((TWO_DIGITS, 2))                                                           \
  X((MILLIS_DIGITS, 3))                                                        \
  X((NANOS_DIGITS, 9))                                                         \
  X((UINT64_MAX_DIGITS, 24))                                                   \
  X((DECIMAL_BASE, 10))

MODULE(DOMAIN(Modules), Chronometry,
    INTERNAL_EX(Format,
        ENUM(Const, CHRONOMETRY_FORMAT_INTERNAL_TABLE),

        PREDICATE(WriteChar,
                  (char *buffer, size_t capacity, size_t *offset, char ch), {
          if (*offset >= capacity) {
            return false;
          }
          buffer[*offset] = ch;
          ++(*offset);
          return true;
        }),

        PREDICATE(WriteFixedDigits,
                  (char *buffer, size_t capacity, size_t *offset,
                   uint64_t value, size_t width), {
          if (*offset + width > capacity) {
            return false;
          }
          const uint64_t base =
              (uint64_t)CNS(Chronometry, Format, Internal, DECIMAL_BASE);
          for (size_t i = width; i > 0U; --i) {
            buffer[*offset + i - 1U] = (char)('0' + (char)(value % base));
            value /= base;
          }
          *offset += width;
          return true;
        }),

        PREDICATE(WriteUnsigned64,
                  (char *buffer, size_t capacity, size_t *offset,
                   uint64_t value), {
          char digits[CNS(Chronometry, Format, Internal, UINT64_MAX_DIGITS)];
          size_t count = 0U;
          const uint64_t base =
              (uint64_t)CNS(Chronometry, Format, Internal, DECIMAL_BASE);
          do {
            digits[count++] = (char)('0' + (char)(value % base));
            value /= base;
          } while (value > 0U);
          if (*offset + count > capacity) {
            return false;
          }
          for (size_t i = count; i > 0U; --i) {
            buffer[*offset] = digits[i - 1U];
            ++(*offset);
          }
          return true;
        }),

        PREDICATE(FinalizeBuffer,
                  (char *buffer, size_t capacity, size_t offset), {
          if (offset >= capacity) {
            return false;
          }
          buffer[offset] = '\0';
          return true;
        }),

        PREDICATE(WriteYear,
                  (char *buffer, size_t capacity, size_t *offset,
                   int32_t year), {
          if (year < 0 ||
              year > CNS(Chronometry, Format, Internal,
                         ISO_FOUR_DIGIT_YEAR_MAX)) {
            char sign = year < 0 ? '-' : '+';
            if (!MODULE_IFUNC(Chronometry, Format, WriteChar)(
                    buffer, capacity, offset, sign)) {
              return false;
            }
          }
          uint64_t mag = year < 0 ? (uint64_t)(-(int64_t)year) : (uint64_t)year;
          size_t width =
              (size_t)CNS(Chronometry, Format, Internal, YEAR_MIN_DIGITS);
          if (mag >= 1000000ULL) {
            width = 7U;
          } else if (mag >= 100000ULL) {
            width = 6U;
          } else if (mag >= 10000ULL) {
            width = 5U;
          }
          return MODULE_IFUNC(Chronometry, Format, WriteFixedDigits)(
              buffer, capacity, offset, mag, width);
        }),

        PREDICATE(WriteDatePart,
                  (char *buffer, size_t capacity, size_t *offset,
                   MODULE_TYPE(Chronometry, Date) date), {
          const size_t two =
              (size_t)CNS(Chronometry, Format, Internal, TWO_DIGITS);
          return MODULE_IFUNC(Chronometry, Format, WriteYear)(
                     buffer, capacity, offset, date.year) &&
                 MODULE_IFUNC(Chronometry, Format, WriteChar)(
                     buffer, capacity, offset, '-') &&
                 MODULE_IFUNC(Chronometry, Format, WriteFixedDigits)(
                     buffer, capacity, offset, date.month, two) &&
                 MODULE_IFUNC(Chronometry, Format, WriteChar)(
                     buffer, capacity, offset, '-') &&
                 MODULE_IFUNC(Chronometry, Format, WriteFixedDigits)(
                     buffer, capacity, offset, date.day, two);
        }),

        PREDICATE(WriteTimePart,
                  (char *buffer, size_t capacity, size_t *offset,
                   MODULE_TYPE(Chronometry, TimeOfDay) time), {
          const size_t two =
              (size_t)CNS(Chronometry, Format, Internal, TWO_DIGITS);
          const size_t three =
              (size_t)CNS(Chronometry, Format, Internal, MILLIS_DIGITS);
          return MODULE_IFUNC(Chronometry, Format, WriteFixedDigits)(
                     buffer, capacity, offset, time.hour, two) &&
                 MODULE_IFUNC(Chronometry, Format, WriteChar)(
                     buffer, capacity, offset, ':') &&
                 MODULE_IFUNC(Chronometry, Format, WriteFixedDigits)(
                     buffer, capacity, offset, time.minute, two) &&
                 MODULE_IFUNC(Chronometry, Format, WriteChar)(
                     buffer, capacity, offset, ':') &&
                 MODULE_IFUNC(Chronometry, Format, WriteFixedDigits)(
                     buffer, capacity, offset, time.second, two) &&
                 MODULE_IFUNC(Chronometry, Format, WriteChar)(
                     buffer, capacity, offset, '.') &&
                 MODULE_IFUNC(Chronometry, Format, WriteFixedDigits)(
                     buffer, capacity, offset, time.millisecond, three);
        }),

        PREDICATE(WriteOffsetPart,
                  (char *buffer, size_t capacity, size_t *offset,
                   MODULE_TYPE(Chronometry, UtcOffset) tzOffset), {
          if (tzOffset.minutesEastOfUtc == 0) {
            return MODULE_IFUNC(Chronometry, Format, WriteChar)(
                buffer, capacity, offset, 'Z');
          }
          char sign = tzOffset.minutesEastOfUtc < 0 ? '-' : '+';
          uint64_t absMin =
              (uint64_t)(tzOffset.minutesEastOfUtc < 0
                             ? -tzOffset.minutesEastOfUtc
                             : tzOffset.minutesEastOfUtc);
          uint64_t minPerHour =
              (uint64_t)MODULE_CONST(Chronometry, Duration, MINUTES_PER_HOUR);
          const size_t two =
              (size_t)CNS(Chronometry, Format, Internal, TWO_DIGITS);
          return MODULE_IFUNC(Chronometry, Format, WriteChar)(
                     buffer, capacity, offset, sign) &&
                 MODULE_IFUNC(Chronometry, Format, WriteFixedDigits)(
                     buffer, capacity, offset, absMin / minPerHour, two) &&
                 MODULE_IFUNC(Chronometry, Format, WriteChar)(
                     buffer, capacity, offset, ':') &&
                 MODULE_IFUNC(Chronometry, Format, WriteFixedDigits)(
                     buffer, capacity, offset, absMin % minPerHour, two);
        }),

        PREDICATE(ParseFixedDigits,
                  (const char **cursor, size_t count, int *outValue), {
          const char *p = *cursor;
          int value = 0;
          const int base = CNS(Chronometry, Format, Internal, DECIMAL_BASE);
          for (size_t i = 0U; i < count; ++i) {
            if (p[i] < '0' || p[i] > '9') {
              return false;
            }
            value = value * base + (p[i] - '0');
          }
          *cursor = p + count;
          *outValue = value;
          return true;
        }),

        PREDICATE(ParseUnsigned64, (const char **cursor, uint64_t *outValue), {
          const char *p = *cursor;
          if (*p < '0' || *p > '9') {
            return false;
          }
          uint64_t value = 0U;
          const uint64_t base =
              (uint64_t)CNS(Chronometry, Format, Internal, DECIMAL_BASE);
          while (*p >= '0' && *p <= '9') {
            uint64_t digit = (uint64_t)(*p - '0');
            if (value > (UINT64_MAX - digit) / base) {
              return false;
            }
            value = value * base + digit;
            ++p;
          }
          *cursor = p;
          *outValue = value;
          return true;
        }),

        PREDICATE(ParseSignedYear, (const char **cursor, int *outYear), {
          const char *p = *cursor;
          int sign = 1;
          if (*p == '+' || *p == '-') {
            sign = (*p == '-') ? -1 : 1;
            ++p;
          }
          size_t digits = 0U;
          int64_t magnitude = 0;
          const int64_t base =
              CNS(Chronometry, Format, Internal, DECIMAL_BASE);
          const int64_t maxAbs =
              -CNS(Chronometry, Format, Internal, DATE_YEAR_MIN);
          while (*p >= '0' && *p <= '9') {
            magnitude = magnitude * base + (*p - '0');
            if (magnitude > maxAbs) {
              return false;
            }
            ++digits;
            ++p;
          }
          if (digits < (size_t)CNS(Chronometry, Format, Internal,
                                   YEAR_MIN_DIGITS)) {
            return false;
          }
          int64_t signedYear = (int64_t)sign * magnitude;
          if (signedYear < CNS(Chronometry, Format, Internal, DATE_YEAR_MIN) ||
              signedYear > CNS(Chronometry, Format, Internal, DATE_YEAR_MAX)) {
            return false;
          }
          *cursor = p;
          *outYear = (int)signedYear;
          return true;
        }),

        OPERATION(ParseDatePrefix,
                  (const char **cursor,
                   const MODULE_TYPE(Chronometry, CalendarPolicy) *policy,
                   MODULE_TYPE(Chronometry, Date) *outDate), {
          int year = 0;
          int month = 0;
          int day = 0;
          if (!MODULE_IFUNC(Chronometry, Format, ParseSignedYear)(cursor,
                                                                  &year) ||
              **cursor != '-') {
            return STATUS_CONST(OUT_OF_RANGE);
          }
          ++(*cursor);
          if (!MODULE_IFUNC(Chronometry, Format, ParseFixedDigits)(
                  cursor, CNS(Chronometry, Format, Internal, TWO_DIGITS),
                  &month) ||
              **cursor != '-') {
            return STATUS_CONST(OUT_OF_RANGE);
          }
          ++(*cursor);
          if (!MODULE_IFUNC(Chronometry, Format, ParseFixedDigits)(
                  cursor, CNS(Chronometry, Format, Internal, TWO_DIGITS),
                  &day)) {
            return STATUS_CONST(OUT_OF_RANGE);
          }
          if (month < MODULE_CONST(Chronometry, Calendar, JANUARY) ||
              month > MODULE_CONST(Chronometry, Calendar, DECEMBER) ||
              day <= 0 ||
              day > MODULE_CONST(Chronometry, Calendar, DAYS_IN_JANUARY)) {
            return STATUS_CONST(OUT_OF_RANGE);
          }
          MODULE_TYPE(Chronometry, Date) candidate = {
              year, (uint8_t)month, (uint8_t)day};
          if (!MODULE_FUNC(Chronometry, Calendar, Date, IsValid)(policy,
                                                                 candidate)) {
            return STATUS_CONST(OUT_OF_RANGE);
          }
          *outDate = candidate;
          return STATUS_CONST(SUCCESS);
        }),

        OPERATION(ParseTimePrefix,
                  (const char **cursor,
                   MODULE_TYPE(Chronometry, TimeOfDay) *outTime), {
          int hour = 0;
          int minute = 0;
          int second = 0;
          int millisecond = 0;
          const size_t twoDigits =
              CNS(Chronometry, Format, Internal, TWO_DIGITS);
          if (!MODULE_IFUNC(Chronometry, Format, ParseFixedDigits)(
                  cursor, twoDigits, &hour) ||
              **cursor != ':') {
            return STATUS_CONST(OUT_OF_RANGE);
          }
          ++(*cursor);
          if (!MODULE_IFUNC(Chronometry, Format, ParseFixedDigits)(
                  cursor, twoDigits, &minute) ||
              **cursor != ':') {
            return STATUS_CONST(OUT_OF_RANGE);
          }
          ++(*cursor);
          if (!MODULE_IFUNC(Chronometry, Format, ParseFixedDigits)(
                  cursor, twoDigits, &second) ||
              **cursor != '.') {
            return STATUS_CONST(OUT_OF_RANGE);
          }
          ++(*cursor);
          if (!MODULE_IFUNC(Chronometry, Format, ParseFixedDigits)(
                  cursor, CNS(Chronometry, Format, Internal, MILLIS_DIGITS),
                  &millisecond)) {
            return STATUS_CONST(OUT_OF_RANGE);
          }
          if (hour < 0 ||
              hour >= MODULE_CONST(Chronometry, Duration, HOURS_PER_DAY) ||
              minute < 0 ||
              minute >= MODULE_CONST(Chronometry, Duration, MINUTES_PER_HOUR) ||
              second < 0 ||
              second >=
                  MODULE_CONST(Chronometry, Duration, SECONDS_PER_MINUTE) ||
              millisecond < 0 ||
              millisecond >=
                  MODULE_CONST(Chronometry, Duration,
                               MILLISECONDS_PER_SECOND)) {
            return STATUS_CONST(OUT_OF_RANGE);
          }
          *outTime = (MODULE_TYPE(Chronometry, TimeOfDay)){
              .millisecond = (uint16_t)millisecond,
              .second = (uint8_t)second,
              .minute = (uint8_t)minute,
              .hour = (uint8_t)hour};
          return STATUS_CONST(SUCCESS);
        }),

        OPERATION(ParseOffsetSuffix,
                  (const char **cursor,
                   MODULE_TYPE(Chronometry, UtcOffset) *outOffset), {
          const char ch = **cursor;
          if (ch == 'Z' || ch == 'z') {
            ++(*cursor);
            outOffset->minutesEastOfUtc = 0;
            return STATUS_CONST(SUCCESS);
          }
          if (ch != '+' && ch != '-') {
            return STATUS_CONST(OUT_OF_RANGE);
          }
          int sign = (ch == '-') ? -1 : 1;
          ++(*cursor);
          int hours = 0;
          int minutes = 0;
          const size_t twoDigits =
              CNS(Chronometry, Format, Internal, TWO_DIGITS);
          if (!MODULE_IFUNC(Chronometry, Format, ParseFixedDigits)(
                  cursor, twoDigits, &hours) ||
              **cursor != ':') {
            return STATUS_CONST(OUT_OF_RANGE);
          }
          ++(*cursor);
          if (!MODULE_IFUNC(Chronometry, Format, ParseFixedDigits)(
                  cursor, twoDigits, &minutes)) {
            return STATUS_CONST(OUT_OF_RANGE);
          }
          if (hours >= MODULE_CONST(Chronometry, Duration, HOURS_PER_DAY) ||
              minutes >= MODULE_CONST(Chronometry, Duration, MINUTES_PER_HOUR)) {
            return STATUS_CONST(OUT_OF_RANGE);
          }
          MODULE_TYPE(Chronometry, UtcOffset) candidate = {
              (int16_t)(sign *
                        (hours * MODULE_CONST(Chronometry, Duration,
                                              MINUTES_PER_HOUR) +
                         minutes))};
          if (!MODULE_FUNC(Chronometry, Timezone, Offset, IsValid)(candidate)) {
            return STATUS_CONST(OUT_OF_RANGE);
          }
          *outOffset = candidate;
          return STATUS_CONST(SUCCESS);
        })
    )
);

/* ========================================================================== */
/* 2. Package Implementation: Chronometry_Format                              */
/* ========================================================================== */

MODULE_IMPLEMENT(DOMAIN(Modules), Chronometry,
    PACKAGE(Format,
        VARIANT(ToISO,
            OPERATION(Date,
                      (MODULE_TYPE(Chronometry, Date) date, char *buffer,
                       size_t capacity), {
              if (buffer == NULL || capacity == 0U) {
                return STATUS_CONST(INVALID_ARGUMENT);
              }
              MODULE_TYPE(Chronometry, CalendarPolicy) gregorian =
                  MODULE_FUNC(Chronometry, Calendar, GregorianPolicy)();
              if (!MODULE_FUNC(Chronometry, Calendar, Date, IsValid)(
                      &gregorian, date)) {
                return STATUS_CONST(OUT_OF_RANGE);
              }
              size_t offset = 0U;
              if (!MODULE_IFUNC(Chronometry, Format, WriteDatePart)(
                      buffer, capacity, &offset, date) ||
                  !MODULE_IFUNC(Chronometry, Format, FinalizeBuffer)(
                      buffer, capacity, offset)) {
                return STATUS_CONST(OUT_OF_RANGE);
              }
              return STATUS_CONST(SUCCESS);
            }),

            OPERATION(Timestamp,
                      (MODULE_TYPE(Chronometry, Timestamp) value,
                       char *buffer, size_t capacity), {
              if (buffer == NULL || capacity == 0U) {
                return STATUS_CONST(INVALID_ARGUMENT);
              }
              MODULE_TYPE(Chronometry, CalendarPolicy) gregorian =
                  MODULE_FUNC(Chronometry, Calendar, GregorianPolicy)();
              if (!MODULE_FUNC(Chronometry, Timestamp, IsValid)(&gregorian,
                                                                 value)) {
                return STATUS_CONST(OUT_OF_RANGE);
              }
              size_t offset = 0U;
              if (!MODULE_IFUNC(Chronometry, Format, WriteDatePart)(
                      buffer, capacity, &offset, value.date) ||
                  !MODULE_IFUNC(Chronometry, Format, WriteChar)(
                      buffer, capacity, &offset, 'T') ||
                  !MODULE_IFUNC(Chronometry, Format, WriteTimePart)(
                      buffer, capacity, &offset, value.time) ||
                  !MODULE_IFUNC(Chronometry, Format, FinalizeBuffer)(
                      buffer, capacity, offset)) {
                return STATUS_CONST(OUT_OF_RANGE);
              }
              return STATUS_CONST(SUCCESS);
            }),

            OPERATION(OffsetTimestamp,
                      (MODULE_TYPE(Chronometry, OffsetTimestamp) value,
                       char *buffer, size_t capacity), {
              if (buffer == NULL || capacity == 0U) {
                return STATUS_CONST(INVALID_ARGUMENT);
              }
              MODULE_TYPE(Chronometry, CalendarPolicy) gregorian =
                  MODULE_FUNC(Chronometry, Calendar, GregorianPolicy)();
              if (!MODULE_FUNC(Chronometry, Timestamp, IsValid)(
                      &gregorian, value.local) ||
                  !MODULE_FUNC(Chronometry, Timezone, Offset, IsValid)(
                      value.offset)) {
                return STATUS_CONST(OUT_OF_RANGE);
              }
              size_t offset = 0U;
              if (!MODULE_IFUNC(Chronometry, Format, WriteDatePart)(
                      buffer, capacity, &offset, value.local.date) ||
                  !MODULE_IFUNC(Chronometry, Format, WriteChar)(
                      buffer, capacity, &offset, 'T') ||
                  !MODULE_IFUNC(Chronometry, Format, WriteTimePart)(
                      buffer, capacity, &offset, value.local.time) ||
                  !MODULE_IFUNC(Chronometry, Format, WriteOffsetPart)(
                      buffer, capacity, &offset, value.offset) ||
                  !MODULE_IFUNC(Chronometry, Format, FinalizeBuffer)(
                      buffer, capacity, offset)) {
                return STATUS_CONST(OUT_OF_RANGE);
              }
              return STATUS_CONST(SUCCESS);
            }),

            OPERATION(Instant,
                      (MODULE_TYPE(Chronometry, Instant) value,
                       char *buffer, size_t capacity), {
              if (buffer == NULL || capacity == 0U) {
                return STATUS_CONST(INVALID_ARGUMENT);
              }
              if (!MODULE_FUNC(Chronometry, Instant, IsValid)(value)) {
                return STATUS_CONST(OUT_OF_RANGE);
              }
              MODULE_TYPE(Chronometry, OffsetTimestamp) utc = {0};
              OPSTATUS status = MODULE_FUNC(Chronometry, Timezone, FromUTC)(
                  value, (MODULE_TYPE(Chronometry, UtcOffset)){0}, &utc);
              if (status != STATUS_CONST(SUCCESS)) {
                return status;
              }
              return MODULE_FUNC(Chronometry, Format, ToISOOffsetTimestamp)(
                  utc, buffer, capacity);
            }),

              OPERATION(Duration,
                        (MODULE_TYPE(Chronometry, Duration) value,
                         char *buffer, size_t capacity), {
                if (buffer == NULL || capacity == 0U) {
                  return STATUS_CONST(INVALID_ARGUMENT);
                }
                size_t offset = 0U;
                if (value.nanoseconds == 0) {
                  if (!MODULE_IFUNC(Chronometry, Format, WriteChar)(
                          buffer, capacity, &offset, 'P') ||
                      !MODULE_IFUNC(Chronometry, Format, WriteChar)(
                          buffer, capacity, &offset, 'T') ||
                      !MODULE_IFUNC(Chronometry, Format, WriteChar)(
                          buffer, capacity, &offset, '0') ||
                      !MODULE_IFUNC(Chronometry, Format, WriteChar)(
                          buffer, capacity, &offset, 'S') ||
                      !MODULE_IFUNC(Chronometry, Format, FinalizeBuffer)(
                          buffer, capacity, offset)) {
                    return STATUS_CONST(OUT_OF_RANGE);
                  }
                  return STATUS_CONST(SUCCESS);
                }
                if (value.nanoseconds < 0 &&
                    !MODULE_IFUNC(Chronometry, Format, WriteChar)(
                        buffer, capacity, &offset, '-')) {
                  return STATUS_CONST(OUT_OF_RANGE);
                }
                uint64_t totalNs =
                    value.nanoseconds < 0
                        ? ((uint64_t)(-(value.nanoseconds + 1)) + 1ULL)
                        : (uint64_t)value.nanoseconds;
                const uint64_t nsPerSec = (uint64_t)MODULE_CONST(
                    Chronometry, Duration, NANOSECONDS_PER_SECOND);
                const uint64_t secPerMin = (uint64_t)MODULE_CONST(
                    Chronometry, Duration, SECONDS_PER_MINUTE);
                const uint64_t secPerHour = (uint64_t)MODULE_CONST(
                    Chronometry, Duration, SECONDS_PER_HOUR);
                uint64_t totalSec = totalNs / nsPerSec;
                uint64_t remNs = totalNs % nsPerSec;
                uint64_t hours = totalSec / secPerHour;
                uint64_t minutes = (totalSec % secPerHour) / secPerMin;
                uint64_t seconds = totalSec % secPerMin;
                if (!MODULE_IFUNC(Chronometry, Format, WriteChar)(
                        buffer, capacity, &offset, 'P') ||
                    !MODULE_IFUNC(Chronometry, Format, WriteChar)(
                        buffer, capacity, &offset, 'T')) {
                  return STATUS_CONST(OUT_OF_RANGE);
                }
                if (hours > 0U &&
                    (!MODULE_IFUNC(Chronometry, Format, WriteUnsigned64)(
                         buffer, capacity, &offset, hours) ||
                     !MODULE_IFUNC(Chronometry, Format, WriteChar)(
                         buffer, capacity, &offset, 'H'))) {
                  return STATUS_CONST(OUT_OF_RANGE);
                }
                if (minutes > 0U &&
                    (!MODULE_IFUNC(Chronometry, Format, WriteUnsigned64)(
                         buffer, capacity, &offset, minutes) ||
                     !MODULE_IFUNC(Chronometry, Format, WriteChar)(
                         buffer, capacity, &offset, 'M'))) {
                  return STATUS_CONST(OUT_OF_RANGE);
                }
                if (seconds > 0U || remNs > 0U ||
                    (hours == 0U && minutes == 0U)) {
                  if (!MODULE_IFUNC(Chronometry, Format, WriteUnsigned64)(
                          buffer, capacity, &offset, seconds)) {
                    return STATUS_CONST(OUT_OF_RANGE);
                  }
                  if (remNs > 0U) {
                    if (!MODULE_IFUNC(Chronometry, Format, WriteChar)(
                            buffer, capacity, &offset, '.')) {
                      return STATUS_CONST(OUT_OF_RANGE);
                    }
                    size_t width = (size_t)CNS(Chronometry, Format, Internal,
                                               NANOS_DIGITS);
                    const uint64_t base = (uint64_t)CNS(
                        Chronometry, Format, Internal, DECIMAL_BASE);
                    while (remNs % base == 0U && width > 1U) {
                      remNs /= base;
                      --width;
                    }
                    if (!MODULE_IFUNC(Chronometry, Format, WriteFixedDigits)(
                            buffer, capacity, &offset, remNs, width)) {
                      return STATUS_CONST(OUT_OF_RANGE);
                    }
                  }
                  if (!MODULE_IFUNC(Chronometry, Format, WriteChar)(
                          buffer, capacity, &offset, 'S')) {
                    return STATUS_CONST(OUT_OF_RANGE);
                  }
                }
                if (!MODULE_IFUNC(Chronometry, Format, FinalizeBuffer)(
                        buffer, capacity, offset)) {
                  return STATUS_CONST(OUT_OF_RANGE);
                }
                return STATUS_CONST(SUCCESS);
              })
        ),

        VARIANT(FromISO,
            OPERATION(Date,
                      (const char *text,
                       MODULE_TYPE(Chronometry, Date) *date), {
              if (text == NULL || date == NULL) {
                return STATUS_CONST(INVALID_ARGUMENT);
              }
              MODULE_TYPE(Chronometry, CalendarPolicy) gregorian =
                  MODULE_FUNC(Chronometry, Calendar, GregorianPolicy)();
              const char *cursor = text;
              MODULE_TYPE(Chronometry, Date) parsed = {0};
              OPSTATUS status = MODULE_IFUNC(
                  Chronometry, Format, ParseDatePrefix)(&cursor, &gregorian,
                                                        &parsed);
              if (status != STATUS_CONST(SUCCESS)) {
                return status;
              }
              if (*cursor != '\0') {
                return STATUS_CONST(OUT_OF_RANGE);
              }
              *date = parsed;
              return STATUS_CONST(SUCCESS);
            }),

            OPERATION(Timestamp,
                      (const char *text,
                       MODULE_TYPE(Chronometry, Timestamp) *value), {
              if (text == NULL || value == NULL) {
                return STATUS_CONST(INVALID_ARGUMENT);
              }
              MODULE_TYPE(Chronometry, CalendarPolicy) gregorian =
                  MODULE_FUNC(Chronometry, Calendar, GregorianPolicy)();
              const char *cursor = text;
              MODULE_TYPE(Chronometry, Timestamp) parsed = {0};
              OPSTATUS status = MODULE_IFUNC(
                  Chronometry, Format, ParseDatePrefix)(&cursor, &gregorian,
                                                        &parsed.date);
              if (status != STATUS_CONST(SUCCESS)) {
                return status;
              }
              if (*cursor != 'T') {
                return STATUS_CONST(OUT_OF_RANGE);
              }
              ++cursor;
              status = MODULE_IFUNC(Chronometry, Format, ParseTimePrefix)(
                  &cursor, &parsed.time);
              if (status != STATUS_CONST(SUCCESS)) {
                return status;
              }
              if (*cursor != '\0') {
                return STATUS_CONST(OUT_OF_RANGE);
              }
              *value = parsed;
              return STATUS_CONST(SUCCESS);
            }),

            OPERATION(OffsetTimestamp,
                      (const char *text,
                       MODULE_TYPE(Chronometry, OffsetTimestamp) *value), {
              if (text == NULL || value == NULL) {
                return STATUS_CONST(INVALID_ARGUMENT);
              }
              MODULE_TYPE(Chronometry, CalendarPolicy) gregorian =
                  MODULE_FUNC(Chronometry, Calendar, GregorianPolicy)();
              const char *cursor = text;
              MODULE_TYPE(Chronometry, OffsetTimestamp) parsed = {0};
              OPSTATUS status = MODULE_IFUNC(
                  Chronometry, Format, ParseDatePrefix)(&cursor, &gregorian,
                                                        &parsed.local.date);
              if (status != STATUS_CONST(SUCCESS)) {
                return status;
              }
              if (*cursor != 'T') {
                return STATUS_CONST(OUT_OF_RANGE);
              }
              ++cursor;
              status = MODULE_IFUNC(Chronometry, Format, ParseTimePrefix)(
                  &cursor, &parsed.local.time);
              if (status != STATUS_CONST(SUCCESS)) {
                return status;
              }
              status = MODULE_IFUNC(Chronometry, Format, ParseOffsetSuffix)(
                  &cursor, &parsed.offset);
              if (status != STATUS_CONST(SUCCESS)) {
                return status;
              }
              if (*cursor != '\0') {
                return STATUS_CONST(OUT_OF_RANGE);
              }
              parsed.daylightSavings = false;
              *value = parsed;
              return STATUS_CONST(SUCCESS);
            }),

            OPERATION(Instant,
                      (const char *text,
                       MODULE_TYPE(Chronometry, Instant) *value), {
              if (text == NULL || value == NULL) {
                return STATUS_CONST(INVALID_ARGUMENT);
              }
              MODULE_TYPE(Chronometry, OffsetTimestamp) parsed = {0};
              OPSTATUS status = MODULE_FUNC(
                  Chronometry, Format, FromISOOffsetTimestamp)(text, &parsed);
              if (status != STATUS_CONST(SUCCESS)) {
                return status;
              }
              return MODULE_FUNC(Chronometry, Timezone, ToUTC)(parsed, value);
            }),

            OPERATION(Duration,
                        (const char *text,
                         MODULE_TYPE(Chronometry, Duration) *value), {
                if (text == NULL || value == NULL) {
                  return STATUS_CONST(INVALID_ARGUMENT);
                }
                const char *cursor = text;
                bool negative = false;
                if (*cursor == '-' || *cursor == '+') {
                  negative = (*cursor == '-');
                  ++cursor;
                }
                if (*cursor != 'P') {
                  return STATUS_CONST(OUT_OF_RANGE);
                }
                ++cursor;
                bool hasComponent = false;
                uint64_t totalNs = 0U;
                const uint64_t nsPerSec = (uint64_t)MODULE_CONST(
                    Chronometry, Duration, NANOSECONDS_PER_SECOND);
                const uint64_t secPerDay = (uint64_t)MODULE_CONST(
                    Chronometry, Duration, SECONDS_PER_DAY);
                const uint64_t secPerHour = (uint64_t)MODULE_CONST(
                    Chronometry, Duration, SECONDS_PER_HOUR);
                const uint64_t secPerMin = (uint64_t)MODULE_CONST(
                    Chronometry, Duration, SECONDS_PER_MINUTE);
                if (*cursor >= '0' && *cursor <= '9') {
                  uint64_t days = 0U;
                  if (!MODULE_IFUNC(Chronometry, Format, ParseUnsigned64)(
                          &cursor, &days) ||
                      *cursor != 'D') {
                    return STATUS_CONST(OUT_OF_RANGE);
                  }
                  ++cursor;
                  if (days > UINT64_MAX / (secPerDay * nsPerSec)) {
                    return STATUS_CONST(ARITHMETIC_OVERFLOW);
                  }
                  totalNs += days * secPerDay * nsPerSec;
                  hasComponent = true;
                }
                if (*cursor == 'T') {
                  ++cursor;
                  bool hasTimeComp = false;
                  while (*cursor >= '0' && *cursor <= '9') {
                    uint64_t part = 0U;
                    if (!MODULE_IFUNC(Chronometry, Format, ParseUnsigned64)(
                            &cursor, &part)) {
                      return STATUS_CONST(OUT_OF_RANGE);
                    }
                    if (*cursor == 'H') {
                      ++cursor;
                      uint64_t mult = secPerHour * nsPerSec;
                      if (part > (UINT64_MAX - totalNs) / mult) {
                        return STATUS_CONST(ARITHMETIC_OVERFLOW);
                      }
                      totalNs += part * mult;
                      hasTimeComp = true;
                    } else if (*cursor == 'M') {
                      ++cursor;
                      uint64_t mult = secPerMin * nsPerSec;
                      if (part > (UINT64_MAX - totalNs) / mult) {
                        return STATUS_CONST(ARITHMETIC_OVERFLOW);
                      }
                      totalNs += part * mult;
                      hasTimeComp = true;
                    } else if (*cursor == 'S' || *cursor == '.') {
                      if (part > (UINT64_MAX - totalNs) / nsPerSec) {
                        return STATUS_CONST(ARITHMETIC_OVERFLOW);
                      }
                      totalNs += part * nsPerSec;
                      if (*cursor == '.') {
                        ++cursor;
                        if (*cursor < '0' || *cursor > '9') {
                          return STATUS_CONST(OUT_OF_RANGE);
                        }
                        uint64_t fracNs = 0U;
                        size_t fracDigits = 0U;
                        const uint64_t base = (uint64_t)CNS(
                            Chronometry, Format, Internal, DECIMAL_BASE);
                        const size_t maxDigits = (size_t)CNS(
                            Chronometry, Format, Internal, NANOS_DIGITS);
                        while (*cursor >= '0' && *cursor <= '9') {
                          if (fracDigits >= maxDigits) {
                            return STATUS_CONST(OUT_OF_RANGE);
                          }
                          fracNs = fracNs * base + (uint64_t)(*cursor - '0');
                          ++fracDigits;
                          ++cursor;
                        }
                        for (size_t i = fracDigits; i < maxDigits; ++i) {
                          fracNs *= base;
                        }
                        if (fracNs > UINT64_MAX - totalNs) {
                          return STATUS_CONST(ARITHMETIC_OVERFLOW);
                        }
                        totalNs += fracNs;
                      }
                      if (*cursor != 'S') {
                        return STATUS_CONST(OUT_OF_RANGE);
                      }
                      ++cursor;
                      hasTimeComp = true;
                      break;
                    } else {
                      return STATUS_CONST(OUT_OF_RANGE);
                    }
                  }
                  if (!hasTimeComp) {
                    return STATUS_CONST(OUT_OF_RANGE);
                  }
                  hasComponent = true;
                }
                if (!hasComponent || *cursor != '\0') {
                  return STATUS_CONST(OUT_OF_RANGE);
                }
                if (negative) {
                  if (totalNs > (uint64_t)INT64_MAX + 1ULL) {
                    return STATUS_CONST(ARITHMETIC_OVERFLOW);
                  }
                  value->nanoseconds =
                      totalNs == (uint64_t)INT64_MAX + 1ULL
                          ? INT64_MIN
                          : -(int64_t)totalNs;
                } else {
                  if (totalNs > (uint64_t)INT64_MAX) {
                    return STATUS_CONST(ARITHMETIC_OVERFLOW);
                  }
                  value->nanoseconds = (int64_t)totalNs;
                }
                return STATUS_CONST(SUCCESS);
              })
        )
    )
);

/* EOF */