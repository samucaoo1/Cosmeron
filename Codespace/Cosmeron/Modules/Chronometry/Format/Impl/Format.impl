#pragma once

#include <stdio.h>
#include <string.h>

/* ========================================================================== */
/* 1. Internal Format Constants & Shared Helpers (Row-Tuple Pattern)          */
/* ========================================================================== */

#define CHRONOMETRY_FORMAT_INTERNAL_COL_NAME(NAME, VALUE) NAME
#define CHRONOMETRY_FORMAT_INTERNAL_COL_VALUE(NAME, VALUE) VALUE
#define CHRONOMETRY_FORMAT_INTERNAL_GET(FIELD, ROW)                            \
  PP_OP_CAT2(CHRONOMETRY_FORMAT_INTERNAL_COL_, FIELD) ROW

#define CHRONOMETRY_FORMAT_INTERNAL_TABLE(X)                                   \
  X((DATE_CAPACITY, 16))                                                       \
  X((DATETIME_CAPACITY, 32))                                                   \
  X((DATE_YEAR_MIN, -4194304))                                                 \
  X((DATE_YEAR_MAX, 4194303))

MODULE(DOMAIN(Modules), Chronometry,
    INTERNAL_EX(Format,
        ENUM(Const, CHRONOMETRY_FORMAT_INTERNAL_TABLE),

        OPERATION(GregorianPolicy,
                  (MODULE_TYPE(Chronometry, CalendarPolicy) *outPolicy), {
          return MODULE_FUNC(Chronometry, Calendar, SystemPolicy)(
              MODULE_CONST(Chronometry, Calendar, GREGORIAN), outPolicy);
        }),

        OPERATION(CopyFormatted,
                  (const char *formatted, size_t formattedSize, int written,
                   char *buffer, size_t capacity), {
          if (written < 0 || (size_t)written >= formattedSize ||
              (size_t)written >= capacity) {
            return STATUS_CONST(OUT_OF_RANGE);
          }
          memcpy(buffer, formatted, (size_t)written + 1U);
          return STATUS_CONST(SUCCESS);
        }),

        OPERATION(BuildValidDate,
                  (const MODULE_TYPE(Chronometry, CalendarPolicy) *policy,
                   int year, int month, int day,
                   MODULE_TYPE(Chronometry, Date) *outDate), {
          if (year < CNS(Chronometry, Format, Internal, DATE_YEAR_MIN) ||
              year > CNS(Chronometry, Format, Internal, DATE_YEAR_MAX) ||
              month < MODULE_CONST(Chronometry, Calendar, JANUARY) ||
              month > MODULE_CONST(Chronometry, Calendar, DECEMBER) ||
              day <= 0 ||
              day > MODULE_CONST(Chronometry, Calendar, DAYS_IN_JANUARY)) {
            return STATUS_CONST(OUT_OF_RANGE);
          }
          MODULE_TYPE(Chronometry, Date) candidate = {
              year, (uint8_t)month, (uint8_t)day};
          if (!MODULE_FUNC(Chronometry, Calendar, Date, IsValid)(policy,
                                                                 candidate)) {
            return STATUS_CONST(OUT_OF_RANGE);
          }
          *outDate = candidate;
          return STATUS_CONST(SUCCESS);
        })
    )
);

/* ========================================================================== */
/* 2. Package Implementation: Chronometry_Format                              */
/* ========================================================================== */

MODULE_IMPLEMENT(DOMAIN(Modules), Chronometry,
    PACKAGE(Format,
        SPACE(ISO,
              OPERATION(Date,
                        (MODULE_TYPE(Chronometry, Date) date, char *buffer,
                         size_t capacity), {
                if (buffer == NULL || capacity == 0U) {
                  return STATUS_CONST(INVALID_ARGUMENT);
                }
                MODULE_TYPE(Chronometry, CalendarPolicy) gregorian;
                OPSTATUS status = MODULE_IFUNC(Chronometry, Format,
                                               GregorianPolicy)(&gregorian);
                if (status != STATUS_CONST(SUCCESS)) {
                  return status;
                }
                if (!MODULE_FUNC(Chronometry, Calendar, Date, IsValid)(
                        &gregorian, date)) {
                  return STATUS_CONST(OUT_OF_RANGE);
                }
                char formatted[CNS(Chronometry, Format, Internal,
                                   DATE_CAPACITY)];
                int written = snprintf(formatted, sizeof(formatted),
                                       "%+05d-%02u-%02u", date.year,
                                       (unsigned)date.month,
                                       (unsigned)date.day);
                return MODULE_IFUNC(Chronometry, Format, CopyFormatted)(
                    formatted, sizeof(formatted), written, buffer, capacity);
              }),

              OPERATION(DateTime,
                        (MODULE_TYPE(Chronometry, TimeStamp) value,
                         char *buffer, size_t capacity), {
                if (buffer == NULL || capacity == 0U) {
                  return STATUS_CONST(INVALID_ARGUMENT);
                }
                MODULE_TYPE(Chronometry, CalendarPolicy) gregorian;
                OPSTATUS status = MODULE_IFUNC(Chronometry, Format,
                                               GregorianPolicy)(&gregorian);
                if (status != STATUS_CONST(SUCCESS)) {
                  return status;
                }
                if (!MODULE_FUNC(Chronometry, Timestamp, IsValid)(&gregorian,
                                                                   value)) {
                  return STATUS_CONST(OUT_OF_RANGE);
                }
                char formatted[CNS(Chronometry, Format, Internal,
                                   DATETIME_CAPACITY)];
                int written = snprintf(
                    formatted, sizeof(formatted),
                    "%+05d-%02u-%02uT%02u:%02u:%02u.%03u", value.date.year,
                    (unsigned)value.date.month, (unsigned)value.date.day,
                    (unsigned)value.time.hour, (unsigned)value.time.minute,
                    (unsigned)value.time.second,
                    (unsigned)value.time.millisecond);
                return MODULE_IFUNC(Chronometry, Format, CopyFormatted)(
                    formatted, sizeof(formatted), written, buffer, capacity);
              }),

              OPERATION(ParseDate,
                        (const char *text,
                         MODULE_TYPE(Chronometry, Date) *date), {
                if (text == NULL || date == NULL) {
                  return STATUS_CONST(INVALID_ARGUMENT);
                }
                int year = 0;
                int month = 0;
                int day = 0;
                int consumed = 0;
                if (sscanf(text, "%d-%d-%d%n", &year, &month, &day,
                           &consumed) != 3 ||
                    text[consumed] != '\0') {
                  return STATUS_CONST(OUT_OF_RANGE);
                }
                MODULE_TYPE(Chronometry, CalendarPolicy) gregorian;
                OPSTATUS status = MODULE_IFUNC(Chronometry, Format,
                                               GregorianPolicy)(&gregorian);
                if (status != STATUS_CONST(SUCCESS)) {
                  return status;
                }
                return MODULE_IFUNC(Chronometry, Format, BuildValidDate)(
                    &gregorian, year, month, day, date);
              }),

              OPERATION(ParseDateTime,
                        (const char *text,
                         MODULE_TYPE(Chronometry, TimeStamp) *value), {
                if (text == NULL || value == NULL) {
                  return STATUS_CONST(INVALID_ARGUMENT);
                }
                int year = 0;
                int month = 0;
                int day = 0;
                int hour = 0;
                int minute = 0;
                int second = 0;
                int millisecond = 0;
                int consumed = 0;
                if (sscanf(text, "%d-%d-%dT%d:%d:%d.%d%n", &year, &month, &day,
                           &hour, &minute, &second, &millisecond,
                           &consumed) != 7 ||
                    text[consumed] != '\0' || hour < 0 ||
                    hour >=
                        MODULE_CONST(Chronometry, Duration, HOURS_PER_DAY) ||
                    minute < 0 ||
                    minute >=
                        MODULE_CONST(Chronometry, Duration, MINUTES_PER_HOUR) ||
                    second < 0 ||
                    second >= MODULE_CONST(Chronometry, Duration,
                                           SECONDS_PER_MINUTE) ||
                    millisecond < 0 ||
                    millisecond >= MODULE_CONST(Chronometry, Duration,
                                                MILLISECONDS_PER_SECOND)) {
                  return STATUS_CONST(OUT_OF_RANGE);
                }
                MODULE_TYPE(Chronometry, CalendarPolicy) gregorian;
                OPSTATUS status = MODULE_IFUNC(Chronometry, Format,
                                               GregorianPolicy)(&gregorian);
                if (status != STATUS_CONST(SUCCESS)) {
                  return status;
                }
                MODULE_TYPE(Chronometry, TimeStamp) candidate = {
                    .time = {(uint16_t)millisecond, (uint8_t)second,
                             (uint8_t)minute, (uint8_t)hour}};
                status = MODULE_IFUNC(Chronometry, Format, BuildValidDate)(
                    &gregorian, year, month, day, &candidate.date);
                if (status != STATUS_CONST(SUCCESS)) {
                  return status;
                }
                *value = candidate;
                return STATUS_CONST(SUCCESS);
              })
        )
    )
);

/* EOF */
