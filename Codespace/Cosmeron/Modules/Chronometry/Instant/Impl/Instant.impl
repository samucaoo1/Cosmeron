#pragma once

#include <limits.h>
#if OS_WINDOWS
#include <windows.h>
#else
#include <time.h>
#endif

/* ========================================================================== */
/* 1. Platform Wall-Clock Backend (Detect.h + INTERNAL_EX)                    */
/* ========================================================================== */

#if OS_WINDOWS
#define CHRONOMETRY_INSTANT_INTERNAL_COL_NAME(NAME, VALUE) NAME
#define CHRONOMETRY_INSTANT_INTERNAL_COL_VALUE(NAME, VALUE) VALUE
#define CHRONOMETRY_INSTANT_INTERNAL_GET(FIELD, ROW)                           \
  PP_OP_CAT2(CHRONOMETRY_INSTANT_INTERNAL_COL_, FIELD) ROW

#define CHRONOMETRY_INSTANT_INTERNAL_TABLE(X)                                  \
  X((FILETIME_UNIX_EPOCH_SECONDS, 11644473600LL))                              \
  X((FILETIME_TICKS_PER_SECOND, 10000000LL))                                   \
  X((NANOSECONDS_PER_FILETIME_TICK, 100LL))

MODULE(DOMAIN(Modules), Chronometry,
    INTERNAL_EX(Instant,
        OPERATION(ReadWallClock,
                  (MODULE_TYPE(Chronometry, Instant) *outResult), {
          FILETIME ft;
          GetSystemTimeAsFileTime(&ft);
          uint64_t ticks =
              ((uint64_t)ft.dwHighDateTime << 32U) | (uint64_t)ft.dwLowDateTime;
          const uint64_t ticksPerSec = (uint64_t)10000000ULL;
          const int64_t epochDelta = 11644473600LL;
          const uint64_t nsPerTick = 100ULL;
          outResult->seconds = (int64_t)(ticks / ticksPerSec) - epochDelta;
          outResult->nanoseconds =
              (uint32_t)((ticks % ticksPerSec) * nsPerTick);
          return STATUS_CONST(SUCCESS);
        })
    )
);
#else
MODULE(DOMAIN(Modules), Chronometry,
    INTERNAL_EX(Instant,
        OPERATION(ReadWallClock,
                  (MODULE_TYPE(Chronometry, Instant) *outResult), {
          struct timespec value;
          if (clock_gettime(CLOCK_REALTIME, &value) != 0) {
            return STATUS_CONST(GENERIC_ERROR);
          }
          const int64_t nsPerSec =
              MODULE_CONST(Chronometry, Duration, NANOSECONDS_PER_SECOND);
          if (value.tv_nsec < 0 || value.tv_nsec >= nsPerSec) {
            return STATUS_CONST(GENERIC_ERROR);
          }
          outResult->seconds = (int64_t)value.tv_sec;
          outResult->nanoseconds = (uint32_t)value.tv_nsec;
          return STATUS_CONST(SUCCESS);
        })
    )
);
#endif

/* ========================================================================== */
/* 2. Package Implementation: Chronometry_Instant                             */
/* ========================================================================== */

MODULE_IMPLEMENT(DOMAIN(Modules), Chronometry,
    PACKAGE(Instant,
        OPERATION(Now, (MODULE_TYPE(Chronometry, Instant) *outResult), {
          if (outResult == NULL) {
            return STATUS_CONST(INVALID_ARGUMENT);
          }
          return MODULE_IFUNC(Chronometry, Instant, ReadWallClock)(outResult);
        }),

        PREDICATE(IsValid, (MODULE_TYPE(Chronometry, Instant) instant), {
          return instant.nanoseconds <
                 (uint32_t)MODULE_CONST(Chronometry, Duration,
                                        NANOSECONDS_PER_SECOND);
        }),

        COMPARISON(Compare,
                   (MODULE_TYPE(Chronometry, Instant) left,
                    MODULE_TYPE(Chronometry, Instant) right), {
          if (left.seconds < right.seconds) {
            return COMPARISON_CONST(LOWER);
          }
          if (left.seconds > right.seconds) {
            return COMPARISON_CONST(HIGHER);
          }
          if (left.nanoseconds < right.nanoseconds) {
            return COMPARISON_CONST(LOWER);
          }
          if (left.nanoseconds > right.nanoseconds) {
            return COMPARISON_CONST(HIGHER);
          }
          return COMPARISON_CONST(EQUAL);
        }),

        OPERATION(AddDuration,
                  (MODULE_TYPE(Chronometry, Instant) instant,
                   MODULE_TYPE(Chronometry, Duration) duration,
                   MODULE_TYPE(Chronometry, Instant) *outResult), {
          if (outResult == NULL ||
              !MODULE_FUNC(Chronometry, Instant, IsValid)(instant)) {
            return STATUS_CONST(INVALID_ARGUMENT);
          }
          const int64_t nsPerSec =
              MODULE_CONST(Chronometry, Duration, NANOSECONDS_PER_SECOND);
          int64_t whole = duration.nanoseconds / nsPerSec;
          int64_t remainder = duration.nanoseconds % nsPerSec;
          if ((whole > 0 && instant.seconds > INT64_MAX - whole) ||
              (whole < 0 && instant.seconds < INT64_MIN - whole)) {
            return STATUS_CONST(ARITHMETIC_OVERFLOW);
          }
          int64_t seconds = instant.seconds + whole;
          int64_t nanos = (int64_t)instant.nanoseconds + remainder;
          if (nanos >= nsPerSec) {
            if (seconds == INT64_MAX) {
              return STATUS_CONST(ARITHMETIC_OVERFLOW);
            }
            ++seconds;
            nanos -= nsPerSec;
          } else if (nanos < 0) {
            if (seconds == INT64_MIN) {
              return STATUS_CONST(ARITHMETIC_OVERFLOW);
            }
            --seconds;
            nanos += nsPerSec;
          }
          *outResult =
              (MODULE_TYPE(Chronometry, Instant)){seconds, (uint32_t)nanos};
          return STATUS_CONST(SUCCESS);
        }),

        OPERATION(DurationBetween,
                  (MODULE_TYPE(Chronometry, Instant) start,
                   MODULE_TYPE(Chronometry, Instant) end,
                   MODULE_TYPE(Chronometry, Duration) *outResult), {
          if (outResult == NULL ||
              !MODULE_FUNC(Chronometry, Instant, IsValid)(start) ||
              !MODULE_FUNC(Chronometry, Instant, IsValid)(end)) {
            return STATUS_CONST(INVALID_ARGUMENT);
          }
          const int64_t nsPerSec =
              MODULE_CONST(Chronometry, Duration, NANOSECONDS_PER_SECOND);
          if ((start.seconds < 0 && end.seconds > INT64_MAX + start.seconds) ||
              (start.seconds > 0 && end.seconds < INT64_MIN + start.seconds)) {
            return STATUS_CONST(ARITHMETIC_OVERFLOW);
          }
          int64_t seconds = end.seconds - start.seconds;
          int64_t nanos = (int64_t)end.nanoseconds - (int64_t)start.nanoseconds;
          if (nanos < 0) {
            if (seconds == INT64_MIN) {
              return STATUS_CONST(ARITHMETIC_OVERFLOW);
            }
            --seconds;
            nanos += nsPerSec;
          }
          if (seconds > INT64_MAX / nsPerSec ||
              seconds < INT64_MIN / nsPerSec ||
              (seconds == INT64_MAX / nsPerSec &&
               nanos > INT64_MAX % nsPerSec)) {
            return STATUS_CONST(ARITHMETIC_OVERFLOW);
          }
          outResult->nanoseconds = seconds * nsPerSec + nanos;
          return STATUS_CONST(SUCCESS);
        })
    )
);

/* EOF */
