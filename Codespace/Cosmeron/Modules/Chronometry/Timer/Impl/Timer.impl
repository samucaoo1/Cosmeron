#pragma once

/* ========================================================================== */
/* 1. Internal Anchor Measurement Helper                                      */
/* ========================================================================== */

MODULE(DOMAIN(Modules), Chronometry,
    INTERNAL_EX(Timer,
        OPERATION(MeasureAndAdvance,
                  (MODULE_TYPE(Chronometry, ClockTimePoint) *anchor,
                   MODULE_TYPE(Chronometry, Duration) *outElapsed), {
          if (anchor == NULL || outElapsed == NULL) {
            return STATUS_CONST(INVALID_ARGUMENT);
          }
          MODULE_TYPE(Chronometry, ClockTimePoint) now;
          OPSTATUS status = MODULE_FUNC(Chronometry, Clock, Now)(&now);
          if (status != STATUS_CONST(SUCCESS)) {
            return status;
          }
          status = MODULE_FUNC(Chronometry, Clock, DurationBetween)(
              *anchor, now, outElapsed);
          if (status == STATUS_CONST(SUCCESS)) {
            *anchor = now;
          }
          return status;
        })
    )
);

/* ========================================================================== */
/* 2. Package Implementation: Chronometry_Timer                               */
/* ========================================================================== */

MODULE_IMPLEMENT(DOMAIN(Modules), Chronometry,
    PACKAGE(Timer,
        OPERATION(Start, (MODULE_TYPE(Chronometry, Timer) *timer), {
          if (timer == NULL) {
            return STATUS_CONST(INVALID_ARGUMENT);
          }
          return MODULE_FUNC(Chronometry, Clock, Now)(&timer->start);
        }),

        OPERATION(Elapsed,
                  (const MODULE_TYPE(Chronometry, Timer) *timer,
                   MODULE_TYPE(Chronometry, Duration) *outElapsed), {
          if (timer == NULL || outElapsed == NULL) {
            return STATUS_CONST(INVALID_ARGUMENT);
          }
          MODULE_TYPE(Chronometry, ClockTimePoint) now;
          OPSTATUS status = MODULE_FUNC(Chronometry, Clock, Now)(&now);
          if (status != STATUS_CONST(SUCCESS)) {
            return status;
          }
          return MODULE_FUNC(Chronometry, Clock, DurationBetween)(
              timer->start, now, outElapsed);
        }),

        OPERATION(Restart,
                  (MODULE_TYPE(Chronometry, Timer) *timer,
                   MODULE_TYPE(Chronometry, Duration) *outElapsed), {
          if (timer == NULL) {
            return STATUS_CONST(INVALID_ARGUMENT);
          }
          return MODULE_IFUNC(Chronometry, Timer, MeasureAndAdvance)(
              &timer->start, outElapsed);
        }),

        SPACE(Delta,
              OPERATION(Start, (MODULE_TYPE(Chronometry, Delta) *delta), {
                if (delta == NULL) {
                  return STATUS_CONST(INVALID_ARGUMENT);
                }
                return MODULE_FUNC(Chronometry, Clock, Now)(&delta->previous);
              }),

              OPERATION(Update,
                        (MODULE_TYPE(Chronometry, Delta) *delta,
                         MODULE_TYPE(Chronometry, Duration) *outElapsed), {
                if (delta == NULL) {
                  return STATUS_CONST(INVALID_ARGUMENT);
                }
                return MODULE_IFUNC(Chronometry, Timer, MeasureAndAdvance)(
                    &delta->previous, outElapsed);
              })
        ),

        SPACE(FrameLimiter,
              OPERATION(Create,
                        (MODULE_TYPE(Chronometry, Duration) target,
                         MODULE_TYPE(Chronometry, FrameLimiter) *outLimiter), {
                if (outLimiter == NULL || target.nanoseconds <= 0) {
                  return STATUS_CONST(INVALID_ARGUMENT);
                }
                outLimiter->target = target;
                outLimiter->frameStart.nanoseconds = 0U;
                return STATUS_CONST(SUCCESS);
              }),

              OPERATION(FromFPS,
                        (uint32_t fps,
                         MODULE_TYPE(Chronometry, FrameLimiter) *outLimiter), {
                if (outLimiter == NULL || fps == 0U) {
                  return STATUS_CONST(INVALID_ARGUMENT);
                }
                return MODULE_FUNC(Chronometry, Timer, FrameLimiter, Create)(
                    MODULE_FUNC(Chronometry, Duration, FromNanoseconds)(
                        MODULE_CONST(Chronometry, Duration,
                                     NANOSECONDS_PER_SECOND) /
                        fps),
                    outLimiter);
              }),

              OPERATION(Begin,
                        (MODULE_TYPE(Chronometry, FrameLimiter) *limiter), {
                if (limiter == NULL) {
                  return STATUS_CONST(INVALID_ARGUMENT);
                }
                return MODULE_FUNC(Chronometry, Clock, Now)(
                    &limiter->frameStart);
              }),

              OPERATION(Remaining,
                        (const MODULE_TYPE(Chronometry, FrameLimiter) *limiter,
                         MODULE_TYPE(Chronometry, Duration) *outRemaining), {
                if (limiter == NULL || outRemaining == NULL ||
                    limiter->frameStart.nanoseconds == 0U) {
                  return STATUS_CONST(INVALID_ARGUMENT);
                }
                MODULE_TYPE(Chronometry, ClockTimePoint) now;
                OPSTATUS status = MODULE_FUNC(Chronometry, Clock, Now)(&now);
                if (status != STATUS_CONST(SUCCESS)) {
                  return status;
                }
                MODULE_TYPE(Chronometry, Duration) elapsed;
                status = MODULE_FUNC(Chronometry, Clock, DurationBetween)(
                    limiter->frameStart, now, &elapsed);
                if (status != STATUS_CONST(SUCCESS)) {
                  return status;
                }
                outRemaining->nanoseconds =
                    limiter->target.nanoseconds - elapsed.nanoseconds;
                if (outRemaining->nanoseconds < 0) {
                  outRemaining->nanoseconds = 0;
                }
                return STATUS_CONST(SUCCESS);
              })
        )
    )
);

/* EOF */
