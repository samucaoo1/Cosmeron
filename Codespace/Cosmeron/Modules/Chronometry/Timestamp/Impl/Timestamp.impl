#pragma once

#include <limits.h>

/* ========================================================================== */
/* 1. Internal Time-of-Day Conversion Helpers                                 */
/* ========================================================================== */

MODULE(DOMAIN(Modules), Chronometry,
    INTERNAL_EX(Timestamp,
        FUNCTION(int64_t, MillisecondsOfDay,
                 (MODULE_TYPE(Chronometry, TimeOfDay) time), {
          return (((int64_t)time.hour *
                       MODULE_CONST(Chronometry, Duration, MINUTES_PER_HOUR) +
                   time.minute) *
                      MODULE_CONST(Chronometry, Duration, SECONDS_PER_MINUTE) +
                  time.second) *
                     MODULE_CONST(Chronometry, Duration,
                                  MILLISECONDS_PER_SECOND) +
                 time.millisecond;
        }),

        FUNCTION(MODULE_TYPE(Chronometry, TimeOfDay), TimeFromMilliseconds,
                 (int64_t milliseconds), {
          const int64_t msPerSec =
              MODULE_CONST(Chronometry, Duration, MILLISECONDS_PER_SECOND);
          const int64_t msPerMin =
              (int64_t)MODULE_CONST(Chronometry, Duration, SECONDS_PER_MINUTE) *
              msPerSec;
          const int64_t msPerHour =
              (int64_t)MODULE_CONST(Chronometry, Duration, SECONDS_PER_HOUR) *
              msPerSec;
          MODULE_TYPE(Chronometry, TimeOfDay) result = {0};
          result.hour = (uint8_t)(milliseconds / msPerHour);
          milliseconds %= msPerHour;
          result.minute = (uint8_t)(milliseconds / msPerMin);
          milliseconds %= msPerMin;
          result.second = (uint8_t)(milliseconds / msPerSec);
          result.millisecond = (uint16_t)(milliseconds % msPerSec);
          return result;
        })
    )
);

/* ========================================================================== */
/* 2. Package Implementation: Chronometry_Timestamp                           */
/* ========================================================================== */

MODULE_IMPLEMENT(DOMAIN(Modules), Chronometry,
    PACKAGE(Timestamp,
        PREDICATE(IsValid,
                  (const MODULE_TYPE(Chronometry, CalendarPolicy) *policy,
                   MODULE_TYPE(Chronometry, Timestamp) value), {
          return MODULE_FUNC(Chronometry, Calendar, Date, IsValid)(
                     policy, value.date) &&
                 MODULE_FUNC(Chronometry, Timestamp, Time, IsValid)(value.time);
        }),

        COMPARISON(Compare,
                   (MODULE_TYPE(Chronometry, Timestamp) left,
                    MODULE_TYPE(Chronometry, Timestamp) right), {
          CMPOUT date = MODULE_FUNC(Chronometry, Calendar, Date, Compare)(
              left.date, right.date);
          if (date != COMPARISON_CONST(EQUAL)) {
            return date;
          }
          return MODULE_FUNC(Chronometry, Timestamp, Time, Compare)(
              left.time, right.time);
        }),

        OPERATION(AddDuration,
                  (const MODULE_TYPE(Chronometry, CalendarPolicy) *policy,
                   MODULE_TYPE(Chronometry, Timestamp) value,
                   MODULE_TYPE(Chronometry, Duration) duration,
                   MODULE_TYPE(Chronometry, Timestamp) *outResult), {
          if (outResult == NULL ||
              !MODULE_FUNC(Chronometry, Timestamp, IsValid)(policy, value)) {
            return STATUS_CONST(INVALID_ARGUMENT);
          }
          int64_t ordinal = 0;
          if (MODULE_FUNC(Chronometry, Calendar, Date, ToOrdinal)(
                  policy, value.date, &ordinal) != STATUS_CONST(SUCCESS)) {
            return STATUS_CONST(OUT_OF_RANGE);
          }
          const int64_t msPerDay =
              (int64_t)MODULE_CONST(Chronometry, Duration, SECONDS_PER_DAY) *
              MODULE_CONST(Chronometry, Duration, MILLISECONDS_PER_SECOND);
          const int64_t nsPerMs = MODULE_CONST(
              Chronometry, Duration, NANOSECONDS_PER_MILLISECOND);
          int64_t deltaMs =
              MODULE_IFUNC(Chronometry, FloorDiv)(duration.nanoseconds, nsPerMs);
          int64_t baseMs =
              MODULE_IFUNC(Chronometry, Timestamp, MillisecondsOfDay)(value.time);
          if ((deltaMs > 0 && baseMs > INT64_MAX - deltaMs) ||
              (deltaMs < 0 && baseMs < INT64_MIN - deltaMs)) {
            return STATUS_CONST(ARITHMETIC_OVERFLOW);
          }
          int64_t milliseconds = baseMs + deltaMs;
          int64_t dayDelta =
              MODULE_IFUNC(Chronometry, FloorDiv)(milliseconds, msPerDay);
          int64_t remainder = milliseconds - dayDelta * msPerDay;
          if ((dayDelta > 0 && ordinal > INT64_MAX - dayDelta) ||
              (dayDelta < 0 && ordinal < INT64_MIN - dayDelta)) {
            return STATUS_CONST(ARITHMETIC_OVERFLOW);
          }
          if (MODULE_FUNC(Chronometry, Calendar, Date, FromOrdinal)(
                  policy, ordinal + dayDelta, &outResult->date) !=
              STATUS_CONST(SUCCESS)) {
            return STATUS_CONST(OUT_OF_RANGE);
          }
          outResult->time = MODULE_IFUNC(Chronometry, Timestamp,
                                         TimeFromMilliseconds)(remainder);
          return STATUS_CONST(SUCCESS);
        }),

        OPERATION(Difference,
                  (const MODULE_TYPE(Chronometry, CalendarPolicy) *policy,
                   MODULE_TYPE(Chronometry, Timestamp) left,
                   MODULE_TYPE(Chronometry, Timestamp) right,
                   MODULE_TYPE(Chronometry, Duration) *outResult), {
          if (outResult == NULL ||
              !MODULE_FUNC(Chronometry, Timestamp, IsValid)(policy, left) ||
              !MODULE_FUNC(Chronometry, Timestamp, IsValid)(policy, right)) {
            return STATUS_CONST(INVALID_ARGUMENT);
          }
          int64_t days = 0;
          if (MODULE_FUNC(Chronometry, Calendar, Date, Difference)(
                  policy, left.date, right.date, &days) !=
              STATUS_CONST(SUCCESS)) {
            return STATUS_CONST(OUT_OF_RANGE);
          }
          const int64_t msPerDay =
              (int64_t)MODULE_CONST(Chronometry, Duration, SECONDS_PER_DAY) *
              MODULE_CONST(Chronometry, Duration, MILLISECONDS_PER_SECOND);
          if (days > INT64_MAX / msPerDay || days < INT64_MIN / msPerDay) {
            return STATUS_CONST(ARITHMETIC_OVERFLOW);
          }
          int64_t milliseconds =
              days * msPerDay +
              MODULE_IFUNC(Chronometry, Timestamp, MillisecondsOfDay)(
                  right.time) -
              MODULE_IFUNC(Chronometry, Timestamp, MillisecondsOfDay)(
                  left.time);
          const int64_t nsPerMs =
              MODULE_CONST(Chronometry, Duration, NANOSECONDS_PER_MILLISECOND);
          if (milliseconds > INT64_MAX / nsPerMs ||
              milliseconds < INT64_MIN / nsPerMs) {
            return STATUS_CONST(ARITHMETIC_OVERFLOW);
          }
          outResult->nanoseconds = milliseconds * nsPerMs;
          return STATUS_CONST(SUCCESS);
        }),

        SPACE(Time,
              PREDICATE(IsValid, (MODULE_TYPE(Chronometry, TimeOfDay) time), {
                return time.hour <
                           MODULE_CONST(Chronometry, Duration, HOURS_PER_DAY) &&
                       time.minute <
                           MODULE_CONST(Chronometry, Duration,
                                        MINUTES_PER_HOUR) &&
                       time.second <
                           MODULE_CONST(Chronometry, Duration,
                                        SECONDS_PER_MINUTE) &&
                       time.millisecond <
                           MODULE_CONST(Chronometry, Duration,
                                        MILLISECONDS_PER_SECOND);
              }),

              COMPARISON(Compare,
                         (MODULE_TYPE(Chronometry, TimeOfDay) left,
                          MODULE_TYPE(Chronometry, TimeOfDay) right), {
                int64_t leftMs =
                    MODULE_IFUNC(Chronometry, Timestamp, MillisecondsOfDay)(
                        left);
                int64_t rightMs =
                    MODULE_IFUNC(Chronometry, Timestamp, MillisecondsOfDay)(
                        right);
                if (leftMs < rightMs) {
                  return COMPARISON_CONST(LOWER);
                }
                if (leftMs > rightMs) {
                  return COMPARISON_CONST(HIGHER);
                }
                return COMPARISON_CONST(EQUAL);
              })
        )
    )
);

/* EOF */
