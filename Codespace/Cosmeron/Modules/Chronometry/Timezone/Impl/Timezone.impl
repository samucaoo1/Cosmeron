#pragma once

#include <string.h>
#if OS_WINDOWS
#include <windows.h>
#else
#include <time.h>
#endif

/* ========================================================================== */
/* 1. Internal Timezone Constants & Helpers (Row-Tuple Pattern)               */
/* ========================================================================== */

#define CHRONOMETRY_TIMEZONE_INTERNAL_COL_NAME(NAME, VALUE) NAME
#define CHRONOMETRY_TIMEZONE_INTERNAL_COL_VALUE(NAME, VALUE) VALUE
#define CHRONOMETRY_TIMEZONE_INTERNAL_GET(FIELD, ROW)                          \
  PP_OP_CAT2(CHRONOMETRY_TIMEZONE_INTERNAL_COL_, FIELD) ROW

#define CHRONOMETRY_TIMEZONE_INTERNAL_TABLE(X)                                 \
  X((MAX_OFFSET_MINUTES, 1439))                                                \
  X((MAX_DST_SAVINGS_MINUTES, 180))                                            \
  X((TM_YEAR_BASE, 1900))                                                      \
  X((TM_MONTH_BASE, 1))

MODULE(DOMAIN(Modules), Chronometry,
    ISTRUCT(ZoneNameEntry,
        FIELDS(
            const char *ianaName;
            MODULE_ENUM(Chronometry, Timezone, ZoneId) zoneId;
        )
    ),

    ISTRUCT(CountryEntry,
        FIELDS(
            const char *code;
            const char *name;
        )
    ),

    ISTRUCT(CountryZoneEntry,
        FIELDS(
            const char *code;
            MODULE_ENUM(Chronometry, Timezone, ZoneId) zoneId;
        )
    ),

    INTERNAL_EX(Timezone,
        ENUM(Const, CHRONOMETRY_TIMEZONE_INTERNAL_TABLE),

        OPERATION(OffsetDuration,
                  (MODULE_TYPE(Chronometry, UtcOffset) offset, int64_t sign,
                   MODULE_TYPE(Chronometry, Duration) *outDuration), {
          return MODULE_FUNC(Chronometry, Duration, FromSeconds)(
              sign * (int64_t)offset.minutesEastOfUtc *
                  MODULE_CONST(Chronometry, Duration, SECONDS_PER_MINUTE),
              outDuration);
        }),

        PREDICATE(IsTransitionRuleValid,
                  (MODULE_TYPE(Chronometry, DstTransitionRule) rule), {
          return rule.month >= MODULE_CONST(Chronometry, Calendar, JANUARY) &&
                 rule.month <= MODULE_CONST(Chronometry, Calendar, DECEMBER) &&
                 rule.anchorKind >=
                     MODULE_CONST(Chronometry, Calendar, WEEKDAY_EXACT) &&
                 rule.anchorKind <=
                     MODULE_CONST(Chronometry, Calendar, WEEKDAY_LAST) &&
                 rule.weekday >= MODULE_CONST(Chronometry, Calendar, MONDAY) &&
                 rule.weekday <= MODULE_CONST(Chronometry, Calendar, SUNDAY) &&
                 rule.localHour <=
                     MODULE_CONST(Chronometry, Duration, HOURS_PER_DAY) &&
                 (rule.localHour <
                      MODULE_CONST(Chronometry, Duration, HOURS_PER_DAY) ||
                  rule.localMinute == 0U) &&
                 rule.localMinute <
                     MODULE_CONST(Chronometry, Duration, MINUTES_PER_HOUR) &&
                 rule.timeBase >=
                     MODULE_CONST(Chronometry, Timezone, TIME_BASE_WALL) &&
                 rule.timeBase <=
                     MODULE_CONST(Chronometry, Timezone, TIME_BASE_UTC);
        }),

        OPERATION(TransitionTimestampForYear,
                  (int32_t year,
                   MODULE_TYPE(Chronometry, DstTransitionRule) rule,
                   MODULE_TYPE(Chronometry, Timestamp) *outTimestamp), {
          MODULE_TYPE(Chronometry, Date) date = {0};
          OPSTATUS status = MODULE_FUNC(
              Chronometry, Calendar, Date, FromWeekdayAnchor)(
              MODULE_CONST(Chronometry, Calendar, GREGORIAN), year, rule.month,
              rule.anchorKind, rule.anchorDay, rule.weekday, &date);
          if (status != STATUS_CONST(SUCCESS)) {
            return status;
          }
          uint8_t hour = rule.localHour;
          if (hour == MODULE_CONST(Chronometry, Duration, HOURS_PER_DAY)) {
            MODULE_TYPE(Chronometry, CalendarPolicy) gregorian =
                MODULE_FUNC(Chronometry, Calendar, GregorianPolicy)();
            int64_t ordinal = 0;
            status = MODULE_FUNC(Chronometry, Calendar, Date, ToOrdinal)(
                &gregorian, date, &ordinal);
            if (status != STATUS_CONST(SUCCESS)) {
              return status;
            }
            status = MODULE_FUNC(Chronometry, Calendar, Date, FromOrdinal)(
                &gregorian, ordinal + 1, &date);
            if (status != STATUS_CONST(SUCCESS)) {
              return status;
            }
            hour = 0U;
          }
          *outTimestamp = (MODULE_TYPE(Chronometry, Timestamp)){
              .date = date,
              .time = {.millisecond = 0U,
                       .second = 0U,
                       .minute = rule.localMinute,
                       .hour = hour}};
          return STATUS_CONST(SUCCESS);
        }),

        OPERATION(TransitionInstantForYear,
                  (int32_t year,
                   MODULE_TYPE(Chronometry, DstTransitionRule) rule,
                   MODULE_TYPE(Chronometry, UtcOffset) standardOffset,
                   MODULE_TYPE(Chronometry, UtcOffset) wallOffset,
                   MODULE_TYPE(Chronometry, Instant) *outInstant), {
          MODULE_TYPE(Chronometry, Timestamp) ts = {0};
          OPSTATUS status = MODULE_IFUNC(
              Chronometry, Timezone, TransitionTimestampForYear)(year, rule,
                                                                  &ts);
          if (status != STATUS_CONST(SUCCESS)) {
            return status;
          }
          MODULE_TYPE(Chronometry, UtcOffset) baseOffset = {0};
          if (rule.timeBase ==
              MODULE_CONST(Chronometry, Timezone, TIME_BASE_STANDARD)) {
            baseOffset = standardOffset;
          } else if (rule.timeBase ==
                     MODULE_CONST(Chronometry, Timezone, TIME_BASE_WALL)) {
            baseOffset = wallOffset;
          }
          MODULE_TYPE(Chronometry, OffsetTimestamp) ots = {
              .local = ts, .offset = baseOffset, .daylightSavings = false};
          return MODULE_FUNC(Chronometry, Timezone, ToUTC)(ots, outInstant);
        })
    )
);

#if OS_WINDOWS
MODULE(DOMAIN(Modules), Chronometry,
    INTERNAL_EX(Timezone,
        OPERATION(ReadSystemOffset,
                  (MODULE_TYPE(Chronometry, Instant) instant,
                   MODULE_TYPE(Chronometry, UtcOffset) *outOffset,
                   bool *outIsDst), {
          (void)instant;
          TIME_ZONE_INFORMATION tzi;
          DWORD mode = GetTimeZoneInformation(&tzi);
          if (mode == TIME_ZONE_ID_INVALID) {
            return STATUS_CONST(GENERIC_ERROR);
          }
          LONG bias = tzi.Bias;
          bool isDst = (mode == TIME_ZONE_ID_DAYLIGHT);
          bias += isDst ? tzi.DaylightBias : tzi.StandardBias;
          outOffset->minutesEastOfUtc = (int16_t)(-bias);
          if (outIsDst != NULL) {
            *outIsDst = isDst;
          }
          return STATUS_CONST(SUCCESS);
        })
    )
);
#else
MODULE(DOMAIN(Modules), Chronometry,
    INTERNAL_EX(Timezone,
        OPERATION(ReadSystemOffset,
                  (MODULE_TYPE(Chronometry, Instant) instant,
                   MODULE_TYPE(Chronometry, UtcOffset) *outOffset,
                   bool *outIsDst), {
          time_t sec = (time_t)instant.seconds;
          struct tm localTm;
          struct tm utcTm;
          if (localtime_r(&sec, &localTm) == NULL ||
              gmtime_r(&sec, &utcTm) == NULL) {
            return STATUS_CONST(GENERIC_ERROR);
          }
          const int32_t yearBase =
              CNS(Chronometry, Timezone, Internal, TM_YEAR_BASE);
          const int32_t monthBase =
              CNS(Chronometry, Timezone, Internal, TM_MONTH_BASE);
          MODULE_TYPE(Chronometry, Timestamp) localTs = {
              .date = {(int32_t)localTm.tm_year + yearBase,
                       (uint8_t)(localTm.tm_mon + monthBase),
                       (uint8_t)localTm.tm_mday},
              .time = {.millisecond = 0U,
                       .second = (uint8_t)localTm.tm_sec,
                       .minute = (uint8_t)localTm.tm_min,
                       .hour = (uint8_t)localTm.tm_hour}};
          MODULE_TYPE(Chronometry, Timestamp) utcTs = {
              .date = {(int32_t)utcTm.tm_year + yearBase,
                       (uint8_t)(utcTm.tm_mon + monthBase),
                       (uint8_t)utcTm.tm_mday},
              .time = {.millisecond = 0U,
                       .second = (uint8_t)utcTm.tm_sec,
                       .minute = (uint8_t)utcTm.tm_min,
                       .hour = (uint8_t)utcTm.tm_hour}};
          MODULE_TYPE(Chronometry, CalendarPolicy) gregorian =
              MODULE_FUNC(Chronometry, Calendar, GregorianPolicy)();
          MODULE_TYPE(Chronometry, Duration) diff = {0};
          OPSTATUS status = MODULE_FUNC(Chronometry, Timestamp, Difference)(
              &gregorian, utcTs, localTs, &diff);
          if (status != STATUS_CONST(SUCCESS)) {
            return status;
          }
          int64_t minutes =
              diff.nanoseconds /
              ((int64_t)MODULE_CONST(Chronometry, Duration, SECONDS_PER_MINUTE) *
               MODULE_CONST(Chronometry, Duration, NANOSECONDS_PER_SECOND));
          outOffset->minutesEastOfUtc = (int16_t)minutes;
          if (outIsDst != NULL) {
            *outIsDst = localTm.tm_isdst > 0;
          }
          return STATUS_CONST(SUCCESS);
        })
    )
);
#endif

/* ========================================================================== */
/* 2. X-Macro Zone & Country Lookup Tables                                    */
/* ========================================================================== */

#define COSMERON_MACRO_INTERNAL_CHRONOMETRY_BUILD_RULE(ROW)                    \
  (MODULE_TYPE(Chronometry, TimezoneRule)) {                                   \
    .ianaName = CHRONOMETRY_TIMEZONE_IANA_GET(IANA_NAME, ROW),                 \
    .standardOffset = {CHRONOMETRY_TIMEZONE_IANA_GET(STD_OFFSET_MIN, ROW)},    \
    .dstSavingsMinutes = CHRONOMETRY_TIMEZONE_IANA_GET(DST_SAVINGS_MIN, ROW),  \
    .start =                                                                   \
        {                                                                      \
            .month = MODULE_CONST(                                             \
                Chronometry, Calendar,                                         \
                CHRONOMETRY_TIMEZONE_IANA_GET(START_MONTH, ROW)),              \
            .anchorKind = MODULE_CONST(                                        \
                Chronometry, Calendar,                                         \
                CHRONOMETRY_TIMEZONE_IANA_GET(START_ANCHOR_KIND, ROW)),        \
            .anchorDay = CHRONOMETRY_TIMEZONE_IANA_GET(START_ANCHOR_DAY, ROW), \
            .weekday = MODULE_CONST(                                           \
                Chronometry, Calendar,                                         \
                CHRONOMETRY_TIMEZONE_IANA_GET(START_WEEKDAY, ROW)),            \
            .localHour = CHRONOMETRY_TIMEZONE_IANA_GET(START_HOUR, ROW),       \
            .localMinute = CHRONOMETRY_TIMEZONE_IANA_GET(START_MINUTE, ROW),   \
            .timeBase = MODULE_CONST(                                          \
                Chronometry, Timezone,                                         \
                CHRONOMETRY_TIMEZONE_IANA_GET(START_BASE, ROW)),               \
        },                                                                     \
    .end = {                                                                   \
        .month = MODULE_CONST(Chronometry, Calendar,                           \
                              CHRONOMETRY_TIMEZONE_IANA_GET(END_MONTH, ROW)),  \
        .anchorKind = MODULE_CONST(                                            \
            Chronometry, Calendar,                                             \
            CHRONOMETRY_TIMEZONE_IANA_GET(END_ANCHOR_KIND, ROW)),              \
        .anchorDay = CHRONOMETRY_TIMEZONE_IANA_GET(END_ANCHOR_DAY, ROW),       \
        .weekday = MODULE_CONST(                                               \
            Chronometry, Calendar,                                             \
            CHRONOMETRY_TIMEZONE_IANA_GET(END_WEEKDAY, ROW)),                  \
        .localHour = CHRONOMETRY_TIMEZONE_IANA_GET(END_HOUR, ROW),             \
        .localMinute = CHRONOMETRY_TIMEZONE_IANA_GET(END_MINUTE, ROW),         \
        .timeBase = MODULE_CONST(                                              \
            Chronometry, Timezone,                                             \
            CHRONOMETRY_TIMEZONE_IANA_GET(END_BASE, ROW)),                     \
    },                                                                         \
  }

#define COSMERON_MACRO_INTERNAL_CHRONOMETRY_ZONE_ID_CASE(ROW)                  \
  case MODULE_CONST(Chronometry, Timezone,                                     \
                    CHRONOMETRY_TIMEZONE_IANA_GET(ID, ROW)):                   \
    *outRule = COSMERON_MACRO_INTERNAL_CHRONOMETRY_BUILD_RULE(ROW);            \
    return STATUS_CONST(SUCCESS);

#define COSMERON_MACRO_INTERNAL_CHRONOMETRY_ZONE_NAME_ENTRY(ROW)               \
  {CHRONOMETRY_TIMEZONE_IANA_GET(IANA_NAME, ROW),                              \
   MODULE_CONST(Chronometry, Timezone,                                         \
                CHRONOMETRY_TIMEZONE_IANA_GET(ID, ROW))},

#define COSMERON_MACRO_INTERNAL_CHRONOMETRY_ZONE_LINK_ENTRY(ROW)               \
  {CHRONOMETRY_TIMEZONE_LINK_GET(ALIAS, ROW),                                  \
   MODULE_CONST(Chronometry, Timezone,                                         \
                CHRONOMETRY_TIMEZONE_LINK_GET(TARGET, ROW))},

#define COSMERON_MACRO_INTERNAL_CHRONOMETRY_COUNTRY_ENTRY(ROW)                 \
  {CHRONOMETRY_TIMEZONE_COUNTRY_GET(CODE, ROW),                                \
   CHRONOMETRY_TIMEZONE_COUNTRY_GET(NAME, ROW)},

#define COSMERON_MACRO_INTERNAL_CHRONOMETRY_COUNTRY_ZONE_ENTRY(ROW)            \
  {CHRONOMETRY_TIMEZONE_COUNTRY_ZONE_GET(CODE, ROW),                           \
   MODULE_CONST(Chronometry, Timezone,                                         \
                CHRONOMETRY_TIMEZONE_COUNTRY_ZONE_GET(ZONE_ID, ROW))},

static const MODULE_ITYPE(Chronometry, ZoneNameEntry)
    MODULE_IFUNC(Chronometry, Timezone, ZoneNameEntries)[] = {
        CHRONOMETRY_TIMEZONE_IANA_TABLE(
            COSMERON_MACRO_INTERNAL_CHRONOMETRY_ZONE_NAME_ENTRY)
};

static const MODULE_ITYPE(Chronometry, ZoneNameEntry)
    MODULE_IFUNC(Chronometry, Timezone, ZoneLinkEntries)[] = {
        CHRONOMETRY_TIMEZONE_LINK_TABLE(
            COSMERON_MACRO_INTERNAL_CHRONOMETRY_ZONE_LINK_ENTRY)
};

static const MODULE_ITYPE(Chronometry, CountryEntry)
    MODULE_IFUNC(Chronometry, Timezone, CountryEntries)[] = {
        CHRONOMETRY_TIMEZONE_COUNTRY_TABLE(
            COSMERON_MACRO_INTERNAL_CHRONOMETRY_COUNTRY_ENTRY)
};

static const MODULE_ITYPE(Chronometry, CountryZoneEntry)
    MODULE_IFUNC(Chronometry, Timezone, CountryZoneEntries)[] = {
        CHRONOMETRY_TIMEZONE_COUNTRY_ZONE_TABLE(
            COSMERON_MACRO_INTERNAL_CHRONOMETRY_COUNTRY_ZONE_ENTRY)
};

static inline OPSTATUS MODULE_IFUNC(Chronometry, Timezone, RuleById)(
    MODULE_ENUM(Chronometry, Timezone, ZoneId) zoneId,
    MODULE_TYPE(Chronometry, TimezoneRule) *outRule) {
  switch (zoneId) {
    CHRONOMETRY_TIMEZONE_IANA_TABLE(
        COSMERON_MACRO_INTERNAL_CHRONOMETRY_ZONE_ID_CASE)
  default:
    return STATUS_CONST(OUT_OF_RANGE);
  }
}

static inline bool MODULE_IFUNC(Chronometry, Timezone, CountryRange)(
    const char *countryCode, size_t *outStart, size_t *outCount) {
  const size_t total =
      sizeof(MODULE_IFUNC(Chronometry, Timezone, CountryZoneEntries)) /
      sizeof(MODULE_IFUNC(Chronometry, Timezone, CountryZoneEntries)[0]);
  size_t low = 0U;
  size_t high = total;
  while (low < high) {
    size_t mid = low + (high - low) / 2U;
    int cmp = strcmp(
        MODULE_IFUNC(Chronometry, Timezone, CountryZoneEntries)[mid].code,
        countryCode);
    if (cmp < 0) {
      low = mid + 1U;
    } else {
      high = mid;
    }
  }
  if (low >= total ||
      strcmp(MODULE_IFUNC(Chronometry, Timezone, CountryZoneEntries)[low].code,
             countryCode) != 0) {
    return false;
  }
  size_t end = low + 1U;
  while (end < total &&
         strcmp(MODULE_IFUNC(Chronometry, Timezone, CountryZoneEntries)[end]
                    .code,
                countryCode) == 0) {
    ++end;
  }
  *outStart = low;
  *outCount = end - low;
  return true;
}

/* ========================================================================== */
/* 3. Package Implementation: Chronometry_Timezone                            */
/* ========================================================================== */

MODULE_IMPLEMENT(DOMAIN(Modules), Chronometry,
    PACKAGE(Timezone,
        OPERATION(ToUTC,
                  (MODULE_TYPE(Chronometry, OffsetTimestamp) value,
                   MODULE_TYPE(Chronometry, Instant) *instant), {
          if (instant == NULL ||
              !MODULE_FUNC(Chronometry, Timezone, Offset, IsValid)(
                  value.offset)) {
            return STATUS_CONST(INVALID_ARGUMENT);
          }
          MODULE_TYPE(Chronometry, Instant) local;
          OPSTATUS status =
              MODULE_FUNC(Chronometry, Epoch, TimestampToUnix)(value.local,
                                                               &local);
          if (status != STATUS_CONST(SUCCESS)) {
            return status;
          }
          MODULE_TYPE(Chronometry, Duration) offset;
          status = MODULE_IFUNC(Chronometry, Timezone, OffsetDuration)(
              value.offset, -1, &offset);
          return status == STATUS_CONST(SUCCESS)
                     ? MODULE_FUNC(Chronometry, Instant, AddDuration)(
                           local, offset, instant)
                     : status;
        }),

        VARIANT(FromUTC,
            OPERATION((MODULE_TYPE(Chronometry, Instant) instant,
                       MODULE_TYPE(Chronometry, UtcOffset) offset,
                       MODULE_TYPE(Chronometry, OffsetTimestamp) *value), {
              if (value == NULL ||
                  !MODULE_FUNC(Chronometry, Timezone, Offset, IsValid)(offset)) {
                return STATUS_CONST(INVALID_ARGUMENT);
              }
              MODULE_TYPE(Chronometry, Duration) duration;
              OPSTATUS status = MODULE_IFUNC(
                  Chronometry, Timezone, OffsetDuration)(offset, 1, &duration);
              if (status != STATUS_CONST(SUCCESS)) {
                return status;
              }
              MODULE_TYPE(Chronometry, Instant) local;
              status = MODULE_FUNC(Chronometry, Instant, AddDuration)(
                  instant, duration, &local);
              if (status != STATUS_CONST(SUCCESS)) {
                return status;
              }
              status = MODULE_FUNC(Chronometry, Epoch, TimestampFromUnix)(
                  local, &value->local);
              if (status == STATUS_CONST(SUCCESS)) {
                value->offset = offset;
                value->daylightSavings = false;
              }
              return status;
            }),

            OPERATION(WithRule,
                      (MODULE_TYPE(Chronometry, Instant) instant,
                       const MODULE_TYPE(Chronometry, TimezoneRule) *rule,
                       MODULE_TYPE(Chronometry, OffsetTimestamp) *value), {
              if (rule == NULL || value == NULL ||
                  !MODULE_FUNC(Chronometry, Timezone, Zone, IsRuleValid)(rule)) {
                return STATUS_CONST(INVALID_ARGUMENT);
              }
              if (rule->dstSavingsMinutes == 0) {
                return MODULE_FUNC(Chronometry, Timezone, FromUTC)(
                    instant, rule->standardOffset, value);
              }
              MODULE_TYPE(Chronometry, OffsetTimestamp) stdLocal = {0};
              OPSTATUS status = MODULE_FUNC(Chronometry, Timezone, FromUTC)(
                  instant, rule->standardOffset, &stdLocal);
              if (status != STATUS_CONST(SUCCESS)) {
                return status;
              }
              MODULE_TYPE(Chronometry, UtcOffset) dstOffset = {
                  (int16_t)(rule->standardOffset.minutesEastOfUtc +
                            rule->dstSavingsMinutes)};
              MODULE_TYPE(Chronometry, Instant) startUtc = {0};
              MODULE_TYPE(Chronometry, Instant) endUtc = {0};
              status = MODULE_IFUNC(
                  Chronometry, Timezone, TransitionInstantForYear)(
                  stdLocal.local.date.year, rule->start, rule->standardOffset,
                  rule->standardOffset, &startUtc);
              if (status != STATUS_CONST(SUCCESS)) {
                return status;
              }
              status = MODULE_IFUNC(
                  Chronometry, Timezone, TransitionInstantForYear)(
                  stdLocal.local.date.year, rule->end, rule->standardOffset,
                  dstOffset, &endUtc);
              if (status != STATUS_CONST(SUCCESS)) {
                return status;
              }
              bool isDst = false;
              if (MODULE_FUNC(Chronometry, Instant, Compare)(
                      startUtc, endUtc) == COMPARISON_CONST(LOWER)) {
                isDst = MODULE_FUNC(Chronometry, Instant, Compare)(
                            instant, startUtc) != COMPARISON_CONST(LOWER) &&
                        MODULE_FUNC(Chronometry, Instant, Compare)(
                            instant, endUtc) == COMPARISON_CONST(LOWER);
              } else {
                isDst = MODULE_FUNC(Chronometry, Instant, Compare)(
                            instant, startUtc) != COMPARISON_CONST(LOWER) ||
                        MODULE_FUNC(Chronometry, Instant, Compare)(
                            instant, endUtc) == COMPARISON_CONST(LOWER);
              }
              MODULE_TYPE(Chronometry, UtcOffset) effectiveOffset =
                  isDst ? dstOffset : rule->standardOffset;
              status = MODULE_FUNC(Chronometry, Timezone, FromUTC)(
                  instant, effectiveOffset, value);
              if (status == STATUS_CONST(SUCCESS)) {
                value->daylightSavings = isDst;
              }
              return status;
            }),

            OPERATION(WithZone,
                      (MODULE_TYPE(Chronometry, Instant) instant,
                       MODULE_ENUM(Chronometry, Timezone, ZoneId) zoneId,
                       MODULE_TYPE(Chronometry, OffsetTimestamp) *value), {
              MODULE_TYPE(Chronometry, TimezoneRule) rule = {0};
              OPSTATUS status = MODULE_FUNC(
                  Chronometry, Timezone, Zone, FromId)(zoneId, &rule);
              if (status != STATUS_CONST(SUCCESS)) {
                return status;
              }
              return MODULE_FUNC(Chronometry, Timezone, FromUTCWithRule)(
                  instant, &rule, value);
            })
        ),

        OPERATION(SystemOffsetAt,
                  (MODULE_TYPE(Chronometry, Instant) instant,
                   MODULE_TYPE(Chronometry, UtcOffset) *outOffset,
                   bool *outIsDst), {
          if (outOffset == NULL ||
              !MODULE_FUNC(Chronometry, Instant, IsValid)(instant)) {
            return STATUS_CONST(INVALID_ARGUMENT);
          }
          return MODULE_IFUNC(Chronometry, Timezone, ReadSystemOffset)(
              instant, outOffset, outIsDst);
        }),

        OPERATION(SystemNow,
                  (MODULE_TYPE(Chronometry, OffsetTimestamp) *outValue), {
          if (outValue == NULL) {
            return STATUS_CONST(INVALID_ARGUMENT);
          }
          MODULE_TYPE(Chronometry, Instant) now = {0};
          OPSTATUS status = MODULE_FUNC(Chronometry, Instant, Now)(&now);
          if (status != STATUS_CONST(SUCCESS)) {
            return status;
          }
          MODULE_TYPE(Chronometry, UtcOffset) offset = {0};
          bool isDst = false;
          status = MODULE_FUNC(Chronometry, Timezone, SystemOffsetAt)(
              now, &offset, &isDst);
          if (status != STATUS_CONST(SUCCESS)) {
            return status;
          }
          status = MODULE_FUNC(Chronometry, Timezone, FromUTC)(
              now, offset, outValue);
          if (status == STATUS_CONST(SUCCESS)) {
            outValue->daylightSavings = isDst;
          }
          return status;
        }),

        SPACE(Offset,
              PREDICATE(IsValid, (MODULE_TYPE(Chronometry, UtcOffset) offset), {
                const int16_t maxOffset = (int16_t)CNS(
                    Chronometry, Timezone, Internal, MAX_OFFSET_MINUTES);
                return offset.minutesEastOfUtc >= -maxOffset &&
                       offset.minutesEastOfUtc <= maxOffset;
              }),

              OPERATION(FromHoursMinutes,
                        (int8_t hours, int8_t minutes,
                         MODULE_TYPE(Chronometry, UtcOffset) *outOffset), {
                if (outOffset == NULL) {
                  return STATUS_CONST(INVALID_ARGUMENT);
                }
                const int8_t minPerHour = (int8_t)MODULE_CONST(
                    Chronometry, Duration, MINUTES_PER_HOUR);
                if (minutes <= -minPerHour || minutes >= minPerHour ||
                    (hours > 0 && minutes < 0) ||
                    (hours < 0 && minutes > 0)) {
                  return STATUS_CONST(INVALID_ARGUMENT);
                }
                int32_t total = (int32_t)hours * minPerHour + (int32_t)minutes;
                const int32_t maxOffset = (int32_t)CNS(
                    Chronometry, Timezone, Internal, MAX_OFFSET_MINUTES);
                if (total < -maxOffset || total > maxOffset) {
                  return STATUS_CONST(OUT_OF_RANGE);
                }
                outOffset->minutesEastOfUtc = (int16_t)total;
                return STATUS_CONST(SUCCESS);
              })
        ),

        SPACE(Zone,
              FUNCTION(const char *, DataVersion, (), {
                return CHRONOMETRY_TIMEZONE_TZDATA_VERSION;
              }),

              OPERATION(FromId,
                        (MODULE_ENUM(Chronometry, Timezone, ZoneId) zoneId,
                         MODULE_TYPE(Chronometry, TimezoneRule) *outRule), {
                if (outRule == NULL) {
                  return STATUS_CONST(INVALID_ARGUMENT);
                }
                return MODULE_IFUNC(Chronometry, Timezone, RuleById)(zoneId,
                                                                     outRule);
              }),

              OPERATION(FromName,
                        (const char *ianaName,
                         MODULE_TYPE(Chronometry, TimezoneRule) *outRule), {
                if (ianaName == NULL || outRule == NULL) {
                  return STATUS_CONST(INVALID_ARGUMENT);
                }
                size_t low = 0U;
                size_t high =
                    sizeof(MODULE_IFUNC(Chronometry, Timezone,
                                        ZoneNameEntries)) /
                    sizeof(MODULE_IFUNC(Chronometry, Timezone,
                                        ZoneNameEntries)[0]);
                while (low < high) {
                  size_t mid = low + (high - low) / 2U;
                  int cmp = strcmp(
                      ianaName,
                      MODULE_IFUNC(Chronometry, Timezone, ZoneNameEntries)[mid]
                          .ianaName);
                  if (cmp == 0) {
                    return MODULE_FUNC(Chronometry, Timezone, Zone, FromId)(
                        MODULE_IFUNC(Chronometry, Timezone,
                                     ZoneNameEntries)[mid]
                            .zoneId,
                        outRule);
                  }
                  if (cmp < 0) {
                    high = mid;
                  } else {
                    low = mid + 1U;
                  }
                }
                low = 0U;
                high = sizeof(MODULE_IFUNC(Chronometry, Timezone,
                                           ZoneLinkEntries)) /
                       sizeof(MODULE_IFUNC(Chronometry, Timezone,
                                           ZoneLinkEntries)[0]);
                while (low < high) {
                  size_t mid = low + (high - low) / 2U;
                  int cmp = strcmp(
                      ianaName,
                      MODULE_IFUNC(Chronometry, Timezone, ZoneLinkEntries)[mid]
                          .ianaName);
                  if (cmp == 0) {
                    return MODULE_FUNC(Chronometry, Timezone, Zone, FromId)(
                        MODULE_IFUNC(Chronometry, Timezone,
                                     ZoneLinkEntries)[mid]
                            .zoneId,
                        outRule);
                  }
                  if (cmp < 0) {
                    high = mid;
                  } else {
                    low = mid + 1U;
                  }
                }
                return STATUS_CONST(OUT_OF_RANGE);
              }),

              PREDICATE(IsRuleValid,
                        (const MODULE_TYPE(Chronometry, TimezoneRule) *rule), {
                if (rule == NULL ||
                    !MODULE_FUNC(Chronometry, Timezone, Offset, IsValid)(
                        rule->standardOffset) ||
                    rule->dstSavingsMinutes < 0 ||
                    rule->dstSavingsMinutes >
                        CNS(Chronometry, Timezone, Internal,
                            MAX_DST_SAVINGS_MINUTES)) {
                  return false;
                }
                MODULE_TYPE(Chronometry, UtcOffset) combined = {
                    (int16_t)(rule->standardOffset.minutesEastOfUtc +
                              rule->dstSavingsMinutes)};
                if (!MODULE_FUNC(Chronometry, Timezone, Offset, IsValid)(
                        combined)) {
                  return false;
                }
                if (rule->dstSavingsMinutes == 0) {
                  return true;
                }
                return MODULE_IFUNC(Chronometry, Timezone,
                                    IsTransitionRuleValid)(rule->start) &&
                       MODULE_IFUNC(Chronometry, Timezone,
                                    IsTransitionRuleValid)(rule->end);
              }),

              OPERATION(IsDstAtLocal,
                        (const MODULE_TYPE(Chronometry, TimezoneRule) *rule,
                         MODULE_TYPE(Chronometry, Timestamp) local,
                         bool *outIsDst), {
                if (rule == NULL || outIsDst == NULL ||
                    !MODULE_FUNC(Chronometry, Timezone, Zone, IsRuleValid)(
                        rule)) {
                  return STATUS_CONST(INVALID_ARGUMENT);
                }
                MODULE_TYPE(Chronometry, CalendarPolicy) gregorian =
                    MODULE_FUNC(Chronometry, Calendar, GregorianPolicy)();
                if (!MODULE_FUNC(Chronometry, Timestamp, IsValid)(&gregorian,
                                                                   local)) {
                  return STATUS_CONST(INVALID_ARGUMENT);
                }
                if (rule->dstSavingsMinutes == 0) {
                  *outIsDst = false;
                  return STATUS_CONST(SUCCESS);
                }
                MODULE_TYPE(Chronometry, Timestamp) startTs = {0};
                MODULE_TYPE(Chronometry, Timestamp) endTs = {0};
                OPSTATUS status = MODULE_IFUNC(
                    Chronometry, Timezone, TransitionTimestampForYear)(
                    local.date.year, rule->start, &startTs);
                if (status != STATUS_CONST(SUCCESS)) {
                  return status;
                }
                status = MODULE_IFUNC(
                    Chronometry, Timezone, TransitionTimestampForYear)(
                    local.date.year, rule->end, &endTs);
                if (status != STATUS_CONST(SUCCESS)) {
                  return status;
                }
                if (MODULE_FUNC(Chronometry, Timestamp, Compare)(
                        startTs, endTs) == COMPARISON_CONST(LOWER)) {
                  *outIsDst = MODULE_FUNC(Chronometry, Timestamp, Compare)(
                                  local, startTs) != COMPARISON_CONST(LOWER) &&
                              MODULE_FUNC(Chronometry, Timestamp, Compare)(
                                  local, endTs) == COMPARISON_CONST(LOWER);
                } else {
                  *outIsDst = MODULE_FUNC(Chronometry, Timestamp, Compare)(
                                  local, startTs) != COMPARISON_CONST(LOWER) ||
                              MODULE_FUNC(Chronometry, Timestamp, Compare)(
                                  local, endTs) == COMPARISON_CONST(LOWER);
                }
                return STATUS_CONST(SUCCESS);
              }),

              OPERATION(ClassifyLocal,
                        (const MODULE_TYPE(Chronometry, TimezoneRule) *rule,
                         MODULE_TYPE(Chronometry, Timestamp) local,
                         MODULE_ENUM(Chronometry, Timezone, LocalTimeStatus)
                             *outStatus,
                         MODULE_TYPE(Chronometry, OffsetTimestamp) *outEarlier,
                         MODULE_TYPE(Chronometry, OffsetTimestamp) *outLater), {
                if (rule == NULL || outStatus == NULL || outEarlier == NULL ||
                    outLater == NULL ||
                    !MODULE_FUNC(Chronometry, Timezone, Zone, IsRuleValid)(
                        rule)) {
                  return STATUS_CONST(INVALID_ARGUMENT);
                }
                MODULE_TYPE(Chronometry, CalendarPolicy) gregorian =
                    MODULE_FUNC(Chronometry, Calendar, GregorianPolicy)();
                if (!MODULE_FUNC(Chronometry, Timestamp, IsValid)(&gregorian,
                                                                   local)) {
                  return STATUS_CONST(INVALID_ARGUMENT);
                }
                if (rule->dstSavingsMinutes == 0) {
                  MODULE_TYPE(Chronometry, OffsetTimestamp) unique = {
                      .local = local,
                      .offset = rule->standardOffset,
                      .daylightSavings = false};
                  *outStatus = MODULE_CONST(
                      Chronometry, Timezone, LOCAL_TIME_UNIQUE);
                  *outEarlier = unique;
                  *outLater = unique;
                  return STATUS_CONST(SUCCESS);
                }
                MODULE_TYPE(Chronometry, UtcOffset) dstOffset = {
                    (int16_t)(rule->standardOffset.minutesEastOfUtc +
                              rule->dstSavingsMinutes)};
                MODULE_TYPE(Chronometry, Instant) startUtc = {0};
                MODULE_TYPE(Chronometry, Instant) endUtc = {0};
                OPSTATUS status = MODULE_IFUNC(
                    Chronometry, Timezone, TransitionInstantForYear)(
                    local.date.year, rule->start, rule->standardOffset,
                    rule->standardOffset, &startUtc);
                if (status != STATUS_CONST(SUCCESS)) {
                  return status;
                }
                status = MODULE_IFUNC(
                    Chronometry, Timezone, TransitionInstantForYear)(
                    local.date.year, rule->end, rule->standardOffset,
                    dstOffset, &endUtc);
                if (status != STATUS_CONST(SUCCESS)) {
                  return status;
                }
                MODULE_TYPE(Chronometry, OffsetTimestamp) startWallStd = {0};
                MODULE_TYPE(Chronometry, OffsetTimestamp) endWallDst = {0};
                status = MODULE_FUNC(Chronometry, Timezone, FromUTC)(
                    startUtc, rule->standardOffset, &startWallStd);
                if (status != STATUS_CONST(SUCCESS)) {
                  return status;
                }
                status = MODULE_FUNC(Chronometry, Timezone, FromUTC)(
                    endUtc, dstOffset, &endWallDst);
                if (status != STATUS_CONST(SUCCESS)) {
                  return status;
                }
                MODULE_TYPE(Chronometry, Duration) savings = {0};
                status = MODULE_FUNC(Chronometry, Duration, FromMinutes)(
                    rule->dstSavingsMinutes, &savings);
                if (status != STATUS_CONST(SUCCESS)) {
                  return status;
                }
                MODULE_TYPE(Chronometry, Timestamp) gapEnd = {0};
                status = MODULE_FUNC(Chronometry, Timestamp, AddDuration)(
                    &gregorian, startWallStd.local, savings, &gapEnd);
                if (status != STATUS_CONST(SUCCESS)) {
                  return status;
                }
                if (MODULE_FUNC(Chronometry, Timestamp, Compare)(
                        local, startWallStd.local) !=
                        COMPARISON_CONST(LOWER) &&
                    MODULE_FUNC(Chronometry, Timestamp, Compare)(
                        local, gapEnd) == COMPARISON_CONST(LOWER)) {
                  MODULE_TYPE(Chronometry, Duration) negSavings = {0};
                  status = MODULE_FUNC(Chronometry, Duration, Negate)(
                      savings, &negSavings);
                  if (status != STATUS_CONST(SUCCESS)) {
                    return status;
                  }
                  MODULE_TYPE(Chronometry, Timestamp) shiftedBack = {0};
                  MODULE_TYPE(Chronometry, Timestamp) shiftedForward = {0};
                  status = MODULE_FUNC(Chronometry, Timestamp, AddDuration)(
                      &gregorian, local, negSavings, &shiftedBack);
                  if (status != STATUS_CONST(SUCCESS)) {
                    return status;
                  }
                  status = MODULE_FUNC(Chronometry, Timestamp, AddDuration)(
                      &gregorian, local, savings, &shiftedForward);
                  if (status != STATUS_CONST(SUCCESS)) {
                    return status;
                  }
                  *outStatus = MODULE_CONST(
                      Chronometry, Timezone, LOCAL_TIME_NONEXISTENT);
                  *outEarlier = (MODULE_TYPE(Chronometry, OffsetTimestamp)){
                      .local = shiftedBack,
                      .offset = rule->standardOffset,
                      .daylightSavings = false};
                  *outLater = (MODULE_TYPE(Chronometry, OffsetTimestamp)){
                      .local = shiftedForward,
                      .offset = dstOffset,
                      .daylightSavings = true};
                  return STATUS_CONST(SUCCESS);
                }
                MODULE_TYPE(Chronometry, Duration) negSavings = {0};
                status = MODULE_FUNC(Chronometry, Duration, Negate)(
                    savings, &negSavings);
                if (status != STATUS_CONST(SUCCESS)) {
                  return status;
                }
                MODULE_TYPE(Chronometry, Timestamp) overlapStart = {0};
                status = MODULE_FUNC(Chronometry, Timestamp, AddDuration)(
                    &gregorian, endWallDst.local, negSavings, &overlapStart);
                if (status != STATUS_CONST(SUCCESS)) {
                  return status;
                }
                if (MODULE_FUNC(Chronometry, Timestamp, Compare)(
                        local, overlapStart) != COMPARISON_CONST(LOWER) &&
                    MODULE_FUNC(Chronometry, Timestamp, Compare)(
                        local, endWallDst.local) == COMPARISON_CONST(LOWER)) {
                  *outStatus = MODULE_CONST(
                      Chronometry, Timezone, LOCAL_TIME_AMBIGUOUS);
                  *outEarlier = (MODULE_TYPE(Chronometry, OffsetTimestamp)){
                      .local = local,
                      .offset = dstOffset,
                      .daylightSavings = true};
                  *outLater = (MODULE_TYPE(Chronometry, OffsetTimestamp)){
                      .local = local,
                      .offset = rule->standardOffset,
                      .daylightSavings = false};
                  return STATUS_CONST(SUCCESS);
                }
                bool isDst = false;
                if (MODULE_FUNC(Chronometry, Timestamp, Compare)(
                        startWallStd.local, endWallDst.local) ==
                    COMPARISON_CONST(LOWER)) {
                  isDst = MODULE_FUNC(Chronometry, Timestamp, Compare)(
                              local, gapEnd) != COMPARISON_CONST(LOWER) &&
                          MODULE_FUNC(Chronometry, Timestamp, Compare)(
                              local, overlapStart) == COMPARISON_CONST(LOWER);
                } else {
                  isDst = MODULE_FUNC(Chronometry, Timestamp, Compare)(
                              local, gapEnd) != COMPARISON_CONST(LOWER) ||
                          MODULE_FUNC(Chronometry, Timestamp, Compare)(
                              local, overlapStart) == COMPARISON_CONST(LOWER);
                }
                MODULE_TYPE(Chronometry, OffsetTimestamp) unique = {
                    .local = local,
                    .offset = isDst ? dstOffset : rule->standardOffset,
                    .daylightSavings = isDst};
                *outStatus =
                    MODULE_CONST(Chronometry, Timezone, LOCAL_TIME_UNIQUE);
                *outEarlier = unique;
                *outLater = unique;
                return STATUS_CONST(SUCCESS);
              }),

              OPERATION(ResolveLocal,
                        (const MODULE_TYPE(Chronometry, TimezoneRule) *rule,
                         MODULE_TYPE(Chronometry, Timestamp) local,
                         MODULE_TYPE(Chronometry, OffsetTimestamp)
                             *outResolved), {
                return MODULE_FUNC(
                    Chronometry, Timezone, Zone, ResolveLocalWithPolicy)(
                    rule, local,
                    MODULE_CONST(Chronometry, Timezone,
                                 DISAMBIGUATE_COMPATIBLE),
                    outResolved);
              }),

              OPERATION(ResolveLocalWithPolicy,
                        (const MODULE_TYPE(Chronometry, TimezoneRule) *rule,
                         MODULE_TYPE(Chronometry, Timestamp) local,
                         MODULE_ENUM(Chronometry, Timezone, Disambiguation)
                             policy,
                         MODULE_TYPE(Chronometry, OffsetTimestamp)
                             *outResolved), {
                if (outResolved == NULL ||
                    policy < MODULE_CONST(Chronometry, Timezone,
                                          DISAMBIGUATE_COMPATIBLE) ||
                    policy > MODULE_CONST(Chronometry, Timezone,
                                          DISAMBIGUATE_REJECT)) {
                  return STATUS_CONST(INVALID_ARGUMENT);
                }
                MODULE_ENUM(Chronometry, Timezone, LocalTimeStatus)
                statusKind = 0;
                MODULE_TYPE(Chronometry, OffsetTimestamp) earlier = {0};
                MODULE_TYPE(Chronometry, OffsetTimestamp) later = {0};
                OPSTATUS status = MODULE_FUNC(
                    Chronometry, Timezone, Zone, ClassifyLocal)(
                    rule, local, &statusKind, &earlier, &later);
                if (status != STATUS_CONST(SUCCESS)) {
                  return status;
                }
                if (statusKind == MODULE_CONST(Chronometry, Timezone,
                                               LOCAL_TIME_UNIQUE)) {
                  *outResolved = earlier;
                  return STATUS_CONST(SUCCESS);
                }
                if (policy == MODULE_CONST(Chronometry, Timezone,
                                           DISAMBIGUATE_REJECT)) {
                  return STATUS_CONST(OUT_OF_RANGE);
                }
                if (policy == MODULE_CONST(Chronometry, Timezone,
                                           DISAMBIGUATE_EARLIER)) {
                  *outResolved = earlier;
                  return STATUS_CONST(SUCCESS);
                }
                if (policy == MODULE_CONST(Chronometry, Timezone,
                                           DISAMBIGUATE_LATER)) {
                  *outResolved = later;
                  return STATUS_CONST(SUCCESS);
                }
                *outResolved = (statusKind ==
                                MODULE_CONST(Chronometry, Timezone,
                                             LOCAL_TIME_AMBIGUOUS))
                                   ? earlier
                                   : later;
                return STATUS_CONST(SUCCESS);
              })
        ),

        SPACE(Country,
              OPERATION(NameFromCode,
                        (const char *countryCode,
                         const char **outCountryName), {
                if (countryCode == NULL || outCountryName == NULL) {
                  return STATUS_CONST(INVALID_ARGUMENT);
                }
                size_t low = 0U;
                size_t high =
                    sizeof(MODULE_IFUNC(Chronometry, Timezone,
                                        CountryEntries)) /
                    sizeof(MODULE_IFUNC(Chronometry, Timezone,
                                        CountryEntries)[0]);
                while (low < high) {
                  size_t mid = low + (high - low) / 2U;
                  int cmp = strcmp(
                      countryCode,
                      MODULE_IFUNC(Chronometry, Timezone, CountryEntries)[mid]
                          .code);
                  if (cmp == 0) {
                    *outCountryName =
                        MODULE_IFUNC(Chronometry, Timezone, CountryEntries)[mid]
                            .name;
                    return STATUS_CONST(SUCCESS);
                  }
                  if (cmp < 0) {
                    high = mid;
                  } else {
                    low = mid + 1U;
                  }
                }
                return STATUS_CONST(OUT_OF_RANGE);
              }),

              OPERATION(ZoneCount,
                        (const char *countryCode, size_t *outCount), {
                if (countryCode == NULL || outCount == NULL) {
                  return STATUS_CONST(INVALID_ARGUMENT);
                }
                size_t start = 0U;
                size_t count = 0U;
                if (!MODULE_IFUNC(Chronometry, Timezone, CountryRange)(
                        countryCode, &start, &count)) {
                  *outCount = 0U;
                  return STATUS_CONST(OUT_OF_RANGE);
                }
                *outCount = count;
                return STATUS_CONST(SUCCESS);
              }),

              OPERATION(ZoneIdAt,
                        (const char *countryCode, size_t index,
                         MODULE_ENUM(Chronometry, Timezone, ZoneId)
                             *outZoneId), {
                if (countryCode == NULL || outZoneId == NULL) {
                  return STATUS_CONST(INVALID_ARGUMENT);
                }
                size_t start = 0U;
                size_t count = 0U;
                if (!MODULE_IFUNC(Chronometry, Timezone, CountryRange)(
                        countryCode, &start, &count) ||
                    index >= count) {
                  return STATUS_CONST(OUT_OF_RANGE);
                }
                *outZoneId = MODULE_IFUNC(Chronometry, Timezone,
                                          CountryZoneEntries)[start + index]
                                 .zoneId;
                return STATUS_CONST(SUCCESS);
              }),

              OPERATION(ZoneRuleAt,
                        (const char *countryCode, size_t index,
                         MODULE_TYPE(Chronometry, TimezoneRule) *outRule), {
                MODULE_ENUM(Chronometry, Timezone, ZoneId) zoneId = 0;
                OPSTATUS status = MODULE_FUNC(
                    Chronometry, Timezone, Country, ZoneIdAt)(countryCode,
                                                              index, &zoneId);
                if (status != STATUS_CONST(SUCCESS)) {
                  return status;
                }
                return MODULE_FUNC(Chronometry, Timezone, Zone, FromId)(
                    zoneId, outRule);
              })
        )
    )
);

#undef COSMERON_MACRO_INTERNAL_CHRONOMETRY_COUNTRY_ZONE_ENTRY
#undef COSMERON_MACRO_INTERNAL_CHRONOMETRY_COUNTRY_ENTRY
#undef COSMERON_MACRO_INTERNAL_CHRONOMETRY_ZONE_LINK_ENTRY
#undef COSMERON_MACRO_INTERNAL_CHRONOMETRY_ZONE_NAME_ENTRY
#undef COSMERON_MACRO_INTERNAL_CHRONOMETRY_ZONE_ID_CASE
#undef COSMERON_MACRO_INTERNAL_CHRONOMETRY_BUILD_RULE

/* EOF */