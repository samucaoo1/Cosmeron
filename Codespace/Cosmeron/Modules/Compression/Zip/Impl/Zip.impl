#pragma once
static inline OPSTATUS COMPRESSION_INS(ZipStatus)(cosmeron_compression_vendor_mz_zip_archive *zip) {
  switch (cosmeron_compression_vendor_mz_zip_get_last_error(zip)) {
  case cosmeron_compression_vendor_MZ_ZIP_ALLOC_FAILED: return STATUS_CONST(OUT_OF_MEMORY);
  case cosmeron_compression_vendor_MZ_ZIP_BUF_TOO_SMALL: return STATUS_CONST(INSUFFICIENT_SPACE);
  case cosmeron_compression_vendor_MZ_ZIP_FILE_NOT_FOUND: return STATUS_CONST(NOT_FOUND);
  case cosmeron_compression_vendor_MZ_ZIP_TOO_MANY_FILES:
  case cosmeron_compression_vendor_MZ_ZIP_FILE_TOO_LARGE:
  case cosmeron_compression_vendor_MZ_ZIP_ARCHIVE_TOO_LARGE: return STATUS_CONST(OUT_OF_RANGE);
  case cosmeron_compression_vendor_MZ_ZIP_UNSUPPORTED_METHOD:
  case cosmeron_compression_vendor_MZ_ZIP_UNSUPPORTED_ENCRYPTION:
  case cosmeron_compression_vendor_MZ_ZIP_UNSUPPORTED_FEATURE:
  case cosmeron_compression_vendor_MZ_ZIP_UNSUPPORTED_MULTIDISK: return STATUS_CONST(NOT_SUPPORTED);
  case cosmeron_compression_vendor_MZ_ZIP_INVALID_PARAMETER:
  case cosmeron_compression_vendor_MZ_ZIP_INVALID_FILENAME: return STATUS_CONST(INVALID_ARGUMENT);
  case cosmeron_compression_vendor_MZ_ZIP_FILE_WRITE_FAILED:
  case cosmeron_compression_vendor_MZ_ZIP_COMPRESSION_FAILED:
  case cosmeron_compression_vendor_MZ_ZIP_INTERNAL_ERROR: return STATUS_CONST(GENERIC_ERROR);
  default: return STATUS_CONST(INVALID_SEQUENCE);
  }
}
COMPRESSION_ZIP_OPEN_PROTOTYPE {
  cosmeron_compression_vendor_mz_zip_archive *zip;
  OPSTATUS status;
  if (!reader || reader->native || !data) return STATUS_CONST(INVALID_ARGUMENT);
  zip = (cosmeron_compression_vendor_mz_zip_archive *)calloc(1, sizeof(*zip));
  if (!zip) return STATUS_CONST(OUT_OF_MEMORY);
  if (!cosmeron_compression_vendor_mz_zip_reader_init_mem(zip, data, size, 0)) {
    status = COMPRESSION_INS(ZipStatus)(zip); free(zip); return status;
  }
  reader->native = zip; return STATUS_CONST(SUCCESS);
}
COMPRESSION_ZIP_CLOSE_PROTOTYPE {
  if (reader && reader->native) {
    cosmeron_compression_vendor_mz_zip_reader_end((cosmeron_compression_vendor_mz_zip_archive *)reader->native);
    free(reader->native); reader->native = NULL;
  }
}
COMPRESSION_ZIP_COUNT_PROTOTYPE {
  if (!reader || !reader->native || !outCount) return STATUS_CONST(INVALID_ARGUMENT);
  *outCount = cosmeron_compression_vendor_mz_zip_reader_get_num_files((cosmeron_compression_vendor_mz_zip_archive *)reader->native);
  return STATUS_CONST(SUCCESS);
}
COMPRESSION_ZIP_ENTRY_PROTOTYPE {
  cosmeron_compression_vendor_mz_zip_archive_file_stat stat;
  cosmeron_compression_vendor_mz_zip_archive *zip;
  COMPRESSION_TYPE(TZipEntry) result;
  if (!reader || !reader->native || !outEntry) return STATUS_CONST(INVALID_ARGUMENT);
  zip = (cosmeron_compression_vendor_mz_zip_archive *)reader->native;
  if (index >= cosmeron_compression_vendor_mz_zip_reader_get_num_files(zip)) return STATUS_CONST(OUT_OF_RANGE);
  if (!cosmeron_compression_vendor_mz_zip_reader_file_stat(zip, (unsigned int)index, &stat))
    return COMPRESSION_INS(ZipStatus)(zip);
  result.compressedSize = stat.m_comp_size; result.size = stat.m_uncomp_size;
  result.crc32 = stat.m_crc32; result.directory = stat.m_is_directory != 0;
  result.supported = stat.m_is_supported != 0;
  *outEntry = result; return STATUS_CONST(SUCCESS);
}
COMPRESSION_ZIP_NAME_PROTOTYPE {
  cosmeron_compression_vendor_mz_zip_archive *zip;
  unsigned int required;
  if (!reader || !reader->native || !outSize || (!destination && capacity)) return STATUS_CONST(INVALID_ARGUMENT);
  zip = (cosmeron_compression_vendor_mz_zip_archive *)reader->native;
  if (index >= cosmeron_compression_vendor_mz_zip_reader_get_num_files(zip)) return STATUS_CONST(OUT_OF_RANGE);
  required = cosmeron_compression_vendor_mz_zip_reader_get_filename(zip, (unsigned int)index, NULL, 0);
  if (!required) return COMPRESSION_INS(ZipStatus)(zip);
  if (capacity < required) return STATUS_CONST(INSUFFICIENT_SPACE);
  cosmeron_compression_vendor_mz_zip_reader_get_filename(zip, (unsigned int)index, destination, required);
  *outSize = required - 1; return STATUS_CONST(SUCCESS);
}
COMPRESSION_ZIP_FIND_PROTOTYPE {
  cosmeron_compression_vendor_mz_zip_archive *zip;
  cosmeron_compression_vendor_mz_uint32 index = 0;
  if (!reader || !reader->native || !name || !outIndex) return STATUS_CONST(INVALID_ARGUMENT);
  zip = (cosmeron_compression_vendor_mz_zip_archive *)reader->native;
  if (!cosmeron_compression_vendor_mz_zip_reader_locate_file_v2(zip, name, NULL,
      cosmeron_compression_vendor_MZ_ZIP_FLAG_CASE_SENSITIVE, &index)) return COMPRESSION_INS(ZipStatus)(zip);
  *outIndex = index; return STATUS_CONST(SUCCESS);
}
COMPRESSION_ZIP_EXTRACT_PROTOTYPE {
  COMPRESSION_TYPE(TZipEntry) entry;
  cosmeron_compression_vendor_mz_zip_archive *zip;
  unsigned char dummy = 0;
  OPSTATUS status;
  if (!outSize || (!destination && capacity)) return STATUS_CONST(INVALID_ARGUMENT);
  status = COMPRESSION_FUNC(ZipEntry)(reader, index, &entry);
  if (status != STATUS_CONST(SUCCESS)) return status;
  if (!entry.supported) return STATUS_CONST(NOT_SUPPORTED);
  if (entry.size > capacity) return STATUS_CONST(INSUFFICIENT_SPACE);
  zip = (cosmeron_compression_vendor_mz_zip_archive *)reader->native;
  /* The reader borrows its memory archive; extraction must not overlap it. */
  if (COMPRESSION_INS(Overlap)(zip->m_pState->m_pMem, (size_t)zip->m_archive_size, destination, capacity))
    return STATUS_CONST(INVALID_ARGUMENT);
  if (!cosmeron_compression_vendor_mz_zip_reader_extract_to_mem(zip, (unsigned int)index,
      destination ? destination : &dummy, (size_t)entry.size, 0)) return COMPRESSION_INS(ZipStatus)(zip);
  *outSize = (size_t)entry.size; return STATUS_CONST(SUCCESS);
}
COMPRESSION_ZIP_EXTRACT_ALLOC_PROTOTYPE {
  COMPRESSION_TYPE(TZipEntry) entry;
  COMPRESSION_TYPE(TBuffer) result = {0};
  OPSTATUS status;
  if (!outBuffer || outBuffer->data || outBuffer->size) return STATUS_CONST(INVALID_ARGUMENT);
  status = COMPRESSION_FUNC(ZipEntry)(reader, index, &entry);
  if (status != STATUS_CONST(SUCCESS)) return status;
  if (!entry.supported) return STATUS_CONST(NOT_SUPPORTED);
  if (entry.size > maxOutput || entry.size > SIZE_MAX) return STATUS_CONST(INSUFFICIENT_SPACE);
  result.data = (unsigned char *)malloc(entry.size ? (size_t)entry.size : 1);
  if (!result.data) return STATUS_CONST(OUT_OF_MEMORY);
  status = COMPRESSION_FUNC(ZipExtract)(reader, index, result.data, (size_t)entry.size, &result.size);
  if (status != STATUS_CONST(SUCCESS)) { free(result.data); return status; }
  *outBuffer = result; return STATUS_CONST(SUCCESS);
}
COMPRESSION_ZIP_CREATE_PROTOTYPE {
  cosmeron_compression_vendor_mz_zip_archive *zip;
  OPSTATUS status;
  if (!writer || writer->native) return STATUS_CONST(INVALID_ARGUMENT);
  zip = (cosmeron_compression_vendor_mz_zip_archive *)calloc(1, sizeof(*zip));
  if (!zip) return STATUS_CONST(OUT_OF_MEMORY);
  if (!cosmeron_compression_vendor_mz_zip_writer_init_heap(zip, 0, 0)) {
    status = COMPRESSION_INS(ZipStatus)(zip); free(zip); return status;
  }
  writer->native = zip; return STATUS_CONST(SUCCESS);
}
/* Use portable relative names; writer cannot create traversal/absolute entries. */
static inline bool COMPRESSION_INS(ZipNameValid)(const char *name) {
  const char *start = name, *p;
  if (!name || !*name || *name == '/') return false;
  for (p = name;; ++p) {
    if (*p == '\\' || *p == ':') return false;
    if (*p == '/' || !*p) {
      size_t length = (size_t)(p - start);
      if (!length || (length == 1 && start[0] == '.') ||
          (length == 2 && start[0] == '.' && start[1] == '.')) return false;
      if (!*p || !p[1]) return true;
      start = p + 1;
    }
  }
}
COMPRESSION_ZIP_ADD_PROTOTYPE {
  cosmeron_compression_vendor_mz_zip_archive *zip;
  const unsigned char dummy = 0;
  if (!writer || !writer->native || !COMPRESSION_INS(ZipNameValid)(name) ||
      (!data && size) || !COMPRESSION_INS(LevelValid)(level)) return STATUS_CONST(INVALID_ARGUMENT);
  if (name[strlen(name) - 1] == '/' && size) return STATUS_CONST(INVALID_ARGUMENT);
  zip = (cosmeron_compression_vendor_mz_zip_archive *)writer->native;
  if (!cosmeron_compression_vendor_mz_zip_writer_add_mem(zip, name, data ? data : &dummy, size,
      (unsigned int)(level == COMPRESSION_CONST(LEVEL_DEFAULT) ? cosmeron_compression_vendor_MZ_DEFAULT_LEVEL : level)))
    return COMPRESSION_INS(ZipStatus)(zip);
  return STATUS_CONST(SUCCESS);
}
COMPRESSION_ZIP_FINISH_PROTOTYPE {
  cosmeron_compression_vendor_mz_zip_archive *zip;
  COMPRESSION_TYPE(TBuffer) result = {0};
  void *data;
  if (!writer || !writer->native || !outBuffer || outBuffer->data || outBuffer->size)
    return STATUS_CONST(INVALID_ARGUMENT);
  zip = (cosmeron_compression_vendor_mz_zip_archive *)writer->native;
  if (!cosmeron_compression_vendor_mz_zip_writer_finalize_heap_archive(zip, &data, &result.size))
    return COMPRESSION_INS(ZipStatus)(zip);
  result.data = (unsigned char *)data;
  cosmeron_compression_vendor_mz_zip_writer_end(zip);
  free(zip); writer->native = NULL;
  *outBuffer = result; return STATUS_CONST(SUCCESS);
}
COMPRESSION_ZIP_DISCARD_PROTOTYPE {
  if (writer && writer->native) {
    cosmeron_compression_vendor_mz_zip_writer_end((cosmeron_compression_vendor_mz_zip_archive *)writer->native);
    free(writer->native); writer->native = NULL;
  }
}
