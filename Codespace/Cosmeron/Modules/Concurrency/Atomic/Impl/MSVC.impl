#pragma once

#include <intrin.h>
#include <windows.h>

typedef struct { volatile LONG value; } CONCURRENCY_TYPE(TAtomicU32);
#if defined(_M_X64) || defined(_M_ARM64)
#define CONCURRENCY_HAS_ATOMIC_U64 1
typedef struct { volatile LONG64 value; } CONCURRENCY_TYPE(TAtomicU64);
#else
#define CONCURRENCY_HAS_ATOMIC_U64 0
#endif
#define CONCURRENCY_HAS_ATOMIC_PTR 1
typedef struct { void *volatile value; } CONCURRENCY_TYPE(TAtomicPtr);
typedef struct { volatile LONG value; } CONCURRENCY_TYPE(TAtomicBool);

typedef enum CONCURRENCY_TYPE(MemoryOrder) {
  CONCURRENCY_CONST(ATOMIC, MEMORY_ORDER_RELAXED),
  CONCURRENCY_CONST(ATOMIC, MEMORY_ORDER_ACQUIRE),
  CONCURRENCY_CONST(ATOMIC, MEMORY_ORDER_RELEASE),
  CONCURRENCY_CONST(ATOMIC, MEMORY_ORDER_ACQ_REL),
  CONCURRENCY_CONST(ATOMIC, MEMORY_ORDER_SEQ_CST)
} CONCURRENCY_TYPE(MemoryOrder);

#define ATOMIC_U32_INIT(VALUE) { (LONG)(VALUE) }
#if CONCURRENCY_HAS_ATOMIC_U64
#define ATOMIC_U64_INIT(VALUE) { (LONG64)(VALUE) }
#endif
#define ATOMIC_PTR_INIT(VALUE) { (void *)(VALUE) }
#define ATOMIC_BOOL_INIT(VALUE) { (LONG)((VALUE) != false) }

/*
 * MSVC's Interlocked family is intentionally used instead of C11 atomics.
 * This keeps the backend header-only and avoids an external atomic runtime.
 * The operations provide at least the ordering requested by this portable API;
 * on this backend some weaker orders may therefore be implemented more strongly.
 */

static inline uint32_t ATOMIC_FUNC(U32_Load)(const CONCURRENCY_TYPE(TAtomicU32) *atomic,
                                           CONCURRENCY_TYPE(MemoryOrder) order) {
  (void)order;
  return (uint32_t)_InterlockedCompareExchange(
      (volatile LONG *)&atomic->value, 0, 0);
}
static inline void ATOMIC_FUNC(U32_Store)(CONCURRENCY_TYPE(TAtomicU32) *atomic, uint32_t value,
                                        CONCURRENCY_TYPE(MemoryOrder) order) {
  (void)order;
  (void)_InterlockedExchange(&atomic->value, (LONG)value);
}
static inline uint32_t ATOMIC_FUNC(U32_Exchange)(CONCURRENCY_TYPE(TAtomicU32) *atomic,
                                               uint32_t value,
                                               CONCURRENCY_TYPE(MemoryOrder) order) {
  (void)order;
  return (uint32_t)_InterlockedExchange(&atomic->value, (LONG)value);
}
static inline bool ATOMIC_FUNC(U32_CompareExchange)(CONCURRENCY_TYPE(TAtomicU32) *atomic,
                                                   uint32_t *expected,
                                                   uint32_t desired,
                                                   CONCURRENCY_TYPE(MemoryOrder) success,
                                                   CONCURRENCY_TYPE(MemoryOrder) failure) {
  LONG old;
  (void)success;
  (void)failure;
  old = _InterlockedCompareExchange(&atomic->value, (LONG)desired,
                                    (LONG)*expected);
  if ((uint32_t)old == *expected)
    return true;
  *expected = (uint32_t)old;
  return false;
}
static inline uint32_t ATOMIC_FUNC(U32_FetchAdd)(CONCURRENCY_TYPE(TAtomicU32) *atomic,
                                                uint32_t value,
                                                CONCURRENCY_TYPE(MemoryOrder) order) {
  (void)order;
  return (uint32_t)_InterlockedExchangeAdd(&atomic->value, (LONG)value);
}
static inline uint32_t ATOMIC_FUNC(U32_FetchSub)(CONCURRENCY_TYPE(TAtomicU32) *atomic,
                                                uint32_t value,
                                                CONCURRENCY_TYPE(MemoryOrder) order) {
  return ATOMIC_FUNC(U32_FetchAdd)(atomic, (uint32_t)(0u - value), order);
}
static inline uint32_t ATOMIC_FUNC(U32_FetchAnd)(CONCURRENCY_TYPE(TAtomicU32) *atomic,
                                                uint32_t value,
                                                CONCURRENCY_TYPE(MemoryOrder) order) {
  (void)order;
  return (uint32_t)_InterlockedAnd(&atomic->value, (LONG)value);
}
static inline uint32_t ATOMIC_FUNC(U32_FetchOr)(CONCURRENCY_TYPE(TAtomicU32) *atomic,
                                               uint32_t value,
                                               CONCURRENCY_TYPE(MemoryOrder) order) {
  (void)order;
  return (uint32_t)_InterlockedOr(&atomic->value, (LONG)value);
}
static inline uint32_t ATOMIC_FUNC(U32_FetchXor)(CONCURRENCY_TYPE(TAtomicU32) *atomic,
                                                uint32_t value,
                                                CONCURRENCY_TYPE(MemoryOrder) order) {
  (void)order;
  return (uint32_t)_InterlockedXor(&atomic->value, (LONG)value);
}

#if CONCURRENCY_HAS_ATOMIC_U64
static inline uint64_t ATOMIC_FUNC(U64_Load)(const CONCURRENCY_TYPE(TAtomicU64) *atomic,
                                           CONCURRENCY_TYPE(MemoryOrder) order) {
  (void)order;
  return (uint64_t)_InterlockedCompareExchange64(
      (volatile LONG64 *)&atomic->value, 0, 0);
}
static inline void ATOMIC_FUNC(U64_Store)(CONCURRENCY_TYPE(TAtomicU64) *atomic, uint64_t value,
                                        CONCURRENCY_TYPE(MemoryOrder) order) {
  (void)order;
  (void)_InterlockedExchange64(&atomic->value, (LONG64)value);
}
static inline uint64_t ATOMIC_FUNC(U64_Exchange)(CONCURRENCY_TYPE(TAtomicU64) *atomic,
                                               uint64_t value,
                                               CONCURRENCY_TYPE(MemoryOrder) order) {
  (void)order;
  return (uint64_t)_InterlockedExchange64(&atomic->value, (LONG64)value);
}
static inline bool ATOMIC_FUNC(U64_CompareExchange)(CONCURRENCY_TYPE(TAtomicU64) *atomic,
                                                   uint64_t *expected,
                                                   uint64_t desired,
                                                   CONCURRENCY_TYPE(MemoryOrder) success,
                                                   CONCURRENCY_TYPE(MemoryOrder) failure) {
  LONG64 old;
  (void)success;
  (void)failure;
  old = _InterlockedCompareExchange64(&atomic->value, (LONG64)desired,
                                      (LONG64)*expected);
  if ((uint64_t)old == *expected)
    return true;
  *expected = (uint64_t)old;
  return false;
}
static inline uint64_t ATOMIC_FUNC(U64_FetchAdd)(CONCURRENCY_TYPE(TAtomicU64) *atomic,
                                                uint64_t value,
                                                CONCURRENCY_TYPE(MemoryOrder) order) {
  (void)order;
  return (uint64_t)_InterlockedExchangeAdd64(&atomic->value, (LONG64)value);
}
static inline uint64_t ATOMIC_FUNC(U64_FetchSub)(CONCURRENCY_TYPE(TAtomicU64) *atomic,
                                                uint64_t value,
                                                CONCURRENCY_TYPE(MemoryOrder) order) {
  return ATOMIC_FUNC(U64_FetchAdd)(atomic, (uint64_t)(0ull - value), order);
}
static inline uint64_t ATOMIC_FUNC(U64_FetchAnd)(CONCURRENCY_TYPE(TAtomicU64) *atomic,
                                                uint64_t value,
                                                CONCURRENCY_TYPE(MemoryOrder) order) {
  (void)order;
  return (uint64_t)_InterlockedAnd64(&atomic->value, (LONG64)value);
}
static inline uint64_t ATOMIC_FUNC(U64_FetchOr)(CONCURRENCY_TYPE(TAtomicU64) *atomic,
                                               uint64_t value,
                                               CONCURRENCY_TYPE(MemoryOrder) order) {
  (void)order;
  return (uint64_t)_InterlockedOr64(&atomic->value, (LONG64)value);
}
static inline uint64_t ATOMIC_FUNC(U64_FetchXor)(CONCURRENCY_TYPE(TAtomicU64) *atomic,
                                                uint64_t value,
                                                CONCURRENCY_TYPE(MemoryOrder) order) {
  (void)order;
  return (uint64_t)_InterlockedXor64(&atomic->value, (LONG64)value);
}
#endif

static inline uintptr_t ATOMIC_FUNC(Ptr_Load)(const CONCURRENCY_TYPE(TAtomicPtr) *atomic,
                                            CONCURRENCY_TYPE(MemoryOrder) order) {
  (void)order;
  return (uintptr_t)_InterlockedCompareExchangePointer(
      (void *volatile *)&atomic->value, NULL, NULL);
}
static inline void ATOMIC_FUNC(Ptr_Store)(CONCURRENCY_TYPE(TAtomicPtr) *atomic, uintptr_t value,
                                        CONCURRENCY_TYPE(MemoryOrder) order) {
  (void)order;
  (void)_InterlockedExchangePointer(&atomic->value, (void *)value);
}
static inline uintptr_t ATOMIC_FUNC(Ptr_Exchange)(CONCURRENCY_TYPE(TAtomicPtr) *atomic,
                                                uintptr_t value,
                                                CONCURRENCY_TYPE(MemoryOrder) order) {
  (void)order;
  return (uintptr_t)_InterlockedExchangePointer(&atomic->value, (void *)value);
}
static inline bool ATOMIC_FUNC(Ptr_CompareExchange)(CONCURRENCY_TYPE(TAtomicPtr) *atomic,
                                                  uintptr_t *expected,
                                                  uintptr_t desired,
                                                  CONCURRENCY_TYPE(MemoryOrder) success,
                                                  CONCURRENCY_TYPE(MemoryOrder) failure) {
  void *old;
  (void)success;
  (void)failure;
  old = _InterlockedCompareExchangePointer(&atomic->value, (void *)desired,
                                           (void *)*expected);
  if ((uintptr_t)old == *expected)
    return true;
  *expected = (uintptr_t)old;
  return false;
}

static inline bool ATOMIC_FUNC(Bool_Load)(const CONCURRENCY_TYPE(TAtomicBool) *atomic,
                                        CONCURRENCY_TYPE(MemoryOrder) order) {
  (void)order;
  return _InterlockedCompareExchange((volatile LONG *)&atomic->value, 0, 0) != 0;
}
static inline void ATOMIC_FUNC(Bool_Store)(CONCURRENCY_TYPE(TAtomicBool) *atomic, bool value,
                                         CONCURRENCY_TYPE(MemoryOrder) order) {
  (void)order;
  (void)_InterlockedExchange(&atomic->value, (LONG)value);
}
static inline bool ATOMIC_FUNC(Bool_Exchange)(CONCURRENCY_TYPE(TAtomicBool) *atomic, bool value,
                                             CONCURRENCY_TYPE(MemoryOrder) order) {
  (void)order;
  return _InterlockedExchange(&atomic->value, (LONG)value) != 0;
}
