#pragma once

static inline OPSTATUS COROUTINE_FUNC(Init)(CONCURRENCY_TYPE(TCoroutine) *coroutine,
                                      CONCURRENCY_TYPE(CoroutineFunction) function,
                                      void *argument) {
  if (coroutine == NULL || function == NULL)
    return STATUS_CONST(INVALID_ARGUMENT);

  coroutine->function = function;
  coroutine->argument = argument;
  coroutine->continuation = 0u;
  coroutine->state = CONCURRENCY_CONST(COROUTINE, STATE_READY);
  return STATUS_CONST(SUCCESS);
}

static inline OPSTATUS COROUTINE_FUNC(Resume)(CONCURRENCY_TYPE(TCoroutine) *coroutine) {
  if (coroutine == NULL || coroutine->function == NULL)
    return STATUS_CONST(INVALID_ARGUMENT);
  if (coroutine->state == CONCURRENCY_CONST(COROUTINE, STATE_RUNNING))
    return STATUS_CONST(BUSY);
  if (coroutine->state == CONCURRENCY_CONST(COROUTINE, STATE_FINISHED))
    return STATUS_CONST(NOT_AVAILABLE);

  coroutine->function(coroutine, coroutine->argument);
  return STATUS_CONST(SUCCESS);
}

static inline OPSTATUS COROUTINE_FUNC(Reset)(CONCURRENCY_TYPE(TCoroutine) *coroutine) {
  if (coroutine == NULL || coroutine->function == NULL)
    return STATUS_CONST(INVALID_ARGUMENT);
  if (coroutine->state == CONCURRENCY_CONST(COROUTINE, STATE_RUNNING))
    return STATUS_CONST(BUSY);

  coroutine->continuation = 0u;
  coroutine->state = CONCURRENCY_CONST(COROUTINE, STATE_READY);
  return STATUS_CONST(SUCCESS);
}

static inline CONCURRENCY_TYPE(CoroutineState)
COROUTINE_FUNC(GetState)(const CONCURRENCY_TYPE(TCoroutine) *coroutine) {
  return coroutine == NULL ? CONCURRENCY_CONST(COROUTINE, STATE_FINISHED) : coroutine->state;
}

static inline bool COROUTINE_FUNC(IsReady)(const CONCURRENCY_TYPE(TCoroutine) *coroutine) {
  return coroutine != NULL && coroutine->state == CONCURRENCY_CONST(COROUTINE, STATE_READY);
}

static inline bool COROUTINE_FUNC(IsRunning)(const CONCURRENCY_TYPE(TCoroutine) *coroutine) {
  return coroutine != NULL && coroutine->state == CONCURRENCY_CONST(COROUTINE, STATE_RUNNING);
}

static inline bool COROUTINE_FUNC(IsSuspended)(const CONCURRENCY_TYPE(TCoroutine) *coroutine) {
  return coroutine != NULL && coroutine->state == CONCURRENCY_CONST(COROUTINE, STATE_SUSPENDED);
}

static inline bool COROUTINE_FUNC(IsFinished)(const CONCURRENCY_TYPE(TCoroutine) *coroutine) {
  return coroutine != NULL && coroutine->state == CONCURRENCY_CONST(COROUTINE, STATE_FINISHED);
}

/* EOF */
