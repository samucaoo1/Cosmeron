#pragma once
#include "../RWLock.h"
#if OS_POSIX
#include <errno.h>
RWLOCK_INIT_PROTOTYPE { if (lock == NULL) return STATUS_CONST(INVALID_ARGUMENT); return pthread_rwlock_init(&lock->native, NULL) == 0 ? STATUS_CONST(SUCCESS) : STATUS_CONST(GENERIC_ERROR); }
RWLOCK_DESTROY_PROTOTYPE { if (lock == NULL) return STATUS_CONST(INVALID_ARGUMENT); return pthread_rwlock_destroy(&lock->native) == 0 ? STATUS_CONST(SUCCESS) : STATUS_CONST(BUSY); }
RWLOCK_READ_LOCK_PROTOTYPE { if (lock == NULL) return STATUS_CONST(INVALID_ARGUMENT); return pthread_rwlock_rdlock(&lock->native) == 0 ? STATUS_CONST(SUCCESS) : STATUS_CONST(GENERIC_ERROR); }
RWLOCK_TRY_READ_LOCK_PROTOTYPE {
  int result;
  if (lock == NULL || outAcquired == NULL) return STATUS_CONST(INVALID_ARGUMENT);
  result = pthread_rwlock_tryrdlock(&lock->native);
  if (result == 0) { *outAcquired = true; return STATUS_CONST(SUCCESS); }
  if (result == EBUSY) { *outAcquired = false; return STATUS_CONST(SUCCESS); }
  return STATUS_CONST(GENERIC_ERROR);
}
RWLOCK_READ_UNLOCK_PROTOTYPE { if (lock == NULL) return STATUS_CONST(INVALID_ARGUMENT); return pthread_rwlock_unlock(&lock->native) == 0 ? STATUS_CONST(SUCCESS) : STATUS_CONST(GENERIC_ERROR); }
RWLOCK_WRITE_LOCK_PROTOTYPE { if (lock == NULL) return STATUS_CONST(INVALID_ARGUMENT); return pthread_rwlock_wrlock(&lock->native) == 0 ? STATUS_CONST(SUCCESS) : STATUS_CONST(GENERIC_ERROR); }
RWLOCK_TRY_WRITE_LOCK_PROTOTYPE {
  int result;
  if (lock == NULL || outAcquired == NULL) return STATUS_CONST(INVALID_ARGUMENT);
  result = pthread_rwlock_trywrlock(&lock->native);
  if (result == 0) { *outAcquired = true; return STATUS_CONST(SUCCESS); }
  if (result == EBUSY) { *outAcquired = false; return STATUS_CONST(SUCCESS); }
  return STATUS_CONST(GENERIC_ERROR);
}
RWLOCK_WRITE_UNLOCK_PROTOTYPE { if (lock == NULL) return STATUS_CONST(INVALID_ARGUMENT); return pthread_rwlock_unlock(&lock->native) == 0 ? STATUS_CONST(SUCCESS) : STATUS_CONST(GENERIC_ERROR); }
#elif OS_WINDOWS
RWLOCK_INIT_PROTOTYPE { if (lock == NULL) return STATUS_CONST(INVALID_ARGUMENT); InitializeSRWLock(&lock->native); return STATUS_CONST(SUCCESS); }
RWLOCK_DESTROY_PROTOTYPE { return lock == NULL ? STATUS_CONST(INVALID_ARGUMENT) : STATUS_CONST(SUCCESS); }
RWLOCK_READ_LOCK_PROTOTYPE { if (lock == NULL) return STATUS_CONST(INVALID_ARGUMENT); AcquireSRWLockShared(&lock->native); return STATUS_CONST(SUCCESS); }
RWLOCK_TRY_READ_LOCK_PROTOTYPE {
  if (lock == NULL || outAcquired == NULL) return STATUS_CONST(INVALID_ARGUMENT);
  *outAcquired = TryAcquireSRWLockShared(&lock->native) != 0;
  return STATUS_CONST(SUCCESS);
}
RWLOCK_READ_UNLOCK_PROTOTYPE { if (lock == NULL) return STATUS_CONST(INVALID_ARGUMENT); ReleaseSRWLockShared(&lock->native); return STATUS_CONST(SUCCESS); }
RWLOCK_WRITE_LOCK_PROTOTYPE { if (lock == NULL) return STATUS_CONST(INVALID_ARGUMENT); AcquireSRWLockExclusive(&lock->native); return STATUS_CONST(SUCCESS); }
RWLOCK_TRY_WRITE_LOCK_PROTOTYPE {
  if (lock == NULL || outAcquired == NULL) return STATUS_CONST(INVALID_ARGUMENT);
  *outAcquired = TryAcquireSRWLockExclusive(&lock->native) != 0;
  return STATUS_CONST(SUCCESS);
}
RWLOCK_WRITE_UNLOCK_PROTOTYPE { if (lock == NULL) return STATUS_CONST(INVALID_ARGUMENT); ReleaseSRWLockExclusive(&lock->native); return STATUS_CONST(SUCCESS); }
#endif
