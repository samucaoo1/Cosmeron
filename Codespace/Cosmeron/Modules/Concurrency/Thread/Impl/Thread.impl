#pragma once

#include "../../../../Core/Memory/Alloc.h"

#if OS_POSIX

#include <sched.h>

typedef struct CONCURRENCY_INS(ThreadStart_InternalType_) {
  CONCURRENCY_TYPE(ThreadFunction) function;
  void *argument;
} CONCURRENCY_INS(ThreadStart_InternalType_);

static inline void *CONCURRENCY_INS(ThreadStart)(void *opaque) {
  CONCURRENCY_INS(ThreadStart_InternalType_) *start = (CONCURRENCY_INS(ThreadStart_InternalType_) *)opaque;
  CONCURRENCY_TYPE(ThreadFunction) function = start->function;
  void *argument = start->argument;
  Memory_Free(start);
  function(argument);
  return NULL;
}

THREAD_CREATE_PROTOTYPE {
  if (thread == NULL || function == NULL)
    return STATUS_CONST(INVALID_ARGUMENT);
  CONCURRENCY_INS(ThreadStart_InternalType_) *start;
  {
    void *allocated = NULL;
    if (ALLOC_FUNC(AllocBytes)(&allocated, sizeof(*start)) != STATUS_CONST(SUCCESS))
      return STATUS_CONST(OUT_OF_MEMORY);
    start = (CONCURRENCY_INS(ThreadStart_InternalType_) *)allocated;
  }
  start->function = function;
  start->argument = argument;
  if (pthread_create(&thread->native, NULL, CONCURRENCY_INS(ThreadStart), start) != 0) {
    Memory_Free(start);
    thread->joinable = false;
    return STATUS_CONST(GENERIC_ERROR);
  }
  thread->joinable = true;
  return STATUS_CONST(SUCCESS);
}

THREAD_JOIN_PROTOTYPE {
  if (thread == NULL)
    return STATUS_CONST(INVALID_ARGUMENT);
  if (!thread->joinable)
    return STATUS_CONST(NOT_AVAILABLE);
  if (pthread_join(thread->native, NULL) != 0)
    return STATUS_CONST(GENERIC_ERROR);
  thread->joinable = false;
  return STATUS_CONST(SUCCESS);
}

THREAD_DETACH_PROTOTYPE {
  if (thread == NULL)
    return STATUS_CONST(INVALID_ARGUMENT);
  if (!thread->joinable)
    return STATUS_CONST(NOT_AVAILABLE);
  if (pthread_detach(thread->native) != 0)
    return STATUS_CONST(GENERIC_ERROR);
  thread->joinable = false;
  return STATUS_CONST(SUCCESS);
}

THREAD_YIELD_PROTOTYPE { (void)sched_yield(); }

THREAD_CURRENT_PROTOTYPE { return pthread_self(); }

THREAD_EQUAL_PROTOTYPE {
  return pthread_equal(first, second) != 0;
}

#elif OS_WINDOWS

typedef struct CONCURRENCY_INS(ThreadStart_InternalType_) {
  CONCURRENCY_TYPE(ThreadFunction) function;
  void *argument;
} CONCURRENCY_INS(ThreadStart_InternalType_);

static inline DWORD WINAPI CONCURRENCY_INS(ThreadStart)(LPVOID opaque) {
  CONCURRENCY_INS(ThreadStart_InternalType_) *start = (CONCURRENCY_INS(ThreadStart_InternalType_) *)opaque;
  CONCURRENCY_TYPE(ThreadFunction) function = start->function;
  void *argument = start->argument;
  Memory_Free(start);
  function(argument);
  return 0;
}

THREAD_CREATE_PROTOTYPE {
  CONCURRENCY_INS(ThreadStart_InternalType_) *start;
  if (thread == NULL || function == NULL)
    return STATUS_CONST(INVALID_ARGUMENT);
  {
    void *allocated = NULL;
    if (ALLOC_FUNC(AllocBytes)(&allocated, sizeof(*start)) != STATUS_CONST(SUCCESS))
      return STATUS_CONST(OUT_OF_MEMORY);
    start = (CONCURRENCY_INS(ThreadStart_InternalType_) *)allocated;
  }
  start->function = function;
  start->argument = argument;
  thread->native = CreateThread(NULL, 0, CONCURRENCY_INS(ThreadStart), start, 0,
                                NULL);
  if (thread->native == NULL) {
    Memory_Free(start);
    thread->joinable = false;
    return STATUS_CONST(GENERIC_ERROR);
  }
  thread->joinable = true;
  return STATUS_CONST(SUCCESS);
}

THREAD_JOIN_PROTOTYPE {
  if (thread == NULL)
    return STATUS_CONST(INVALID_ARGUMENT);
  if (!thread->joinable)
    return STATUS_CONST(NOT_AVAILABLE);
  if (WaitForSingleObject(thread->native, INFINITE) != WAIT_OBJECT_0)
    return STATUS_CONST(GENERIC_ERROR);
  CloseHandle(thread->native);
  thread->joinable = false;
  return STATUS_CONST(SUCCESS);
}

THREAD_DETACH_PROTOTYPE {
  if (thread == NULL)
    return STATUS_CONST(INVALID_ARGUMENT);
  if (!thread->joinable)
    return STATUS_CONST(NOT_AVAILABLE);
  if (!CloseHandle(thread->native))
    return STATUS_CONST(GENERIC_ERROR);
  thread->joinable = false;
  return STATUS_CONST(SUCCESS);
}

THREAD_YIELD_PROTOTYPE { SwitchToThread(); }

THREAD_CURRENT_PROTOTYPE {
  return GetCurrentThread();
}

THREAD_EQUAL_PROTOTYPE {
  return GetThreadId(first) == GetThreadId(second);
}

#endif
