/* Stack.def - Dual Mode Engine (Zero Duplication) */

#ifndef TEMPLATE_Array_Stack
#define TEMPLATE_Array_Stack(SUFFIX, TYPE)                                     \
  TEMPLATE_OBJECT(Array, Stack, SUFFIX,                                        \
      FIELDS(                                                                  \
          TYPE *data;                                                          \
          size_t size;                                                         \
          size_t capacity;                                                     \
      ),                                                                       \
                                                                               \
      CLOSURE(                                                                 \
          PROCEDURE(Visitor, (TYPE *element)),                                 \
          PREDICATE(Predicate, (const TYPE *element))),                        \
                                                                               \
      OPERATION_INLINE(Create, (size_t initialCapacity), {                     \
        if (!self)                                                             \
          return STATUS_CONST(INVALID_ARGUMENT);                               \
        MODULE_FUNC(Array, Stack, SUFFIX, Init)(self);                         \
        self->data = NULL;                                                     \
        self->size = 0U;                                                       \
        self->capacity = 0U;                                                   \
        if (initialCapacity == 0U)                                             \
          return STATUS_CONST(SUCCESS);                                        \
        return MODULE_IFUNC(Array, ReserveBuffer)(                             \
            (void **)&self->data, &self->capacity, initialCapacity,            \
            sizeof(TYPE));                                                     \
      }),                                                                      \
                                                                               \
      OPERATION_INLINE(Dispose, (), {                                          \
        if (!self)                                                             \
          return STATUS_CONST(INVALID_ARGUMENT);                               \
        if (self->data)                                                        \
          Memory_Free(self->data);                                             \
        self->data = NULL;                                                     \
        self->size = 0U;                                                       \
        self->capacity = 0U;                                                   \
        return STATUS_CONST(SUCCESS);                                          \
      }),                                                                      \
                                                                               \
      PROCEDURE_INLINE(Destroy, (), {                                          \
        (void)MODULE_FUNC(Array, Stack, SUFFIX, Dispose)(self);                \
      }),                                                                      \
                                                                               \
      OPERATION_INLINE(Reserve, (size_t newCapacity), {                        \
        if (!self)                                                             \
          return STATUS_CONST(INVALID_ARGUMENT);                               \
        return MODULE_IFUNC(Array, ReserveBuffer)(                             \
            (void **)&self->data, &self->capacity, newCapacity, sizeof(TYPE)); \
      }),                                                                      \
                                                                               \
      OPERATION_INLINE(ShrinkToFit, (), {                                      \
        if (!self)                                                             \
          return STATUS_CONST(INVALID_ARGUMENT);                               \
        return MODULE_IFUNC(Array, ShrinkBuffer)(                              \
            (void **)&self->data, self->size, &self->capacity, sizeof(TYPE));  \
      }),                                                                      \
                                                                               \
      PROCEDURE_INLINE(Clear, (), {                                            \
        if (self)                                                              \
          self->size = 0U;                                                     \
      }),                                                                      \
                                                                               \
      OPERATION_INLINE(Push, (TYPE value), {                                   \
        if (!self)                                                             \
          return STATUS_CONST(INVALID_ARGUMENT);                               \
        OPSTATUS status = MODULE_IFUNC(Array, EnsureCapacity)(                 \
            (void **)&self->data, self->size, &self->capacity, sizeof(TYPE));  \
        if (status != STATUS_CONST(SUCCESS))                                   \
          return status;                                                       \
        self->data[self->size++] = value;                                      \
        return STATUS_CONST(SUCCESS);                                          \
      }),                                                                      \
                                                                               \
      OPERATION_INLINE(Pop, (TYPE *outValue), {                                \
        if (!self || !outValue)                                                \
          return STATUS_CONST(INVALID_ARGUMENT);                               \
        if (self->size == 0U)                                                  \
          return STATUS_CONST(OUT_OF_RANGE);                                   \
        *outValue = self->data[--self->size];                                  \
        return STATUS_CONST(SUCCESS);                                          \
      }),                                                                      \
                                                                               \
      OPERATION_INLINE(Top, (TYPE **out), {                                    \
        if (!self || !out)                                                     \
          return STATUS_CONST(INVALID_ARGUMENT);                               \
        if (self->size == 0U)                                                  \
          return STATUS_CONST(OUT_OF_RANGE);                                   \
        *out = &self->data[self->size - 1U];                                   \
        return STATUS_CONST(SUCCESS);                                          \
      }),                                                                      \
                                                                               \
      CONST_OPERATION_INLINE(Peek, (TYPE *outValue), {                         \
        if (!self || !outValue)                                                \
          return STATUS_CONST(INVALID_ARGUMENT);                               \
        if (self->size == 0U)                                                  \
          return STATUS_CONST(OUT_OF_RANGE);                                   \
        *outValue = self->data[self->size - 1U];                               \
        return STATUS_CONST(SUCCESS);                                          \
      }),                                                                      \
                                                                               \
      CONST_PREDICATE_INLINE(IsEmpty, (), {                                    \
        return !self || self->size == 0U;                                      \
      }),                                                                      \
                                                                               \
      CONST_PREDICATE_INLINE(Empty, (), {                                      \
        return !self || self->size == 0U;                                      \
      }),                                                                      \
                                                                               \
      CONST_FUNCTION_INLINE(size_t, Size, (), {                                \
        return self ? self->size : 0U;                                         \
      }),                                                                      \
                                                                               \
      CONST_FUNCTION_INLINE(size_t, Count, (), {                               \
        return self ? self->size : 0U;                                         \
      }),                                                                      \
                                                                               \
      CONST_FUNCTION_INLINE(size_t, Capacity, (), {                            \
        return self ? self->capacity : 0U;                                     \
      }),                                                                      \
                                                                               \
      /* --- Iterator Protocol (Bottom-to-Top / Top-to-Bottom) --- */          \
      OPERATION_INLINE(                                                        \
          Begin,                                                               \
          (struct MODULE_TYPED(Iterator, Contiguous, SUFFIX) *outIter), {      \
            if (!self || !outIter)                                             \
              return STATUS_CONST(INVALID_ARGUMENT);                           \
            return MODULE_FUNC(Iterator, Contiguous, SUFFIX, FromBuffer)(      \
                outIter, self->data, self->size, 0U, false);                   \
          }),                                                                  \
                                                                               \
      OPERATION_INLINE(                                                        \
          End,                                                                 \
          (struct MODULE_TYPED(Iterator, Contiguous, SUFFIX) *outIter), {      \
            if (!self || !outIter)                                             \
              return STATUS_CONST(INVALID_ARGUMENT);                           \
            return MODULE_FUNC(Iterator, Contiguous, SUFFIX, FromBuffer)(      \
                outIter, self->data, self->size, self->size, false);           \
          }),                                                                  \
                                                                               \
      OPERATION_INLINE(                                                        \
          RBegin,                                                              \
          (struct MODULE_TYPED(Iterator, Contiguous, SUFFIX) *outIter), {      \
            if (!self || !outIter)                                             \
              return STATUS_CONST(INVALID_ARGUMENT);                           \
            return MODULE_FUNC(Iterator, Contiguous, SUFFIX, FromBuffer)(      \
                outIter, self->data, self->size, 0U, true);                    \
          }),                                                                  \
                                                                               \
      OPERATION_INLINE(                                                        \
          REnd,                                                                \
          (struct MODULE_TYPED(Iterator, Contiguous, SUFFIX) *outIter), {      \
            if (!self || !outIter)                                             \
              return STATUS_CONST(INVALID_ARGUMENT);                           \
            return MODULE_FUNC(Iterator, Contiguous, SUFFIX, FromBuffer)(      \
                outIter, self->data, self->size, self->size, true);            \
          })                                                                   \
  )
#define TEMPLATE_Stack(SUFFIX, TYPE) TEMPLATE_Array_Stack(SUFFIX, TYPE)
#endif

/* Mode 2 (Direct Include): Auto-instantiates and cleans up environment */
#if defined(SUFFIX) && defined(TYPE)
  TEMPLATE_Array_Stack(SUFFIX, TYPE);
  #undef SUFFIX
  #undef TYPE
#endif

