#pragma once

#include <string.h>

MODULE_IMPLEMENT(DOMAIN(Container), Bitset,
  INTERNAL_EX(Dynamic,
    FUNCTION(size_t, LimbsNeeded, (size_t bitCount), {
      if (bitCount == 0U)
        return 0U;
      const size_t limbBits = (size_t)CNS(Bit, Internal, U64_BITS);
      return ((bitCount - 1U) / limbBits) + 1U;
    })
  ),

  OBJECT(Dynamic,
    VARIANT(Create,
      OPERATION((size_t bitCount), {
        return MODULE_FUNC(Bitset, Dynamic, CreateWithAllocator)(
            self, bitCount, MODULE_FUNC(Memory, Allocator, Default)());
      }),

      OPERATION(WithAllocator,
                (size_t bitCount, MODULE_TYPE(Memory, Allocator) allocator), {
        if (!self)
          return STATUS_CONST(INVALID_ARGUMENT);
        MODULE_FUNC(Bitset, Dynamic, Init)(self);
        self->limbs = NULL;
        self->bitCount = 0U;
        self->limbCount = 0U;
        self->limbCapacity = 0U;
        self->allocator = MODULE_FUNC(Memory, Allocator, IsValid)(&allocator)
                              ? allocator
                              : MODULE_FUNC(Memory, Allocator, Default)();
        if (bitCount == 0U)
          return STATUS_CONST(SUCCESS);
        const size_t neededLimbs =
            MODULE_IFUNC(Bitset, Dynamic, LimbsNeeded)(bitCount);
        OPSTATUS status = MODULE_FUNC(Memory, Allocator, Calloc)(
            &self->allocator, neededLimbs, sizeof(uint64_t),
            (void **)&self->limbs);
        if (status != STATUS_CONST(SUCCESS))
          return status;
        self->bitCount = bitCount;
        self->limbCount = neededLimbs;
        self->limbCapacity = neededLimbs;
        return STATUS_CONST(SUCCESS);
      })
    ),

    OPERATION(Dispose, (), {
      if (!self)
        return STATUS_CONST(INVALID_ARGUMENT);
      if (self->limbs) {
        MODULE_FUNC(Memory, Allocator, Free)(
            &self->allocator, self->limbs,
            self->limbCapacity * sizeof(uint64_t));
      }
      OBJECT_RESET_ZERO(Bitset, Dynamic, self);
      return STATUS_CONST(SUCCESS);
    }),

    OPERATION(Reserve, (size_t minBitCapacity), {
      if (!self)
        return STATUS_CONST(INVALID_ARGUMENT);
      const size_t neededLimbs =
          MODULE_IFUNC(Bitset, Dynamic, LimbsNeeded)(minBitCapacity);
      if (neededLimbs <= self->limbCapacity)
        return STATUS_CONST(SUCCESS);
      void *newLimbsRaw = NULL;
      OPSTATUS status = MODULE_FUNC(Memory, Allocator, Realloc)(
          &self->allocator, self->limbs, self->limbCapacity * sizeof(uint64_t),
          neededLimbs * sizeof(uint64_t), &newLimbsRaw);
      if (status != STATUS_CONST(SUCCESS))
        return status;
      uint64_t *newLimbs = (uint64_t *)newLimbsRaw;
      memset(&newLimbs[self->limbCapacity], 0,
             (neededLimbs - self->limbCapacity) * sizeof(uint64_t));
      self->limbs = newLimbs;
      self->limbCapacity = neededLimbs;
      return STATUS_CONST(SUCCESS);
    }),

    OPERATION(Resize, (size_t newBitCount), {
      if (!self)
        return STATUS_CONST(INVALID_ARGUMENT);
      const size_t newLimbCount =
          MODULE_IFUNC(Bitset, Dynamic, LimbsNeeded)(newBitCount);
      if (newLimbCount > self->limbCapacity) {
        OPSTATUS status =
            MODULE_FUNC(Bitset, Dynamic, Reserve)(self, newBitCount);
        if (status != STATUS_CONST(SUCCESS))
          return status;
      }
      if (newLimbCount > self->limbCount && self->limbs) {
        memset(&self->limbs[self->limbCount], 0,
               (newLimbCount - self->limbCount) * sizeof(uint64_t));
      }
      self->bitCount = newBitCount;
      self->limbCount = newLimbCount;
      MODULE_IFUNC(Type, LimbsMaskTail)(self->limbs, self->limbCount,
                                        self->bitCount);
      return STATUS_CONST(SUCCESS);
    }),

    CONST_OPERATION(Clone,
                    (MODULE_TYPE(Bitset, Dynamic) *outClone), {
      if (!self || !outClone || self == outClone)
        return STATUS_CONST(INVALID_ARGUMENT);
      OPSTATUS status = MODULE_FUNC(Bitset, Dynamic, Create)(
          outClone, self->bitCount);
      if (status != STATUS_CONST(SUCCESS))
        return status;
      if (self->limbCount > 0U && self->limbs && outClone->limbs) {
        memcpy(outClone->limbs, self->limbs,
               self->limbCount * sizeof(uint64_t));
      }
      return STATUS_CONST(SUCCESS);
    }),

    OPERATION(Clear, (), {
      if (!self)
        return STATUS_CONST(INVALID_ARGUMENT);
      if (self->limbs && self->limbCount > 0U)
        memset(self->limbs, 0, self->limbCount * sizeof(uint64_t));
      return STATUS_CONST(SUCCESS);
    }),

    OPERATION(SetAll, (), {
      if (!self)
        return STATUS_CONST(INVALID_ARGUMENT);
      if (self->limbs && self->limbCount > 0U) {
        memset(self->limbs, CNS(Bit, Internal, BYTE_ALL_ONES),
               self->limbCount * sizeof(uint64_t));
        MODULE_IFUNC(Type, LimbsMaskTail)(self->limbs, self->limbCount,
                                          self->bitCount);
      }
      return STATUS_CONST(SUCCESS);
    }),

    OPERATION(And, (const MODULE_TYPE(Bitset, Dynamic) *source), {
      if (!self || !source || self->bitCount != source->bitCount)
        return STATUS_CONST(INVALID_ARGUMENT);
      for (size_t i = 0U; i < self->limbCount; ++i)
        self->limbs[i] &= source->limbs[i];
      return STATUS_CONST(SUCCESS);
    }),

    OPERATION(Or, (const MODULE_TYPE(Bitset, Dynamic) *source), {
      if (!self || !source || self->bitCount != source->bitCount)
        return STATUS_CONST(INVALID_ARGUMENT);
      for (size_t i = 0U; i < self->limbCount; ++i)
        self->limbs[i] |= source->limbs[i];
      MODULE_IFUNC(Type, LimbsMaskTail)(self->limbs, self->limbCount,
                                        self->bitCount);
      return STATUS_CONST(SUCCESS);
    }),

    OPERATION(Xor, (const MODULE_TYPE(Bitset, Dynamic) *source), {
      if (!self || !source || self->bitCount != source->bitCount)
        return STATUS_CONST(INVALID_ARGUMENT);
      for (size_t i = 0U; i < self->limbCount; ++i)
        self->limbs[i] ^= source->limbs[i];
      MODULE_IFUNC(Type, LimbsMaskTail)(self->limbs, self->limbCount,
                                        self->bitCount);
      return STATUS_CONST(SUCCESS);
    }),

    OPERATION(Not, (), {
      if (!self)
        return STATUS_CONST(INVALID_ARGUMENT);
      for (size_t i = 0U; i < self->limbCount; ++i)
        self->limbs[i] = ~self->limbs[i];
      MODULE_IFUNC(Type, LimbsMaskTail)(self->limbs, self->limbCount,
                                        self->bitCount);
      return STATUS_CONST(SUCCESS);
    }),

    OPERATION(ShiftLeft, (size_t bitCount), {
      if (!self)
        return STATUS_CONST(INVALID_ARGUMENT);
      MODULE_IFUNC(Type, LimbsShiftLeft)(self->limbs, self->limbCount,
                                         self->bitCount, bitCount);
      return STATUS_CONST(SUCCESS);
    }),

    OPERATION(ShiftRight, (size_t bitCount), {
      if (!self)
        return STATUS_CONST(INVALID_ARGUMENT);
      MODULE_IFUNC(Type, LimbsShiftRight)(self->limbs, self->limbCount,
                                          bitCount);
      return STATUS_CONST(SUCCESS);
    }),

    VARIANT(Bit,
      OPERATION(Set, (size_t bit), {
        if (!self)
          return STATUS_CONST(INVALID_ARGUMENT);
        if (bit >= self->bitCount)
          return STATUS_CONST(OUT_OF_RANGE);
        const size_t limbBits = (size_t)CNS(Bit, Internal, U64_BITS);
        return MODULE_FUNC(Bit, 64, Set)(&self->limbs[bit / limbBits],
                                         (uint8_t)(bit % limbBits));
      }),

      OPERATION(Clear, (size_t bit), {
        if (!self)
          return STATUS_CONST(INVALID_ARGUMENT);
        if (bit >= self->bitCount)
          return STATUS_CONST(OUT_OF_RANGE);
        const size_t limbBits = (size_t)CNS(Bit, Internal, U64_BITS);
        return MODULE_FUNC(Bit, 64, Clear)(&self->limbs[bit / limbBits],
                                           (uint8_t)(bit % limbBits));
      }),

      OPERATION(Flip, (size_t bit), {
        if (!self)
          return STATUS_CONST(INVALID_ARGUMENT);
        if (bit >= self->bitCount)
          return STATUS_CONST(OUT_OF_RANGE);
        const size_t limbBits = (size_t)CNS(Bit, Internal, U64_BITS);
        return MODULE_FUNC(Bit, 64, Flip)(&self->limbs[bit / limbBits],
                                          (uint8_t)(bit % limbBits));
      }),

      CONST_OPERATION(Check, (size_t bit, bool *outResult), {
        if (!self || !outResult)
          return STATUS_CONST(INVALID_ARGUMENT);
        if (bit >= self->bitCount)
          return STATUS_CONST(OUT_OF_RANGE);
        const size_t limbBits = (size_t)CNS(Bit, Internal, U64_BITS);
        *outResult =
            MODULE_FUNC(Bit, 64, Check)(self->limbs[bit / limbBits],
                                        (uint8_t)(bit % limbBits));
        return STATUS_CONST(SUCCESS);
      }),

      CONST_PREDICATE(Test, (size_t bit), {
        if (!self || bit >= self->bitCount)
          return false;
        const size_t limbBits = (size_t)CNS(Bit, Internal, U64_BITS);
        return MODULE_FUNC(Bit, 64, Check)(self->limbs[bit / limbBits],
                                           (uint8_t)(bit % limbBits));
      })
    ),

    OPERATION(SetRange, (size_t startBit, size_t endBit), {
      if (!self)
        return STATUS_CONST(INVALID_ARGUMENT);
      if (startBit > endBit || endBit > self->bitCount)
        return STATUS_CONST(OUT_OF_RANGE);
      MODULE_IFUNC(Type, LimbsSetRange)(self->limbs, startBit, endBit);
      return STATUS_CONST(SUCCESS);
    }),

    OPERATION(ClearRange, (size_t startBit, size_t endBit), {
      if (!self)
        return STATUS_CONST(INVALID_ARGUMENT);
      if (startBit > endBit || endBit > self->bitCount)
        return STATUS_CONST(OUT_OF_RANGE);
      MODULE_IFUNC(Type, LimbsClearRange)(self->limbs, startBit, endBit);
      return STATUS_CONST(SUCCESS);
    }),

    OPERATION(FlipRange, (size_t startBit, size_t endBit), {
      if (!self)
        return STATUS_CONST(INVALID_ARGUMENT);
      if (startBit > endBit || endBit > self->bitCount)
        return STATUS_CONST(OUT_OF_RANGE);
      MODULE_IFUNC(Type, LimbsFlipRange)(self->limbs, startBit, endBit);
      return STATUS_CONST(SUCCESS);
    }),

    CONST_FUNCTION(size_t, Count, (), {
      if (!self)
        return 0U;
      return MODULE_IFUNC(Type, LimbsPopcount)(self->limbs, self->limbCount);
    }),

    CONST_FUNCTION(size_t, Size, (), {
      return self ? self->bitCount : 0U;
    }),

    CONST_FUNCTION(size_t, Capacity, (), {
      return self ? (self->limbCapacity * (size_t)CNS(Bit, Internal, U64_BITS))
                  : 0U;
    }),

    CONST_PREDICATE(Any, (), {
      if (!self)
        return false;
      return MODULE_IFUNC(Type, LimbsAny)(self->limbs, self->limbCount);
    }),

    CONST_PREDICATE(All, (), {
      if (!self || self->bitCount == 0U)
        return false;
      return MODULE_IFUNC(Type, LimbsAll)(self->limbs, self->limbCount,
                                          self->bitCount);
    }),

    CONST_PREDICATE(None, (), {
      return !MODULE_FUNC(Bitset, Dynamic, Any)(self);
    }),

    CONST_PREDICATE(Equal,
                    (const MODULE_TYPE(Bitset, Dynamic) *other), {
      if (!self || !other)
        return self == other;
      if (self->bitCount != other->bitCount)
        return false;
      if (self->limbCount == 0U)
        return true;
      return MODULE_IFUNC(Type, LimbsEqual)(self->limbs, other->limbs,
                                            self->limbCount);
    }),

    VARIANT(Is,
      CONST_PREDICATE(Subset,
                      (const MODULE_TYPE(Bitset, Dynamic) *other), {
        if (!self || !other || self->bitCount != other->bitCount)
          return false;
        if (self->limbCount == 0U)
          return true;
        return MODULE_IFUNC(Type, LimbsIsSubset)(self->limbs, other->limbs,
                                                 self->limbCount);
      }),

      CONST_PREDICATE(Disjoint,
                      (const MODULE_TYPE(Bitset, Dynamic) *other), {
        if (!self || !other || self->bitCount != other->bitCount)
          return false;
        if (self->limbCount == 0U)
          return true;
        return !MODULE_IFUNC(Type, LimbsIntersects)(self->limbs, other->limbs,
                                                    self->limbCount);
      })
    ),

    CONST_PREDICATE(Intersects,
                    (const MODULE_TYPE(Bitset, Dynamic) *other), {
      if (!self || !other || self->bitCount != other->bitCount)
        return false;
      if (self->limbCount == 0U)
        return false;
      return MODULE_IFUNC(Type, LimbsIntersects)(self->limbs, other->limbs,
                                                 self->limbCount);
    }),

    VARIANT(Find,
      CONST_OPERATION(FirstSet, (size_t *outBit), {
        if (!self || !outBit)
          return STATUS_CONST(INVALID_ARGUMENT);
        return MODULE_IFUNC(Type, LimbsFindFirstSet)(
                   self->limbs, self->limbCount, self->bitCount, outBit)
                   ? STATUS_CONST(SUCCESS)
                   : STATUS_CONST(NOT_FOUND);
      }),

      CONST_OPERATION(FirstZero, (size_t *outBit), {
        if (!self || !outBit)
          return STATUS_CONST(INVALID_ARGUMENT);
        return MODULE_IFUNC(Type, LimbsFindFirstZero)(
                   self->limbs, self->limbCount, self->bitCount, outBit)
                   ? STATUS_CONST(SUCCESS)
                   : STATUS_CONST(NOT_FOUND);
      }),

      CONST_OPERATION(NextSet, (size_t startBit, size_t *outBit), {
        if (!self || !outBit)
          return STATUS_CONST(INVALID_ARGUMENT);
        return MODULE_IFUNC(Type, LimbsFindNextSet)(
                   self->limbs, self->limbCount, self->bitCount, startBit, outBit)
                   ? STATUS_CONST(SUCCESS)
                   : STATUS_CONST(NOT_FOUND);
      })
    )
  )
);

/* EOF */
