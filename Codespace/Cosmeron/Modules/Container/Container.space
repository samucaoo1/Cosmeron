#pragma once

#ifndef CONTAINER_ENABLE_PSEUDO_METHODS
#define CONTAINER_ENABLE_PSEUDO_METHODS 1
#endif

#if CONTAINER_ENABLE_PSEUDO_METHODS != 0 && CONTAINER_ENABLE_PSEUDO_METHODS != 1
#error "CONTAINER_ENABLE_PSEUDO_METHODS must be 0 or 1"
#endif

#if CONTAINER_ENABLE_PSEUDO_METHODS
#define CONTAINER_API_FORWARD(API_TYPE) struct API_TYPE;
#define CONTAINER_API_FIELD(API_TYPE) const struct API_TYPE *api;
#define CONTAINER_API_BIND(SELF, API) ((SELF).api = &(API))
#define CONTAINER_API_INITIALIZER(API) .api = &(API),
#else
#define CONTAINER_API_FORWARD(API_TYPE)
#define CONTAINER_API_FIELD(API_TYPE)
#define CONTAINER_API_BIND(SELF, API) ((void)0)
#define CONTAINER_API_INITIALIZER(API)
#endif
