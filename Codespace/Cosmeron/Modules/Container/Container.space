#pragma once

#include "../../Core/Namespace.h"

#define CONTAINER_MOD Container
#define CONTAINER_CMOD CONTAINER

#define CONTAINER_NS(NAME) GNS2(LIB_PREFIX(CONTAINER_MOD), NAME)
#define CONTAINER_CNS(NAME) CNS2(LIB_PREFIX_CONST(CONTAINER_CMOD), NAME)
#define CONTAINER_INS(NAME) GNS3(LIB_PREFIX(CONTAINER_MOD), Internal, NAME)
#define CONTAINER_CINS(NAME) CNS3(LIB_PREFIX_CONST(CONTAINER_CMOD), INTERNAL, NAME)

#ifndef CONTAINER_DISABLE_FUNCTION_TABLE
#define CONTAINER_FUNCTION_TABLE_ENABLED 1
#else
#define CONTAINER_FUNCTION_TABLE_ENABLED 0
#endif

#if CONTAINER_FUNCTION_TABLE_ENABLED
#define CONTAINER_API_FORWARD(API_TYPE) struct API_TYPE;
#define CONTAINER_API_FIELD(API_TYPE) const struct API_TYPE *api;
#define CONTAINER_API_BIND(SELF, API) ((SELF).api = &(API))
#define CONTAINER_API_INITIALIZER(API) .api = &(API),
#else
#define CONTAINER_API_FORWARD(API_TYPE)
#define CONTAINER_API_FIELD(API_TYPE)
#define CONTAINER_API_BIND(SELF, API) ((void)0)
#define CONTAINER_API_INITIALIZER(API)
#endif
/* EOF */
