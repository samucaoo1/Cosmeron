#pragma once

#define GRAPH_IMPLEMENT(VERTEX_TYPE, VERTEX_SUFFIX, WEIGHT_TYPE, WEIGHT_SUFFIX)\
  GRAPH_IMPLEMENT_INIT(VERTEX_SUFFIX, WEIGHT_SUFFIX)                           \
  GRAPH_IMPLEMENT_DESTROY(VERTEX_SUFFIX, WEIGHT_SUFFIX)                        \
  GRAPH_IMPLEMENT_CLEAR(VERTEX_SUFFIX, WEIGHT_SUFFIX)                          \
  GRAPH_IMPLEMENT_ADD_VERTEX(VERTEX_TYPE, VERTEX_SUFFIX, WEIGHT_SUFFIX)        \
  GRAPH_IMPLEMENT_ADD_EDGE(WEIGHT_TYPE, VERTEX_SUFFIX, WEIGHT_SUFFIX)          \
  GRAPH_IMPLEMENT_REMOVE_EDGE(VERTEX_SUFFIX, WEIGHT_SUFFIX)                    \
  GRAPH_IMPLEMENT_REMOVE_VERTEX(VERTEX_SUFFIX, WEIGHT_SUFFIX)                  \
  GRAPH_IMPLEMENT_HAS_EDGE(VERTEX_SUFFIX, WEIGHT_SUFFIX)                       \
  GRAPH_IMPLEMENT_FIND_WEIGHT(WEIGHT_TYPE, VERTEX_SUFFIX, WEIGHT_SUFFIX)       \
  GRAPH_IMPLEMENT_CONST_FIND_WEIGHT(WEIGHT_TYPE, VERTEX_SUFFIX, WEIGHT_SUFFIX) \
  GRAPH_IMPLEMENT_VERTEX_COUNT(VERTEX_SUFFIX, WEIGHT_SUFFIX)                   \
  GRAPH_IMPLEMENT_EDGE_COUNT(VERTEX_SUFFIX, WEIGHT_SUFFIX)                     \
  GRAPH_IMPLEMENT_IS_EMPTY(VERTEX_SUFFIX, WEIGHT_SUFFIX)                       \
  GRAPH_IMPLEMENT_BFS(VERTEX_SUFFIX, WEIGHT_SUFFIX)                            \
  GRAPH_IMPLEMENT_DFS(VERTEX_SUFFIX, WEIGHT_SUFFIX)

#include "Lifecycle.impl"
#include "Modifiers.impl"
#include "Observers.impl"
#include "Search.impl"
