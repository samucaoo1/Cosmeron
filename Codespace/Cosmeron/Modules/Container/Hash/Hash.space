#pragma once

#include "../Container.space"

#include "../../../Core/Algorithm/Comparison.h"
#include "../../../Core/Error/Status.h"
#include "../../../Core/Memory/Alloc.h"
#include "../../../Core/Namespace.h"

#include <stdbool.h>
#include <stddef.h>
#include <stdint.h>
#include <string.h>

#define HASH_NS(NAME) GNS2(LIB_PREFIX(Hash), NAME)

#define HASH_INITIAL_CAPACITY 16u
#define HASH_LOAD_PERCENT 75u

#define HASH_BUCKET_EMPTY 0u
#define HASH_BUCKET_OCCUPIED 1u
#define HASH_BUCKET_DELETED 2u

#define HASH_SUFFIX(KEY_SUFFIX, VALUE_SUFFIX) GNS2(KEY_SUFFIX, VALUE_SUFFIX)

#define THASH_TYPE(KEY_SUFFIX, VALUE_SUFFIX)                                  \
  GNS2(LIB_PREFIX(THash), HASH_SUFFIX(KEY_SUFFIX, VALUE_SUFFIX))

#define THASH_BUCKET_TYPE(KEY_SUFFIX, VALUE_SUFFIX)                           \
  GNS2(LIB_PREFIX(THashBucket), HASH_SUFFIX(KEY_SUFFIX, VALUE_SUFFIX))

#define HASH_FUNC(KEY_SUFFIX, VALUE_SUFFIX, FUNC)                             \
  GNS2(GNS2(HASH_NS(HASH_SUFFIX(KEY_SUFFIX, VALUE_SUFFIX)), FUNC), Function)

#define HASH_OPERATION(KEY_SUFFIX, VALUE_SUFFIX, FUNC)                        \
  GNS2(HASH_NS(HASH_SUFFIX(KEY_SUFFIX, VALUE_SUFFIX)), FUNC)

#define HASH_INT(VALUE)                                                       \
  ((size_t)((uint32_t)(VALUE) * UINT32_C(2654435761)))

static inline size_t Hash_CString(const char *value) {
  size_t hash = (size_t)UINT64_C(14695981039346656037);
  if (!value)
    return 0;
  while (*value) {
    hash ^= (uint8_t)*value++;
    hash *= (size_t)UINT64_C(1099511628211);
  }
  return hash;
}

#define HASH_CSTRING(VALUE) Hash_CString((VALUE))
#define HASH_EQUAL_INT(A, B) ((A) == (B))
#define HASH_EQUAL_CSTRING(A, B)                                              \
  (((A) == NULL || (B) == NULL) ? ((A) == (B)) : (strcmp((A), (B)) == 0))
