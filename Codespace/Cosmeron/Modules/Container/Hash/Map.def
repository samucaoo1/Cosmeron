/* Map.def - Dual Mode Engine (Zero Duplication) */

#ifndef TEMPLATE_Hash_HashMap
#define TEMPLATE_Hash_HashMap(SUFFIX, KEY_TYPE, VALUE_TYPE)                    \
  TEMPLATE_ISTRUCT(Hash, HashMapBucket, SUFFIX,                                \
      FIELDS(                                                                  \
          KEY_TYPE key;                                                        \
          VALUE_TYPE value;                                                    \
          MODULE_ENUM(Hash, BucketState) state;                                \
      ));                                                                      \
  CLOSURE_SCOPED_FUNCTION(NS(LIB_PREFIX(Hash), HashMap, SUFFIX), size_t,       \
                          Hasher, (KEY_TYPE key))                              \
  CLOSURE_SCOPED_PREDICATE(NS(LIB_PREFIX(Hash), HashMap, SUFFIX), Equals,      \
                           (KEY_TYPE left, KEY_TYPE right))                    \
  CLOSURE_SCOPED_PROCEDURE(NS(LIB_PREFIX(Hash), HashMap, SUFFIX), Visitor,     \
                           (KEY_TYPE key, VALUE_TYPE *value))                  \
  INTERNAL_DEF_EX(                                                             \
      Hash, NS(HashMap, SUFFIX),                                               \
      FUNCTION(size_t, DefaultHash, (KEY_TYPE key, void *context), {           \
        (void)context;                                                         \
        return MODULE_IFUNC(Hash, HashBytes)(&key, sizeof(KEY_TYPE));          \
      }),                                                                      \
                                                                               \
      PREDICATE(DefaultEquals, (KEY_TYPE left, KEY_TYPE right, void *context), \
                {                                                              \
                  (void)context;                                               \
                  return memcmp(&left, &right, sizeof(KEY_TYPE)) == 0;         \
                }),                                                            \
                                                                               \
      FUNCTION(size_t, NextOccupied,                                           \
               (const struct MODULE_ITYPED(Hash, HashMapBucket, SUFFIX)        \
                    *buckets,                                                  \
                size_t capacity, size_t startIndex),                           \
               {                                                               \
                 size_t i = startIndex;                                        \
                 while (i < capacity &&                                        \
                        buckets[i].state != Hash_BucketState_OCCUPIED) {       \
                   i++;                                                        \
                 }                                                             \
                 return i;                                                     \
               }),                                                             \
                                                                               \
      PREDICATE(FindSlot,                                                      \
                (const struct MODULE_ITYPED(Hash, HashMapBucket, SUFFIX)       \
                     *buckets,                                                 \
                 size_t capacity,                                              \
                 MODULE_CLOSURE(Hash, HashMap, SUFFIX, Hasher) hasher,         \
                 MODULE_CLOSURE(Hash, HashMap, SUFFIX, Equals) equals,         \
                 KEY_TYPE key, size_t *outIndex),                              \
                {                                                              \
                  if (!buckets || capacity == 0U)                              \
                    return false;                                              \
                  size_t start = CLOSURE_CALL(hasher, key) % capacity;         \
                  size_t firstDeleted = capacity;                              \
                  for (size_t probe = 0U; probe < capacity; probe++) {         \
                    size_t idx = (start + probe) % capacity;                   \
                    MODULE_ENUM(Hash, BucketState) st = buckets[idx].state;    \
                    if (st == Hash_BucketState_EMPTY) {                        \
                      if (outIndex) {                                          \
                        *outIndex =                                            \
                            (firstDeleted < capacity) ? firstDeleted : idx;    \
                      }                                                        \
                      return false;                                            \
                    }                                                          \
                    if (st == Hash_BucketState_DELETED) {                      \
                      if (firstDeleted == capacity)                            \
                        firstDeleted = idx;                                    \
                    } else if (CLOSURE_CALL(equals, buckets[idx].key, key)) {  \
                      if (outIndex)                                            \
                        *outIndex = idx;                                       \
                      return true;                                             \
                    }                                                          \
                  }                                                            \
                  if (outIndex)                                                \
                    *outIndex = firstDeleted;                                  \
                  return false;                                                \
                }))                                                            \
                                                                               \
  TEMPLATE_OBJECT(Hash, HashMapIter, SUFFIX,                                   \
      FIELDS(                                                                  \
          struct MODULE_ITYPED(Hash, HashMapBucket, SUFFIX) *buckets;          \
          size_t capacity;                                                     \
          size_t index;                                                        \
      ),                                                                       \
                                                                               \
      CLOSURE(PROCEDURE(Visitor, (KEY_TYPE key, VALUE_TYPE *value))),          \
                                                                               \
      OPERATION_INLINE(                                                        \
          FromBuckets,                                                         \
          (struct MODULE_ITYPED(Hash, HashMapBucket, SUFFIX) *buckets,         \
           size_t capacity, size_t index),                                     \
          {                                                                    \
            if (!self)                                                         \
              return STATUS_CONST(INVALID_ARGUMENT);                           \
            MODULE_FUNC(Hash, HashMapIter, SUFFIX, Init)(self);                \
            self->buckets = buckets;                                           \
            self->capacity = capacity;                                         \
            self->index = (buckets && index < capacity)                        \
                              ? MODULE_IFUNC(Hash, NS(HashMap, SUFFIX),        \
                                             NextOccupied)(buckets, capacity,  \
                                                           index)              \
                              : capacity;                                      \
            return STATUS_CONST(SUCCESS);                                      \
          }),                                                                  \
                                                                               \
      CONST_PREDICATE_INLINE(IsValid, (), {                                    \
        return self != NULL && self->buckets != NULL &&                        \
               self->index < self->capacity &&                                 \
               self->buckets[self->index].state == Hash_BucketState_OCCUPIED;  \
      }),                                                                      \
                                                                               \
      CONST_PREDICATE_INLINE(HasNext, (), {                                    \
        return MODULE_FUNC(Hash, HashMapIter, SUFFIX, IsValid)(self);          \
      }),                                                                      \
                                                                               \
      OPERATION_INLINE(Reset, (), {                                            \
        if (!self)                                                             \
          return STATUS_CONST(INVALID_ARGUMENT);                               \
        self->index = self->buckets                                            \
                          ? MODULE_IFUNC(Hash, NS(HashMap, SUFFIX),            \
                                         NextOccupied)(self->buckets,          \
                                                       self->capacity, 0U)     \
                          : 0U;                                                \
        return STATUS_CONST(SUCCESS);                                          \
      }),                                                                      \
                                                                               \
      OPERATION_INLINE(Get, (VALUE_TYPE **outValue), {                         \
        if (!self || !outValue)                                                \
          return STATUS_CONST(INVALID_ARGUMENT);                               \
        if (!MODULE_FUNC(Hash, HashMapIter, SUFFIX, IsValid)(self))            \
          return STATUS_CONST(OUT_OF_RANGE);                                   \
        *outValue = &self->buckets[self->index].value;                         \
        return STATUS_CONST(SUCCESS);                                          \
      }),                                                                      \
                                                                               \
      CONST_OPERATION_INLINE(ConstGet, (const VALUE_TYPE **outValue), {        \
        if (!self || !outValue)                                                \
          return STATUS_CONST(INVALID_ARGUMENT);                               \
        if (!MODULE_FUNC(Hash, HashMapIter, SUFFIX, IsValid)(self))            \
          return STATUS_CONST(OUT_OF_RANGE);                                   \
        *outValue = &self->buckets[self->index].value;                         \
        return STATUS_CONST(SUCCESS);                                          \
      }),                                                                      \
                                                                               \
      CONST_OPERATION_INLINE(Key, (const KEY_TYPE **outKey), {                 \
        if (!self || !outKey)                                                  \
          return STATUS_CONST(INVALID_ARGUMENT);                               \
        if (!MODULE_FUNC(Hash, HashMapIter, SUFFIX, IsValid)(self))            \
          return STATUS_CONST(OUT_OF_RANGE);                                   \
        *outKey = &self->buckets[self->index].key;                             \
        return STATUS_CONST(SUCCESS);                                          \
      }),                                                                      \
                                                                               \
      CONST_OPERATION_INLINE(Value, (VALUE_TYPE *outValue), {                  \
        if (!self || !outValue)                                                \
          return STATUS_CONST(INVALID_ARGUMENT);                               \
        if (!MODULE_FUNC(Hash, HashMapIter, SUFFIX, IsValid)(self))            \
          return STATUS_CONST(OUT_OF_RANGE);                                   \
        *outValue = self->buckets[self->index].value;                          \
        return STATUS_CONST(SUCCESS);                                          \
      }),                                                                      \
                                                                               \
      OPERATION_INLINE(StepNext, (), {                                         \
        if (!self)                                                             \
          return STATUS_CONST(INVALID_ARGUMENT);                               \
        if (!MODULE_FUNC(Hash, HashMapIter, SUFFIX, IsValid)(self))            \
          return STATUS_CONST(OUT_OF_RANGE);                                   \
        self->index = MODULE_IFUNC(Hash, NS(HashMap, SUFFIX), NextOccupied)(   \
            self->buckets, self->capacity, self->index + 1U);                  \
        return STATUS_CONST(SUCCESS);                                          \
      }),                                                                      \
                                                                               \
      OPERATION_INLINE(Next, (VALUE_TYPE **outValue), {                        \
        if (!self)                                                             \
          return STATUS_CONST(INVALID_ARGUMENT);                               \
        if (!MODULE_FUNC(Hash, HashMapIter, SUFFIX, IsValid)(self))            \
          return STATUS_CONST(OUT_OF_RANGE);                                   \
        if (outValue)                                                          \
          *outValue = &self->buckets[self->index].value;                       \
        self->index = MODULE_IFUNC(Hash, NS(HashMap, SUFFIX), NextOccupied)(   \
            self->buckets, self->capacity, self->index + 1U);                  \
        return STATUS_CONST(SUCCESS);                                          \
      }),                                                                      \
                                                                               \
      CONST_PREDICATE_INLINE(                                                  \
          Equals,                                                              \
          (const struct MODULE_TYPED(Hash, HashMapIter, SUFFIX) *other), {     \
            if (!self || !other)                                               \
              return false;                                                    \
            return self->buckets == other->buckets &&                          \
                   self->index == other->index;                                \
          }),                                                                  \
                                                                               \
      OPERATION_INLINE(                                                        \
          ForEach,                                                             \
          (MODULE_CLOSURE(Hash, HashMapIter, SUFFIX, Visitor) visitor), {      \
            if (!self || !CLOSURE_IS_VALID(visitor))                           \
              return STATUS_CONST(INVALID_ARGUMENT);                           \
            while (MODULE_FUNC(Hash, HashMapIter, SUFFIX, IsValid)(self)) {    \
              CLOSURE_CALL(visitor, self->buckets[self->index].key,            \
                           &self->buckets[self->index].value);                 \
              self->index =                                                    \
                  MODULE_IFUNC(Hash, NS(HashMap, SUFFIX), NextOccupied)(       \
                      self->buckets, self->capacity, self->index + 1U);        \
            }                                                                  \
            return STATUS_CONST(SUCCESS);                                      \
          })                                                                   \
  );                                                                           \
                                                                               \
  TEMPLATE_OBJECT(Hash, HashMap, SUFFIX,                                       \
      FIELDS(                                                                  \
          struct MODULE_ITYPED(Hash, HashMapBucket, SUFFIX) *buckets;          \
          size_t capacity;                                                     \
          size_t size;                                                         \
          size_t deleted;                                                      \
          MODULE_CLOSURE(Hash, HashMap, SUFFIX, Hasher) hasher;                \
          MODULE_CLOSURE(Hash, HashMap, SUFFIX, Equals) equals;                \
      ),                                                                       \
                                                                               \
      OPERATION_INLINE(                                                        \
          CreateWithHash,                                                      \
          (size_t (*hashFn)(KEY_TYPE key, void *context),                      \
           bool (*equalsFn)(KEY_TYPE left, KEY_TYPE right, void *context),     \
           void *context),                                                     \
          {                                                                    \
            if (!self)                                                         \
              return STATUS_CONST(INVALID_ARGUMENT);                           \
            MODULE_FUNC(Hash, HashMap, SUFFIX, Init)(self);                    \
            self->buckets = NULL;                                              \
            self->capacity = 0U;                                               \
            self->size = 0U;                                                   \
            self->deleted = 0U;                                                \
            self->hasher = NS_JOIN(                                            \
                MODULE_CLOSURE_FUNC(Hash, HashMap, SUFFIX, Hasher), Bind)(     \
                hashFn ? hashFn                                                \
                       : MODULE_IFUNC(Hash, NS(HashMap, SUFFIX), DefaultHash), \
                hashFn ? context : NULL);                                      \
            self->equals = NS_JOIN(                                            \
                MODULE_CLOSURE_FUNC(Hash, HashMap, SUFFIX, Equals), Bind)(     \
                equalsFn                                                       \
                    ? equalsFn                                                 \
                    : MODULE_IFUNC(Hash, NS(HashMap, SUFFIX), DefaultEquals),  \
                equalsFn ? context : NULL);                                    \
            return STATUS_CONST(SUCCESS);                                      \
          }),                                                                  \
                                                                               \
      OPERATION_INLINE(Create, (), {                                           \
        return MODULE_FUNC(Hash, HashMap, SUFFIX, CreateWithHash)(             \
            self, NULL, NULL, NULL);                                           \
      }),                                                                      \
                                                                               \
      PROCEDURE_INLINE(Clear, (), {                                            \
        if (!self)                                                             \
          return;                                                              \
        if (self->buckets) {                                                   \
          for (size_t i = 0U; i < self->capacity; i++)                         \
            self->buckets[i].state = Hash_BucketState_EMPTY;                   \
        }                                                                      \
        self->size = 0U;                                                       \
        self->deleted = 0U;                                                    \
      }),                                                                      \
                                                                               \
      OPERATION_INLINE(Dispose, (), {                                          \
        if (!self)                                                             \
          return STATUS_CONST(INVALID_ARGUMENT);                               \
        if (self->buckets) {                                                   \
          void *raw = (void *)self->buckets;                                   \
          MODULE_IFUNC(Hash, FreeBuckets)(&raw);                               \
          self->buckets = NULL;                                                \
        }                                                                      \
        self->capacity = 0U;                                                   \
        self->size = 0U;                                                       \
        self->deleted = 0U;                                                    \
        return STATUS_CONST(SUCCESS);                                          \
      }),                                                                      \
                                                                               \
      PROCEDURE_INLINE(Destroy, (), {                                          \
        (void)MODULE_FUNC(Hash, HashMap, SUFFIX, Dispose)(self);               \
      }),                                                                      \
                                                                               \
      OPERATION_INLINE(Rehash, (size_t newCapacity), {                         \
        if (!self)                                                             \
          return STATUS_CONST(INVALID_ARGUMENT);                               \
        size_t minCap = self->size + 1U;                                       \
        size_t targetCap = MODULE_IFUNC(Hash, NormalizeCapacity)(              \
            newCapacity > minCap ? newCapacity : minCap);                      \
        void *raw = NULL;                                                      \
        OPSTATUS status = MODULE_IFUNC(Hash, AllocBuckets)(                    \
            &raw, targetCap,                                                   \
            sizeof(struct MODULE_ITYPED(Hash, HashMapBucket, SUFFIX)));        \
        if (status != STATUS_CONST(SUCCESS))                                   \
          return status;                                                       \
        struct MODULE_ITYPED(Hash, HashMapBucket, SUFFIX) *newBuckets =        \
            (struct MODULE_ITYPED(Hash, HashMapBucket, SUFFIX) *)raw;          \
        for (size_t i = 0U; i < targetCap; i++)                                \
          newBuckets[i].state = Hash_BucketState_EMPTY;                        \
        if (self->buckets) {                                                   \
          for (size_t i = 0U; i < self->capacity; i++) {                       \
            if (self->buckets[i].state == Hash_BucketState_OCCUPIED) {         \
              size_t slot = 0U;                                                \
              (void)MODULE_IFUNC(Hash, NS(HashMap, SUFFIX), FindSlot)(         \
                  newBuckets, targetCap, self->hasher, self->equals,           \
                  self->buckets[i].key, &slot);                                \
              newBuckets[slot].key = self->buckets[i].key;                     \
              newBuckets[slot].value = self->buckets[i].value;                 \
              newBuckets[slot].state = Hash_BucketState_OCCUPIED;              \
            }                                                                  \
          }                                                                    \
          void *oldRaw = (void *)self->buckets;                                \
          MODULE_IFUNC(Hash, FreeBuckets)(&oldRaw);                            \
        }                                                                      \
        self->buckets = newBuckets;                                            \
        self->capacity = targetCap;                                            \
        self->deleted = 0U;                                                    \
        return STATUS_CONST(SUCCESS);                                          \
      }),                                                                      \
                                                                               \
      OPERATION_INLINE(Reserve, (size_t minElements), {                        \
        if (!self)                                                             \
          return STATUS_CONST(INVALID_ARGUMENT);                               \
        size_t needed =                                                        \
            (minElements * Hash_Config_PERCENT_BASE) /                         \
                Hash_Config_LOAD_PERCENT +                                     \
            1U;                                                                \
        if (needed <= self->capacity)                                          \
          return STATUS_CONST(SUCCESS);                                        \
        return MODULE_FUNC(Hash, HashMap, SUFFIX, Rehash)(self, needed);       \
      }),                                                                      \
                                                                               \
      OPERATION_INLINE(Insert, (KEY_TYPE key, VALUE_TYPE value), {             \
        if (!self)                                                             \
          return STATUS_CONST(INVALID_ARGUMENT);                               \
        if (self->capacity == 0U ||                                            \
            (self->size + self->deleted + 1U) * Hash_Config_PERCENT_BASE >=    \
                self->capacity * Hash_Config_LOAD_PERCENT) {                   \
          size_t nextCap =                                                     \
              (self->capacity == 0U)                                           \
                  ? Hash_Config_INITIAL_CAPACITY                               \
                  : ((self->size * Hash_Config_PERCENT_BASE >=                 \
                      self->capacity * (Hash_Config_LOAD_PERCENT / 2U))        \
                         ? self->capacity * Hash_Config_GROWTH_FACTOR          \
                         : self->capacity);                                    \
          OPSTATUS status =                                                    \
              MODULE_FUNC(Hash, HashMap, SUFFIX, Rehash)(self, nextCap);       \
          if (status != STATUS_CONST(SUCCESS))                                 \
            return status;                                                     \
        }                                                                      \
        size_t slot = 0U;                                                      \
        if (MODULE_IFUNC(Hash, NS(HashMap, SUFFIX), FindSlot)(                 \
                self->buckets, self->capacity, self->hasher, self->equals,     \
                key, &slot)) {                                                 \
          return STATUS_CONST(ALREADY_EXISTS);                                 \
        }                                                                      \
        if (self->buckets[slot].state == Hash_BucketState_DELETED)             \
          self->deleted--;                                                     \
        self->buckets[slot].key = key;                                         \
        self->buckets[slot].value = value;                                     \
        self->buckets[slot].state = Hash_BucketState_OCCUPIED;                 \
        self->size++;                                                          \
        return STATUS_CONST(SUCCESS);                                          \
      }),                                                                      \
                                                                               \
      OPERATION_INLINE(Upsert, (KEY_TYPE key, VALUE_TYPE value), {             \
        if (!self)                                                             \
          return STATUS_CONST(INVALID_ARGUMENT);                               \
        if (self->capacity == 0U ||                                            \
            (self->size + self->deleted + 1U) * Hash_Config_PERCENT_BASE >=    \
                self->capacity * Hash_Config_LOAD_PERCENT) {                   \
          size_t nextCap =                                                     \
              (self->capacity == 0U)                                           \
                  ? Hash_Config_INITIAL_CAPACITY                               \
                  : ((self->size * Hash_Config_PERCENT_BASE >=                 \
                      self->capacity * (Hash_Config_LOAD_PERCENT / 2U))        \
                         ? self->capacity * Hash_Config_GROWTH_FACTOR          \
                         : self->capacity);                                    \
          OPSTATUS status =                                                    \
              MODULE_FUNC(Hash, HashMap, SUFFIX, Rehash)(self, nextCap);       \
          if (status != STATUS_CONST(SUCCESS))                                 \
            return status;                                                     \
        }                                                                      \
        size_t slot = 0U;                                                      \
        if (MODULE_IFUNC(Hash, NS(HashMap, SUFFIX), FindSlot)(                 \
                self->buckets, self->capacity, self->hasher, self->equals,     \
                key, &slot)) {                                                 \
          self->buckets[slot].value = value;                                   \
          return STATUS_CONST(SUCCESS);                                        \
        }                                                                      \
        if (self->buckets[slot].state == Hash_BucketState_DELETED)             \
          self->deleted--;                                                     \
        self->buckets[slot].key = key;                                         \
        self->buckets[slot].value = value;                                     \
        self->buckets[slot].state = Hash_BucketState_OCCUPIED;                 \
        self->size++;                                                          \
        return STATUS_CONST(SUCCESS);                                          \
      }),                                                                      \
                                                                               \
      OPERATION_INLINE(Remove, (KEY_TYPE key), {                               \
        if (!self)                                                             \
          return STATUS_CONST(INVALID_ARGUMENT);                               \
        size_t slot = 0U;                                                      \
        if (!MODULE_IFUNC(Hash, NS(HashMap, SUFFIX), FindSlot)(                \
                self->buckets, self->capacity, self->hasher, self->equals,     \
                key, &slot)) {                                                 \
          return STATUS_CONST(NOT_FOUND);                                      \
        }                                                                      \
        self->buckets[slot].state = Hash_BucketState_DELETED;                  \
        self->size--;                                                          \
        self->deleted++;                                                       \
        return STATUS_CONST(SUCCESS);                                          \
      }),                                                                      \
                                                                               \
      OPERATION_INLINE(                                                        \
          EraseIter,                                                           \
          (struct MODULE_TYPED(Hash, HashMapIter, SUFFIX) *iter), {            \
            if (!self || !iter ||                                              \
                !MODULE_FUNC(Hash, HashMapIter, SUFFIX, IsValid)(iter) ||      \
                iter->buckets != self->buckets) {                              \
              return STATUS_CONST(INVALID_ARGUMENT);                           \
            }                                                                  \
            self->buckets[iter->index].state = Hash_BucketState_DELETED;       \
            self->size--;                                                      \
            self->deleted++;                                                   \
            iter->index =                                                      \
                MODULE_IFUNC(Hash, NS(HashMap, SUFFIX), NextOccupied)(         \
                    self->buckets, self->capacity, iter->index + 1U);          \
            return STATUS_CONST(SUCCESS);                                      \
          }),                                                                  \
                                                                               \
      OPERATION_INLINE(Find, (KEY_TYPE key, VALUE_TYPE **outValue), {          \
        if (!self || !outValue)                                                \
          return STATUS_CONST(INVALID_ARGUMENT);                               \
        size_t slot = 0U;                                                      \
        if (!MODULE_IFUNC(Hash, NS(HashMap, SUFFIX), FindSlot)(                \
                self->buckets, self->capacity, self->hasher, self->equals,     \
                key, &slot)) {                                                 \
          return STATUS_CONST(NOT_FOUND);                                      \
        }                                                                      \
        *outValue = &self->buckets[slot].value;                                \
        return STATUS_CONST(SUCCESS);                                          \
      }),                                                                      \
                                                                               \
      CONST_OPERATION_INLINE(                                                  \
          ConstFind, (KEY_TYPE key, const VALUE_TYPE **outValue), {            \
            if (!self || !outValue)                                            \
              return STATUS_CONST(INVALID_ARGUMENT);                           \
            size_t slot = 0U;                                                  \
            if (!MODULE_IFUNC(Hash, NS(HashMap, SUFFIX), FindSlot)(            \
                    self->buckets, self->capacity, self->hasher, self->equals, \
                    key, &slot)) {                                             \
              return STATUS_CONST(NOT_FOUND);                                  \
            }                                                                  \
            *outValue = &self->buckets[slot].value;                            \
            return STATUS_CONST(SUCCESS);                                      \
          }),                                                                  \
                                                                               \
      CONST_PREDICATE_INLINE(Contains, (KEY_TYPE key), {                       \
        if (!self)                                                             \
          return false;                                                        \
        return MODULE_IFUNC(Hash, NS(HashMap, SUFFIX), FindSlot)(              \
            self->buckets, self->capacity, self->hasher, self->equals, key,    \
            NULL);                                                             \
      }),                                                                      \
                                                                               \
      CONST_PREDICATE_INLINE(Empty, (), {                                      \
        return !self || self->size == 0U;                                      \
      }),                                                                      \
                                                                               \
      CONST_PREDICATE_INLINE(IsEmpty, (), {                                    \
        return !self || self->size == 0U;                                      \
      }),                                                                      \
                                                                               \
      CONST_FUNCTION_INLINE(size_t, Size, (), {                                \
        return self ? self->size : 0U;                                         \
      }),                                                                      \
                                                                               \
      CONST_FUNCTION_INLINE(size_t, Count, (), {                               \
        return self ? self->size : 0U;                                         \
      }),                                                                      \
                                                                               \
      CONST_FUNCTION_INLINE(size_t, Capacity, (), {                            \
        return self ? self->capacity : 0U;                                     \
      }),                                                                      \
                                                                               \
      /* --- Optional Iterator Protocol (Forward) --- */                       \
      OPERATION_INLINE(                                                        \
          Begin, (struct MODULE_TYPED(Hash, HashMapIter, SUFFIX) *outIter), {  \
            if (!self || !outIter)                                             \
              return STATUS_CONST(INVALID_ARGUMENT);                           \
            return MODULE_FUNC(Hash, HashMapIter, SUFFIX, FromBuckets)(        \
                outIter, self->buckets, self->capacity, 0U);                   \
          }),                                                                  \
                                                                               \
      OPERATION_INLINE(                                                        \
          End, (struct MODULE_TYPED(Hash, HashMapIter, SUFFIX) *outIter), {    \
            if (!self || !outIter)                                             \
              return STATUS_CONST(INVALID_ARGUMENT);                           \
            return MODULE_FUNC(Hash, HashMapIter, SUFFIX, FromBuckets)(        \
                outIter, self->buckets, self->capacity, self->capacity);       \
          }),                                                                  \
                                                                               \
      OPERATION_INLINE(                                                        \
          FindIter,                                                            \
          (KEY_TYPE key,                                                       \
           struct MODULE_TYPED(Hash, HashMapIter, SUFFIX) *outIter),           \
          {                                                                    \
            if (!self || !outIter)                                             \
              return STATUS_CONST(INVALID_ARGUMENT);                           \
            size_t slot = 0U;                                                  \
            if (!MODULE_IFUNC(Hash, NS(HashMap, SUFFIX), FindSlot)(            \
                    self->buckets, self->capacity, self->hasher, self->equals, \
                    key, &slot)) {                                             \
              MODULE_FUNC(Hash, HashMapIter, SUFFIX, FromBuckets)(             \
                  outIter, self->buckets, self->capacity, self->capacity);     \
              return STATUS_CONST(NOT_FOUND);                                  \
            }                                                                  \
            MODULE_FUNC(Hash, HashMapIter, SUFFIX, FromBuckets)(               \
                outIter, self->buckets, self->capacity, slot);                 \
            return STATUS_CONST(SUCCESS);                                      \
          }),                                                                  \
                                                                               \
      OPERATION_INLINE(                                                        \
          ForEach,                                                             \
          (MODULE_CLOSURE(Hash, HashMap, SUFFIX, Visitor) visitor), {          \
            if (!self || !CLOSURE_IS_VALID(visitor))                           \
              return STATUS_CONST(INVALID_ARGUMENT);                           \
            for (size_t i = 0U; i < self->capacity; i++) {                     \
              if (self->buckets[i].state == Hash_BucketState_OCCUPIED) {       \
                CLOSURE_CALL(visitor, self->buckets[i].key,                    \
                             &self->buckets[i].value);                         \
              }                                                                \
            }                                                                  \
            return STATUS_CONST(SUCCESS);                                      \
          })                                                                   \
  )
#endif

/* Mode 2 (Direct Include): Auto-instantiates and cleans up environment */
#if defined(SUFFIX) && defined(KEY_TYPE) && defined(VALUE_TYPE)
  TEMPLATE_Hash_HashMap(SUFFIX, KEY_TYPE, VALUE_TYPE);
  #undef SUFFIX
  #undef KEY_TYPE
  #undef VALUE_TYPE
#endif
