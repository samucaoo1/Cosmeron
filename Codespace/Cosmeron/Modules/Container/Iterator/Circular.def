/* Circular.def - Dual Mode Engine (Zero Duplication) */

#ifndef TEMPLATE_Iterator_Circular
#define TEMPLATE_Iterator_Circular(SUFFIX, TYPE)                               \
  TEMPLATE_OBJECT(Iterator, Circular, SUFFIX,                                  \
      FIELDS(                                                                  \
          TYPE *base;                                                          \
          size_t capacity;                                                     \
          size_t head;                                                         \
          size_t count;                                                        \
          size_t step;                                                         \
          bool reverse;                                                        \
      ),                                                                       \
                                                                               \
      CLOSURE(                                                                 \
          PROCEDURE(Visitor, (TYPE *element)),                                 \
          PREDICATE(Predicate, (const TYPE *element))),                        \
                                                                               \
      OPERATION_INLINE(FromRing,                                               \
                       (TYPE *base, size_t capacity, size_t head,              \
                        size_t count, size_t startStep, bool reverse),         \
                       {                                                       \
                         if (!self || (count > 0U && (!base || capacity == 0U))\
                             || startStep > count || count > capacity)         \
                           return STATUS_CONST(INVALID_ARGUMENT);              \
                         MODULE_FUNC(Iterator, Circular, SUFFIX, Init)(self);  \
                         self->base = base;                                    \
                         self->capacity = capacity;                            \
                         self->head = (capacity > 0U) ? (head % capacity) : 0U;\
                         self->count = count;                                  \
                         self->step = startStep;                               \
                         self->reverse = reverse;                              \
                         return STATUS_CONST(SUCCESS);                         \
                       }),                                                     \
                                                                               \
      CONST_PREDICATE_INLINE(IsValid, (), {                                    \
        return self != NULL && (self->base != NULL || self->count == 0U) &&    \
               self->step < self->count;                                       \
      }),                                                                      \
                                                                               \
      CONST_PREDICATE_INLINE(HasNext, (), {                                    \
        return MODULE_FUNC(Iterator, Circular, SUFFIX, IsValid)(self);         \
      }),                                                                      \
                                                                               \
      CONST_PREDICATE_INLINE(HasPrev, (), {                                    \
        if (!self || (!self->base && self->count > 0U))                        \
          return false;                                                        \
        return self->step > 0U && self->step <= self->count;                   \
      }),                                                                      \
                                                                               \
      CONST_FUNCTION_INLINE(size_t, Index, (), {                               \
        if (!self || self->step >= self->count)                                \
          return self ? self->count : 0U;                                      \
        return self->reverse ? (self->count - 1U - self->step) : self->step;   \
      }),                                                                      \
                                                                               \
      CONST_FUNCTION_INLINE(size_t, Remaining, (), {                           \
        if (!self || self->step >= self->count)                                \
          return 0U;                                                           \
        return self->count - self->step;                                       \
      }),                                                                      \
                                                                               \
      OPERATION_INLINE(Reset, (), {                                            \
        if (!self)                                                             \
          return STATUS_CONST(INVALID_ARGUMENT);                               \
        self->step = 0U;                                                       \
        return STATUS_CONST(SUCCESS);                                          \
      }),                                                                      \
                                                                               \
      OPERATION_INLINE(Seek, (size_t stepIndex), {                             \
        if (!self)                                                             \
          return STATUS_CONST(INVALID_ARGUMENT);                               \
        if (stepIndex > self->count)                                           \
          return STATUS_CONST(OUT_OF_RANGE);                                   \
        self->step = stepIndex;                                                \
        return STATUS_CONST(SUCCESS);                                          \
      }),                                                                      \
                                                                               \
      OPERATION_INLINE(Get, (TYPE **outPtr), {                                 \
        if (!self || !outPtr)                                                  \
          return STATUS_CONST(INVALID_ARGUMENT);                               \
        if (!self->base || self->capacity == 0U || self->step >= self->count)  \
          return STATUS_CONST(OUT_OF_RANGE);                                   \
        size_t logical =                                                       \
            self->reverse ? (self->count - 1U - self->step) : self->step;      \
        size_t physical = (self->head + logical) % self->capacity;             \
        *outPtr = &self->base[physical];                                       \
        return STATUS_CONST(SUCCESS);                                          \
      }),                                                                      \
                                                                               \
      CONST_OPERATION_INLINE(ConstGet, (const TYPE **outPtr), {                \
        if (!self || !outPtr)                                                  \
          return STATUS_CONST(INVALID_ARGUMENT);                               \
        if (!self->base || self->capacity == 0U || self->step >= self->count)  \
          return STATUS_CONST(OUT_OF_RANGE);                                   \
        size_t logical =                                                       \
            self->reverse ? (self->count - 1U - self->step) : self->step;      \
        size_t physical = (self->head + logical) % self->capacity;             \
        *outPtr = &self->base[physical];                                       \
        return STATUS_CONST(SUCCESS);                                          \
      }),                                                                      \
                                                                               \
      CONST_OPERATION_INLINE(Value, (TYPE *outValue), {                        \
        if (!self || !outValue)                                                \
          return STATUS_CONST(INVALID_ARGUMENT);                               \
        if (!self->base || self->capacity == 0U || self->step >= self->count)  \
          return STATUS_CONST(OUT_OF_RANGE);                                   \
        size_t logical =                                                       \
            self->reverse ? (self->count - 1U - self->step) : self->step;      \
        size_t physical = (self->head + logical) % self->capacity;             \
        *outValue = self->base[physical];                                      \
        return STATUS_CONST(SUCCESS);                                          \
      }),                                                                      \
                                                                               \
      OPERATION_INLINE(Set, (TYPE value), {                                    \
        if (!self)                                                             \
          return STATUS_CONST(INVALID_ARGUMENT);                               \
        if (!self->base || self->capacity == 0U || self->step >= self->count)  \
          return STATUS_CONST(OUT_OF_RANGE);                                   \
        size_t logical =                                                       \
            self->reverse ? (self->count - 1U - self->step) : self->step;      \
        size_t physical = (self->head + logical) % self->capacity;             \
        self->base[physical] = value;                                          \
        return STATUS_CONST(SUCCESS);                                          \
      }),                                                                      \
                                                                               \
      OPERATION_INLINE(Next, (), {                                             \
        if (!self)                                                             \
          return STATUS_CONST(INVALID_ARGUMENT);                               \
        if (self->step >= self->count)                                         \
          return STATUS_CONST(OUT_OF_RANGE);                                   \
        self->step++;                                                          \
        return STATUS_CONST(SUCCESS);                                          \
      }),                                                                      \
                                                                               \
      OPERATION_INLINE(Prev, (), {                                             \
        if (!self)                                                             \
          return STATUS_CONST(INVALID_ARGUMENT);                               \
        if (self->step == 0U)                                                  \
          return STATUS_CONST(OUT_OF_RANGE);                                   \
        self->step--;                                                          \
        return STATUS_CONST(SUCCESS);                                          \
      }),                                                                      \
                                                                               \
      OPERATION_INLINE(Advance, (ptrdiff_t offset), {                          \
        if (!self)                                                             \
          return STATUS_CONST(INVALID_ARGUMENT);                               \
        if (offset >= 0) {                                                     \
          size_t delta = (size_t)offset;                                       \
          if (delta > self->count - self->step)                                \
            return STATUS_CONST(OUT_OF_RANGE);                                 \
          self->step += delta;                                                 \
        } else {                                                               \
          size_t delta = (size_t)(-(offset + 1)) + 1U;                         \
          if (delta > self->step)                                              \
            return STATUS_CONST(OUT_OF_RANGE);                                 \
          self->step -= delta;                                                 \
        }                                                                      \
        return STATUS_CONST(SUCCESS);                                          \
      }),                                                                      \
                                                                               \
      OPERATION_INLINE(StepValue, (TYPE *outValue), {                          \
        if (!self || !outValue)                                                \
          return STATUS_CONST(INVALID_ARGUMENT);                               \
        if (!self->base || self->capacity == 0U || self->step >= self->count)  \
          return STATUS_CONST(OUT_OF_RANGE);                                   \
        size_t logical =                                                       \
            self->reverse ? (self->count - 1U - self->step) : self->step;      \
        size_t physical = (self->head + logical) % self->capacity;             \
        *outValue = self->base[physical];                                      \
        self->step++;                                                          \
        return STATUS_CONST(SUCCESS);                                          \
      }),                                                                      \
                                                                               \
      OPERATION_INLINE(StepPtr, (TYPE **outPtr), {                             \
        if (!self || !outPtr)                                                  \
          return STATUS_CONST(INVALID_ARGUMENT);                               \
        if (!self->base || self->capacity == 0U || self->step >= self->count)  \
          return STATUS_CONST(OUT_OF_RANGE);                                   \
        size_t logical =                                                       \
            self->reverse ? (self->count - 1U - self->step) : self->step;      \
        size_t physical = (self->head + logical) % self->capacity;             \
        *outPtr = &self->base[physical];                                       \
        self->step++;                                                          \
        return STATUS_CONST(SUCCESS);                                          \
      }),                                                                      \
                                                                               \
      CONST_OPERATION_INLINE(                                                  \
          Distance,                                                            \
          (const struct MODULE_TYPED(Iterator, Circular, SUFFIX) *other,       \
           ptrdiff_t *outDistance),                                            \
          {                                                                    \
            if (!self || !other || !outDistance)                               \
              return STATUS_CONST(INVALID_ARGUMENT);                           \
            if (self->base != other->base || self->capacity != other->capacity \
                || self->head != other->head || self->count != other->count || \
                self->reverse != other->reverse)                               \
              return STATUS_CONST(INVALID_ARGUMENT);                           \
            *outDistance = (ptrdiff_t)other->step - (ptrdiff_t)self->step;     \
            return STATUS_CONST(SUCCESS);                                      \
          }),                                                                  \
                                                                               \
      CONST_PREDICATE_INLINE(                                                  \
          Equal,                                                               \
          (const struct MODULE_TYPED(Iterator, Circular, SUFFIX) *other), {    \
            if (!self || !other)                                               \
              return self == other;                                            \
            return self->base == other->base &&                                \
                   self->capacity == other->capacity &&                        \
                   self->head == other->head && self->count == other->count && \
                   self->step == other->step &&                                \
                   self->reverse == other->reverse;                            \
          }),                                                                  \
                                                                               \
      OPERATION_INLINE(                                                        \
          ForEach,                                                             \
          (MODULE_CLOSURE(Iterator, Circular, SUFFIX, Visitor) visitor), {     \
            if (!self || !CLOSURE_IS_VALID(visitor))                           \
              return STATUS_CONST(INVALID_ARGUMENT);                           \
            while (self->step < self->count) {                                 \
              size_t logical = self->reverse                                   \
                                   ? (self->count - 1U - self->step)           \
                                   : self->step;                               \
              size_t physical = (self->head + logical) % self->capacity;       \
              CLOSURE_CALL(visitor, &self->base[physical]);                    \
              self->step++;                                                    \
            }                                                                  \
            return STATUS_CONST(SUCCESS);                                      \
          }),                                                                  \
                                                                               \
      OPERATION_INLINE(                                                        \
          ToStream,                                                            \
          (struct MODULE_TYPED(Iterator, Stream, SUFFIX) *outStream), {        \
            if (!self || !outStream)                                           \
              return STATUS_CONST(INVALID_ARGUMENT);                           \
            return MODULE_FUNC(Iterator, Stream, SUFFIX, Bind)(                \
                outStream, (void *)self,                                       \
                (OPSTATUS (*)(void *, TYPE *))MODULE_FUNC(                     \
                    Iterator, Circular, SUFFIX, StepValue),                    \
                (bool (*)(const void *))MODULE_FUNC(                           \
                    Iterator, Circular, SUFFIX, HasNext),                      \
                (OPSTATUS (*)(void *))MODULE_FUNC(                             \
                    Iterator, Circular, SUFFIX, Reset));                       \
          })                                                                   \
  )
#define TEMPLATE_Circular(SUFFIX, TYPE) TEMPLATE_Iterator_Circular(SUFFIX, TYPE)
#endif

/* Mode 2 (Direct Include): Auto-instantiates and cleans up environment */
#if defined(SUFFIX) && defined(TYPE)
  TEMPLATE_Iterator_Circular(SUFFIX, TYPE);
  #undef SUFFIX
  #undef TYPE
#endif
