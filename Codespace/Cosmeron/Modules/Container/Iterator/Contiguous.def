/* Contiguous.def - Dual Mode Engine (Zero Duplication) */

#ifndef TEMPLATE_Iterator_Contiguous
#define TEMPLATE_Iterator_Contiguous(SUFFIX, TYPE)                             \
  TEMPLATE_OBJECT(Iterator, Contiguous, SUFFIX,                                \
      FIELDS(                                                                  \
          TYPE *base;                                                          \
          size_t count;                                                        \
          size_t index;                                                        \
          bool reverse;                                                        \
      ),                                                                       \
                                                                               \
      CLOSURE(                                                                 \
          PROCEDURE(Visitor, (TYPE *element)),                                 \
          PROCEDURE(ConstVisitor, (const TYPE *element)),                      \
          PROCEDURE(IndexedVisitor, (size_t index, TYPE *element)),            \
          PREDICATE(Predicate, (const TYPE *element))),                        \
                                                                               \
      OPERATION_INLINE(FromBuffer,                                             \
                       (TYPE *base, size_t count, size_t startIndex,           \
                        bool reverse),                                         \
                       {                                                       \
                         if (!self || (count > 0U && !base) ||                 \
                             startIndex > count)                               \
                           return STATUS_CONST(INVALID_ARGUMENT);              \
                         MODULE_FUNC(Iterator, Contiguous, SUFFIX, Init)(self);\
                         self->base = base;                                    \
                         self->count = count;                                  \
                         self->index = startIndex;                             \
                         self->reverse = reverse;                              \
                         return STATUS_CONST(SUCCESS);                         \
                       }),                                                     \
                                                                               \
      CONST_PREDICATE_INLINE(IsValid, (), {                                    \
        return self != NULL && (self->base != NULL || self->count == 0U) &&    \
               self->index < self->count;                                      \
      }),                                                                      \
                                                                               \
      CONST_PREDICATE_INLINE(HasNext, (), {                                    \
        return MODULE_FUNC(Iterator, Contiguous, SUFFIX, IsValid)(self);       \
      }),                                                                      \
                                                                               \
      CONST_PREDICATE_INLINE(HasPrev, (), {                                    \
        if (!self || (!self->base && self->count > 0U))                        \
          return false;                                                        \
        return self->index > 0U && self->index <= self->count;                 \
      }),                                                                      \
                                                                               \
      CONST_FUNCTION_INLINE(size_t, Index, (), {                               \
        if (!self || self->index >= self->count)                               \
          return self ? self->count : 0U;                                      \
        return self->reverse ? (self->count - 1U - self->index) : self->index; \
      }),                                                                      \
                                                                               \
      CONST_FUNCTION_INLINE(size_t, Remaining, (), {                           \
        if (!self || self->index >= self->count)                               \
          return 0U;                                                           \
        return self->count - self->index;                                      \
      }),                                                                      \
                                                                               \
      OPERATION_INLINE(Reset, (), {                                            \
        if (!self)                                                             \
          return STATUS_CONST(INVALID_ARGUMENT);                               \
        self->index = 0U;                                                      \
        return STATUS_CONST(SUCCESS);                                          \
      }),                                                                      \
                                                                               \
      OPERATION_INLINE(Seek, (size_t stepIndex), {                             \
        if (!self)                                                             \
          return STATUS_CONST(INVALID_ARGUMENT);                               \
        if (stepIndex > self->count)                                           \
          return STATUS_CONST(OUT_OF_RANGE);                                   \
        self->index = stepIndex;                                               \
        return STATUS_CONST(SUCCESS);                                          \
      }),                                                                      \
                                                                               \
      OPERATION_INLINE(Get, (TYPE **outPtr), {                                 \
        if (!self || !outPtr)                                                  \
          return STATUS_CONST(INVALID_ARGUMENT);                               \
        if (!self->base || self->index >= self->count)                         \
          return STATUS_CONST(OUT_OF_RANGE);                                   \
        size_t pos =                                                           \
            self->reverse ? (self->count - 1U - self->index) : self->index;    \
        *outPtr = &self->base[pos];                                            \
        return STATUS_CONST(SUCCESS);                                          \
      }),                                                                      \
                                                                               \
      CONST_OPERATION_INLINE(ConstGet, (const TYPE **outPtr), {                \
        if (!self || !outPtr)                                                  \
          return STATUS_CONST(INVALID_ARGUMENT);                               \
        if (!self->base || self->index >= self->count)                         \
          return STATUS_CONST(OUT_OF_RANGE);                                   \
        size_t pos =                                                           \
            self->reverse ? (self->count - 1U - self->index) : self->index;    \
        *outPtr = &self->base[pos];                                            \
        return STATUS_CONST(SUCCESS);                                          \
      }),                                                                      \
                                                                               \
      CONST_OPERATION_INLINE(Value, (TYPE *outValue), {                        \
        if (!self || !outValue)                                                \
          return STATUS_CONST(INVALID_ARGUMENT);                               \
        if (!self->base || self->index >= self->count)                         \
          return STATUS_CONST(OUT_OF_RANGE);                                   \
        size_t pos =                                                           \
            self->reverse ? (self->count - 1U - self->index) : self->index;    \
        *outValue = self->base[pos];                                           \
        return STATUS_CONST(SUCCESS);                                          \
      }),                                                                      \
                                                                               \
      OPERATION_INLINE(Set, (TYPE value), {                                    \
        if (!self)                                                             \
          return STATUS_CONST(INVALID_ARGUMENT);                               \
        if (!self->base || self->index >= self->count)                         \
          return STATUS_CONST(OUT_OF_RANGE);                                   \
        size_t pos =                                                           \
            self->reverse ? (self->count - 1U - self->index) : self->index;    \
        self->base[pos] = value;                                               \
        return STATUS_CONST(SUCCESS);                                          \
      }),                                                                      \
                                                                               \
      OPERATION_INLINE(Next, (), {                                             \
        if (!self)                                                             \
          return STATUS_CONST(INVALID_ARGUMENT);                               \
        if (self->index >= self->count)                                        \
          return STATUS_CONST(OUT_OF_RANGE);                                   \
        self->index++;                                                         \
        return STATUS_CONST(SUCCESS);                                          \
      }),                                                                      \
                                                                               \
      OPERATION_INLINE(Prev, (), {                                             \
        if (!self)                                                             \
          return STATUS_CONST(INVALID_ARGUMENT);                               \
        if (self->index == 0U)                                                 \
          return STATUS_CONST(OUT_OF_RANGE);                                   \
        self->index--;                                                         \
        return STATUS_CONST(SUCCESS);                                          \
      }),                                                                      \
                                                                               \
      OPERATION_INLINE(Advance, (ptrdiff_t offset), {                          \
        if (!self)                                                             \
          return STATUS_CONST(INVALID_ARGUMENT);                               \
        if (offset >= 0) {                                                     \
          size_t step = (size_t)offset;                                        \
          if (step > self->count - self->index)                                \
            return STATUS_CONST(OUT_OF_RANGE);                                 \
          self->index += step;                                                 \
        } else {                                                               \
          size_t step = (size_t)(-(offset + 1)) + 1U;                          \
          if (step > self->index)                                              \
            return STATUS_CONST(OUT_OF_RANGE);                                 \
          self->index -= step;                                                 \
        }                                                                      \
        return STATUS_CONST(SUCCESS);                                          \
      }),                                                                      \
                                                                               \
      OPERATION_INLINE(StepValue, (TYPE *outValue), {                          \
        if (!self || !outValue)                                                \
          return STATUS_CONST(INVALID_ARGUMENT);                               \
        if (!self->base || self->index >= self->count)                         \
          return STATUS_CONST(OUT_OF_RANGE);                                   \
        size_t pos =                                                           \
            self->reverse ? (self->count - 1U - self->index) : self->index;    \
        *outValue = self->base[pos];                                           \
        self->index++;                                                         \
        return STATUS_CONST(SUCCESS);                                          \
      }),                                                                      \
                                                                               \
      OPERATION_INLINE(StepPtr, (TYPE **outPtr), {                             \
        if (!self || !outPtr)                                                  \
          return STATUS_CONST(INVALID_ARGUMENT);                               \
        if (!self->base || self->index >= self->count)                         \
          return STATUS_CONST(OUT_OF_RANGE);                                   \
        size_t pos =                                                           \
            self->reverse ? (self->count - 1U - self->index) : self->index;    \
        *outPtr = &self->base[pos];                                            \
        self->index++;                                                         \
        return STATUS_CONST(SUCCESS);                                          \
      }),                                                                      \
                                                                               \
      CONST_OPERATION_INLINE(                                                  \
          Distance,                                                            \
          (const struct MODULE_TYPED(Iterator, Contiguous, SUFFIX) *other,     \
           ptrdiff_t *outDistance),                                            \
          {                                                                    \
            if (!self || !other || !outDistance)                               \
              return STATUS_CONST(INVALID_ARGUMENT);                           \
            if (self->base != other->base || self->count != other->count ||    \
                self->reverse != other->reverse)                               \
              return STATUS_CONST(INVALID_ARGUMENT);                           \
            *outDistance = (ptrdiff_t)other->index - (ptrdiff_t)self->index;   \
            return STATUS_CONST(SUCCESS);                                      \
          }),                                                                  \
                                                                               \
      CONST_PREDICATE_INLINE(                                                  \
          Equal,                                                               \
          (const struct MODULE_TYPED(Iterator, Contiguous, SUFFIX) *other), {  \
            if (!self || !other)                                               \
              return self == other;                                            \
            return self->base == other->base && self->count == other->count && \
                   self->index == other->index &&                              \
                   self->reverse == other->reverse;                            \
          }),                                                                  \
                                                                               \
      OPERATION_INLINE(                                                        \
          ForEach,                                                             \
          (MODULE_CLOSURE(Iterator, Contiguous, SUFFIX, Visitor) visitor), {   \
            if (!self || !CLOSURE_IS_VALID(visitor))                           \
              return STATUS_CONST(INVALID_ARGUMENT);                           \
            while (self->index < self->count) {                                \
              size_t pos = self->reverse ? (self->count - 1U - self->index)    \
                                         : self->index;                        \
              CLOSURE_CALL(visitor, &self->base[pos]);                         \
              self->index++;                                                   \
            }                                                                  \
            return STATUS_CONST(SUCCESS);                                      \
          }),                                                                  \
                                                                               \
      OPERATION_INLINE(                                                        \
          ToStream,                                                            \
          (struct MODULE_TYPED(Iterator, Stream, SUFFIX) *outStream), {        \
            if (!self || !outStream)                                           \
              return STATUS_CONST(INVALID_ARGUMENT);                           \
            return MODULE_FUNC(Iterator, Stream, SUFFIX, Bind)(                \
                outStream, (void *)self,                                       \
                (OPSTATUS (*)(void *, TYPE *))MODULE_FUNC(                     \
                    Iterator, Contiguous, SUFFIX, StepValue),                  \
                (bool (*)(const void *))MODULE_FUNC(                           \
                    Iterator, Contiguous, SUFFIX, HasNext),                    \
                (OPSTATUS (*)(void *))MODULE_FUNC(                             \
                    Iterator, Contiguous, SUFFIX, Reset));                     \
          })                                                                   \
  )
#define TEMPLATE_Contiguous(SUFFIX, TYPE)                                      \
  TEMPLATE_Iterator_Contiguous(SUFFIX, TYPE)
#endif

/* Mode 2 (Direct Include): Auto-instantiates and cleans up environment */
#if defined(SUFFIX) && defined(TYPE)
  TEMPLATE_Iterator_Contiguous(SUFFIX, TYPE);
  #undef SUFFIX
  #undef TYPE
#endif
