/* Forward.def - Dual Mode Engine (Zero Duplication) */

#ifndef TEMPLATE_Iterator_Forward
#define TEMPLATE_Iterator_Forward(SUFFIX, TYPE)                                \
  TEMPLATE_OBJECT(Iterator, Forward, SUFFIX,                                   \
      FIELDS(                                                                  \
          struct MODULE_TYPED(Linked, SingleNode, SUFFIX) *start;              \
          struct MODULE_TYPED(Linked, SingleNode, SUFFIX) *current;            \
          size_t count;                                                        \
          size_t remaining;                                                    \
      ),                                                                       \
                                                                               \
      CLOSURE(                                                                 \
          PROCEDURE(Visitor, (TYPE *element)),                                 \
          PROCEDURE(ConstVisitor, (const TYPE *element)),                      \
          PREDICATE(Predicate, (const TYPE *element))),                        \
                                                                               \
      OPERATION_INLINE(                                                        \
          FromNodes,                                                           \
          (struct MODULE_TYPED(Linked, SingleNode, SUFFIX) *head,              \
           size_t maxCount),                                                   \
          {                                                                    \
            if (!self)                                                         \
              return STATUS_CONST(INVALID_ARGUMENT);                           \
            MODULE_FUNC(Iterator, Forward, SUFFIX, Init)(self);                \
            self->start = head;                                                \
            self->current = head;                                              \
            self->count = maxCount;                                            \
            self->remaining = maxCount;                                        \
            return STATUS_CONST(SUCCESS);                                      \
          }),                                                                  \
                                                                               \
      CONST_PREDICATE_INLINE(IsValid, (), {                                    \
        return self != NULL && self->current != NULL && self->remaining > 0U;  \
      }),                                                                      \
                                                                               \
      CONST_PREDICATE_INLINE(HasNext, (), {                                    \
        return MODULE_FUNC(Iterator, Forward, SUFFIX, IsValid)(self);          \
      }),                                                                      \
                                                                               \
      CONST_FUNCTION_INLINE(size_t, Remaining, (), {                           \
        if (!self || !self->current)                                           \
          return 0U;                                                           \
        return self->remaining;                                                \
      }),                                                                      \
                                                                               \
      OPERATION_INLINE(Reset, (), {                                            \
        if (!self)                                                             \
          return STATUS_CONST(INVALID_ARGUMENT);                               \
        self->current = self->start;                                           \
        self->remaining = self->count;                                         \
        return STATUS_CONST(SUCCESS);                                          \
      }),                                                                      \
                                                                               \
      OPERATION_INLINE(Get, (TYPE **outPtr), {                                 \
        if (!self || !outPtr)                                                  \
          return STATUS_CONST(INVALID_ARGUMENT);                               \
        if (!self->current || self->remaining == 0U)                           \
          return STATUS_CONST(OUT_OF_RANGE);                                   \
        *outPtr = &self->current->value;                                       \
        return STATUS_CONST(SUCCESS);                                          \
      }),                                                                      \
                                                                               \
      CONST_OPERATION_INLINE(ConstGet, (const TYPE **outPtr), {                \
        if (!self || !outPtr)                                                  \
          return STATUS_CONST(INVALID_ARGUMENT);                               \
        if (!self->current || self->remaining == 0U)                           \
          return STATUS_CONST(OUT_OF_RANGE);                                   \
        *outPtr = &self->current->value;                                       \
        return STATUS_CONST(SUCCESS);                                          \
      }),                                                                      \
                                                                               \
      CONST_OPERATION_INLINE(Value, (TYPE *outValue), {                        \
        if (!self || !outValue)                                                \
          return STATUS_CONST(INVALID_ARGUMENT);                               \
        if (!self->current || self->remaining == 0U)                           \
          return STATUS_CONST(OUT_OF_RANGE);                                   \
        *outValue = self->current->value;                                      \
        return STATUS_CONST(SUCCESS);                                          \
      }),                                                                      \
                                                                               \
      OPERATION_INLINE(Set, (TYPE value), {                                    \
        if (!self)                                                             \
          return STATUS_CONST(INVALID_ARGUMENT);                               \
        if (!self->current || self->remaining == 0U)                           \
          return STATUS_CONST(OUT_OF_RANGE);                                   \
        self->current->value = value;                                          \
        return STATUS_CONST(SUCCESS);                                          \
      }),                                                                      \
                                                                               \
      OPERATION_INLINE(Next, (), {                                             \
        if (!self)                                                             \
          return STATUS_CONST(INVALID_ARGUMENT);                               \
        if (!self->current || self->remaining == 0U)                           \
          return STATUS_CONST(OUT_OF_RANGE);                                   \
        self->current = self->current->next;                                   \
        if (self->remaining != SIZE_MAX)                                       \
          self->remaining--;                                                   \
        if (self->remaining == 0U)                                             \
          self->current = NULL;                                                \
        return STATUS_CONST(SUCCESS);                                          \
      }),                                                                      \
                                                                               \
      OPERATION_INLINE(StepValue, (TYPE *outValue), {                          \
        if (!self || !outValue)                                                \
          return STATUS_CONST(INVALID_ARGUMENT);                               \
        if (!self->current || self->remaining == 0U)                           \
          return STATUS_CONST(OUT_OF_RANGE);                                   \
        *outValue = self->current->value;                                      \
        self->current = self->current->next;                                   \
        if (self->remaining != SIZE_MAX)                                       \
          self->remaining--;                                                   \
        if (self->remaining == 0U)                                             \
          self->current = NULL;                                                \
        return STATUS_CONST(SUCCESS);                                          \
      }),                                                                      \
                                                                               \
      OPERATION_INLINE(StepPtr, (TYPE **outPtr), {                             \
        if (!self || !outPtr)                                                  \
          return STATUS_CONST(INVALID_ARGUMENT);                               \
        if (!self->current || self->remaining == 0U)                           \
          return STATUS_CONST(OUT_OF_RANGE);                                   \
        *outPtr = &self->current->value;                                       \
        self->current = self->current->next;                                   \
        if (self->remaining != SIZE_MAX)                                       \
          self->remaining--;                                                   \
        if (self->remaining == 0U)                                             \
          self->current = NULL;                                                \
        return STATUS_CONST(SUCCESS);                                          \
      }),                                                                      \
                                                                               \
      CONST_PREDICATE_INLINE(                                                  \
          Equal,                                                               \
          (const struct MODULE_TYPED(Iterator, Forward, SUFFIX) *other), {     \
            if (!self || !other)                                               \
              return self == other;                                            \
            return self->current == other->current;                            \
          }),                                                                  \
                                                                               \
      OPERATION_INLINE(                                                        \
          ForEach,                                                             \
          (MODULE_CLOSURE(Iterator, Forward, SUFFIX, Visitor) visitor), {      \
            if (!self || !CLOSURE_IS_VALID(visitor))                           \
              return STATUS_CONST(INVALID_ARGUMENT);                           \
            while (self->current != NULL && self->remaining > 0U) {            \
              CLOSURE_CALL(visitor, &self->current->value);                    \
              self->current = self->current->next;                             \
              if (self->remaining != SIZE_MAX)                                 \
                self->remaining--;                                             \
              if (self->remaining == 0U)                                       \
                self->current = NULL;                                          \
            }                                                                  \
            return STATUS_CONST(SUCCESS);                                      \
          }),                                                                  \
                                                                               \
      OPERATION_INLINE(                                                        \
          ToStream,                                                            \
          (struct MODULE_TYPED(Iterator, Stream, SUFFIX) *outStream), {        \
            if (!self || !outStream)                                           \
              return STATUS_CONST(INVALID_ARGUMENT);                           \
            return MODULE_FUNC(Iterator, Stream, SUFFIX, Bind)(                \
                outStream, (void *)self,                                       \
                (OPSTATUS (*)(void *, TYPE *))MODULE_FUNC(                     \
                    Iterator, Forward, SUFFIX, StepValue),                     \
                (bool (*)(const void *))MODULE_FUNC(                           \
                    Iterator, Forward, SUFFIX, HasNext),                       \
                (OPSTATUS (*)(void *))MODULE_FUNC(                             \
                    Iterator, Forward, SUFFIX, Reset));                        \
          })                                                                   \
  )
#endif

/* Mode 2 (Direct Include): Auto-instantiates and cleans up environment */
#if defined(SUFFIX) && defined(TYPE)
  TEMPLATE_Iterator_Forward(SUFFIX, TYPE);
  #undef SUFFIX
  #undef TYPE
#endif

