
/* ============================================================
 * Single Linked — Modifiers
 *
 * Compostos a partir das funções internas (Internal.impl).
 * ============================================================ */

/* PushFront — Cria nó e liga no head */
#define COSMERON_MACRO_INTERNAL_SINGLE_LINKED_IMPLEMENT_PUSH_FRONT(TYPE, FUNCTION_NAME,                \
                                           FUNCTION_CREATE_NODE,               \
                                           FUNCTION_LINK_FRONT,                \
                                           CONTAINER_STRUCT, NODE_STRUCT)       \
  static inline OPSTATUS FUNCTION_NAME(CONTAINER_STRUCT *container,            \
                                       TYPE value) {                           \
    if (!container)                                                            \
      return STATUS_CONST(INVALID_ARGUMENT);                                      \
    NODE_STRUCT *node;                                                         \
    OPSTATUS status = FUNCTION_CREATE_NODE(&node, value);                         \
    if (status != STATUS_CONST(SUCCESS))                                         \
      return status;                                                              \
    FUNCTION_LINK_FRONT(container, node);                                      \
    return STATUS_CONST(SUCCESS);                                             \
  }

/* PopFront — Remove do head e libera */
#define COSMERON_MACRO_INTERNAL_SINGLE_LINKED_IMPLEMENT_POP_FRONT(TYPE, FUNCTION_NAME,                 \
                                          FUNCTION_UNLINK_FRONT,               \
                                          CONTAINER_STRUCT)                     \
  static inline OPSTATUS FUNCTION_NAME(CONTAINER_STRUCT *container,            \
                                       TYPE *outValue) {                      \
    if (!container || !outValue)                                               \
      return STATUS_CONST(INVALID_ARGUMENT);                                   \
    if (!container->head)                                                      \
      return STATUS_CONST(OUT_OF_RANGE);                                      \
    *outValue = container->head->value;                                    \
    FUNCTION_UNLINK_FRONT(container);                                          \
    return STATUS_CONST(SUCCESS);                                             \
  }

/* PushBack — Cria nó e liga no tail */
#define COSMERON_MACRO_INTERNAL_SINGLE_LINKED_IMPLEMENT_PUSH_BACK(TYPE, FUNCTION_NAME,                 \
                                          FUNCTION_CREATE_NODE,                \
                                          FUNCTION_LINK_BACK,                  \
                                          CONTAINER_STRUCT, NODE_STRUCT)        \
  static inline OPSTATUS FUNCTION_NAME(CONTAINER_STRUCT *container,            \
                                       TYPE value) {                           \
    if (!container)                                                            \
      return STATUS_CONST(INVALID_ARGUMENT);                                      \
    NODE_STRUCT *node;                                                         \
    OPSTATUS status = FUNCTION_CREATE_NODE(&node, value);                         \
    if (status != STATUS_CONST(SUCCESS))                                         \
      return status;                                                              \
    FUNCTION_LINK_BACK(container, node);                                       \
    return STATUS_CONST(SUCCESS);                                             \
  }

/* Clear — Destroi tudo e reinicializa */
#define COSMERON_MACRO_INTERNAL_SINGLE_LINKED_IMPLEMENT_CLEAR(TYPE, FUNCTION_NAME,                     \
                                      FUNCTION_DESTROY, CONTAINER_STRUCT)      \
  static inline void FUNCTION_NAME(CONTAINER_STRUCT *container) {              \
    FUNCTION_DESTROY(container);                                               \
  }

/* InsertAfter — Insere após um nó existente */
#define COSMERON_MACRO_INTERNAL_SINGLE_LINKED_IMPLEMENT_INSERT_AFTER(TYPE, FUNCTION_NAME,              \
                                             FUNCTION_CREATE_NODE,             \
                                             CONTAINER_STRUCT, NODE_STRUCT)     \
  static inline OPSTATUS FUNCTION_NAME(CONTAINER_STRUCT *container,            \
                                       NODE_STRUCT *pos, TYPE value,           \
                                       NODE_STRUCT **outNode) {               \
    if (!container || !pos)                                                  \
      return STATUS_CONST(INVALID_ARGUMENT);                                      \
    NODE_STRUCT *current = container->head;                                    \
    while (current && current != pos)                                          \
      current = current->next;                                                 \
    if (!current)                                                              \
      return STATUS_CONST(INVALID_ARGUMENT);                                      \
    NODE_STRUCT *node;                                                         \
    OPSTATUS status = FUNCTION_CREATE_NODE(&node, value);                         \
    if (status != STATUS_CONST(SUCCESS))                                         \
      return status;                                                              \
    node->next = pos->next;                                                    \
    pos->next = node;                                                          \
    if (container->tail == pos)                                                \
      container->tail = node;                                                  \
    container->size++;                                                         \
    if (outNode)                                                              \
      *outNode = node;                                                        \
    return STATUS_CONST(SUCCESS);                                             \
  }

/* EraseAfter — Remove o nó após pos */
#define COSMERON_MACRO_INTERNAL_SINGLE_LINKED_IMPLEMENT_ERASE_AFTER(TYPE, FUNCTION_NAME,               \
                                            CONTAINER_STRUCT, NODE_STRUCT)      \
  static inline OPSTATUS FUNCTION_NAME(CONTAINER_STRUCT *container,            \
                                       NODE_STRUCT *pos) {                     \
    if (!container)                                                            \
      return STATUS_CONST(INVALID_ARGUMENT);                                      \
    if (!pos)                                                                  \
      return STATUS_CONST(OUT_OF_RANGE);                                          \
    NODE_STRUCT *current = container->head;                                    \
    while (current && current != pos)                                          \
      current = current->next;                                                 \
    if (!current)                                                              \
      return STATUS_CONST(INVALID_ARGUMENT);                                      \
    if (!pos->next)                                                            \
      return STATUS_CONST(OUT_OF_RANGE);                                          \
    NODE_STRUCT *old = pos->next;                                              \
    pos->next = old->next;                                                     \
    if (container->tail == old)                                                \
      container->tail = pos;                                                   \
    Memory_Free(old);                                                         \
    container->size--;                                                         \
    return STATUS_CONST(SUCCESS);                                             \
  }
