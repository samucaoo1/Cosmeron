          MODULE_IFUNC(Tree, NS(BTreeSet, SUFFIX), LastInSubtree)(             \
              self->root, &self->node, &self->index);                          \
        } else {                                                               \
          MODULE_IFUNC(Tree, NS(BTreeSet, SUFFIX), FirstInSubtree)(            \
              self->root, &self->node, &self->index);                          \
        }                                                                      \
        return STATUS_CONST(SUCCESS);                                          \
