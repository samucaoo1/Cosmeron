      }),                                                                      \
                                                                               \
      CONST_OPERATION_INLINE(Key, (const KEY_TYPE **outKey), {                 \
        return MODULE_FUNC(Tree, BTreeSetIter, SUFFIX, Get)(self, outKey);     \
