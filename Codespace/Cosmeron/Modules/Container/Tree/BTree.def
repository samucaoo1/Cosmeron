      CONST_PREDICATE_INLINE(                                                  \
          Equals,                                                              \
          (const struct MODULE_TYPED(Tree, BTreeSetIter, SUFFIX) *other), {    \
            if (!self || !other)                                               \
              return false;                                                    \
