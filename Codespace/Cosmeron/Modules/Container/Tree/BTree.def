            while (self->node != NULL) {                                       \
              CLOSURE_CALL(visitor, &self->node->keys[self->index]);           \
              MODULE_FUNC(Tree, BTreeSetIter, SUFFIX, StepNext)(self);         \
            }                                                                  \
            return STATUS_CONST(SUCCESS);                                      \
          })                                                                   \
  );                                                                           \
