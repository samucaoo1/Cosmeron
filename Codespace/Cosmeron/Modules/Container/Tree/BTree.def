                                                                               \
      PROCEDURE_INLINE(Clear, (), {                                            \
        if (!self)                                                             \
          return;                                                              \
        MODULE_IFUNC(Tree, NS(BTreeSet, SUFFIX), DestroyNodes)(self->root);    \
        self->root = NULL;                                                     \
