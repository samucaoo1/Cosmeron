        size_t idx = 0U;                                                       \
        MODULE_IFUNC(Tree, NS(BTreeSet, SUFFIX), LastInSubtree)(               \
            self->root, &node, &idx);                                          \
        *outKey = &node->keys[idx];                                            \
        return STATUS_CONST(SUCCESS);                                          \
