                                                                               \
      CONST_OPERATION_INLINE(Get, (const KEY_TYPE **outKey), {                 \
        if (!self || !outKey)                                                  \
          return STATUS_CONST(INVALID_ARGUMENT);                               \
        if (!self->node || self->index >= self->node->numKeys)                 \
