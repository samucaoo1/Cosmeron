      OPERATION_INLINE(Insert, (KEY_TYPE key), {                               \
        if (!self)                                                             \
          return STATUS_CONST(INVALID_ARGUMENT);                               \
        if (MODULE_IFUNC(Tree, NS(BTreeSet, SUFFIX), FindPos)(                 \
                self->root, self->compare, key, NULL, NULL)) {                 \
          return STATUS_CONST(ALREADY_EXISTS);                                 \
        }                                                                      \
        if (!self->root) {                                                     \
          self->root = MODULE_IFUNC(Tree, NS(BTreeSet, SUFFIX),                \
                                    CreateNode)(true);                         \
          if (!self->root)                                                     \
            return STATUS_CONST(OUT_OF_MEMORY);                                \
          self->root->keys[0U] = key;                                          \
          self->root->numKeys = 1U;                                            \
          self->size = 1U;                                                     \
          return STATUS_CONST(SUCCESS);                                        \
        }                                                                      \
        if (self->root->numKeys == 2U * (size_t)(DEGREE) - 1U) {               \
          struct MODULE_ITYPED(Tree, BTreeSetNode, SUFFIX) *newRoot =          \
              MODULE_IFUNC(Tree, NS(BTreeSet, SUFFIX), CreateNode)(false);     \
          if (!newRoot)                                                        \
            return STATUS_CONST(OUT_OF_MEMORY);                                \
          newRoot->children[0U] = self->root;                                  \
          self->root->parent = newRoot;                                        \
          OPSTATUS status = MODULE_IFUNC(Tree, NS(BTreeSet, SUFFIX),           \
                                         SplitChild)(newRoot, 0U);             \
          if (status != STATUS_CONST(SUCCESS)) {                               \
            self->root->parent = NULL;                                         \
            void *raw = (void *)newRoot;                                       \
            MODULE_IFUNC(Tree, FreeNode)(&raw);                                \
            return status;                                                     \
          }                                                                    \
          self->root = newRoot;                                                \
          size_t childIdx =                                                    \
              (CLOSURE_CALL(self->compare, key, newRoot->keys[0U]) >           \
               COMPARISON_CONST(EQUAL))                                        \
                  ? 1U                                                         \
                  : 0U;                                                        \
          status = MODULE_IFUNC(Tree, NS(BTreeSet, SUFFIX), InsertNonFull)(    \
              newRoot->children[childIdx], self->compare, key);                \
          if (status == STATUS_CONST(SUCCESS))                                 \
            self->size++;                                                      \
          return status;                                                       \
        }                                                                      \
        OPSTATUS status = MODULE_IFUNC(Tree, NS(BTreeSet, SUFFIX),             \
                                       InsertNonFull)(self->root,              \
                                                      self->compare, key);     \
        if (status == STATUS_CONST(SUCCESS))                                   \
          self->size++;                                                        \
        return status;                                                         \
      }),                                                                      \
                                                                               \
      OPERATION_INLINE(Remove, (KEY_TYPE key), {                               \
        if (!self)                                                             \
          return STATUS_CONST(INVALID_ARGUMENT);                               \
        if (!self->root)                                                       \
          return STATUS_CONST(NOT_FOUND);                                      \
        OPSTATUS status = MODULE_IFUNC(Tree, NS(BTreeSet, SUFFIX),             \
                                       RemoveFromNode)(self->root,             \
                                                       self->compare, key);    \
        if (status != STATUS_CONST(SUCCESS))                                   \
          return status;                                                       \
        self->size--;                                                          \
        if (self->root->numKeys == 0U) {                                       \
          struct MODULE_ITYPED(Tree, BTreeSetNode, SUFFIX) *oldRoot =          \
              self->root;                                                      \
          if (oldRoot->isLeaf) {                                               \
            self->root = NULL;                                                 \
          } else {                                                             \
            self->root = oldRoot->children[0U];                                \
            if (self->root)                                                    \
              self->root->parent = NULL;                                       \
          }                                                                    \
          void *raw = (void *)oldRoot;                                         \
          MODULE_IFUNC(Tree, FreeNode)(&raw);                                  \
        }                                                                      \
        return STATUS_CONST(SUCCESS);                                          \
      }),                                                                      \
                                                                               \
      OPERATION_INLINE(                                                        \
          EraseIter,                                                           \
          (struct MODULE_TYPED(Tree, BTreeSetIter, SUFFIX) *iter), {           \
            if (!self || !iter || !iter->node ||                               \
                iter->index >= iter->node->numKeys) {                          \
              return STATUS_CONST(INVALID_ARGUMENT);                           \
