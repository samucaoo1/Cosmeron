/* BTree.def - Dual Mode Engine (Zero Duplication) */

#ifndef COSMERON_MACRO_INTERNAL_TREE_BTREE_NAV
#define COSMERON_MACRO_INTERNAL_TREE_BTREE_NAV(TARGET, SUFFIX, NODE_TYPE,      \
                                               KEY_TYPE, COMP_CLOSURE_TYPE)    \
  COMPARISON(DefaultCompare, (KEY_TYPE left, KEY_TYPE right, void *context), { \
    (void)context;                                                             \
    return (left < right)                                                      \
               ? COMPARISON_CONST(LOWER)                                       \
               : ((left > right) ? COMPARISON_CONST(HIGHER)                    \
                                 : COMPARISON_CONST(EQUAL));                   \
  }),                                                                          \
                                                                               \
  PROCEDURE(DestroyNodes, (NODE_TYPE *node), {                                 \
    if (!node)                                                                 \
      return;                                                                  \
    if (!node->isLeaf) {                                                       \
      for (size_t i = 0U; i <= node->numKeys; i++) {                           \
        MODULE_IFUNC(Tree, NS(TARGET, SUFFIX), DestroyNodes)(                  \
            node->children[i]);                                                \
      }                                                                        \
    }                                                                          \
    void *raw = (void *)node;                                                  \
    MODULE_IFUNC(Tree, FreeNode)(&raw);                                        \
  }),                                                                          \
                                                                               \
  FUNCTION(size_t, ComputeHeight, (const NODE_TYPE *node), {                   \
    size_t height = 0U;                                                        \
    while (node != NULL) {                                                     \
      height++;                                                                \
      if (node->isLeaf)                                                        \
        break;                                                                 \
      node = node->children[0U];                                               \
    }                                                                          \
    return height;                                                             \
  }),                                                                          \
                                                                               \
  PROCEDURE(FirstInSubtree,                                                    \
            (NODE_TYPE *node, NODE_TYPE **outNode, size_t *outIdx), {          \
              if (!node) {                                                     \
                *outNode = NULL;                                               \
                *outIdx = 0U;                                                  \
                return;                                                        \
              }                                                                \
              while (!node->isLeaf)                                            \
                node = node->children[0U];                                     \
              *outNode = node;                                                 \
              *outIdx = 0U;                                                    \
            }),                                                                \
                                                                               \
  PROCEDURE(LastInSubtree,                                                     \
            (NODE_TYPE *node, NODE_TYPE **outNode, size_t *outIdx), {          \
              if (!node) {                                                     \
                *outNode = NULL;                                               \
                *outIdx = 0U;                                                  \
                return;                                                        \
              }                                                                \
              while (!node->isLeaf)                                            \
                node = node->children[node->numKeys];                          \
              *outNode = node;                                                 \
              *outIdx = (node->numKeys > 0U) ? (node->numKeys - 1U) : 0U;      \
            }),                                                                \
                                                                               \
  PROCEDURE(InOrderNext, (NODE_TYPE **inoutNode, size_t *inoutIdx), {          \
    NODE_TYPE *node = *inoutNode;                                              \
    size_t idx = *inoutIdx;                                                    \
    if (!node)                                                                 \
      return;                                                                  \
    if (!node->isLeaf) {                                                       \
      MODULE_IFUNC(Tree, NS(TARGET, SUFFIX), FirstInSubtree)(                  \
          node->children[idx + 1U], inoutNode, inoutIdx);                      \
      return;                                                                  \
    }                                                                          \
    if (idx + 1U < node->numKeys) {                                            \
      *inoutIdx = idx + 1U;                                                    \
      return;                                                                  \
    }                                                                          \
    while (node->parent != NULL) {                                             \
      NODE_TYPE *par = node->parent;                                           \
      size_t childIdx = 0U;                                                    \
      while (childIdx <= par->numKeys && par->children[childIdx] != node)      \
        childIdx++;                                                            \
      if (childIdx < par->numKeys) {                                           \
        *inoutNode = par;                                                      \
        *inoutIdx = childIdx;                                                  \
        return;                                                                \
      }                                                                        \
      node = par;                                                              \
    }                                                                          \
    *inoutNode = NULL;                                                         \
    *inoutIdx = 0U;                                                            \
  }),                                                                          \
                                                                               \
  PROCEDURE(InOrderPrev, (NODE_TYPE **inoutNode, size_t *inoutIdx), {          \
    NODE_TYPE *node = *inoutNode;                                              \
    size_t idx = *inoutIdx;                                                    \
    if (!node)                                                                 \
      return;                                                                  \
    if (!node->isLeaf) {                                                       \
      MODULE_IFUNC(Tree, NS(TARGET, SUFFIX), LastInSubtree)(                   \
          node->children[idx], inoutNode, inoutIdx);                           \
      return;                                                                  \
    }                                                                          \
    if (idx > 0U) {                                                            \
      *inoutIdx = idx - 1U;                                                    \
      return;                                                                  \
    }                                                                          \
    while (node->parent != NULL) {                                             \
      NODE_TYPE *par = node->parent;                                           \
      size_t childIdx = 0U;                                                    \
      while (childIdx <= par->numKeys && par->children[childIdx] != node)      \
        childIdx++;                                                            \
      if (childIdx > 0U) {                                                     \
        *inoutNode = par;                                                      \
        *inoutIdx = childIdx - 1U;                                             \
        return;                                                                \
      }                                                                        \
      node = par;                                                              \
    }                                                                          \
    *inoutNode = NULL;                                                         \
    *inoutIdx = 0U;                                                            \
  }),                                                                          \
                                                                               \
  PREDICATE(FindPos,                                                           \
            (NODE_TYPE *root, COMP_CLOSURE_TYPE cmp, KEY_TYPE key,             \
             NODE_TYPE **outNode, size_t *outIdx),                             \
            {                                                                  \
              NODE_TYPE *cur = root;                                           \
              while (cur != NULL) {                                            \
                size_t i = 0U;                                                 \
                while (i < cur->numKeys &&                                     \
                       CLOSURE_CALL(cmp, key, cur->keys[i]) >                  \
                           COMPARISON_CONST(EQUAL)) {                          \
                  i++;                                                         \
                }                                                              \
                if (i < cur->numKeys &&                                        \
                    CLOSURE_CALL(cmp, key, cur->keys[i]) ==                    \
                        COMPARISON_CONST(EQUAL)) {                             \
                  if (outNode)                                                 \
                    *outNode = cur;                                            \
                  if (outIdx)                                                  \
                    *outIdx = i;                                               \
                  return true;                                                 \
                }                                                              \
                if (cur->isLeaf)                                               \
                  break;                                                       \
                cur = cur->children[i];                                        \
              }                                                                \
              if (outNode)                                                     \
                *outNode = NULL;                                               \
              if (outIdx)                                                      \
                *outIdx = 0U;                                                  \
              return false;                                                    \
            }),                                                                \
                                                                               \
  PROCEDURE(LowerBoundPos,                                                     \
            (NODE_TYPE *root, COMP_CLOSURE_TYPE cmp, KEY_TYPE key,             \
             NODE_TYPE **outNode, size_t *outIdx),                             \
            {                                                                  \
              NODE_TYPE *cur = root;                                           \
              NODE_TYPE *bestNode = NULL;                                      \
              size_t bestIdx = 0U;                                             \
              while (cur != NULL) {                                            \
                size_t i = 0U;                                                 \
                while (i < cur->numKeys &&                                     \
                       CLOSURE_CALL(cmp, cur->keys[i], key) <                  \
                           COMPARISON_CONST(EQUAL)) {                          \
                  i++;                                                         \
                }                                                              \
                if (i < cur->numKeys) {                                        \
                  bestNode = cur;                                              \
                  bestIdx = i;                                                 \
                }                                                              \
                if (cur->isLeaf)                                               \
                  break;                                                       \
                cur = cur->children[i];                                        \
              }                                                                \
              *outNode = bestNode;                                             \
              *outIdx = bestIdx;                                               \
            }),                                                                \
                                                                               \
  PROCEDURE(UpperBoundPos,                                                     \
            (NODE_TYPE *root, COMP_CLOSURE_TYPE cmp, KEY_TYPE key,             \
             NODE_TYPE **outNode, size_t *outIdx),                             \
            {                                                                  \
              NODE_TYPE *cur = root;                                           \
              NODE_TYPE *bestNode = NULL;                                      \
              size_t bestIdx = 0U;                                             \
              while (cur != NULL) {                                            \
                size_t i = 0U;                                                 \
                while (i < cur->numKeys &&                                     \
                       CLOSURE_CALL(cmp, cur->keys[i], key) <=                 \
                           COMPARISON_CONST(EQUAL)) {                          \
                  i++;                                                         \
                }                                                              \
                if (i < cur->numKeys) {                                        \
                  bestNode = cur;                                              \
                  bestIdx = i;                                                 \
                }                                                              \
                if (cur->isLeaf)                                               \
                  break;                                                       \
                cur = cur->children[i];                                        \
              }                                                                \
              *outNode = bestNode;                                             \
              *outIdx = bestIdx;                                               \
            })
#endif

#ifndef TEMPLATE_Tree_BTreeSetDegree
#define TEMPLATE_Tree_BTreeSetDegree(SUFFIX, KEY_TYPE, DEGREE)                 \
  TEMPLATE_ISTRUCT(Tree, BTreeSetNode, SUFFIX,                                 \
      FIELDS(                                                                  \
          size_t numKeys;                                                      \
          bool isLeaf;                                                         \
          struct MODULE_ITYPED(Tree, BTreeSetNode, SUFFIX) *parent;            \
          KEY_TYPE keys[2U * (DEGREE) - 1U];                                   \
          struct MODULE_ITYPED(Tree, BTreeSetNode, SUFFIX)                     \
              *children[2U * (DEGREE)];                                        \
      ));                                                                      \
  CLOSURE_SCOPED_COMPARISON(NS(LIB_PREFIX(Tree), BTreeSet, SUFFIX),            \
                            Comparator, (KEY_TYPE left, KEY_TYPE right))       \
  CLOSURE_SCOPED_PROCEDURE(NS(LIB_PREFIX(Tree), BTreeSet, SUFFIX), Visitor,    \
                           (const KEY_TYPE *key))                              \
  INTERNAL_DEF_EX(                                                             \
      Tree, NS(BTreeSet, SUFFIX),                                              \
      COSMERON_MACRO_INTERNAL_TREE_BTREE_NAV(                                  \
          BTreeSet, SUFFIX, struct MODULE_ITYPED(Tree, BTreeSetNode, SUFFIX),  \
          KEY_TYPE, MODULE_CLOSURE(Tree, BTreeSet, SUFFIX, Comparator)),       \
                                                                               \
      FUNCTION(struct MODULE_ITYPED(Tree, BTreeSetNode, SUFFIX) *, CreateNode, \
               (bool isLeaf), {                                                \
                 void *raw = NULL;                                             \
                 if (MODULE_IFUNC(Tree, AllocNode)(                            \
                         &raw, sizeof(struct MODULE_ITYPED(Tree, BTreeSetNode, \
                                                            SUFFIX))) !=       \
                     STATUS_CONST(SUCCESS)) {                                  \
                   return NULL;                                                \
                 }                                                             \
                 struct MODULE_ITYPED(Tree, BTreeSetNode, SUFFIX) *node =      \
                     (struct MODULE_ITYPED(Tree, BTreeSetNode, SUFFIX) *)raw;  \
                 node->numKeys = 0U;                                           \
                 node->isLeaf = isLeaf;                                        \
                 node->parent = NULL;                                          \
                 for (size_t i = 0U; i < 2U * (size_t)(DEGREE); i++)           \
                   node->children[i] = NULL;                                   \
                 return node;                                                  \
               }),                                                             \
                                                                               \
      OPERATION(SplitChild,                                                    \
                (struct MODULE_ITYPED(Tree, BTreeSetNode, SUFFIX) *parent,     \
                 size_t idx),                                                  \
                {                                                              \
                  struct MODULE_ITYPED(Tree, BTreeSetNode, SUFFIX) *y =        \
                      parent->children[idx];                                   \
                  struct MODULE_ITYPED(Tree, BTreeSetNode, SUFFIX) *z =        \
                      MODULE_IFUNC(Tree, NS(BTreeSet, SUFFIX), CreateNode)(    \
                          y->isLeaf);                                          \
                  if (!z)                                                      \
                    return STATUS_CONST(OUT_OF_MEMORY);                        \
                  size_t t = (size_t)(DEGREE);                                 \
                  z->numKeys = t - 1U;                                         \
                  z->parent = parent;                                          \
                  for (size_t j = 0U; j < t - 1U; j++)                         \
                    z->keys[j] = y->keys[j + t];                               \
                  if (!y->isLeaf) {                                            \
                    for (size_t j = 0U; j < t; j++) {                          \
                      z->children[j] = y->children[j + t];                     \
                      if (z->children[j])                                      \
                        z->children[j]->parent = z;                            \
                      y->children[j + t] = NULL;                               \
                    }                                                          \
                  }                                                            \
                  y->numKeys = t - 1U;                                         \
                  for (size_t j = parent->numKeys; j > idx; j--)               \
                    parent->children[j + 1U] = parent->children[j];            \
                  parent->children[idx + 1U] = z;                              \
                  for (size_t j = parent->numKeys; j > idx; j--)               \
                    parent->keys[j] = parent->keys[j - 1U];                    \
                  parent->keys[idx] = y->keys[t - 1U];                         \
                  parent->numKeys++;                                           \
                  return STATUS_CONST(SUCCESS);                                \
                }),                                                            \
                                                                               \
      OPERATION(InsertNonFull,                                                 \
                (struct MODULE_ITYPED(Tree, BTreeSetNode, SUFFIX) *node,       \
                 MODULE_CLOSURE(Tree, BTreeSet, SUFFIX, Comparator) cmp,       \
                 KEY_TYPE key),                                                \
                {                                                              \
                  size_t i = node->numKeys;                                    \
                  if (node->isLeaf) {                                          \
                    while (i > 0U &&                                           \
                           CLOSURE_CALL(cmp, key, node->keys[i - 1U]) <        \
                               COMPARISON_CONST(EQUAL)) {                      \
                      node->keys[i] = node->keys[i - 1U];                      \
                      i--;                                                     \
                    }                                                          \
                    node->keys[i] = key;                                       \
                    node->numKeys++;                                           \
                    return STATUS_CONST(SUCCESS);                              \
                  }                                                            \
                  while (i > 0U &&                                             \
                         CLOSURE_CALL(cmp, key, node->keys[i - 1U]) <          \
                             COMPARISON_CONST(EQUAL)) {                        \
                    i--;                                                       \
                  }                                                            \
                  if (node->children[i]->numKeys == 2U * (size_t)(DEGREE) - 1U){\
                    OPSTATUS status = MODULE_IFUNC(Tree, NS(BTreeSet, SUFFIX), \
                                                   SplitChild)(node, i);       \
                    if (status != STATUS_CONST(SUCCESS))                       \
                      return status;                                           \
                    if (CLOSURE_CALL(cmp, key, node->keys[i]) >                \
                        COMPARISON_CONST(EQUAL)) {                             \
                      i++;                                                     \
                    }                                                          \
                  }                                                            \
                  return MODULE_IFUNC(Tree, NS(BTreeSet, SUFFIX),              \
                                      InsertNonFull)(node->children[i], cmp,   \
                                                     key);                     \
                }),                                                            \
                                                                               \
      PROCEDURE(Merge,                                                         \
                (struct MODULE_ITYPED(Tree, BTreeSetNode, SUFFIX) *node,       \
                 size_t idx),                                                  \
                {                                                              \
                  struct MODULE_ITYPED(Tree, BTreeSetNode, SUFFIX) *child =    \
                      node->children[idx];                                     \
                  struct MODULE_ITYPED(Tree, BTreeSetNode, SUFFIX) *sibling =  \
                      node->children[idx + 1U];                                \
                  size_t t = (size_t)(DEGREE);                                 \
                  child->keys[t - 1U] = node->keys[idx];                       \
                  for (size_t i = 0U; i < sibling->numKeys; i++)               \
                    child->keys[i + t] = sibling->keys[i];                     \
                  if (!child->isLeaf) {                                        \
                    for (size_t i = 0U; i <= sibling->numKeys; i++) {          \
                      child->children[i + t] = sibling->children[i];           \
                      if (child->children[i + t])                              \
                        child->children[i + t]->parent = child;                \
                    }                                                          \
                  }                                                            \
                  for (size_t i = idx + 1U; i < node->numKeys; i++)            \
                    node->keys[i - 1U] = node->keys[i];                        \
                  for (size_t i = idx + 2U; i <= node->numKeys; i++)           \
                    node->children[i - 1U] = node->children[i];                \
                  child->numKeys += sibling->numKeys + 1U;                     \
                  node->numKeys--;                                             \
                  void *raw = (void *)sibling;                                 \
                  MODULE_IFUNC(Tree, FreeNode)(&raw);                          \
                }),                                                            \
                                                                               \
      PROCEDURE(BorrowFromPrev,                                                \
                (struct MODULE_ITYPED(Tree, BTreeSetNode, SUFFIX) *node,       \
                 size_t idx),                                                  \
                {                                                              \
                  struct MODULE_ITYPED(Tree, BTreeSetNode, SUFFIX) *child =    \
                      node->children[idx];                                     \
                  struct MODULE_ITYPED(Tree, BTreeSetNode, SUFFIX) *sibling =  \
                      node->children[idx - 1U];                                \
                  for (size_t i = child->numKeys; i > 0U; i--)                 \
                    child->keys[i] = child->keys[i - 1U];                      \
                  if (!child->isLeaf) {                                        \
                    for (size_t i = child->numKeys + 1U; i > 0U; i--)          \
                      child->children[i] = child->children[i - 1U];            \
                  }                                                            \
                  child->keys[0U] = node->keys[idx - 1U];                      \
                  if (!child->isLeaf) {                                        \
                    child->children[0U] = sibling->children[sibling->numKeys]; \
                    if (child->children[0U])                                   \
                      child->children[0U]->parent = child;                     \
                  }                                                            \
                  node->keys[idx - 1U] = sibling->keys[sibling->numKeys - 1U]; \
                  child->numKeys++;                                            \
                  sibling->numKeys--;                                          \
                }),                                                            \
                                                                               \
      PROCEDURE(BorrowFromNext,                                                \
                (struct MODULE_ITYPED(Tree, BTreeSetNode, SUFFIX) *node,       \
                 size_t idx),                                                  \
                {                                                              \
                  struct MODULE_ITYPED(Tree, BTreeSetNode, SUFFIX) *child =    \
                      node->children[idx];                                     \
                  struct MODULE_ITYPED(Tree, BTreeSetNode, SUFFIX) *sibling =  \
                      node->children[idx + 1U];                                \
                  child->keys[child->numKeys] = node->keys[idx];               \
                  if (!child->isLeaf) {                                        \
                    child->children[child->numKeys + 1U] =                     \
                        sibling->children[0U];                                 \
                    if (child->children[child->numKeys + 1U])                  \
                      child->children[child->numKeys + 1U]->parent = child;    \
                  }                                                            \
                  node->keys[idx] = sibling->keys[0U];                         \
                  for (size_t i = 1U; i < sibling->numKeys; i++)               \
                    sibling->keys[i - 1U] = sibling->keys[i];                  \
                  if (!sibling->isLeaf) {                                      \
                    for (size_t i = 1U; i <= sibling->numKeys; i++)            \
                      sibling->children[i - 1U] = sibling->children[i];        \
                  }                                                            \
                  child->numKeys++;                                            \
                  sibling->numKeys--;                                          \
                }),                                                            \
                                                                               \
      PROCEDURE(Fill,                                                          \
                (struct MODULE_ITYPED(Tree, BTreeSetNode, SUFFIX) *node,       \
                 size_t idx),                                                  \
                {                                                              \
                  size_t t = (size_t)(DEGREE);                                 \
                  if (idx != 0U && node->children[idx - 1U]->numKeys >= t) {   \
                    MODULE_IFUNC(Tree, NS(BTreeSet, SUFFIX),                   \
                                 BorrowFromPrev)(node, idx);                   \
                  } else if (idx != node->numKeys &&                           \
                             node->children[idx + 1U]->numKeys >= t) {         \
                    MODULE_IFUNC(Tree, NS(BTreeSet, SUFFIX),                   \
                                 BorrowFromNext)(node, idx);                   \
                  } else {                                                     \
                    if (idx != node->numKeys)                                  \
                      MODULE_IFUNC(Tree, NS(BTreeSet, SUFFIX), Merge)(node,    \
                                                                      idx);    \
                    else                                                       \
                      MODULE_IFUNC(Tree, NS(BTreeSet, SUFFIX), Merge)(         \
                          node, idx - 1U);                                     \
                  }                                                            \
                }),                                                            \
                                                                               \
      OPERATION(RemoveFromNode,                                                \
                (struct MODULE_ITYPED(Tree, BTreeSetNode, SUFFIX) *node,       \
                 MODULE_CLOSURE(Tree, BTreeSet, SUFFIX, Comparator) cmp,       \
                 KEY_TYPE key),                                                \
                {                                                              \
                  size_t idx = 0U;                                             \
                  while (idx < node->numKeys &&                                \
                         CLOSURE_CALL(cmp, node->keys[idx], key) <             \
                             COMPARISON_CONST(EQUAL)) {                        \
                    idx++;                                                     \
                  }                                                            \
                  if (idx < node->numKeys &&                                   \
                      CLOSURE_CALL(cmp, node->keys[idx], key) ==               \
                          COMPARISON_CONST(EQUAL)) {                           \
                    if (node->isLeaf) {                                        \
                      for (size_t i = idx + 1U; i < node->numKeys; i++)        \
                        node->keys[i - 1U] = node->keys[i];                    \
                      node->numKeys--;                                         \
                      return STATUS_CONST(SUCCESS);                            \
                    }                                                          \
                    size_t t = (size_t)(DEGREE);                               \
                    if (node->children[idx]->numKeys >= t) {                   \
                      struct MODULE_ITYPED(Tree, BTreeSetNode, SUFFIX) *pred = \
                          NULL;                                                \
                      size_t predIdx = 0U;                                     \
                      MODULE_IFUNC(Tree, NS(BTreeSet, SUFFIX), LastInSubtree)( \
                          node->children[idx], &pred, &predIdx);               \
                      KEY_TYPE predKey = pred->keys[predIdx];                  \
                      node->keys[idx] = predKey;                               \
                      return MODULE_IFUNC(Tree, NS(BTreeSet, SUFFIX),          \
                                          RemoveFromNode)(node->children[idx], \
                                                          cmp, predKey);       \
                    } else if (node->children[idx + 1U]->numKeys >= t) {       \
                      struct MODULE_ITYPED(Tree, BTreeSetNode, SUFFIX) *succ = \
                          NULL;                                                \
                      size_t succIdx = 0U;                                     \
                      MODULE_IFUNC(Tree, NS(BTreeSet, SUFFIX),                 \
                                   FirstInSubtree)(node->children[idx + 1U],   \
                                                   &succ, &succIdx);           \
                      KEY_TYPE succKey = succ->keys[succIdx];                  \
                      node->keys[idx] = succKey;                               \
                      return MODULE_IFUNC(Tree, NS(BTreeSet, SUFFIX),          \
                                          RemoveFromNode)(                     \
                          node->children[idx + 1U], cmp, succKey);             \
                    } else {                                                   \
                      MODULE_IFUNC(Tree, NS(BTreeSet, SUFFIX), Merge)(node,    \
                                                                      idx);    \
                      return MODULE_IFUNC(Tree, NS(BTreeSet, SUFFIX),          \
                                          RemoveFromNode)(node->children[idx], \
                                                          cmp, key);           \
                    }                                                          \
                  } else {                                                     \
                    if (node->isLeaf)                                          \
                      return STATUS_CONST(NOT_FOUND);                          \
                    bool flag = (idx == node->numKeys);                        \
                    size_t t = (size_t)(DEGREE);                               \
                    if (node->children[idx]->numKeys < t)                      \
                      MODULE_IFUNC(Tree, NS(BTreeSet, SUFFIX), Fill)(node,     \
                                                                     idx);     \
                    if (flag && idx > node->numKeys)                           \
                      return MODULE_IFUNC(Tree, NS(BTreeSet, SUFFIX),          \
                                          RemoveFromNode)(                     \
                          node->children[idx - 1U], cmp, key);                 \
                    return MODULE_IFUNC(Tree, NS(BTreeSet, SUFFIX),            \
                                        RemoveFromNode)(node->children[idx],   \
                                                        cmp, key);             \
                  }                                                            \
                }),                                                            \
                                                                               \
      PROCEDURE(PreOrder,                                                      \
                (struct MODULE_ITYPED(Tree, BTreeSetNode, SUFFIX) *node,       \
                 MODULE_CLOSURE(Tree, BTreeSet, SUFFIX, Visitor) visitor),     \
                {                                                              \
                  if (!node)                                                   \
                    return;                                                    \
                  for (size_t i = 0U; i < node->numKeys; i++)                  \
                    CLOSURE_CALL(visitor, &node->keys[i]);                     \
                  if (!node->isLeaf) {                                         \
                    for (size_t i = 0U; i <= node->numKeys; i++) {             \
                      MODULE_IFUNC(Tree, NS(BTreeSet, SUFFIX), PreOrder)(      \
                          node->children[i], visitor);                         \
                    }                                                          \
                  }                                                            \
                }),                                                            \
                                                                               \
      PROCEDURE(InOrder,                                                       \
                (struct MODULE_ITYPED(Tree, BTreeSetNode, SUFFIX) *node,       \
                 MODULE_CLOSURE(Tree, BTreeSet, SUFFIX, Visitor) visitor),     \
                {                                                              \
                  if (!node)                                                   \
                    return;                                                    \
                  for (size_t i = 0U; i < node->numKeys; i++) {                \
                    if (!node->isLeaf) {                                       \
                      MODULE_IFUNC(Tree, NS(BTreeSet, SUFFIX), InOrder)(       \
                          node->children[i], visitor);                         \
                    }                                                          \
                    CLOSURE_CALL(visitor, &node->keys[i]);                     \
                  }                                                            \
                  if (!node->isLeaf) {                                         \
                    MODULE_IFUNC(Tree, NS(BTreeSet, SUFFIX), InOrder)(         \
                        node->children[node->numKeys], visitor);               \
                  }                                                            \
                }),                                                            \
                                                                               \
      PROCEDURE(PostOrder,                                                     \
                (struct MODULE_ITYPED(Tree, BTreeSetNode, SUFFIX) *node,       \
                 MODULE_CLOSURE(Tree, BTreeSet, SUFFIX, Visitor) visitor),     \
                {                                                              \
                  if (!node)                                                   \
                    return;                                                    \
                  if (!node->isLeaf) {                                         \
                    for (size_t i = 0U; i <= node->numKeys; i++) {             \
                      MODULE_IFUNC(Tree, NS(BTreeSet, SUFFIX), PostOrder)(     \
                          node->children[i], visitor);                         \
                    }                                                          \
                  }                                                            \
                  for (size_t i = 0U; i < node->numKeys; i++)                  \
                    CLOSURE_CALL(visitor, &node->keys[i]);                     \
                }))                                                            \
