          if (self->reverse)                                                   \
            MODULE_IFUNC(Tree, NS(BTreeSet, SUFFIX), InOrderNext)(&n, &i);     \
          else                                                                 \
            MODULE_IFUNC(Tree, NS(BTreeSet, SUFFIX), InOrderPrev)(&n, &i);     \
          return n != NULL;                                                    \
