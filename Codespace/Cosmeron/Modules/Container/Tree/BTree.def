                                                                               \
      OPERATION_INLINE(StepPrev, (), {                                         \
        if (!self)                                                             \
          return STATUS_CONST(INVALID_ARGUMENT);                               \
        if (self->node == NULL) {                                              \
          if (!self->root)                                                     \
            return STATUS_CONST(OUT_OF_RANGE);                                 \
          if (self->reverse) {                                                 \
            MODULE_IFUNC(Tree, NS(BTreeSet, SUFFIX), FirstInSubtree)(          \
                self->root, &self->node, &self->index);                        \
          } else {                                                             \
            MODULE_IFUNC(Tree, NS(BTreeSet, SUFFIX), LastInSubtree)(           \
                self->root, &self->node, &self->index);                        \
          }                                                                    \
          return STATUS_CONST(SUCCESS);                                        \
        }                                                                      \
        struct MODULE_ITYPED(Tree, BTreeSetNode, SUFFIX) *n = self->node;      \
        size_t i = self->index;                                                \
        if (self->reverse)                                                     \
          MODULE_IFUNC(Tree, NS(BTreeSet, SUFFIX), InOrderNext)(&n, &i);       \
        else                                                                   \
          MODULE_IFUNC(Tree, NS(BTreeSet, SUFFIX), InOrderPrev)(&n, &i);       \
        if (!n)                                                                \
          return STATUS_CONST(OUT_OF_RANGE);                                   \
        self->node = n;                                                        \
        self->index = i;                                                       \
        return STATUS_CONST(SUCCESS);                                          \
      }),                                                                      \
                                                                               \
      OPERATION_INLINE(Next, (const KEY_TYPE **outKey), {                      \
        if (!self)                                                             \
          return STATUS_CONST(INVALID_ARGUMENT);                               \
        if (!self->node || self->index >= self->node->numKeys)                 \
          return STATUS_CONST(OUT_OF_RANGE);                                   \
        if (outKey)                                                            \
          *outKey = &self->node->keys[self->index];                            \
        return MODULE_FUNC(Tree, BTreeSetIter, SUFFIX, StepNext)(self);        \
      }),                                                                      \
                                                                               \
      OPERATION_INLINE(Prev, (const KEY_TYPE **outKey), {                      \
        OPSTATUS status =                                                      \
            MODULE_FUNC(Tree, BTreeSetIter, SUFFIX, StepPrev)(self);           \
        if (status != STATUS_CONST(SUCCESS))                                   \
          return status;                                                       \
        if (outKey)                                                            \
          *outKey = &self->node->keys[self->index];                            \
        return STATUS_CONST(SUCCESS);                                          \
