          MODULE_CLOSURE(Tree, BTreeSet, SUFFIX, Comparator) compare;          \
      ),                                                                       \
                                                                               \
      OPERATION_INLINE(                                                        \
          CreateWithComparator,                                                \
          (CMPOUT (*compareFn)(KEY_TYPE left, KEY_TYPE right, void *context),  \
