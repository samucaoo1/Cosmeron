      OPERATION_INLINE(StepNext, (), {                                         \
        if (!self)                                                             \
          return STATUS_CONST(INVALID_ARGUMENT);                               \
        if (!self->node)                                                       \
          return STATUS_CONST(OUT_OF_RANGE);                                   \
        if (self->reverse) {                                                   \
          MODULE_IFUNC(Tree, NS(BTreeSet, SUFFIX), InOrderPrev)(               \
              &self->node, &self->index);                                      \
        } else {                                                               \
          MODULE_IFUNC(Tree, NS(BTreeSet, SUFFIX), InOrderNext)(               \
              &self->node, &self->index);                                      \
        }                                                                      \
        return STATUS_CONST(SUCCESS);                                          \
