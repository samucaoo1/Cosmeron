            KEY_TYPE targetKey = iter->node->keys[iter->index];                \
            bool wasReverse = iter->reverse;                                   \
            struct MODULE_TYPED(Tree, BTreeSetIter, SUFFIX) probe = *iter;     \
            MODULE_FUNC(Tree, BTreeSetIter, SUFFIX, StepNext)(&probe);         \
            bool hasNext = (probe.node != NULL);                               \
            KEY_TYPE nextKey = targetKey;                                      \
            if (hasNext)                                                       \
              nextKey = probe.node->keys[probe.index];                         \
            OPSTATUS status =                                                  \
                MODULE_FUNC(Tree, BTreeSet, SUFFIX, Remove)(self, targetKey);  \
            if (status != STATUS_CONST(SUCCESS))                               \
              return status;                                                   \
            if (hasNext) {                                                     \
              struct MODULE_ITYPED(Tree, BTreeSetNode, SUFFIX) *nextNode =     \
                  NULL;                                                        \
              size_t nextIdx = 0U;                                             \
              MODULE_IFUNC(Tree, NS(BTreeSet, SUFFIX), FindPos)(               \
                  self->root, self->compare, nextKey, &nextNode, &nextIdx);    \
              return MODULE_FUNC(Tree, BTreeSetIter, SUFFIX, FromPos)(         \
                  iter, self->root, nextNode, nextIdx, wasReverse);            \
            }                                                                  \
            return MODULE_FUNC(Tree, BTreeSetIter, SUFFIX, FromPos)(           \
                iter, self->root, NULL, 0U, wasReverse);                       \
          }),                                                                  \
