          {                                                                    \
            if (!self)                                                         \
              return STATUS_CONST(INVALID_ARGUMENT);                           \
            MODULE_FUNC(Tree, BTreeSet, SUFFIX, Init)(self);                   \
            self->root = NULL;                                                 \
            self->size = 0U;                                                   \
            self->degree = (size_t)(DEGREE);                                   \
            if (compareFn) {                                                   \
              self->compare = NS_JOIN(                                         \
                  MODULE_CLOSURE_FUNC(Tree, BTreeSet, SUFFIX, Comparator),     \
                  Bind)(compareFn, context);                                   \
            } else {                                                           \
              self->compare = NS_JOIN(                                         \
                  MODULE_CLOSURE_FUNC(Tree, BTreeSet, SUFFIX, Comparator),     \
                  Bind)(                                                       \
                  MODULE_IFUNC(Tree, NS(BTreeSet, SUFFIX), DefaultCompare),    \
                  NULL);                                                       \
            }                                                                  \
            return STATUS_CONST(SUCCESS);                                      \
          }),                                                                  \
                                                                               \
      OPERATION_INLINE(Create, (), {                                           \
        return MODULE_FUNC(Tree, BTreeSet, SUFFIX, CreateWithComparator)(      \
            self, NULL, NULL);                                                 \
