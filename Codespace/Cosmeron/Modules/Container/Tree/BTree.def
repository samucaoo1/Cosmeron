  TEMPLATE_OBJECT(Tree, BTreeSetIter, SUFFIX,                                  \
      FIELDS(                                                                  \
          struct MODULE_ITYPED(Tree, BTreeSetNode, SUFFIX) *root;              \
          struct MODULE_ITYPED(Tree, BTreeSetNode, SUFFIX) *node;              \
          size_t index;                                                        \
          bool reverse;                                                        \
      ),                                                                       \
                                                                               \
      CLOSURE(PROCEDURE(Visitor, (const KEY_TYPE *key))),                      \
                                                                               \
      OPERATION_INLINE(                                                        \
          FromPos,                                                             \
          (struct MODULE_ITYPED(Tree, BTreeSetNode, SUFFIX) *root,             \
