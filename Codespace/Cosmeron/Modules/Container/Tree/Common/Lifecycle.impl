
/* =============================================================
 * Lifecycle — Init, DestroyNodes, Destroy, Clear
 * Shared by all algorithms and both set/map semantics.
 * ============================================================= */

#define TTREE_IMPLEMENT_LIFECYCLE(T)                                           \
  TTREE_INIT_PROTOTYPE(T) {                        \
    if (!tree)                                                                 \
      return STATUS_CONST(INVALID_ARGUMENT);                                      \
    tree->root = NULL;                                                         \
    tree->size = 0;                                                            \
    return STATUS_CONST(SUCCESS);                                                 \
  }                                                                            \
                                                                               \
  static inline void TTREE_FN(T, DestroyNodes)(TTREE_NODE(T) * node) {        \
    if (!node)                                                                 \
      return;                                                                  \
    TTREE_FN(T, DestroyNodes)(node->left);                                     \
    TTREE_FN(T, DestroyNodes)(node->right);                                    \
    Memory_Free(node);                                                        \
  }                                                                            \
                                                                               \
  TTREE_DESTROY_PROTOTYPE(T) {                         \
    if (!tree)                                                                 \
      return;                                                                  \
    TTREE_FN(T, DestroyNodes)(tree->root);                                     \
    tree->root = NULL;                                                         \
    tree->size = 0;                                                            \
  }                                                                            \
                                                                               \
  TTREE_CLEAR_PROTOTYPE(T) {                           \
    if (!tree)                                                                 \
      return;                                                                  \
    TTREE_FN(T, Destroy)(tree);                                                \
  }
