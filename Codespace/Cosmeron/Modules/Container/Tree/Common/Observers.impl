
/* =============================================================
 * Observers — FindNode, Contains, MinNode, MaxNode, Min, Max,
 *             Empty, Size
 * Shared by all algorithms.  CMP is baked at compile time.
 *
 * Find is split:
 *   TTREE_IMPLEMENT_FIND_SET  → OPSTATUS + KEY_TYPE **out
 *   TTREE_IMPLEMENT_FIND_MAP  → OPSTATUS + VALUE_TYPE **out
 * ============================================================= */

#define TTREE_IMPLEMENT_OBSERVERS(T, KEY_TYPE, CMP)                            \
  TTREE_FIND_NODE_PROTOTYPE(T, KEY_TYPE) {                          \
    if (!tree)                                                                 \
      return NULL;                                                             \
    TTREE_NODE(T) *current = tree->root;                                       \
    while (current) {                                                          \
      TTREE_CMPOUT _r = CMP(key, current->key);                                      \
      if (_r < 0)                                                              \
        current = current->left;                                               \
      else if (_r > 0)                                                         \
        current = current->right;                                              \
      else                                                                     \
        return current;                                                        \
    }                                                                          \
    return NULL;                                                               \
  }                                                                            \
                                                                               \
  TTREE_CONTAINS_PROTOTYPE(T, KEY_TYPE) {       \
    if (!tree)                                                                 \
      return false;                                                            \
    const TTREE_NODE(T) *current = tree->root;                                 \
    while (current) {                                                          \
      TTREE_CMPOUT result = CMP(key, current->key);                            \
      if (result < 0) current = current->left;                                 \
      else if (result > 0) current = current->right;                           \
      else return true;                                                        \
    }                                                                          \
    return false;                                                              \
  }                                                                            \
                                                                               \
  TTREE_MIN_NODE_PROTOTYPE(T) {                            \
    if (!node)                                                                 \
      return NULL;                                                             \
    while (node->left)                                                         \
      node = node->left;                                                       \
    return node;                                                               \
  }                                                                            \
                                                                               \
  TTREE_MAX_NODE_PROTOTYPE(T) {                            \
    if (!node)                                                                 \
      return NULL;                                                             \
    while (node->right)                                                        \
      node = node->right;                                                      \
    return node;                                                               \
  }                                                                            \
                                                                               \
  TTREE_MIN_PROTOTYPE(T, KEY_TYPE) {           \
    TTREE_NODE(T) *node;                                                       \
    if (!tree || !out)                                                        \
      return STATUS_CONST(INVALID_ARGUMENT);                                   \
    node = TTREE_FN(T, MinNode)(tree->root);                                   \
    if (!node)                                                                \
      return STATUS_CONST(NOT_FOUND);                                          \
    *out = &node->key;                                                         \
    return STATUS_CONST(SUCCESS);                                              \
  }                                                                            \
                                                                               \
  TTREE_MAX_PROTOTYPE(T, KEY_TYPE) {           \
    TTREE_NODE(T) *node;                                                       \
    if (!tree || !out)                                                        \
      return STATUS_CONST(INVALID_ARGUMENT);                                   \
    node = TTREE_FN(T, MaxNode)(tree->root);                                   \
    if (!node)                                                                \
      return STATUS_CONST(NOT_FOUND);                                          \
    *out = &node->key;                                                         \
    return STATUS_CONST(SUCCESS);                                              \
  }                                                                            \
                                                                               \
  TTREE_EMPTY_PROTOTYPE(T) {                       \
    return tree != NULL && tree->size == 0;                                    \
  }                                                                            \
                                                                               \
  TTREE_SIZE_PROTOTYPE(T) {                      \
    return tree ? tree->size : 0U;                                             \
  }

/* ------ Find: SET variant (returns KEY_TYPE*) ------ */

#define TTREE_IMPLEMENT_FIND_SET(T, KEY_TYPE)                                  \
  TTREE_FIND_SET_PROTOTYPE(T, KEY_TYPE) {                   \
    TTREE_NODE(T) *node;                                                       \
    if (!tree || !out)                                                        \
      return STATUS_CONST(INVALID_ARGUMENT);                                   \
    node = TTREE_FN(T, FindNode)(tree, key);                                   \
    if (!node)                                                                \
      return STATUS_CONST(NOT_FOUND);                                          \
    *out = &node->key;                                                         \
    return STATUS_CONST(SUCCESS);                                              \
  }

/* ------ Find: MAP variant (returns VALUE_TYPE*) ------ */

#define TTREE_IMPLEMENT_FIND_MAP(T, KEY_TYPE, VALUE_TYPE)                      \
  TTREE_FIND_MAP_PROTOTYPE(T, KEY_TYPE, VALUE_TYPE) {                 \
    TTREE_NODE(T) *node;                                                       \
    if (!tree || !out)                                                        \
      return STATUS_CONST(INVALID_ARGUMENT);                                   \
    node = TTREE_FN(T, FindNode)(tree, key);                                   \
    if (!node)                                                                \
      return STATUS_CONST(NOT_FOUND);                                          \
    *out = &node->value;                                                       \
    return STATUS_CONST(SUCCESS);                                              \
  }
