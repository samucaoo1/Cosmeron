      if (childIdx > 0U) {                                                     \
        cursor->node = par;                                                    \
        cursor->index = childIdx - 1U;                                         \
        return true;                                                           \
      }                                                                        \
      cur = par;                                                               \
    }                                                                          \
    cursor->node = NULL;                                                       \
    cursor->index = 0U;                                                        \
