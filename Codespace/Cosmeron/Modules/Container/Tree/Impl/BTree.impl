#define BTREE_MAP_CURSOR_TYPE(SUFFIX_K, SUFFIX_V)                              \
  GNS3(BTree_Map_Cursor, SUFFIX_K, SUFFIX_V)

/* =============================================================
 * Template: TBTree_Set (Declaration)
 * ============================================================= */

#define TEMPLATE_TBTREE_SET_DEGREE(SUFFIX, KEY_TYPE, DEGREE)                   \
  typedef struct BTREE_SET_NODE_TYPE(SUFFIX) {                                 \
    size_t numKeys;                                                            \
    bool isLeaf;                                                               \
    struct BTREE_SET_NODE_TYPE(SUFFIX) * parent;                               \
    KEY_TYPE keys[2 * (DEGREE) - 1];                                           \
    struct BTREE_SET_NODE_TYPE(SUFFIX) * children[2 * (DEGREE)];               \
  } BTREE_SET_NODE_TYPE(SUFFIX);                                               \
                                                                               \
  typedef struct BTREE_SET_CURSOR_TYPE(SUFFIX) {                               \
    BTREE_SET_NODE_TYPE(SUFFIX) * node;                                        \
    size_t index;                                                              \
  } BTREE_SET_CURSOR_TYPE(SUFFIX);                                             \
                                                                               \
  OBJECT(TBTREE_SET_TYPED(SUFFIX),                                             \
         FIELDS(BTREE_SET_NODE_TYPE(SUFFIX) * root; size_t size;               \
                size_t degree;                                                 \
                CMPOUT(*compare)(KEY_TYPE left, KEY_TYPE right);),             \
         OPERATION(Create, ()),                                                \
         OPERATION(CreateWithComparator,                                       \
                   (CMPOUT(*compare)(KEY_TYPE left, KEY_TYPE right))),         \
         OPERATION(Insert, (KEY_TYPE key)), OPERATION(Remove, (KEY_TYPE key)), \
         CONST_OPERATION(Find, (KEY_TYPE key, KEY_TYPE * *out)),               \
         CONST_OPERATION(Min, (KEY_TYPE * *out)),                              \
         CONST_OPERATION(Max, (KEY_TYPE * *out)), OPERATION(Clear, ()),        \
         PROCEDURE(Destroy, ()), CONST_PREDICATE(Contains, (KEY_TYPE key)),    \
         CONST_PREDICATE(Empty, ()), CONST_FUNCTION(size_t, Size, ()),         \
         CONST_FUNCTION(size_t, Height, ()),                                   \
         CONST_FUNCTION(BTREE_SET_CURSOR_TYPE(SUFFIX), First, ()),             \
         CONST_FUNCTION(BTREE_SET_CURSOR_TYPE(SUFFIX), Last, ()),              \
         CONST_FUNCTION(bool, CursorNext,                                      \
                        (BTREE_SET_CURSOR_TYPE(SUFFIX) * cursor)),             \
         CONST_FUNCTION(bool, CursorPrev,                                      \
                        (BTREE_SET_CURSOR_TYPE(SUFFIX) * cursor)),             \
         CONST_PREDICATE(CursorValid,                                          \
                         (const BTREE_SET_CURSOR_TYPE(SUFFIX) * cursor)),      \
         CONST_FUNCTION(KEY_TYPE *, CursorKey,                                 \
                        (const BTREE_SET_CURSOR_TYPE(SUFFIX) * cursor)))

#define TEMPLATE_TBTREE_SET(SUFFIX, KEY_TYPE)                                  \
  TEMPLATE_TBTREE_SET_DEGREE(SUFFIX, KEY_TYPE, BTREE_DEFAULT_DEGREE)

/* =============================================================
 * Template: TBTree_Set (Implementation)
 * ============================================================= */

#define TEMPLATE_TBTREE_SET_DEGREE_IMPLEMENT(SUFFIX, KEY_TYPE, DEGREE, CMP)    \
  static inline BTREE_SET_NODE_TYPE(SUFFIX) *                                  \
      GNS3(TBTREE_SET_TYPED(SUFFIX), Internal, CreateNode)(bool isLeaf) {      \
    void *allocated = NULL;                                                    \
    if (ALLOC_FUNC(AllocArray)(&allocated, 1U,                                 \
                               sizeof(BTREE_SET_NODE_TYPE(SUFFIX))) !=         \
        STATUS_CONST(SUCCESS))                                                 \
      return NULL;                                                             \
    BTREE_SET_NODE_TYPE(SUFFIX) *node =                                        \
        (BTREE_SET_NODE_TYPE(SUFFIX) *)allocated;                              \
    node->numKeys = 0;                                                         \
    node->isLeaf = isLeaf;                                                     \
    node->parent = NULL;                                                       \
    for (size_t i = 0; i < 2 * (size_t)(DEGREE); i++) {                        \
      node->children[i] = NULL;                                                \
    }                                                                          \
    return node;                                                               \
  }                                                                            \
                                                                               \
  static inline void GNS3(TBTREE_SET_TYPED(SUFFIX), Internal,                  \
                          DestroyNodes)(BTREE_SET_NODE_TYPE(SUFFIX) * node) {  \
    if (!node)                                                                 \
      return;                                                                  \
    if (!node->isLeaf) {                                                       \
      for (size_t i = 0; i <= node->numKeys; i++) {                            \
        GNS3(TBTREE_SET_TYPED(SUFFIX), Internal,                               \
             DestroyNodes)(node->children[i]);                                 \
      }                                                                        \
    }                                                                          \
    Memory_Free(node);                                                         \
  }                                                                            \
                                                                               \
  static inline size_t GNS3(TBTREE_SET_TYPED(SUFFIX), Internal, FindKeyIndex)( \
      const BTREE_SET_NODE_TYPE(SUFFIX) * node, KEY_TYPE key,                  \
      CMPOUT(*comparator)(KEY_TYPE, KEY_TYPE)) {                               \
    size_t low = 0;                                                            \
    size_t high = node->numKeys;                                               \
    while (low < high) {                                                       \
      size_t mid = low + (high - low) / 2U;                                    \
      if (comparator(node->keys[mid], key) < COMPARISON_EQUAL_CONST) {         \
        low = mid + 1U;                                                        \
      } else {                                                                 \
        high = mid;                                                            \
      }                                                                        \
    }                                                                          \
    return low;                                                                \
  }                                                                            \
                                                                               \
  static inline OPSTATUS GNS3(TBTREE_SET_TYPED(SUFFIX), Internal, SplitChild)( \
      BTREE_SET_NODE_TYPE(SUFFIX) * parent, size_t i,                          \
      BTREE_SET_NODE_TYPE(SUFFIX) * child) {                                   \
    BTREE_SET_NODE_TYPE(SUFFIX) *sibling =                                     \
        GNS3(TBTREE_SET_TYPED(SUFFIX), Internal, CreateNode)(child->isLeaf);   \
    if (!sibling)                                                              \
      return STATUS_CONST(OUT_OF_MEMORY);                                      \
    sibling->parent = parent;                                                  \
    sibling->numKeys = (size_t)(DEGREE) - 1U;                                  \
    for (size_t j = 0; j < (size_t)(DEGREE) - 1U; j++) {                       \
      sibling->keys[j] = child->keys[j + (size_t)(DEGREE)];                    \
    }                                                                          \
    if (!child->isLeaf) {                                                      \
      for (size_t j = 0; j < (size_t)(DEGREE); j++) {                          \
        sibling->children[j] = child->children[j + (size_t)(DEGREE)];          \
        if (sibling->children[j])                                              \
          sibling->children[j]->parent = sibling;                              \
        child->children[j + (size_t)(DEGREE)] = NULL;                          \
      }                                                                        \
    }                                                                          \
    child->numKeys = (size_t)(DEGREE) - 1U;                                    \
    for (size_t j = parent->numKeys + 1U; j > i + 1U; j--) {                   \
      parent->children[j] = parent->children[j - 1U];                          \
    }                                                                          \
    parent->children[i + 1U] = sibling;                                        \
    for (size_t j = parent->numKeys; j > i; j--) {                             \
      parent->keys[j] = parent->keys[j - 1U];                                  \
    }                                                                          \
    parent->keys[i] = child->keys[(size_t)(DEGREE) - 1U];                      \
    parent->numKeys++;                                                         \
    return STATUS_CONST(SUCCESS);                                              \
  }                                                                            \
                                                                               \
  static inline OPSTATUS GNS3(TBTREE_SET_TYPED(SUFFIX), Internal,              \
                              InsertNonFull)(                                  \
      TBTREE_SET_TYPED(SUFFIX) * self, BTREE_SET_NODE_TYPE(SUFFIX) * node,     \
      KEY_TYPE key, CMPOUT(*comparator)(KEY_TYPE, KEY_TYPE)) {                 \
    while (1) {                                                                \
      if (node->isLeaf) {                                                      \
        size_t idx = GNS3(TBTREE_SET_TYPED(SUFFIX), Internal,                  \
                          FindKeyIndex)(node, key, comparator);                \
        for (size_t j = node->numKeys; j > idx; j--) {                         \
          node->keys[j] = node->keys[j - 1U];                                  \
        }                                                                      \
        node->keys[idx] = key;                                                 \
        node->numKeys++;                                                       \
        self->size++;                                                          \
        return STATUS_CONST(SUCCESS);                                          \
      } else {                                                                 \
        size_t idx = GNS3(TBTREE_SET_TYPED(SUFFIX), Internal,                  \
                          FindKeyIndex)(node, key, comparator);                \
        BTREE_SET_NODE_TYPE(SUFFIX) *child = node->children[idx];              \
        if (child->numKeys == 2 * (size_t)(DEGREE) - 1U) {                     \
          OPSTATUS status = GNS3(TBTREE_SET_TYPED(SUFFIX), Internal,           \
                                 SplitChild)(node, idx, child);                \
          if (status != STATUS_CONST(SUCCESS))                                 \
            return status;                                                     \
          if (comparator(key, node->keys[idx]) > COMPARISON_EQUAL_CONST)       \
            idx++;                                                             \
          child = node->children[idx];                                         \
        }                                                                      \
        node = child;                                                          \
      }                                                                        \
    }                                                                          \
  }                                                                            \
                                                                               \
  static inline void GNS3(TBTREE_SET_TYPED(SUFFIX), Internal, BorrowFromPrev)( \
      BTREE_SET_NODE_TYPE(SUFFIX) * parent, size_t idx) {                      \
    BTREE_SET_NODE_TYPE(SUFFIX) *c = parent->children[idx];                    \
    BTREE_SET_NODE_TYPE(SUFFIX) *sibling = parent->children[idx - 1U];         \
    for (size_t j = c->numKeys; j > 0; j--) {                                  \
      c->keys[j] = c->keys[j - 1U];                                            \
    }                                                                          \
    c->keys[0] = parent->keys[idx - 1U];                                       \
    if (!c->isLeaf) {                                                          \
      for (size_t j = c->numKeys + 1U; j > 0; j--) {                           \
        c->children[j] = c->children[j - 1U];                                  \
      }                                                                        \
      c->children[0] = sibling->children[sibling->numKeys];                    \
      if (c->children[0])                                                      \
        c->children[0]->parent = c;                                            \
      sibling->children[sibling->numKeys] = NULL;                              \
    }                                                                          \
    parent->keys[idx - 1U] = sibling->keys[sibling->numKeys - 1U];             \
    c->numKeys++;                                                              \
    sibling->numKeys--;                                                        \
  }                                                                            \
                                                                               \
  static inline void GNS3(TBTREE_SET_TYPED(SUFFIX), Internal, BorrowFromNext)( \
      BTREE_SET_NODE_TYPE(SUFFIX) * parent, size_t idx) {                      \
    BTREE_SET_NODE_TYPE(SUFFIX) *c = parent->children[idx];                    \
    BTREE_SET_NODE_TYPE(SUFFIX) *sibling = parent->children[idx + 1U];         \
    c->keys[c->numKeys] = parent->keys[idx];                                   \
    if (!c->isLeaf) {                                                          \
      c->children[c->numKeys + 1U] = sibling->children[0];                     \
      if (c->children[c->numKeys + 1U])                                        \
        c->children[c->numKeys + 1U]->parent = c;                              \
    }                                                                          \
    parent->keys[idx] = sibling->keys[0];                                      \
    for (size_t j = 0; j + 1U < sibling->numKeys; j++) {                       \
      sibling->keys[j] = sibling->keys[j + 1U];                                \
    }                                                                          \
    if (!sibling->isLeaf) {                                                    \
      for (size_t j = 0; j < sibling->numKeys; j++) {                          \
        sibling->children[j] = sibling->children[j + 1U];                      \
      }                                                                        \
      sibling->children[sibling->numKeys] = NULL;                              \
    }                                                                          \
    c->numKeys++;                                                              \
    sibling->numKeys--;                                                        \
  }                                                                            \
                                                                               \
  static inline void GNS3(TBTREE_SET_TYPED(SUFFIX), Internal, MergeChildren)(  \
      TBTREE_SET_TYPED(SUFFIX) * self, BTREE_SET_NODE_TYPE(SUFFIX) * parent,   \
      size_t idx) {                                                            \
    (void)self;                                                                \
    BTREE_SET_NODE_TYPE(SUFFIX) *c = parent->children[idx];                    \
    BTREE_SET_NODE_TYPE(SUFFIX) *sibling = parent->children[idx + 1U];         \
    c->keys[c->numKeys] = parent->keys[idx];                                   \
    for (size_t j = 0; j < sibling->numKeys; j++) {                            \
      c->keys[c->numKeys + 1U + j] = sibling->keys[j];                         \
    }                                                                          \
    if (!c->isLeaf) {                                                          \
      for (size_t j = 0; j <= sibling->numKeys; j++) {                         \
        c->children[c->numKeys + 1U + j] = sibling->children[j];               \
        if (c->children[c->numKeys + 1U + j])                                  \
          c->children[c->numKeys + 1U + j]->parent = c;                        \
      }                                                                        \
    }                                                                          \
    c->numKeys += 1U + sibling->numKeys;                                       \
    Memory_Free(sibling);                                                      \
    for (size_t j = idx; j + 1U < parent->numKeys; j++) {                      \
      parent->keys[j] = parent->keys[j + 1U];                                  \
    }                                                                          \
    for (size_t j = idx + 1U; j < parent->numKeys; j++) {                      \
      parent->children[j] = parent->children[j + 1U];                          \
    }                                                                          \
    parent->children[parent->numKeys] = NULL;                                  \
    parent->numKeys--;                                                         \
  }                                                                            \
                                                                               \
  static inline void GNS3(TBTREE_SET_TYPED(SUFFIX), Internal, DeleteInternal)( \
      TBTREE_SET_TYPED(SUFFIX) * self, BTREE_SET_NODE_TYPE(SUFFIX) * node,     \
      KEY_TYPE key, CMPOUT(*comparator)(KEY_TYPE, KEY_TYPE)) {                 \
    size_t idx = GNS3(TBTREE_SET_TYPED(SUFFIX), Internal,                      \
                      FindKeyIndex)(node, key, comparator);                    \
    if (idx < node->numKeys &&                                                 \
        comparator(node->keys[idx], key) == COMPARISON_EQUAL_CONST) {          \
      if (node->isLeaf) {                                                      \
        for (size_t j = idx; j + 1U < node->numKeys; j++) {                    \
          node->keys[j] = node->keys[j + 1U];                                  \
        }                                                                      \
        node->numKeys--;                                                       \
      } else {                                                                 \
        BTREE_SET_NODE_TYPE(SUFFIX) *predChild = node->children[idx];          \
        BTREE_SET_NODE_TYPE(SUFFIX) *succChild = node->children[idx + 1U];     \
        if (predChild->numKeys >= (size_t)(DEGREE)) {                          \
          BTREE_SET_NODE_TYPE(SUFFIX) *cur = predChild;                        \
          while (!cur->isLeaf)                                                 \
            cur = cur->children[cur->numKeys];                                 \
          KEY_TYPE predKey = cur->keys[cur->numKeys - 1U];                     \
          node->keys[idx] = predKey;                                           \
          GNS3(TBTREE_SET_TYPED(SUFFIX), Internal,                             \
               DeleteInternal)(self, predChild, predKey, comparator);          \
        } else if (succChild->numKeys >= (size_t)(DEGREE)) {                   \
          BTREE_SET_NODE_TYPE(SUFFIX) *cur = succChild;                        \
          while (!cur->isLeaf)                                                 \
            cur = cur->children[0];                                            \
          KEY_TYPE succKey = cur->keys[0];                                     \
          node->keys[idx] = succKey;                                           \
          GNS3(TBTREE_SET_TYPED(SUFFIX), Internal,                             \
               DeleteInternal)(self, succChild, succKey, comparator);          \
        } else {                                                               \
          BTREE_SET_NODE_TYPE(SUFFIX) *merged = predChild;                     \
          GNS3(TBTREE_SET_TYPED(SUFFIX), Internal, MergeChildren)(self, node,  \
                                                                  idx);        \
          GNS3(TBTREE_SET_TYPED(SUFFIX), Internal,                             \
               DeleteInternal)(self, merged, key, comparator);                 \
        }                                                                      \
      }                                                                        \
    } else {                                                                   \
      if (node->isLeaf)                                                        \
        return;                                                                \
      BTREE_SET_NODE_TYPE(SUFFIX) *child = node->children[idx];                \
      if (child->numKeys < (size_t)(DEGREE)) {                                 \
        BTREE_SET_NODE_TYPE(SUFFIX) *leftSibling =                             \
            (idx > 0) ? node->children[idx - 1U] : NULL;                       \
        BTREE_SET_NODE_TYPE(SUFFIX) *rightSibling =                            \
            (idx < node->numKeys) ? node->children[idx + 1U] : NULL;           \
        if (leftSibling && leftSibling->numKeys >= (size_t)(DEGREE)) {         \
          GNS3(TBTREE_SET_TYPED(SUFFIX), Internal, BorrowFromPrev)(node, idx); \
        } else if (rightSibling &&                                             \
                   rightSibling->numKeys >= (size_t)(DEGREE)) {                \
          GNS3(TBTREE_SET_TYPED(SUFFIX), Internal, BorrowFromNext)(node, idx); \
        } else {                                                               \
          if (idx < node->numKeys) {                                           \
            GNS3(TBTREE_SET_TYPED(SUFFIX), Internal,                           \
                 MergeChildren)(self, node, idx);                              \
            child = node->children[idx];                                       \
          } else {                                                             \
            GNS3(TBTREE_SET_TYPED(SUFFIX), Internal,                           \
                 MergeChildren)(self, node, idx - 1U);                         \
            child = node->children[idx - 1U];                                  \
          }                                                                    \
        }                                                                      \
      }                                                                        \
      GNS3(TBTREE_SET_TYPED(SUFFIX), Internal,                                 \
           DeleteInternal)(self, child, key, comparator);                      \
    }                                                                          \
  }                                                                            \
                                                                               \
  OBJECT_OPERATION_IMPLEMENT_EX(TBTREE_SET_TYPED(SUFFIX), Create, ()) {        \
    if (!self)                                                                 \
      return STATUS_CONST(INVALID_ARGUMENT);                                   \
    self->root = NULL;                                                         \
    self->size = 0U;                                                           \
    self->degree = (size_t)(DEGREE);                                           \
    self->compare = CMP;                                                       \
    return STATUS_CONST(SUCCESS);                                              \
  }                                                                            \
                                                                               \
  OBJECT_OPERATION_IMPLEMENT_EX(                                               \
      TBTREE_SET_TYPED(SUFFIX), CreateWithComparator,                          \
      (CMPOUT(*compare)(KEY_TYPE left, KEY_TYPE right))) {                     \
    if (!self || !compare)                                                     \
      return STATUS_CONST(INVALID_ARGUMENT);                                   \
    self->root = NULL;                                                         \
    self->size = 0U;                                                           \
    self->degree = (size_t)(DEGREE);                                           \
    self->compare = compare;                                                   \
    return STATUS_CONST(SUCCESS);                                              \
  }                                                                            \
                                                                               \
  OBJECT_PREDICATE_IMPLEMENT_EX(TBTREE_SET_TYPED(SUFFIX), Empty, ()) {         \
    return !self || self->size == 0U;                                          \
  }                                                                            \
                                                                               \
  OBJECT_FUNCTION_IMPLEMENT_EX(TBTREE_SET_TYPED(SUFFIX), size_t, Size, ()) {   \
    return self ? self->size : 0U;                                             \
  }                                                                            \
                                                                               \
  OBJECT_FUNCTION_IMPLEMENT_EX(TBTREE_SET_TYPED(SUFFIX), size_t, Height, ()) { \
    if (!self || !self->root)                                                  \
      return 0U;                                                               \
    size_t h = 0U;                                                             \
    const BTREE_SET_NODE_TYPE(SUFFIX) *cur = self->root;                       \
    while (cur) {                                                              \
      h++;                                                                     \
      if (cur->isLeaf)                                                         \
        break;                                                                 \
      cur = cur->children[0];                                                  \
    }                                                                          \
    return h;                                                                  \
  }                                                                            \
                                                                               \
  OBJECT_PREDICATE_IMPLEMENT_EX(TBTREE_SET_TYPED(SUFFIX), Contains,            \
                                (KEY_TYPE key)) {                              \
    if (!self || !self->root)                                                  \
      return false;                                                            \
    CMPOUT (*comparator)(KEY_TYPE, KEY_TYPE) =                                 \
        self->compare ? self->compare : CMP;                                   \
    const BTREE_SET_NODE_TYPE(SUFFIX) *cur = self->root;                       \
    while (cur) {                                                              \
      size_t idx = GNS3(TBTREE_SET_TYPED(SUFFIX), Internal,                    \
                        FindKeyIndex)(cur, key, comparator);                   \
      if (idx < cur->numKeys &&                                                \
          comparator(cur->keys[idx], key) == COMPARISON_EQUAL_CONST)           \
        return true;                                                           \
      if (cur->isLeaf)                                                         \
        break;                                                                 \
      cur = cur->children[idx];                                                \
    }                                                                          \
    return false;                                                              \
  }                                                                            \
                                                                               \
  OBJECT_OPERATION_IMPLEMENT_EX(TBTREE_SET_TYPED(SUFFIX), Find,                \
                                (KEY_TYPE key, KEY_TYPE * *out)) {             \
    if (!self || !out)                                                         \
      return STATUS_CONST(INVALID_ARGUMENT);                                   \
    if (!self->root)                                                           \
      return STATUS_CONST(NOT_FOUND);                                          \
    CMPOUT (*comparator)(KEY_TYPE, KEY_TYPE) =                                 \
        self->compare ? self->compare : CMP;                                   \
    BTREE_SET_NODE_TYPE(SUFFIX) *cur = self->root;                             \
    while (cur) {                                                              \
      size_t idx = GNS3(TBTREE_SET_TYPED(SUFFIX), Internal,                    \
                        FindKeyIndex)(cur, key, comparator);                   \
      if (idx < cur->numKeys &&                                                \
          comparator(cur->keys[idx], key) == COMPARISON_EQUAL_CONST) {         \
        *out = &cur->keys[idx];                                                \
        return STATUS_CONST(SUCCESS);                                          \
      }                                                                        \
      if (cur->isLeaf)                                                         \
        break;                                                                 \
      cur = cur->children[idx];                                                \
    }                                                                          \
    return STATUS_CONST(NOT_FOUND);                                            \
  }                                                                            \
                                                                               \
  OBJECT_OPERATION_IMPLEMENT_EX(TBTREE_SET_TYPED(SUFFIX), Min,                 \
                                (KEY_TYPE * *out)) {                           \
    if (!self || !out)                                                         \
      return STATUS_CONST(INVALID_ARGUMENT);                                   \
    if (!self->root || self->size == 0U)                                       \
      return STATUS_CONST(NOT_FOUND);                                          \
    BTREE_SET_NODE_TYPE(SUFFIX) *cur = self->root;                             \
    while (!cur->isLeaf)                                                       \
      cur = cur->children[0];                                                  \
    *out = &cur->keys[0];                                                      \
    return STATUS_CONST(SUCCESS);                                              \
  }                                                                            \
                                                                               \
  OBJECT_OPERATION_IMPLEMENT_EX(TBTREE_SET_TYPED(SUFFIX), Max,                 \
                                (KEY_TYPE * *out)) {                           \
    if (!self || !out)                                                         \
      return STATUS_CONST(INVALID_ARGUMENT);                                   \
    if (!self->root || self->size == 0U)                                       \
      return STATUS_CONST(NOT_FOUND);                                          \
    BTREE_SET_NODE_TYPE(SUFFIX) *cur = self->root;                             \
    while (!cur->isLeaf)                                                       \
      cur = cur->children[cur->numKeys];                                       \
    *out = &cur->keys[cur->numKeys - 1U];                                      \
    return STATUS_CONST(SUCCESS);                                              \
  }                                                                            \
                                                                               \
  OBJECT_OPERATION_IMPLEMENT_EX(TBTREE_SET_TYPED(SUFFIX), Insert,              \
                                (KEY_TYPE key)) {                              \
    if (!self)                                                                 \
      return STATUS_CONST(INVALID_ARGUMENT);                                   \
    CMPOUT (*comparator)(KEY_TYPE, KEY_TYPE) =                                 \
        self->compare ? self->compare : CMP;                                   \
    if (OBJECT_CALL(self, Contains, key))                                      \
      return STATUS_CONST(ALREADY_EXISTS);                                     \
    if (!self->root) {                                                         \
      BTREE_SET_NODE_TYPE(SUFFIX) *root =                                      \
          GNS3(TBTREE_SET_TYPED(SUFFIX), Internal, CreateNode)(true);          \
      if (!root)                                                               \
        return STATUS_CONST(OUT_OF_MEMORY);                                    \
      root->keys[0] = key;                                                     \
      root->numKeys = 1U;                                                      \
      self->root = root;                                                       \
      self->size = 1U;                                                         \
      self->degree = (size_t)(DEGREE);                                         \
      self->compare = comparator;                                              \
      return STATUS_CONST(SUCCESS);                                            \
    }                                                                          \
    if (self->root->numKeys == 2 * (size_t)(DEGREE) - 1U) {                    \
      BTREE_SET_NODE_TYPE(SUFFIX) *newRoot =                                   \
          GNS3(TBTREE_SET_TYPED(SUFFIX), Internal, CreateNode)(false);         \
      if (!newRoot)                                                            \
        return STATUS_CONST(OUT_OF_MEMORY);                                    \
      newRoot->children[0] = self->root;                                       \
      self->root->parent = newRoot;                                            \
      OPSTATUS status = GNS3(TBTREE_SET_TYPED(SUFFIX), Internal,               \
                             SplitChild)(newRoot, 0U, self->root);             \
      if (status != STATUS_CONST(SUCCESS)) {                                   \
        self->root->parent = NULL;                                             \
        Memory_Free(newRoot);                                                  \
        return status;                                                         \
      }                                                                        \
      self->root = newRoot;                                                    \
