#define BTREE_SET_NODE_TYPE(SUFFIX) GNS2(BTree_Set_Node, SUFFIX)
#define BTREE_SET_CURSOR_TYPE(SUFFIX) GNS2(BTree_Set_Cursor, SUFFIX)

