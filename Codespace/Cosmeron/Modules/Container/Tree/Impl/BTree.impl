                                                                               \
  OBJECT_FUNCTION_IMPLEMENT_EX(TBTREE_SET_TYPED(SUFFIX), bool, CursorNext,     \
                               (BTREE_SET_CURSOR_TYPE(SUFFIX) * cursor)) {     \
    (void)self;                                                                \
    if (!cursor || !cursor->node || cursor->index >= cursor->node->numKeys)    \
      return false;                                                            \
    if (!cursor->node->isLeaf) {                                               \
      BTREE_SET_NODE_TYPE(SUFFIX) *cur =                                       \
          cursor->node->children[cursor->index + 1U];                          \
      while (!cur->isLeaf)                                                     \
        cur = cur->children[0];                                                \
      cursor->node = cur;                                                      \
      cursor->index = 0U;                                                      \
