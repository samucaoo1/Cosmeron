#pragma once

/* =============================================================
 * Iterators — Begin, End, Next, Prev
 * Shared by all algorithms and both set/map semantics.
 * ============================================================= */

#define COSMERON_MACRO_INTERNAL_TREE_IMPLEMENT_ITERATORS(T)                   \
  TREE_BEGIN_PROTOTYPE(T) {                                                    \
    if (!tree)                                                                 \
      return NULL;                                                             \
    return TREE_FUNC(T, MinNode)(tree->root);                                  \
  }                                                                            \
                                                                               \
  TREE_END_PROTOTYPE(T) {                                                      \
    (void)tree;                                                                \
    return NULL;                                                               \
  }                                                                            \
                                                                               \
  TREE_NEXT_PROTOTYPE(T) {                                                     \
    if (!node)                                                                 \
      return NULL;                                                             \
    if (node->right)                                                           \
      return TREE_FUNC(T, MinNode)(node->right);                               \
    TREE_NODE(T) *_p = node->parent;                                           \
    while (_p && node == _p->right) {                                          \
      node = _p;                                                               \
      _p = _p->parent;                                                         \
    }                                                                          \
    return _p;                                                                 \
  }                                                                            \
                                                                               \
  TREE_PREV_PROTOTYPE(T) {                                                     \
    if (!node)                                                                 \
      return NULL;                                                             \
    if (node->left)                                                            \
      return TREE_FUNC(T, MaxNode)(node->left);                                \
    TREE_NODE(T) *_p = node->parent;                                           \
    while (_p && node == _p->left) {                                           \
      node = _p;                                                               \
      _p = _p->parent;                                                         \
    }                                                                          \
    return _p;                                                                 \
  }

#define COSMERON_MACRO_INTERNAL_TREE_IMPLEMENT_CONST_ITERATORS(T)             \
  TREE_CONST_BEGIN_PROTOTYPE(T) {                                              \
    const TREE_NODE(T) *node;                                                  \
    if (!tree)                                                                 \
      return NULL;                                                             \
    node = tree->root;                                                         \
    if (!node)                                                                 \
      return NULL;                                                             \
    while (node->left)                                                         \
      node = node->left;                                                       \
    return node;                                                               \
  }                                                                            \
                                                                               \
  TREE_CONST_END_PROTOTYPE(T) {                                                \
    (void)tree;                                                                \
    return NULL;                                                               \
  }                                                                            \
                                                                               \
  TREE_CONST_NEXT_PROTOTYPE(T) {                                               \
    const TREE_NODE(T) *parent;                                                \
    if (!node)                                                                 \
      return NULL;                                                             \
    if (node->right) {                                                         \
      node = node->right;                                                      \
      while (node->left)                                                       \
        node = node->left;                                                     \
      return node;                                                             \
    }                                                                          \
    parent = node->parent;                                                     \
    while (parent && node == parent->right) {                                  \
      node = parent;                                                           \
      parent = parent->parent;                                                 \
    }                                                                          \
    return parent;                                                             \
  }                                                                            \
                                                                               \
  TREE_CONST_PREV_PROTOTYPE(T) {                                               \
    const TREE_NODE(T) *parent;                                                \
    if (!node)                                                                 \
      return NULL;                                                             \
    if (node->left) {                                                          \
      node = node->left;                                                       \
      while (node->right)                                                      \
        node = node->right;                                                    \
      return node;                                                             \
    }                                                                          \
    parent = node->parent;                                                     \
    while (parent && node == parent->left) {                                   \
      node = parent;                                                           \
      parent = parent->parent;                                                 \
    }                                                                          \
    return parent;                                                             \
  }

/* Compatibility aliases */
#define COSMERON_MACRO_INTERNAL_TTREE_IMPLEMENT_ITERATORS COSMERON_MACRO_INTERNAL_TREE_IMPLEMENT_ITERATORS
#define COSMERON_MACRO_INTERNAL_TTREE_IMPLEMENT_CONST_ITERATORS COSMERON_MACRO_INTERNAL_TREE_IMPLEMENT_CONST_ITERATORS
