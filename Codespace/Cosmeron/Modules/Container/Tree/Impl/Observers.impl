#pragma once

/* =============================================================
 * Observers — FindNode, Contains, MinNode, MaxNode, Min, Max,
 *             Empty, Size
 * Shared by all algorithms.  CMP is baked at compile time.
 *
 * Find is split:
 *   COSMERON_MACRO_INTERNAL_TREE_IMPLEMENT_FIND_SET  → OPSTATUS + KEY_TYPE **out
 *   COSMERON_MACRO_INTERNAL_TREE_IMPLEMENT_FIND_MAP  → OPSTATUS + VALUE_TYPE **out
 * ============================================================= */

#define COSMERON_MACRO_INTERNAL_TREE_IMPLEMENT_OBSERVERS(T, KEY_TYPE, CMP)     \
  TREE_FIND_NODE_PROTOTYPE(T, KEY_TYPE) {                                      \
    if (!tree)                                                                 \
      return NULL;                                                             \
    TREE_NODE(T) *current = tree->root;                                        \
    while (current) {                                                          \
      TREE_CMPOUT _comparison = CMP(key, current->key);                        \
      if (_comparison < COMPARISON_EQUAL_CONST)                                \
        current = current->left;                                               \
      else if (_comparison > COMPARISON_EQUAL_CONST)                           \
        current = current->right;                                              \
      else                                                                     \
        return current;                                                        \
    }                                                                          \
    return NULL;                                                               \
  }                                                                            \
                                                                               \
  TREE_CONTAINS_PROTOTYPE(T, KEY_TYPE) {                                       \
    if (!tree)                                                                 \
      return false;                                                            \
    const TREE_NODE(T) *current = tree->root;                                  \
    while (current) {                                                          \
      TREE_CMPOUT _comparison = CMP(key, current->key);                        \
      if (_comparison < COMPARISON_EQUAL_CONST)                                \
        current = current->left;                                               \
      else if (_comparison > COMPARISON_EQUAL_CONST)                           \
        current = current->right;                                              \
      else                                                                     \
        return true;                                                           \
    }                                                                          \
    return false;                                                              \
  }                                                                            \
                                                                               \
  TREE_MIN_NODE_PROTOTYPE(T) {                                                 \
    if (!node)                                                                 \
      return NULL;                                                             \
    while (node->left)                                                         \
      node = node->left;                                                       \
    return node;                                                               \
  }                                                                            \
                                                                               \
  TREE_MAX_NODE_PROTOTYPE(T) {                                                 \
    if (!node)                                                                 \
      return NULL;                                                             \
    while (node->right)                                                        \
      node = node->right;                                                      \
    return node;                                                               \
  }                                                                            \
                                                                               \
  TREE_MIN_PROTOTYPE(T, KEY_TYPE) {                                            \
    TREE_NODE(T) *node;                                                        \
    if (!tree || !out)                                                         \
      return STATUS_CONST(INVALID_ARGUMENT);                                   \
    node = TREE_FUNC(T, MinNode)(tree->root);                                  \
    if (!node)                                                                 \
      return STATUS_CONST(NOT_FOUND);                                          \
    *out = &node->key;                                                         \
    return STATUS_CONST(SUCCESS);                                              \
  }                                                                            \
                                                                               \
  TREE_MAX_PROTOTYPE(T, KEY_TYPE) {                                            \
    TREE_NODE(T) *node;                                                        \
    if (!tree || !out)                                                         \
      return STATUS_CONST(INVALID_ARGUMENT);                                   \
    node = TREE_FUNC(T, MaxNode)(tree->root);                                  \
    if (!node)                                                                 \
      return STATUS_CONST(NOT_FOUND);                                          \
    *out = &node->key;                                                         \
    return STATUS_CONST(SUCCESS);                                              \
  }                                                                            \
                                                                               \
  TREE_EMPTY_PROTOTYPE(T) {                                                    \
    return tree != NULL && tree->size == 0;                                    \
  }                                                                            \
                                                                               \
  TREE_SIZE_PROTOTYPE(T) {                                                     \
    return tree ? tree->size : 0U;                                             \
  }

/* ------ Find: SET variant (returns KEY_TYPE*) ------ */

#define COSMERON_MACRO_INTERNAL_TREE_IMPLEMENT_FIND_SET(T, KEY_TYPE)          \
  TREE_FIND_SET_PROTOTYPE(T, KEY_TYPE) {                                       \
    TREE_NODE(T) *node;                                                        \
    if (!tree || !out)                                                         \
      return STATUS_CONST(INVALID_ARGUMENT);                                   \
    node = TREE_FUNC(T, FindNode)(tree, key);                                  \
    if (!node)                                                                 \
      return STATUS_CONST(NOT_FOUND);                                          \
    *out = &node->key;                                                         \
    return STATUS_CONST(SUCCESS);                                              \
  }

/* ------ Find: MAP variant (returns VALUE_TYPE*) ------ */

#define COSMERON_MACRO_INTERNAL_TREE_IMPLEMENT_FIND_MAP(T, KEY_TYPE, VALUE_TYPE) \
  TREE_FIND_MAP_PROTOTYPE(T, KEY_TYPE, VALUE_TYPE) {                           \
    TREE_NODE(T) *node;                                                        \
    if (!tree || !out)                                                         \
      return STATUS_CONST(INVALID_ARGUMENT);                                   \
    node = TREE_FUNC(T, FindNode)(tree, key);                                  \
    if (!node)                                                                 \
      return STATUS_CONST(NOT_FOUND);                                          \
    *out = &node->value;                                                       \
    return STATUS_CONST(SUCCESS);                                              \
  }

/* Compatibility aliases */
#define COSMERON_MACRO_INTERNAL_TTREE_IMPLEMENT_OBSERVERS COSMERON_MACRO_INTERNAL_TREE_IMPLEMENT_OBSERVERS
#define COSMERON_MACRO_INTERNAL_TTREE_IMPLEMENT_FIND_SET COSMERON_MACRO_INTERNAL_TREE_IMPLEMENT_FIND_SET
#define COSMERON_MACRO_INTERNAL_TTREE_IMPLEMENT_FIND_MAP COSMERON_MACRO_INTERNAL_TREE_IMPLEMENT_FIND_MAP
