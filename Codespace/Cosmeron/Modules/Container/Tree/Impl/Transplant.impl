#pragma once

/* =============================================================
 * Modifiers — Transplant
 * Shared by all algorithms and both set/map semantics.
 * ============================================================= */

#define COSMERON_MACRO_INTERNAL_TREE_IMPLEMENT_TRANSPLANT(T)                  \
  static inline void TREE_FUNC(T, Transplant)(                                 \
      T * tree, TREE_NODE(T) * u, TREE_NODE(T) * v) {                          \
    if (!u->parent)                                                            \
      tree->root = v;                                                          \
    else if (u == u->parent->left)                                             \
      u->parent->left = v;                                                     \
    else                                                                       \
      u->parent->right = v;                                                    \
    if (v)                                                                     \
      v->parent = u->parent;                                                   \
  }

#define COSMERON_MACRO_INTERNAL_TTREE_IMPLEMENT_TRANSPLANT(T)                 \
  COSMERON_MACRO_INTERNAL_TREE_IMPLEMENT_TRANSPLANT(T)
