#pragma once

#include "../Container.space"

#include "../../../Core/Algorithm/Comparison.h"
#include "../../../Core/Error/Status.h"
#include "../../../Core/Memory/Alloc.h"
#include "../../../Core/Memory/Swap.h"
#include "../../../Core/Namespace.h"
#include <stdbool.h>
#include <stddef.h>
#include <stdint.h>
#include <stdlib.h>

/* =============================================================
 * Namespace base
 * ============================================================= */

#define TREE_NS(NAME) GNS2(CONTAINER_NS(Tree), NAME)

/* =============================================================
 * Name generators
 *   TTREE_SET_TYPE(AVL, int)       → Tree_AVL_Set_int
 *   TTREE_MAP_TYPE(AVL, int, char) → Tree_AVL_Map_int_char
 *   TTREE_NODE(T)                  → T_Node
 *   TTREE_FN(T, Insert)            → T_Insert
 * ============================================================= */

#define TTREE_SET_TYPE(ALG, KEY) \
  GNS2(GNS2(TREE_NS(ALG), Set), KEY)

#define TTREE_MAP_TYPE(ALG, KEY, VAL) \
  GNS2(GNS2(GNS2(TREE_NS(ALG), Map), KEY), VAL)

#define TTREE_PUBLIC_SET_TYPE(ALG, KEY) \
  GNS2(GNS2(TREE_NS(ALG), TSet), KEY)

#define TTREE_PUBLIC_MAP_TYPE(ALG, KEY, VAL) \
  GNS2(GNS2(GNS2(TREE_NS(ALG), TMap), KEY), VAL)

#define TTREE_NODE(T) GNS2(T, Node)

#define TTREE_FN(T, FUNC) PP_OP_CAT2(PP_OP_CAT2(T, _), FUNC)
#define TTREE_FUNCTION_TABLE_TYPE(T) GNS2(T, FunctionTable)


/* =============================================================
 * Operation prototypes
 * ============================================================= */

#define TTREE_INIT_PROTOTYPE(T)                                               \
  static inline OPSTATUS TTREE_FN(T, Init)(T *tree)
#define TTREE_DESTROY_PROTOTYPE(T)                                            \
  static inline void TTREE_FN(T, Destroy)(T *tree)
#define TTREE_CLEAR_PROTOTYPE(T)                                              \
  static inline void TTREE_FN(T, Clear)(T *tree)
#define TTREE_INSERT_SET_PROTOTYPE(T, KEY_TYPE)                               \
  static inline OPSTATUS TTREE_FN(T, Insert)(T *tree, KEY_TYPE key)
#define TTREE_INSERT_MAP_PROTOTYPE(T, KEY_TYPE, VALUE_TYPE)                   \
  static inline OPSTATUS TTREE_FN(T, Insert)(                                 \
      T *tree, KEY_TYPE key, VALUE_TYPE value)
#define TTREE_REMOVE_PROTOTYPE(T, KEY_TYPE)                                   \
  static inline OPSTATUS TTREE_FN(T, Remove)(T *tree, KEY_TYPE key)
#define TTREE_FIND_NODE_PROTOTYPE(T, KEY_TYPE)                                \
  static inline TTREE_NODE(T) *TTREE_FN(T, FindNode)(T *tree, KEY_TYPE key)
#define TTREE_FIND_SET_PROTOTYPE(T, KEY_TYPE)                                 \
  static inline OPSTATUS TTREE_FN(T, Find)(                                   \
      T *tree, KEY_TYPE key, KEY_TYPE **out)
#define TTREE_FIND_MAP_PROTOTYPE(T, KEY_TYPE, VALUE_TYPE)                     \
  static inline OPSTATUS TTREE_FN(T, Find)(                                   \
      T *tree, KEY_TYPE key, VALUE_TYPE **out)
#define TTREE_CONTAINS_PROTOTYPE(T, KEY_TYPE)                                 \
  static inline bool TTREE_FN(T, Contains)(const T *tree, KEY_TYPE key)
#define TTREE_MIN_NODE_PROTOTYPE(T)                                           \
  static inline TTREE_NODE(T) *TTREE_FN(T, MinNode)(TTREE_NODE(T) *node)
#define TTREE_MAX_NODE_PROTOTYPE(T)                                           \
  static inline TTREE_NODE(T) *TTREE_FN(T, MaxNode)(TTREE_NODE(T) *node)
#define TTREE_MIN_PROTOTYPE(T, KEY_TYPE)                                      \
  static inline OPSTATUS TTREE_FN(T, Min)(T *tree, KEY_TYPE **out)
#define TTREE_MAX_PROTOTYPE(T, KEY_TYPE)                                      \
  static inline OPSTATUS TTREE_FN(T, Max)(T *tree, KEY_TYPE **out)
#define TTREE_EMPTY_PROTOTYPE(T)                                              \
  static inline bool TTREE_FN(T, Empty)(const T *tree)
#define TTREE_SIZE_PROTOTYPE(T)                                               \
  static inline size_t TTREE_FN(T, Size)(const T *tree)
#define TTREE_BEGIN_PROTOTYPE(T)                                              \
  static inline TTREE_NODE(T) *TTREE_FN(T, Begin)(T *tree)
#define TTREE_END_PROTOTYPE(T)                                                \
  static inline TTREE_NODE(T) *TTREE_FN(T, End)(T *tree)
#define TTREE_NEXT_PROTOTYPE(T)                                               \
  static inline TTREE_NODE(T) *TTREE_FN(T, Next)(TTREE_NODE(T) *node)
#define TTREE_PREV_PROTOTYPE(T)                                               \
  static inline TTREE_NODE(T) *TTREE_FN(T, Prev)(TTREE_NODE(T) *node)
#define TTREE_CONST_BEGIN_PROTOTYPE(T)                                        \
  static inline const TTREE_NODE(T) *TTREE_FN(T, ConstBegin)(const T *tree)
#define TTREE_CONST_END_PROTOTYPE(T)                                          \
  static inline const TTREE_NODE(T) *TTREE_FN(T, ConstEnd)(const T *tree)
#define TTREE_CONST_NEXT_PROTOTYPE(T)                                         \
  static inline const TTREE_NODE(T) *TTREE_FN(T, ConstNext)(                  \
      const TTREE_NODE(T) *node)
#define TTREE_CONST_PREV_PROTOTYPE(T)                                         \
  static inline const TTREE_NODE(T) *TTREE_FN(T, ConstPrev)(                  \
      const TTREE_NODE(T) *node)

#define TTREE_SET_PROTOTYPES(T, KEY_TYPE)                                     \
  TTREE_INIT_PROTOTYPE(T);                                                    \
  TTREE_DESTROY_PROTOTYPE(T);                                                 \
  TTREE_CLEAR_PROTOTYPE(T);                                                   \
  TTREE_INSERT_SET_PROTOTYPE(T, KEY_TYPE);                                    \
  TTREE_REMOVE_PROTOTYPE(T, KEY_TYPE);                                        \
  TTREE_FIND_NODE_PROTOTYPE(T, KEY_TYPE);                                     \
  TTREE_FIND_SET_PROTOTYPE(T, KEY_TYPE);                                      \
  TTREE_CONTAINS_PROTOTYPE(T, KEY_TYPE);                                      \
  TTREE_MIN_NODE_PROTOTYPE(T);                                                \
  TTREE_MAX_NODE_PROTOTYPE(T);                                                \
  TTREE_MIN_PROTOTYPE(T, KEY_TYPE);                                           \
  TTREE_MAX_PROTOTYPE(T, KEY_TYPE);                                           \
  TTREE_EMPTY_PROTOTYPE(T);                                                   \
  TTREE_SIZE_PROTOTYPE(T);                                                    \
  TTREE_BEGIN_PROTOTYPE(T);                                                   \
  TTREE_END_PROTOTYPE(T);                                                     \
  TTREE_NEXT_PROTOTYPE(T);                                                    \
  TTREE_PREV_PROTOTYPE(T);                                                    \
  TTREE_CONST_BEGIN_PROTOTYPE(T);                                             \
  TTREE_CONST_END_PROTOTYPE(T);                                               \
  TTREE_CONST_NEXT_PROTOTYPE(T);                                              \
  TTREE_CONST_PREV_PROTOTYPE(T);

#define TTREE_MAP_PROTOTYPES(T, KEY_TYPE, VALUE_TYPE)                         \
  TTREE_INIT_PROTOTYPE(T);                                                    \
  TTREE_DESTROY_PROTOTYPE(T);                                                 \
  TTREE_CLEAR_PROTOTYPE(T);                                                   \
  TTREE_INSERT_MAP_PROTOTYPE(T, KEY_TYPE, VALUE_TYPE);                        \
  TTREE_REMOVE_PROTOTYPE(T, KEY_TYPE);                                        \
  TTREE_FIND_NODE_PROTOTYPE(T, KEY_TYPE);                                     \
  TTREE_FIND_MAP_PROTOTYPE(T, KEY_TYPE, VALUE_TYPE);                          \
  TTREE_CONTAINS_PROTOTYPE(T, KEY_TYPE);                                      \
  TTREE_MIN_NODE_PROTOTYPE(T);                                                \
  TTREE_MAX_NODE_PROTOTYPE(T);                                                \
  TTREE_MIN_PROTOTYPE(T, KEY_TYPE);                                           \
  TTREE_MAX_PROTOTYPE(T, KEY_TYPE);                                           \
  TTREE_EMPTY_PROTOTYPE(T);                                                   \
  TTREE_SIZE_PROTOTYPE(T);                                                    \
  TTREE_BEGIN_PROTOTYPE(T);                                                   \
  TTREE_END_PROTOTYPE(T);                                                     \
  TTREE_NEXT_PROTOTYPE(T);                                                    \
  TTREE_PREV_PROTOTYPE(T);                                                    \
  TTREE_CONST_BEGIN_PROTOTYPE(T);                                             \
  TTREE_CONST_END_PROTOTYPE(T);                                               \
  TTREE_CONST_NEXT_PROTOTYPE(T);                                              \
  TTREE_CONST_PREV_PROTOTYPE(T);

/* =============================================================
 * Comparator output type — default is int.
 * Override by defining TTREE_CMPOUT before including the algorithm.
 * ============================================================= */

#ifndef TTREE_CMPOUT
#define TTREE_CMPOUT CMPOUT
#endif

/* =============================================================
 * One-liner: declare + bind FunctionTable + init.
 *
 *   TREE_SET_DECLARE(AVL, int, s)   ->   TTREE_SET_TYPE(AVL, int) s = {
 *                                .api = &TTREE_FN(..., functions),
 *                                .root = NULL, .size = 0
 *                              };
 *   TREE_MAP_DECLARE(AVL, int, int, m)
 * ============================================================= */

#define TREE_SET_DECLARE(ALG, KEY, NAME)                                                  \
  TTREE_SET_TYPE(ALG, KEY) NAME = {                                             \
      CONTAINER_API_INITIALIZER(TTREE_FN(TTREE_SET_TYPE(ALG, KEY), functions))                    \
      .root = NULL,                                                             \
      .size = 0,                                                                \
  }

#define TREE_MAP_DECLARE(ALG, KEY, VAL, NAME)                                             \
  TTREE_MAP_TYPE(ALG, KEY, VAL) NAME = {                                        \
      CONTAINER_API_INITIALIZER(                                              \
          TTREE_FN(TTREE_MAP_TYPE(ALG, KEY, VAL), functions))               \
      .root = NULL,                                                             \
      .size = 0,                                                                \
  }

/* =============================================================
 * FunctionTable structs — declared here (in the public header) so
 * that code using the tree can take a pointer to the FunctionTable
 * typedef without including the FunctionTable header file.
 *
 *   TTREE_FUNCTION_TABLE_STRUCT_SET(T, KEY_TYPE)
 *     -> typedef struct T_FunctionTable { ... } T_FunctionTable;
 *   TTREE_FUNCTION_TABLE_STRUCT_MAP(T, KEY_TYPE, VALUE_TYPE)
 *     -> same, for MAP.
 *
 * The matching `*_INSTANCE` macros (the static const function tables
 * themselves) live in FunctionTable/Tree.h.
 * ============================================================= */

#if COSMERON_MACRO_INTERNAL_CONTAINER_FUNCTION_TABLE_ENABLED

#define TTREE_FUNCTION_TABLE_STRUCT_SET(T, KEY_TYPE)                                          \
  typedef struct TTREE_FUNCTION_TABLE_TYPE(T) {                               \
    OPSTATUS (*init)(T *);                                                     \
    void (*destroy)(T *);                                                      \
    void (*clear)(T *);                                                        \
    OPSTATUS (*insert)(T *, KEY_TYPE);                                         \
    OPSTATUS (*remove)(T *, KEY_TYPE);                                         \
    TTREE_NODE(T) * (*findNode)(T *, KEY_TYPE);                               \
    OPSTATUS (*find)(T *, KEY_TYPE, KEY_TYPE **);                                      \
    bool (*contains)(const T *, KEY_TYPE);                                           \
    TTREE_NODE(T) * (*minNode)(TTREE_NODE(T) *);                              \
    TTREE_NODE(T) * (*maxNode)(TTREE_NODE(T) *);                              \
    OPSTATUS (*min)(T *, KEY_TYPE **);                                                     \
    OPSTATUS (*max)(T *, KEY_TYPE **);                                                     \
    bool (*empty)(const T *);                                                        \
    size_t (*size)(const T *);                                                       \
    TTREE_NODE(T) * (*begin)(T *);                                             \
    TTREE_NODE(T) * (*end)(T *);                                               \
    TTREE_NODE(T) * (*next)(TTREE_NODE(T) *);                                  \
    TTREE_NODE(T) * (*prev)(TTREE_NODE(T) *);                                  \
    const TTREE_NODE(T) *(*constBegin)(const T *);                             \
    const TTREE_NODE(T) *(*constEnd)(const T *);                               \
    const TTREE_NODE(T) *(*constNext)(const TTREE_NODE(T) *);                  \
    const TTREE_NODE(T) *(*constPrev)(const TTREE_NODE(T) *);                  \
  } TTREE_FUNCTION_TABLE_TYPE(T);

#define TTREE_FUNCTION_TABLE_STRUCT_MAP(T, KEY_TYPE, VALUE_TYPE)                              \
  typedef struct TTREE_FUNCTION_TABLE_TYPE(T) {                               \
    OPSTATUS (*init)(T *);                                                     \
    void (*destroy)(T *);                                                      \
    void (*clear)(T *);                                                        \
    OPSTATUS (*insert)(T *, KEY_TYPE, VALUE_TYPE);                             \
    OPSTATUS (*remove)(T *, KEY_TYPE);                                         \
    TTREE_NODE(T) * (*findNode)(T *, KEY_TYPE);                               \
    OPSTATUS (*find)(T *, KEY_TYPE, VALUE_TYPE **);                                  \
    bool (*contains)(const T *, KEY_TYPE);                                           \
    TTREE_NODE(T) * (*minNode)(TTREE_NODE(T) *);                              \
    TTREE_NODE(T) * (*maxNode)(TTREE_NODE(T) *);                              \
    OPSTATUS (*min)(T *, KEY_TYPE **);                                                     \
    OPSTATUS (*max)(T *, KEY_TYPE **);                                                     \
    bool (*empty)(const T *);                                                        \
    size_t (*size)(const T *);                                                       \
    TTREE_NODE(T) * (*begin)(T *);                                             \
    TTREE_NODE(T) * (*end)(T *);                                               \
    TTREE_NODE(T) * (*next)(TTREE_NODE(T) *);                                  \
    TTREE_NODE(T) * (*prev)(TTREE_NODE(T) *);                                  \
    const TTREE_NODE(T) *(*constBegin)(const T *);                             \
    const TTREE_NODE(T) *(*constEnd)(const T *);                               \
    const TTREE_NODE(T) *(*constNext)(const TTREE_NODE(T) *);                  \
    const TTREE_NODE(T) *(*constPrev)(const TTREE_NODE(T) *);                  \
  } TTREE_FUNCTION_TABLE_TYPE(T);

#else
#define TTREE_FUNCTION_TABLE_STRUCT_SET(...)
#define TTREE_FUNCTION_TABLE_STRUCT_MAP(...)
#endif

#include "FunctionTable/Tree.h"
