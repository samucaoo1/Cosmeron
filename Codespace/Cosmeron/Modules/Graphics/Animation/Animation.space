#pragma once
#include "../../../Core/Namespace.h"
#include "../../../Core/Error/Status.h"
#include <stdbool.h>
#include <stddef.h>
#include <stdint.h>

#define ANIMATION_MOD Animation
#define ANIMATION_CMOD ANIMATION
#define ANIMATION_NS(NAME) GNS2(LIB_PREFIX(ANIMATION_MOD), NAME)
#define ANIMATION_CNS(NAME) CNS2(LIB_PREFIX_CONST(ANIMATION_CMOD), NAME)
#define ANIMATION_INS(NAME) GNS3(LIB_PREFIX(ANIMATION_MOD), Internal, NAME)
#define ANIMATION_TYPE(NAME) ANIMATION_NS(NAME)
#define ANIMATION_FUNC(NAME) ANIMATION_NS(NAME)
#define ANIMATION_CONST(NAME) ANIMATION_CNS(NAME)

typedef enum ANIMATION_TYPE(EasingKind) {
  ANIMATION_CONST(EASING_LINEAR),
  ANIMATION_CONST(EASING_IN_QUAD),
  ANIMATION_CONST(EASING_OUT_QUAD),
  ANIMATION_CONST(EASING_IN_OUT_QUAD),
  ANIMATION_CONST(EASING_IN_CUBIC),
  ANIMATION_CONST(EASING_OUT_CUBIC),
  ANIMATION_CONST(EASING_IN_OUT_CUBIC),
  ANIMATION_CONST(EASING_IN_SINE),
  ANIMATION_CONST(EASING_OUT_SINE),
  ANIMATION_CONST(EASING_IN_OUT_SINE),
  ANIMATION_CONST(EASING_IN_BOUNCE),
  ANIMATION_CONST(EASING_OUT_BOUNCE),
  ANIMATION_CONST(EASING_IN_OUT_BOUNCE),
  ANIMATION_CONST(EASING_IN_ELASTIC),
  ANIMATION_CONST(EASING_OUT_ELASTIC),
  ANIMATION_CONST(EASING_IN_OUT_ELASTIC)
} ANIMATION_TYPE(EasingKind);
