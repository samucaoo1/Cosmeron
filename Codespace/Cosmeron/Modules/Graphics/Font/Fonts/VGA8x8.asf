#pragma once
/*
 * VGA8x8.asf -- printable ASCII glyphs from font8x8_basic.h (U+0020..U+007E).
 *
 * Source: https://github.com/dhepper/font8x8/blob/8e279d2d864e79128e96188a6b9526cfa3fbfef9/font8x8_basic.h
 * Source author: Daniel Hepper; original bitmap author: Marcel Sondaar.
 * Source states explicitly: "License: Public Domain".
 * Adaptation: each set bit becomes '#', unset bit becomes ' ' (8x8).
 *
 * This is a C11 includeable font definition, NOT a textual .flf/.asf parser
 * input. It needs no script at build time and no runtime file access.
 */
