#pragma once
#include "../../../Core/Namespace.h"
#include "../../../Core/Error/Status.h"
#include <stdbool.h>
#include <stddef.h>
#include <stdint.h>

#define GRADIENT_MOD Gradient
#define GRADIENT_CMOD GRADIENT
#define GRADIENT_NS(NAME) GNS2(LIB_PREFIX(GRADIENT_MOD), NAME)
#define GRADIENT_CNS(NAME) CNS2(LIB_PREFIX_CONST(GRADIENT_CMOD), NAME)
#define GRADIENT_INS(NAME) GNS3(LIB_PREFIX(GRADIENT_MOD), Internal, NAME)
#define GRADIENT_TYPE(NAME) GRADIENT_NS(NAME)
#define GRADIENT_FUNC(NAME) GRADIENT_NS(NAME)
#define GRADIENT_CONST(NAME) GRADIENT_CNS(NAME)

typedef struct GRADIENT_TYPE(TColorStop) {
  float position; /* normalized [0.0f, 1.0f] */
  uint32_t color; /* 0xAARRGGBB */
} GRADIENT_TYPE(TColorStop);
