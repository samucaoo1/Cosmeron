#pragma once
#include "../../Core/Namespace.h"
#include "../../Core/Error/Status.h"
#include "../Struct/TPair.h"
#include <stdbool.h>
#include <float.h>
#include <stddef.h>
#include <stdint.h>
#include <string.h>
#include <stdlib.h>

#define INPUT_MOD Input
#define INPUT_CMOD INPUT
#ifndef INPUT_NS
#define INPUT_NS(NAME) GNS2(LIB_PREFIX(INPUT_MOD), NAME)
#endif
#define INPUT_CNS(NAME) CNS2(LIB_PREFIX_CONST(INPUT_CMOD), NAME)
#define INPUT_INS(NAME) GNS3(LIB_PREFIX(INPUT_MOD), Internal, NAME)
#define INPUT_TYPE(NAME) INPUT_NS(NAME)
#define INPUT_FUNC(NAME) INPUT_NS(NAME)
#define INPUT_CONST(NAME) INPUT_CNS(NAME)

#define INPUT_KEYBOARD_FUNC(NAME) GNS2(INPUT_NS(Keyboard), NAME)

#define INPUT_MOUSE_FUNC(NAME) GNS2(INPUT_NS(Mouse), NAME)

#define INPUT_CONTROLLER_FUNC(NAME) GNS2(INPUT_NS(Controller), NAME)

#define INPUT_GAMEPAD_FUNC(NAME) GNS2(INPUT_NS(Gamepad), NAME)

#define INPUT_EVENT_FUNC(NAME) GNS2(INPUT_NS(Event), NAME)

#ifndef INPUT_EVENT_CAPACITY
#define INPUT_EVENT_CAPACITY 256
#endif
#ifndef INPUT_DEVICE_CAPACITY
#define INPUT_DEVICE_CAPACITY 32
#endif
_Static_assert(INPUT_EVENT_CAPACITY > 0, "Input event capacity must be positive");
_Static_assert(INPUT_DEVICE_CAPACITY > 0, "Input device capacity must be positive");
enum {
  INPUT_CONST(MAX_BUTTONS) = 128,
  INPUT_CONST(MAX_AXES) = 64,
  INPUT_CONST(MAX_HATS) = 4,
  INPUT_CONST(NAME_CAPACITY) = 128
};
#include "Internal/Keys.inc"
typedef enum INPUT_TYPE(Key) {
#define COSMERON_INPUT_KEY_ENUM(NAME, LINUX, WINDOWS) LIB_PREFIX_CONST(NAME),
  COSMERON_INPUT_KEY_TABLE(COSMERON_INPUT_KEY_ENUM)
#undef COSMERON_INPUT_KEY_ENUM
  LIB_PREFIX_CONST(INPUT_KEY_COUNT)
} INPUT_TYPE(Key);

typedef uint32_t INPUT_TYPE(Capabilities);
typedef enum INPUT_TYPE(CaptureMode) {
  INPUT_CONST(CAPTURE_NATIVE), INPUT_CONST(CAPTURE_APPLICATION)
} INPUT_TYPE(CaptureMode);
enum {
  INPUT_CONST(CAPABILITY_KEYBOARD) = 1u << 0,
  INPUT_CONST(CAPABILITY_PHYSICAL_KEYS) = 1u << 1,
  INPUT_CONST(CAPABILITY_LOGICAL_KEYS) = 1u << 2,
  INPUT_CONST(CAPABILITY_MOUSE_BUTTONS) = 1u << 3,
  INPUT_CONST(CAPABILITY_POINTER_POSITION) = 1u << 4,
  INPUT_CONST(CAPABILITY_RAW_MOTION) = 1u << 5,
  INPUT_CONST(CAPABILITY_SCROLL) = 1u << 6,
  INPUT_CONST(CAPABILITY_PRECISE_SCROLL) = 1u << 7,
  INPUT_CONST(CAPABILITY_CONTROLLERS) = 1u << 8,
  INPUT_CONST(CAPABILITY_APPLICATION_EVENTS) = 1u << 9
};

typedef uint64_t INPUT_TYPE(ControllerId);
typedef uint32_t INPUT_TYPE(Modifiers);
enum {
  INPUT_CONST(MODIFIER_SHIFT) = 1u << 0,
  INPUT_CONST(MODIFIER_CONTROL) = 1u << 1,
  INPUT_CONST(MODIFIER_ALT) = 1u << 2,
  INPUT_CONST(MODIFIER_SUPER) = 1u << 3
};
typedef enum INPUT_TYPE(MouseButton) {
  INPUT_CONST(MOUSE_BUTTON_LEFT), INPUT_CONST(MOUSE_BUTTON_RIGHT),
  INPUT_CONST(MOUSE_BUTTON_MIDDLE), INPUT_CONST(MOUSE_BUTTON_SIDE),
  INPUT_CONST(MOUSE_BUTTON_EXTRA), INPUT_CONST(MOUSE_BUTTON_COUNT)
} INPUT_TYPE(MouseButton);
typedef enum INPUT_TYPE(Hat) {
  INPUT_CONST(HAT_CENTERED) = 0,
  INPUT_CONST(HAT_UP) = 1u << 0, INPUT_CONST(HAT_DOWN) = 1u << 1,
  INPUT_CONST(HAT_LEFT) = 1u << 2, INPUT_CONST(HAT_RIGHT) = 1u << 3
} INPUT_TYPE(Hat);
typedef enum INPUT_TYPE(GamepadButton) {
  INPUT_CONST(GAMEPAD_BUTTON_SOUTH),
  INPUT_CONST(GAMEPAD_BUTTON_EAST),
  INPUT_CONST(GAMEPAD_BUTTON_WEST),
  INPUT_CONST(GAMEPAD_BUTTON_NORTH),
  INPUT_CONST(GAMEPAD_BUTTON_LEFT_SHOULDER),
  INPUT_CONST(GAMEPAD_BUTTON_RIGHT_SHOULDER),
  INPUT_CONST(GAMEPAD_BUTTON_LEFT_STICK),
  INPUT_CONST(GAMEPAD_BUTTON_RIGHT_STICK),
  INPUT_CONST(GAMEPAD_BUTTON_BACK),
  INPUT_CONST(GAMEPAD_BUTTON_START),
  INPUT_CONST(GAMEPAD_BUTTON_GUIDE),
  INPUT_CONST(GAMEPAD_BUTTON_UP),
  INPUT_CONST(GAMEPAD_BUTTON_DOWN),
  INPUT_CONST(GAMEPAD_BUTTON_LEFT),
  INPUT_CONST(GAMEPAD_BUTTON_RIGHT),
  INPUT_CONST(GAMEPAD_BUTTON_COUNT)
} INPUT_TYPE(GamepadButton);
typedef enum INPUT_TYPE(GamepadAxis) {
  INPUT_CONST(GAMEPAD_AXIS_LEFT_X),
  INPUT_CONST(GAMEPAD_AXIS_LEFT_Y),
  INPUT_CONST(GAMEPAD_AXIS_RIGHT_X),
  INPUT_CONST(GAMEPAD_AXIS_RIGHT_Y),
  INPUT_CONST(GAMEPAD_AXIS_LEFT_TRIGGER),
  INPUT_CONST(GAMEPAD_AXIS_RIGHT_TRIGGER),
  INPUT_CONST(GAMEPAD_AXIS_COUNT)
} INPUT_TYPE(GamepadAxis);
typedef enum INPUT_TYPE(EventType) {
  INPUT_CONST(EVENT_KEY_PRESS),
  INPUT_CONST(EVENT_KEY_RELEASE),
  INPUT_CONST(EVENT_KEY_REPEAT),
  INPUT_CONST(EVENT_MOUSE_BUTTON_PRESS),
  INPUT_CONST(EVENT_MOUSE_BUTTON_RELEASE),
  INPUT_CONST(EVENT_MOUSE_MOVE),
  INPUT_CONST(EVENT_MOUSE_SCROLL),
  INPUT_CONST(EVENT_CONTROLLER_BUTTON_PRESS),
  INPUT_CONST(EVENT_CONTROLLER_BUTTON_RELEASE),
  INPUT_CONST(EVENT_CONTROLLER_AXIS),
  INPUT_CONST(EVENT_CONTROLLER_HAT),
  INPUT_CONST(EVENT_DEVICE_CONNECTED),
  INPUT_CONST(EVENT_DEVICE_DISCONNECTED),
  INPUT_CONST(EVENT_DEVICE_RESET),
  INPUT_CONST(EVENT_MOUSE_POSITION),
  INPUT_CONST(EVENT_FOCUS_GAINED),
  INPUT_CONST(EVENT_FOCUS_LOST),
  INPUT_CONST(EVENT_SOURCE_REMOVED),
} INPUT_TYPE(EventType);
typedef struct INPUT_TYPE(TEvent) {
  INPUT_TYPE(EventType) type;
  INPUT_TYPE(ControllerId) controller; /* zero for keyboard/mouse */
  uint64_t sequence;
  uint32_t source; /* application device slot, independent of controller ID */
  INPUT_TYPE(Key) physicalKey; /* UNKNOWN if unavailable */
  union {
    INPUT_TYPE(Key) key;
    INPUT_TYPE(MouseButton) mouseButton;
    TPAIR_TYPE(float) motion; /* displacement, not absolute position */
    uint32_t button;
    struct { uint32_t index; float value; } axis;
    struct { uint32_t index; INPUT_TYPE(Hat) value; } hat;
  } data;
} INPUT_TYPE(TEvent);
