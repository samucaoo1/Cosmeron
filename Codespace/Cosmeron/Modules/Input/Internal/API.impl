#pragma once
INPUT_UPDATE_PROTOTYPE {
  INPUT_INS(Begin)();
  return INPUT_INS(BackendUpdate)();
}
INPUT_KEYBOARD_IS_DOWN_PROTOTYPE {
  return key > LIB_PREFIX_CONST(INPUT_KEY_UNKNOWN) && key < LIB_PREFIX_CONST(INPUT_KEY_COUNT) && INPUT_INS(state).keys[key].down;
}
INPUT_KEYBOARD_IS_PRESSED_PROTOTYPE {
  return key > LIB_PREFIX_CONST(INPUT_KEY_UNKNOWN) && key < LIB_PREFIX_CONST(INPUT_KEY_COUNT) && INPUT_INS(state).keys[key].pressed;
}
INPUT_KEYBOARD_IS_RELEASED_PROTOTYPE {
  return key > LIB_PREFIX_CONST(INPUT_KEY_UNKNOWN) && key < LIB_PREFIX_CONST(INPUT_KEY_COUNT) && INPUT_INS(state).keys[key].released;
}
INPUT_KEYBOARD_IS_REPEATED_PROTOTYPE {
  return key > LIB_PREFIX_CONST(INPUT_KEY_UNKNOWN) && key < LIB_PREFIX_CONST(INPUT_KEY_COUNT) && INPUT_INS(state).keys[key].repeated;
}
INPUT_MOUSE_IS_DOWN_PROTOTYPE {
  return button >= 0 && button < INPUT_CONST(MOUSE_BUTTON_COUNT) && INPUT_INS(state).mouse[button].down;
}
INPUT_MOUSE_IS_PRESSED_PROTOTYPE {
  return button >= 0 && button < INPUT_CONST(MOUSE_BUTTON_COUNT) && INPUT_INS(state).mouse[button].pressed;
}
INPUT_MOUSE_IS_RELEASED_PROTOTYPE {
  return button >= 0 && button < INPUT_CONST(MOUSE_BUTTON_COUNT) && INPUT_INS(state).mouse[button].released;
}
INPUT_KEYBOARD_GET_MODIFIERS_PROTOTYPE {
  INPUT_TYPE(Modifiers) modifiers = 0;
  if (INPUT_KEYBOARD_FUNC(IsDown)(LIB_PREFIX_CONST(INPUT_KEY_LEFT_SHIFT)) || INPUT_KEYBOARD_FUNC(IsDown)(LIB_PREFIX_CONST(INPUT_KEY_RIGHT_SHIFT))) modifiers |= INPUT_CONST(MODIFIER_SHIFT);
  if (INPUT_KEYBOARD_FUNC(IsDown)(LIB_PREFIX_CONST(INPUT_KEY_LEFT_CONTROL)) || INPUT_KEYBOARD_FUNC(IsDown)(LIB_PREFIX_CONST(INPUT_KEY_RIGHT_CONTROL))) modifiers |= INPUT_CONST(MODIFIER_CONTROL);
  if (INPUT_KEYBOARD_FUNC(IsDown)(LIB_PREFIX_CONST(INPUT_KEY_LEFT_ALT)) || INPUT_KEYBOARD_FUNC(IsDown)(LIB_PREFIX_CONST(INPUT_KEY_RIGHT_ALT))) modifiers |= INPUT_CONST(MODIFIER_ALT);
  if (INPUT_KEYBOARD_FUNC(IsDown)(LIB_PREFIX_CONST(INPUT_KEY_LEFT_SUPER)) || INPUT_KEYBOARD_FUNC(IsDown)(LIB_PREFIX_CONST(INPUT_KEY_RIGHT_SUPER))) modifiers |= INPUT_CONST(MODIFIER_SUPER);
  return modifiers;
}
INPUT_MOUSE_GET_POSITION_PROTOTYPE {
  if (x) *x = INPUT_INS(state).x;
  if (y) *y = INPUT_INS(state).y;
}
INPUT_MOUSE_GET_DELTA_PROTOTYPE {
  if (x) *x = INPUT_INS(state).dx;
  if (y) *y = INPUT_INS(state).dy;
}
INPUT_MOUSE_GET_SCROLL_PROTOTYPE {
  if (x) *x = INPUT_INS(state).sx;
  if (y) *y = INPUT_INS(state).sy;
}
INPUT_CONTROLLER_ENUMERATE_PROTOTYPE {
  size_t i, total = 0;
  if (!count || (!controllers && capacity)) return STATUS_CONST(INVALID_ARGUMENT);
  for (i = 0; i < INPUT_DEVICE_CAPACITY; ++i) if (INPUT_INS(state).devices[i].connected) ++total;
  *count = total; /* documented exception: required size on insufficient space */
  if (!controllers && !capacity) return STATUS_CONST(SUCCESS);
  if (capacity < total) return STATUS_CONST(INSUFFICIENT_SPACE);
  total = 0;
  for (i = 0; i < INPUT_DEVICE_CAPACITY; ++i)
    if (INPUT_INS(state).devices[i].connected) controllers[total++] = INPUT_INS(state).devices[i].id;
  return STATUS_CONST(SUCCESS);
}
INPUT_CONTROLLER_IS_CONNECTED_PROTOTYPE { return INPUT_INS(Find)(controller) != NULL; }
INPUT_CONTROLLER_GET_NAME_PROTOTYPE {
  INPUT_INS(Device) *d;
  size_t length;
  if (!required || (!buffer && capacity)) return STATUS_CONST(INVALID_ARGUMENT);
  d = INPUT_INS(Find)(controller);
  if (!d) return STATUS_CONST(NOT_FOUND);
  length = strlen(d->name) + 1;
  *required = length; /* includes NUL; produced even when buffer is too small */
  if (!buffer && !capacity) return STATUS_CONST(SUCCESS);
  if (capacity < length) return STATUS_CONST(INSUFFICIENT_SPACE);
  memcpy(buffer, d->name, length);
  return STATUS_CONST(SUCCESS);
}
INPUT_CONTROLLER_GET_BUTTON_COUNT_PROTOTYPE {
  INPUT_INS(Device) *d = INPUT_INS(Find)(controller);
  return d ? d->buttonCount : 0;
}
INPUT_CONTROLLER_GET_AXIS_COUNT_PROTOTYPE {
  INPUT_INS(Device) *d = INPUT_INS(Find)(controller);
  return d ? d->axisCount : 0;
}
INPUT_CONTROLLER_GET_HAT_COUNT_PROTOTYPE {
  INPUT_INS(Device) *d = INPUT_INS(Find)(controller);
  return d ? d->hatCount : 0;
}
INPUT_CONTROLLER_HAS_RUMBLE_PROTOTYPE {
  INPUT_INS(Device) *d = INPUT_INS(Find)(controller);
  return d && d->rumble;
}
INPUT_CONTROLLER_IS_DOWN_PROTOTYPE {
  INPUT_INS(Device) *d = INPUT_INS(Find)(controller);
  return d && button < d->buttonCount && d->buttons[button].down;
}
INPUT_CONTROLLER_IS_PRESSED_PROTOTYPE {
  INPUT_INS(Device) *d = INPUT_INS(Find)(controller);
  return d && button < d->buttonCount && d->buttons[button].pressed;
}
INPUT_CONTROLLER_IS_RELEASED_PROTOTYPE {
  INPUT_INS(Device) *d = INPUT_INS(Find)(controller);
  return d && button < d->buttonCount && d->buttons[button].released;
}
INPUT_CONTROLLER_GET_AXIS_PROTOTYPE {
  INPUT_INS(Device) *d = INPUT_INS(Find)(controller);
  return d && axis < d->axisCount ? d->axes[axis] : 0;
}
INPUT_CONTROLLER_GET_HAT_PROTOTYPE {
  INPUT_INS(Device) *d = INPUT_INS(Find)(controller);
  return d && hat < d->hatCount ? d->hats[hat] : INPUT_CONST(HAT_CENTERED);
}
INPUT_CONTROLLER_RUMBLE_PROTOTYPE {
  INPUT_INS(Device) *d;
  if (!(lowFrequency >= 0 && lowFrequency <= 1) || !(highFrequency >= 0 && highFrequency <= 1)) return STATUS_CONST(INVALID_ARGUMENT);
  d = INPUT_INS(Find)(controller);
  if (!d) return STATUS_CONST(NOT_FOUND);
  return INPUT_INS(BackendRumble)(d, lowFrequency, highFrequency, durationMs);
}
INPUT_CONTROLLER_STOP_RUMBLE_PROTOTYPE {
  return INPUT_CONTROLLER_FUNC(Rumble)(controller, 0, 0, 0);
}
INPUT_GAMEPAD_IS_MAPPED_PROTOTYPE {
  INPUT_INS(Device) *d = INPUT_INS(Find)(controller);
  return d && d->mapped;
}
INPUT_GAMEPAD_IS_DOWN_PROTOTYPE {
  INPUT_INS(Device) *d = INPUT_INS(Find)(controller);
  int index;
  if (!d || !d->mapped || button < 0 || button >= INPUT_CONST(GAMEPAD_BUTTON_COUNT)) return false;
  index = d->gamepadButtons[button];
  return index >= 0 && (uint32_t)index < d->buttonCount && d->buttons[index].down;
}
INPUT_GAMEPAD_IS_PRESSED_PROTOTYPE {
  INPUT_INS(Device) *d = INPUT_INS(Find)(controller);
  int index;
  if (!d || !d->mapped || button < 0 || button >= INPUT_CONST(GAMEPAD_BUTTON_COUNT)) return false;
  index = d->gamepadButtons[button];
  return index >= 0 && (uint32_t)index < d->buttonCount && d->buttons[index].pressed;
}
INPUT_GAMEPAD_IS_RELEASED_PROTOTYPE {
  INPUT_INS(Device) *d = INPUT_INS(Find)(controller);
  int index;
  if (!d || !d->mapped || button < 0 || button >= INPUT_CONST(GAMEPAD_BUTTON_COUNT)) return false;
  index = d->gamepadButtons[button];
  return index >= 0 && (uint32_t)index < d->buttonCount && d->buttons[index].released;
}
INPUT_GAMEPAD_GET_AXIS_PROTOTYPE {
  INPUT_INS(Device) *d = INPUT_INS(Find)(controller);
  int index;
  float value;
  if (!d || !d->mapped || axis < 0 || axis >= INPUT_CONST(GAMEPAD_AXIS_COUNT)) return 0;
  index = d->gamepadAxes[axis];
  if (index < 0 || (uint32_t)index >= d->axisCount) return 0;
  value = d->axes[index];
  if (axis == INPUT_CONST(GAMEPAD_AXIS_LEFT_TRIGGER) || axis == INPUT_CONST(GAMEPAD_AXIS_RIGHT_TRIGGER)) return (value + 1) * 0.5f;
#if defined(__linux__) && !defined(INPUT_NO_NATIVE)
  if (axis == INPUT_CONST(GAMEPAD_AXIS_LEFT_Y) || axis == INPUT_CONST(GAMEPAD_AXIS_RIGHT_Y)) return -value;
#endif
  return value;
}
INPUT_EVENT_POLL_PROTOTYPE {
  INPUT_INS(State) *s = &INPUT_INS(state);
  if (!event || !s->count) return false;
  *event = s->events[s->head];
  s->head = (s->head + 1) % INPUT_EVENT_CAPACITY; --s->count;
  return true;
}
INPUT_EVENT_CLEAR_PROTOTYPE { INPUT_INS(state).head = INPUT_INS(state).count = 0; }
INPUT_EVENT_GET_DROPPED_COUNT_PROTOTYPE { return INPUT_INS(state).dropped; }
