/* Basic.def - Dual Mode Engine (Zero Duplication) */

#include "../Impl/Common.inc"

#ifndef TEMPLATE_Math_ArithmeticSigned
#define TEMPLATE_Math_ArithmeticSigned(SUFFIX, TYPE, MINIMUM, MAXIMUM)         \
  TEMPLATE_PACKAGE(Math, Arithmetic, SUFFIX,                                   \
      OPERATION_INLINE(Add, (TYPE a, TYPE b, TYPE *outResult), {               \
        if (!outResult) {                                                      \
          return STATUS_CONST(INVALID_ARGUMENT);                               \
        }                                                                      \
        int64_t result = 0;                                                    \
        OPSTATUS status = MODULE_IFUNC(Math, Arithmetic, SignedAdd)(           \
            (int64_t)a, (int64_t)b, (int64_t)(MINIMUM), (int64_t)(MAXIMUM),    \
            &result);                                                          \
        if (status == STATUS_CONST(SUCCESS)) {                                 \
          *outResult = (TYPE)result;                                           \
        }                                                                      \
        return status;                                                         \
      }),                                                                      \
      OPERATION_INLINE(Sub, (TYPE a, TYPE b, TYPE *outResult), {               \
        if (!outResult) {                                                      \
          return STATUS_CONST(INVALID_ARGUMENT);                               \
        }                                                                      \
        int64_t result = 0;                                                    \
        OPSTATUS status = MODULE_IFUNC(Math, Arithmetic, SignedSub)(           \
            (int64_t)a, (int64_t)b, (int64_t)(MINIMUM), (int64_t)(MAXIMUM),    \
            &result);                                                          \
        if (status == STATUS_CONST(SUCCESS)) {                                 \
          *outResult = (TYPE)result;                                           \
        }                                                                      \
        return status;                                                         \
      }),                                                                      \
      OPERATION_INLINE(Mul, (TYPE a, TYPE b, TYPE *outResult), {               \
        if (!outResult) {                                                      \
          return STATUS_CONST(INVALID_ARGUMENT);                               \
        }                                                                      \
        int64_t result = 0;                                                    \
        OPSTATUS status = MODULE_IFUNC(Math, Arithmetic, SignedMul)(           \
            (int64_t)a, (int64_t)b, (int64_t)(MINIMUM), (int64_t)(MAXIMUM),    \
            &result);                                                          \
        if (status == STATUS_CONST(SUCCESS)) {                                 \
          *outResult = (TYPE)result;                                           \
        }                                                                      \
        return status;                                                         \
      }),                                                                      \
      OPERATION_INLINE(Div, (TYPE a, TYPE b, TYPE *outResult), {               \
        if (!outResult) {                                                      \
          return STATUS_CONST(INVALID_ARGUMENT);                               \
        }                                                                      \
        int64_t result = 0;                                                    \
        OPSTATUS status = MODULE_IFUNC(Math, Arithmetic, SignedDiv)(           \
            (int64_t)a, (int64_t)b, (int64_t)(MINIMUM), &result);              \
        if (status == STATUS_CONST(SUCCESS)) {                                 \
          *outResult = (TYPE)result;                                           \
        }                                                                      \
        return status;                                                         \
      }),                                                                      \
      OPERATION_INLINE(Mod, (TYPE a, TYPE b, TYPE *outResult), {               \
        if (!outResult) {                                                      \
          return STATUS_CONST(INVALID_ARGUMENT);                               \
        }                                                                      \
        int64_t result = 0;                                                    \
        OPSTATUS status = MODULE_IFUNC(Math, Arithmetic, SignedMod)(           \
            (int64_t)a, (int64_t)b, (int64_t)(MINIMUM), &result);              \
        if (status == STATUS_CONST(SUCCESS)) {                                 \
          *outResult = (TYPE)result;                                           \
        }                                                                      \
        return status;                                                         \
      })                                                                       \
  )
#endif

#ifndef TEMPLATE_Math_ArithmeticUnsigned
#define TEMPLATE_Math_ArithmeticUnsigned(SUFFIX, TYPE, MAXIMUM)                \
  TEMPLATE_PACKAGE(Math, Arithmetic, SUFFIX,                                   \
      OPERATION_INLINE(Add, (TYPE a, TYPE b, TYPE *outResult), {               \
        if (!outResult) {                                                      \
          return STATUS_CONST(INVALID_ARGUMENT);                               \
        }                                                                      \
        uint64_t result = 0U;                                                  \
        OPSTATUS status = MODULE_IFUNC(Math, Arithmetic, UnsignedAdd)(         \
            (uint64_t)a, (uint64_t)b, (uint64_t)(MAXIMUM), &result);           \
        if (status == STATUS_CONST(SUCCESS)) {                                 \
          *outResult = (TYPE)result;                                           \
        }                                                                      \
        return status;                                                         \
      }),                                                                      \
      OPERATION_INLINE(Sub, (TYPE a, TYPE b, TYPE *outResult), {               \
        if (!outResult) {                                                      \
          return STATUS_CONST(INVALID_ARGUMENT);                               \
        }                                                                      \
        uint64_t result = 0U;                                                  \
        OPSTATUS status = MODULE_IFUNC(Math, Arithmetic, UnsignedSub)(         \
            (uint64_t)a, (uint64_t)b, &result);                                \
        if (status == STATUS_CONST(SUCCESS)) {                                 \
          *outResult = (TYPE)result;                                           \
        }                                                                      \
        return status;                                                         \
      }),                                                                      \
      OPERATION_INLINE(Mul, (TYPE a, TYPE b, TYPE *outResult), {               \
        if (!outResult) {                                                      \
          return STATUS_CONST(INVALID_ARGUMENT);                               \
        }                                                                      \
        uint64_t result = 0U;                                                  \
        OPSTATUS status = MODULE_IFUNC(Math, Arithmetic, UnsignedMul)(         \
            (uint64_t)a, (uint64_t)b, (uint64_t)(MAXIMUM), &result);           \
        if (status == STATUS_CONST(SUCCESS)) {                                 \
          *outResult = (TYPE)result;                                           \
        }                                                                      \
        return status;                                                         \
      }),                                                                      \
      OPERATION_INLINE(Div, (TYPE a, TYPE b, TYPE *outResult), {               \
        if (!outResult) {                                                      \
          return STATUS_CONST(INVALID_ARGUMENT);                               \
        }                                                                      \
        uint64_t result = 0U;                                                  \
        OPSTATUS status = MODULE_IFUNC(Math, Arithmetic, UnsignedDiv)(         \
            (uint64_t)a, (uint64_t)b, &result);                                \
        if (status == STATUS_CONST(SUCCESS)) {                                 \
          *outResult = (TYPE)result;                                           \
        }                                                                      \
        return status;                                                         \
      }),                                                                      \
      OPERATION_INLINE(Mod, (TYPE a, TYPE b, TYPE *outResult), {               \
        if (!outResult) {                                                      \
          return STATUS_CONST(INVALID_ARGUMENT);                               \
        }                                                                      \
        uint64_t result = 0U;                                                  \
        OPSTATUS status = MODULE_IFUNC(Math, Arithmetic, UnsignedMod)(         \
            (uint64_t)a, (uint64_t)b, &result);                                \
        if (status == STATUS_CONST(SUCCESS)) {                                 \
          *outResult = (TYPE)result;                                           \
        }                                                                      \
        return status;                                                         \
      })                                                                       \
  )
#endif

/* Mode 2 (Direct Include): Auto-instantiates and cleans up environment */
#if (!defined(COSMERON_INTERNAL_NO_AUTO_INSTANTIATE) && !defined(COSMERON_INTERNAL_IN_COMMON_INC)) && defined(SUFFIX) && defined(TYPE) && defined(MINIMUM) && defined(MAXIMUM)
  TEMPLATE_Math_ArithmeticSigned(SUFFIX, TYPE, MINIMUM, MAXIMUM);
  #undef SUFFIX
  #undef TYPE
  #undef MINIMUM
  #undef MAXIMUM
#elif (!defined(COSMERON_INTERNAL_NO_AUTO_INSTANTIATE) && !defined(COSMERON_INTERNAL_IN_COMMON_INC)) && defined(SUFFIX) && defined(TYPE) && defined(MAXIMUM)
  TEMPLATE_Math_ArithmeticUnsigned(SUFFIX, TYPE, MAXIMUM);
  #undef SUFFIX
  #undef TYPE
  #undef MAXIMUM
#endif
