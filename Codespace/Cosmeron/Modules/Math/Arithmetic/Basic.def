/* Basic.def - Dual Mode Engine (Zero Duplication) */

#ifndef TEMPLATE_Math_ArithmeticSigned
#define TEMPLATE_Math_ArithmeticSigned(SUFFIX, TYPE, MINIMUM, MAXIMUM)         \
  TEMPLATE_PACKAGE(Math, Arithmetic, SUFFIX,                                   \
      OPERATION_INLINE(Add, (TYPE a, TYPE b, TYPE *outResult), {               \
        if (!outResult) {                                                      \
          return STATUS_CONST(INVALID_ARGUMENT);                               \
        }                                                                      \
        if ((b > 0 && a > (MAXIMUM) - b) || (b < 0 && a < (MINIMUM) - b)) {    \
          return STATUS_CONST(OUT_OF_RANGE);                                   \
        }                                                                      \
        *outResult = (TYPE)(a + b);                                            \
        return STATUS_CONST(SUCCESS);                                          \
      }),                                                                      \
      OPERATION_INLINE(Sub, (TYPE a, TYPE b, TYPE *outResult), {               \
        if (!outResult) {                                                      \
          return STATUS_CONST(INVALID_ARGUMENT);                               \
        }                                                                      \
        if ((b < 0 && a > (MAXIMUM) + b) || (b > 0 && a < (MINIMUM) + b)) {    \
          return STATUS_CONST(OUT_OF_RANGE);                                   \
        }                                                                      \
        *outResult = (TYPE)(a - b);                                            \
        return STATUS_CONST(SUCCESS);                                          \
      }),                                                                      \
      OPERATION_INLINE(Mul, (TYPE a, TYPE b, TYPE *outResult), {               \
        if (!outResult) {                                                      \
          return STATUS_CONST(INVALID_ARGUMENT);                               \
        }                                                                      \
        if (a == 0 || b == 0) {                                                \
          *outResult = 0;                                                      \
          return STATUS_CONST(SUCCESS);                                        \
        }                                                                      \
        if (a > 0) {                                                           \
          if (b > 0 ? (a > (MAXIMUM) / b) : (b < (MINIMUM) / a)) {             \
            return STATUS_CONST(OUT_OF_RANGE);                                 \
          }                                                                    \
        } else {                                                               \
          if (b > 0 ? (a < (MINIMUM) / b) : (a != 0 && b < (MAXIMUM) / a)) {   \
            return STATUS_CONST(OUT_OF_RANGE);                                 \
          }                                                                    \
        }                                                                      \
        *outResult = (TYPE)(a * b);                                            \
        return STATUS_CONST(SUCCESS);                                          \
      }),                                                                      \
      OPERATION_INLINE(Div, (TYPE a, TYPE b, TYPE *outResult), {               \
        if (!outResult || b == 0) {                                            \
          return STATUS_CONST(INVALID_ARGUMENT);                               \
        }                                                                      \
        if (a == (MINIMUM) && b == -1) {                                       \
          return STATUS_CONST(OUT_OF_RANGE);                                   \
        }                                                                      \
        *outResult = (TYPE)(a / b);                                            \
        return STATUS_CONST(SUCCESS);                                          \
      }),                                                                      \
      OPERATION_INLINE(Mod, (TYPE a, TYPE b, TYPE *outResult), {               \
        if (!outResult || b == 0) {                                            \
          return STATUS_CONST(INVALID_ARGUMENT);                               \
        }                                                                      \
        if (a == (MINIMUM) && b == -1) {                                       \
          return STATUS_CONST(OUT_OF_RANGE);                                   \
        }                                                                      \
        *outResult = (TYPE)(a % b);                                            \
        return STATUS_CONST(SUCCESS);                                          \
      })                                                                       \
  )
#endif

#ifndef TEMPLATE_Math_ArithmeticUnsigned
#define TEMPLATE_Math_ArithmeticUnsigned(SUFFIX, TYPE, MAXIMUM)                \
  TEMPLATE_PACKAGE(Math, Arithmetic, SUFFIX,                                   \
      OPERATION_INLINE(Add, (TYPE a, TYPE b, TYPE *outResult), {               \
        if (!outResult) {                                                      \
          return STATUS_CONST(INVALID_ARGUMENT);                               \
        }                                                                      \
        if (a > (MAXIMUM) - b) {                                               \
          return STATUS_CONST(OUT_OF_RANGE);                                   \
        }                                                                      \
        *outResult = (TYPE)(a + b);                                            \
        return STATUS_CONST(SUCCESS);                                          \
      }),                                                                      \
      OPERATION_INLINE(Sub, (TYPE a, TYPE b, TYPE *outResult), {               \
        if (!outResult) {                                                      \
          return STATUS_CONST(INVALID_ARGUMENT);                               \
        }                                                                      \
        if (a < b) {                                                           \
          return STATUS_CONST(OUT_OF_RANGE);                                   \
        }                                                                      \
        *outResult = (TYPE)(a - b);                                            \
        return STATUS_CONST(SUCCESS);                                          \
      }),                                                                      \
      OPERATION_INLINE(Mul, (TYPE a, TYPE b, TYPE *outResult), {               \
        if (!outResult) {                                                      \
          return STATUS_CONST(INVALID_ARGUMENT);                               \
        }                                                                      \
        if (a != 0 && b > (MAXIMUM) / a) {                                     \
          return STATUS_CONST(OUT_OF_RANGE);                                   \
        }                                                                      \
        *outResult = (TYPE)(a * b);                                            \
        return STATUS_CONST(SUCCESS);                                          \
      }),                                                                      \
      OPERATION_INLINE(Div, (TYPE a, TYPE b, TYPE *outResult), {               \
        if (!outResult || b == 0) {                                            \
          return STATUS_CONST(INVALID_ARGUMENT);                               \
        }                                                                      \
        *outResult = (TYPE)(a / b);                                            \
        return STATUS_CONST(SUCCESS);                                          \
      }),                                                                      \
      OPERATION_INLINE(Mod, (TYPE a, TYPE b, TYPE *outResult), {               \
        if (!outResult || b == 0) {                                            \
          return STATUS_CONST(INVALID_ARGUMENT);                               \
        }                                                                      \
        *outResult = (TYPE)(a % b);                                            \
        return STATUS_CONST(SUCCESS);                                          \
      })                                                                       \
  )
#endif

/* Mode 2 (Direct Include): Auto-instantiates and cleans up environment */
#if defined(SUFFIX) && defined(TYPE) && defined(MINIMUM) && defined(MAXIMUM)
  TEMPLATE_Math_ArithmeticSigned(SUFFIX, TYPE, MINIMUM, MAXIMUM);
  #undef SUFFIX
  #undef TYPE
  #undef MINIMUM
  #undef MAXIMUM
#elif defined(SUFFIX) && defined(TYPE) && defined(MAXIMUM)
  TEMPLATE_Math_ArithmeticUnsigned(SUFFIX, TYPE, MAXIMUM);
  #undef SUFFIX
  #undef TYPE
  #undef MAXIMUM
#endif
