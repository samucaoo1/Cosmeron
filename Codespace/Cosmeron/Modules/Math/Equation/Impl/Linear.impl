#define MATH_EQUATION_LINEAR_IMPLEMENT(TYPE, SUFFIX)                           \
  MATH_EQUATION_LINEAR_PROTOTYPE(TYPE, SUFFIX) {                      \
    if (outResult == NULL || outSolution == NULL) {                                                      \
      return STATUS_CONST(INVALID_ARGUMENT);                                      \
    }                                                                          \
                                                                               \
    if (a == (TYPE)0) {                                                        \
      if (b == (TYPE)0) {                                                      \
        *outSolution = MATH_CONST(SOLUTION_INFINITE);\
        return STATUS_CONST(SUCCESS);                                  \
      }                                                                        \
                                                                               \
      *outSolution = MATH_CONST(SOLUTION_NONE);\
      return STATUS_CONST(SUCCESS);                                           \
    }                                                                          \
                                                                               \
    *outResult = -b / a;                                                          \
    *outSolution = MATH_CONST(SOLUTION_ONE);                                   \
    return STATUS_CONST(SUCCESS);                                            \
  }
/* EOF */
