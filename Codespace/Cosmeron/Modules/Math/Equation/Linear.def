/* Linear.def - Dual Mode Engine (Zero Duplication) */

#include "../Impl/Common.inc"

#ifndef TEMPLATE_Math_LinearEquation
#define TEMPLATE_Math_LinearEquation(SUFFIX, TYPE)                             \
  TEMPLATE_PACKAGE(Math, LinearEquation, SUFFIX,                               \
      OPERATION_INLINE(Solve,                                                  \
                       (TYPE a, TYPE b, TYPE *outResult,                       \
                        MODULE_ENUM(Math, Solution) *outSolution), {           \
        if (!outResult || !outSolution) {                                      \
          return STATUS_CONST(INVALID_ARGUMENT);                               \
        }                                                                      \
        if (a == (TYPE)0) {                                                    \
          *outResult = (TYPE)0;                                                \
          *outSolution = (b == (TYPE)0) ? MODULE_CONST(Math, INFINITE)         \
                                        : MODULE_CONST(Math, NONE);            \
          return STATUS_CONST(SUCCESS);                                        \
        }                                                                      \
        *outSolution = MODULE_CONST(Math, ONE);                                \
        *outResult = -b / a;                                                   \
        return STATUS_CONST(SUCCESS);                                          \
      })                                                                       \
  )
#endif

/* Mode 2 (Direct Include): Auto-instantiates and cleans up environment */
#if (!defined(COSMERON_INTERNAL_NO_AUTO_INSTANTIATE) && !defined(COSMERON_INTERNAL_IN_COMMON_INC)) && defined(SUFFIX) && defined(TYPE)
  TEMPLATE_Math_LinearEquation(SUFFIX, TYPE);
  #undef SUFFIX
  #undef TYPE
#endif
