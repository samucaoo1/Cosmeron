/* Quadratic.def - Dual Mode Engine (Zero Duplication) */

#include "../Impl/Common.inc"
#define COSMERON_INTERNAL_NO_AUTO_INSTANTIATE 1
#include "Linear.def"
#undef COSMERON_INTERNAL_NO_AUTO_INSTANTIATE

#ifndef TEMPLATE_Math_QuadraticEquation
#define TEMPLATE_Math_QuadraticEquation(SUFFIX, TYPE)                          \
  TEMPLATE_PACKAGE(Math, QuadraticEquation, SUFFIX,                            \
      FUNCTION_INLINE(TYPE, Sqrt, (TYPE x), {                                  \
        if (x <= (TYPE)0) {                                                    \
          return (TYPE)0;                                                      \
        }                                                                      \
        TYPE guess = x > (TYPE)1 ? x * (TYPE)0.5 : (TYPE)1;                    \
        for (size_t i = 0U;                                                    \
             i < CNS(Math, Equation, Internal, MAX_SQRT_ITERATIONS); ++i) {    \
          const TYPE next = (TYPE)0.5 * (guess + x / guess);                   \
          if (next == guess) {                                                 \
            break;                                                             \
          }                                                                    \
          guess = next;                                                        \
        }                                                                      \
        return guess;                                                          \
      }),                                                                      \
      FUNCTION_INLINE(TYPE, Discriminant, (TYPE a, TYPE b, TYPE c), {          \
        return b * b - (TYPE)4 * a * c;                                        \
      }),                                                                      \
      OPERATION_INLINE(Solve,                                                  \
                       (TYPE a, TYPE b, TYPE c, TYPE *outResult1,              \
                        TYPE *outResult2,                                      \
                        MODULE_ENUM(Math, Solution) *outSolution), {           \
        if (!outResult1 || !outResult2 || !outSolution) {                      \
          return STATUS_CONST(INVALID_ARGUMENT);                               \
        }                                                                      \
        if (a == (TYPE)0) {                                                    \
          *outResult2 = (TYPE)0;                                               \
          return MODULE_FUNC(Math, LinearEquation, SUFFIX, Solve)(             \
              b, c, outResult1, outSolution);                                  \
        }                                                                      \
        const TYPE d = MODULE_FUNC(                                            \
            Math, QuadraticEquation, SUFFIX, Discriminant)(a, b, c);           \
        if (d < (TYPE)0) {                                                     \
          *outSolution = MODULE_CONST(Math, COMPLEX);                          \
          *outResult1 = (TYPE)0;                                               \
          *outResult2 = (TYPE)0;                                               \
          return STATUS_CONST(SUCCESS);                                        \
        }                                                                      \
        if (d == (TYPE)0) {                                                    \
          *outSolution = MODULE_CONST(Math, ONE);                              \
          *outResult1 = -b / ((TYPE)2 * a);                                    \
          *outResult2 = *outResult1;                                           \
          return STATUS_CONST(SUCCESS);                                        \
        }                                                                      \
        const TYPE sq =                                                        \
            MODULE_FUNC(Math, QuadraticEquation, SUFFIX, Sqrt)(d);             \
        const TYPE twoA = (TYPE)2 * a;                                         \
        *outSolution = MODULE_CONST(Math, TWO);                                \
        *outResult1 = (-b - sq) / twoA;                                        \
        *outResult2 = (-b + sq) / twoA;                                        \
        return STATUS_CONST(SUCCESS);                                          \
      })                                                                       \
  )
#endif

/* Mode 2 (Direct Include): Auto-instantiates and cleans up environment */
#if (!defined(COSMERON_INTERNAL_NO_AUTO_INSTANTIATE) && !defined(COSMERON_INTERNAL_IN_COMMON_INC)) && defined(SUFFIX) && defined(TYPE)
  TEMPLATE_Math_QuadraticEquation(SUFFIX, TYPE);
  #undef SUFFIX
  #undef TYPE
#endif
