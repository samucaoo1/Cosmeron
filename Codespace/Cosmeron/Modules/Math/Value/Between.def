/* Between.def - Dual Mode Engine (Zero Duplication) */

#ifndef TEMPLATE_Math_Between
#define TEMPLATE_Math_Between(SUFFIX, TYPE)                                    \
  TEMPLATE_PACKAGE(Math, Between, SUFFIX,                                      \
      PREDICATE_INLINE(Is, (TYPE value, TYPE minimum, TYPE maximum), {         \
        if (minimum > maximum) {                                               \
          return false;                                                        \
        }                                                                      \
        return value >= minimum && value <= maximum;                           \
      }),                                                                      \
      FUNCTION_INLINE(MODULE_ENUM(Math, RangeResult), Classify,                \
                      (TYPE value, TYPE minimum, TYPE maximum), {              \
        if (minimum > maximum) {                                               \
          return MODULE_CONST(Math, INVALID_RANGE);                            \
        }                                                                      \
        if (value < minimum) {                                                 \
          return MODULE_CONST(Math, BELOW_RANGE);                              \
        }                                                                      \
        if (value > maximum) {                                                 \
          return MODULE_CONST(Math, ABOVE_RANGE);                              \
        }                                                                      \
        return MODULE_CONST(Math, IN_RANGE);                                   \
      })                                                                       \
  )
#endif

/* Mode 2 (Direct Include): Auto-instantiates and cleans up environment */
#if defined(SUFFIX) && defined(TYPE)
  TEMPLATE_Math_Between(SUFFIX, TYPE);
  #undef SUFFIX
  #undef TYPE
#endif
