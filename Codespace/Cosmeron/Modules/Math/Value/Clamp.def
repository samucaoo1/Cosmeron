/* Clamp.def - Dual Mode Engine (Zero Duplication) */

#include "../Impl/Common.inc"

#ifndef TEMPLATE_Math_Clamp
#define TEMPLATE_Math_Clamp(SUFFIX, TYPE)                                      \
  TEMPLATE_PACKAGE(Math, Clamp, SUFFIX,                                        \
      FUNCTION_INLINE(TYPE, Apply, (TYPE value, TYPE minimum, TYPE maximum), { \
        if (minimum > maximum) {                                               \
          const TYPE temp = minimum;                                           \
          minimum = maximum;                                                   \
          maximum = temp;                                                      \
        }                                                                      \
        if (value < minimum) {                                                 \
          return minimum;                                                      \
        }                                                                      \
        if (value > maximum) {                                                 \
          return maximum;                                                      \
        }                                                                      \
        return value;                                                          \
      })                                                                       \
  )
#endif

/* Mode 2 (Direct Include): Auto-instantiates and cleans up environment */
#if (!defined(COSMERON_INTERNAL_NO_AUTO_INSTANTIATE) && !defined(COSMERON_INTERNAL_IN_COMMON_INC)) && defined(SUFFIX) && defined(TYPE)
  TEMPLATE_Math_Clamp(SUFFIX, TYPE);
  #undef SUFFIX
  #undef TYPE
#endif
