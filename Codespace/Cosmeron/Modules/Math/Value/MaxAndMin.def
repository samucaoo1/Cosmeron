/* MaxAndMin.def - Dual Mode Engine (Zero Duplication) */

#ifndef TEMPLATE_Math_MaxAndMin
#define TEMPLATE_Math_MaxAndMin(SUFFIX, TYPE)                                  \
  TEMPLATE_PACKAGE(Math, MaxAndMin, SUFFIX,                                    \
      FUNCTION_INLINE(TYPE, Max, (TYPE a, TYPE b), {                           \
        return (a > b) ? a : b;                                                \
      }),                                                                      \
      FUNCTION_INLINE(TYPE, Min, (TYPE a, TYPE b), {                           \
        return (a < b) ? a : b;                                                \
      })                                                                       \
  )
#endif

/* Mode 2 (Direct Include): Auto-instantiates and cleans up environment */
#if defined(SUFFIX) && defined(TYPE)
  TEMPLATE_Math_MaxAndMin(SUFFIX, TYPE);
  #undef SUFFIX
  #undef TYPE
#endif
