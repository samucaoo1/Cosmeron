#pragma once

static inline OPSTATUS NETWORK_DATAGRAM_INS(Publish)(
    NETWORK_TYPE(TError) *error, NETWORK_TYPE(TError) domainError,
    OPSTATUS status) {
  if (error != NULL)
    *error = domainError;
  return status;
}

static inline OPSTATUS NETWORK_DATAGRAM_INS(Fail)(
    NETWORK_TYPE(TError) *error, NETWORK_TYPE(TError) domainError) {
  return NETWORK_DATAGRAM_INS(Publish)(
      error, domainError, STATUS_CONST(GENERIC_ERROR));
}

static inline void NETWORK_DATAGRAM_INS(RefreshLocalEndpoint)(
    NETWORK_DATAGRAM_TYPE(TDatagram) *datagram) {
  struct sockaddr_storage native;
  SOCKET_TYPE(Len) length = (SOCKET_TYPE(Len))sizeof(native);
  if (TSOCKET_NATIVE_GETSOCKNAME(datagram->socket.handle, (struct sockaddr *)&native, &length) == 0)
    SOCKET_INS(EndpointFromNative)((struct sockaddr *)&native,
                                     &datagram->localEndpoint);
}

NETWORK_DATAGRAM_INIT_PROTOTYPE {
  if (datagram == NULL)
    return;
  memset(datagram, 0, sizeof(*datagram));
  datagram->blocking = true;
  SOCKET_FUNC(Init)(&datagram->socket);
}

NETWORK_DATAGRAM_OPEN_PROTOTYPE {
  if (datagram == NULL) {
    if (error != NULL) *error = NETWORK_ERROR_CONST(NONE);
    return STATUS_CONST(INVALID_ARGUMENT);
  }
  NETWORK_DATAGRAM_FUNC(Close)(datagram);
  {
    NETWORK_TYPE(TError) socketError;
    if (SOCKET_FUNC(Create)(
            &datagram->socket, family, SOCKET_CONST(KIND_DATAGRAM),
            SOCKET_CONST(PROTOCOL_UDP), &socketError) != STATUS_CONST(SUCCESS))
      return NETWORK_DATAGRAM_INS(Fail)(error, socketError);
  }
  datagram->blocking = true;
  return NETWORK_DATAGRAM_INS(Publish)(error, NETWORK_ERROR_CONST(NONE), STATUS_CONST(SUCCESS));
}

NETWORK_DATAGRAM_BIND_PROTOTYPE {
  SOCKET_TYPE(TFamily) family;
  if (datagram == NULL || endpoint == NULL) {
    if (error != NULL) *error = NETWORK_ERROR_CONST(NONE);
    return STATUS_CONST(INVALID_ARGUMENT);
  }
  family = endpoint->address.type == NETWORK_ADDRESS_CONST(IPV6)
               ? SOCKET_CONST(FAMILY_IPV6)
               : SOCKET_CONST(FAMILY_IPV4);
  if (datagram->socket.handle == TSOCKET_NATIVE_INVALID &&
      NETWORK_DATAGRAM_FUNC(Open)(datagram, family, error) != STATUS_CONST(SUCCESS))
    return STATUS_CONST(GENERIC_ERROR);
  if (datagram->socket.family != family)
    return NETWORK_DATAGRAM_INS(Fail)(error, NETWORK_ERROR_CONST(ADDRESS_FAMILY_UNSUPPORTED));
  {
    NETWORK_TYPE(TError) socketError;
    if (SOCKET_FUNC(Bind)(
            &datagram->socket, endpoint, &socketError) != STATUS_CONST(SUCCESS))
      return NETWORK_DATAGRAM_INS(Fail)(error, socketError);
  }
  NETWORK_DATAGRAM_INS(RefreshLocalEndpoint)(datagram);
  return NETWORK_DATAGRAM_INS(Publish)(error, NETWORK_ERROR_CONST(NONE), STATUS_CONST(SUCCESS));
}

NETWORK_DATAGRAM_SET_PEER_PROTOTYPE {
  SOCKET_TYPE(TFamily) family;
  if (datagram == NULL || endpoint == NULL) {
    if (error != NULL) *error = NETWORK_ERROR_CONST(NONE);
    return STATUS_CONST(INVALID_ARGUMENT);
  }
  family = endpoint->address.type == NETWORK_ADDRESS_CONST(IPV6)
               ? SOCKET_CONST(FAMILY_IPV6)
               : SOCKET_CONST(FAMILY_IPV4);
  if (datagram->socket.handle == TSOCKET_NATIVE_INVALID &&
      NETWORK_DATAGRAM_FUNC(Open)(datagram, family, error) != STATUS_CONST(SUCCESS))
    return STATUS_CONST(GENERIC_ERROR);
  if (datagram->socket.family != family)
    return NETWORK_DATAGRAM_INS(Fail)(error, NETWORK_ERROR_CONST(ADDRESS_FAMILY_UNSUPPORTED));
  {
    NETWORK_TYPE(TError) socketError;
    if (SOCKET_FUNC(Connect)(
            &datagram->socket, endpoint, &socketError) != STATUS_CONST(SUCCESS))
      return NETWORK_DATAGRAM_INS(Fail)(error, socketError);
  }
  datagram->peerEndpoint = *endpoint;
  datagram->hasPeer = true;
  NETWORK_DATAGRAM_INS(RefreshLocalEndpoint)(datagram);
  return NETWORK_DATAGRAM_INS(Publish)(error, NETWORK_ERROR_CONST(NONE), STATUS_CONST(SUCCESS));
}

NETWORK_DATAGRAM_SEND_TO_PROTOTYPE {
  SOCKET_TYPE(TFamily) family;
  if (datagram == NULL || endpoint == NULL || sent == NULL ||
      (size != 0 && data == NULL)) {
    if (error != NULL) *error = NETWORK_ERROR_CONST(NONE);
    return STATUS_CONST(INVALID_ARGUMENT);
  }
  family = endpoint->address.type == NETWORK_ADDRESS_CONST(IPV6)
               ? SOCKET_CONST(FAMILY_IPV6)
               : SOCKET_CONST(FAMILY_IPV4);
  if (datagram->socket.handle == TSOCKET_NATIVE_INVALID &&
      NETWORK_DATAGRAM_FUNC(Open)(datagram, family, error) != STATUS_CONST(SUCCESS))
    return STATUS_CONST(GENERIC_ERROR);
  if (datagram->socket.family != family)
    return NETWORK_DATAGRAM_INS(Fail)(error, NETWORK_ERROR_CONST(ADDRESS_FAMILY_UNSUPPORTED));
  {
    NETWORK_TYPE(TError) socketError;
    if (SOCKET_FUNC(SendTo)(
            &datagram->socket, data, size, endpoint, sent, &socketError) !=
        STATUS_CONST(SUCCESS))
      return NETWORK_DATAGRAM_INS(Fail)(error, socketError);
  }
  NETWORK_DATAGRAM_INS(RefreshLocalEndpoint)(datagram);
  return NETWORK_DATAGRAM_INS(Publish)(error, NETWORK_ERROR_CONST(NONE), STATUS_CONST(SUCCESS));
}

NETWORK_DATAGRAM_RECEIVE_FROM_PROTOTYPE {
  if (datagram == NULL || received == NULL ||
      (capacity != 0 && buffer == NULL)) {
    if (error != NULL) *error = NETWORK_ERROR_CONST(NONE);
    return STATUS_CONST(INVALID_ARGUMENT);
  }
  if (datagram->socket.handle == TSOCKET_NATIVE_INVALID)
    return NETWORK_DATAGRAM_INS(Fail)(error, NETWORK_ERROR_CONST(NOT_CONNECTED));
  {
    NETWORK_TYPE(TError) socketError;
    if (SOCKET_FUNC(ReceiveFrom)(
            &datagram->socket, buffer, capacity, sender, received,
            &socketError) != STATUS_CONST(SUCCESS))
      return NETWORK_DATAGRAM_INS(Fail)(error, socketError);
  }
  return NETWORK_DATAGRAM_INS(Publish)(error, NETWORK_ERROR_CONST(NONE), STATUS_CONST(SUCCESS));
}

NETWORK_DATAGRAM_SEND_PROTOTYPE {
  if (datagram == NULL || sent == NULL || (size != 0 && data == NULL)) {
    if (error != NULL) *error = NETWORK_ERROR_CONST(NONE);
    return STATUS_CONST(INVALID_ARGUMENT);
  }
  if (!datagram->hasPeer)
    return NETWORK_DATAGRAM_INS(Fail)(error, NETWORK_ERROR_CONST(NOT_CONNECTED));
  {
    NETWORK_TYPE(TError) socketError;
    if (SOCKET_FUNC(Send)(
            &datagram->socket, data, size, sent, &socketError) !=
        STATUS_CONST(SUCCESS))
      return NETWORK_DATAGRAM_INS(Fail)(error, socketError);
  }
  return NETWORK_DATAGRAM_INS(Publish)(error, NETWORK_ERROR_CONST(NONE), STATUS_CONST(SUCCESS));
}

NETWORK_DATAGRAM_RECEIVE_PROTOTYPE {
  if (datagram == NULL || received == NULL ||
      (capacity != 0 && buffer == NULL)) {
    if (error != NULL) *error = NETWORK_ERROR_CONST(NONE);
    return STATUS_CONST(INVALID_ARGUMENT);
  }
  if (!datagram->hasPeer)
    return NETWORK_DATAGRAM_INS(Fail)(error, NETWORK_ERROR_CONST(NOT_CONNECTED));
  {
    NETWORK_TYPE(TError) socketError;
    if (SOCKET_FUNC(Receive)(
            &datagram->socket, buffer, capacity, received, &socketError) !=
        STATUS_CONST(SUCCESS))
      return NETWORK_DATAGRAM_INS(Fail)(error, socketError);
  }
  return NETWORK_DATAGRAM_INS(Publish)(error, NETWORK_ERROR_CONST(NONE), STATUS_CONST(SUCCESS));
}

NETWORK_DATAGRAM_SET_BLOCKING_PROTOTYPE {
  if (datagram == NULL) {
    if (error != NULL) *error = NETWORK_ERROR_CONST(NONE);
    return STATUS_CONST(INVALID_ARGUMENT);
  }
  {
    NETWORK_TYPE(TError) socketError;
    if (SOCKET_FUNC(SetBlocking)(
            &datagram->socket, blocking, &socketError) != STATUS_CONST(SUCCESS))
      return NETWORK_DATAGRAM_INS(Fail)(error, socketError);
  }
  datagram->blocking = blocking;
  return NETWORK_DATAGRAM_INS(Publish)(error, NETWORK_ERROR_CONST(NONE), STATUS_CONST(SUCCESS));
}

NETWORK_DATAGRAM_CLEAR_PEER_PROTOTYPE {
  struct sockaddr_storage native;
  NETWORK_TYPE(TError) domainError = NETWORK_ERROR_CONST(NONE);

  if (datagram == NULL) {
    if (error != NULL)
      *error = NETWORK_ERROR_CONST(NONE);
    return STATUS_CONST(INVALID_ARGUMENT);
  }

  if (datagram->socket.handle != TSOCKET_NATIVE_INVALID && datagram->hasPeer) {
    memset(&native, 0, sizeof(native));
    ((struct sockaddr *)&native)->sa_family = AF_UNSPEC;
    if (TSOCKET_NATIVE_CONNECT(
            datagram->socket.handle, (struct sockaddr *)&native,
            (SOCKET_TYPE(Len))sizeof(struct sockaddr)) == TSOCKET_NATIVE_ERROR) {
#if OS_WINDOWS
      int nativeError = TSOCKET_NATIVE_ERROR_CODE();
      if (nativeError != WSAEAFNOSUPPORT && nativeError != WSAEINVAL)
        domainError = SOCKET_INS(MapNativeError)(nativeError);
#elif OS_MAC
      int nativeError = TSOCKET_NATIVE_ERROR_CODE();
      if (nativeError != EAFNOSUPPORT && nativeError != EINVAL)
        domainError = SOCKET_INS(MapNativeError)(nativeError);
#else
      domainError = SOCKET_INS(MapNativeError)(TSOCKET_NATIVE_ERROR_CODE());
#endif
    }
  }

  datagram->hasPeer = false;
  memset(&datagram->peerEndpoint, 0, sizeof(datagram->peerEndpoint));
  return NETWORK_DATAGRAM_INS(Publish)(
      error, domainError,
      domainError == NETWORK_ERROR_CONST(NONE)
          ? STATUS_CONST(SUCCESS)
          : STATUS_CONST(GENERIC_ERROR));
}

NETWORK_DATAGRAM_CLOSE_PROTOTYPE {
  if (datagram == NULL)
    return;
  SOCKET_FUNC(Close)(&datagram->socket);
  datagram->hasPeer = false;
}
