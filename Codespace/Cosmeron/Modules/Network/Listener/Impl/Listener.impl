#pragma once

#if !OS_WINDOWS
#include <poll.h>
#endif

static inline OPSTATUS NETWORK_LISTENER_INS(Publish)(
    NETWORK_TYPE(TError) *error, NETWORK_TYPE(TError) domainError,
    OPSTATUS status) {
  if (error != NULL)
    *error = domainError;
  return status;
}

static inline OPSTATUS NETWORK_LISTENER_INS(Fail)(
    NETWORK_TYPE(TError) *error, NETWORK_TYPE(TError) domainError) {
  return NETWORK_LISTENER_INS(Publish)(
      error, domainError, STATUS_CONST(GENERIC_ERROR));
}

static inline OPSTATUS NETWORK_LISTENER_INS(Open)(
    SOCKET_TYPE(TSocket) *socket,
    const NETWORK_ADDRESS_TYPE(TEndpoint) *endpoint,
    NETWORK_TYPE(TError) *error) {
  SOCKET_TYPE(TFamily) family =
      endpoint->address.type == NETWORK_ADDRESS_CONST(IPV6)
          ? SOCKET_CONST(FAMILY_IPV6)
          : SOCKET_CONST(FAMILY_IPV4);
  OPSTATUS status;

  status = SOCKET_FUNC(Create)(
      socket, family, SOCKET_CONST(KIND_STREAM), SOCKET_CONST(PROTOCOL_TCP),
      error);
  if (status != STATUS_CONST(SUCCESS))
    return status;

  status = SOCKET_FUNC(SetReuseAddress)(socket, true, error);
  if (status == STATUS_CONST(SUCCESS))
    status = SOCKET_FUNC(Bind)(socket, endpoint, error);
  if (status == STATUS_CONST(SUCCESS))
    status = SOCKET_FUNC(Listen)(
        socket, NETWORK_LISTENER_DEFAULT_BACKLOG, error);
  if (status != STATUS_CONST(SUCCESS))
    SOCKET_FUNC(Close)(socket);
  return status;
}

static inline void NETWORK_LISTENER_INS(RefreshLocalEndpoint)(
    NETWORK_LISTENER_TYPE(TListener) *listener, SOCKET_TYPE(TSocket) *socket) {
  struct sockaddr_storage native;
  SOCKET_TYPE(Len) length = (SOCKET_TYPE(Len))sizeof(native);
  if (TSOCKET_NATIVE_GETSOCKNAME(socket->handle, (struct sockaddr *)&native, &length) == 0)
    SOCKET_INS(EndpointFromNative)((struct sockaddr *)&native,
                                     &listener->localEndpoint);
}

NETWORK_LISTENER_INIT_PROTOTYPE {
  if (listener == NULL)
    return;
  memset(listener, 0, sizeof(*listener));
  listener->blocking = true;
  SOCKET_FUNC(Init)(&listener->primary);
  SOCKET_FUNC(Init)(&listener->secondary);
}

NETWORK_LISTENER_LISTEN_AT_PROTOTYPE {
  if (listener == NULL || endpoint == NULL) {
    if (error != NULL) *error = NETWORK_ERROR_CONST(NONE);
    return STATUS_CONST(INVALID_ARGUMENT);
  }
  NETWORK_LISTENER_FUNC(Close)(listener);
  {
    NETWORK_TYPE(TError) openError = NETWORK_ERROR_CONST(NONE);
    if (NETWORK_LISTENER_INS(Open)(
            &listener->primary, endpoint, &openError) != STATUS_CONST(SUCCESS))
      return NETWORK_LISTENER_INS(Fail)(error, openError);
  }
  listener->dualStack = false;
  NETWORK_LISTENER_INS(RefreshLocalEndpoint)(listener, &listener->primary);
  return NETWORK_LISTENER_INS(Publish)(
      error, NETWORK_ERROR_CONST(NONE), STATUS_CONST(SUCCESS));
}

NETWORK_LISTENER_LISTEN_PROTOTYPE {
  NETWORK_ADDRESS_TYPE(TAddress) address;
  NETWORK_ADDRESS_TYPE(TEndpoint) endpoint;
  uint16_t boundPort = port;

  if (listener == NULL) {
    if (error != NULL) *error = NETWORK_ERROR_CONST(NONE);
    return STATUS_CONST(INVALID_ARGUMENT);
  }
  NETWORK_LISTENER_FUNC(Close)(listener);

  NETWORK_ADDRESS_FUNC(IPv6_Any)(&address);
  NETWORK_ADDRESS_FUNC(Endpoint_Create)(&endpoint, &address, port);

  {
    NETWORK_TYPE(TError) openError = NETWORK_ERROR_CONST(NONE);
    if (NETWORK_LISTENER_INS(Open)(
            &listener->primary, &endpoint, &openError) == STATUS_CONST(SUCCESS)) {
    int ipv6Only = 1;
    SOCKET_TYPE(Len) length = (SOCKET_TYPE(Len))sizeof(ipv6Only);
    NETWORK_LISTENER_INS(RefreshLocalEndpoint)(listener, &listener->primary);
    boundPort = listener->localEndpoint.port;

    if (TSOCKET_NATIVE_GETSOCKOPT(listener->primary.handle, IPPROTO_IPV6, IPV6_V6ONLY,
                   (char *)&ipv6Only, &length) == 0 && ipv6Only == 0) {
      listener->dualStack = true;
      return NETWORK_LISTENER_INS(Publish)(
          error, NETWORK_ERROR_CONST(NONE), STATUS_CONST(SUCCESS));
    }

    NETWORK_ADDRESS_FUNC(IPv4_Any)(&address);
    NETWORK_ADDRESS_FUNC(Endpoint_Create)(&endpoint, &address, boundPort);
    if (NETWORK_LISTENER_INS(Open)(
            &listener->secondary, &endpoint, &openError) == STATUS_CONST(SUCCESS)) {
      listener->dualStack = true;
      return NETWORK_LISTENER_INS(Publish)(
      error, NETWORK_ERROR_CONST(NONE), STATUS_CONST(SUCCESS));
    }

    /* IPv6 remains usable even when the IPv4 companion cannot be opened. */
    return NETWORK_LISTENER_INS(Publish)(
        error, NETWORK_ERROR_CONST(NONE), STATUS_CONST(SUCCESS));
    }
  }

  NETWORK_ADDRESS_FUNC(IPv4_Any)(&address);
  NETWORK_ADDRESS_FUNC(Endpoint_Create)(&endpoint, &address, port);
  {
    NETWORK_TYPE(TError) openError = NETWORK_ERROR_CONST(NONE);
    if (NETWORK_LISTENER_INS(Open)(
            &listener->primary, &endpoint, &openError) != STATUS_CONST(SUCCESS))
      return NETWORK_LISTENER_INS(Fail)(error, openError);
  }

  NETWORK_LISTENER_INS(RefreshLocalEndpoint)(listener, &listener->primary);
  listener->dualStack = false;
  return NETWORK_LISTENER_INS(Publish)(
      error, NETWORK_ERROR_CONST(NONE), STATUS_CONST(SUCCESS));
}

static inline SOCKET_TYPE(TSocket) *NETWORK_LISTENER_INS(AcceptSocket)(
    NETWORK_LISTENER_TYPE(TListener) *listener) {
  if (listener->secondary.handle == TSOCKET_NATIVE_INVALID)
    return &listener->primary;

#if OS_WINDOWS
  fd_set set;
  FD_ZERO(&set);
  FD_SET(listener->primary.handle, &set);
  FD_SET(listener->secondary.handle, &set);
  if (TSOCKET_NATIVE_SELECT(0, &set, NULL, NULL, NULL) <= 0)
    return NULL;
  return SOCKET_INS(DescriptorSetContains)(listener->primary.handle, &set) ? &listener->primary
                                                  : &listener->secondary;
#else
  struct pollfd descriptors[2];
  descriptors[0].fd = listener->primary.handle;
  descriptors[0].events = POLLIN;
  descriptors[0].revents = 0;
  descriptors[1].fd = listener->secondary.handle;
  descriptors[1].events = POLLIN;
  descriptors[1].revents = 0;
  if (poll(descriptors, 2, -1) <= 0)
    return NULL;
  if (descriptors[0].revents & POLLIN)
    return &listener->primary;
  if (descriptors[1].revents & POLLIN)
    return &listener->secondary;
  return NULL;
#endif
}

NETWORK_LISTENER_ACCEPT_PROTOTYPE {
  SOCKET_TYPE(TSocket) *source;
  NETWORK_ADDRESS_TYPE(TEndpoint) peer;
  NETWORK_CONNECTION_TYPE(TConnection) accepted;

  if (listener == NULL || connection == NULL) {
    if (error != NULL)
      *error = NETWORK_ERROR_CONST(NONE);
    return STATUS_CONST(INVALID_ARGUMENT);
  }
  source = NETWORK_LISTENER_INS(AcceptSocket)(listener);
  if (source == NULL)
    return NETWORK_LISTENER_INS(Fail)(
        error, NETWORK_ERROR_CONST(UNKNOWN));

  NETWORK_CONNECTION_FUNC(Init)(&accepted);
  {
    NETWORK_TYPE(TError) socketError;
    if (SOCKET_FUNC(Accept)(
            source, &accepted.socket, &peer, &socketError) !=
        STATUS_CONST(SUCCESS))
      return NETWORK_LISTENER_INS(Fail)(
        error, socketError);
  }

  accepted.remoteEndpoint = peer;
  accepted.state = NETWORK_CONNECTION_CONST(CONNECTED);
  NETWORK_CONNECTION_INS(RefreshEndpoints)(&accepted);
  *connection = accepted;
  return NETWORK_LISTENER_INS(Publish)(
      error, NETWORK_ERROR_CONST(NONE), STATUS_CONST(SUCCESS));
}

NETWORK_LISTENER_CLOSE_PROTOTYPE {
  if (listener == NULL)
    return;
  SOCKET_FUNC(Close)(&listener->primary);
  SOCKET_FUNC(Close)(&listener->secondary);
  listener->dualStack = false;
}
