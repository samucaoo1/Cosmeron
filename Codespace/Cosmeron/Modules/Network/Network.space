#pragma once

#include "../../Core/Namespace.h"
#include "../../Core/Preprocessor/Compiling.inc"
#include "../../Core/Preprocessor/Operations.h"
#include "../../Core/Preprocessor/Detect/OperationSystem.h"

#include <stdbool.h>
#include <stddef.h>
#include <stdint.h>

#define NETWORK_MOD(NAME) GNS2(LIB_PREFIX(Network), NAME)
#define NETWORK_TYPE(NAME) GNS2(NETWORK_MOD(Type), NAME)
#define NETWORK_FUNC(NAME) GNS2(LIB_PREFIX(Network), NAME)
#define NETWORK_CONST(NAME) CNS2(LIB_PREFIX_CONST(NETWORK), NAME)
#ifdef COSMERON_NAMESPACE_CONST
#define NETWORK_CONST_FINAL(NAME) GNS2(COSMERON_NAMESPACE_CONST, NAME)
#else
#define NETWORK_CONST_FINAL(NAME) NAME
#endif

#define NETWORK_ERROR_CONST(NAME) NETWORK_CONST_FINAL(NETWORK_ERROR_##NAME)
#define NETWORK_EVENT_CONST(NAME) NETWORK_CONST_FINAL(NETWORK_EVENT_##NAME)
#define NETWORK_POLLER_SOURCE_CONST(NAME)                                      \
  NETWORK_CONST_FINAL(NETWORK_POLLER_SOURCE_##NAME)

#define NETWORK_ADDRESS_TYPE(NAME) GNS2(NETWORK_MOD(Address), NAME)
#define NETWORK_ADDRESS_FUNC(NAME) GNS2(NETWORK_MOD(Address), NAME)
#define NETWORK_CONNECTION_TYPE(NAME) GNS2(NETWORK_MOD(Connection), NAME)
#define NETWORK_CONNECTION_FUNC(NAME) GNS2(NETWORK_MOD(Connection), NAME)
#define NETWORK_LISTENER_TYPE(NAME) GNS2(NETWORK_MOD(Listener), NAME)
#define NETWORK_LISTENER_FUNC(NAME) GNS2(NETWORK_MOD(Listener), NAME)
#define NETWORK_DATAGRAM_TYPE(NAME) GNS2(NETWORK_MOD(Datagram), NAME)
#define NETWORK_DATAGRAM_FUNC(NAME) GNS2(NETWORK_MOD(Datagram), NAME)
#define NETWORK_POLLER_TYPE(NAME) GNS2(NETWORK_MOD(Poller), NAME)
#define NETWORK_POLLER_FUNC(NAME) GNS2(NETWORK_MOD(Poller), NAME)
#define NETWORK_POLLER_CONST(NAME) CNS3(LIB_PREFIX_CONST(NETWORK), POLLER, NAME)

#define SOCKET_NS NETWORK_MOD(Socket)
#define SOCKET_TYPE(NAME) GNS2(SOCKET_NS, NAME)
#define SOCKET_FUNC(NAME) GNS2(SOCKET_NS, NAME)
/* EOF */
