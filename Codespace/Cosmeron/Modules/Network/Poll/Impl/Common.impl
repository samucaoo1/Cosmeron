#pragma once

static inline OPSTATUS NETWORK_POLLER_FUNC(_Publish)(
    NETWORK_POLLER_TYPE(TPoller) *poller, NETWORK_TYPE(Error) *error,
    NETWORK_TYPE(Error) domainError, OPSTATUS status) {
  if (poller != NULL)
    poller->lastError = domainError;
  if (error != NULL)
    *error = domainError;
  return status;
}

static inline OPSTATUS NETWORK_POLLER_FUNC(_Add)(
    NETWORK_POLLER_TYPE(TPoller) *poller, NETWORK_POLLER_TYPE(SourceType) sourceType, void *object,
    NETWORK_POLLER_TYPE(EventFlags) interests, void *userdata, NETWORK_POLLER_TYPE(Handle) *handle,
    NETWORK_TYPE(Error) *error) {
  NETWORK_POLLER_TYPE(TRegistration) registration;
  if (poller == NULL || object == NULL) {
    if (error != NULL) *error = NETWORK_ERROR_CONST(NONE);
    return STATUS_CONST(INVALID_ARGUMENT);
  }
  registration.handle = poller->nextHandle++;
  if (registration.handle == 0)
    registration.handle = poller->nextHandle++;
  registration.sourceType = sourceType;
  registration.interests = interests;
  registration.object = object;
  registration.userdata = userdata;
  if (FLAT_VECTOR_FUNC(Network_Poll_Registration, PushBack)(
          &poller->registrations, registration) != STATUS_CONST(SUCCESS)) {
    return NETWORK_POLLER_FUNC(_Publish)(
        poller, error, NETWORK_ERROR_CONST(RESOURCE_EXHAUSTED),
        STATUS_CONST(OUT_OF_MEMORY));
  }
  if (handle != NULL) *handle = registration.handle;
  return NETWORK_POLLER_FUNC(_Publish)(
      poller, error, NETWORK_ERROR_CONST(NONE), STATUS_CONST(SUCCESS));
}

static inline void NETWORK_POLLER_FUNC(Init)(NETWORK_POLLER_TYPE(TPoller) *poller) {
  memset(poller, 0, sizeof(*poller));
  FLAT_VECTOR_FUNC(Network_Poll_Registration, Init)(&poller->registrations);
  poller->nextHandle = 1;
  poller->lastError = NETWORK_ERROR_CONST(NONE);
}

static inline void NETWORK_POLLER_FUNC(Destroy)(NETWORK_POLLER_TYPE(TPoller) *poller) {
  if (poller == NULL) return;
  FLAT_VECTOR_FUNC(Network_Poll_Registration, Destroy)(&poller->registrations);
  poller->nextHandle = 1;
}

static inline OPSTATUS NETWORK_POLLER_FUNC(AddConnection)(
    NETWORK_POLLER_TYPE(TPoller) *poller, NETWORK_CONNECTION_TYPE(TConnection) *connection,
    NETWORK_POLLER_TYPE(EventFlags) interests, void *userdata, NETWORK_POLLER_TYPE(Handle) *handle,
    NETWORK_TYPE(Error) *error) {
  return NETWORK_POLLER_FUNC(_Add)(
      poller, NETWORK_POLLER_SOURCE_CONST(CONNECTION), connection, interests,
      userdata, handle, error);
}

static inline OPSTATUS NETWORK_POLLER_FUNC(AddListener)(
    NETWORK_POLLER_TYPE(TPoller) *poller, NETWORK_LISTENER_TYPE(TListener) *listener,
    NETWORK_POLLER_TYPE(EventFlags) interests, void *userdata, NETWORK_POLLER_TYPE(Handle) *handle,
    NETWORK_TYPE(Error) *error) {
  return NETWORK_POLLER_FUNC(_Add)(
      poller, NETWORK_POLLER_SOURCE_CONST(LISTENER), listener, interests,
      userdata, handle, error);
}

static inline OPSTATUS NETWORK_POLLER_FUNC(AddDatagram)(
    NETWORK_POLLER_TYPE(TPoller) *poller, NETWORK_DATAGRAM_TYPE(TDatagram) *datagram,
    NETWORK_POLLER_TYPE(EventFlags) interests, void *userdata, NETWORK_POLLER_TYPE(Handle) *handle,
    NETWORK_TYPE(Error) *error) {
  return NETWORK_POLLER_FUNC(_Add)(
      poller, NETWORK_POLLER_SOURCE_CONST(DATAGRAM), datagram, interests,
      userdata, handle, error);
}

static inline OPSTATUS NETWORK_POLLER_FUNC(Remove)(
    NETWORK_POLLER_TYPE(TPoller) *poller, NETWORK_POLLER_TYPE(Handle) handle,
    NETWORK_TYPE(Error) *error) {
  size_t i;
  if (poller == NULL || handle == 0) {
    if (error != NULL) *error = NETWORK_ERROR_CONST(NONE);
    return STATUS_CONST(INVALID_ARGUMENT);
  }
  for (i = 0; i < poller->registrations.size; ++i)
    if (poller->registrations.data[i].handle == handle) {
      OPSTATUS status = FLAT_VECTOR_FUNC(Network_Poll_Registration, Erase)(
          &poller->registrations, i, 1);
      return NETWORK_POLLER_FUNC(_Publish)(
          poller, error, NETWORK_ERROR_CONST(NONE), status);
    }
  return NETWORK_POLLER_FUNC(_Publish)(
      poller, error, NETWORK_ERROR_CONST(NONE), STATUS_CONST(NOT_FOUND));
}

static inline OPSTATUS NETWORK_POLLER_FUNC(Watch)(
    NETWORK_POLLER_TYPE(TPoller) *poller, NETWORK_POLLER_TYPE(Handle) handle,
    NETWORK_POLLER_TYPE(EventFlags) interests, NETWORK_TYPE(Error) *error) {
  size_t i;
  if (poller == NULL || handle == 0) {
    if (error != NULL) *error = NETWORK_ERROR_CONST(NONE);
    return STATUS_CONST(INVALID_ARGUMENT);
  }
  for (i = 0; i < poller->registrations.size; ++i)
    if (poller->registrations.data[i].handle == handle) {
      poller->registrations.data[i].interests = interests;
      return NETWORK_POLLER_FUNC(_Publish)(
          poller, error, NETWORK_ERROR_CONST(NONE), STATUS_CONST(SUCCESS));
    }
  return NETWORK_POLLER_FUNC(_Publish)(
      poller, error, NETWORK_ERROR_CONST(NONE), STATUS_CONST(NOT_FOUND));
}

static inline bool NETWORK_POLLER_FUNC(_StreamClosed)(
    SOCKET_TYPE(Handle) handle) {
  char byte;
#if OS_WINDOWS
  int result = TSOCKET_NATIVE_RECV(handle, &byte, 1, MSG_PEEK);
#elif OS_MAC
  ssize_t result = TSOCKET_NATIVE_RECV(handle, &byte, 1, MSG_PEEK);
#else
  ssize_t result = TSOCKET_NATIVE_RECV(handle, &byte, 1, MSG_PEEK | MSG_DONTWAIT);
#endif
  if (result == 0) return true;
  if (result == TSOCKET_NATIVE_ERROR) {
    NETWORK_TYPE(Error) error =
        SOCKET_FUNC(_MapNativeError)(TSOCKET_NATIVE_ERROR_CODE());
    return error != NETWORK_ERROR_CONST(WOULD_BLOCK);
  }
  return false;
}

static inline OPSTATUS NETWORK_POLLER_FUNC(_PushEvent)(
    NETWORK_POLLER_TYPE(TPoller) *poller, NETWORK_POLLER_TYPE(TEventVector) *events,
    NETWORK_POLLER_TYPE(TRegistration) *registration, NETWORK_POLLER_TYPE(EventFlags) flags,
    NETWORK_TYPE(Error) *error) {
  NETWORK_POLLER_TYPE(TEvent) event;
  if (flags == NETWORK_EVENT_CONST(NONE))
    return NETWORK_POLLER_FUNC(_Publish)(
        poller, error, NETWORK_ERROR_CONST(NONE), STATUS_CONST(SUCCESS));
  event.handle = registration->handle;
  event.sourceType = registration->sourceType;
  event.flags = flags;
  event.object = registration->object;
  event.userdata = registration->userdata;
  if (FLAT_VECTOR_FUNC(Network_Event, PushBack)(events, event) !=
      STATUS_CONST(SUCCESS)) {
    return NETWORK_POLLER_FUNC(_Publish)(
        poller, error, NETWORK_ERROR_CONST(RESOURCE_EXHAUSTED),
        STATUS_CONST(OUT_OF_MEMORY));
  }
  return NETWORK_POLLER_FUNC(_Publish)(
      poller, error, NETWORK_ERROR_CONST(NONE), STATUS_CONST(SUCCESS));
}
