#pragma once

#include <limits.h>

static inline bool NETWORK_POLLER_FUNC(_SetHandle)(
    SOCKET_TYPE(Handle) handle, NETWORK_POLLER_TYPE(EventFlags) interests,
    fd_set *read_set, fd_set *writeSet, fd_set *errorSet,
    SOCKET_TYPE(Handle) *maximum) {
  if (handle == TSOCKET_NATIVE_INVALID) return true;
  if (handle < 0 || handle >= FD_SETSIZE) return false;
  if (interests & (NETWORK_EVENT_CONST(READ) | NETWORK_EVENT_CONST(ACCEPT) |
                   NETWORK_EVENT_CONST(CLOSE)))
    FD_SET(handle, read_set);
  if (interests & NETWORK_EVENT_CONST(WRITE)) FD_SET(handle, writeSet);
  FD_SET(handle, errorSet);
  if (handle > *maximum) *maximum = handle;
  return true;
}

static inline NETWORK_POLLER_TYPE(EventFlags) NETWORK_POLLER_FUNC(_Ready)(
    SOCKET_TYPE(Handle) handle, NETWORK_POLLER_TYPE(EventFlags) interests,
    bool detectClose, fd_set *read_set, fd_set *writeSet, fd_set *errorSet) {
  NETWORK_POLLER_TYPE(EventFlags) flags = NETWORK_EVENT_CONST(NONE);
  bool closed = false;
  if (handle == TSOCKET_NATIVE_INVALID) return flags;
  if (FD_ISSET(handle, errorSet)) flags |= NETWORK_EVENT_CONST(ERROR);
  if (FD_ISSET(handle, writeSet) && (interests & NETWORK_EVENT_CONST(WRITE)))
    flags |= NETWORK_EVENT_CONST(WRITE);
  if (FD_ISSET(handle, read_set)) {
    if (detectClose && (interests & NETWORK_EVENT_CONST(CLOSE)))
      closed = NETWORK_POLLER_FUNC(_StreamClosed)(handle);
    if (interests & NETWORK_EVENT_CONST(ACCEPT)) flags |= NETWORK_EVENT_CONST(ACCEPT);
    if ((interests & NETWORK_EVENT_CONST(READ)) && !closed)
      flags |= NETWORK_EVENT_CONST(READ);
    if (closed) flags |= NETWORK_EVENT_CONST(CLOSE);
  }
  return flags;
}

static inline OPSTATUS NETWORK_POLLER_FUNC(_WaitNative)(
    NETWORK_POLLER_TYPE(TPoller) *poller, NETWORK_POLLER_TYPE(TEventVector) *events,
    struct timeval *timeout, NETWORK_TYPE(TError) *error) {
  fd_set read_set, writeSet, errorSet;
  SOCKET_TYPE(Handle) maximum = 0;
  size_t i;
  int result;

  if (poller == NULL || events == NULL) {
    if (error != NULL) *error = NETWORK_ERROR_CONST(NONE);
    return STATUS_CONST(INVALID_ARGUMENT);
  }
  FLAT_VECTOR_FUNC(Network_Event, Clear)(events);
  if (poller->registrations.size == 0) {
    return NETWORK_POLLER_FUNC(_Publish)(
        poller, error, NETWORK_ERROR_CONST(NONE), STATUS_CONST(SUCCESS));
  }

  FD_ZERO(&read_set); FD_ZERO(&writeSet); FD_ZERO(&errorSet);
  for (i = 0; i < poller->registrations.size; ++i) {
    NETWORK_POLLER_TYPE(TRegistration) *r = &poller->registrations.data[i];
    bool valid = true;
    if (r->sourceType == NETWORK_POLLER_SOURCE_CONST(CONNECTION)) {
      NETWORK_CONNECTION_TYPE(TConnection) *c = (NETWORK_CONNECTION_TYPE(TConnection) *)r->object;
      valid = NETWORK_POLLER_FUNC(_SetHandle)(
          c->socket.handle, r->interests, &read_set, &writeSet, &errorSet, &maximum);
    } else if (r->sourceType == NETWORK_POLLER_SOURCE_CONST(DATAGRAM)) {
      NETWORK_DATAGRAM_TYPE(TDatagram) *d = (NETWORK_DATAGRAM_TYPE(TDatagram) *)r->object;
      valid = NETWORK_POLLER_FUNC(_SetHandle)(
          d->socket.handle, r->interests, &read_set, &writeSet, &errorSet, &maximum);
    } else {
      NETWORK_LISTENER_TYPE(TListener) *l = (NETWORK_LISTENER_TYPE(TListener) *)r->object;
      valid = NETWORK_POLLER_FUNC(_SetHandle)(
                  l->primary.handle, r->interests, &read_set, &writeSet,
                  &errorSet, &maximum) &&
              NETWORK_POLLER_FUNC(_SetHandle)(
                  l->secondary.handle, r->interests, &read_set, &writeSet,
                  &errorSet, &maximum);
    }
    if (!valid) {
      return NETWORK_POLLER_FUNC(_Publish)(
          poller, error, NETWORK_ERROR_CONST(RESOURCE_EXHAUSTED),
          STATUS_CONST(OUT_OF_RANGE));
    }
  }

  result = select(maximum + 1, &read_set, &writeSet, &errorSet, timeout);
  if (result == TSOCKET_NATIVE_ERROR) {
    return NETWORK_POLLER_FUNC(_Publish)(
        poller, error,
        SOCKET_FUNC(_MapNativeError)(TSOCKET_NATIVE_ERROR_CODE()),
        STATUS_CONST(GENERIC_ERROR));
  }

  for (i = 0; i < poller->registrations.size; ++i) {
    NETWORK_POLLER_TYPE(TRegistration) *r = &poller->registrations.data[i];
    NETWORK_POLLER_TYPE(EventFlags) flags = NETWORK_EVENT_CONST(NONE);
    if (r->sourceType == NETWORK_POLLER_SOURCE_CONST(CONNECTION)) {
      NETWORK_CONNECTION_TYPE(TConnection) *c = (NETWORK_CONNECTION_TYPE(TConnection) *)r->object;
      flags = NETWORK_POLLER_FUNC(_Ready)(
          c->socket.handle, r->interests, true, &read_set, &writeSet, &errorSet);
    } else if (r->sourceType == NETWORK_POLLER_SOURCE_CONST(DATAGRAM)) {
      NETWORK_DATAGRAM_TYPE(TDatagram) *d = (NETWORK_DATAGRAM_TYPE(TDatagram) *)r->object;
      flags = NETWORK_POLLER_FUNC(_Ready)(
          d->socket.handle, r->interests, false, &read_set, &writeSet, &errorSet);
    } else {
      NETWORK_LISTENER_TYPE(TListener) *l = (NETWORK_LISTENER_TYPE(TListener) *)r->object;
      flags = NETWORK_POLLER_FUNC(_Ready)(
          l->primary.handle, r->interests, false, &read_set, &writeSet, &errorSet);
      flags |= NETWORK_POLLER_FUNC(_Ready)(
          l->secondary.handle, r->interests, false, &read_set, &writeSet, &errorSet);
    }
    if (NETWORK_POLLER_FUNC(_PushEvent)(
            poller, events, r, flags, error) != STATUS_CONST(SUCCESS))
      return STATUS_CONST(OUT_OF_MEMORY);
  }

  return NETWORK_POLLER_FUNC(_Publish)(
      poller, error, NETWORK_ERROR_CONST(NONE), STATUS_CONST(SUCCESS));
}

static inline OPSTATUS NETWORK_POLLER_FUNC(Wait)(
    NETWORK_POLLER_TYPE(TPoller) *poller, NETWORK_POLLER_TYPE(TEventVector) *events,
    NETWORK_TYPE(TError) *error) {
  return NETWORK_POLLER_FUNC(_WaitNative)(poller, events, NULL, error);
}

static inline OPSTATUS NETWORK_POLLER_FUNC(WaitFor)(
    NETWORK_POLLER_TYPE(TPoller) *poller, NETWORK_POLLER_TYPE(TEventVector) *events,
    CHRONOMETRY_TYPE(Duration) timeout, NETWORK_TYPE(TError) *error) {
  struct timeval native_timeout;
  if (timeout.nanoseconds < 0) {
    if (error != NULL) *error = NETWORK_ERROR_CONST(NONE);
    return STATUS_CONST(INVALID_ARGUMENT);
  }
  {
    int64_t seconds =
        timeout.nanoseconds / CHRONOMETRY_NANOSECONDS_PER_SECOND;
    if ((uint64_t)seconds > (uint64_t)LONG_MAX)
      native_timeout.tv_sec = LONG_MAX;
    else
      native_timeout.tv_sec = (long)seconds;
  }
  native_timeout.tv_usec = (long)(
      (timeout.nanoseconds % CHRONOMETRY_NANOSECONDS_PER_SECOND) /
      CHRONOMETRY_NANOSECONDS_PER_MICROSECOND);
  return NETWORK_POLLER_FUNC(_WaitNative)(
      poller, events, &native_timeout, error);
}
