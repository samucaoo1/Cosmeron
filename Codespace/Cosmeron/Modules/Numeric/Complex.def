/* Complex.def - Dual Mode Engine (Zero Duplication) */

#include "Impl/Common.inc"

#ifndef TEMPLATE_Numeric_Complex
#define TEMPLATE_Numeric_Complex(SUFFIX, TYPE)                                 \
  TEMPLATE_STRUCT(Numeric, Complex, SUFFIX,                                    \
      FIELDS(                                                                  \
          TYPE real;                                                           \
          TYPE imag;                                                           \
      )                                                                        \
  );                                                                           \
  TEMPLATE_PACKAGE(Numeric, Complex, SUFFIX,                                   \
      FUNCTION_INLINE(MODULE_TYPED(Numeric, Complex, SUFFIX), Make,            \
                      (TYPE real, TYPE imag), {                                \
        MODULE_TYPED(Numeric, Complex, SUFFIX) z;                              \
        z.real = real;                                                         \
        z.imag = imag;                                                         \
        return z;                                                              \
      }),                                                                      \
      FUNCTION_INLINE(MODULE_TYPED(Numeric, Complex, SUFFIX), Add,             \
                      (MODULE_TYPED(Numeric, Complex, SUFFIX) a,               \
                       MODULE_TYPED(Numeric, Complex, SUFFIX) b), {            \
        return MODULE_FUNC(Numeric, Complex, SUFFIX, Make)(a.real + b.real,    \
                                                           a.imag + b.imag);   \
      }),                                                                      \
      FUNCTION_INLINE(MODULE_TYPED(Numeric, Complex, SUFFIX), Sub,             \
                      (MODULE_TYPED(Numeric, Complex, SUFFIX) a,               \
                       MODULE_TYPED(Numeric, Complex, SUFFIX) b), {            \
        return MODULE_FUNC(Numeric, Complex, SUFFIX, Make)(a.real - b.real,    \
                                                           a.imag - b.imag);   \
      }),                                                                      \
      FUNCTION_INLINE(MODULE_TYPED(Numeric, Complex, SUFFIX), Mul,             \
                      (MODULE_TYPED(Numeric, Complex, SUFFIX) a,               \
                       MODULE_TYPED(Numeric, Complex, SUFFIX) b), {            \
        return MODULE_FUNC(Numeric, Complex, SUFFIX, Make)(                    \
            a.real * b.real - a.imag * b.imag,                                 \
            a.real * b.imag + a.imag * b.real);                                \
      }),                                                                      \
      VARIANT(Magnitude,                                                       \
          FUNCTION_INLINE(TYPE, Squared,                                       \
                          (MODULE_TYPED(Numeric, Complex, SUFFIX) z), {        \
            return z.real * z.real + z.imag * z.imag;                          \
          }),                                                                  \
          FUNCTION_INLINE(TYPE, (MODULE_TYPED(Numeric, Complex, SUFFIX) z), {  \
            const TYPE magSq = MODULE_FUNC(                                    \
                Numeric, Complex, SUFFIX, MagnitudeSquared)(z);                \
            if (magSq <= (TYPE)0) {                                            \
              return (TYPE)0;                                                  \
            }                                                                  \
            TYPE guess = magSq > (TYPE)1 ? magSq * (TYPE)0.5 : (TYPE)1;        \
            for (size_t i = 0U;                                                \
                 i < CNS(Numeric, Internal, MAX_SQRT_ITERATIONS); ++i) {       \
              const TYPE next = (TYPE)0.5 * (guess + magSq / guess);           \
              if (next == guess) {                                             \
                break;                                                         \
              }                                                                \
              guess = next;                                                    \
            }                                                                  \
            return guess;                                                      \
          })                                                                   \
      ),                                                                       \
      OPERATION_INLINE(Div,                                                    \
                       (MODULE_TYPED(Numeric, Complex, SUFFIX) a,              \
                        MODULE_TYPED(Numeric, Complex, SUFFIX) b,              \
                        MODULE_TYPED(Numeric, Complex, SUFFIX) *outValue), {   \
        if (!outValue) {                                                       \
          return STATUS_CONST(INVALID_ARGUMENT);                               \
        }                                                                      \
        const TYPE denom =                                                     \
            MODULE_FUNC(Numeric, Complex, SUFFIX, MagnitudeSquared)(b);        \
        if (denom == (TYPE)0) {                                                \
          return STATUS_CONST(INVALID_ARGUMENT);                               \
        }                                                                      \
        *outValue = MODULE_FUNC(Numeric, Complex, SUFFIX, Make)(               \
            (a.real * b.real + a.imag * b.imag) / denom,                       \
            (a.imag * b.real - a.real * b.imag) / denom);                      \
        return STATUS_CONST(SUCCESS);                                          \
      }),                                                                      \
      FUNCTION_INLINE(MODULE_TYPED(Numeric, Complex, SUFFIX), Conjugate,       \
                      (MODULE_TYPED(Numeric, Complex, SUFFIX) z), {            \
        return MODULE_FUNC(Numeric, Complex, SUFFIX, Make)(z.real, -z.imag);   \
      }),                                                                      \
      PREDICATE_INLINE(Equals,                                                 \
                       (MODULE_TYPED(Numeric, Complex, SUFFIX) a,              \
                        MODULE_TYPED(Numeric, Complex, SUFFIX) b), {           \
        return a.real == b.real && a.imag == b.imag;                           \
      })                                                                       \
  )
#endif

/* Mode 2 (Direct Include): Auto-instantiates and cleans up environment */
#if (!defined(COSMERON_INTERNAL_NO_AUTO_INSTANTIATE) && !defined(COSMERON_INTERNAL_IN_COMMON_INC)) && defined(SUFFIX) && defined(TYPE)
  TEMPLATE_Numeric_Complex(SUFFIX, TYPE);
  #undef SUFFIX
  #undef TYPE
#endif
