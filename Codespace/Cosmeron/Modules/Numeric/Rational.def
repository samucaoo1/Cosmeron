/* Rational.def - Dual Mode Engine (Zero Duplication) */

#include "Impl/Common.inc"

#ifndef TEMPLATE_Numeric_Rational
#define TEMPLATE_Numeric_Rational(SUFFIX, TYPE)                                \
  TEMPLATE_STRUCT(Numeric, Rational, SUFFIX,                                   \
      FIELDS(                                                                  \
          TYPE numerator;                                                      \
          TYPE denominator;                                                    \
      )                                                                        \
  );                                                                           \
  TEMPLATE_PACKAGE(Numeric, Rational, SUFFIX,                                  \
      FUNCTION_INLINE(TYPE, Gcd, (TYPE a, TYPE b), {                           \
        return (TYPE)MODULE_IFUNC(Numeric, Gcd64)((int64_t)a, (int64_t)b);     \
      }),                                                                      \
      OPERATION_INLINE(Make,                                                   \
                       (TYPE numerator, TYPE denominator,                      \
                        MODULE_TYPED(Numeric, Rational, SUFFIX) *outValue), {  \
        if (!outValue || denominator == (TYPE)0) {                             \
          return STATUS_CONST(INVALID_ARGUMENT);                               \
        }                                                                      \
        if (denominator < (TYPE)0) {                                           \
          numerator = -numerator;                                              \
          denominator = -denominator;                                          \
        }                                                                      \
        const TYPE g = MODULE_FUNC(Numeric, Rational, SUFFIX, Gcd)(            \
            numerator, denominator);                                           \
        outValue->numerator = numerator / g;                                   \
        outValue->denominator = denominator / g;                               \
        return STATUS_CONST(SUCCESS);                                          \
      }),                                                                      \
      OPERATION_INLINE(Add,                                                    \
                       (MODULE_TYPED(Numeric, Rational, SUFFIX) a,             \
                        MODULE_TYPED(Numeric, Rational, SUFFIX) b,             \
                        MODULE_TYPED(Numeric, Rational, SUFFIX) *outValue), {  \
        if (!outValue || a.denominator == (TYPE)0 || b.denominator == (TYPE)0) {\
          return STATUS_CONST(INVALID_ARGUMENT);                               \
        }                                                                      \
        const TYPE g = MODULE_FUNC(Numeric, Rational, SUFFIX, Gcd)(            \
            a.denominator, b.denominator);                                     \
        const TYPE num = a.numerator * (b.denominator / g) +                   \
                         b.numerator * (a.denominator / g);                    \
        const TYPE den = (a.denominator / g) * b.denominator;                  \
        return MODULE_FUNC(Numeric, Rational, SUFFIX, Make)(num, den,          \
                                                            outValue);         \
      }),                                                                      \
      OPERATION_INLINE(Sub,                                                    \
                       (MODULE_TYPED(Numeric, Rational, SUFFIX) a,             \
                        MODULE_TYPED(Numeric, Rational, SUFFIX) b,             \
                        MODULE_TYPED(Numeric, Rational, SUFFIX) *outValue), {  \
        MODULE_TYPED(Numeric, Rational, SUFFIX) negB;                          \
        negB.numerator = -b.numerator;                                         \
        negB.denominator = b.denominator;                                      \
        return MODULE_FUNC(Numeric, Rational, SUFFIX, Add)(a, negB, outValue); \
      }),                                                                      \
      OPERATION_INLINE(Mul,                                                    \
                       (MODULE_TYPED(Numeric, Rational, SUFFIX) a,             \
                        MODULE_TYPED(Numeric, Rational, SUFFIX) b,             \
                        MODULE_TYPED(Numeric, Rational, SUFFIX) *outValue), {  \
        if (!outValue || a.denominator == (TYPE)0 || b.denominator == (TYPE)0) {\
          return STATUS_CONST(INVALID_ARGUMENT);                               \
        }                                                                      \
        const TYPE g1 = MODULE_FUNC(Numeric, Rational, SUFFIX, Gcd)(           \
            a.numerator, b.denominator);                                       \
        const TYPE g2 = MODULE_FUNC(Numeric, Rational, SUFFIX, Gcd)(           \
            b.numerator, a.denominator);                                       \
        const TYPE num = (a.numerator / g1) * (b.numerator / g2);              \
        const TYPE den = (a.denominator / g2) * (b.denominator / g1);          \
        return MODULE_FUNC(Numeric, Rational, SUFFIX, Make)(num, den,          \
                                                            outValue);         \
      }),                                                                      \
      OPERATION_INLINE(Div,                                                    \
                       (MODULE_TYPED(Numeric, Rational, SUFFIX) a,             \
                        MODULE_TYPED(Numeric, Rational, SUFFIX) b,             \
                        MODULE_TYPED(Numeric, Rational, SUFFIX) *outValue), {  \
        if (!outValue || b.numerator == (TYPE)0 || b.denominator == (TYPE)0) { \
          return STATUS_CONST(INVALID_ARGUMENT);                               \
        }                                                                      \
        MODULE_TYPED(Numeric, Rational, SUFFIX) inv;                           \
        inv.numerator = b.denominator;                                         \
        inv.denominator = b.numerator;                                         \
        return MODULE_FUNC(Numeric, Rational, SUFFIX, Mul)(a, inv, outValue);  \
      }),                                                                      \
      COMPARISON_INLINE(Compare,                                               \
                        (MODULE_TYPED(Numeric, Rational, SUFFIX) a,            \
                         MODULE_TYPED(Numeric, Rational, SUFFIX) b), {         \
        const TYPE lhs = a.numerator * b.denominator;                          \
        const TYPE rhs = b.numerator * a.denominator;                          \
        if (lhs < rhs) {                                                       \
          return COMPARISON_CONST(LOWER);                                      \
        }                                                                      \
        if (lhs > rhs) {                                                       \
          return COMPARISON_CONST(HIGHER);                                     \
        }                                                                      \
        return COMPARISON_CONST(EQUAL);                                        \
      }),                                                                      \
      FUNCTION_INLINE(double, ToFloat64,                                       \
                      (MODULE_TYPED(Numeric, Rational, SUFFIX) value), {       \
        if (value.denominator == (TYPE)0) {                                    \
          return 0.0;                                                          \
        }                                                                      \
        return (double)value.numerator / (double)value.denominator;            \
      })                                                                       \
  )
#endif

/* Mode 2 (Direct Include): Auto-instantiates and cleans up environment */
#if (!defined(COSMERON_INTERNAL_NO_AUTO_INSTANTIATE) && !defined(COSMERON_INTERNAL_IN_COMMON_INC)) && defined(SUFFIX) && defined(TYPE)
  TEMPLATE_Numeric_Rational(SUFFIX, TYPE);
  #undef SUFFIX
  #undef TYPE
#endif
