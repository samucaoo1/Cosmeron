#include "../../Core/Algorithm/Comparison.h"
#include "../../Core/Condition/Status.h"
#include "../../Core/Module/Module.h"

#define TEMPLATE_Numeric_Rational(SUFFIX, TYPE)                                \
  MODULE(Numeric,                                                              \
      STRUCT(PP_OP_CAT2(Rational_, SUFFIX),                                    \
          FIELDS(                                                              \
              TYPE numerator;                                                  \
              TYPE denominator;                                                \
          )                                                                    \
      )                                                                        \
  );                                                                           \
  static inline TYPE MODULE_FUNC(Numeric, Rational, Gcd, SUFFIX)(TYPE a,       \
                                                                 TYPE b) {     \
    if (a < 0) {                                                               \
      a = -a;                                                                  \
    }                                                                          \
    if (b < 0) {                                                               \
      b = -b;                                                                  \
    }                                                                          \
    while (b != 0) {                                                           \
      TYPE t = a % b;                                                          \
      a = b;                                                                   \
      b = t;                                                                   \
    }                                                                          \
    return a == 0 ? 1 : a;                                                     \
  }                                                                            \
  static inline OPSTATUS MODULE_FUNC(Numeric, Rational, Make, SUFFIX)(         \
      TYPE numerator, TYPE denominator,                                        \
      MODULE_TYPED(Numeric, Rational, SUFFIX) *outValue) {                     \
    if (!outValue || denominator == 0) {                                       \
      return STATUS_CONST(INVALID_ARGUMENT);                                   \
    }                                                                          \
    if (denominator < 0) {                                                     \
      numerator = -numerator;                                                  \
      denominator = -denominator;                                              \
    }                                                                          \
    TYPE g = MODULE_FUNC(Numeric, Rational, Gcd, SUFFIX)(numerator,            \
                                                         denominator);         \
    outValue->numerator = numerator / g;                                       \
    outValue->denominator = denominator / g;                                   \
    return STATUS_CONST(SUCCESS);                                              \
  }                                                                            \
  static inline OPSTATUS MODULE_FUNC(Numeric, Rational, Add, SUFFIX)(          \
      MODULE_TYPED(Numeric, Rational, SUFFIX) a,                               \
      MODULE_TYPED(Numeric, Rational, SUFFIX) b,                               \
      MODULE_TYPED(Numeric, Rational, SUFFIX) *outValue) {                     \
    if (!outValue || a.denominator == 0 || b.denominator == 0) {               \
      return STATUS_CONST(INVALID_ARGUMENT);                                   \
    }                                                                          \
    TYPE g = MODULE_FUNC(Numeric, Rational, Gcd, SUFFIX)(a.denominator,        \
                                                         b.denominator);       \
    TYPE num = a.numerator * (b.denominator / g) +                             \
               b.numerator * (a.denominator / g);                              \
    TYPE den = (a.denominator / g) * b.denominator;                            \
    return MODULE_FUNC(Numeric, Rational, Make, SUFFIX)(num, den, outValue);   \
  }                                                                            \
  static inline OPSTATUS MODULE_FUNC(Numeric, Rational, Sub, SUFFIX)(          \
      MODULE_TYPED(Numeric, Rational, SUFFIX) a,                               \
      MODULE_TYPED(Numeric, Rational, SUFFIX) b,                               \
      MODULE_TYPED(Numeric, Rational, SUFFIX) *outValue) {                     \
    if (!outValue || a.denominator == 0 || b.denominator == 0) {               \
      return STATUS_CONST(INVALID_ARGUMENT);                                   \
    }                                                                          \
    TYPE g = MODULE_FUNC(Numeric, Rational, Gcd, SUFFIX)(a.denominator,        \
                                                         b.denominator);       \
    TYPE num = a.numerator * (b.denominator / g) -                             \
               b.numerator * (a.denominator / g);                              \
    TYPE den = (a.denominator / g) * b.denominator;                            \
    return MODULE_FUNC(Numeric, Rational, Make, SUFFIX)(num, den, outValue);   \
  }                                                                            \
  static inline OPSTATUS MODULE_FUNC(Numeric, Rational, Mul, SUFFIX)(          \
      MODULE_TYPED(Numeric, Rational, SUFFIX) a,                               \
      MODULE_TYPED(Numeric, Rational, SUFFIX) b,                               \
      MODULE_TYPED(Numeric, Rational, SUFFIX) *outValue) {                     \
    if (!outValue || a.denominator == 0 || b.denominator == 0) {               \
      return STATUS_CONST(INVALID_ARGUMENT);                                   \
    }                                                                          \
    TYPE g1 = MODULE_FUNC(Numeric, Rational, Gcd, SUFFIX)(a.numerator,         \
                                                          b.denominator);      \
    TYPE g2 = MODULE_FUNC(Numeric, Rational, Gcd, SUFFIX)(b.numerator,         \
                                                          a.denominator);      \
    TYPE num = (a.numerator / g1) * (b.numerator / g2);                        \
    TYPE den = (a.denominator / g2) * (b.denominator / g1);                    \
    return MODULE_FUNC(Numeric, Rational, Make, SUFFIX)(num, den, outValue);   \
  }                                                                            \
  static inline OPSTATUS MODULE_FUNC(Numeric, Rational, Div, SUFFIX)(          \
      MODULE_TYPED(Numeric, Rational, SUFFIX) a,                               \
      MODULE_TYPED(Numeric, Rational, SUFFIX) b,                               \
      MODULE_TYPED(Numeric, Rational, SUFFIX) *outValue) {                     \
    if (!outValue || b.numerator == 0) {                                       \
      return STATUS_CONST(INVALID_ARGUMENT);                                   \
    }                                                                          \
    MODULE_TYPED(Numeric, Rational, SUFFIX) inv = {                            \
        .numerator = b.denominator,                                            \
        .denominator = b.numerator,                                            \
    };                                                                         \
    return MODULE_FUNC(Numeric, Rational, Mul, SUFFIX)(a, inv, outValue);      \
  }                                                                            \
  static inline CMPOUT MODULE_FUNC(Numeric, Rational, Compare, SUFFIX)(        \
      MODULE_TYPED(Numeric, Rational, SUFFIX) a,                               \
      MODULE_TYPED(Numeric, Rational, SUFFIX) b) {                             \
    TYPE lhs = a.numerator * b.denominator;                                    \
    TYPE rhs = b.numerator * a.denominator;                                    \
    if (lhs < rhs) {                                                           \
      return COMPARISON_CONST(LOWER);                                          \
    }                                                                          \
    if (lhs > rhs) {                                                           \
      return COMPARISON_CONST(HIGHER);                                         \
    }                                                                          \
    return COMPARISON_CONST(EQUAL);                                            \
  }                                                                            \
  static inline double MODULE_FUNC(Numeric, Rational, ToFloat64, SUFFIX)(      \
      MODULE_TYPED(Numeric, Rational, SUFFIX) value) {                         \
    return (double)value.numerator / (double)value.denominator;                \
  }

#if defined(SUFFIX) && defined(TYPE)
TEMPLATE_Numeric_Rational(SUFFIX, TYPE)
#undef SUFFIX
#undef TYPE
#endif

/* EOF */
