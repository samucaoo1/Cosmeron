#pragma once
PARSING_SLICE_CREATE_PROTOTYPE {
  return PARSING_INS(Slice)(data, size);
}

PARSING_SLICE_EQUAL_PROTOTYPE {
  return (!left.size || left.data) && (!right.size || right.data) && PARSING_INS(Equal)(left, right);
}
PARSING_SLICE_U64_PROTOTYPE {
  uint64_t value = 0;
  size_t i;
  if (!outValue || !text.data || !text.size) return STATUS_CONST(INVALID_ARGUMENT);
  for (i = 0; i < text.size; ++i) {
    unsigned digit = (unsigned)(unsigned char)text.data[i] - (unsigned)'0';
    if (digit > 9) return STATUS_CONST(INVALID_SEQUENCE);
    if (value > (UINT64_MAX - digit) / 10) return STATUS_CONST(OUT_OF_RANGE);
    value = value * 10 + digit;
  }
  *outValue = value;
  return STATUS_CONST(SUCCESS);
}
PARSING_SLICE_I64_PROTOTYPE {
  uint64_t value;
  bool negative;
  OPSTATUS status;
  if (!outValue || !text.data || !text.size) return STATUS_CONST(INVALID_ARGUMENT);
  negative = text.data[0] == '-';
  if (negative || text.data[0] == '+') {
    ++text.data;
    --text.size;
  }
  if (!text.size) return STATUS_CONST(INVALID_SEQUENCE);
  status = PARSING_FUNC(Slice_U64)(text, &value);
  if (status != STATUS_CONST(SUCCESS)) return status;
  if (value > (uint64_t)INT64_MAX + (negative ? 1u : 0u)) return STATUS_CONST(OUT_OF_RANGE);
  *outValue = negative ? (value == (uint64_t)INT64_MAX + 1u ? INT64_MIN : -(int64_t)value) : (int64_t)value;
  return STATUS_CONST(SUCCESS);
}
PARSING_SLICE_F64_PROTOTYPE {
  size_t i = 0, digits = 0;
  PARSING_INS(Buffer) buffer = {0};
  const char *decimal;
  char *end;
  double value;
  OPSTATUS status;
  if (!outValue || !text.data || !text.size) return STATUS_CONST(INVALID_ARGUMENT);
  if (text.data[i] == '+' || text.data[i] == '-') ++i;
  while (i < text.size && text.data[i] >= '0' && text.data[i] <= '9') {
    ++i;
    ++digits;
  }
  if (i < text.size && text.data[i] == '.') {
    ++i;
    while (i < text.size && text.data[i] >= '0' && text.data[i] <= '9') {
      ++i;
      ++digits;
    }
  }
  if (!digits) return STATUS_CONST(INVALID_SEQUENCE);
  if (i < text.size && (text.data[i] == 'e' || text.data[i] == 'E')) {
    size_t start;
    ++i;
    if (i < text.size && (text.data[i] == '+' || text.data[i] == '-')) ++i;
    start = i;
    while (i < text.size && text.data[i] >= '0' && text.data[i] <= '9') ++i;
    if (start == i) return STATUS_CONST(INVALID_SEQUENCE);
  }
  if (i != text.size) return STATUS_CONST(INVALID_SEQUENCE);
  decimal = localeconv()->decimal_point;
  for (i = 0; i < text.size; ++i) {
    status = text.data[i] == '.' ? PARSING_INS(Append)(&buffer, decimal, strlen(decimal)) : PARSING_INS(Append)(&buffer, text.data + i, 1);
    if (status != STATUS_CONST(SUCCESS)) {
      free(buffer.data);
      return status;
    }
  }
  errno = 0;
  value = strtod(buffer.data, &end);
  status = errno == ERANGE ? STATUS_CONST(OUT_OF_RANGE) : (*end ? STATUS_CONST(INVALID_SEQUENCE) : STATUS_CONST(SUCCESS));
  free(buffer.data);
  if (status == STATUS_CONST(SUCCESS)) *outValue = value;
  return status;
}

PARSING_SLICE_BOOL_PROTOTYPE {
  if (!outValue || (!text.data && text.size)) return STATUS_CONST(INVALID_ARGUMENT);
  if (PARSING_INS(Equal)(text, PARSING_INS(Slice)("true", 4))) *outValue = true;
  else if (PARSING_INS(Equal)(text, PARSING_INS(Slice)("false", 5))) *outValue = false;
  else return STATUS_CONST(INVALID_SEQUENCE);
  return STATUS_CONST(SUCCESS);
}

static inline int PARSING_INS(Hex)(char c) {
  if (c >= '0' && c <= '9') return c - '0';
  if (c >= 'a' && c <= 'f') return c - 'a' + 10;
  if (c >= 'A' && c <= 'F') return c - 'A' + 10;
  return -1;
}

/* TOML/YAML escapes encode Unicode scalar values, not JSON surrogate pairs. */
static inline OPSTATUS PARSING_INS(UnicodeEscape)(PARSING_INS(Cursor) *cursor,
size_t digits, PARSING_INS(Buffer) *buffer) {
  uint32_t codepoint = 0;
  size_t i, units;
  unsigned char encoded[4];
  OPSTATUS status;
  if (cursor->size - cursor->position < digits) return STATUS_CONST(INCOMPLETE_SEQUENCE);
  for (i = 0; i < digits; ++i) {
    int digit = PARSING_INS(Hex)(cursor->source[cursor->position]);
    if (digit < 0) return STATUS_CONST(INVALID_SEQUENCE);
    codepoint = codepoint * 16u + (unsigned)digit;
    ++cursor->position;
  }
  if (codepoint > 0x10ffffu || (codepoint >= 0xd800u && codepoint <= 0xdfffu))
    return STATUS_CONST(INVALID_SEQUENCE);
  status = TEXT_UTF8_FUNC(Encode)(codepoint, encoded, sizeof(encoded), &units);
  return status == STATUS_CONST(SUCCESS) ?
    PARSING_INS(Append)(buffer, (const char *)encoded, units) : status;
}
