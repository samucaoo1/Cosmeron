#pragma once
#include "../../Core/Namespace.h"
#include "../../Core/Error/Status.h"
#include "../../Core/Memory/Alloc.h"
#include "../Text/Encoding/UTF8.h"
#include <errno.h>
#include <float.h>
#include <locale.h>
#include <stdio.h>
#include <string.h>

#define PARSING_MOD Parsing
#define PARSING_CMOD PARSING
#ifndef PARSING_NS
#define PARSING_NS(NAME) GNS2(LIB_PREFIX(PARSING_MOD), NAME)
#endif
#ifndef PARSING_CNS
#define PARSING_CNS(NAME) CNS2(LIB_PREFIX_CONST(PARSING_CMOD), NAME)
#endif
#define PARSING_INS(NAME) GNS2(PARSING_NS(Internal), NAME)
#define PARSING_TYPE(NAME) PARSING_NS(NAME)
#define PARSING_FUNC(NAME) PARSING_NS(NAME)
#define PARSING_CONST(NAME) PARSING_CNS(NAME)

typedef struct PARSING_TYPE(TSlice) { const char *data; size_t size; } PARSING_TYPE(TSlice);
typedef enum PARSING_TYPE(DiagnosticCode) {
  PARSING_CONST(DIAGNOSTIC_NONE), PARSING_CONST(DIAGNOSTIC_SYNTAX),
  PARSING_CONST(DIAGNOSTIC_ENCODING), PARSING_CONST(DIAGNOSTIC_DUPLICATE),
  PARSING_CONST(DIAGNOSTIC_DEPTH), PARSING_CONST(DIAGNOSTIC_LIMIT),
  PARSING_CONST(DIAGNOSTIC_UNSUPPORTED)
} PARSING_TYPE(DiagnosticCode);
typedef struct PARSING_TYPE(TDiagnostic) {
  PARSING_TYPE(DiagnosticCode) code;
  size_t offset, line, column;
} PARSING_TYPE(TDiagnostic);
typedef struct PARSING_TYPE(TLimits) { size_t maxDepth, maxNodes, maxBytes; } PARSING_TYPE(TLimits);
enum { PARSING_CONST(DEFAULT_DEPTH) = 64, PARSING_CONST(DEFAULT_NODES) = 100000,
       PARSING_CONST(DEFAULT_BYTES) = 16777216 };
typedef struct PARSING_INS(Buffer) { char *data; size_t size, capacity; } PARSING_INS(Buffer);
typedef struct PARSING_INS(Cursor) {
  const char *source; size_t size, position, nodes;
  PARSING_TYPE(TLimits) limits;
  PARSING_TYPE(TDiagnostic) *diagnostic;
} PARSING_INS(Cursor);

static inline PARSING_TYPE(TSlice) PARSING_INS(Slice)(const char *data, size_t size) {
  PARSING_TYPE(TSlice) slice; slice.data = data; slice.size = size; return slice;
}
static inline OPSTATUS PARSING_INS(Append)(PARSING_INS(Buffer) *buffer, const char *data, size_t size) {
  size_t required, capacity; void *memory; OPSTATUS status;
  if (!buffer) return STATUS_CONST(SUCCESS);
  if (size > SIZE_MAX - buffer->size - 1) return STATUS_CONST(OUT_OF_RANGE);
  required = buffer->size + size + 1;
  if (required > buffer->capacity) {
    capacity = buffer->capacity ? buffer->capacity : 64;
    while (capacity < required) { if (capacity > SIZE_MAX / 2) { capacity = required; break; } capacity *= 2; }
    memory = buffer->data; status = MEMORY_FUNC(ReallocBytes)(&memory, capacity);
    if (status != STATUS_CONST(SUCCESS)) return status;
    buffer->data = (char *)memory; buffer->capacity = capacity;
  }
  if (size) memcpy(buffer->data + buffer->size, data, size);
  buffer->size += size; buffer->data[buffer->size] = '\0'; return STATUS_CONST(SUCCESS);
}
static inline OPSTATUS PARSING_INS(Copy)(PARSING_TYPE(TSlice) input, char **out) {
  PARSING_INS(Buffer) buffer = {0}; OPSTATUS status = PARSING_INS(Append)(&buffer, input.data, input.size);
  if (status == STATUS_CONST(SUCCESS)) *out = buffer.data;
  return status;
}
static inline OPSTATUS PARSING_INS(Output)(PARSING_INS(Buffer) *buffer, char *output,
    size_t capacity, size_t *outSize) {
  OPSTATUS status = STATUS_CONST(SUCCESS);
  if (!outSize || (!output && capacity)) status = STATUS_CONST(INVALID_ARGUMENT);
  else {
    *outSize = buffer->size;
    if (!output || capacity <= buffer->size) status = STATUS_CONST(INSUFFICIENT_SPACE);
    else { if (buffer->size) memmove(output, buffer->data, buffer->size); output[buffer->size] = '\0'; }
  }
  free(buffer->data); return status;
}
static inline bool PARSING_INS(Space)(char c) { return c == ' ' || c == '\t' || c == '\r' || c == '\n'; }
static inline PARSING_TYPE(TSlice) PARSING_INS(Trim)(PARSING_TYPE(TSlice) slice) {
  while (slice.size && PARSING_INS(Space)(slice.data[0])) { ++slice.data; --slice.size; }
  while (slice.size && PARSING_INS(Space)(slice.data[slice.size - 1])) --slice.size;
  return slice;
}
static inline bool PARSING_INS(Equal)(PARSING_TYPE(TSlice) a, PARSING_TYPE(TSlice) b) {
  return a.size == b.size && (!a.size || !memcmp(a.data, b.data, a.size));
}
static inline OPSTATUS PARSING_INS(Fail)(PARSING_INS(Cursor) *cursor,
    PARSING_TYPE(DiagnosticCode) code, OPSTATUS status) {
  if (cursor->diagnostic) {
    size_t i, line = 1, column = 1;
    for (i = 0; i < cursor->position && i < cursor->size; ++i) {
      if (cursor->source[i] == '\r') { ++line; column = 1; }
      else if (cursor->source[i] == '\n') { if (!i || cursor->source[i-1] != '\r') ++line; column = 1; }
      else ++column;
    }
    cursor->diagnostic->code = code; cursor->diagnostic->offset = cursor->position;
    cursor->diagnostic->line = line; cursor->diagnostic->column = column;
  }
  return status;
}
static inline OPSTATUS PARSING_INS(CursorCreate)(const char *source, size_t size,
    const PARSING_TYPE(TLimits) *limits, PARSING_TYPE(TDiagnostic) *diagnostic,
    PARSING_INS(Cursor) *out) {
  PARSING_INS(Cursor) cursor = {0};
  if ((!source && size) || !out) return STATUS_CONST(INVALID_ARGUMENT);
  cursor.source = source ? source : ""; cursor.size = size; cursor.diagnostic = diagnostic;
  cursor.limits.maxDepth = PARSING_CONST(DEFAULT_DEPTH);
  cursor.limits.maxNodes = PARSING_CONST(DEFAULT_NODES);
  cursor.limits.maxBytes = PARSING_CONST(DEFAULT_BYTES);
  if (limits) cursor.limits = *limits;
  if (!cursor.limits.maxDepth || cursor.limits.maxDepth > PARSING_CONST(DEFAULT_DEPTH) || !cursor.limits.maxNodes || !cursor.limits.maxBytes)
    return STATUS_CONST(INVALID_ARGUMENT);
  if (size > cursor.limits.maxBytes) return PARSING_INS(Fail)(&cursor, PARSING_CONST(DIAGNOSTIC_LIMIT), STATUS_CONST(OUT_OF_RANGE));
  if (!TEXT_UTF8_FUNC(Validate)((const unsigned char *)cursor.source, size)) {
    /* Locate the first invalid code unit rather than reporting the whole buffer. */
    size_t units; TEXT_TYPE(TChar32) cp;
    while (cursor.position < size && TEXT_UTF8_FUNC(Decode)((const unsigned char *)cursor.source + cursor.position,
        size - cursor.position, &cp, &units) == STATUS_CONST(SUCCESS)) cursor.position += units;
    return PARSING_INS(Fail)(&cursor, PARSING_CONST(DIAGNOSTIC_ENCODING), STATUS_CONST(INVALID_SEQUENCE));
  }
  if (size >= 3 && !memcmp(cursor.source, "\xef\xbb\xbf", 3)) cursor.position = 3;
  *out = cursor; return STATUS_CONST(SUCCESS);
}
static inline bool PARSING_INS(Line)(PARSING_INS(Cursor) *cursor, PARSING_TYPE(TSlice) *out) {
  size_t start = cursor->position;
  if (start >= cursor->size) return false;
  while (cursor->position < cursor->size && cursor->source[cursor->position] != '\n' && cursor->source[cursor->position] != '\r') ++cursor->position;
  *out = PARSING_INS(Slice)(cursor->source + start, cursor->position - start);
  if (cursor->position < cursor->size && cursor->source[cursor->position++] == '\r' && cursor->position < cursor->size && cursor->source[cursor->position] == '\n') ++cursor->position;
  return true;
}
