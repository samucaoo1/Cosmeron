#pragma once
static inline void PARSING_INS(YAMLFreeValue)(PARSING_TYPE(TYAMLValue) *value) {
  if (value) {
    PARSING_TYPE(TYAMLValue) *child = value->first;
    while (child) {
      PARSING_TYPE(TYAMLValue) *next = child->next;
      PARSING_INS(YAMLFreeValue)(child);
      child = next;
    }
    free(value->key);
    free(value->text);
    free(value);
  }
}

PARSING_YAML_FREE_PROTOTYPE {
  if (document) {
    PARSING_INS(YAMLFreeValue)(document->root);
    document->root = NULL;
  }
}

static inline OPSTATUS PARSING_INS(YAMLError)(PARSING_INS(Cursor) *cursor, OPSTATUS status) {
  return PARSING_INS(Fail)(cursor, status == STATUS_CONST(NOT_SUPPORTED) ? PARSING_CONST(DIAGNOSTIC_UNSUPPORTED) :
  (status == STATUS_CONST(ALREADY_EXISTS) ? PARSING_CONST(DIAGNOSTIC_DUPLICATE) : PARSING_CONST(DIAGNOSTIC_SYNTAX)), status);
}

static inline OPSTATUS PARSING_INS(YAMLNew)(PARSING_INS(Cursor) *cursor, PARSING_TYPE(YAMLKind) kind, PARSING_TYPE(TYAMLValue) **out) {
  void *memory;
  OPSTATUS status;
  if (++cursor->nodes > cursor->limits.maxNodes) return PARSING_INS(Fail)(cursor, PARSING_CONST(DIAGNOSTIC_LIMIT), STATUS_CONST(OUT_OF_RANGE));
  status = MEMORY_FUNC(AllocBytes)(&memory, sizeof(**out));
  if (status != STATUS_CONST(SUCCESS)) return status;
  *out = (PARSING_TYPE(TYAMLValue) *)memory;
  memset(*out, 0, sizeof(**out));
  (*out)->kind = kind;
  return STATUS_CONST(SUCCESS);
}

static inline OPSTATUS PARSING_INS(YAMLLine)(PARSING_INS(Cursor) *cursor, PARSING_TYPE(TSlice) *outLine, size_t *outIndent, bool *outEnd) {
  PARSING_TYPE(TSlice) line;
  while (PARSING_INS(Line)(cursor, &line)) {
    size_t indent = 0, i;
    char quote = 0;
    while (indent < line.size && line.data[indent] == ' ') ++indent;
    if (indent < line.size && line.data[indent] == '\t') return PARSING_INS(YAMLError)(cursor, STATUS_CONST(INVALID_SEQUENCE));
    line.data += indent;
    line.size -= indent;
    if (!line.size || line.data[0] == '#') continue;
    for (i = 0; i < line.size; ++i) {
      char c = line.data[i];
      if (quote == '"' && c == '\\') {
        if (++i >= line.size) return PARSING_INS(YAMLError)(cursor, STATUS_CONST(INCOMPLETE_SEQUENCE));
        continue;
      }
      if (quote) {
        if (c == quote) {
          if (quote == '\'' && i+1 < line.size && line.data[i+1] == '\'') ++i;
          else quote = 0;
        }
      } else if ((c == '"' || c == '\'') && (i == 0 || line.data[i-1] == ' ' || line.data[i-1] == ':')) quote = c;
      else if (c == '#' && (!i || PARSING_INS(Space)(line.data[i-1]))) {
        line.size = i;
        break;
      }
      if ((unsigned char)c < 0x20 && c != '\t') return PARSING_INS(YAMLError)(cursor, STATUS_CONST(INVALID_SEQUENCE));
    }
    if (quote) return PARSING_INS(YAMLError)(cursor, STATUS_CONST(NOT_SUPPORTED));
    while (line.size && PARSING_INS(Space)(line.data[line.size-1])) --line.size;
    if (!line.size) continue;
    if (PARSING_INS(Equal)(line, PARSING_INS(Slice)("---", 3)) || PARSING_INS(Equal)(line, PARSING_INS(Slice)("...", 3)) || line.data[0] == '%') return PARSING_INS(YAMLError)(cursor, STATUS_CONST(NOT_SUPPORTED));
    *outLine = line;
    *outIndent = indent;
    *outEnd = false;
    return STATUS_CONST(SUCCESS);
  }
  *outEnd = true;
  return STATUS_CONST(SUCCESS);
}

static inline size_t PARSING_INS(YAMLColon)(PARSING_TYPE(TSlice) line) {
  size_t i;
  char quote = 0;
  for (i = 0; i < line.size; ++i) {
    char c = line.data[i];
    if (quote == '"' && c == '\\') {
      ++i;
      continue;
    }
    if (quote) {
      if (c == quote) {
        if (quote == '\'' && i+1 < line.size && line.data[i+1] == '\'') ++i;
        else quote = 0;
      }
    } else if (c == '\'' || c == '"') quote = c;
    else if (c == ':' && (i+1 == line.size || PARSING_INS(Space)(line.data[i+1]))) return i;
  }
  return SIZE_MAX;
}

static inline OPSTATUS PARSING_INS(YAMLText)(PARSING_INS(Cursor) *cursor, PARSING_TYPE(TSlice) source,
char **out, size_t *outSize, bool *outQuoted) {
  source = PARSING_INS(Trim)(source);
  *outQuoted = false;
  if (!source.size) {
    *outSize = 0;
    return PARSING_INS(Copy)(source, out);
  }
  if (strchr("&*!|>{[?%@`", source.data[0]) || PARSING_INS(YAMLColon)(source) != SIZE_MAX) return PARSING_INS(YAMLError)(cursor, STATUS_CONST(NOT_SUPPORTED));
  if (source.data[0] == '"') {
    PARSING_INS(Cursor) string = *cursor;
    OPSTATUS status;
    string.source = source.data;
    string.size = source.size;
    string.position = 0;
    string.diagnostic = NULL;
    /* YAML has additional escapes; unsupported ones must not be accepted as plain text. */
    { size_t index;
      for (index = 1; index + 1 < source.size; ++index) {
        if (source.data[index] == '\\') {
          ++index;
          if (!strchr("\"\\/bfnrtu", source.data[index]))
            return PARSING_INS(YAMLError)(cursor, STATUS_CONST(NOT_SUPPORTED));
        }
      }
    }
    status = PARSING_INS(JSONString)(&string, out, outSize);
    if (status != STATUS_CONST(SUCCESS)) return PARSING_INS(YAMLError)(cursor, status);
    if (string.position != source.size) {
      free(*out);
      *out = NULL;
      return PARSING_INS(YAMLError)(cursor, STATUS_CONST(INVALID_SEQUENCE));
    }
    *outQuoted = true;
    return STATUS_CONST(SUCCESS);
  }
  if (source.data[0] == '\'') {
    PARSING_INS(Buffer) text = {0};
    size_t i;
    OPSTATUS status = STATUS_CONST(SUCCESS);
    if (source.size < 2 || source.data[source.size-1] != '\'') return PARSING_INS(YAMLError)(cursor, STATUS_CONST(INCOMPLETE_SEQUENCE));
    for (i = 1; status == STATUS_CONST(SUCCESS) && i+1 < source.size; ++i) {
      if (source.data[i] == '\'') {
        if (i+2 >= source.size || source.data[i+1] != '\'') {
          status = STATUS_CONST(INVALID_SEQUENCE);
          break;
        }
        ++i;
      }
      status = PARSING_INS(Append)(&text, source.data+i, 1);
    }
    if (status == STATUS_CONST(SUCCESS)) status = PARSING_INS(Append)(&text, "", 0);
    if (status != STATUS_CONST(SUCCESS)) {
      free(text.data);
      return PARSING_INS(YAMLError)(cursor, status);
    }
    *out = text.data;
    *outSize = text.size;
    *outQuoted = true;
    return STATUS_CONST(SUCCESS);
  }
  if ((source.data[0] == '-' || source.data[0] == ':' || source.data[0] == '?') && (source.size == 1 || PARSING_INS(Space)(source.data[1]))) return PARSING_INS(YAMLError)(cursor, STATUS_CONST(NOT_SUPPORTED));
  *outSize = source.size;
  return PARSING_INS(Copy)(source, out);
}

static inline bool PARSING_INS(YAMLSequence)(PARSING_TYPE(TSlice) line) {
  return line.size && line.data[0] == '-' && (line.size == 1 || PARSING_INS(Space)(line.data[1]));
}

static inline OPSTATUS PARSING_INS(YAMLBlock)(PARSING_INS(Cursor) *cursor, size_t indent, size_t depth,
PARSING_TYPE(TYAMLValue) **out) {
  PARSING_TYPE(TYAMLValue) *value;
  PARSING_INS(Cursor) look;
  PARSING_TYPE(TSlice) line;
  size_t nextIndent;
  bool end;
  OPSTATUS status;
  if (depth >= cursor->limits.maxDepth) return PARSING_INS(Fail)(cursor, PARSING_CONST(DIAGNOSTIC_DEPTH), STATUS_CONST(OUT_OF_RANGE));
  look = *cursor;
  status = PARSING_INS(YAMLLine)(&look, &line, &nextIndent, &end);
  if (status != STATUS_CONST(SUCCESS)) return status;
  if (end) return PARSING_INS(YAMLError)(cursor, STATUS_CONST(INCOMPLETE_SEQUENCE));
  status = PARSING_INS(YAMLNew)(cursor, PARSING_INS(YAMLSequence)(line) ? PARSING_CONST(YAML_SEQUENCE) :
  (PARSING_INS(YAMLColon)(line) != SIZE_MAX ? PARSING_CONST(YAML_MAPPING) : PARSING_CONST(YAML_SCALAR)), &value);
  if (status != STATUS_CONST(SUCCESS)) return status;
  if (value->kind == PARSING_CONST(YAML_SCALAR) && (PARSING_INS(Equal)(line, PARSING_INS(Slice)("{}", 2)) || PARSING_INS(Equal)(line, PARSING_INS(Slice)("[]", 2)))) {
    value->kind = line.data[0] == '{' ? PARSING_CONST(YAML_MAPPING) : PARSING_CONST(YAML_SEQUENCE);
    look.nodes = cursor->nodes;
    *cursor = look;
    *out = value;
    return STATUS_CONST(SUCCESS);
  }
  if (value->kind == PARSING_CONST(YAML_SCALAR)) {
    status = PARSING_INS(YAMLText)(cursor, line, &value->text, &value->textSize, &value->quoted);
    if (status == STATUS_CONST(SUCCESS)) {
      look.nodes = cursor->nodes;
      *cursor = look;
    }
  } else while (status == STATUS_CONST(SUCCESS)) {
    PARSING_TYPE(TSlice) content;
    PARSING_TYPE(TYAMLValue) *child = NULL;
    char *key = NULL;
    size_t keySize = 0;
    bool keyQuoted;
    look = *cursor;
    status = PARSING_INS(YAMLLine)(&look, &line, &nextIndent, &end);
    if (status != STATUS_CONST(SUCCESS) || end || nextIndent < indent) break;
    if (nextIndent > indent || (value->kind == PARSING_CONST(YAML_SEQUENCE)) != PARSING_INS(YAMLSequence)(line)) {
      status = PARSING_INS(YAMLError)(&look, STATUS_CONST(INVALID_SEQUENCE));
      break;
    }
    if (value->kind == PARSING_CONST(YAML_MAPPING)) {
      size_t colon = PARSING_INS(YAMLColon)(line);
      PARSING_TYPE(TYAMLValue) *existing;
      if (colon == SIZE_MAX) {
        status = PARSING_INS(YAMLError)(&look, STATUS_CONST(INVALID_SEQUENCE));
        break;
      }
      status = PARSING_INS(YAMLText)(&look, PARSING_INS(Slice)(line.data, colon), &key, &keySize, &keyQuoted);
      if (status != STATUS_CONST(SUCCESS)) break;
      if (!keySize) {
        free(key);
        status = PARSING_INS(YAMLError)(&look, STATUS_CONST(NOT_SUPPORTED));
        break;
      }
      for (existing = value->first; existing; existing = existing->next) if (PARSING_INS(Equal)(PARSING_INS(Slice)(existing->key, existing->keySize), PARSING_INS(Slice)(key, keySize))) break;
      if (existing) {
        free(key);
        status = PARSING_INS(YAMLError)(&look, STATUS_CONST(ALREADY_EXISTS));
        break;
      }
      content = PARSING_INS(Trim)(PARSING_INS(Slice)(line.data + colon + 1, line.size - colon - 1));
    } else content = PARSING_INS(Trim)(PARSING_INS(Slice)(line.data + 1, line.size - 1));
    *cursor = look;
    if (depth + 1 >= cursor->limits.maxDepth) {
      free(key);
      status = PARSING_INS(Fail)(cursor, PARSING_CONST(DIAGNOSTIC_DEPTH), STATUS_CONST(OUT_OF_RANGE));
      break;
    }
    if (!content.size) {
      look = *cursor;
      status = PARSING_INS(YAMLLine)(&look, &line, &nextIndent, &end);
      if (status == STATUS_CONST(SUCCESS) && !end && nextIndent > indent) status = PARSING_INS(YAMLBlock)(cursor, nextIndent, depth + 1, &child);
      else if (status == STATUS_CONST(SUCCESS)) {
        status = PARSING_INS(YAMLNew)(cursor, PARSING_CONST(YAML_SCALAR), &child);
        if (status == STATUS_CONST(SUCCESS)) {
          child->textSize = 4;
          status = PARSING_INS(Copy)(PARSING_INS(Slice)("null", 4), &child->text);
        }
      }
    } else {
      PARSING_TYPE(YAMLKind) kind = PARSING_INS(Equal)(content, PARSING_INS(Slice)("{}", 2)) ? PARSING_CONST(YAML_MAPPING) :
      (PARSING_INS(Equal)(content, PARSING_INS(Slice)("[]", 2)) ? PARSING_CONST(YAML_SEQUENCE) : PARSING_CONST(YAML_SCALAR));
      if (depth + 1 >= cursor->limits.maxDepth) status = PARSING_INS(Fail)(cursor, PARSING_CONST(DIAGNOSTIC_DEPTH), STATUS_CONST(OUT_OF_RANGE));
      else status = PARSING_INS(YAMLNew)(cursor, kind, &child);
      if (status == STATUS_CONST(SUCCESS) && kind == PARSING_CONST(YAML_SCALAR)) status = PARSING_INS(YAMLText)(cursor, content, &child->text, &child->textSize, &child->quoted);
    }
    if (status != STATUS_CONST(SUCCESS)) {
      free(key);
      PARSING_INS(YAMLFreeValue)(child);
      break;
    }
    child->key = key;
    child->keySize = keySize;
    if (value->last) value->last->next = child;
    else value->first = child;
    value->last = child;
    ++value->count;
  }
  if (status != STATUS_CONST(SUCCESS)) {
    PARSING_INS(YAMLFreeValue)(value);
    return status;
  }
  *out = value;
  return STATUS_CONST(SUCCESS);
}

PARSING_YAML_PARSE_PROTOTYPE {
  PARSING_INS(Cursor) cursor, look;
  PARSING_TYPE(TYAMLDocument) document = {0};
  PARSING_TYPE(TSlice) line;
  size_t indent;
  bool end;
  OPSTATUS status;
  if (!outDocument || outDocument->root) return STATUS_CONST(INVALID_ARGUMENT);
  status = PARSING_INS(CursorCreate)(source, size, NULL, diagnostic, &cursor);
  if (status != STATUS_CONST(SUCCESS)) return status;
  { size_t index;
    for (index = 0; index < size; ++index) {
      unsigned char byte = (unsigned char)source[index];
      if ((byte < 0x20 && byte != '\t' && byte != '\r' && byte != '\n') || byte == 0x7f) {
        cursor.position = index;
        return PARSING_INS(Fail)(&cursor, PARSING_CONST(DIAGNOSTIC_SYNTAX), STATUS_CONST(INVALID_SEQUENCE));
      }
    }
  }

  /* One optional leading document marker; streams remain explicitly unsupported. */
  look = cursor;
  while (PARSING_INS(Line)(&look, &line)) {
    line = PARSING_INS(Trim)(line);
    if (!line.size || line.data[0] == '#') {
      cursor = look;
      continue;
    }
    if (PARSING_INS(Equal)(line, PARSING_INS(Slice)("---", 3))) cursor = look;
    break;
  }
  look = cursor;
  status = PARSING_INS(YAMLLine)(&look, &line, &indent, &end);
  if (status != STATUS_CONST(SUCCESS)) return status;
  if (end) {
    status = PARSING_INS(YAMLNew)(&cursor, PARSING_CONST(YAML_SCALAR), &document.root);
    if (status == STATUS_CONST(SUCCESS)) {
      document.root->textSize = 4;
      status = PARSING_INS(Copy)(PARSING_INS(Slice)("null", 4), &document.root->text);
    }
  } else if (indent) status = PARSING_INS(YAMLError)(&look, STATUS_CONST(NOT_SUPPORTED));
  else status = PARSING_INS(YAMLBlock)(&cursor, 0, 0, &document.root);
  if (status == STATUS_CONST(SUCCESS) && !end) {
    look = cursor;
    status = PARSING_INS(YAMLLine)(&look, &line, &indent, &end);
    if (status == STATUS_CONST(SUCCESS) && !end) status = PARSING_INS(YAMLError)(&look, STATUS_CONST(NOT_SUPPORTED));
  }
  if (status != STATUS_CONST(SUCCESS)) {
    PARSING_FUNC(YAML_Free)(&document);
    return status;
  }
  *outDocument = document;
  if (diagnostic) memset(diagnostic, 0, sizeof(*diagnostic));
  return STATUS_CONST(SUCCESS);
}

PARSING_YAML_GET_PROTOTYPE {
  const PARSING_TYPE(TYAMLValue) *value;
  if (!mapping || mapping->kind != PARSING_CONST(YAML_MAPPING) || !key || !outValue) return STATUS_CONST(INVALID_ARGUMENT);
  for (value = mapping->first; value; value = value->next) if (PARSING_INS(Equal)(PARSING_INS(Slice)(value->key, value->keySize), PARSING_INS(Slice)(key, strlen(key)))) {
    *outValue = value;
    return STATUS_CONST(SUCCESS);
  }
  return STATUS_CONST(NOT_FOUND);
}

PARSING_YAML_AT_PROTOTYPE {
  const PARSING_TYPE(TYAMLValue) *value;
  if (!sequence || sequence->kind != PARSING_CONST(YAML_SEQUENCE) || !outValue) return STATUS_CONST(INVALID_ARGUMENT);
  if (index >= sequence->count) return STATUS_CONST(OUT_OF_RANGE);
  value = sequence->first;
  while (index--) value = value->next;
  *outValue = value;
  return STATUS_CONST(SUCCESS);
}

PARSING_YAML_SCALAR_PROTOTYPE {
  if (!value || value->kind != PARSING_CONST(YAML_SCALAR) || !outValue) return STATUS_CONST(INVALID_ARGUMENT);
  *outValue = PARSING_INS(Slice)(value->text, value->textSize);
  return STATUS_CONST(SUCCESS);
}

static inline OPSTATUS PARSING_INS(YAMLIndent)(PARSING_INS(Buffer) *buffer, size_t depth) {
  size_t i;
  OPSTATUS status = STATUS_CONST(SUCCESS);
  for (i = 0; status == STATUS_CONST(SUCCESS) && i < depth; ++i) status = PARSING_INS(Append)(buffer, "  ", 2);
  return status;
}

static inline OPSTATUS PARSING_INS(YAMLWriteValue)(const PARSING_TYPE(TYAMLValue) *value, PARSING_INS(Buffer) *buffer, size_t depth) {
  const PARSING_TYPE(TYAMLValue) *child;
  OPSTATUS status = STATUS_CONST(SUCCESS);
  if (depth >= PARSING_CONST(DEFAULT_DEPTH)) return STATUS_CONST(OUT_OF_RANGE);
  if (value->kind == PARSING_CONST(YAML_SCALAR)) return value->quoted ? PARSING_INS(JSONQuote)(buffer, PARSING_INS(Slice)(value->text, value->textSize)) : PARSING_INS(Append)(buffer, value->text, value->textSize);
  if (!value->count) return PARSING_INS(Append)(buffer, value->kind == PARSING_CONST(YAML_SEQUENCE) ? "[]" : "{}", 2);
  for (child = value->first; status == STATUS_CONST(SUCCESS) && child; child = child->next) {
    status = PARSING_INS(YAMLIndent)(buffer, depth);
    if (status == STATUS_CONST(SUCCESS) && value->kind == PARSING_CONST(YAML_MAPPING)) {
      status = PARSING_INS(JSONQuote)(buffer, PARSING_INS(Slice)(child->key, child->keySize));
      if (status == STATUS_CONST(SUCCESS)) status = PARSING_INS(Append)(buffer, ":", 1);
    } else if (status == STATUS_CONST(SUCCESS)) status = PARSING_INS(Append)(buffer, "-", 1);
    if (status == STATUS_CONST(SUCCESS) && child->kind != PARSING_CONST(YAML_SCALAR) && child->count) {
      status = PARSING_INS(Append)(buffer, "\n", 1);
      if (status == STATUS_CONST(SUCCESS)) status = PARSING_INS(YAMLWriteValue)(child, buffer, depth + 1);
    } else {
      if (status == STATUS_CONST(SUCCESS)) status = PARSING_INS(Append)(buffer, " ", 1);
      if (status == STATUS_CONST(SUCCESS)) status = PARSING_INS(YAMLWriteValue)(child, buffer, depth + 1);
      if (status == STATUS_CONST(SUCCESS)) status = PARSING_INS(Append)(buffer, "\n", 1);
    }
  }
  return status;
}

PARSING_YAML_WRITE_PROTOTYPE {
  PARSING_INS(Buffer) text = {0};
  OPSTATUS status;
  if (!document || !document->root || !outSize || (!buffer && capacity)) return STATUS_CONST(INVALID_ARGUMENT);
  status = PARSING_INS(YAMLWriteValue)(document->root, &text, 0);
  if (status != STATUS_CONST(SUCCESS)) {
    free(text.data);
    return status;
  }
  return PARSING_INS(Output)(&text, buffer, capacity, outSize);
}

PARSING_YAML_SET_SCALAR_PROTOTYPE {
  char *copy;
  OPSTATUS status;
  if (!value || value->kind != PARSING_CONST(YAML_SCALAR) || (!text.data && text.size) || !TEXT_UTF8_FUNC(Validate)((const unsigned char *)text.data, text.size)) return STATUS_CONST(INVALID_ARGUMENT);
  status = PARSING_INS(Copy)(text, &copy);
  if (status != STATUS_CONST(SUCCESS)) return status;
  free(value->text);
  value->text = copy;
  value->textSize = text.size;
  value->quoted = true;
  return STATUS_CONST(SUCCESS);
}

PARSING_YAML_GET_MUTABLE_PROTOTYPE {
  const PARSING_TYPE(TYAMLValue) *value;
  OPSTATUS status;
  if (!outValue) return STATUS_CONST(INVALID_ARGUMENT);
  status = PARSING_FUNC(YAML_Get)(object, key, &value);
  if (status == STATUS_CONST(SUCCESS)) *outValue = (PARSING_TYPE(TYAMLValue) *)value;
  return status;
}

PARSING_YAML_AT_MUTABLE_PROTOTYPE {
  const PARSING_TYPE(TYAMLValue) *value;
  OPSTATUS status;
  if (!outValue) return STATUS_CONST(INVALID_ARGUMENT);
  status = PARSING_FUNC(YAML_At)(array, index, &value);
  if (status == STATUS_CONST(SUCCESS)) *outValue = (PARSING_TYPE(TYAMLValue) *)value;
  return status;
}
