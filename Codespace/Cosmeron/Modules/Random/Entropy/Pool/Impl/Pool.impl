inline static uint64_t RANDOM_ENTROPY_INS(PoolMix)(uint64_t value) {
  value = (value ^ (value >> 30U)) * UINT64_C(0xbf58476d1ce4e5b9);
  value = (value ^ (value >> 27U)) * UINT64_C(0x94d049bb133111eb);
  return value ^ (value >> 31U);
}
RANDOM_ENTROPY_POOL_INIT_PROTOTYPE {
  if (pool == NULL)
    return STATUS_CONST(INVALID_ARGUMENT);
  pool->state = UINT64_C(0x6a09e667f3bcc909);
  pool->count = 0U;
  return STATUS_CONST(SUCCESS);
}
RANDOM_ENTROPY_POOL_ADD_PROTOTYPE {
  if (pool == NULL)
    return STATUS_CONST(INVALID_ARGUMENT);
  pool->state = RANDOM_ENTROPY_INS(PoolMix)(pool->state ^ value ^ pool->count);
  ++pool->count;
  return STATUS_CONST(SUCCESS);
}
RANDOM_ENTROPY_POOL_FINALIZE_PROTOTYPE {
  if (pool == NULL || outValue == NULL)
    return STATUS_CONST(INVALID_ARGUMENT);
  *outValue = RANDOM_ENTROPY_INS(PoolMix)(pool->state ^ pool->count);
  return STATUS_CONST(SUCCESS);
}

