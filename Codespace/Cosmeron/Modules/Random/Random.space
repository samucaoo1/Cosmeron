#define RANDOM_MIXER_TYPE(NAME) RANDOM_MIXER_NS(NAME)
#define RANDOM_MIXER_FUNC(NAME) RANDOM_MIXER_NS(NAME)

#define RANDOM_SOURCE_NS(NAME) GNS3(LIB_PREFIX(RANDOM_MOD), Source, NAME)
#define RANDOM_SOURCE_CNS(NAME)                                               \
  CNS3(LIB_PREFIX_CONST(RANDOM_CMOD), SOURCE, NAME)
#define RANDOM_SOURCE_TYPE(NAME) RANDOM_SOURCE_NS(NAME)
#define RANDOM_SOURCE_FUNC(NAME) RANDOM_SOURCE_NS(NAME)
#define RANDOM_SOURCE_INS(NAME)                                               \
  GNS4(LIB_PREFIX(RANDOM_MOD), Source, Internal, NAME)

#define RANDOM_DISTRIBUTION_NS(NAME)                                          \
  GNS3(LIB_PREFIX(RANDOM_MOD), Distribution, NAME)
#define RANDOM_DISTRIBUTION_CNS(NAME)                                         \
  CNS3(LIB_PREFIX_CONST(RANDOM_CMOD), DISTRIBUTION, NAME)
#define RANDOM_DISTRIBUTION_FUNC(NAME) RANDOM_DISTRIBUTION_NS(NAME)
#define RANDOM_DISTRIBUTION_INS(NAME)                                         \
