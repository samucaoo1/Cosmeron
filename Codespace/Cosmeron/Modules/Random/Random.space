#pragma once

#include "../../Core/Namespace.h"
#include "../../Core/Preprocessor/Compiling.inc"

#include <stdbool.h>
#include <stddef.h>
#include <stdint.h>

#define RANDOM_MOD Random
#define RANDOM_CMOD RANDOM

#define RANDOM_NS(NAME) GNS2(LIB_PREFIX(RANDOM_MOD), NAME)
#define RANDOM_CNS(NAME) CNS2(LIB_PREFIX_CONST(RANDOM_CMOD), NAME)
#define RANDOM_INS(NAME) GNS3(LIB_PREFIX(RANDOM_MOD), Internal, NAME)
#define RANDOM_CINS(NAME) CNS3(LIB_PREFIX_CONST(RANDOM_CMOD), INTERNAL, NAME)

#define RANDOM_TYPE(NAME) RANDOM_NS(NAME)
#define RANDOM_FUNC(NAME) RANDOM_NS(NAME)

#define RANDOM_ENGINE_NS(NAME) GNS3(LIB_PREFIX(RANDOM_MOD), Engine, NAME)
#define RANDOM_ENGINE_CNS(NAME)                                               \
  CNS3(LIB_PREFIX_CONST(RANDOM_CMOD), ENGINE, NAME)
#define RANDOM_ENGINE_TYPE(NAME) RANDOM_ENGINE_NS(NAME)
#define RANDOM_ENGINE_FUNC(ENGINE, NAME)                                      \
  GNS2(RANDOM_ENGINE_NS(ENGINE), NAME)
#define RANDOM_ENGINE_INS(ENGINE, NAME)                                       \
  GNS4(LIB_PREFIX(RANDOM_MOD), Engine, Internal, PP_OP_CAT3(ENGINE, _, NAME))

#define RANDOM_ENTROPY_NS(NAME) GNS3(LIB_PREFIX(RANDOM_MOD), Entropy, NAME)
#define RANDOM_ENTROPY_CNS(NAME)                                              \
