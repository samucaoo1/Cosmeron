#pragma once

#include "../Sort.space"

#define COSMERON_MACRO_INTERNAL_SORT_THRESHOLD 24u

static inline void SORT_INS(InsertionRange)(
    unsigned char *data, size_t lo, size_t hi, size_t size,
    TCALLBACK(Comparison) compare) {
  for (size_t i = lo + 1; i < hi; ++i) {
    size_t j = i;
    while (j > lo &&
           CALLBACK_INVOKE(compare, data + j * size,
                           data + (j - 1) * size) == COMPARISON_CONST(LOWER)) {
      SORT_INS(Swap)(data + j * size, data + (j - 1) * size, size);
      --j;
    }
  }
}

static inline void SORT_INS(SiftDown)(
    unsigned char *data, size_t root, size_t count, size_t size,
    TCALLBACK(Comparison) compare) {
  while (count > 1 && root <= (count - 2) / 2) {
    size_t child = root * 2 + 1;
    if (child + 1 < count &&
        CALLBACK_INVOKE(compare, data + child * size,
                        data + (child + 1) * size) == COMPARISON_CONST(LOWER))
      ++child;
    if (CALLBACK_INVOKE(compare, data + root * size,
                        data + child * size) != COMPARISON_CONST(LOWER))
      break;
    SORT_INS(Swap)(data + root * size, data + child * size, size);
    root = child;
  }
}

static inline void SORT_INS(HeapRange)(
    unsigned char *data, size_t count, size_t size,
    TCALLBACK(Comparison) compare) {
  for (size_t i = count / 2; i > 0; --i)
    SORT_INS(SiftDown)(data, i - 1, count, size, compare);
  for (size_t end = count; end > 1; --end) {
    SORT_INS(Swap)(data, data + (end - 1) * size, size);
    SORT_INS(SiftDown)(data, 0, end - 1, size, compare);
  }
}

static inline size_t SORT_INS(DepthLimit)(size_t count) {
  size_t depth = 0;
  while (count > 1) {
    count >>= 1;
    depth += 2;
  }
  return depth;
}

static inline void SORT_INS(IntroRange)(
    unsigned char *data, size_t lo, size_t hi, size_t size, size_t depth,
    TCALLBACK(Comparison) compare) {
  while (hi - lo > COSMERON_MACRO_INTERNAL_SORT_THRESHOLD) {
    if (!depth) {
      SORT_INS(HeapRange)(data + lo * size, hi - lo, size, compare);
      return;
    }
    --depth;
    size_t last = hi - 1, mid = lo + (hi - lo) / 2;
    if (CALLBACK_INVOKE(compare, data + mid * size, data + lo * size) ==
        COMPARISON_CONST(LOWER))
      SORT_INS(Swap)(data + mid * size, data + lo * size, size);
    if (CALLBACK_INVOKE(compare, data + last * size, data + lo * size) ==
        COMPARISON_CONST(LOWER))
      SORT_INS(Swap)(data + last * size, data + lo * size, size);
    if (CALLBACK_INVOKE(compare, data + last * size, data + mid * size) ==
        COMPARISON_CONST(LOWER))
      SORT_INS(Swap)(data + last * size, data + mid * size, size);

    size_t lt = lo, i = lo, gt = last;
    while (i < gt) {
      CMPOUT order = CALLBACK_INVOKE(compare, data + i * size, data + last * size);
      if (order == COMPARISON_CONST(LOWER)) {
        SORT_INS(Swap)(data + lt * size, data + i * size, size);
        ++lt;
        ++i;
      } else if (order == COMPARISON_CONST(HIGHER)) {
        --gt;
        SORT_INS(Swap)(data + i * size, data + gt * size, size);
      } else {
        ++i;
      }
    }
    SORT_INS(Swap)(data + gt * size, data + last * size, size);

    if (lt - lo < hi - (gt + 1)) {
      SORT_INS(IntroRange)(data, lo, lt, size, depth, compare);
      lo = gt + 1;
    } else {
      SORT_INS(IntroRange)(data, gt + 1, hi, size, depth, compare);
      hi = lt;
    }
  }
  SORT_INS(InsertionRange)(data, lo, hi, size, compare);
}

static inline void SORT_INS(MergeRange)(
    unsigned char *data, unsigned char *scratch, size_t lo, size_t hi,
    size_t size, TCALLBACK(Comparison) compare) {
  if (hi - lo < 2)
    return;
  size_t mid = lo + (hi - lo) / 2;
  SORT_INS(MergeRange)(data, scratch, lo, mid, size, compare);
  SORT_INS(MergeRange)(data, scratch, mid, hi, size, compare);
  size_t left = lo, right = mid;
  for (size_t out = lo; out < hi; ++out) {
    bool chooseLeft = left < mid &&
        (right == hi ||
         CALLBACK_INVOKE(compare, data + left * size, data + right * size) !=
             COMPARISON_CONST(HIGHER));
    memcpy(scratch + out * size,
           data + (chooseLeft ? left++ : right++) * size, size);
  }
  memcpy(data + lo * size, scratch + lo * size, (hi - lo) * size);
}

PACKAGE_OPERATION_IMPLEMENT_EX(LIB_PREFIX(SORT_MOD), Insertion,
    (void *data, size_t count, size_t elementSize, TCALLBACK(Comparison) compare)) {
  OPSTATUS s = SORT_INS(Validate)(data, count, elementSize, CALLBACK_IS_VALID(compare));
  if (s != STATUS_CONST(SUCCESS))
    return s;
  if (count > 1)
    SORT_INS(InsertionRange)(data, 0, count, elementSize, compare);
  return STATUS_CONST(SUCCESS);
}

PACKAGE_OPERATION_IMPLEMENT_EX(LIB_PREFIX(SORT_MOD), Heap,
    (void *data, size_t count, size_t elementSize, TCALLBACK(Comparison) compare)) {
  OPSTATUS s = SORT_INS(Validate)(data, count, elementSize, CALLBACK_IS_VALID(compare));
  if (s != STATUS_CONST(SUCCESS))
    return s;
  if (count > 1)
    SORT_INS(HeapRange)(data, count, elementSize, compare);
  return STATUS_CONST(SUCCESS);
}

PACKAGE_OPERATION_IMPLEMENT_EX(LIB_PREFIX(SORT_MOD), Intro,
    (void *data, size_t count, size_t elementSize, TCALLBACK(Comparison) compare)) {
  OPSTATUS s = SORT_INS(Validate)(data, count, elementSize, CALLBACK_IS_VALID(compare));
  if (s != STATUS_CONST(SUCCESS))
    return s;
  if (count > 1)
    SORT_INS(IntroRange)(data, 0, count, elementSize,
                         SORT_INS(DepthLimit)(count), compare);
  return STATUS_CONST(SUCCESS);
}

PACKAGE_OPERATION_IMPLEMENT_EX(LIB_PREFIX(SORT_MOD), Array,
    (void *data, size_t count, size_t elementSize, TCALLBACK(Comparison) compare)) {
  return SORT_FUNC(Intro)(data, count, elementSize, compare);
}

PACKAGE_OPERATION_IMPLEMENT_EX(LIB_PREFIX(SORT_MOD), StableWithBuffer,
    (void *data, size_t count, size_t elementSize, TCALLBACK(Comparison) compare,
     void *buffer, size_t bufferSize)) {
  OPSTATUS s = SORT_INS(Validate)(data, count, elementSize, CALLBACK_IS_VALID(compare));
  if (s != STATUS_CONST(SUCCESS))
    return s;
  if (count < 2)
    return STATUS_CONST(SUCCESS);
  if (!buffer || bufferSize < count * elementSize)
    return STATUS_CONST(INSUFFICIENT_SPACE);
  SORT_INS(MergeRange)(data, buffer, 0, count, elementSize, compare);
  return STATUS_CONST(SUCCESS);
}

PACKAGE_OPERATION_IMPLEMENT_EX(LIB_PREFIX(SORT_MOD), Merge,
    (void *data, size_t count, size_t elementSize, TCALLBACK(Comparison) compare)) {
  OPSTATUS s = SORT_INS(Validate)(data, count, elementSize, CALLBACK_IS_VALID(compare));
  if (s != STATUS_CONST(SUCCESS))
    return s;
  if (count < 2)
    return STATUS_CONST(SUCCESS);
  void *buffer = NULL;
  s = ALLOC_FUNC(Array)(&buffer, count, elementSize);
  if (s != STATUS_CONST(SUCCESS))
    return s;
  SORT_INS(MergeRange)(data, buffer, 0, count, elementSize, compare);
  ALLOC_FUNC(Free)(&buffer);
  return STATUS_CONST(SUCCESS);
}

PACKAGE_OPERATION_IMPLEMENT_EX(LIB_PREFIX(SORT_MOD), Stable,
    (void *data, size_t count, size_t elementSize, TCALLBACK(Comparison) compare)) {
  return SORT_FUNC(Merge)(data, count, elementSize, compare);
}

/* EOF */
