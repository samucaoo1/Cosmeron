#pragma once

#if defined(SORT_DISABLE_FUNCTION_TABLE) && !defined(PACKAGE_DISABLE_FUNCTION_TABLE)
#define PACKAGE_DISABLE_FUNCTION_TABLE 1
#endif

#include "../../Core/Algorithm/Comparison.h"
#include "../../Core/Memory/Alloc.h"
#include "../../Core/Memory/Swap.h"
#include "../../Core/Module/Package.h"
#include "../../Core/Namespace.h"
#include "../../Core/Outcome/Status.h"
#include "../../Core/Preprocessor/Compiling.inc"
#include "../../Core/Preprocessor/Operations.h"

#include <limits.h>
#include <stdbool.h>
#include <stddef.h>
#include <stdint.h>
#include <string.h>

#define SORT_MOD Sort
#define SORT_CMOD SORT

#define SORT_NS(NAME) GNS2(LIB_PREFIX(SORT_MOD), NAME)
#define SORT_CNS(NAME) CNS2(LIB_PREFIX_CONST(SORT_CMOD), NAME)
#define SORT_INS(NAME) GNS3(LIB_PREFIX(SORT_MOD), Internal, NAME)
#define SORT_CINS(NAME) CNS3(LIB_PREFIX_CONST(SORT_CMOD), INTERNAL, NAME)

#define SORT_TYPE(NAME) SORT_NS(NAME)
#define SORT_FUNC(NAME) SORT_NS(NAME)
#define SORT_TYPED_FUNC(NAME, SUFFIX) GNS2(SORT_FUNC(NAME), SUFFIX)
#define SORT_TYPED_INS(NAME, SUFFIX) GNS2(SORT_INS(NAME), SUFFIX)
#define SORT_CONST(NAME) SORT_CNS(NAME)

/* ==========================================================================
 * Sort Order Table (Row-Tuple Pattern)
 * ========================================================================== */

#define SORT_ORDER_COL_NAME(NAME, VALUE)  NAME
#define SORT_ORDER_COL_VALUE(NAME, VALUE) VALUE
#define SORT_ORDER_GET(FIELD, ROW) PP_OP_CAT2(SORT_ORDER_COL_, FIELD) ROW

#define SORT_ORDER_TABLE(X)                                                    \
  X((ASCENDING, 0))                                                            \
  X((DESCENDING, 1))

#define SORT_ORDER_ENUM_EMIT(ROW)                                              \
  SORT_CONST(SORT_ORDER_GET(NAME, ROW)) = SORT_ORDER_GET(VALUE, ROW),

typedef enum SORT_TYPE(Order) {
  SORT_ORDER_TABLE(SORT_ORDER_ENUM_EMIT)
} SORT_TYPE(Order);

#undef SORT_ORDER_ENUM_EMIT

/* Legacy alias for backwards compatibility if needed */
typedef SORT_TYPE(Order) SORT_TYPE(TOrder);

/* ==========================================================================
 * Common Internal Helpers
 * ========================================================================== */

static inline OPSTATUS SORT_INS(Validate)(const void *data, size_t count,
                                          size_t size, bool hasComparator) {
  if (!size || !hasComparator)
    return STATUS_CONST(INVALID_ARGUMENT);
  if (count > SIZE_MAX / size)
    return STATUS_CONST(ARITHMETIC_OVERFLOW);
  if (count && !data)
    return STATUS_CONST(INVALID_ARGUMENT);
  return STATUS_CONST(SUCCESS);
}

static inline void SORT_INS(Swap)(void *a, void *b, size_t size) {
  (void)SWAP_FUNC(Bytes)(a, b, size);
}

/* EOF */
