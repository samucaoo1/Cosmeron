#pragma once

#include "../Struct.space"

#define TEMPLATE_TDUAL_IMPLEMENT(SUFFIX, TYPE)                                 \
  PACKAGE_FUNCTION_IMPLEMENT_EX(                                               \
      TDUAL_PKG(SUFFIX), TDUAL_TYPE(SUFFIX), Create,                            \
      (TYPE value1, TYPE value2)) {                                            \
    TDUAL_TYPE(SUFFIX) dual;                                                   \
    dual.value1 = value1;                                                      \
    dual.value2 = value2;                                                      \
    return dual;                                                               \
  }                                                                            \
                                                                               \
  PACKAGE_OPERATION_IMPLEMENT_EX(                                              \
      TDUAL_PKG(SUFFIX), Extract,                                              \
      (TDUAL_TYPE(SUFFIX) dual, TYPE *outValue1, TYPE *outValue2)) {            \
    if (outValue1 == NULL || outValue2 == NULL)                                \
      return STATUS_CONST(INVALID_ARGUMENT);                                   \
    *outValue1 = dual.value1;                                                  \
    *outValue2 = dual.value2;                                                  \
    return STATUS_CONST(SUCCESS);                                              \
  }                                                                            \
                                                                               \
  PACKAGE_PROCEDURE_IMPLEMENT_EX(                                              \
      TDUAL_PKG(SUFFIX), Unpack,                                               \
      (TDUAL_TYPE(SUFFIX) dual, TYPE *outValue1, TYPE *outValue2)) {           \
    if (outValue1 != NULL)                                                     \
      *outValue1 = dual.value1;                                                \
    if (outValue2 != NULL)                                                     \
      *outValue2 = dual.value2;                                                \
  }                                                                            \
                                                                               \
  static inline TDUAL_TYPE(SUFFIX)                                             \
      CAST_TYPE_TO_STRUCT(SUFFIX, TDual)(TYPE value1, TYPE value2) {           \
    return GNS2(TDUAL_PKG(SUFFIX), Create)(value1, value2);                    \
  }                                                                            \
                                                                               \
  static inline void CAST_STRUCT_TO_TYPE(TDual, SUFFIX)(                       \
      TDUAL_TYPE(SUFFIX) dual, TYPE *var1, TYPE *var2) {                       \
    GNS2(TDUAL_PKG(SUFFIX), Unpack)(dual, var1, var2);                         \
  }                                                                            \
  PACKAGE_IMPLEMENT(TDUAL_PKG(SUFFIX));

/* EOF */
