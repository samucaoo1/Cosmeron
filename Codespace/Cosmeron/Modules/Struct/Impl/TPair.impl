#pragma once

#include "../Struct.space"

#define TEMPLATE_TPAIR_IMPLEMENT(SUFFIX, TYPE)                                 \
  PACKAGE_FUNCTION_IMPLEMENT_EX(                                               \
      TPAIR_PKG(SUFFIX), TPAIR_TYPE(SUFFIX), Create,                            \
      (TYPE value1, TYPE value2)) {                                            \
    TPAIR_TYPE(SUFFIX) pair;                                                   \
    pair.value1 = value1;                                                      \
    pair.value2 = value2;                                                      \
    return pair;                                                               \
  }                                                                            \
                                                                               \
  PACKAGE_OPERATION_IMPLEMENT_EX(                                              \
      TPAIR_PKG(SUFFIX), Extract,                                              \
      (TPAIR_TYPE(SUFFIX) pair, TYPE *outValue1, TYPE *outValue2)) {            \
    if (outValue1 == NULL || outValue2 == NULL)                                \
      return STATUS_CONST(INVALID_ARGUMENT);                                   \
    *outValue1 = pair.value1;                                                  \
    *outValue2 = pair.value2;                                                  \
    return STATUS_CONST(SUCCESS);                                              \
  }                                                                            \
                                                                               \
  PACKAGE_PROCEDURE_IMPLEMENT_EX(                                              \
      TPAIR_PKG(SUFFIX), Unpack,                                               \
      (TPAIR_TYPE(SUFFIX) pair, TYPE *outValue1, TYPE *outValue2)) {           \
    if (outValue1 != NULL)                                                     \
      *outValue1 = pair.value1;                                                \
    if (outValue2 != NULL)                                                     \
      *outValue2 = pair.value2;                                                \
  }                                                                            \
                                                                               \
  static inline TPAIR_TYPE(SUFFIX)                                             \
      CAST_TYPE_TO_STRUCT(SUFFIX, TPair)(TYPE value1, TYPE value2) {           \
    return GNS2(TPAIR_PKG(SUFFIX), Create)(value1, value2);                    \
  }                                                                            \
                                                                               \
  static inline void CAST_STRUCT_TO_TYPE(TPair, SUFFIX)(                       \
      TPAIR_TYPE(SUFFIX) pair, TYPE *var1, TYPE *var2) {                       \
    GNS2(TPAIR_PKG(SUFFIX), Unpack)(pair, var1, var2);                         \
  }                                                                            \
  PACKAGE_IMPLEMENT(TPAIR_PKG(SUFFIX));

/* EOF */
