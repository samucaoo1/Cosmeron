#pragma once

#include "../Struct.space"

#define TEMPLATE_TPENTA_IMPLEMENT(SUFFIX, TYPE)                                \
  PACKAGE_FUNCTION_IMPLEMENT_EX(                                               \
      TPENTA_PKG(SUFFIX), TPENTA_TYPE(SUFFIX), Create,                         \
      (TYPE value1, TYPE value2, TYPE value3, TYPE value4, TYPE value5)) {     \
    TPENTA_TYPE(SUFFIX) penta;                                                 \
    penta.value1 = value1;                                                     \
    penta.value2 = value2;                                                     \
    penta.value3 = value3;                                                     \
    penta.value4 = value4;                                                     \
    penta.value5 = value5;                                                     \
    return penta;                                                              \
  }                                                                            \
                                                                               \
  PACKAGE_OPERATION_IMPLEMENT_EX(                                              \
      TPENTA_PKG(SUFFIX), Extract,                                             \
      (TPENTA_TYPE(SUFFIX) penta, TYPE *outValue1, TYPE *outValue2,             \
       TYPE *outValue3, TYPE *outValue4, TYPE *outValue5)) {                   \
    if (outValue1 == NULL || outValue2 == NULL || outValue3 == NULL ||         \
        outValue4 == NULL || outValue5 == NULL)                                \
      return STATUS_CONST(INVALID_ARGUMENT);                                   \
    *outValue1 = penta.value1;                                                 \
    *outValue2 = penta.value2;                                                 \
    *outValue3 = penta.value3;                                                 \
    *outValue4 = penta.value4;                                                 \
    *outValue5 = penta.value5;                                                 \
    return STATUS_CONST(SUCCESS);                                              \
  }                                                                            \
                                                                               \
  PACKAGE_PROCEDURE_IMPLEMENT_EX(                                              \
      TPENTA_PKG(SUFFIX), Unpack,                                              \
      (TPENTA_TYPE(SUFFIX) penta, TYPE *outValue1, TYPE *outValue2,             \
       TYPE *outValue3, TYPE *outValue4, TYPE *outValue5)) {                   \
    if (outValue1 != NULL)                                                     \
      *outValue1 = penta.value1;                                               \
    if (outValue2 != NULL)                                                     \
      *outValue2 = penta.value2;                                               \
    if (outValue3 != NULL)                                                     \
      *outValue3 = penta.value3;                                               \
    if (outValue4 != NULL)                                                     \
      *outValue4 = penta.value4;                                               \
    if (outValue5 != NULL)                                                     \
      *outValue5 = penta.value5;                                               \
  }                                                                            \
                                                                               \
  static inline TPENTA_TYPE(SUFFIX)                                            \
      CAST_TYPE_TO_STRUCT(SUFFIX, TPenta)(TYPE value1, TYPE value2,            \
                                          TYPE value3, TYPE value4,            \
                                          TYPE value5) {                       \
    return GNS2(TPENTA_PKG(SUFFIX), Create)(value1, value2, value3, value4,    \
                                            value5);                           \
  }                                                                            \
                                                                               \
  static inline void CAST_STRUCT_TO_TYPE(                                      \
      TPenta, SUFFIX)(TPENTA_TYPE(SUFFIX) penta, TYPE *var1, TYPE *var2,       \
                      TYPE *var3, TYPE *var4, TYPE *var5) {                    \
    GNS2(TPENTA_PKG(SUFFIX), Unpack)(penta, var1, var2, var3, var4, var5);     \
  }                                                                            \
  PACKAGE_IMPLEMENT(TPENTA_PKG(SUFFIX));

/* EOF */
