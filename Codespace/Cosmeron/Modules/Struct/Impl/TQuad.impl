#pragma once

#include "../Struct.space"

#define TEMPLATE_TQUAD_IMPLEMENT(SUFFIX, TYPE)                                 \
  PACKAGE_FUNCTION_IMPLEMENT_EX(                                               \
      TQUAD_PKG(SUFFIX), TQUAD_TYPE(SUFFIX), Create,                            \
      (TYPE value1, TYPE value2, TYPE value3, TYPE value4)) {                  \
    TQUAD_TYPE(SUFFIX) quad;                                                   \
    quad.value1 = value1;                                                      \
    quad.value2 = value2;                                                      \
    quad.value3 = value3;                                                      \
    quad.value4 = value4;                                                      \
    return quad;                                                               \
  }                                                                            \
                                                                               \
  PACKAGE_OPERATION_IMPLEMENT_EX(                                              \
      TQUAD_PKG(SUFFIX), Extract,                                              \
      (TQUAD_TYPE(SUFFIX) quad, TYPE *outValue1, TYPE *outValue2,              \
       TYPE *outValue3, TYPE *outValue4)) {                                    \
    if (outValue1 == NULL || outValue2 == NULL || outValue3 == NULL ||         \
        outValue4 == NULL)                                                     \
      return STATUS_CONST(INVALID_ARGUMENT);                                   \
    *outValue1 = quad.value1;                                                  \
    *outValue2 = quad.value2;                                                  \
    *outValue3 = quad.value3;                                                  \
    *outValue4 = quad.value4;                                                  \
    return STATUS_CONST(SUCCESS);                                              \
  }                                                                            \
                                                                               \
  PACKAGE_PROCEDURE_IMPLEMENT_EX(                                              \
      TQUAD_PKG(SUFFIX), Unpack,                                               \
      (TQUAD_TYPE(SUFFIX) quad, TYPE *outValue1, TYPE *outValue2,              \
       TYPE *outValue3, TYPE *outValue4)) {                                    \
    if (outValue1 != NULL)                                                     \
      *outValue1 = quad.value1;                                                \
    if (outValue2 != NULL)                                                     \
      *outValue2 = quad.value2;                                                \
    if (outValue3 != NULL)                                                     \
      *outValue3 = quad.value3;                                                \
    if (outValue4 != NULL)                                                     \
      *outValue4 = quad.value4;                                                \
  }                                                                            \
                                                                               \
  static inline TQUAD_TYPE(SUFFIX)                                             \
      CAST_TYPE_TO_STRUCT(SUFFIX, TQuad)(TYPE value1, TYPE value2,             \
                                         TYPE value3, TYPE value4) {           \
    return GNS2(TQUAD_PKG(SUFFIX), Create)(value1, value2, value3, value4);    \
  }                                                                            \
                                                                               \
  static inline void CAST_STRUCT_TO_TYPE(                                      \
      TQuad, SUFFIX)(TQUAD_TYPE(SUFFIX) quad, TYPE *var1, TYPE *var2,          \
                     TYPE *var3, TYPE *var4) {                                 \
    GNS2(TQUAD_PKG(SUFFIX), Unpack)(quad, var1, var2, var3, var4);             \
  }                                                                            \
  PACKAGE_IMPLEMENT(TQUAD_PKG(SUFFIX));

/* EOF */
