#pragma once

#include <stdbool.h>
#include <stddef.h>
#include <stdint.h>
#include <stdio.h>
#include <string.h>

MODULE_IMPLEMENT(DOMAIN(Modules), Text,
  INTERNAL_EX(Attributed,
    FUNCTION(size_t, NextCapacity,
             (size_t current, size_t initial, size_t needed), {
      size_t newCap = (current == 0U) ? initial : current;
      const size_t growth =
          MODULE_CONST(Text, Attributed, GROWTH_FACTOR);
      while (newCap < needed) {
        if (newCap > SIZE_MAX / growth) {
          return needed;
        }
        newCap *= growth;
      }
      return newCap;
    }),

    OPERATION(EnsureTextCapacity,
              (MODULE_TYPE(Text, Attributed) *self, size_t needed), {
      if (self->capacity >= needed) {
        return STATUS_CONST(SUCCESS);
      }

      const size_t newCap = MODULE_IFUNC(Text, Attributed, NextCapacity)(
          self->capacity,
          MODULE_CONST(Text, Attributed, INITIAL_TEXT_CAPACITY), needed);
      void *temp = self->text;
      OPSTATUS status =
          MODULE_FUNC(Memory, Alloc, ReallocBytes)(&temp, newCap + 1U);
      if (status != STATUS_CONST(SUCCESS)) {
        return status;
      }

      self->text = (char *)temp;
      self->capacity = newCap;
      return STATUS_CONST(SUCCESS);
    }),

    OPERATION(EnsureSpanCapacity,
              (MODULE_TYPE(Text, Attributed) *self, size_t needed), {
      if (self->spanCapacity >= needed) {
        return STATUS_CONST(SUCCESS);
      }

      const size_t newCap = MODULE_IFUNC(Text, Attributed, NextCapacity)(
          self->spanCapacity,
          MODULE_CONST(Text, Attributed, INITIAL_SPAN_CAPACITY), needed);
      void *temp = self->spans;
      OPSTATUS status = MODULE_FUNC(Memory, Alloc, ReallocArray)(
          &temp, newCap, sizeof(MODULE_TYPE(Text, Attributed, Span)));
      if (status != STATUS_CONST(SUCCESS)) {
        return status;
      }

      self->spans = (MODULE_TYPE(Text, Attributed, Span) *)temp;
      self->spanCapacity = newCap;
      return STATUS_CONST(SUCCESS);
    }),

    PROCEDURE(AppendLiteral,
              (char *outBuffer, size_t bufferCapacity, size_t *written,
               const char *literal), {
      const size_t remaining =
          (bufferCapacity > *written) ? (bufferCapacity - *written) : 0U;
      const int n = snprintf(outBuffer + *written, remaining, "%s", literal);
      if (n > 0) {
        *written += (size_t)n;
      }
    }),

    PROCEDURE(AppendAnsiRgb,
              (char *outBuffer, size_t bufferCapacity, size_t *written,
               unsigned sgrPrefix, uint32_t color), {
      const uint8_t r = MODULE_FUNC(Text, Grid_Color, Red)(color);
      const uint8_t g = MODULE_FUNC(Text, Grid_Color, Green)(color);
      const uint8_t b = MODULE_FUNC(Text, Grid_Color, Blue)(color);
      const size_t remaining =
          (bufferCapacity > *written) ? (bufferCapacity - *written) : 0U;
      const int n = snprintf(outBuffer + *written, remaining,
                             "\033[%u;2;%u;%u;%um", sgrPrefix, r, g, b);
      if (n > 0) {
        *written += (size_t)n;
      }
    })
  ),

  OBJECT(Attributed,
    OPERATION(Create, (size_t initialCapacity), {
      if (!self) {
        return STATUS_CONST(INVALID_ARGUMENT);
      }

      OBJECT_RESET_ZERO(Text, Attributed, self);

      if (initialCapacity > 0U) {
        OPSTATUS status = MODULE_IFUNC(Text, Attributed, EnsureTextCapacity)(
            self, initialCapacity);
        if (status != STATUS_CONST(SUCCESS)) {
          return status;
        }
        self->text[0] = '\0';
      }

      return STATUS_CONST(SUCCESS);
    }),

    OPERATION(Destroy, (), {
      if (!self) {
        return STATUS_CONST(INVALID_ARGUMENT);
      }

      if (self->text != NULL) {
        Memory_Free(self->text);
      }
      if (self->spans != NULL) {
        Memory_Free(self->spans);
      }

      OBJECT_RESET_ZERO(Text, Attributed, self);
      return STATUS_CONST(SUCCESS);
    }),

    VARIANT(Clear,
      OPERATION((), {
        if (!self) {
          return STATUS_CONST(INVALID_ARGUMENT);
        }

        self->length = 0U;
        if (self->text != NULL) {
          self->text[0] = '\0';
        }
        self->spanCount = 0U;
        return STATUS_CONST(SUCCESS);
      }),

      OPERATION(Spans, (), {
        if (!self) {
          return STATUS_CONST(INVALID_ARGUMENT);
        }

        self->spanCount = 0U;
        return STATUS_CONST(SUCCESS);
      })
    ),

    OPERATION(SetText, (const char *text, size_t length), {
      if (!self || (!text && length > 0U)) {
        return STATUS_CONST(INVALID_ARGUMENT);
      }

      if (length == 0U) {
        self->length = 0U;
        if (self->text != NULL) {
          self->text[0] = '\0';
        }
        return STATUS_CONST(SUCCESS);
      }

      OPSTATUS status =
          MODULE_IFUNC(Text, Attributed, EnsureTextCapacity)(self, length);
      if (status != STATUS_CONST(SUCCESS)) {
        return status;
      }

      memcpy(self->text, text, length);
      self->text[length] = '\0';
      self->length = length;
      return STATUS_CONST(SUCCESS);
    }),

    OPERATION(AppendText, (const char *text, size_t length), {
      if (!self || (!text && length > 0U)) {
        return STATUS_CONST(INVALID_ARGUMENT);
      }

      if (length == 0U) {
        return STATUS_CONST(SUCCESS);
      }

      if (length > SIZE_MAX - self->length) {
        return STATUS_CONST(OUT_OF_RANGE);
      }

      const size_t newLen = self->length + length;
      OPSTATUS status =
          MODULE_IFUNC(Text, Attributed, EnsureTextCapacity)(self, newLen);
      if (status != STATUS_CONST(SUCCESS)) {
        return status;
      }

      memcpy(self->text + self->length, text, length);
      self->text[newLen] = '\0';
      self->length = newLen;
      return STATUS_CONST(SUCCESS);
    }),

    OPERATION(AddSpan,
              (size_t start, size_t length,
               MODULE_TYPE(Text, Attribute, Cell) attribute), {
      if (!self) {
        return STATUS_CONST(INVALID_ARGUMENT);
      }

      if (length == 0U) {
        return STATUS_CONST(SUCCESS);
      }

      OPSTATUS status = MODULE_IFUNC(Text, Attributed, EnsureSpanCapacity)(
          self, self->spanCount + 1U);
      if (status != STATUS_CONST(SUCCESS)) {
        return status;
      }

      self->spans[self->spanCount].start = start;
      self->spans[self->spanCount].length = length;
      self->spans[self->spanCount].attribute = attribute;
      self->spanCount++;
      return STATUS_CONST(SUCCESS);
    }),

    CONST_OPERATION(GetAttributeAt,
                    (size_t index,
                     MODULE_TYPE(Text, Attribute, Cell) *outAttribute), {
      if (!self || !outAttribute) {
        return STATUS_CONST(INVALID_ARGUMENT);
      }

      if (index >= self->length) {
        return STATUS_CONST(OUT_OF_RANGE);
      }

      memset(outAttribute, 0, sizeof(*outAttribute));

      for (size_t i = 0U; i < self->spanCount; ++i) {
        const MODULE_TYPE(Text, Attributed, Span) *span = &self->spans[i];
        if (index >= span->start && index < span->start + span->length) {
          if (span->attribute.foreground != 0U) {
            outAttribute->foreground = span->attribute.foreground;
          }
          if (span->attribute.background != 0U) {
            outAttribute->background = span->attribute.background;
          }
          outAttribute->flags |= span->attribute.flags;
          if (span->attribute.underline != 0U) {
            outAttribute->underline = span->attribute.underline;
          }
        }
      }

      return STATUS_CONST(SUCCESS);
    }),

    CONST_OPERATION(RenderAnsi,
                    (char *outBuffer, size_t bufferCapacity,
                     size_t *outWritten), {
      if (!self || !outBuffer || !outWritten || bufferCapacity == 0U) {
        return STATUS_CONST(INVALID_ARGUMENT);
      }

      *outWritten = 0U;
      if (self->length == 0U) {
        outBuffer[0] = '\0';
        return STATUS_CONST(SUCCESS);
      }

      const unsigned sgrFgPrefix = 38U;
      const unsigned sgrBgPrefix = 48U;
      size_t written = 0U;
      MODULE_TYPE(Text, Attribute, Cell) activeAttr;
      memset(&activeAttr, 0, sizeof(activeAttr));
      bool hadStyle = false;

      for (size_t i = 0U; i < self->length; ++i) {
        MODULE_TYPE(Text, Attribute, Cell) currentAttr;
        OPSTATUS status = OBJECT_CALL(self, GetAttributeAt, i, &currentAttr);
        if (status != STATUS_CONST(SUCCESS)) {
          return status;
        }

        const bool attrChanged =
            (i == 0U) ||
            (memcmp(&currentAttr, &activeAttr, sizeof(currentAttr)) != 0);

        if (attrChanged) {
          if (hadStyle) {
            MODULE_IFUNC(Text, Attributed, AppendLiteral)(
                outBuffer, bufferCapacity, &written, "\033[0m");
            hadStyle = false;
          }

          const bool hasStyle = (currentAttr.foreground != 0U) ||
                                (currentAttr.background != 0U) ||
                                (currentAttr.flags != 0U) ||
                                (currentAttr.underline != 0U);

          if (hasStyle) {
            if (currentAttr.flags & CNS(Text, Attribute, BOLD)) {
              MODULE_IFUNC(Text, Attributed, AppendLiteral)(
                  outBuffer, bufferCapacity, &written, "\033[1m");
            }
            if (currentAttr.flags & CNS(Text, Attribute, ITALIC)) {
              MODULE_IFUNC(Text, Attributed, AppendLiteral)(
                  outBuffer, bufferCapacity, &written, "\033[3m");
            }
            if (currentAttr.underline != 0U) {
              MODULE_IFUNC(Text, Attributed, AppendLiteral)(
                  outBuffer, bufferCapacity, &written, "\033[4m");
            }
            if (currentAttr.foreground != 0U) {
              MODULE_IFUNC(Text, Attributed, AppendAnsiRgb)(
                  outBuffer, bufferCapacity, &written, sgrFgPrefix,
                  currentAttr.foreground);
            }
            if (currentAttr.background != 0U) {
              MODULE_IFUNC(Text, Attributed, AppendAnsiRgb)(
                  outBuffer, bufferCapacity, &written, sgrBgPrefix,
                  currentAttr.background);
            }
            hadStyle = true;
          }
          activeAttr = currentAttr;
        }

        if (written + 1U < bufferCapacity) {
          outBuffer[written++] = self->text[i];
        } else {
          return STATUS_CONST(INSUFFICIENT_SPACE);
        }
      }

      if (hadStyle) {
        MODULE_IFUNC(Text, Attributed, AppendLiteral)(
            outBuffer, bufferCapacity, &written, "\033[0m");
      }

      if (written < bufferCapacity) {
        outBuffer[written] = '\0';
        *outWritten = written;
        return STATUS_CONST(SUCCESS);
      }

      return STATUS_CONST(INSUFFICIENT_SPACE);
    })
  )
);

/* EOF */
