#pragma once

#include <ctype.h>
#include <string.h>

#define TEXT_CSTRING_INTERNAL_COL_NAME(NAME, VALUE) NAME
#define TEXT_CSTRING_INTERNAL_COL_VALUE(NAME, VALUE) VALUE
#define TEXT_CSTRING_INTERNAL_GET(FIELD, ROW)                                  \
  PP_OP_CAT2(TEXT_CSTRING_INTERNAL_COL_, FIELD) ROW

#define TEXT_CSTRING_INTERNAL_TABLE(X) X((ASCII_MAX, 127U))

IENUM_DEF(MODULE_NS(Text, CString), Config, TEXT_CSTRING_INTERNAL_TABLE)

MODULE_IMPLEMENT(DOMAIN(Modules), Text,
  INTERNAL_EX(CString,
    PREDICATE(IsDefaultSpace, (char c), {
      return c == ' ' || c == '\t' || c == '\n' || c == '\r' || c == '\v' ||
             c == '\f';
    }),

    PREDICATE(CharInSet, (char c, const char *set), {
      if (set == NULL) {
        return MODULE_IFUNC(Text, CString, IsDefaultSpace)(c);
      }
      for (size_t i = 0U; set[i] != '\0'; ++i) {
        if (set[i] == c) {
          return true;
        }
      }
      return false;
    })
  ),

  PACKAGE(CString,
    VARIANT(Length,
      FUNCTION(size_t, (const char *str), {
        if (str == NULL) {
          return 0U;
        }
        size_t len = 0U;
        while (str[len] != '\0') {
          len++;
        }
        return len;
      }),

      FUNCTION(size_t, Bounded, (const char *str, size_t maxLen), {
        if (str == NULL) {
          return 0U;
        }
        size_t len = 0U;
        while (len < maxLen && str[len] != '\0') {
          len++;
        }
        return len;
      })
    ),

    PREDICATE(IsEmpty, (const char *str), {
      return (str == NULL || str[0] == '\0');
    }),

    VARIANT(IsAscii,
      PREDICATE((const char *str), {
        if (str == NULL) {
          return false;
        }
        for (size_t i = 0U; str[i] != '\0'; ++i) {
          if ((unsigned char)str[i] > MODULE_IFUNC(Text, CString, ASCII_MAX)) {
            return false;
          }
        }
        return true;
      }),

      PREDICATE(Bounded, (const char *str, size_t maxLen), {
        if (str == NULL) {
          return false;
        }
        for (size_t i = 0U; i < maxLen && str[i] != '\0'; ++i) {
          if ((unsigned char)str[i] > MODULE_IFUNC(Text, CString, ASCII_MAX)) {
            return false;
          }
        }
        return true;
      })
    ),

    VARIANT(Copy,
      OPERATION((char *dest, size_t destCapacity, const char *src,
                 size_t *outLength), {
        if (dest == NULL || destCapacity == 0U || src == NULL) {
          return STATUS_CONST(INVALID_ARGUMENT);
        }
        size_t i = 0U;
        while (src[i] != '\0') {
          if (i + 1U < destCapacity) {
            dest[i] = src[i];
          } else {
            dest[destCapacity - 1U] = '\0';
            return STATUS_CONST(INSUFFICIENT_SPACE);
          }
          i++;
        }
        dest[i] = '\0';
        if (outLength != NULL) {
          *outLength = i;
        }
        return STATUS_CONST(SUCCESS);
      }),

      OPERATION(Bounded,
                (char *dest, size_t destCapacity, const char *src,
                 size_t maxSourceChars, size_t *outLength), {
        if (dest == NULL || destCapacity == 0U || src == NULL) {
          return STATUS_CONST(INVALID_ARGUMENT);
        }
        size_t i = 0U;
        while (i < maxSourceChars && src[i] != '\0') {
          if (i + 1U < destCapacity) {
            dest[i] = src[i];
          } else {
            dest[destCapacity - 1U] = '\0';
            return STATUS_CONST(INSUFFICIENT_SPACE);
          }
          i++;
        }
        dest[i] = '\0';
        if (outLength != NULL) {
          *outLength = i;
        }
        return STATUS_CONST(SUCCESS);
      })
    ),

    VARIANT(Concat,
      OPERATION((char *dest, size_t destCapacity, const char *src,
                 size_t *outLength), {
        if (dest == NULL || destCapacity == 0U || src == NULL) {
          return STATUS_CONST(INVALID_ARGUMENT);
        }
        size_t destLen = 0U;
        while (destLen < destCapacity && dest[destLen] != '\0') {
          destLen++;
        }
        if (destLen >= destCapacity) {
          return STATUS_CONST(INVALID_ARGUMENT);
        }
        size_t j = 0U;
        while (src[j] != '\0') {
          if (destLen + j + 1U < destCapacity) {
            dest[destLen + j] = src[j];
          } else {
            dest[destCapacity - 1U] = '\0';
            return STATUS_CONST(INSUFFICIENT_SPACE);
          }
          j++;
        }
        dest[destLen + j] = '\0';
        if (outLength != NULL) {
          *outLength = destLen + j;
        }
        return STATUS_CONST(SUCCESS);
      }),

      OPERATION(Bounded,
                (char *dest, size_t destCapacity, const char *src,
                 size_t maxSourceChars, size_t *outLength), {
        if (dest == NULL || destCapacity == 0U || src == NULL) {
          return STATUS_CONST(INVALID_ARGUMENT);
        }
        size_t destLen = 0U;
        while (destLen < destCapacity && dest[destLen] != '\0') {
          destLen++;
        }
        if (destLen >= destCapacity) {
          return STATUS_CONST(INVALID_ARGUMENT);
        }
        size_t j = 0U;
        while (j < maxSourceChars && src[j] != '\0') {
          if (destLen + j + 1U < destCapacity) {
            dest[destLen + j] = src[j];
          } else {
            dest[destCapacity - 1U] = '\0';
            return STATUS_CONST(INSUFFICIENT_SPACE);
          }
          j++;
        }
        dest[destLen + j] = '\0';
        if (outLength != NULL) {
          *outLength = destLen + j;
        }
        return STATUS_CONST(SUCCESS);
      })
    ),

    VARIANT(Compare,
      COMPARISON((const char *left, const char *right), {
        if (left == NULL && right == NULL) {
          return COMPARISON_CONST(EQUAL);
        }
        if (left == NULL) {
          return COMPARISON_CONST(LOWER);
        }
        if (right == NULL) {
          return COMPARISON_CONST(HIGHER);
        }
        size_t i = 0U;
        while (left[i] != '\0' && right[i] != '\0') {
          unsigned char lc = (unsigned char)left[i];
          unsigned char rc = (unsigned char)right[i];
          if (lc < rc) {
            return COMPARISON_CONST(LOWER);
          }
          if (lc > rc) {
            return COMPARISON_CONST(HIGHER);
          }
          i++;
        }
        unsigned char lc = (unsigned char)left[i];
        unsigned char rc = (unsigned char)right[i];
        if (lc < rc) {
          return COMPARISON_CONST(LOWER);
        }
        if (lc > rc) {
          return COMPARISON_CONST(HIGHER);
        }
        return COMPARISON_CONST(EQUAL);
      }),

      COMPARISON(Bounded, (const char *left, const char *right, size_t maxLen), {
        if (maxLen == 0U) {
          return COMPARISON_CONST(EQUAL);
        }
        if (left == NULL && right == NULL) {
          return COMPARISON_CONST(EQUAL);
        }
        if (left == NULL) {
          return COMPARISON_CONST(LOWER);
        }
        if (right == NULL) {
          return COMPARISON_CONST(HIGHER);
        }
        size_t i = 0U;
        while (i < maxLen && left[i] != '\0' && right[i] != '\0') {
          unsigned char lc = (unsigned char)left[i];
          unsigned char rc = (unsigned char)right[i];
          if (lc < rc) {
            return COMPARISON_CONST(LOWER);
          }
          if (lc > rc) {
            return COMPARISON_CONST(HIGHER);
          }
          i++;
        }
        if (i == maxLen) {
          return COMPARISON_CONST(EQUAL);
        }
        unsigned char lc = (unsigned char)left[i];
        unsigned char rc = (unsigned char)right[i];
        if (lc < rc) {
          return COMPARISON_CONST(LOWER);
        }
        if (lc > rc) {
          return COMPARISON_CONST(HIGHER);
        }
        return COMPARISON_CONST(EQUAL);
      }),

      COMPARISON(IgnoreCase, (const char *left, const char *right), {
        if (left == NULL && right == NULL) {
          return COMPARISON_CONST(EQUAL);
        }
        if (left == NULL) {
          return COMPARISON_CONST(LOWER);
        }
        if (right == NULL) {
          return COMPARISON_CONST(HIGHER);
        }
        size_t i = 0U;
        while (left[i] != '\0' && right[i] != '\0') {
          int lc = tolower((unsigned char)left[i]);
          int rc = tolower((unsigned char)right[i]);
          if (lc < rc) {
            return COMPARISON_CONST(LOWER);
          }
          if (lc > rc) {
            return COMPARISON_CONST(HIGHER);
          }
          i++;
        }
        int lc = tolower((unsigned char)left[i]);
        int rc = tolower((unsigned char)right[i]);
        if (lc < rc) {
          return COMPARISON_CONST(LOWER);
        }
        if (lc > rc) {
          return COMPARISON_CONST(HIGHER);
        }
        return COMPARISON_CONST(EQUAL);
      }),

      COMPARISON(IgnoreCaseBounded,
                 (const char *left, const char *right, size_t maxLen), {
        if (maxLen == 0U) {
          return COMPARISON_CONST(EQUAL);
        }
        if (left == NULL && right == NULL) {
          return COMPARISON_CONST(EQUAL);
        }
        if (left == NULL) {
          return COMPARISON_CONST(LOWER);
        }
        if (right == NULL) {
          return COMPARISON_CONST(HIGHER);
        }
        size_t i = 0U;
        while (i < maxLen && left[i] != '\0' && right[i] != '\0') {
          int lc = tolower((unsigned char)left[i]);
          int rc = tolower((unsigned char)right[i]);
          if (lc < rc) {
            return COMPARISON_CONST(LOWER);
          }
          if (lc > rc) {
            return COMPARISON_CONST(HIGHER);
          }
          i++;
        }
        if (i == maxLen) {
          return COMPARISON_CONST(EQUAL);
        }
        int lc = tolower((unsigned char)left[i]);
        int rc = tolower((unsigned char)right[i]);
        if (lc < rc) {
          return COMPARISON_CONST(LOWER);
        }
        if (lc > rc) {
          return COMPARISON_CONST(HIGHER);
        }
        return COMPARISON_CONST(EQUAL);
      })
    ),

    VARIANT(Equal,
      PREDICATE((const char *left, const char *right), {
        return MODULE_FUNC(Text, CString, Compare)(left, right) ==
               COMPARISON_CONST(EQUAL);
      }),

      PREDICATE(Bounded, (const char *left, const char *right, size_t maxLen), {
        return MODULE_FUNC(Text, CString, CompareBounded)(
                   left, right, maxLen) == COMPARISON_CONST(EQUAL);
      }),

      PREDICATE(IgnoreCase, (const char *left, const char *right), {
        return MODULE_FUNC(Text, CString, CompareIgnoreCase)(left, right) ==
               COMPARISON_CONST(EQUAL);
      }),

      PREDICATE(IgnoreCaseBounded,
                (const char *left, const char *right, size_t maxLen), {
        return MODULE_FUNC(Text, CString, CompareIgnoreCaseBounded)(
                   left, right, maxLen) == COMPARISON_CONST(EQUAL);
      })
    ),

    VARIANT(StartsWith,
      PREDICATE((const char *str, const char *prefix), {
        if (str == NULL || prefix == NULL) {
          return false;
        }
        size_t i = 0U;
        while (prefix[i] != '\0') {
          if (str[i] != prefix[i]) {
            return false;
          }
          i++;
        }
        return true;
      }),

      PREDICATE(Bounded, (const char *str, size_t strLen, const char *prefix), {
        if (str == NULL || prefix == NULL) {
          return false;
        }
        size_t i = 0U;
        while (prefix[i] != '\0') {
          if (i >= strLen || str[i] != prefix[i]) {
            return false;
          }
          i++;
        }
        return true;
      }),

      PREDICATE(IgnoreCase, (const char *str, const char *prefix), {
        if (str == NULL || prefix == NULL) {
          return false;
        }
        size_t i = 0U;
        while (prefix[i] != '\0') {
          if (tolower((unsigned char)str[i]) !=
              tolower((unsigned char)prefix[i])) {
            return false;
          }
          i++;
        }
        return true;
      })
    ),

    VARIANT(EndsWith,
      PREDICATE((const char *str, const char *suffix), {
        if (str == NULL || suffix == NULL) {
          return false;
        }
        size_t strLen = MODULE_FUNC(Text, CString, Length)(str);
        size_t sufLen = MODULE_FUNC(Text, CString, Length)(suffix);
        if (sufLen > strLen) {
          return false;
        }
        return memcmp(str + (strLen - sufLen), suffix, sufLen) == 0;
      }),

      PREDICATE(Bounded, (const char *str, size_t strLen, const char *suffix), {
        if (str == NULL || suffix == NULL) {
          return false;
        }
        size_t actualLen =
            MODULE_FUNC(Text, CString, LengthBounded)(str, strLen);
        size_t sufLen = MODULE_FUNC(Text, CString, Length)(suffix);
        if (sufLen > actualLen) {
          return false;
        }
        return memcmp(str + (actualLen - sufLen), suffix, sufLen) == 0;
      }),

      PREDICATE(IgnoreCase, (const char *str, const char *suffix), {
        if (str == NULL || suffix == NULL) {
          return false;
        }
        size_t strLen = MODULE_FUNC(Text, CString, Length)(str);
        size_t sufLen = MODULE_FUNC(Text, CString, Length)(suffix);
        if (sufLen > strLen) {
          return false;
        }
        const char *sub = str + (strLen - sufLen);
        for (size_t i = 0U; i < sufLen; ++i) {
          if (tolower((unsigned char)sub[i]) !=
              tolower((unsigned char)suffix[i])) {
            return false;
          }
        }
        return true;
      })
    ),

    VARIANT(FindChar,
      OPERATION((const char *str, char ch, size_t *outIndex), {
        if (str == NULL || outIndex == NULL) {
          return STATUS_CONST(INVALID_ARGUMENT);
        }
        for (size_t i = 0U; str[i] != '\0'; ++i) {
          if (str[i] == ch) {
            *outIndex = i;
            return STATUS_CONST(SUCCESS);
          }
        }
        if (ch == '\0') {
          *outIndex = MODULE_FUNC(Text, CString, Length)(str);
          return STATUS_CONST(SUCCESS);
        }
        return STATUS_CONST(NOT_FOUND);
      }),

      OPERATION(Bounded, (const char *str, size_t maxLen, char ch,
                          size_t *outIndex), {
        if (str == NULL || outIndex == NULL) {
          return STATUS_CONST(INVALID_ARGUMENT);
        }
        for (size_t i = 0U; i < maxLen && str[i] != '\0'; ++i) {
          if (str[i] == ch) {
            *outIndex = i;
            return STATUS_CONST(SUCCESS);
          }
        }
        return STATUS_CONST(NOT_FOUND);
      })
    ),

    VARIANT(FindLastChar,
      OPERATION((const char *str, char ch, size_t *outIndex), {
        if (str == NULL || outIndex == NULL) {
          return STATUS_CONST(INVALID_ARGUMENT);
        }
        size_t len = MODULE_FUNC(Text, CString, Length)(str);
        if (ch == '\0') {
          *outIndex = len;
          return STATUS_CONST(SUCCESS);
        }
        while (len > 0U) {
          len--;
          if (str[len] == ch) {
            *outIndex = len;
            return STATUS_CONST(SUCCESS);
          }
        }
        return STATUS_CONST(NOT_FOUND);
      }),

      OPERATION(Bounded, (const char *str, size_t maxLen, char ch,
                          size_t *outIndex), {
        if (str == NULL || outIndex == NULL) {
          return STATUS_CONST(INVALID_ARGUMENT);
        }
        size_t len = MODULE_FUNC(Text, CString, LengthBounded)(str, maxLen);
        while (len > 0U) {
          len--;
          if (str[len] == ch) {
            *outIndex = len;
            return STATUS_CONST(SUCCESS);
          }
        }
        return STATUS_CONST(NOT_FOUND);
      })
    ),

    VARIANT(FindCStr,
      OPERATION((const char *haystack, const char *needle, size_t *outIndex), {
        if (haystack == NULL || needle == NULL || outIndex == NULL) {
          return STATUS_CONST(INVALID_ARGUMENT);
        }
        size_t needleLen = MODULE_FUNC(Text, CString, Length)(needle);
        if (needleLen == 0U) {
          *outIndex = 0U;
          return STATUS_CONST(SUCCESS);
        }
        size_t hayLen = MODULE_FUNC(Text, CString, Length)(haystack);
        if (needleLen > hayLen) {
          return STATUS_CONST(NOT_FOUND);
        }
        for (size_t i = 0U; i <= hayLen - needleLen; ++i) {
          if (memcmp(haystack + i, needle, needleLen) == 0) {
            *outIndex = i;
            return STATUS_CONST(SUCCESS);
          }
        }
        return STATUS_CONST(NOT_FOUND);
      }),

      OPERATION(Bounded,
                (const char *haystack, size_t maxHaystackLen,
                 const char *needle, size_t *outIndex), {
        if (haystack == NULL || needle == NULL || outIndex == NULL) {
          return STATUS_CONST(INVALID_ARGUMENT);
        }
        size_t needleLen = MODULE_FUNC(Text, CString, Length)(needle);
        if (needleLen == 0U) {
          *outIndex = 0U;
          return STATUS_CONST(SUCCESS);
        }
        size_t hayLen =
            MODULE_FUNC(Text, CString, LengthBounded)(haystack, maxHaystackLen);
        if (needleLen > hayLen) {
          return STATUS_CONST(NOT_FOUND);
        }
        for (size_t i = 0U; i <= hayLen - needleLen; ++i) {
          if (memcmp(haystack + i, needle, needleLen) == 0) {
            *outIndex = i;
            return STATUS_CONST(SUCCESS);
          }
        }
        return STATUS_CONST(NOT_FOUND);
      })
    ),

    OPERATION(Span, (const char *str, const char *accept, size_t *outLength), {
      if (str == NULL || accept == NULL || outLength == NULL) {
        return STATUS_CONST(INVALID_ARGUMENT);
      }
      size_t count = 0U;
      while (str[count] != '\0') {
        if (!MODULE_IFUNC(Text, CString, CharInSet)(str[count], accept)) {
          break;
        }
        count++;
      }
      *outLength = count;
      return STATUS_CONST(SUCCESS);
    }),

    OPERATION(ComplementSpan,
              (const char *str, const char *reject, size_t *outLength), {
      if (str == NULL || reject == NULL || outLength == NULL) {
        return STATUS_CONST(INVALID_ARGUMENT);
      }
      size_t count = 0U;
      while (str[count] != '\0') {
        if (MODULE_IFUNC(Text, CString, CharInSet)(str[count], reject)) {
          break;
        }
        count++;
      }
      *outLength = count;
      return STATUS_CONST(SUCCESS);
    }),

    VARIANT(Trim,
      OPERATION((const char *str, const char *charsToTrim, char *output,
                 size_t capacity, size_t *outLength), {
        if (str == NULL || output == NULL || capacity == 0U ||
            outLength == NULL) {
          return STATUS_CONST(INVALID_ARGUMENT);
        }
        size_t start = 0U;
        while (str[start] != '\0' &&
               MODULE_IFUNC(Text, CString, CharInSet)(str[start], charsToTrim)) {
          start++;
        }
        size_t len = MODULE_FUNC(Text, CString, Length)(str);
        while (len > start &&
               MODULE_IFUNC(Text, CString, CharInSet)(str[len - 1U],
                                                      charsToTrim)) {
          len--;
        }
        size_t trimmedLen = len - start;
        return MODULE_FUNC(Text, CString, CopyBounded)(
            output, capacity, str + start, trimmedLen, outLength);
      }),

      OPERATION(Left,
                (const char *str, const char *charsToTrim, char *output,
                 size_t capacity, size_t *outLength), {
        if (str == NULL || output == NULL || capacity == 0U ||
            outLength == NULL) {
          return STATUS_CONST(INVALID_ARGUMENT);
        }
        size_t start = 0U;
        while (str[start] != '\0' &&
               MODULE_IFUNC(Text, CString, CharInSet)(str[start], charsToTrim)) {
          start++;
        }
        return MODULE_FUNC(Text, CString, Copy)(output, capacity, str + start,
                                                outLength);
      }),

      OPERATION(Right,
                (const char *str, const char *charsToTrim, char *output,
                 size_t capacity, size_t *outLength), {
        if (str == NULL || output == NULL || capacity == 0U ||
            outLength == NULL) {
          return STATUS_CONST(INVALID_ARGUMENT);
        }
        size_t len = MODULE_FUNC(Text, CString, Length)(str);
        while (len > 0U &&
               MODULE_IFUNC(Text, CString, CharInSet)(str[len - 1U],
                                                      charsToTrim)) {
          len--;
        }
        return MODULE_FUNC(Text, CString, CopyBounded)(output, capacity, str,
                                                       len, outLength);
      })
    ),

    VARIANT(CountChar,
      OPERATION((const char *str, char ch, size_t *outCount), {
        if (str == NULL || outCount == NULL) {
          return STATUS_CONST(INVALID_ARGUMENT);
        }
        size_t count = 0U;
        for (size_t i = 0U; str[i] != '\0'; ++i) {
          if (str[i] == ch) {
            count++;
          }
        }
        *outCount = count;
        return STATUS_CONST(SUCCESS);
      }),

      OPERATION(Bounded, (const char *str, size_t maxLen, char ch,
                          size_t *outCount), {
        if (str == NULL || outCount == NULL) {
          return STATUS_CONST(INVALID_ARGUMENT);
        }
        size_t count = 0U;
        for (size_t i = 0U; i < maxLen && str[i] != '\0'; ++i) {
          if (str[i] == ch) {
            count++;
          }
        }
        *outCount = count;
        return STATUS_CONST(SUCCESS);
      })
    ),

    VARIANT(ReplaceChar,
      OPERATION((char *str, char from, char to, size_t *outCount), {
        if (str == NULL) {
          return STATUS_CONST(INVALID_ARGUMENT);
        }
        size_t count = 0U;
        for (size_t i = 0U; str[i] != '\0'; ++i) {
          if (str[i] == from) {
            str[i] = to;
            count++;
          }
        }
        if (outCount != NULL) {
          *outCount = count;
        }
        return STATUS_CONST(SUCCESS);
      }),

      OPERATION(Bounded, (char *str, size_t maxLen, char from, char to,
                          size_t *outCount), {
        if (str == NULL) {
          return STATUS_CONST(INVALID_ARGUMENT);
        }
        size_t count = 0U;
        for (size_t i = 0U; i < maxLen && str[i] != '\0'; ++i) {
          if (str[i] == from) {
            str[i] = to;
            count++;
          }
        }
        if (outCount != NULL) {
          *outCount = count;
        }
        return STATUS_CONST(SUCCESS);
      })
    ),

    VARIANT(Duplicate,
      OPERATION((const char *src, char **outDest), {
        if (src == NULL || outDest == NULL) {
          return STATUS_CONST(INVALID_ARGUMENT);
        }
        size_t len = MODULE_FUNC(Text, CString, Length)(src);
        void *allocated = NULL;
        OPSTATUS status = MODULE_FUNC(Memory, Alloc, Bytes)(&allocated, len + 1U);
        if (status != STATUS_CONST(SUCCESS)) {
          return status;
        }
        char *buf = (char *)allocated;
        memcpy(buf, src, len);
        buf[len] = '\0';
        *outDest = buf;
        return STATUS_CONST(SUCCESS);
      }),

      OPERATION(Bounded, (const char *src, size_t maxLen, char **outDest), {
        if (src == NULL || outDest == NULL) {
          return STATUS_CONST(INVALID_ARGUMENT);
        }
        size_t len = MODULE_FUNC(Text, CString, LengthBounded)(src, maxLen);
        void *allocated = NULL;
        OPSTATUS status = MODULE_FUNC(Memory, Alloc, Bytes)(&allocated, len + 1U);
        if (status != STATUS_CONST(SUCCESS)) {
          return status;
        }
        char *buf = (char *)allocated;
        memcpy(buf, src, len);
        buf[len] = '\0';
        *outDest = buf;
        return STATUS_CONST(SUCCESS);
      })
    ),

    PROCEDURE(Free, (char *str), {
      if (str != NULL) {
        void *ptr = str;
        MODULE_FUNC(Memory, Alloc, Free)(&ptr);
      }
    })
  )
);

/* EOF */
