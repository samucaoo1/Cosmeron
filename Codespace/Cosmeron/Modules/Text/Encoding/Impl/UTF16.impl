#pragma once

PACKAGE_OPERATION_IMPLEMENT_EX(Text_UTF16, EncodedLength,
                               (MODULE_TYPE(Text, Char32) codepoint,
                                size_t *outUnits)) {
  uint_least32_t value = (uint_least32_t)codepoint;

  if (outUnits == NULL)
    return STATUS_CONST(INVALID_ARGUMENT);
  if (!MODULE_FUNC(Text, Codepoint, IsScalar)(codepoint))
    return STATUS_CONST(INVALID_SEQUENCE);

  *outUnits = value <= UINT32_C(0xFFFF) ? 1U : 2U;
  return STATUS_CONST(SUCCESS);
}

PACKAGE_OPERATION_IMPLEMENT_EX(Text_UTF16, Encode,
                               (MODULE_TYPE(Text, Char32) codepoint,
                                MODULE_TYPE(Text, Char16) *output,
                                size_t capacity, size_t *outUnits)) {
  uint_least32_t value = (uint_least32_t)codepoint;
  size_t length = 0U;
  OPSTATUS status;

  if (output == NULL || outUnits == NULL)
    return STATUS_CONST(INVALID_ARGUMENT);

  status = MODULE_FUNC(Text, UTF16, EncodedLength)(codepoint, &length);
  if (status != STATUS_CONST(SUCCESS))
    return status;
  if (capacity < length)
    return STATUS_CONST(INSUFFICIENT_SPACE);

  if (length == 1U) {
    output[0] = (MODULE_TYPE(Text, Char16))value;
  } else {
    value -= UINT32_C(0x10000);
    output[0] =
        (MODULE_TYPE(Text, Char16))(UINT32_C(0xD800) + (value >> 10U));
    output[1] =
        (MODULE_TYPE(Text, Char16))(UINT32_C(0xDC00) + (value & UINT32_C(0x3FF)));
  }

  *outUnits = length;
  return STATUS_CONST(SUCCESS);
}

PACKAGE_OPERATION_IMPLEMENT_EX(Text_UTF16, Decode,
                               (const MODULE_TYPE(Text, Char16) *input,
                                size_t size,
                                MODULE_TYPE(Text, Char32) *outCodepoint,
                                size_t *outUnits)) {
  uint_least32_t first;
  MODULE_TYPE(Text, Char32) codepoint;
  size_t units;

  if (input == NULL || outCodepoint == NULL || outUnits == NULL)
    return STATUS_CONST(INVALID_ARGUMENT);
  if (size == 0U)
    return STATUS_CONST(INCOMPLETE_SEQUENCE);

  first = (uint_least32_t)input[0];
  if (first < UINT32_C(0xD800) || first > UINT32_C(0xDFFF)) {
    codepoint = (MODULE_TYPE(Text, Char32))first;
    units = 1U;
  } else {
    if (first > UINT32_C(0xDBFF))
      return STATUS_CONST(INVALID_SEQUENCE);
    if (size < 2U)
      return STATUS_CONST(INCOMPLETE_SEQUENCE);
    if ((uint_least32_t)input[1] < UINT32_C(0xDC00) ||
        (uint_least32_t)input[1] > UINT32_C(0xDFFF))
      return STATUS_CONST(INVALID_SEQUENCE);

    codepoint = (MODULE_TYPE(Text, Char32))(
        UINT32_C(0x10000) + ((first - UINT32_C(0xD800)) << 10U) +
        ((uint_least32_t)input[1] - UINT32_C(0xDC00)));
    units = 2U;
  }

  *outCodepoint = codepoint;
  *outUnits = units;
  return STATUS_CONST(SUCCESS);
}

PACKAGE_PREDICATE_IMPLEMENT_EX(Text_UTF16, Validate,
                               (const MODULE_TYPE(Text, Char16) *input,
                                size_t size)) {
  size_t offset = 0U;

  if (input == NULL && size != 0U)
    return false;

  while (offset < size) {
    MODULE_TYPE(Text, Char32) codepoint;
    size_t units;
    if (MODULE_FUNC(Text, UTF16, Decode)(input + offset, size - offset, &codepoint,
                                &units) != STATUS_CONST(SUCCESS))
      return false;
    offset += units;
  }

  return true;
}
/* EOF */
