#pragma once

TEXT_UTF16_ENCODED_LENGTH_PROTOTYPE {
  uint_least32_t value = (uint_least32_t)codepoint;

  if (outUnits == NULL)
    return STATUS_CONST(INVALID_ARGUMENT);
  if (!TEXT_CODEPOINT_FUNC(IsScalar)(codepoint))
    return STATUS_CONST(INVALID_SEQUENCE);

  *outUnits = value <= UINT32_C(0xFFFF) ? 1U : 2U;
  return STATUS_CONST(SUCCESS);
}

TEXT_UTF16_ENCODE_PROTOTYPE {
  uint_least32_t value = (uint_least32_t)codepoint;
  size_t length = 0U;
  OPSTATUS status;

  if (output == NULL || outUnits == NULL)
    return STATUS_CONST(INVALID_ARGUMENT);

  status = TEXT_UTF16_FUNC(EncodedLength)(codepoint, &length);
  if (status != STATUS_CONST(SUCCESS))
    return status;
  if (capacity < length)
    return STATUS_CONST(INSUFFICIENT_SPACE);

  if (length == 1U) {
    output[0] = (TEXT_TYPE(TChar16))value;
  } else {
    value -= UINT32_C(0x10000);
    output[0] =
        (TEXT_TYPE(TChar16))(UINT32_C(0xD800) + (value >> 10U));
    output[1] =
        (TEXT_TYPE(TChar16))(UINT32_C(0xDC00) + (value & UINT32_C(0x3FF)));
  }

  *outUnits = length;
  return STATUS_CONST(SUCCESS);
}

TEXT_UTF16_DECODE_PROTOTYPE {
  uint_least32_t first;
  TEXT_TYPE(TChar32) codepoint;
  size_t units;

  if (input == NULL || outCodepoint == NULL || outUnits == NULL)
    return STATUS_CONST(INVALID_ARGUMENT);
  if (size == 0U)
    return STATUS_CONST(INCOMPLETE_SEQUENCE);

  first = (uint_least32_t)input[0];
  if (first < UINT32_C(0xD800) || first > UINT32_C(0xDFFF)) {
    codepoint = (TEXT_TYPE(TChar32))first;
    units = 1U;
  } else {
    if (first > UINT32_C(0xDBFF))
      return STATUS_CONST(INVALID_SEQUENCE);
    if (size < 2U)
      return STATUS_CONST(INCOMPLETE_SEQUENCE);
    if ((uint_least32_t)input[1] < UINT32_C(0xDC00) ||
        (uint_least32_t)input[1] > UINT32_C(0xDFFF))
      return STATUS_CONST(INVALID_SEQUENCE);

    codepoint = (TEXT_TYPE(TChar32))(
        UINT32_C(0x10000) + ((first - UINT32_C(0xD800)) << 10U) +
        ((uint_least32_t)input[1] - UINT32_C(0xDC00)));
    units = 2U;
  }

  *outCodepoint = codepoint;
  *outUnits = units;
  return STATUS_CONST(SUCCESS);
}

TEXT_UTF16_VALIDATE_PROTOTYPE {
  size_t offset = 0U;

  if (input == NULL && size != 0U)
    return false;

  while (offset < size) {
    TEXT_TYPE(TChar32) codepoint;
    size_t units;
    if (TEXT_UTF16_FUNC(Decode)(input + offset, size - offset, &codepoint,
                                &units) != STATUS_CONST(SUCCESS))
      return false;
    offset += units;
  }

  return true;
}
/* EOF */
