#pragma once

#define TEXT_UTF16_CONST_COL_NAME(NAME, VALUE) NAME
#define TEXT_UTF16_CONST_COL_VALUE(NAME, VALUE) VALUE
#define TEXT_UTF16_CONST_GET(FIELD, ROW)                                       \
  PP_OP_CAT2(TEXT_UTF16_CONST_COL_, FIELD) ROW

#define TEXT_UTF16_CONST_TABLE(X)                                              \
  X((BMP_MAX, 0xFFFFU))                                                        \
  X((SUPPLEMENTARY_BASE, 0x10000U))                                            \
  X((HIGH_SURROGATE_MIN, 0xD800U))                                             \
  X((HIGH_SURROGATE_MAX, 0xDBFFU))                                             \
  X((LOW_SURROGATE_MIN, 0xDC00U))                                              \
  X((LOW_SURROGATE_MAX, 0xDFFFU))                                              \
  X((SURROGATE_MASK, 0x3FFU))                                                  \
  X((SURROGATE_BITS, 10U))

MODULE(DOMAIN(Modules), Text,
  INTERNAL_EX(UTF16,
    ENUM_EX(Const, TEXT_UTF16_CONST_TABLE, PLAIN)
  )
);

MODULE_IMPLEMENT(DOMAIN(Modules), Text,
  PACKAGE(UTF16,
    OPERATION(EncodedLength,
              (MODULE_TYPE(Text, Char32) codepoint, size_t *outUnits), {
      if (outUnits == NULL) {
        return STATUS_CONST(INVALID_ARGUMENT);
      }
      if (!MODULE_FUNC(Text, Codepoint, IsScalar)(codepoint)) {
        return STATUS_CONST(INVALID_SEQUENCE);
      }

      const uint_least32_t value = (uint_least32_t)codepoint;
      *outUnits = (value <= CNS(Text, UTF16, Internal, BMP_MAX)) ? 1U : 2U;
      return STATUS_CONST(SUCCESS);
    }),

    OPERATION(Encode,
              (MODULE_TYPE(Text, Char32) codepoint,
               MODULE_TYPE(Text, Char16) *output, size_t capacity,
               size_t *outUnits), {
      if (output == NULL || outUnits == NULL) {
        return STATUS_CONST(INVALID_ARGUMENT);
      }

      size_t length = 0U;
      const OPSTATUS status =
          MODULE_FUNC(Text, UTF16, EncodedLength)(codepoint, &length);
      if (status != STATUS_CONST(SUCCESS)) {
        return status;
      }
      if (capacity < length) {
        return STATUS_CONST(INSUFFICIENT_SPACE);
      }

      uint_least32_t value = (uint_least32_t)codepoint;
      if (length == 1U) {
        output[0] = (MODULE_TYPE(Text, Char16))value;
      } else {
        value -= CNS(Text, UTF16, Internal, SUPPLEMENTARY_BASE);
        output[0] = (MODULE_TYPE(Text, Char16))(
            CNS(Text, UTF16, Internal, HIGH_SURROGATE_MIN) +
            (value >> CNS(Text, UTF16, Internal, SURROGATE_BITS)));
        output[1] = (MODULE_TYPE(Text, Char16))(
            CNS(Text, UTF16, Internal, LOW_SURROGATE_MIN) +
            (value & CNS(Text, UTF16, Internal, SURROGATE_MASK)));
      }

      *outUnits = length;
      return STATUS_CONST(SUCCESS);
    }),

    OPERATION(Decode,
              (const MODULE_TYPE(Text, Char16) *input, size_t size,
               MODULE_TYPE(Text, Char32) *outCodepoint, size_t *outUnits), {
      if (input == NULL || outCodepoint == NULL || outUnits == NULL) {
        return STATUS_CONST(INVALID_ARGUMENT);
      }
      if (size == 0U) {
        return STATUS_CONST(INCOMPLETE_SEQUENCE);
      }

      const uint_least32_t first = (uint_least32_t)input[0];
      if (first < CNS(Text, UTF16, Internal, HIGH_SURROGATE_MIN) ||
          first > CNS(Text, UTF16, Internal, LOW_SURROGATE_MAX)) {
        *outCodepoint = (MODULE_TYPE(Text, Char32))first;
        *outUnits = 1U;
        return STATUS_CONST(SUCCESS);
      }

      if (first > CNS(Text, UTF16, Internal, HIGH_SURROGATE_MAX)) {
        return STATUS_CONST(INVALID_SEQUENCE);
      }
      if (size < 2U) {
        return STATUS_CONST(INCOMPLETE_SEQUENCE);
      }

      const uint_least32_t second = (uint_least32_t)input[1];
      if (second < CNS(Text, UTF16, Internal, LOW_SURROGATE_MIN) ||
          second > CNS(Text, UTF16, Internal, LOW_SURROGATE_MAX)) {
        return STATUS_CONST(INVALID_SEQUENCE);
      }

      *outCodepoint = (MODULE_TYPE(Text, Char32))(
          CNS(Text, UTF16, Internal, SUPPLEMENTARY_BASE) +
          ((first - CNS(Text, UTF16, Internal, HIGH_SURROGATE_MIN))
           << CNS(Text, UTF16, Internal, SURROGATE_BITS)) +
          (second - CNS(Text, UTF16, Internal, LOW_SURROGATE_MIN)));
      *outUnits = 2U;
      return STATUS_CONST(SUCCESS);
    }),

    PREDICATE(Validate,
              (const MODULE_TYPE(Text, Char16) *input, size_t size), {
      if (input == NULL && size != 0U) {
        return false;
      }

      size_t offset = 0U;
      while (offset < size) {
        MODULE_TYPE(Text, Char32) codepoint = 0;
        size_t units = 0U;
        if (MODULE_FUNC(Text, UTF16, Decode)(input + offset, size - offset,
                                             &codepoint,
                                             &units) != STATUS_CONST(SUCCESS)) {
          return false;
        }
        offset += units;
      }

      return true;
    })
  )
);

/* EOF */
