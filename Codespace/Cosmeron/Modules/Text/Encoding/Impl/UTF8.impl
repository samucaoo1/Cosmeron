#pragma once

PACKAGE_OPERATION_IMPLEMENT_EX(Text_UTF8, EncodedLength,
                               (MODULE_TYPE(Text, Char32) codepoint,
                                size_t *outUnits)) {
  uint_least32_t value = (uint_least32_t)codepoint;

  if (outUnits == NULL)
    return STATUS_CONST(INVALID_ARGUMENT);
  if (!MODULE_FUNC(Text, Codepoint, IsScalar)(codepoint))
    return STATUS_CONST(INVALID_SEQUENCE);

  if (value <= UINT32_C(0x7F))
    *outUnits = 1U;
  else if (value <= UINT32_C(0x7FF))
    *outUnits = 2U;
  else if (value <= UINT32_C(0xFFFF))
    *outUnits = 3U;
  else
    *outUnits = 4U;

  return STATUS_CONST(SUCCESS);
}

PACKAGE_OPERATION_IMPLEMENT_EX(Text_UTF8, Encode,
                               (MODULE_TYPE(Text, Char32) codepoint,
                                unsigned char *output, size_t capacity,
                                size_t *outUnits)) {
  uint_least32_t value = (uint_least32_t)codepoint;
  size_t length = 0U;
  OPSTATUS status;

  if (output == NULL || outUnits == NULL)
    return STATUS_CONST(INVALID_ARGUMENT);

  status = MODULE_FUNC(Text, UTF8, EncodedLength)(codepoint, &length);
  if (status != STATUS_CONST(SUCCESS))
    return status;
  if (capacity < length)
    return STATUS_CONST(INSUFFICIENT_SPACE);

  if (length == 1U) {
    output[0] = (unsigned char)value;
  } else if (length == 2U) {
    output[0] = (unsigned char)(UINT32_C(0xC0) | (value >> 6U));
    output[1] = (unsigned char)(UINT32_C(0x80) | (value & UINT32_C(0x3F)));
  } else if (length == 3U) {
    output[0] = (unsigned char)(UINT32_C(0xE0) | (value >> 12U));
    output[1] =
        (unsigned char)(UINT32_C(0x80) | ((value >> 6U) & UINT32_C(0x3F)));
    output[2] = (unsigned char)(UINT32_C(0x80) | (value & UINT32_C(0x3F)));
  } else {
    output[0] = (unsigned char)(UINT32_C(0xF0) | (value >> 18U));
    output[1] =
        (unsigned char)(UINT32_C(0x80) | ((value >> 12U) & UINT32_C(0x3F)));
    output[2] =
        (unsigned char)(UINT32_C(0x80) | ((value >> 6U) & UINT32_C(0x3F)));
    output[3] = (unsigned char)(UINT32_C(0x80) | (value & UINT32_C(0x3F)));
  }

  *outUnits = length;
  return STATUS_CONST(SUCCESS);
}

PACKAGE_OPERATION_IMPLEMENT_EX(Text_UTF8, Decode,
                               (const unsigned char *input, size_t size,
                                MODULE_TYPE(Text, Char32) *outCodepoint,
                                size_t *outUnits)) {
  uint_least32_t value;
  uint_least32_t minimum;
  size_t length;
  size_t index;

  if (input == NULL || outCodepoint == NULL || outUnits == NULL)
    return STATUS_CONST(INVALID_ARGUMENT);
  if (size == 0U)
    return STATUS_CONST(INCOMPLETE_SEQUENCE);

  if (input[0] <= 0x7FU) {
    *outCodepoint = (MODULE_TYPE(Text, Char32))input[0];
    *outUnits = 1U;
    return STATUS_CONST(SUCCESS);
  }

  if (input[0] >= 0xC2U && input[0] <= 0xDFU) {
    value = input[0] & 0x1FU;
    length = 2U;
    minimum = UINT32_C(0x80);
  } else if (input[0] >= 0xE0U && input[0] <= 0xEFU) {
    value = input[0] & 0x0FU;
    length = 3U;
    minimum = UINT32_C(0x800);
  } else if (input[0] >= 0xF0U && input[0] <= 0xF4U) {
    value = input[0] & 0x07U;
    length = 4U;
    minimum = UINT32_C(0x10000);
  } else {
    return STATUS_CONST(INVALID_SEQUENCE);
  }

  if (size < length)
    return STATUS_CONST(INCOMPLETE_SEQUENCE);

  for (index = 1U; index < length; ++index) {
    if ((input[index] & 0xC0U) != 0x80U)
      return STATUS_CONST(INVALID_SEQUENCE);
    value = (value << 6U) | (input[index] & 0x3FU);
  }

  if (value < minimum ||
      !MODULE_FUNC(Text, Codepoint, IsScalar)((MODULE_TYPE(Text, Char32))value))
    return STATUS_CONST(INVALID_SEQUENCE);

  *outCodepoint = (MODULE_TYPE(Text, Char32))value;
  *outUnits = length;
  return STATUS_CONST(SUCCESS);
}

PACKAGE_OPERATION_IMPLEMENT_EX(Text_UTF8, Count,
                               (const unsigned char *input, size_t size,
                                size_t *outCodepoints, size_t *outUnits)) {
  size_t offset = 0U;
  size_t count = 0U;

  if (outCodepoints == NULL || outUnits == NULL)
    return STATUS_CONST(INVALID_ARGUMENT);
  if (input == NULL && size != 0U)
    return STATUS_CONST(INVALID_ARGUMENT);

  while (offset < size) {
    MODULE_TYPE(Text, Char32) codepoint;
    size_t units;
    OPSTATUS status =
        MODULE_FUNC(Text, UTF8, Decode)(input + offset, size - offset, &codepoint, &units);
    (void)codepoint;
    if (status != STATUS_CONST(SUCCESS))
      return status;
    offset += units;
    ++count;
  }

  *outCodepoints = count;
  *outUnits = offset;
  return STATUS_CONST(SUCCESS);
}

PACKAGE_PREDICATE_IMPLEMENT_EX(Text_UTF8, Validate,
                               (const unsigned char *input, size_t size)) {
  size_t codepoints;
  size_t units;
  return MODULE_FUNC(Text, UTF8, Count)(input, size, &codepoints, &units) ==
         STATUS_CONST(SUCCESS);
}
/* EOF */
