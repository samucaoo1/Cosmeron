#pragma once

#include <ctype.h>
#include <inttypes.h>
#include <math.h>
#include <stdio.h>
#include <string.h>

#define TEXT_FORMAT_BYTES_HUMAN_INTERNAL_COL_NAME(NAME, VALUE) NAME
#define TEXT_FORMAT_BYTES_HUMAN_INTERNAL_COL_VALUE(NAME, VALUE) VALUE
#define TEXT_FORMAT_BYTES_HUMAN_INTERNAL_GET(FIELD, ROW)                       \
  PP_OP_CAT2(TEXT_FORMAT_BYTES_HUMAN_INTERNAL_COL_, FIELD) ROW

#define TEXT_FORMAT_BYTES_HUMAN_INTERNAL_TABLE(X)                              \
  X((UNIT_COUNT, 7U))                                                          \
  X((MAX_FRAC_DIGITS, 9U))                                                     \
  X((DECIMAL_BASE, 10U))

IENUM_DEF(Text_Format, BytesHumanConfig, TEXT_FORMAT_BYTES_HUMAN_INTERNAL_TABLE)

MODULE_IMPLEMENT(DOMAIN(Modules), Text,
  INTERNAL_EX(BytesHuman,
    OPERATION(ResolveUnitMultiplier,
              (const char *unitBuf, size_t unitLen, uint64_t *outMultiplier), {
      if (unitLen == 0U || strcmp(unitBuf, "b") == 0) {
        *outMultiplier = 1ULL;
        return STATUS_CONST(SUCCESS);
      }

      static const char *const iecNames[CNS(Text, Format, Internal, UNIT_COUNT)] = {
          "b", "kib", "mib", "gib", "tib", "pib", "eib"
      };
      static const char *const siNames[CNS(Text, Format, Internal, UNIT_COUNT)] = {
          "b", "kb", "mb", "gb", "tb", "pb", "eb"
      };
      static const char shortLetters[CNS(Text, Format, Internal, UNIT_COUNT)] = {
          'b', 'k', 'm', 'g', 't', 'p', 'e'
      };

      uint64_t iecMul = 1ULL;
      uint64_t siMul = 1ULL;
      const uint64_t iecBase = (uint64_t)CNS(Text, Format, BYTES_IEC_BASE);
      const uint64_t siBase = (uint64_t)CNS(Text, Format, BYTES_SI_BASE);

      for (size_t i = 1U; i < (size_t)CNS(Text, Format, Internal, UNIT_COUNT);
           ++i) {
        iecMul *= iecBase;
        siMul *= siBase;
        if ((unitLen == 1U && unitBuf[0] == shortLetters[i]) ||
            strcmp(unitBuf, iecNames[i]) == 0) {
          *outMultiplier = iecMul;
          return STATUS_CONST(SUCCESS);
        }
        if (strcmp(unitBuf, siNames[i]) == 0) {
          *outMultiplier = siMul;
          return STATUS_CONST(SUCCESS);
        }
      }

      return STATUS_CONST(INVALID_ARGUMENT);
    })
  ),

  PACKAGE(BytesHuman,
    VARIANT(Format,
      OPERATION((char *buffer, size_t capacity, size_t *outWritten,
                 uint64_t bytes), {
        return MODULE_FUNC(Text, BytesHuman, FormatEx)(
            buffer, capacity, outWritten, bytes,
            CNS(Text, Format, BYTE_UNIT_IEC),
            CNS(Text, Format, BYTES_DEFAULT_PRECISION));
      }),

      OPERATION(Ex,
                (char *buffer, size_t capacity, size_t *outWritten,
                 uint64_t bytes, unsigned unitStandard, unsigned precision), {
        if (buffer == NULL || capacity == 0U) {
          return STATUS_CONST(INVALID_ARGUMENT);
        }
        if (unitStandard != CNS(Text, Format, BYTE_UNIT_IEC) &&
            unitStandard != CNS(Text, Format, BYTE_UNIT_SI)) {
          return STATUS_CONST(INVALID_ARGUMENT);
        }

        static const char *const iecUnits[CNS(Text, Format, Internal, UNIT_COUNT)] = {
            "B", "KiB", "MiB", "GiB", "TiB", "PiB", "EiB"
        };
        static const char *const siUnits[CNS(Text, Format, Internal, UNIT_COUNT)] = {
            "B", "KB", "MB", "GB", "TB", "PB", "EB"
        };

        const bool isIec = (unitStandard == CNS(Text, Format, BYTE_UNIT_IEC));
        const char *const *units = isIec ? iecUnits : siUnits;
        const double base =
            isIec ? (double)CNS(Text, Format, BYTES_IEC_BASE)
                  : (double)CNS(Text, Format, BYTES_SI_BASE);

        if (precision > CNS(Text, Format, BYTES_MAX_PRECISION)) {
          precision = CNS(Text, Format, BYTES_MAX_PRECISION);
        }

        int written = 0;
        if (bytes < (uint64_t)base) {
          written = snprintf(buffer, capacity, "%" PRIu64 " %s", bytes, units[0]);
        } else {
          double value = (double)bytes;
          size_t unitIndex = 0U;
          while (value >= base &&
                 unitIndex + 1U < (size_t)CNS(Text, Format, Internal, UNIT_COUNT)) {
            value /= base;
            unitIndex++;
          }
          written = snprintf(buffer, capacity, "%.*f %s", (int)precision, value,
                             units[unitIndex]);
        }

        if (written < 0 || (size_t)written >= capacity) {
          buffer[capacity - 1U] = '\0';
          return STATUS_CONST(INSUFFICIENT_SPACE);
        }

        if (outWritten != NULL) {
          *outWritten = (size_t)written;
        }
        return STATUS_CONST(SUCCESS);
      })
    ),

    OPERATION(Parse, (const char *str, uint64_t *outBytes), {
      if (str == NULL || outBytes == NULL) {
        return STATUS_CONST(INVALID_ARGUMENT);
      }

      const char *p = str;
      while (*p != '\0' && isspace((unsigned char)*p)) {
        p++;
      }

      if (*p == '\0' || !isdigit((unsigned char)*p)) {
        return STATUS_CONST(INVALID_ARGUMENT);
      }

      const uint64_t decBase =
          (uint64_t)CNS(Text, Format, Internal, DECIMAL_BASE);
      uint64_t intPart = 0U;
      while (*p != '\0' && isdigit((unsigned char)*p)) {
        const uint64_t digit = (uint64_t)(*p - '0');
        if (intPart > (UINT64_MAX - digit) / decBase) {
          return STATUS_CONST(ARITHMETIC_OVERFLOW);
        }
        intPart = intPart * decBase + digit;
        p++;
      }

      uint64_t fracPart = 0U;
      uint64_t fracScale = 1U;
      if (*p == '.' || *p == ',') {
        p++;
        size_t fracDigits = 0U;
        while (*p != '\0' && isdigit((unsigned char)*p)) {
          if (fracDigits < (size_t)CNS(Text, Format, Internal, MAX_FRAC_DIGITS)) {
            const uint64_t digit = (uint64_t)(*p - '0');
            fracPart = fracPart * decBase + digit;
            fracScale *= decBase;
            fracDigits++;
          }
          p++;
        }
      }

      while (*p != '\0' && isspace((unsigned char)*p)) {
        p++;
      }

      char unitBuf[8];
      size_t unitLen = 0U;
      while (*p != '\0' && isalpha((unsigned char)*p)) {
        if (unitLen + 1U < sizeof(unitBuf)) {
          unitBuf[unitLen++] = (char)tolower((unsigned char)*p);
        } else {
          return STATUS_CONST(INVALID_ARGUMENT);
        }
        p++;
      }
      unitBuf[unitLen] = '\0';

      while (*p != '\0' && isspace((unsigned char)*p)) {
        p++;
      }
      if (*p != '\0') {
        return STATUS_CONST(INVALID_ARGUMENT);
      }

      uint64_t multiplier = 1ULL;
      const OPSTATUS unitStatus = MODULE_IFUNC(
          Text, BytesHuman, ResolveUnitMultiplier)(unitBuf, unitLen, &multiplier);
      if (unitStatus != STATUS_CONST(SUCCESS)) {
        return unitStatus;
      }

      if (multiplier > 0ULL && intPart > UINT64_MAX / multiplier) {
        return STATUS_CONST(ARITHMETIC_OVERFLOW);
      }
      uint64_t total = intPart * multiplier;

      if (fracScale > 1ULL) {
        const uint64_t fracBytes = (fracPart * multiplier) / fracScale;
        if (total > UINT64_MAX - fracBytes) {
          return STATUS_CONST(ARITHMETIC_OVERFLOW);
        }
        total += fracBytes;
      }

      *outBytes = total;
      return STATUS_CONST(SUCCESS);
    })
  )
);

/* EOF */
