#pragma once

#include <ctype.h>
#include <string.h>

#define TEXT_BYTES_HUMAN_INTERNAL_COL_NAME(NAME, VALUE) NAME
#define TEXT_BYTES_HUMAN_INTERNAL_COL_VALUE(NAME, VALUE) VALUE
#define TEXT_BYTES_HUMAN_INTERNAL_GET(FIELD, ROW)                              \
  PP_OP_CAT2(TEXT_BYTES_HUMAN_INTERNAL_COL_, FIELD) ROW

#define TEXT_BYTES_HUMAN_INTERNAL_TABLE(X)                                     \
  X((DEFAULT_PRECISION, 2U))                                                   \
  X((MAX_PRECISION, 6U))                                                       \
  X((IEC_BASE, 1024U))                                                         \
  X((SI_BASE, 1000U))                                                          \
  X((UNIT_COUNT, 7U))                                                          \
  X((MAX_FRAC_DIGITS, 9U))                                                     \
  X((DECIMAL_BASE, 10U))

IENUM_DEF(MODULE_NS(Text, BytesHuman), Config, TEXT_BYTES_HUMAN_INTERNAL_TABLE)

MODULE_IMPLEMENT(DOMAIN(Modules), Text,
  INTERNAL_EX(BytesHuman,
    OPERATION(ResolveUnitMultiplier,
              (const char *unitBuf, size_t unitLen, uint64_t *outMultiplier), {
      if (unitLen == 0U || strcmp(unitBuf, "b") == 0) {
        *outMultiplier = 1ULL;
        return STATUS_CONST(SUCCESS);
      }

      static const char *const
          iecNames[MODULE_IFUNC(Text, BytesHuman, UNIT_COUNT)] = {
              "b", "kib", "mib", "gib", "tib", "pib", "eib"};
      static const char *const
          siNames[MODULE_IFUNC(Text, BytesHuman, UNIT_COUNT)] = {
              "b", "kb", "mb", "gb", "tb", "pb", "eb"};
      static const char
          shortLetters[MODULE_IFUNC(Text, BytesHuman, UNIT_COUNT)] = {
              'b', 'k', 'm', 'g', 't', 'p', 'e'};

      uint64_t iecMul = 1ULL;
      uint64_t siMul = 1ULL;
      const uint64_t iecBase =
          (uint64_t)MODULE_IFUNC(Text, BytesHuman, IEC_BASE);
      const uint64_t siBase =
          (uint64_t)MODULE_IFUNC(Text, BytesHuman, SI_BASE);

      for (size_t i = 1U;
           i < (size_t)MODULE_IFUNC(Text, BytesHuman, UNIT_COUNT); ++i) {
        iecMul *= iecBase;
        siMul *= siBase;
        if ((unitLen == 1U && unitBuf[0] == shortLetters[i]) ||
            strcmp(unitBuf, iecNames[i]) == 0) {
          *outMultiplier = iecMul;
          return STATUS_CONST(SUCCESS);
        }
        if (strcmp(unitBuf, siNames[i]) == 0) {
          *outMultiplier = siMul;
          return STATUS_CONST(SUCCESS);
        }
      }

      return STATUS_CONST(INVALID_ARGUMENT);
    })
  ),

  PACKAGE(BytesHuman,
    VARIANT(Write,
      OPERATION((MODULE_TYPE(Text, Writer) *writer, uint64_t bytes), {
        return MODULE_FUNC(Text, BytesHuman, WriteEx)(
            writer, bytes, MODULE_NS(Text, BytesHuman, Unit, IEC),
            MODULE_IFUNC(Text, BytesHuman, DEFAULT_PRECISION));
      }),

      OPERATION(Ex,
                (MODULE_TYPE(Text, Writer) *writer, uint64_t bytes,
                 MODULE_ENUM(Text, BytesHuman, Unit) unitStandard,
                 unsigned precision), {
        if (writer == NULL) {
          return STATUS_CONST(INVALID_ARGUMENT);
        }
        if (unitStandard != MODULE_NS(Text, BytesHuman, Unit, IEC) &&
            unitStandard != MODULE_NS(Text, BytesHuman, Unit, SI)) {
          return STATUS_CONST(INVALID_ARGUMENT);
        }

        static const char *const
            iecUnits[MODULE_IFUNC(Text, BytesHuman, UNIT_COUNT)] = {
                "B", "KiB", "MiB", "GiB", "TiB", "PiB", "EiB"};
        static const char *const
            siUnits[MODULE_IFUNC(Text, BytesHuman, UNIT_COUNT)] = {
                "B", "KB", "MB", "GB", "TB", "PB", "EB"};

        const bool isIec =
            (unitStandard == MODULE_NS(Text, BytesHuman, Unit, IEC));
        const char *const *units = isIec ? iecUnits : siUnits;
        const uint64_t intBase =
            isIec ? (uint64_t)MODULE_IFUNC(Text, BytesHuman, IEC_BASE)
                  : (uint64_t)MODULE_IFUNC(Text, BytesHuman, SI_BASE);
        const double base = (double)intBase;

        if (precision > MODULE_IFUNC(Text, BytesHuman, MAX_PRECISION)) {
          precision = MODULE_IFUNC(Text, BytesHuman, MAX_PRECISION);
        }

        OPSTATUS status = STATUS_CONST(SUCCESS);
        size_t unitIndex = 0U;

        if (bytes < intBase) {
          status = MODULE_FUNC(Text, Writer, WriteUInt)(
              writer, bytes, MODULE_IFUNC(Text, BytesHuman, DECIMAL_BASE),
              false);
        } else {
          double value = (double)bytes;
          while (value >= base &&
                 unitIndex + 1U <
                     (size_t)MODULE_IFUNC(Text, BytesHuman, UNIT_COUNT)) {
            value /= base;
            unitIndex++;
          }
          status = MODULE_FUNC(Text, Writer, WriteFloat)(
              writer, value, 'f', true, (size_t)precision);
        }

        if (status != STATUS_CONST(SUCCESS)) {
          return status;
        }
        status = MODULE_FUNC(Text, Writer, WriteChar)(writer, ' ');
        if (status != STATUS_CONST(SUCCESS)) {
          return status;
        }
        return MODULE_FUNC(Text, Writer, WriteCStr)(writer, units[unitIndex]);
      })
    ),

    VARIANT(Format,
      OPERATION((char *buffer, size_t capacity, size_t *outWritten,
                 uint64_t bytes), {
        return MODULE_FUNC(Text, BytesHuman, FormatEx)(
            buffer, capacity, outWritten, bytes,
            MODULE_NS(Text, BytesHuman, Unit, IEC),
            MODULE_IFUNC(Text, BytesHuman, DEFAULT_PRECISION));
      }),

      OPERATION(Ex,
                (char *buffer, size_t capacity, size_t *outWritten,
                 uint64_t bytes,
                 MODULE_ENUM(Text, BytesHuman, Unit) unitStandard,
                 unsigned precision), {
        if (buffer == NULL || capacity == 0U) {
          return STATUS_CONST(INVALID_ARGUMENT);
        }

        MODULE_TYPE(Text, Writer) writer =
            MODULE_FUNC(Text, Writer, ToBuffer)(buffer, capacity);
        OPSTATUS status = MODULE_FUNC(Text, BytesHuman, WriteEx)(
            &writer, bytes, unitStandard, precision);
        if (status == STATUS_CONST(SUCCESS)) {
          status = MODULE_FUNC(Text, Writer, Finish)(&writer);
        }
        if (outWritten != NULL &&
            (status == STATUS_CONST(SUCCESS) ||
             status == STATUS_CONST(INSUFFICIENT_SPACE))) {
          *outWritten = MODULE_FUNC(Text, Writer, Written)(&writer);
        }
        return status;
      })
    ),

    OPERATION(Parse, (const char *str, uint64_t *outBytes), {
      if (str == NULL || outBytes == NULL) {
        return STATUS_CONST(INVALID_ARGUMENT);
      }

      const char *p = str;
      while (*p != '\0' && isspace((unsigned char)*p)) {
        p++;
      }

      if (*p == '\0' || !isdigit((unsigned char)*p)) {
        return STATUS_CONST(INVALID_ARGUMENT);
      }

      const uint64_t decBase =
          (uint64_t)MODULE_IFUNC(Text, BytesHuman, DECIMAL_BASE);
      uint64_t intPart = 0U;
      while (*p != '\0' && isdigit((unsigned char)*p)) {
        const uint64_t digit = (uint64_t)(*p - '0');
        if (intPart > (UINT64_MAX - digit) / decBase) {
          return STATUS_CONST(ARITHMETIC_OVERFLOW);
        }
        intPart = intPart * decBase + digit;
        p++;
      }

      uint64_t fracPart = 0U;
      uint64_t fracScale = 1U;
      if (*p == '.' || *p == ',') {
        p++;
        if (!isdigit((unsigned char)*p)) {
          return STATUS_CONST(INVALID_ARGUMENT);
        }
        size_t fracDigits = 0U;
        while (*p != '\0' && isdigit((unsigned char)*p)) {
          if (fracDigits <
              (size_t)MODULE_IFUNC(Text, BytesHuman, MAX_FRAC_DIGITS)) {
            const uint64_t digit = (uint64_t)(*p - '0');
            fracPart = fracPart * decBase + digit;
            fracScale *= decBase;
            fracDigits++;
          }
          p++;
        }
      }

      while (*p != '\0' && isspace((unsigned char)*p)) {
        p++;
      }

      char unitBuf[8];
      size_t unitLen = 0U;
      while (*p != '\0' && isalpha((unsigned char)*p)) {
        if (unitLen + 1U < sizeof(unitBuf)) {
          unitBuf[unitLen++] = (char)tolower((unsigned char)*p);
        } else {
          return STATUS_CONST(INVALID_ARGUMENT);
        }
        p++;
      }
      unitBuf[unitLen] = '\0';

      while (*p != '\0' && isspace((unsigned char)*p)) {
        p++;
      }
      if (*p != '\0') {
        return STATUS_CONST(INVALID_ARGUMENT);
      }

      uint64_t multiplier = 1ULL;
      const OPSTATUS unitStatus = MODULE_IFUNC(
          Text, BytesHuman, ResolveUnitMultiplier)(unitBuf, unitLen, &multiplier);
      if (unitStatus != STATUS_CONST(SUCCESS)) {
        return unitStatus;
      }

      if (multiplier > 0ULL && intPart > UINT64_MAX / multiplier) {
        return STATUS_CONST(ARITHMETIC_OVERFLOW);
      }
      uint64_t total = intPart * multiplier;

      if (fracScale > 1ULL) {
        const uint64_t q = multiplier / fracScale;
        const uint64_t r = multiplier % fracScale;
        const uint64_t fracBytes = fracPart * q + (fracPart * r) / fracScale;
        if (total > UINT64_MAX - fracBytes) {
          return STATUS_CONST(ARITHMETIC_OVERFLOW);
        }
        total += fracBytes;
      }

      *outBytes = total;
      return STATUS_CONST(SUCCESS);
    })
  )
);

/* EOF */
