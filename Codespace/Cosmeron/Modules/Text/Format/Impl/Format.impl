#pragma once

#include <limits.h>
#include <stdio.h>
#include <string.h>
#include <wchar.h>

#define TEXT_FORMAT_CONFIG_COL_NAME(NAME, VALUE) NAME
#define TEXT_FORMAT_CONFIG_COL_VALUE(NAME, VALUE) VALUE
#define TEXT_FORMAT_CONFIG_GET(FIELD, ROW)                                     \
  PP_OP_CAT2(TEXT_FORMAT_CONFIG_COL_, FIELD) ROW

#define TEXT_FORMAT_CONFIG_TABLE(X)                                            \
  X((BASE_BINARY, 2U))                                                         \
  X((BASE_OCTAL, 8U))                                                          \
  X((BASE_DECIMAL, 10U))                                                       \
  X((BASE_HEXADECIMAL, 16U))                                                   \
  X((INT_BUFFER_SIZE, 128U))                                                   \
  X((FLOAT_SPEC_SIZE, 32U))                                                    \
  X((FLOAT_BUFFER_SIZE, 1024U))                                                \
  X((UTF8_MAX_BYTES, 4U))

IENUM_DEF(MODULE_NS(Text, Format), Config, TEXT_FORMAT_CONFIG_TABLE)

#define TEXT_FORMAT_LEN_MOD_COL_NAME(NAME) NAME
#define TEXT_FORMAT_LEN_MOD_GET(FIELD, ROW)                                    \
  PP_OP_CAT2(TEXT_FORMAT_LEN_MOD_COL_, FIELD) ROW

#define TEXT_FORMAT_LEN_MOD_TABLE(X)                                           \
  X((LEN_NONE))                                                                \
  X((LEN_HH))                                                                  \
  X((LEN_H))                                                                   \
  X((LEN_L))                                                                   \
  X((LEN_LL))                                                                  \
  X((LEN_J))                                                                   \
  X((LEN_Z))                                                                   \
  X((LEN_T))                                                                   \
  X((LEN_CAPITAL_L))                                                           \
  X((LEN_W8))                                                                  \
  X((LEN_W16))                                                                 \
  X((LEN_W32))                                                                 \
  X((LEN_W64))

IENUM_DEF_EX(MODULE_NS(Text, Format), LengthMod, TEXT_FORMAT_LEN_MOD_TABLE,
             NAME_ONLY)

MODULE_IMPLEMENT(DOMAIN(Modules), Text,
  INTERNAL_EX(Format,
    PREDICATE(IsDigit, (char c), {
      return c >= '0' && c <= '9';
    }),

    FUNCTION(size_t, BoundedLength, (const char *str, size_t maxLen), {
      if (str == NULL) {
        return 0U;
      }
      size_t len = 0U;
      while (len < maxLen && str[len] != '\0') {
        ++len;
      }
      return len;
    }),

    OPERATION(WriteAligned,
              (MODULE_TYPE(Text, Writer) *writer, const char *data,
               size_t length, bool flagMinus, char padChar, size_t width), {
      const size_t pad = (width > length) ? (width - length) : 0U;
      OPSTATUS status = STATUS_CONST(SUCCESS);
      if (!flagMinus && pad > 0U) {
        status = MODULE_FUNC(Text, Writer, WriteRepeat)(writer, padChar, pad);
        if (status != STATUS_CONST(SUCCESS)) {
          return status;
        }
      }
      if (length > 0U) {
        status = MODULE_FUNC(Text, Writer, WriteBuffer)(writer, data, length);
        if (status != STATUS_CONST(SUCCESS)) {
          return status;
        }
      }
      if (flagMinus && pad > 0U) {
        status = MODULE_FUNC(Text, Writer, WriteRepeat)(writer, padChar, pad);
        if (status != STATUS_CONST(SUCCESS)) {
          return status;
        }
      }
      return STATUS_CONST(SUCCESS);
    }),

    PROCEDURE(EmitRadixPrefix,
              (unsigned base, bool uppercase, bool hasNonZeroOrPrecZeroOctal,
               char *prefix, size_t *prefixLen), {
      if (base == MODULE_IFUNC(Text, Format, BASE_HEXADECIMAL)) {
        prefix[(*prefixLen)++] = '0';
        prefix[(*prefixLen)++] = uppercase ? 'X' : 'x';
      } else if (base == MODULE_IFUNC(Text, Format, BASE_BINARY)) {
        prefix[(*prefixLen)++] = '0';
        prefix[(*prefixLen)++] = uppercase ? 'B' : 'b';
      } else if (base == MODULE_IFUNC(Text, Format, BASE_OCTAL)) {
        if (hasNonZeroOrPrecZeroOctal) {
          prefix[(*prefixLen)++] = '0';
        }
      }
    }),

    OPERATION(FormatInteger,
              (MODULE_TYPE(Text, Writer) *writer, uintmax_t value,
               bool isSigned, bool isNegative, unsigned base, bool uppercase,
               bool flagMinus, bool flagPlus, bool flagSpace, bool flagHash,
               bool flagZero, size_t width, bool hasPrecision,
               size_t precision), {
      char digits[MODULE_IFUNC(Text, Format, INT_BUFFER_SIZE)];
      size_t digitsCount = 0U;
      const char *digitsMap = uppercase
                                  ? "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ"
                                  : "0123456789abcdefghijklmnopqrstuvwxyz";

      if (value == 0U && hasPrecision && precision == 0U) {
        digitsCount = 0U;
      } else if (value == 0U) {
        digits[digitsCount++] = '0';
      } else {
        uintmax_t temp = value;
        while (temp > 0U && digitsCount < sizeof(digits)) {
          digits[digitsCount++] = digitsMap[temp % (uintmax_t)base];
          temp /= (uintmax_t)base;
        }
      }

      char prefix[4];
      size_t prefixLen = 0U;

      if (isSigned) {
        if (isNegative) {
          prefix[prefixLen++] = '-';
        } else if (flagPlus) {
          prefix[prefixLen++] = '+';
        } else if (flagSpace) {
          prefix[prefixLen++] = ' ';
        }
      } else if (flagHash) {
        if (base == MODULE_IFUNC(Text, Format, BASE_OCTAL)) {
          const bool needZero =
              (digitsCount == 0U) || (digits[digitsCount - 1U] != '0');
          if (needZero && !(hasPrecision && precision > digitsCount)) {
            MODULE_IFUNC(Text, Format, EmitRadixPrefix)(
                base, uppercase, true, prefix, &prefixLen);
          }
        } else if (value != 0U) {
          MODULE_IFUNC(Text, Format, EmitRadixPrefix)(
              base, uppercase, false, prefix, &prefixLen);
        }
      }

      size_t zeroPad = 0U;
      if (hasPrecision) {
        if (precision > digitsCount) {
          zeroPad = precision - digitsCount;
        }
      } else if (flagZero && !flagMinus && width > (prefixLen + digitsCount)) {
        zeroPad = width - (prefixLen + digitsCount);
      }

      const size_t totalLen = prefixLen + zeroPad + digitsCount;
      const size_t spacePad = (width > totalLen) ? (width - totalLen) : 0U;

      OPSTATUS status = STATUS_CONST(SUCCESS);
      if (!flagMinus && spacePad > 0U) {
        status = MODULE_FUNC(Text, Writer, WriteRepeat)(writer, ' ', spacePad);
        if (status != STATUS_CONST(SUCCESS)) {
          return status;
        }
      }

      if (prefixLen > 0U) {
        status = MODULE_FUNC(Text, Writer, WriteBuffer)(
            writer, prefix, prefixLen);
        if (status != STATUS_CONST(SUCCESS)) {
          return status;
        }
      }

      if (zeroPad > 0U) {
        status = MODULE_FUNC(Text, Writer, WriteRepeat)(writer, '0', zeroPad);
        if (status != STATUS_CONST(SUCCESS)) {
          return status;
        }
      }

      if (digitsCount > 0U) {
        char ordered[MODULE_IFUNC(Text, Format, INT_BUFFER_SIZE)];
        for (size_t i = 0U; i < digitsCount; ++i) {
          ordered[i] = digits[digitsCount - 1U - i];
        }
        status = MODULE_FUNC(Text, Writer, WriteBuffer)(
            writer, ordered, digitsCount);
        if (status != STATUS_CONST(SUCCESS)) {
          return status;
        }
      }

      if (flagMinus && spacePad > 0U) {
        status = MODULE_FUNC(Text, Writer, WriteRepeat)(writer, ' ', spacePad);
        if (status != STATUS_CONST(SUCCESS)) {
          return status;
        }
      }

      return STATUS_CONST(SUCCESS);
    }),

    OPERATION(FormatFloat,
              (MODULE_TYPE(Text, Writer) *writer, double value,
               bool isLongDouble, long double ldValue, char specifier,
               bool flagMinus, bool flagPlus, bool flagSpace, bool flagHash,
               bool flagZero, size_t width, bool hasPrecision,
               size_t precision), {
      char formatSpec[MODULE_IFUNC(Text, Format, FLOAT_SPEC_SIZE)];
      size_t fmtLen = 0U;
      formatSpec[fmtLen++] = '%';
      if (flagPlus) {
        formatSpec[fmtLen++] = '+';
      } else if (flagSpace) {
        formatSpec[fmtLen++] = ' ';
      }
      if (flagHash) {
        formatSpec[fmtLen++] = '#';
      }
      if (hasPrecision) {
        formatSpec[fmtLen++] = '.';
        formatSpec[fmtLen++] = '*';
      }
      if (isLongDouble) {
        formatSpec[fmtLen++] = 'L';
      }
      formatSpec[fmtLen++] = specifier;
      formatSpec[fmtLen] = '\0';

      char tempBuf[MODULE_IFUNC(Text, Format, FLOAT_BUFFER_SIZE)];
      int formattedLen = 0;
      const int prec =
          (hasPrecision && precision > (size_t)INT_MAX) ? INT_MAX : (int)precision;
      if (isLongDouble) {
        formattedLen =
            hasPrecision
                ? snprintf(tempBuf, sizeof(tempBuf), formatSpec, prec, ldValue)
                : snprintf(tempBuf, sizeof(tempBuf), formatSpec, ldValue);
      } else {
        formattedLen =
            hasPrecision
                ? snprintf(tempBuf, sizeof(tempBuf), formatSpec, prec, value)
                : snprintf(tempBuf, sizeof(tempBuf), formatSpec, value);
      }

      if (formattedLen < 0) {
        return STATUS_CONST(INVALID_ARGUMENT);
      }
      if ((size_t)formattedLen >= sizeof(tempBuf)) {
        return STATUS_CONST(INSUFFICIENT_SPACE);
      }

      const size_t len = (size_t)formattedLen;
      size_t prefixLen = 0U;
      if (len > 0U &&
          (tempBuf[0] == '-' || tempBuf[0] == '+' || tempBuf[0] == ' ')) {
        prefixLen = 1U;
      }

      const bool isNonFinite =
          (len > prefixLen) &&
          (tempBuf[prefixLen] == 'i' || tempBuf[prefixLen] == 'I' ||
           tempBuf[prefixLen] == 'n' || tempBuf[prefixLen] == 'N');

      if ((specifier == 'a' || specifier == 'A') && !isNonFinite &&
          len >= prefixLen + 2U && tempBuf[prefixLen] == '0' &&
          (tempBuf[prefixLen + 1U] == 'x' || tempBuf[prefixLen + 1U] == 'X')) {
        prefixLen += 2U;
      }

      const size_t pad = (width > len) ? (width - len) : 0U;
      OPSTATUS status = STATUS_CONST(SUCCESS);

      if (flagZero && !flagMinus && !isNonFinite) {
        if (prefixLen > 0U) {
          status = MODULE_FUNC(Text, Writer, WriteBuffer)(
              writer, tempBuf, prefixLen);
          if (status != STATUS_CONST(SUCCESS)) {
            return status;
          }
        }
        if (pad > 0U) {
          status = MODULE_FUNC(Text, Writer, WriteRepeat)(writer, '0', pad);
          if (status != STATUS_CONST(SUCCESS)) {
            return status;
          }
        }
        return MODULE_FUNC(Text, Writer, WriteBuffer)(
            writer, tempBuf + prefixLen, len - prefixLen);
      }

      return MODULE_IFUNC(Text, Format, WriteAligned)(
          writer, tempBuf, len, flagMinus, ' ', width);
    }),

    OPERATION(FormatString,
              (MODULE_TYPE(Text, Writer) *writer, const char *str,
               bool flagMinus, size_t width, bool hasPrecision,
               size_t precision), {
      if (str == NULL) {
        const char *nullText = "(null)";
        size_t len = 6U;
        if (hasPrecision) {
          len = (precision < len) ? 0U : len;
        }
        return MODULE_IFUNC(Text, Format, WriteAligned)(
            writer, nullText, len, flagMinus, ' ', width);
      }
      const size_t len =
          hasPrecision
              ? MODULE_IFUNC(Text, Format, BoundedLength)(str, precision)
              : strlen(str);
      return MODULE_IFUNC(Text, Format, WriteAligned)(
          writer, str, len, flagMinus, ' ', width);
    }),

    OPERATION(FormatWideString,
              (MODULE_TYPE(Text, Writer) *writer, const wchar_t *wstr,
               bool flagMinus, size_t width, bool hasPrecision,
               size_t precision), {
      if (wstr == NULL) {
        return MODULE_IFUNC(Text, Format, FormatString)(
            writer, NULL, flagMinus, width, hasPrecision, precision);
      }

      size_t totalBytes = 0U;
      size_t count = 0U;
      while (wstr[count] != L'\0') {
        size_t units = 0U;
        const OPSTATUS status = MODULE_FUNC(Text, UTF8, EncodedLength)(
            (MODULE_TYPE(Text, Char32))wstr[count], &units);
        if (status != STATUS_CONST(SUCCESS)) {
          return status;
        }
        if (hasPrecision && totalBytes + units > precision) {
          break;
        }
        totalBytes += units;
        ++count;
      }

      const size_t pad = (width > totalBytes) ? (width - totalBytes) : 0U;
      if (!flagMinus && pad > 0U) {
        const OPSTATUS padStatus =
            MODULE_FUNC(Text, Writer, WriteRepeat)(writer, ' ', pad);
        if (padStatus != STATUS_CONST(SUCCESS)) {
          return padStatus;
        }
      }

      for (size_t i = 0U; i < count; ++i) {
        unsigned char u8[MODULE_IFUNC(Text, Format, UTF8_MAX_BYTES)];
        size_t units = 0U;
        OPSTATUS status = MODULE_FUNC(Text, UTF8, Encode)(
            (MODULE_TYPE(Text, Char32))wstr[i], u8, sizeof(u8), &units);
        if (status != STATUS_CONST(SUCCESS)) {
          return status;
        }
        status = MODULE_FUNC(Text, Writer, WriteBuffer)(
            writer, (const char *)u8, units);
        if (status != STATUS_CONST(SUCCESS)) {
          return status;
        }
      }

      if (flagMinus && pad > 0U) {
        const OPSTATUS padStatus =
            MODULE_FUNC(Text, Writer, WriteRepeat)(writer, ' ', pad);
        if (padStatus != STATUS_CONST(SUCCESS)) {
          return padStatus;
        }
      }

      return STATUS_CONST(SUCCESS);
    })
  ),

  PACKAGE(Format,
    VARIANT(To,
      OPERATION((MODULE_TYPE(Text, Writer) *writer, const char *format, ...), {
        if (writer == NULL || format == NULL) {
          return STATUS_CONST(INVALID_ARGUMENT);
        }
        va_list args;
        va_start(args, format);
        const OPSTATUS status = MODULE_FUNC(Text, Format, ToVariadic)(
            writer, format, args);
        va_end(args);
        return status;
      }),

      OPERATION(Variadic,
                (MODULE_TYPE(Text, Writer) *writer, const char *format,
                 va_list arguments), {
        if (writer == NULL || format == NULL) {
          return STATUS_CONST(INVALID_ARGUMENT);
        }

        const char *p = format;
        const char *literalStart = p;

        while (*p != '\0') {
          if (*p != '%') {
            p++;
            continue;
          }

          if (p > literalStart) {
            const OPSTATUS litStatus = MODULE_FUNC(Text, Writer, WriteBuffer)(
                writer, literalStart, (size_t)(p - literalStart));
            if (litStatus != STATUS_CONST(SUCCESS)) {
              return litStatus;
            }
          }

          p++;
          if (*p == '\0') {
            return STATUS_CONST(INVALID_ARGUMENT);
          }

          if (*p == '%') {
            const OPSTATUS pctStatus =
                MODULE_FUNC(Text, Writer, WriteChar)(writer, '%');
            if (pctStatus != STATUS_CONST(SUCCESS)) {
              return pctStatus;
            }
            p++;
            literalStart = p;
            continue;
          }

          /* Flags */
          bool flagMinus = false;
          bool flagPlus = false;
          bool flagSpace = false;
          bool flagHash = false;
          bool flagZero = false;

          while (*p == '-' || *p == '+' || *p == ' ' || *p == '#' ||
                 *p == '0') {
            if (*p == '-') {
              flagMinus = true;
            } else if (*p == '+') {
              flagPlus = true;
            } else if (*p == ' ') {
              flagSpace = true;
            } else if (*p == '#') {
              flagHash = true;
            } else if (*p == '0') {
              flagZero = true;
            }
            p++;
          }

          /* Field width */
          size_t width = 0U;
          if (*p == '*') {
            p++;
            const int w = va_arg(arguments, int);
            if (w < 0) {
              flagMinus = true;
              width = (size_t)(-(w + 1)) + 1U;
            } else {
              width = (size_t)w;
            }
          } else {
            while (MODULE_IFUNC(Text, Format, IsDigit)(*p)) {
              const size_t digit = (size_t)(*p - '0');
              if (width > (SIZE_MAX - digit) /
                              MODULE_IFUNC(Text, Format, BASE_DECIMAL)) {
                return STATUS_CONST(ARITHMETIC_OVERFLOW);
              }
              width = width * MODULE_IFUNC(Text, Format, BASE_DECIMAL) + digit;
              p++;
            }
          }

          /* Precision */
          bool hasPrecision = false;
          size_t precision = 0U;
          if (*p == '.') {
            p++;
            hasPrecision = true;
            if (*p == '*') {
              p++;
              const int prec = va_arg(arguments, int);
              if (prec >= 0) {
                precision = (size_t)prec;
              } else {
                hasPrecision = false;
              }
            } else {
              while (MODULE_IFUNC(Text, Format, IsDigit)(*p)) {
                const size_t digit = (size_t)(*p - '0');
                if (precision > (SIZE_MAX - digit) /
                                    MODULE_IFUNC(Text, Format, BASE_DECIMAL)) {
                  return STATUS_CONST(ARITHMETIC_OVERFLOW);
                }
                precision =
                    precision * MODULE_IFUNC(Text, Format, BASE_DECIMAL) +
                    digit;
                p++;
              }
            }
          }

          /* Optional parenthesized sub-specifier %(...) for %! */
          const char *subFormat = NULL;
          size_t subFormatLen = 0U;
          if (*p == '(') {
            p++;
            subFormat = p;
            while (*p != '\0' && *p != ')') {
              p++;
            }
            if (*p != ')') {
              return STATUS_CONST(INVALID_ARGUMENT);
            }
            subFormatLen = (size_t)(p - subFormat);
            p++;
          }

          /* Length modifiers */
          MODULE_IENUM(Text, Format, LengthMod) lenMod =
              MODULE_IFUNC(Text, Format, LEN_NONE);
          if (*p == 'h') {
            p++;
            if (*p == 'h') {
              p++;
              lenMod = MODULE_IFUNC(Text, Format, LEN_HH);
            } else {
              lenMod = MODULE_IFUNC(Text, Format, LEN_H);
            }
          } else if (*p == 'l') {
            p++;
            if (*p == 'l') {
              p++;
              lenMod = MODULE_IFUNC(Text, Format, LEN_LL);
            } else {
              lenMod = MODULE_IFUNC(Text, Format, LEN_L);
            }
          } else if (*p == 'j') {
            p++;
            lenMod = MODULE_IFUNC(Text, Format, LEN_J);
          } else if (*p == 'z') {
            p++;
            lenMod = MODULE_IFUNC(Text, Format, LEN_Z);
          } else if (*p == 't' &&
                     (p[1] == 'd' || p[1] == 'i' || p[1] == 'u' ||
                      p[1] == 'o' || p[1] == 'x' || p[1] == 'X' ||
                      p[1] == 'b' || p[1] == 'B')) {
            p++;
            lenMod = MODULE_IFUNC(Text, Format, LEN_T);
          } else if (*p == 'L') {
            p++;
            lenMod = MODULE_IFUNC(Text, Format, LEN_CAPITAL_L);
          } else if (*p == 'w') {
            p++;
            if (*p == 'f') {
              p++;
            }
            if (strncmp(p, "64", 2) == 0) {
              p += 2;
              lenMod = MODULE_IFUNC(Text, Format, LEN_W64);
            } else if (strncmp(p, "32", 2) == 0) {
              p += 2;
              lenMod = MODULE_IFUNC(Text, Format, LEN_W32);
            } else if (strncmp(p, "16", 2) == 0) {
              p += 2;
              lenMod = MODULE_IFUNC(Text, Format, LEN_W16);
            } else if (*p == '8') {
              p += 1;
              lenMod = MODULE_IFUNC(Text, Format, LEN_W8);
            } else {
              return STATUS_CONST(INVALID_ARGUMENT);
            }
          }

          if (*p == '\0') {
            return STATUS_CONST(INVALID_ARGUMENT);
          }

          const char spec = *p++;
          if (subFormat != NULL && spec != '!') {
            return STATUS_CONST(INVALID_ARGUMENT);
          }

          OPSTATUS status = STATUS_CONST(SUCCESS);

          switch (spec) {
          case 'd':
          case 'i': {
            intmax_t sval = 0;
            if (lenMod == MODULE_IFUNC(Text, Format, LEN_LL)) {
              sval = (intmax_t)va_arg(arguments, long long);
            } else if (lenMod == MODULE_IFUNC(Text, Format, LEN_L)) {
              sval = (intmax_t)va_arg(arguments, long);
            } else if (lenMod == MODULE_IFUNC(Text, Format, LEN_J)) {
              sval = va_arg(arguments, intmax_t);
            } else if (lenMod == MODULE_IFUNC(Text, Format, LEN_Z) ||
                       lenMod == MODULE_IFUNC(Text, Format, LEN_T)) {
              sval = (intmax_t)va_arg(arguments, ptrdiff_t);
            } else if (lenMod == MODULE_IFUNC(Text, Format, LEN_H)) {
              sval = (intmax_t)(short)va_arg(arguments, int);
            } else if (lenMod == MODULE_IFUNC(Text, Format, LEN_HH)) {
              sval = (intmax_t)(signed char)va_arg(arguments, int);
            } else if (lenMod == MODULE_IFUNC(Text, Format, LEN_W8)) {
              sval = (intmax_t)(int8_t)va_arg(arguments, int);
            } else if (lenMod == MODULE_IFUNC(Text, Format, LEN_W16)) {
              sval = (intmax_t)(int16_t)va_arg(arguments, int);
            } else if (lenMod == MODULE_IFUNC(Text, Format, LEN_W32)) {
              sval = (intmax_t)va_arg(arguments, int32_t);
            } else if (lenMod == MODULE_IFUNC(Text, Format, LEN_W64)) {
              sval = (intmax_t)va_arg(arguments, int64_t);
            } else {
              sval = (intmax_t)va_arg(arguments, int);
            }
            const bool isNeg = (sval < 0);
            const uintmax_t uval =
                isNeg ? (uintmax_t)(-(sval + 1)) + 1U : (uintmax_t)sval;
            status = MODULE_IFUNC(Text, Format, FormatInteger)(
                writer, uval, true, isNeg,
                MODULE_IFUNC(Text, Format, BASE_DECIMAL), false, flagMinus,
                flagPlus, flagSpace, false, flagZero, width, hasPrecision,
                precision);
            break;
          }

          case 'u':
          case 'o':
          case 'x':
          case 'X':
          case 'b':
          case 'B': {
            uintmax_t uval = 0U;
            if (lenMod == MODULE_IFUNC(Text, Format, LEN_LL)) {
              uval = (uintmax_t)va_arg(arguments, unsigned long long);
            } else if (lenMod == MODULE_IFUNC(Text, Format, LEN_L)) {
              uval = (uintmax_t)va_arg(arguments, unsigned long);
            } else if (lenMod == MODULE_IFUNC(Text, Format, LEN_J)) {
              uval = va_arg(arguments, uintmax_t);
            } else if (lenMod == MODULE_IFUNC(Text, Format, LEN_Z) ||
                       lenMod == MODULE_IFUNC(Text, Format, LEN_T)) {
              uval = (uintmax_t)va_arg(arguments, size_t);
            } else if (lenMod == MODULE_IFUNC(Text, Format, LEN_H)) {
              uval = (uintmax_t)(unsigned short)va_arg(arguments, unsigned int);
            } else if (lenMod == MODULE_IFUNC(Text, Format, LEN_HH)) {
              uval = (uintmax_t)(unsigned char)va_arg(arguments, unsigned int);
            } else if (lenMod == MODULE_IFUNC(Text, Format, LEN_W8)) {
              uval = (uintmax_t)(uint8_t)va_arg(arguments, unsigned int);
            } else if (lenMod == MODULE_IFUNC(Text, Format, LEN_W16)) {
              uval = (uintmax_t)(uint16_t)va_arg(arguments, unsigned int);
            } else if (lenMod == MODULE_IFUNC(Text, Format, LEN_W32)) {
              uval = (uintmax_t)va_arg(arguments, uint32_t);
            } else if (lenMod == MODULE_IFUNC(Text, Format, LEN_W64)) {
              uval = (uintmax_t)va_arg(arguments, uint64_t);
            } else {
              uval = (uintmax_t)va_arg(arguments, unsigned int);
            }

            unsigned base = MODULE_IFUNC(Text, Format, BASE_DECIMAL);
            bool uppercase = false;
            if (spec == 'o') {
              base = MODULE_IFUNC(Text, Format, BASE_OCTAL);
            } else if (spec == 'x') {
              base = MODULE_IFUNC(Text, Format, BASE_HEXADECIMAL);
            } else if (spec == 'X') {
              base = MODULE_IFUNC(Text, Format, BASE_HEXADECIMAL);
              uppercase = true;
            } else if (spec == 'b') {
              base = MODULE_IFUNC(Text, Format, BASE_BINARY);
            } else if (spec == 'B') {
              base = MODULE_IFUNC(Text, Format, BASE_BINARY);
              uppercase = true;
            }

            status = MODULE_IFUNC(Text, Format, FormatInteger)(
                writer, uval, false, false, base, uppercase, flagMinus, false,
                false, flagHash, flagZero, width, hasPrecision, precision);
            break;
          }

          case 'c': {
            if (lenMod == MODULE_IFUNC(Text, Format, LEN_L)) {
              const wint_t wc = va_arg(arguments, wint_t);
              unsigned char utf8Buf[MODULE_IFUNC(Text, Format, UTF8_MAX_BYTES)];
              size_t utf8Units = 0U;
              status = MODULE_FUNC(Text, UTF8, Encode)(
                  (MODULE_TYPE(Text, Char32))wc, utf8Buf, sizeof(utf8Buf),
                  &utf8Units);
              if (status == STATUS_CONST(SUCCESS)) {
                status = MODULE_IFUNC(Text, Format, WriteAligned)(
                    writer, (const char *)utf8Buf, utf8Units, flagMinus, ' ',
                    width);
              }
            } else {
              const char ch = (char)va_arg(arguments, int);
              status = MODULE_IFUNC(Text, Format, WriteAligned)(
                  writer, &ch, 1U, flagMinus, ' ', width);
            }
            break;
          }

          case 's': {
            if (lenMod == MODULE_IFUNC(Text, Format, LEN_L)) {
              const wchar_t *wstr = va_arg(arguments, const wchar_t *);
              status = MODULE_IFUNC(Text, Format, FormatWideString)(
                  writer, wstr, flagMinus, width, hasPrecision, precision);
            } else {
              const char *str = va_arg(arguments, const char *);
              status = MODULE_IFUNC(Text, Format, FormatString)(
                  writer, str, flagMinus, width, hasPrecision, precision);
            }
            break;
          }

          case 'p': {
            const void *ptr = va_arg(arguments, const void *);
            if (ptr == NULL) {
              status = MODULE_IFUNC(Text, Format, WriteAligned)(
                  writer, "(nil)", 5U, flagMinus, ' ', width);
            } else {
              status = MODULE_IFUNC(Text, Format, FormatInteger)(
                  writer, (uintptr_t)ptr, false, false,
                  MODULE_IFUNC(Text, Format, BASE_HEXADECIMAL), false,
                  flagMinus, false, false, true, false, width, false, 0U);
            }
            break;
          }

          case 'f':
          case 'F':
          case 'e':
          case 'E':
          case 'g':
          case 'G':
          case 'a':
          case 'A': {
            if (lenMod == MODULE_IFUNC(Text, Format, LEN_CAPITAL_L)) {
              const long double ld = va_arg(arguments, long double);
              status = MODULE_IFUNC(Text, Format, FormatFloat)(
                  writer, 0.0, true, ld, spec, flagMinus, flagPlus, flagSpace,
                  flagHash, flagZero, width, hasPrecision, precision);
            } else {
              const double d = va_arg(arguments, double);
              status = MODULE_IFUNC(Text, Format, FormatFloat)(
                  writer, d, false, 0.0L, spec, flagMinus, flagPlus, flagSpace,
                  flagHash, flagZero, width, hasPrecision, precision);
            }
            break;
          }

          case 'v': {
            const MODULE_TYPE(Text, View8) view =
                va_arg(arguments, MODULE_TYPE(Text, View8));
            if (view.data == NULL && view.size > 0U) {
              status = STATUS_CONST(INVALID_ARGUMENT);
            } else {
              size_t len = view.size;
              if (hasPrecision && precision < len) {
                len = precision;
              }
              status = MODULE_IFUNC(Text, Format, WriteAligned)(
                  writer, view.data != NULL ? view.data : "", len, flagMinus,
                  ' ', width);
            }
            break;
          }

          case 'U': {
            const MODULE_TYPE(Text, Char32) cp =
                va_arg(arguments, MODULE_TYPE(Text, Char32));
            unsigned char utf8Buf[MODULE_IFUNC(Text, Format, UTF8_MAX_BYTES)];
            size_t utf8Units = 0U;
            status = MODULE_FUNC(Text, UTF8, Encode)(
                cp, utf8Buf, sizeof(utf8Buf), &utf8Units);
            if (status == STATUS_CONST(SUCCESS)) {
              status = MODULE_IFUNC(Text, Format, WriteAligned)(
                  writer, (const char *)utf8Buf, utf8Units, flagMinus, ' ',
                  width);
            }
            break;
          }

          case 't': {
            const bool val = (va_arg(arguments, int) != 0);
            status = MODULE_IFUNC(Text, Format, WriteAligned)(
                writer, val ? "true" : "false", val ? 4U : 5U, flagMinus, ' ',
                width);
            break;
          }

          case 'q': {
            const char *str = va_arg(arguments, const char *);
            if (str == NULL) {
              status = MODULE_IFUNC(Text, Format, WriteAligned)(
                  writer, "(null)", 6U, flagMinus, ' ', width);
            } else {
              const size_t rawLen =
                  hasPrecision
                      ? MODULE_IFUNC(Text, Format, BoundedLength)(str,
                                                                  precision)
                      : strlen(str);
              const bool quote = !flagHash;
              if (width == 0U) {
                status = MODULE_FUNC(Text, Writer, WriteEscaped)(
                    writer, str, rawLen, quote);
              } else {
                MODULE_TYPE(Text, Writer) counter =
                    MODULE_FUNC(Text, Writer, Counter)();
                status = MODULE_FUNC(Text, Writer, WriteEscaped)(
                    &counter, str, rawLen, quote);
                if (status == STATUS_CONST(SUCCESS)) {
                  const size_t renderedLen =
                      MODULE_FUNC(Text, Writer, Written)(&counter);
                  const size_t pad =
                      (width > renderedLen) ? (width - renderedLen) : 0U;
                  if (!flagMinus && pad > 0U) {
                    status = MODULE_FUNC(Text, Writer, WriteRepeat)(
                        writer, ' ', pad);
                  }
                  if (status == STATUS_CONST(SUCCESS)) {
                    status = MODULE_FUNC(Text, Writer, WriteEscaped)(
                        writer, str, rawLen, quote);
                  }
                  if (status == STATUS_CONST(SUCCESS) && flagMinus &&
                      pad > 0U) {
                    status = MODULE_FUNC(Text, Writer, WriteRepeat)(
                        writer, ' ', pad);
                  }
                }
              }
            }
            break;
          }

          case '!': {
            const MODULE_CALLABLE(Text, Format, Adapter) adapter =
                va_arg(arguments, MODULE_CALLABLE(Text, Format, Adapter));
            const void *value = va_arg(arguments, const void *);
            if (!CALLABLE_IS_VALID(adapter)) {
              status = STATUS_CONST(INVALID_ARGUMENT);
            } else {
              const MODULE_TYPE(Text, View8) specView =
                  (subFormat != NULL)
                      ? MODULE_FUNC(Text, View8, Create)(subFormat,
                                                         subFormatLen)
                      : MODULE_FUNC(Text, View8, Empty)();
              if (width == 0U) {
                status = CALLABLE_CALL(adapter, writer, value, specView);
              } else {
                MODULE_TYPE(Text, Writer) counter =
                    MODULE_FUNC(Text, Writer, Counter)();
                status = CALLABLE_CALL(adapter, &counter, value, specView);
                if (status == STATUS_CONST(SUCCESS)) {
                  const size_t renderedLen =
                      MODULE_FUNC(Text, Writer, Written)(&counter);
                  const size_t pad =
                      (width > renderedLen) ? (width - renderedLen) : 0U;
                  if (!flagMinus && pad > 0U) {
                    status = MODULE_FUNC(Text, Writer, WriteRepeat)(
                        writer, ' ', pad);
                  }
                  if (status == STATUS_CONST(SUCCESS)) {
                    status = CALLABLE_CALL(adapter, writer, value, specView);
                  }
                  if (status == STATUS_CONST(SUCCESS) && flagMinus &&
                      pad > 0U) {
                    status = MODULE_FUNC(Text, Writer, WriteRepeat)(
                        writer, ' ', pad);
                  }
                }
              }
            }
            break;
          }

          default:
            status = STATUS_CONST(INVALID_ARGUMENT);
            break;
          }

          if (status != STATUS_CONST(SUCCESS)) {
            return status;
          }
          literalStart = p;
        }

        if (p > literalStart) {
          return MODULE_FUNC(Text, Writer, WriteBuffer)(
              writer, literalStart, (size_t)(p - literalStart));
        }
        return STATUS_CONST(SUCCESS);
      })
    ),

    VARIANT(Buffer,
      OPERATION((char *buffer, size_t capacity, size_t *outWritten,
                 const char *format, ...), {
        if (format == NULL || (buffer == NULL && capacity > 0U)) {
          return STATUS_CONST(INVALID_ARGUMENT);
        }
        va_list args;
        va_start(args, format);
        const OPSTATUS status = MODULE_FUNC(Text, Format, BufferVariadic)(
            buffer, capacity, outWritten, format, args);
        va_end(args);
        return status;
      }),

      OPERATION(Variadic,
                (char *buffer, size_t capacity, size_t *outWritten,
                 const char *format, va_list arguments), {
        if (format == NULL || (buffer == NULL && capacity > 0U)) {
          return STATUS_CONST(INVALID_ARGUMENT);
        }

        MODULE_TYPE(Text, Writer) writer =
            (buffer == NULL && capacity == 0U)
                ? MODULE_FUNC(Text, Writer, Counter)()
                : MODULE_FUNC(Text, Writer, ToBuffer)(buffer, capacity);

        OPSTATUS status = MODULE_FUNC(Text, Format, ToVariadic)(
            &writer, format, arguments);
        if (status == STATUS_CONST(SUCCESS)) {
          status = MODULE_FUNC(Text, Writer, Finish)(&writer);
        }

        if (outWritten != NULL &&
            (status == STATUS_CONST(SUCCESS) ||
             status == STATUS_CONST(INSUFFICIENT_SPACE))) {
          *outWritten = MODULE_FUNC(Text, Writer, Written)(&writer);
        }

        return status;
      })
    )
  )
);

/* EOF */
