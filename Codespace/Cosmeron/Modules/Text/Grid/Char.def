/* Char.def - Dual Mode Engine (Zero Duplication) */

#include "../../../Core/Condition/Status.h"
#include "../../../Core/Memory/Alloc.h"
#include "../../../Core/Module/Module.h"
#define COSMERON_INTERNAL_NO_AUTO_INSTANTIATE 1
#include "../../Tuple/Dual.h"
#include "../../Tuple/Quad.h"
#undef COSMERON_INTERNAL_NO_AUTO_INSTANTIATE
#include "../Impl/Common.inc"
#include "Impl/Char.impl"

#ifndef TEMPLATE_Text_Char
#define TEMPLATE_Text_Char(SUFFIX, TYPE)                                       \
  TEMPLATE_OBJECT(Text, Char, SUFFIX,                                          \
      FIELDS(                                                                  \
          TYPE *data;                                                          \
          MODULE_TYPED(Tuple, Dual, UInt16) size;                              \
      ),                                                                       \
                                                                               \
      CONST_PREDICATE_INLINE(IsEmpty, (), {                                    \
        return self == NULL || self->data == NULL;                             \
      }),                                                                      \
                                                                               \
      CONST_PREDICATE_INLINE(IsValid, (), {                                    \
        return self != NULL &&                                                 \
               MODULE_IFUNC(Text, Char, Valid)(self->data, self->size);        \
      }),                                                                      \
                                                                               \
      OPERATION_INLINE(Create, (MODULE_TYPED(Tuple, Dual, UInt16) size), {   \
        if (self == NULL) {                                                    \
          return STATUS_CONST(INVALID_ARGUMENT);                               \
        }                                                                      \
        return MODULE_IFUNC(Text, Char, CreateRaw)(                            \
            (void **)&self->data, &self->size, size, sizeof(TYPE));            \
      }),                                                                      \
                                                                               \
      OPERATION_INLINE(Destroy, (), {                                          \
        if (self == NULL) {                                                    \
          return STATUS_CONST(INVALID_ARGUMENT);                               \
        }                                                                      \
        Memory_Free(self->data);                                               \
        self->size.col = 0U;                                                   \
        self->size.row = 0U;                                                   \
        return STATUS_CONST(SUCCESS);                                          \
      }),                                                                      \
                                                                               \
      OPERATION_INLINE(Resize, (MODULE_TYPED(Tuple, Dual, UInt16) size), {   \
        if (self == NULL ||                                                    \
            !MODULE_IFUNC(Text, Char, Valid)(self->data, self->size) ||        \
            !MODULE_IFUNC(Text, Char, SizeValid)(size)) {                      \
          return STATUS_CONST(INVALID_ARGUMENT);                               \
        }                                                                      \
        if (size.col == self->size.col && size.row == self->size.row) {        \
          return STATUS_CONST(SUCCESS);                                        \
        }                                                                      \
        if (size.col == 0U) {                                                  \
          return MODULE_FUNC(Text, Char, SUFFIX, Destroy)(self);               \
        }                                                                      \
        MODULE_TYPED(Text, Char, SUFFIX) temporary = {0};                      \
        const OPSTATUS status =                                                \
            MODULE_FUNC(Text, Char, SUFFIX, Create)(&temporary, size);         \
        if (status != STATUS_CONST(SUCCESS)) {                                 \
          return status;                                                       \
        }                                                                      \
        if (self->data != NULL) {                                              \
          const uint16_t copyColumns =                                         \
              self->size.col < size.col ? self->size.col : size.col;           \
          const uint16_t copyRows =                                            \
              self->size.row < size.row ? self->size.row : size.row;           \
          for (uint16_t row = 0U; row < copyRows; ++row) {                     \
            memcpy(temporary.data + (size_t)row * size.col,                    \
                   self->data + (size_t)row * self->size.col,                  \
                   (size_t)copyColumns * sizeof(TYPE));                        \
          }                                                                    \
        }                                                                      \
        Memory_Free(self->data);                                               \
        *self = temporary;                                                     \
        return STATUS_CONST(SUCCESS);                                          \
      }),                                                                      \
                                                                               \
      OPERATION_INLINE(Recreate, (MODULE_TYPED(Tuple, Dual, UInt16) size), { \
        if (self == NULL || !MODULE_IFUNC(Text, Char, SizeValid)(size)) {      \
          return STATUS_CONST(INVALID_ARGUMENT);                               \
        }                                                                      \
        const OPSTATUS status =                                                \
            MODULE_FUNC(Text, Char, SUFFIX, Destroy)(self);                    \
        if (status != STATUS_CONST(SUCCESS)) {                                 \
          return status;                                                       \
        }                                                                      \
        return MODULE_FUNC(Text, Char, SUFFIX, Create)(self, size);            \
      }),                                                                      \
                                                                               \
      OPERATION_INLINE(Clone,                                                  \
                       (const MODULE_TYPED(Text, Char, SUFFIX) *source), {     \
        if (self == NULL || source == NULL || self == source ||                \
            !MODULE_IFUNC(Text, Char, Valid)(source->data, source->size)) {    \
          return STATUS_CONST(INVALID_ARGUMENT);                               \
        }                                                                      \
        const OPSTATUS status =                                                \
            MODULE_FUNC(Text, Char, SUFFIX, Recreate)(self, source->size);     \
        if (status != STATUS_CONST(SUCCESS)) {                                 \
          return status;                                                       \
        }                                                                      \
        if (source->data != NULL) {                                            \
          const size_t count = (size_t)source->size.col * source->size.row;    \
          memcpy(self->data, source->data, count * sizeof(TYPE));              \
        }                                                                      \
        return STATUS_CONST(SUCCESS);                                          \
      }),                                                                      \
                                                                               \
      OPERATION_INLINE(Clear, (), {                                            \
        if (self == NULL ||                                                    \
            !MODULE_IFUNC(Text, Char, Valid)(self->data, self->size)) {        \
          return STATUS_CONST(INVALID_ARGUMENT);                               \
        }                                                                      \
        if (self->data != NULL) {                                              \
          const size_t count = (size_t)self->size.col * self->size.row;        \
          memset(self->data, 0, count * sizeof(TYPE));                         \
        }                                                                      \
        return STATUS_CONST(SUCCESS);                                          \
      }),                                                                      \
                                                                               \
      OPERATION_INLINE(ReadCell,                                               \
                       (MODULE_TYPED(Tuple, Dual, UInt16) position,            \
                        TYPE *character), {                                    \
        if (self == NULL || character == NULL ||                               \
            !MODULE_IFUNC(Text, Char, Valid)(self->data, self->size)) {        \
          return STATUS_CONST(INVALID_ARGUMENT);                               \
        }                                                                      \
        if (position.col >= self->size.col || position.row >= self->size.row) {\
          return STATUS_CONST(OUT_OF_RANGE);                                   \
        }                                                                      \
        *character =                                                           \
            self->data[(size_t)position.row * self->size.col + position.col];  \
        return STATUS_CONST(SUCCESS);                                          \
      }),                                                                      \
                                                                               \
      OPERATION_INLINE(WriteCell,                                              \
                       (MODULE_TYPED(Tuple, Dual, UInt16) position,            \
                        TYPE character), {                                     \
        if (self == NULL ||                                                    \
            !MODULE_IFUNC(Text, Char, Valid)(self->data, self->size)) {        \
          return STATUS_CONST(INVALID_ARGUMENT);                               \
        }                                                                      \
        if (position.col >= self->size.col || position.row >= self->size.row) {\
          return STATUS_CONST(OUT_OF_RANGE);                                   \
        }                                                                      \
        self->data[(size_t)position.row * self->size.col + position.col] =     \
            character;                                                         \
        return STATUS_CONST(SUCCESS);                                          \
      }),                                                                      \
                                                                               \
      OPERATION_INLINE(Fill, (TYPE character), {                               \
        if (self == NULL ||                                                    \
            !MODULE_IFUNC(Text, Char, Valid)(self->data, self->size)) {        \
          return STATUS_CONST(INVALID_ARGUMENT);                               \
        }                                                                      \
        if (self->data != NULL) {                                              \
          const size_t count = (size_t)self->size.col * self->size.row;        \
          for (size_t i = 0U; i < count; ++i) {                                \
            self->data[i] = character;                                         \
          }                                                                    \
        }                                                                      \
        return STATUS_CONST(SUCCESS);                                          \
      }),                                                                      \
                                                                               \
      OPERATION_INLINE(FillRegion,                                             \
                       (MODULE_TYPED(Tuple, Quad, UInt16) region,              \
                        TYPE character), {                                     \
        if (self == NULL ||                                                    \
            !MODULE_IFUNC(Text, Char, Valid)(self->data, self->size)) {        \
          return STATUS_CONST(INVALID_ARGUMENT);                               \
        }                                                                      \
        if (!MODULE_IFUNC(Text, Char, RegionValid)(self->size, region)) {      \
          return STATUS_CONST(OUT_OF_RANGE);                                   \
        }                                                                      \
        for (uint16_t row = region.top; row <= region.bottom; ++row) {         \
          TYPE *rowPtr = self->data + (size_t)row * self->size.col;            \
          for (uint16_t col = region.left; col <= region.right; ++col) {       \
            rowPtr[col] = character;                                           \
          }                                                                    \
        }                                                                      \
        return STATUS_CONST(SUCCESS);                                          \
      }),                                                                      \
                                                                               \
      OPERATION_INLINE(Read,                                                   \
                       (MODULE_TYPED(Tuple, Quad, UInt16) region,              \
                        MODULE_TYPED(Text, Char, SUFFIX) *destination), {      \
        if (self == NULL || destination == NULL || self == destination ||      \
            !MODULE_IFUNC(Text, Char, Valid)(self->data, self->size)) {        \
          return STATUS_CONST(INVALID_ARGUMENT);                               \
        }                                                                      \
        if (!MODULE_IFUNC(Text, Char, RegionValid)(self->size, region)) {      \
          return STATUS_CONST(OUT_OF_RANGE);                                   \
        }                                                                      \
        MODULE_TYPED(Tuple, Dual, UInt16) regionSize;                          \
        regionSize.col = (uint16_t)(region.right - region.left + 1U);          \
        regionSize.row = (uint16_t)(region.bottom - region.top + 1U);          \
        const OPSTATUS status =                                                \
            MODULE_FUNC(Text, Char, SUFFIX, Recreate)(destination, regionSize);\
        if (status != STATUS_CONST(SUCCESS)) {                                 \
          return status;                                                       \
        }                                                                      \
        for (uint16_t row = 0U; row < regionSize.row; ++row) {                 \
          memcpy(destination->data + (size_t)row * regionSize.col,             \
                 self->data + (size_t)(region.top + row) * self->size.col +    \
                     region.left,                                              \
                 (size_t)regionSize.col * sizeof(TYPE));                       \
        }                                                                      \
        return STATUS_CONST(SUCCESS);                                          \
      }),                                                                      \
                                                                               \
      VARIANT(Write,                                                           \
          OPERATION_INLINE(Region,                                             \
              (MODULE_TYPED(Tuple, Dual, UInt16) destinationPosition,          \
               const MODULE_TYPED(Text, Char, SUFFIX) *source,                 \
               MODULE_TYPED(Tuple, Quad, UInt16) sourceRegion), {              \
            if (self == NULL || source == NULL || self == source ||            \
                !MODULE_IFUNC(Text, Char, Valid)(self->data, self->size) ||    \
                !MODULE_IFUNC(Text, Char, Valid)(source->data, source->size)) {\
              return STATUS_CONST(INVALID_ARGUMENT);                           \
            }                                                                  \
            if (!MODULE_IFUNC(Text, Char, RegionValid)(source->size,           \
                                                       sourceRegion)) {        \
              return STATUS_CONST(OUT_OF_RANGE);                               \
            }                                                                  \
            const uint16_t copyWidth =                                         \
                (uint16_t)(sourceRegion.right - sourceRegion.left + 1U);       \
            const uint16_t copyHeight =                                        \
                (uint16_t)(sourceRegion.bottom - sourceRegion.top + 1U);       \
            if (destinationPosition.col + copyWidth > self->size.col ||        \
                destinationPosition.row + copyHeight > self->size.row) {       \
              return STATUS_CONST(OUT_OF_RANGE);                               \
            }                                                                  \
            for (uint16_t row = 0U; row < copyHeight; ++row) {                 \
              memcpy(self->data +                                              \
                         (size_t)(destinationPosition.row + row) *             \
                             self->size.col +                                  \
                         destinationPosition.col,                              \
                     source->data +                                            \
                         (size_t)(sourceRegion.top + row) * source->size.col + \
                         sourceRegion.left,                                    \
                     (size_t)copyWidth * sizeof(TYPE));                        \
            }                                                                  \
            return STATUS_CONST(SUCCESS);                                      \
          }),                                                                  \
          OPERATION_INLINE(,                                                   \
              (MODULE_TYPED(Tuple, Dual, UInt16) destinationPosition,          \
               const MODULE_TYPED(Text, Char, SUFFIX) *source), {              \
            if (self == NULL || source == NULL || self == source ||            \
                !MODULE_IFUNC(Text, Char, Valid)(self->data, self->size) ||    \
                !MODULE_IFUNC(Text, Char, Valid)(source->data, source->size)) {\
              return STATUS_CONST(INVALID_ARGUMENT);                           \
            }                                                                  \
            if (source->size.col == 0U) {                                      \
              return STATUS_CONST(SUCCESS);                                    \
            }                                                                  \
            MODULE_TYPED(Tuple, Quad, UInt16) sourceRegion;                    \
            sourceRegion.left = 0U;                                            \
            sourceRegion.top = 0U;                                             \
            sourceRegion.right = (uint16_t)(source->size.col - 1U);            \
            sourceRegion.bottom = (uint16_t)(source->size.row - 1U);           \
            return MODULE_FUNC(Text, Char, SUFFIX, WriteRegion)(               \
                self, destinationPosition, source, sourceRegion);              \
          })                                                                   \
      )                                                                        \
  )
#endif

#if (!defined(COSMERON_INTERNAL_NO_AUTO_INSTANTIATE) && !defined(COSMERON_INTERNAL_IN_COMMON_INC)) && defined(SUFFIX) && defined(TYPE)
  TEMPLATE_Text_Char(SUFFIX, TYPE);
  #undef SUFFIX
  #undef TYPE
#endif
