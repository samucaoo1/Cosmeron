#pragma once

#include <string.h>

ITABLE_ARRAY_DEF(MODULE_NS(Text, Attribute, Color), uint32_t,
                 WindowsPaletteData, TEXT_ATTRIBUTE_WINDOWS_COLOR_TABLE, 2)

MODULE_IMPLEMENT(DOMAIN(Modules), Text,
  INTERNAL_EX(Attribute,
    FUNCTION(size_t, GridAttributeCount,
             (MODULE_TYPED(Tuple, Dual, UInt16) size), {
      return (size_t)size.col * (size_t)size.row;
    }),

    PREDICATE(GridAttributeSizeValid,
              (MODULE_TYPED(Tuple, Dual, UInt16) size), {
      return (size.col == 0U) == (size.row == 0U);
    }),

    PREDICATE(GridAttributeRegionValid,
              (const MODULE_TYPE(Text, Attribute, Grid) *grid,
               MODULE_TYPED(Tuple, Quad, UInt16) region), {
      return MODULE_FUNC(Text, Attribute, IsValid)(grid) &&
             region.left <= region.right && region.top <= region.bottom &&
             region.right < grid->size.col && region.bottom < grid->size.row;
    })
  ),

  PACKAGE(Attribute,
    SPACE(Color,
      FUNCTION(uint32_t, RGB, (uint8_t red, uint8_t green, uint8_t blue), {
        return (((uint32_t)red &
                 MODULE_IFUNC(Text, Attribute, Color, CHANNEL_MASK))
                << MODULE_IFUNC(Text, Attribute, Color, RED_SHIFT)) |
               (((uint32_t)green &
                 MODULE_IFUNC(Text, Attribute, Color, CHANNEL_MASK))
                << MODULE_IFUNC(Text, Attribute, Color, GREEN_SHIFT)) |
               ((uint32_t)blue &
                MODULE_IFUNC(Text, Attribute, Color, CHANNEL_MASK));
      }),

      FUNCTION(uint8_t, Red, (uint32_t color), {
        return (uint8_t)((color >>
                          MODULE_IFUNC(Text, Attribute, Color, RED_SHIFT)) &
                         MODULE_IFUNC(Text, Attribute, Color, CHANNEL_MASK));
      }),

      FUNCTION(uint8_t, Green, (uint32_t color), {
        return (uint8_t)((color >>
                          MODULE_IFUNC(Text, Attribute, Color, GREEN_SHIFT)) &
                         MODULE_IFUNC(Text, Attribute, Color, CHANNEL_MASK));
      }),

      FUNCTION(uint8_t, Blue, (uint32_t color), {
        return (uint8_t)(color &
                         MODULE_IFUNC(Text, Attribute, Color, CHANNEL_MASK));
      }),

      FUNCTION(const uint32_t *, WindowsPalette, (), {
        return MODULE_IFUNC(Text, Attribute, Color, WindowsPaletteData);
      })
    ),

    FUNCTION(MODULE_TYPE(Text, Attribute, Cell), Default, (), {
      MODULE_TYPE(Text, Attribute, Cell) cell = {0};
      cell.flags = MODULE_NS(Text, Attribute, DEFAULT_FOREGROUND) |
                   MODULE_NS(Text, Attribute, DEFAULT_BACKGROUND);
      cell.underline = MODULE_NS(Text, Attribute, Underline, NONE);
      return cell;
    }),

    PREDICATE(IsEmpty, (const MODULE_TYPE(Text, Attribute, Grid) *grid), {
      return grid != NULL && grid->data == NULL && grid->size.col == 0U &&
             grid->size.row == 0U;
    }),

    PREDICATE(IsValid, (const MODULE_TYPE(Text, Attribute, Grid) *grid), {
      if (grid == NULL ||
          !MODULE_IFUNC(Text, Attribute, GridAttributeSizeValid)(grid->size))
        return false;
      return grid->size.col == 0U ? grid->data == NULL : grid->data != NULL;
    }),

    OPERATION(Create,
              (MODULE_TYPE(Text, Attribute, Grid) *grid,
               MODULE_TYPED(Tuple, Dual, UInt16) size), {
      size_t count;
      OPSTATUS status;
      if (grid == NULL || !MODULE_FUNC(Text, Attribute, IsEmpty)(grid) ||
          !MODULE_IFUNC(Text, Attribute, GridAttributeSizeValid)(size))
        return STATUS_CONST(INVALID_ARGUMENT);
      if (size.col == 0U)
        return STATUS_CONST(SUCCESS);
      count = MODULE_IFUNC(Text, Attribute, GridAttributeCount)(size);
      if (count > SIZE_MAX / sizeof(*grid->data))
        return STATUS_CONST(ARITHMETIC_OVERFLOW);
      {
        void *allocated = NULL;
        status = MODULE_FUNC(Memory, Alloc, Array)(
            &allocated, count, sizeof(MODULE_TYPE(Text, Attribute, Cell)));
        if (status != STATUS_CONST(SUCCESS))
          return status;
        grid->data = (MODULE_TYPE(Text, Attribute, Cell) *)allocated;
      }
      grid->size = size;
      return MODULE_FUNC(Text, Attribute, Clear)(grid);
    }),

    OPERATION(Destroy, (MODULE_TYPE(Text, Attribute, Grid) *grid), {
      if (grid == NULL)
        return STATUS_CONST(INVALID_ARGUMENT);
      Memory_Free(grid->data);
      grid->size = (MODULE_TYPED(Tuple, Dual, UInt16)){0};
      return STATUS_CONST(SUCCESS);
    }),

    VARIANT(Clear,
      OPERATION((MODULE_TYPE(Text, Attribute, Grid) *grid), {
        return MODULE_FUNC(Text, Attribute, ClearWith)(
            grid, MODULE_FUNC(Text, Attribute, Default)());
      }),

      OPERATION(With,
                (MODULE_TYPE(Text, Attribute, Grid) *grid,
                 MODULE_TYPE(Text, Attribute, Cell) attribute), {
        size_t index, count;
        if (!MODULE_FUNC(Text, Attribute, IsValid)(grid))
          return STATUS_CONST(INVALID_ARGUMENT);
        count = MODULE_IFUNC(Text, Attribute, GridAttributeCount)(grid->size);
        for (index = 0U; index < count; ++index)
          grid->data[index] = attribute;
        return STATUS_CONST(SUCCESS);
      })
    ),

    OPERATION(Fill,
              (MODULE_TYPE(Text, Attribute, Grid) *grid,
               MODULE_TYPE(Text, Attribute, Cell) attribute), {
      return MODULE_FUNC(Text, Attribute, ClearWith)(grid, attribute);
    }),

    OPERATION(ReadCell,
              (const MODULE_TYPE(Text, Attribute, Grid) *grid,
               MODULE_TYPED(Tuple, Dual, UInt16) position,
               MODULE_TYPE(Text, Attribute, Cell) *attribute), {
      if (!MODULE_FUNC(Text, Attribute, IsValid)(grid) || attribute == NULL)
        return STATUS_CONST(INVALID_ARGUMENT);
      if (position.col >= grid->size.col || position.row >= grid->size.row)
        return STATUS_CONST(OUT_OF_RANGE);
      *attribute =
          grid->data[(size_t)position.row * grid->size.col + position.col];
      return STATUS_CONST(SUCCESS);
    }),

    OPERATION(WriteCell,
              (MODULE_TYPE(Text, Attribute, Grid) *grid,
               MODULE_TYPED(Tuple, Dual, UInt16) position,
               MODULE_TYPE(Text, Attribute, Cell) attribute), {
      if (!MODULE_FUNC(Text, Attribute, IsValid)(grid))
        return STATUS_CONST(INVALID_ARGUMENT);
      if (position.col >= grid->size.col || position.row >= grid->size.row)
        return STATUS_CONST(OUT_OF_RANGE);
      grid->data[(size_t)position.row * grid->size.col + position.col] =
          attribute;
      return STATUS_CONST(SUCCESS);
    }),

    OPERATION(FillRegion,
              (MODULE_TYPE(Text, Attribute, Grid) *grid,
               MODULE_TYPED(Tuple, Quad, UInt16) region,
               MODULE_TYPE(Text, Attribute, Cell) attribute), {
      uint32_t col, row;
      if (!MODULE_FUNC(Text, Attribute, IsValid)(grid))
        return STATUS_CONST(INVALID_ARGUMENT);
      if (region.left > region.right || region.top > region.bottom)
        return STATUS_CONST(INVALID_ARGUMENT);
      if (!MODULE_IFUNC(Text, Attribute, GridAttributeRegionValid)(grid, region))
        return STATUS_CONST(OUT_OF_RANGE);
      for (row = region.top; row <= region.bottom; ++row)
        for (col = region.left; col <= region.right; ++col)
          grid->data[(size_t)row * grid->size.col + col] = attribute;
      return STATUS_CONST(SUCCESS);
    }),

    OPERATION(Read,
              (const MODULE_TYPE(Text, Attribute, Grid) *source,
               MODULE_TYPED(Tuple, Quad, UInt16) region,
               MODULE_TYPE(Text, Attribute, Grid) *destination), {
      MODULE_TYPE(Text, Attribute, Grid) temporary = {0};
      MODULE_TYPED(Tuple, Dual, UInt16) size;
      uint32_t col, row;
      OPSTATUS status;
      if (!MODULE_FUNC(Text, Attribute, IsValid)(source) ||
          destination == NULL ||
          !MODULE_FUNC(Text, Attribute, IsValid)(destination))
        return STATUS_CONST(INVALID_ARGUMENT);
      if (region.left > region.right || region.top > region.bottom)
        return STATUS_CONST(INVALID_ARGUMENT);
      if (!MODULE_IFUNC(Text, Attribute, GridAttributeRegionValid)(source,
                                                                 region))
        return STATUS_CONST(OUT_OF_RANGE);
      size.col = (uint16_t)(region.right - region.left + 1U);
      size.row = (uint16_t)(region.bottom - region.top + 1U);
      status = MODULE_FUNC(Text, Attribute, Create)(&temporary, size);
      if (status != STATUS_CONST(SUCCESS))
        return status;
      for (row = 0U; row < size.row; ++row)
        for (col = 0U; col < size.col; ++col)
          temporary.data[(size_t)row * size.col + col] =
              source->data[(size_t)(region.top + row) * source->size.col +
                           region.left + col];
      MODULE_FUNC(Text, Attribute, Destroy)(destination);
      *destination = temporary;
      return STATUS_CONST(SUCCESS);
    }),

    VARIANT(Write,
      OPERATION((MODULE_TYPE(Text, Attribute, Grid) *destination,
                 MODULE_TYPED(Tuple, Dual, UInt16) destinationPosition,
                 const MODULE_TYPE(Text, Attribute, Grid) *source), {
        MODULE_TYPED(Tuple, Quad, UInt16) region = {0};
        if (!MODULE_FUNC(Text, Attribute, IsValid)(source))
          return STATUS_CONST(INVALID_ARGUMENT);
        if (MODULE_FUNC(Text, Attribute, IsEmpty)(source))
          return STATUS_CONST(SUCCESS);
        region.right = (uint16_t)(source->size.col - 1U);
        region.bottom = (uint16_t)(source->size.row - 1U);
        return MODULE_FUNC(Text, Attribute, WriteRegion)(
            destination, destinationPosition, source, region);
      }),

      OPERATION(Region,
                (MODULE_TYPE(Text, Attribute, Grid) *destination,
                 MODULE_TYPED(Tuple, Dual, UInt16) destinationPosition,
                 const MODULE_TYPE(Text, Attribute, Grid) *source,
                 MODULE_TYPED(Tuple, Quad, UInt16) sourceRegion), {
        MODULE_TYPE(Text, Attribute, Grid) temporary = {0};
        uint32_t width, height, row;
        OPSTATUS status;
        if (!MODULE_FUNC(Text, Attribute, IsValid)(destination) ||
            !MODULE_FUNC(Text, Attribute, IsValid)(source))
          return STATUS_CONST(INVALID_ARGUMENT);
        if (sourceRegion.left > sourceRegion.right ||
            sourceRegion.top > sourceRegion.bottom)
          return STATUS_CONST(INVALID_ARGUMENT);
        if (!MODULE_IFUNC(Text, Attribute, GridAttributeRegionValid)(
                source, sourceRegion))
          return STATUS_CONST(OUT_OF_RANGE);
        width = (uint32_t)sourceRegion.right - sourceRegion.left + 1U;
        height = (uint32_t)sourceRegion.bottom - sourceRegion.top + 1U;
        if ((uint32_t)destinationPosition.col + width > destination->size.col ||
            (uint32_t)destinationPosition.row + height > destination->size.row)
          return STATUS_CONST(OUT_OF_RANGE);
        status =
            MODULE_FUNC(Text, Attribute, Read)(source, sourceRegion, &temporary);
        if (status != STATUS_CONST(SUCCESS))
          return status;
        for (row = 0U; row < height; ++row)
          memcpy(destination->data +
                     (size_t)(destinationPosition.row + row) *
                         destination->size.col +
                     destinationPosition.col,
                 temporary.data + (size_t)row * width,
                 (size_t)width * sizeof(*temporary.data));
        MODULE_FUNC(Text, Attribute, Destroy)(&temporary);
        return STATUS_CONST(SUCCESS);
      })
    ),

    OPERATION(Resize,
              (MODULE_TYPE(Text, Attribute, Grid) *grid,
               MODULE_TYPED(Tuple, Dual, UInt16) size), {
      MODULE_TYPE(Text, Attribute, Grid) temporary = {0};
      uint32_t width, height, row;
      OPSTATUS status;
      if (!MODULE_FUNC(Text, Attribute, IsValid)(grid) ||
          !MODULE_IFUNC(Text, Attribute, GridAttributeSizeValid)(size))
        return STATUS_CONST(INVALID_ARGUMENT);
      status = MODULE_FUNC(Text, Attribute, Create)(&temporary, size);
      if (status != STATUS_CONST(SUCCESS)) {
        return status;
      }
      width = grid->size.col < size.col ? grid->size.col : size.col;
      height = grid->size.row < size.row ? grid->size.row : size.row;
      for (row = 0U; row < height; ++row)
        memcpy(temporary.data + (size_t)row * size.col,
               grid->data + (size_t)row * grid->size.col,
               (size_t)width * sizeof(*grid->data));
      MODULE_FUNC(Text, Attribute, Destroy)(grid);
      *grid = temporary;
      return STATUS_CONST(SUCCESS);
    }),

    OPERATION(Recreate,
              (MODULE_TYPE(Text, Attribute, Grid) *grid,
               MODULE_TYPED(Tuple, Dual, UInt16) size), {
      MODULE_TYPE(Text, Attribute, Grid) temporary = {0};
      OPSTATUS status;
      if (!MODULE_FUNC(Text, Attribute, IsValid)(grid))
        return STATUS_CONST(INVALID_ARGUMENT);
      status = MODULE_FUNC(Text, Attribute, Create)(&temporary, size);
      if (status != STATUS_CONST(SUCCESS)) {
        return status;
      }
      MODULE_FUNC(Text, Attribute, Destroy)(grid);
      *grid = temporary;
      return STATUS_CONST(SUCCESS);
    }),

    OPERATION(Clone,
              (MODULE_TYPE(Text, Attribute, Grid) *destination,
               const MODULE_TYPE(Text, Attribute, Grid) *source), {
      MODULE_TYPE(Text, Attribute, Grid) temporary = {0};
      OPSTATUS status;
      if (!MODULE_FUNC(Text, Attribute, IsValid)(source) ||
          destination == NULL ||
          !MODULE_FUNC(Text, Attribute, IsValid)(destination))
        return STATUS_CONST(INVALID_ARGUMENT);
      status = MODULE_FUNC(Text, Attribute, Create)(&temporary, source->size);
      if (status != STATUS_CONST(SUCCESS))
        return status;
      if (source->data != NULL)
        memcpy(temporary.data, source->data,
               MODULE_IFUNC(Text, Attribute, GridAttributeCount)(source->size) *
                   sizeof(*source->data));
      MODULE_FUNC(Text, Attribute, Destroy)(destination);
      *destination = temporary;
      return STATUS_CONST(SUCCESS);
    })
  )
);

/* EOF */
