#pragma once

#include "../../../../Core/Memory/Alloc.h"
#include <string.h>

MODULE_IMPLEMENT(DOMAIN(Modules), Text,
  INTERNAL_EX(Char,
    PREDICATE(SizeValid, (MODULE_TYPED(Tuple, Dual, UInt16) size), {
      return (size.col == 0U) == (size.row == 0U);
    }),

    PREDICATE(Valid,
              (const void *data, MODULE_TYPED(Tuple, Dual, UInt16) size), {
      if (!MODULE_IFUNC(Text, Char, SizeValid)(size)) {
        return false;
      }
      return size.col == 0U ? data == NULL : data != NULL;
    }),

    PREDICATE(RegionValid,
              (MODULE_TYPED(Tuple, Dual, UInt16) size,
               MODULE_TYPED(Tuple, Quad, UInt16) region), {
      return region.left <= region.right && region.top <= region.bottom &&
             region.right < size.col && region.bottom < size.row;
    }),

    OPERATION(CreateRaw,
              (void **data, MODULE_TYPED(Tuple, Dual, UInt16) *currentSize,
               MODULE_TYPED(Tuple, Dual, UInt16) size, size_t elementSize), {
      if (data == NULL || currentSize == NULL || *data != NULL ||
          currentSize->col != 0U || currentSize->row != 0U ||
          !MODULE_IFUNC(Text, Char, SizeValid)(size)) {
        return STATUS_CONST(INVALID_ARGUMENT);
      }
      if (size.col == 0U) {
        return STATUS_CONST(SUCCESS);
      }
      const size_t count = (size_t)size.col * size.row;
      void *allocated = NULL;
      const OPSTATUS status =
          MODULE_FUNC(Memory, Alloc, ZeroArray)(&allocated, count, elementSize);
      if (status != STATUS_CONST(SUCCESS)) {
        return status;
      }
      *data = allocated;
      *currentSize = size;
      return STATUS_CONST(SUCCESS);
    })
  )
);

/* EOF */
