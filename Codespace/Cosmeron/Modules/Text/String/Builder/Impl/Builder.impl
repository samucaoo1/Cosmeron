#pragma once

#include <stdio.h>

MODULE_IMPLEMENT(DOMAIN(Modules), Text,
  INTERNAL_EX(Builder,
    FUNCTION(size_t, CStrLen, (const char *str), {
      if (str == NULL) return 0U;
      size_t len = 0U;
      while (str[len] != '\0') ++len;
      return len;
    }),

    OPERATION(EnsureCapacity,
              (MODULE_TYPE(Text, Builder) *self, size_t needed), {
      if (self->capacity >= needed)
        return STATUS_CONST(SUCCESS);

      size_t newCap = self->capacity == 0U
                          ? (size_t)CNS(Text, Builder, Internal, INITIAL_CAPACITY)
                          : self->capacity;
      while (newCap < needed) {
        if (newCap > SIZE_MAX / (size_t)CNS(Text, Builder, Internal, GROWTH_FACTOR)) {
          newCap = needed;
          break;
        }
        newCap *= (size_t)CNS(Text, Builder, Internal, GROWTH_FACTOR);
      }
      return MODULE_FUNC(Text, Builder, Reserve)(self, newCap);
    })
  ),

  OBJECT(Builder,
    OPERATION(Create, (size_t initialCapacity), {
      if (!self)
        return STATUS_CONST(INVALID_ARGUMENT);

      self->buffer = NULL;
      self->size = 0U;
      self->capacity = 0U;

      if (initialCapacity > 0U) {
        return MODULE_FUNC(Text, Builder, Reserve)(self, initialCapacity);
      }
      return STATUS_CONST(SUCCESS);
    }),

    OPERATION(Destroy, (), {
      if (!self)
        return STATUS_CONST(INVALID_ARGUMENT);

      if (self->buffer != NULL) {
        void *buf = self->buffer;
        MODULE_FUNC(Memory, Alloc, Free)(&buf);
        self->buffer = NULL;
      }
      self->size = 0U;
      self->capacity = 0U;
      return STATUS_CONST(SUCCESS);
    }),

    OPERATION(Clear, (), {
      if (!self)
        return STATUS_CONST(INVALID_ARGUMENT);

      self->size = 0U;
      if (self->buffer != NULL) {
        self->buffer[0] = '\0';
      }
      return STATUS_CONST(SUCCESS);
    }),

    OPERATION(Reserve, (size_t newCapacity), {
      if (!self)
        return STATUS_CONST(INVALID_ARGUMENT);

      if (newCapacity <= self->capacity)
        return STATUS_CONST(SUCCESS);

      if (newCapacity > SIZE_MAX - 1U)
        return STATUS_CONST(ARITHMETIC_OVERFLOW);

      size_t allocBytes = newCapacity + 1U;
      void *newBuf = self->buffer;
      OPSTATUS status = MODULE_FUNC(Memory, Alloc, ReallocBytes)(&newBuf, allocBytes);
      if (status != STATUS_CONST(SUCCESS))
        return status;

      self->buffer = (char *)newBuf;
      self->capacity = newCapacity;
      self->buffer[self->size] = '\0';
      return STATUS_CONST(SUCCESS);
    }),

    OPERATION(ShrinkToFit, (), {
      if (!self)
        return STATUS_CONST(INVALID_ARGUMENT);

      if (self->capacity == self->size)
        return STATUS_CONST(SUCCESS);

      if (self->size == 0U) {
        return MODULE_FUNC(Text, Builder, Destroy)(self);
      }

      size_t allocBytes = self->size + 1U;
      void *newBuf = self->buffer;
      OPSTATUS status = MODULE_FUNC(Memory, Alloc, ReallocBytes)(&newBuf, allocBytes);
      if (status != STATUS_CONST(SUCCESS))
        return status;

      self->buffer = (char *)newBuf;
      self->capacity = self->size;
      self->buffer[self->size] = '\0';
      return STATUS_CONST(SUCCESS);
    }),

    VARIANT(Append,
      OPERATION(Char, (char ch), {
        if (!self)
          return STATUS_CONST(INVALID_ARGUMENT);

        if (self->size > SIZE_MAX - 1U)
          return STATUS_CONST(ARITHMETIC_OVERFLOW);

        OPSTATUS status = MODULE_IFUNC(Text, Builder, EnsureCapacity)(
            self, self->size + 1U);
        if (status != STATUS_CONST(SUCCESS))
          return status;

        self->buffer[self->size] = ch;
        self->size++;
        self->buffer[self->size] = '\0';
        return STATUS_CONST(SUCCESS);
      }),

      OPERATION(Buffer, (const char *buffer, size_t length), {
        if (!self)
          return STATUS_CONST(INVALID_ARGUMENT);

        if (buffer == NULL || length == 0U)
          return STATUS_CONST(SUCCESS);

        if (self->size > SIZE_MAX - length)
          return STATUS_CONST(ARITHMETIC_OVERFLOW);

        OPSTATUS status = MODULE_IFUNC(Text, Builder, EnsureCapacity)(
            self, self->size + length);
        if (status != STATUS_CONST(SUCCESS))
          return status;

        memcpy(self->buffer + self->size, buffer, length);
        self->size += length;
        self->buffer[self->size] = '\0';
        return STATUS_CONST(SUCCESS);
      }),

      OPERATION(CStr, (const char *cstr), {
        if (!self)
          return STATUS_CONST(INVALID_ARGUMENT);

        if (cstr == NULL)
          return STATUS_CONST(SUCCESS);

        size_t len = MODULE_IFUNC(Text, Builder, CStrLen)(cstr);
        return MODULE_FUNC(Text, Builder, AppendBuffer)(self, cstr, len);
      }),

      OPERATION(View, (MODULE_TYPE(Text, View, 8) view), {
        if (!self)
          return STATUS_CONST(INVALID_ARGUMENT);

        if (view.data == NULL || view.size == 0U)
          return STATUS_CONST(SUCCESS);

        return MODULE_FUNC(Text, Builder, AppendBuffer)(self, view.data, view.size);
      }),

      OPERATION(Codepoint, (uint32_t codepoint), {
        if (!self)
          return STATUS_CONST(INVALID_ARGUMENT);

        uint8_t utf8Bytes[4];
        size_t outSize = 0U;
        OPSTATUS status = MODULE_FUNC(Text, UTF8, Encode)(
            codepoint, utf8Bytes, sizeof(utf8Bytes), &outSize);
        if (status != STATUS_CONST(SUCCESS))
          return status;

        return MODULE_FUNC(Text, Builder, AppendBuffer)(
            self, (const char *)utf8Bytes, outSize);
      }),

      OPERATION(Format, (const char *format, ...), {
        if (!self || !format)
          return STATUS_CONST(INVALID_ARGUMENT);

        va_list args;
        va_start(args, format);
        OPSTATUS status = MODULE_FUNC(Text, Builder, AppendFormatVariadic)(
            self, format, args);
        va_end(args);
        return status;
      }),

      OPERATION(FormatVariadic, (const char *format, va_list args), {
        if (!self || !format)
          return STATUS_CONST(INVALID_ARGUMENT);

        va_list argsCopy;
        va_copy(argsCopy, args);
        int formattedLen = vsnprintf(NULL, 0U, format, argsCopy);
        va_end(argsCopy);

        if (formattedLen < 0)
          return STATUS_CONST(GENERIC_ERROR);

        size_t len = (size_t)formattedLen;
        if (self->size > SIZE_MAX - len)
          return STATUS_CONST(ARITHMETIC_OVERFLOW);

        OPSTATUS status = MODULE_IFUNC(Text, Builder, EnsureCapacity)(
            self, self->size + len);
        if (status != STATUS_CONST(SUCCESS))
          return status;

        vsnprintf(self->buffer + self->size, len + 1U, format, args);
        self->size += len;
        return STATUS_CONST(SUCCESS);
      })
    ),

    OPERATION(BuildString, (MODULE_TYPE(Text, String, 8) *outString), {
      if (!self || !outString)
        return STATUS_CONST(INVALID_ARGUMENT);

      OPSTATUS status = MODULE_FUNC(Text, String, 8, Init)(outString);
      if (status != STATUS_CONST(SUCCESS))
        return status;

      if (self->size == 0U)
        return STATUS_CONST(SUCCESS);

      return MODULE_FUNC(Text, String, 8, FromBuffer)(
          outString, self->buffer, self->size);
    }),

    CONST_FUNCTION(size_t, Length, (), {
      return self ? self->size : 0U;
    }),

    CONST_FUNCTION(size_t, Capacity, (), {
      return self ? self->capacity : 0U;
    }),

    CONST_PREDICATE(IsEmpty, (), {
      return (!self || self->size == 0U);
    }),

    CONST_FUNCTION(const char *, CStr, (), {
      if (!self || !self->buffer)
        return "";
      return self->buffer;
    }),

    CONST_FUNCTION(MODULE_TYPED(Text, View, 8), View, (), {
      if (!self || !self->buffer)
        return MODULE_FUNC(Text, View, 8, Empty)();
      return MODULE_FUNC(Text, View, 8, Create)(self->buffer, self->size);
    })
  )
);

/* EOF */
