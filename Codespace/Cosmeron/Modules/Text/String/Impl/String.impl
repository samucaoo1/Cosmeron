#pragma once

MODULE_IMPLEMENT(DOMAIN(Modules), Text,
  INTERNAL_EX(String8,
    OPERATION(WriterSink,
              (const char *data, size_t length, void *context), {
      MODULE_TYPE(Text, String8) *str = (MODULE_TYPE(Text, String8) *)context;
      return MODULE_FUNC(Text, String8, AppendBuffer)(str, data, length);
    })
  ),

  PACKAGE(Writer,
    FUNCTION(MODULE_TYPE(Text, Writer), ToString,
             (MODULE_TYPE(Text, String8) *str), {
      if (str == NULL) {
        return MODULE_FUNC(Text, Writer, ToClosure)(
            NS_JOIN(MODULE_CLOSURE_FUNC(Text, WriterSink), Empty)());
      }
      return MODULE_FUNC(Text, Writer, ToClosure)(
          NS_JOIN(MODULE_CLOSURE_FUNC(Text, WriterSink), Bind)(
              MODULE_IFUNC(Text, String8, WriterSink), str));
    })
  ),

  PACKAGE(String8,
    OPERATION(AppendCodepoint,
              (MODULE_TYPE(Text, String8) *str,
               MODULE_TYPE(Text, Char32) codepoint), {
      if (str == NULL) return STATUS_CONST(INVALID_ARGUMENT);
      unsigned char encoded[MODULE_IFUNC(Text, String, UTF8_MAX_BYTES)];
      size_t units = 0U;
      OPSTATUS status = MODULE_FUNC(Text, UTF8, Encode)(
          codepoint, encoded, sizeof(encoded), &units);
      if (status != STATUS_CONST(SUCCESS)) return status;
      return MODULE_FUNC(Text, String8, AppendBuffer)(
          str, (const char *)encoded, units);
    }),

    OPERATION(CountCodepoints,
              (const MODULE_TYPE(Text, String8) *str, size_t *outCount), {
      if (str == NULL || outCount == NULL) return STATUS_CONST(INVALID_ARGUMENT);
      if (str->size == 0U) {
        *outCount = 0U;
        return STATUS_CONST(SUCCESS);
      }
      size_t units = 0U;
      return MODULE_FUNC(Text, UTF8, Count)((const unsigned char *)str->data,
                                            str->size, outCount, &units);
    }),

    PREDICATE(Validate, (const MODULE_TYPE(Text, String8) *str), {
      if (str == NULL) return false;
      if (str->size == 0U) return true;
      return MODULE_FUNC(Text, UTF8, Validate)((const unsigned char *)str->data,
                                               str->size);
    }),

    VARIANT(Trim,
      OPERATION((MODULE_TYPE(Text, String8) *str), {
        if (str == NULL) return STATUS_CONST(INVALID_ARGUMENT);
        OPSTATUS status = MODULE_FUNC(Text, String8, TrimRight)(str);
        if (status != STATUS_CONST(SUCCESS)) return status;
        return MODULE_FUNC(Text, String8, TrimLeft)(str);
      }),

      OPERATION(Left, (MODULE_TYPE(Text, String8) *str), {
        if (str == NULL) return STATUS_CONST(INVALID_ARGUMENT);
        if (str->size == 0U || str->data == NULL) {
          return STATUS_CONST(SUCCESS);
        }
        const MODULE_TYPE(Text, View8) view =
            MODULE_FUNC(Text, String8, View)(str);
        const MODULE_TYPE(Text, View8) trimmed =
            MODULE_FUNC(Text, View8, TrimLeft)(view);
        const size_t leading = (size_t)(trimmed.data - view.data);
        if (leading > 0U) {
          return MODULE_FUNC(Text, String8, Erase)(str, 0U, leading);
        }
        return STATUS_CONST(SUCCESS);
      }),

      OPERATION(Right, (MODULE_TYPE(Text, String8) *str), {
        if (str == NULL) return STATUS_CONST(INVALID_ARGUMENT);
        if (str->size == 0U || str->data == NULL) {
          return STATUS_CONST(SUCCESS);
        }
        const MODULE_TYPE(Text, View8) view =
            MODULE_FUNC(Text, String8, View)(str);
        const MODULE_TYPE(Text, View8) trimmed =
            MODULE_FUNC(Text, View8, TrimRight)(view);
        str->size = trimmed.size;
        str->data[str->size] = '\0';
        return STATUS_CONST(SUCCESS);
      })
    ),

    VARIANT(Format,
      OPERATION((MODULE_TYPE(Text, String8) *str, const char *format, ...), {
        OPSTATUS status;
        va_list args;
        va_start(args, format);
        status = MODULE_FUNC(Text, String8, FormatVariadic)(str, format, args);
        va_end(args);
        return status;
      }),

      OPERATION(Variadic,
                (MODULE_TYPE(Text, String8) *str, const char *format,
                 va_list arguments), {
        if (str == NULL || format == NULL) return STATUS_CONST(INVALID_ARGUMENT);
        OPSTATUS status = MODULE_FUNC(Text, String8, Clear)(str);
        if (status != STATUS_CONST(SUCCESS)) return status;
        MODULE_TYPE(Text, Writer) writer =
            MODULE_FUNC(Text, Writer, ToString)(str);
        status = MODULE_FUNC(Text, Format, ToVariadic)(
            &writer, format, arguments);
        if (status == STATUS_CONST(SUCCESS)) {
          status = MODULE_FUNC(Text, Writer, Finish)(&writer);
        }
        if (status != STATUS_CONST(SUCCESS)) {
          (void)MODULE_FUNC(Text, String8, Clear)(str);
        }
        return status;
      })
    ),

    VARIANT(AppendFormat,
      OPERATION((MODULE_TYPE(Text, String8) *str, const char *format, ...), {
        OPSTATUS status;
        va_list args;
        va_start(args, format);
        status = MODULE_FUNC(Text, String8, AppendFormatVariadic)(
            str, format, args);
        va_end(args);
        return status;
      }),

      OPERATION(Variadic,
                (MODULE_TYPE(Text, String8) *str, const char *format,
                 va_list arguments), {
        if (str == NULL || format == NULL) return STATUS_CONST(INVALID_ARGUMENT);
        const size_t originalSize = str->size;
        MODULE_TYPE(Text, Writer) writer =
            MODULE_FUNC(Text, Writer, ToString)(str);
        OPSTATUS status = MODULE_FUNC(Text, Format, ToVariadic)(
            &writer, format, arguments);
        if (status == STATUS_CONST(SUCCESS)) {
          status = MODULE_FUNC(Text, Writer, Finish)(&writer);
        }
        if (status != STATUS_CONST(SUCCESS)) {
          str->size = originalSize;
          if (str->data != NULL) {
            str->data[originalSize] = '\0';
          }
        }
        return status;
      })
    ),

    OPERATION(SliceCodepoints,
              (const MODULE_TYPE(Text, String8) *str, size_t codepointStart,
               size_t codepointCount, MODULE_TYPE(Text, View8) *outView), {
      if (str == NULL) return STATUS_CONST(INVALID_ARGUMENT);
      MODULE_TYPE(Text, View8) view = MODULE_FUNC(Text, String8, View)(str);
      return MODULE_FUNC(Text, View8, SliceCodepoints)(
          view, codepointStart, codepointCount, outView);
    })
  )
);

/* EOF */
