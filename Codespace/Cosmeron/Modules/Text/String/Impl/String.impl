#pragma once

MODULE_IMPLEMENT(DOMAIN(Modules), Text,
  INTERNAL_EX(String8,
    PREDICATE(IsSpace, (char c), {
      return c == ' ' || c == '\t' || c == '\n' || c == '\r' || c == '\v' ||
             c == '\f';
    })
  ),

  PACKAGE(String8,
    OPERATION(AppendCodepoint,
              (MODULE_TYPE(Text, String8) *str,
               MODULE_TYPE(Text, Char32) codepoint), {
      if (str == NULL) return STATUS_CONST(INVALID_ARGUMENT);
      unsigned char encoded[CNS(Text, String, Internal, UTF8_MAX_BYTES)];
      size_t units = 0U;
      OPSTATUS status = MODULE_FUNC(Text, UTF8, Encode)(
          codepoint, encoded, sizeof(encoded), &units);
      if (status != STATUS_CONST(SUCCESS)) return status;
      return MODULE_FUNC(Text, String8, AppendBuffer)(
          str, (const char *)encoded, units);
    }),

    OPERATION(CountCodepoints,
              (const MODULE_TYPE(Text, String8) *str, size_t *outCount), {
      if (str == NULL || outCount == NULL) return STATUS_CONST(INVALID_ARGUMENT);
      if (str->size == 0U) {
        *outCount = 0U;
        return STATUS_CONST(SUCCESS);
      }
      size_t units = 0U;
      return MODULE_FUNC(Text, UTF8, Count)((const unsigned char *)str->data,
                                            str->size, outCount, &units);
    }),

    PREDICATE(Validate, (const MODULE_TYPE(Text, String8) *str), {
      if (str == NULL) return false;
      if (str->size == 0U) return true;
      return MODULE_FUNC(Text, UTF8, Validate)((const unsigned char *)str->data,
                                               str->size);
    }),

    VARIANT(Trim,
      OPERATION((MODULE_TYPE(Text, String8) *str), {
        if (str == NULL) return STATUS_CONST(INVALID_ARGUMENT);
        OPSTATUS status = MODULE_FUNC(Text, String8, TrimRight)(str);
        if (status != STATUS_CONST(SUCCESS)) return status;
        return MODULE_FUNC(Text, String8, TrimLeft)(str);
      }),

      OPERATION(Left, (MODULE_TYPE(Text, String8) *str), {
        if (str == NULL) return STATUS_CONST(INVALID_ARGUMENT);
        size_t start = 0U;
        while (start < str->size &&
               MODULE_IFUNC(Text, String8, IsSpace)(str->data[start])) {
          ++start;
        }
        if (start > 0U) {
          return MODULE_FUNC(Text, String8, Erase)(str, 0U, start);
        }
        return STATUS_CONST(SUCCESS);
      }),

      OPERATION(Right, (MODULE_TYPE(Text, String8) *str), {
        if (str == NULL) return STATUS_CONST(INVALID_ARGUMENT);
        size_t end = str->size;
        while (end > 0U &&
               MODULE_IFUNC(Text, String8, IsSpace)(str->data[end - 1U])) {
          --end;
        }
        str->size = end;
        if (str->data != NULL) {
          str->data[end] = '\0';
        }
        return STATUS_CONST(SUCCESS);
      })
    ),

    VARIANT(Format,
      OPERATION((MODULE_TYPE(Text, String8) *str, const char *format, ...), {
        OPSTATUS status;
        va_list args;
        va_start(args, format);
        status = MODULE_FUNC(Text, String8, FormatVariadic)(str, format, args);
        va_end(args);
        return status;
      }),

      OPERATION(Variadic,
                (MODULE_TYPE(Text, String8) *str, const char *format,
                 va_list arguments), {
        if (str == NULL || format == NULL) return STATUS_CONST(INVALID_ARGUMENT);
        va_list argsCopy;
        va_copy(argsCopy, arguments);
        size_t needed = 0U;
        OPSTATUS status = MODULE_FUNC(Text, Format, Variadic)(
            NULL, 0U, &needed, format, argsCopy);
        va_end(argsCopy);
        if (status != STATUS_CONST(SUCCESS)) return status;

        status = MODULE_FUNC(Text, String8, Reserve)(str, needed);
        if (status != STATUS_CONST(SUCCESS)) return status;

        size_t written = 0U;
        status = MODULE_FUNC(Text, Format, Variadic)(
            str->data, str->capacity + 1U, &written, format, arguments);
        if (status != STATUS_CONST(SUCCESS)) return status;

        str->size = written;
        str->data[written] = '\0';
        return STATUS_CONST(SUCCESS);
      })
    ),

    VARIANT(AppendFormat,
      OPERATION((MODULE_TYPE(Text, String8) *str, const char *format, ...), {
        OPSTATUS status;
        va_list args;
        va_start(args, format);
        status = MODULE_FUNC(Text, String8, AppendFormatVariadic)(str, format, args);
        va_end(args);
        return status;
      }),

      OPERATION(Variadic,
                (MODULE_TYPE(Text, String8) *str, const char *format,
                 va_list arguments), {
        if (str == NULL || format == NULL) return STATUS_CONST(INVALID_ARGUMENT);
        va_list argsCopy;
        va_copy(argsCopy, arguments);
        size_t needed = 0U;
        OPSTATUS status = MODULE_FUNC(Text, Format, Variadic)(
            NULL, 0U, &needed, format, argsCopy);
        va_end(argsCopy);
        if (status != STATUS_CONST(SUCCESS)) return status;

        if (str->size > SIZE_MAX - needed) return STATUS_CONST(OUT_OF_RANGE);
        size_t total = str->size + needed;

        status = MODULE_FUNC(Text, String8, Reserve)(str, total + 1U);
        if (status != STATUS_CONST(SUCCESS)) return status;

        size_t written = 0U;
        status = MODULE_FUNC(Text, Format, Variadic)(
            str->data + str->size, (str->capacity + 1U) - str->size, &written,
            format, arguments);
        if (status != STATUS_CONST(SUCCESS)) return status;

        str->size += written;
        str->data[str->size] = '\0';
        return STATUS_CONST(SUCCESS);
      })
    ),

    OPERATION(SliceCodepoints,
              (const MODULE_TYPE(Text, String8) *str, size_t codepointStart,
               size_t codepointCount, MODULE_TYPE(Text, View8) *outView), {
      if (str == NULL) return STATUS_CONST(INVALID_ARGUMENT);
      MODULE_TYPE(Text, View8) view = MODULE_FUNC(Text, String8, View)(str);
      return MODULE_FUNC(Text, View8, SliceCodepoints)(view, codepointStart,
                                                       codepointCount, outView);
    })
  )
);
