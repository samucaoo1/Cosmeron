#pragma once

#include "../../Core/Namespace.h"
#include "../../Core/Preprocessor/Compiling.inc"

#include <stdbool.h>
#include <stddef.h>
#include <stdint.h>

#define TEXT_MOD Text
#define TEXT_CMOD TEXT

#define TEXT_NS(NAME) GNS2(LIB_PREFIX(TEXT_MOD), NAME)
#define TEXT_CNS(NAME) CNS2(LIB_PREFIX_CONST(TEXT_CMOD), NAME)
#define TEXT_INS(NAME) GNS3(LIB_PREFIX(TEXT_MOD), Internal, NAME)
#define TEXT_CINS(NAME) CNS3(LIB_PREFIX_CONST(TEXT_CMOD), INTERNAL, NAME)

#define TEXT_TYPE(NAME) TEXT_NS(NAME)
#define TEXT_FUNC(NAME) TEXT_NS(NAME)
#define TEXT_CONST(NAME) TEXT_CNS(NAME)

#define TEXT_CODEPOINT_FUNC(NAME) GNS3(LIB_PREFIX(TEXT_MOD), Codepoint, NAME)
#define TEXT_UTF8_FUNC(NAME) GNS3(LIB_PREFIX(TEXT_MOD), UTF8, NAME)
#define TEXT_UTF16_FUNC(NAME) GNS3(LIB_PREFIX(TEXT_MOD), UTF16, NAME)
#define TEXT_WIDTH_FUNC(NAME) GNS3(LIB_PREFIX(TEXT_MOD), Width, NAME)
#define TEXT_GRID_NS(NAME) GNS3(LIB_PREFIX(TEXT_MOD), Grid, NAME)

#define TEXT_GRID_TYPE(SUFFIX) GNS2(TEXT_GRID_NS(TGrid), SUFFIX)
#define TEXT_GRID_FUNC(SUFFIX, FUNCTION) GNS2(GNS3(LIB_PREFIX(TEXT_MOD), Grid, SUFFIX), FUNCTION)
#define TEXT_GRID_CHAR_TYPE(SUFFIX) GNS2(TEXT_GRID_NS(TCharGrid), SUFFIX)
#define TEXT_GRID_CHAR_FUNC(SUFFIX, FUNCTION) GNS2(GNS4(LIB_PREFIX(TEXT_MOD), Grid, Char, SUFFIX), FUNCTION)
#define TEXT_GRID_ATTRIBUTE_TYPE(NAME) GNS4(LIB_PREFIX(TEXT_MOD), Grid, Attribute, PP_OP_CAT2(T, NAME))
#define TEXT_GRID_ATTRIBUTE_FUNC(NAME) GNS4(LIB_PREFIX(TEXT_MOD), Grid, Attribute, NAME)
#define TEXT_GRID_ATTRIBUTE_CONST(NAME) CNS4(LIB_PREFIX_CONST(TEXT_CMOD), GRID, ATTRIBUTE, NAME)
#define TEXT_GRID_UNDERLINE_TYPE(NAME) GNS4(LIB_PREFIX(TEXT_MOD), Grid, Underline, PP_OP_CAT2(T, NAME))
#define TEXT_GRID_UNDERLINE_CONST(NAME) CNS4(LIB_PREFIX_CONST(TEXT_CMOD), GRID, UNDERLINE, NAME)
#define TEXT_GRID_COLOR_TYPE(NAME) GNS4(LIB_PREFIX(TEXT_MOD), Grid, Color, PP_OP_CAT2(T, NAME))
#define TEXT_GRID_COLOR_FUNC(NAME) GNS4(LIB_PREFIX(TEXT_MOD), Grid, Color, NAME)
#define TEXT_GRID_COLOR_CONST(NAME) CNS4(LIB_PREFIX_CONST(TEXT_CMOD), GRID, COLOR, NAME)

typedef uint16_t TEXT_TYPE(TChar16);
typedef uint32_t TEXT_TYPE(TChar32);

#define TEXT_GRID_CHARACTER_TABLE(X)                                          \
  X(char, char)                                                               \
  X(TEXT_TYPE(TChar16), char16)                                               \
  X(TEXT_TYPE(TChar32), char32)
/* EOF */
