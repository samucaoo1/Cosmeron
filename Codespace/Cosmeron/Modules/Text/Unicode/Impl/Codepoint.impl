#pragma once

TEXT_CODEPOINT_IS_VALID_PROTOTYPE {
  return (uint_least32_t)codepoint <= UINT32_C(0x10FFFF);
}

TEXT_CODEPOINT_IS_SCALAR_PROTOTYPE {
  uint_least32_t value = (uint_least32_t)codepoint;
  return value <= UINT32_C(0x10FFFF) &&
         !(value >= UINT32_C(0xD800) && value <= UINT32_C(0xDFFF));
}

TEXT_CODEPOINT_IS_ASCII_PROTOTYPE {
  return (uint_least32_t)codepoint <= UINT32_C(0x7F);
}

TEXT_CODEPOINT_IS_CONTROL_PROTOTYPE {
  uint_least32_t value = (uint_least32_t)codepoint;
  return value <= UINT32_C(0x1F) ||
         (value >= UINT32_C(0x7F) && value <= UINT32_C(0x9F));
}

TEXT_CODEPOINT_IS_WHITESPACE_PROTOTYPE {
  uint_least32_t value = (uint_least32_t)codepoint;
  return (value >= UINT32_C(0x0009) && value <= UINT32_C(0x000D)) ||
         value == UINT32_C(0x0020) || value == UINT32_C(0x0085) ||
         value == UINT32_C(0x00A0) || value == UINT32_C(0x1680) ||
         (value >= UINT32_C(0x2000) && value <= UINT32_C(0x200A)) ||
         value == UINT32_C(0x2028) || value == UINT32_C(0x2029) ||
         value == UINT32_C(0x202F) || value == UINT32_C(0x205F) ||
         value == UINT32_C(0x3000);
}
/* EOF */
