#pragma once

#define TEXT_UTF16_CONST_COL_NAME(NAME, VALUE) NAME
#define TEXT_UTF16_CONST_COL_VALUE(NAME, VALUE) VALUE
#define TEXT_UTF16_CONST_GET(FIELD, ROW)                                       \
  PP_OP_CAT2(TEXT_UTF16_CONST_COL_, FIELD) ROW

#define TEXT_UTF16_CONST_TABLE(X)                                              \
  X((BMP_MAX, 0xFFFFU))                                                        \
  X((SUPPLEMENTARY_BASE, 0x10000U))                                            \
  X((HIGH_SURROGATE_MIN, 0xD800U))                                             \
  X((HIGH_SURROGATE_MAX, 0xDBFFU))                                             \
  X((LOW_SURROGATE_MIN, 0xDC00U))                                              \
  X((LOW_SURROGATE_MAX, 0xDFFFU))                                              \
  X((SURROGATE_MASK, 0x3FFU))                                                  \
  X((SURROGATE_BITS, 10U))

MODULE(DOMAIN(Modules), Text,
  INTERNAL_EX(UTF16,
    ENUM_EX(Const, TEXT_UTF16_CONST_TABLE, PLAIN)
  )
);

MODULE_IMPLEMENT(DOMAIN(Modules), Text,
  PACKAGE(UTF16,
    OPERATION(EncodedLength,
              (MODULE_TYPE(Text, Char32) codepoint, size_t *outUnits), {
      if (outUnits == NULL) {
        return STATUS_CONST(INVALID_ARGUMENT);
      }
      if (!MODULE_FUNC(Text, Codepoint, IsScalar)(codepoint)) {
        return STATUS_CONST(INVALID_SEQUENCE);
      }

      const uint_least32_t value = (uint_least32_t)codepoint;
      *outUnits = (value <= MODULE_IFUNC(Text, UTF16, BMP_MAX)) ? 1U : 2U;
      return STATUS_CONST(SUCCESS);
    }),

    OPERATION(Encode,
              (MODULE_TYPE(Text, Char32) codepoint,
               MODULE_TYPE(Text, Char16) *output, size_t capacity,
               size_t *outUnits), {
      if (output == NULL || outUnits == NULL) {
        return STATUS_CONST(INVALID_ARGUMENT);
      }

      size_t length = 0U;
      const OPSTATUS status =
          MODULE_FUNC(Text, UTF16, EncodedLength)(codepoint, &length);
      if (status != STATUS_CONST(SUCCESS)) {
        return status;
      }
      if (capacity < length) {
        return STATUS_CONST(INSUFFICIENT_SPACE);
      }

      uint_least32_t value = (uint_least32_t)codepoint;
      if (length == 1U) {
        output[0] = (MODULE_TYPE(Text, Char16))value;
      } else {
        value -= MODULE_IFUNC(Text, UTF16, SUPPLEMENTARY_BASE);
        output[0] = (MODULE_TYPE(Text, Char16))(
            MODULE_IFUNC(Text, UTF16, HIGH_SURROGATE_MIN) +
            (value >> MODULE_IFUNC(Text, UTF16, SURROGATE_BITS)));
        output[1] = (MODULE_TYPE(Text, Char16))(
            MODULE_IFUNC(Text, UTF16, LOW_SURROGATE_MIN) +
            (value & MODULE_IFUNC(Text, UTF16, SURROGATE_MASK)));
      }

      *outUnits = length;
      return STATUS_CONST(SUCCESS);
    }),

    OPERATION(Decode,
              (const MODULE_TYPE(Text, Char16) *input, size_t size,
               MODULE_TYPE(Text, Char32) *outCodepoint, size_t *outUnits), {
      if (input == NULL || outCodepoint == NULL || outUnits == NULL) {
        return STATUS_CONST(INVALID_ARGUMENT);
      }
      if (size == 0U) {
        return STATUS_CONST(INCOMPLETE_SEQUENCE);
      }

      const uint_least32_t first = (uint_least32_t)input[0];
      if (first < MODULE_IFUNC(Text, UTF16, HIGH_SURROGATE_MIN) ||
          first > MODULE_IFUNC(Text, UTF16, LOW_SURROGATE_MAX)) {
        *outCodepoint = (MODULE_TYPE(Text, Char32))first;
        *outUnits = 1U;
        return STATUS_CONST(SUCCESS);
      }

      if (first > MODULE_IFUNC(Text, UTF16, HIGH_SURROGATE_MAX)) {
        return STATUS_CONST(INVALID_SEQUENCE);
      }
      if (size < 2U) {
        return STATUS_CONST(INCOMPLETE_SEQUENCE);
      }

      const uint_least32_t second = (uint_least32_t)input[1];
      if (second < MODULE_IFUNC(Text, UTF16, LOW_SURROGATE_MIN) ||
          second > MODULE_IFUNC(Text, UTF16, LOW_SURROGATE_MAX)) {
        return STATUS_CONST(INVALID_SEQUENCE);
      }

      *outCodepoint = (MODULE_TYPE(Text, Char32))(
          MODULE_IFUNC(Text, UTF16, SUPPLEMENTARY_BASE) +
          ((first - MODULE_IFUNC(Text, UTF16, HIGH_SURROGATE_MIN))
           << MODULE_IFUNC(Text, UTF16, SURROGATE_BITS)) +
          (second - MODULE_IFUNC(Text, UTF16, LOW_SURROGATE_MIN)));
      *outUnits = 2U;
      return STATUS_CONST(SUCCESS);
    }),

    OPERATION(Count,
              (const MODULE_TYPE(Text, Char16) *input, size_t size,
               size_t *outCodepoints, size_t *outUnits), {
      if (outCodepoints == NULL || outUnits == NULL) {
        return STATUS_CONST(INVALID_ARGUMENT);
      }
      if (input == NULL && size != 0U) {
        return STATUS_CONST(INVALID_ARGUMENT);
      }

      size_t offset = 0U;
      size_t count = 0U;
      while (offset < size) {
        MODULE_TYPE(Text, Char32) codepoint = 0;
        size_t units = 0U;
        const OPSTATUS status = MODULE_FUNC(Text, UTF16, Decode)(
            input + offset, size - offset, &codepoint, &units);
        (void)codepoint;
        if (status != STATUS_CONST(SUCCESS)) {
          return status;
        }
        offset += units;
        ++count;
      }

      *outCodepoints = count;
      *outUnits = offset;
      return STATUS_CONST(SUCCESS);
    }),

    PREDICATE(Validate,
              (const MODULE_TYPE(Text, Char16) *input, size_t size), {
      size_t codepoints = 0U;
      size_t units = 0U;
      return MODULE_FUNC(Text, UTF16, Count)(input, size, &codepoints,
                                             &units) == STATUS_CONST(SUCCESS);
    }),

    OPERATION(FromUTF8,
              (const unsigned char *input, size_t size,
               MODULE_TYPE(Text, Char16) *output, size_t capacity,
               size_t *outUnits), {
      if (outUnits == NULL || (input == NULL && size != 0U) ||
          (output == NULL && capacity > 0U)) {
        return STATUS_CONST(INVALID_ARGUMENT);
      }

      size_t inOffset = 0U;
      size_t totalUnits = 0U;
      while (inOffset < size) {
        MODULE_TYPE(Text, Char32) codepoint = 0U;
        size_t inBytes = 0U;
        OPSTATUS status = MODULE_FUNC(Text, UTF8, Decode)(
            input + inOffset, size - inOffset, &codepoint, &inBytes);
        if (status != STATUS_CONST(SUCCESS)) {
          return status;
        }

        size_t units = 0U;
        if (output == NULL) {
          status = MODULE_FUNC(Text, UTF16, EncodedLength)(codepoint, &units);
        } else {
          status = MODULE_FUNC(Text, UTF16, Encode)(
              codepoint, output + totalUnits, capacity - totalUnits, &units);
        }
        if (status != STATUS_CONST(SUCCESS)) {
          return status;
        }

        totalUnits += units;
        inOffset += inBytes;
      }

      *outUnits = totalUnits;
      return STATUS_CONST(SUCCESS);
    }),

    OPERATION(ToUTF8,
              (const MODULE_TYPE(Text, Char16) *input, size_t size,
               unsigned char *output, size_t capacity, size_t *outBytes), {
      if (outBytes == NULL || (input == NULL && size != 0U) ||
          (output == NULL && capacity > 0U)) {
        return STATUS_CONST(INVALID_ARGUMENT);
      }

      size_t inOffset = 0U;
      size_t totalBytes = 0U;
      while (inOffset < size) {
        MODULE_TYPE(Text, Char32) codepoint = 0U;
        size_t inUnits = 0U;
        OPSTATUS status = MODULE_FUNC(Text, UTF16, Decode)(
            input + inOffset, size - inOffset, &codepoint, &inUnits);
        if (status != STATUS_CONST(SUCCESS)) {
          return status;
        }

        size_t bytes = 0U;
        if (output == NULL) {
          status = MODULE_FUNC(Text, UTF8, EncodedLength)(codepoint, &bytes);
        } else {
          status = MODULE_FUNC(Text, UTF8, Encode)(
              codepoint, output + totalBytes, capacity - totalBytes, &bytes);
        }
        if (status != STATUS_CONST(SUCCESS)) {
          return status;
        }

        totalBytes += bytes;
        inOffset += inUnits;
      }

      *outBytes = totalBytes;
      return STATUS_CONST(SUCCESS);
    })
  )
);

/* EOF */
