#pragma once

#define TEXT_UTF8_CONST_COL_NAME(NAME, VALUE) NAME
#define TEXT_UTF8_CONST_COL_VALUE(NAME, VALUE) VALUE
#define TEXT_UTF8_CONST_GET(FIELD, ROW)                                        \
  PP_OP_CAT2(TEXT_UTF8_CONST_COL_, FIELD) ROW

#define TEXT_UTF8_CONST_TABLE(X)                                               \
  X((MAX_1BYTE, 0x7FU))                                                        \
  X((MAX_2BYTE, 0x7FFU))                                                       \
  X((MAX_3BYTE, 0xFFFFU))                                                      \
  X((MIN_2BYTE, 0x80U))                                                        \
  X((MIN_3BYTE, 0x800U))                                                       \
  X((MIN_4BYTE, 0x10000U))                                                     \
  X((LEAD_2_PREFIX, 0xC0U))                                                    \
  X((LEAD_2_MIN, 0xC2U))                                                       \
  X((LEAD_2_MAX, 0xDFU))                                                       \
  X((LEAD_3_PREFIX, 0xE0U))                                                    \
  X((LEAD_3_MAX, 0xEFU))                                                       \
  X((LEAD_4_PREFIX, 0xF0U))                                                    \
  X((LEAD_4_MAX, 0xF4U))                                                       \
  X((CONT_PREFIX, 0x80U))                                                      \
  X((CONT_TYPE_MASK, 0xC0U))                                                   \
  X((CONT_DATA_MASK, 0x3FU))                                                   \
  X((LEAD_2_MASK, 0x1FU))                                                      \
  X((LEAD_3_MASK, 0x0FU))                                                      \
  X((LEAD_4_MASK, 0x07U))                                                      \
  X((CONT_BITS, 6U))

MODULE(DOMAIN(Modules), Text,
  INTERNAL_EX(UTF8,
    ENUM_EX(Const, TEXT_UTF8_CONST_TABLE, PLAIN)
  )
);

MODULE_IMPLEMENT(DOMAIN(Modules), Text,
  PACKAGE(UTF8,
    OPERATION(EncodedLength,
              (MODULE_TYPE(Text, Char32) codepoint, size_t *outUnits), {
      if (outUnits == NULL) {
        return STATUS_CONST(INVALID_ARGUMENT);
      }
      if (!MODULE_FUNC(Text, Codepoint, IsScalar)(codepoint)) {
        return STATUS_CONST(INVALID_SEQUENCE);
      }

      const uint_least32_t value = (uint_least32_t)codepoint;
      if (value <= MODULE_IFUNC(Text, UTF8, MAX_1BYTE)) {
        *outUnits = 1U;
      } else if (value <= MODULE_IFUNC(Text, UTF8, MAX_2BYTE)) {
        *outUnits = 2U;
      } else if (value <= MODULE_IFUNC(Text, UTF8, MAX_3BYTE)) {
        *outUnits = 3U;
      } else {
        *outUnits = 4U;
      }

      return STATUS_CONST(SUCCESS);
    }),

    OPERATION(Encode,
              (MODULE_TYPE(Text, Char32) codepoint, unsigned char *output,
               size_t capacity, size_t *outUnits), {
      if (output == NULL || outUnits == NULL) {
        return STATUS_CONST(INVALID_ARGUMENT);
      }

      size_t length = 0U;
      const OPSTATUS status =
          MODULE_FUNC(Text, UTF8, EncodedLength)(codepoint, &length);
      if (status != STATUS_CONST(SUCCESS)) {
        return status;
      }
      if (capacity < length) {
        return STATUS_CONST(INSUFFICIENT_SPACE);
      }

      uint_least32_t value = (uint_least32_t)codepoint;
      if (length == 1U) {
        output[0] = (unsigned char)value;
      } else {
        for (size_t i = length - 1U; i >= 1U; --i) {
          output[i] = (unsigned char)(MODULE_IFUNC(Text, UTF8, CONT_PREFIX) |
                                      (value & MODULE_IFUNC(Text, UTF8,
                                                            CONT_DATA_MASK)));
          value >>= MODULE_IFUNC(Text, UTF8, CONT_BITS);
        }
        const uint_least32_t leadPrefix =
            (length == 2U)
                ? MODULE_IFUNC(Text, UTF8, LEAD_2_PREFIX)
                : ((length == 3U) ? MODULE_IFUNC(Text, UTF8, LEAD_3_PREFIX)
                                  : MODULE_IFUNC(Text, UTF8, LEAD_4_PREFIX));
        output[0] = (unsigned char)(leadPrefix | value);
      }

      *outUnits = length;
      return STATUS_CONST(SUCCESS);
    }),

    OPERATION(Decode,
              (const unsigned char *input, size_t size,
               MODULE_TYPE(Text, Char32) *outCodepoint, size_t *outUnits), {
      if (input == NULL || outCodepoint == NULL || outUnits == NULL) {
        return STATUS_CONST(INVALID_ARGUMENT);
      }
      if (size == 0U) {
        return STATUS_CONST(INCOMPLETE_SEQUENCE);
      }

      if (input[0] <= MODULE_IFUNC(Text, UTF8, MAX_1BYTE)) {
        *outCodepoint = (MODULE_TYPE(Text, Char32))input[0];
        *outUnits = 1U;
        return STATUS_CONST(SUCCESS);
      }

      uint_least32_t value = 0U;
      uint_least32_t minimum = 0U;
      size_t length = 0U;

      if (input[0] >= MODULE_IFUNC(Text, UTF8, LEAD_2_MIN) &&
          input[0] <= MODULE_IFUNC(Text, UTF8, LEAD_2_MAX)) {
        value = input[0] & MODULE_IFUNC(Text, UTF8, LEAD_2_MASK);
        length = 2U;
        minimum = MODULE_IFUNC(Text, UTF8, MIN_2BYTE);
      } else if (input[0] >= MODULE_IFUNC(Text, UTF8, LEAD_3_PREFIX) &&
                 input[0] <= MODULE_IFUNC(Text, UTF8, LEAD_3_MAX)) {
        value = input[0] & MODULE_IFUNC(Text, UTF8, LEAD_3_MASK);
        length = 3U;
        minimum = MODULE_IFUNC(Text, UTF8, MIN_3BYTE);
      } else if (input[0] >= MODULE_IFUNC(Text, UTF8, LEAD_4_PREFIX) &&
                 input[0] <= MODULE_IFUNC(Text, UTF8, LEAD_4_MAX)) {
        value = input[0] & MODULE_IFUNC(Text, UTF8, LEAD_4_MASK);
        length = 4U;
        minimum = MODULE_IFUNC(Text, UTF8, MIN_4BYTE);
      } else {
        return STATUS_CONST(INVALID_SEQUENCE);
      }

      if (size < length) {
        return STATUS_CONST(INCOMPLETE_SEQUENCE);
      }

      for (size_t index = 1U; index < length; ++index) {
        if ((input[index] & MODULE_IFUNC(Text, UTF8, CONT_TYPE_MASK)) !=
            MODULE_IFUNC(Text, UTF8, CONT_PREFIX)) {
          return STATUS_CONST(INVALID_SEQUENCE);
        }
        value = (value << MODULE_IFUNC(Text, UTF8, CONT_BITS)) |
                (input[index] & MODULE_IFUNC(Text, UTF8, CONT_DATA_MASK));
      }

      if (value < minimum ||
          !MODULE_FUNC(Text, Codepoint,
                       IsScalar)((MODULE_TYPE(Text, Char32))value)) {
        return STATUS_CONST(INVALID_SEQUENCE);
      }

      *outCodepoint = (MODULE_TYPE(Text, Char32))value;
      *outUnits = length;
      return STATUS_CONST(SUCCESS);
    }),

    OPERATION(Count,
              (const unsigned char *input, size_t size, size_t *outCodepoints,
               size_t *outUnits), {
      if (outCodepoints == NULL || outUnits == NULL) {
        return STATUS_CONST(INVALID_ARGUMENT);
      }
      if (input == NULL && size != 0U) {
        return STATUS_CONST(INVALID_ARGUMENT);
      }

      size_t offset = 0U;
      size_t count = 0U;
      while (offset < size) {
        MODULE_TYPE(Text, Char32) codepoint = 0;
        size_t units = 0U;
        const OPSTATUS status = MODULE_FUNC(Text, UTF8, Decode)(
            input + offset, size - offset, &codepoint, &units);
        (void)codepoint;
        if (status != STATUS_CONST(SUCCESS)) {
          return status;
        }
        offset += units;
        ++count;
      }

      *outCodepoints = count;
      *outUnits = offset;
      return STATUS_CONST(SUCCESS);
    }),

    PREDICATE(Validate, (const unsigned char *input, size_t size), {
      size_t codepoints = 0U;
      size_t units = 0U;
      return MODULE_FUNC(Text, UTF8, Count)(input, size, &codepoints,
                                            &units) == STATUS_CONST(SUCCESS);
    })
  )
);

/* EOF */
