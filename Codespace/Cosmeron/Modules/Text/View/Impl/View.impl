#pragma once

PACKAGE_PREDICATE_IMPLEMENT_EX(Text_View8, Validate,
                               (MODULE_TYPED(Text, View, 8) view)) {
  if (view.size == 0U) return true;
  if (view.data == NULL) return false;
  return MODULE_FUNC(Text, UTF8, Validate)((const unsigned char *)view.data, view.size);
}

PACKAGE_OPERATION_IMPLEMENT_EX(Text_View8, CountCodepoints,
                               (MODULE_TYPED(Text, View, 8) view,
                                size_t *outCount)) {
  if (outCount == NULL) return STATUS_CONST(INVALID_ARGUMENT);
  if (view.size == 0U) {
    *outCount = 0U;
    return STATUS_CONST(SUCCESS);
  }
  if (view.data == NULL) return STATUS_CONST(INVALID_ARGUMENT);
  size_t units = 0U;
  return MODULE_FUNC(Text, UTF8, Count)(
      (const unsigned char *)view.data, view.size, outCount, &units);
}

PACKAGE_OPERATION_IMPLEMENT_EX(Text_View8, NextCodepoint,
                               (MODULE_TYPED(Text, View, 8) *view,
                                MODULE_TYPE(Text, Char32) *outCodepoint)) {
  if (view == NULL || outCodepoint == NULL) {
    return STATUS_CONST(INVALID_ARGUMENT);
  }
  if (view->data == NULL || view->size == 0U) {
    return STATUS_CONST(OUT_OF_RANGE);
  }
  size_t units = 0U;
  OPSTATUS status = MODULE_FUNC(Text, UTF8, Decode)(
      (const unsigned char *)view->data, view->size, outCodepoint, &units);
  if (status != STATUS_CONST(SUCCESS)) {
    return status;
  }
  view->data += units;
  view->size -= units;
  return STATUS_CONST(SUCCESS);
}

PACKAGE_FUNCTION_IMPLEMENT_EX(Text_View8, MODULE_TYPED(Text, View, 8),
                              TrimLeft, (MODULE_TYPED(Text, View, 8) view)) {
  if (view.data == NULL || view.size == 0U) {
    return view;
  }
  const unsigned char *ptr = (const unsigned char *)view.data;
  size_t remaining = view.size;
  while (remaining > 0U) {
    MODULE_TYPE(Text, Char32) cp = 0U;
    size_t units = 0U;
    if (MODULE_FUNC(Text, UTF8, Decode)(ptr, remaining, &cp, &units) !=
        STATUS_CONST(SUCCESS)) {
      break;
    }
    if (!MODULE_FUNC(Text, Codepoint, IsWhitespace)(cp)) {
      break;
    }
    ptr += units;
    remaining -= units;
  }
  return MODULE_FUNC(Text, View, 8, Create)((const char *)ptr, remaining);
}

PACKAGE_FUNCTION_IMPLEMENT_EX(Text_View8, MODULE_TYPED(Text, View, 8),
                              TrimRight, (MODULE_TYPED(Text, View, 8) view)) {
  if (view.data == NULL || view.size == 0U) {
    return view;
  }
  const unsigned char *bytes = (const unsigned char *)view.data;
  size_t end = view.size;
  while (end > 0U) {
    size_t cpStart = end - 1U;
    while (cpStart > 0U && (bytes[cpStart] & 0xC0U) == 0x80U &&
           (end - cpStart) < 4U) {
      --cpStart;
    }
    MODULE_TYPE(Text, Char32) cp = 0U;
    size_t units = 0U;
    if (MODULE_FUNC(Text, UTF8, Decode)(bytes + cpStart, end - cpStart, &cp, &units) !=
            STATUS_CONST(SUCCESS) ||
        units != (end - cpStart)) {
      break;
    }
    if (!MODULE_FUNC(Text, Codepoint, IsWhitespace)(cp)) {
      break;
    }
    end = cpStart;
  }
  return MODULE_FUNC(Text, View, 8, Create)(view.data, end);
}

PACKAGE_FUNCTION_IMPLEMENT_EX(Text_View8, MODULE_TYPED(Text, View, 8), Trim,
                              (MODULE_TYPED(Text, View, 8) view)) {
  return MODULE_FUNC(Text, View8, TrimLeft)(MODULE_FUNC(Text, View8, TrimRight)(view));
}

PACKAGE_OPERATION_IMPLEMENT_EX(Text_View8, SliceCodepoints,
                               (MODULE_TYPED(Text, View, 8) view,
                                size_t codepointStart, size_t codepointCount,
                                MODULE_TYPED(Text, View, 8) *outView)) {
  if (outView == NULL) {
    return STATUS_CONST(INVALID_ARGUMENT);
  }
  if (view.data == NULL && view.size > 0U) {
    return STATUS_CONST(INVALID_ARGUMENT);
  }
  if (codepointCount == 0U) {
    *outView = MODULE_FUNC(Text, View, 8, Empty)();
    return STATUS_CONST(SUCCESS);
  }

  const unsigned char *bytes = (const unsigned char *)view.data;
  size_t offset = 0U;
  size_t currentCodepoint = 0U;
  size_t byteStart = 0U;
  bool startFound = false;

  while (offset < view.size) {
    if (currentCodepoint == codepointStart) {
      byteStart = offset;
      startFound = true;
    }
    if (startFound && currentCodepoint == codepointStart + codepointCount) {
      *outView = MODULE_FUNC(Text, View, 8, Create)(
          view.data + byteStart, offset - byteStart);
      return STATUS_CONST(SUCCESS);
    }
    MODULE_TYPE(Text, Char32) cp = 0U;
    size_t units = 0U;
    OPSTATUS status = MODULE_FUNC(Text, UTF8, Decode)(
        bytes + offset, view.size - offset, &cp, &units);
    if (status != STATUS_CONST(SUCCESS)) {
      return status;
    }
    offset += units;
    ++currentCodepoint;
  }

  if (currentCodepoint == codepointStart) {
    byteStart = offset;
    startFound = true;
  }

  if (!startFound) {
    return STATUS_CONST(OUT_OF_RANGE);
  }

  *outView = MODULE_FUNC(Text, View, 8, Create)(
      view.data + byteStart, offset - byteStart);
  return STATUS_CONST(SUCCESS);
}
