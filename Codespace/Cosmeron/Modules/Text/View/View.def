/* View.def - Dual Mode Engine (Zero Duplication) */

#ifndef TEMPLATE_Text_View
#define TEMPLATE_Text_View(SUFFIX, TYPE)                                       \
  TEMPLATE_STRUCT(Text, View, SUFFIX,                                          \
      FIELDS(                                                                  \
          const TYPE *data;                                                    \
          size_t size;                                                         \
      )                                                                        \
  );                                                                           \
  TEMPLATE_PACKAGE(Text, View, SUFFIX,                                         \
      FUNCTION_INLINE(MODULE_TYPED(Text, View, SUFFIX), Create,                \
                      (const TYPE *data, size_t size), {                       \
        MODULE_TYPED(Text, View, SUFFIX) view;                                 \
        view.data = data;                                                      \
        view.size = size;                                                      \
        return view;                                                           \
      }),                                                                      \
                                                                               \
      FUNCTION_INLINE(MODULE_TYPED(Text, View, SUFFIX), FromCStr,              \
                      (const TYPE *cstr), {                                    \
        MODULE_TYPED(Text, View, SUFFIX) view;                                 \
        size_t len = 0U;                                                       \
        view.data = NULL;                                                      \
        view.size = 0U;                                                        \
        if (cstr == NULL)                                                      \
          return view;                                                         \
        while (cstr[len] != (TYPE)0)                                           \
          len++;                                                               \
        view.data = cstr;                                                      \
        view.size = len;                                                       \
        return view;                                                           \
      }),                                                                      \
                                                                               \
      FUNCTION_INLINE(MODULE_TYPED(Text, View, SUFFIX), Empty, (), {           \
        MODULE_TYPED(Text, View, SUFFIX) view;                                 \
        view.data = NULL;                                                      \
        view.size = 0U;                                                        \
        return view;                                                           \
      }),                                                                      \
                                                                               \
      FUNCTION_INLINE(size_t, Length,                                          \
                      (MODULE_TYPED(Text, View, SUFFIX) view), {               \
        return view.size;                                                      \
      }),                                                                      \
                                                                               \
      PREDICATE_INLINE(IsEmpty,                                                \
                       (MODULE_TYPED(Text, View, SUFFIX) view), {              \
        return view.size == 0U || view.data == NULL;                           \
      }),                                                                      \
                                                                               \
      FUNCTION_INLINE(const TYPE *, Data,                                      \
                      (MODULE_TYPED(Text, View, SUFFIX) view), {               \
        return view.data;                                                      \
      }),                                                                      \
                                                                               \
      OPERATION_INLINE(At,                                                     \
                       (MODULE_TYPED(Text, View, SUFFIX) view, size_t index,   \
                        TYPE *outChar), {                                      \
        if (outChar == NULL)                                                   \
          return STATUS_CONST(INVALID_ARGUMENT);                               \
        if (index >= view.size || view.data == NULL)                           \
          return STATUS_CONST(OUT_OF_RANGE);                                   \
        *outChar = view.data[index];                                           \
        return STATUS_CONST(SUCCESS);                                          \
      }),                                                                      \
                                                                               \
      FUNCTION_INLINE(MODULE_TYPED(Text, View, SUFFIX), Slice,                 \
                      (MODULE_TYPED(Text, View, SUFFIX) view, size_t start,    \
                       size_t count), {                                        \
        if (start >= view.size || view.data == NULL)                           \
          return MODULE_FUNC(Text, View, SUFFIX, Empty)();                     \
        {                                                                      \
          size_t available = view.size - start;                                \
          size_t actual = count < available ? count : available;               \
          return MODULE_FUNC(Text, View, SUFFIX, Create)(view.data + start,    \
                                                         actual);              \
        }                                                                      \
      }),                                                                      \
                                                                               \
      FUNCTION_INLINE(MODULE_TYPED(Text, View, SUFFIX), Prefix,                \
                      (MODULE_TYPED(Text, View, SUFFIX) view, size_t count), { \
        return MODULE_FUNC(Text, View, SUFFIX, Slice)(view, 0U, count);        \
      }),                                                                      \
                                                                               \
      FUNCTION_INLINE(MODULE_TYPED(Text, View, SUFFIX), Suffix,                \
                      (MODULE_TYPED(Text, View, SUFFIX) view, size_t count), { \
        if (count >= view.size)                                                \
          return view;                                                         \
        return MODULE_FUNC(Text, View, SUFFIX, Create)(                        \
            view.data + (view.size - count), count);                           \
      }),                                                                      \
                                                                               \
      COMPARISON_INLINE(Compare,                                               \
                        (MODULE_TYPED(Text, View, SUFFIX) left,                \
                         MODULE_TYPED(Text, View, SUFFIX) right), {            \
        size_t minLen = left.size < right.size ? left.size : right.size;       \
        for (size_t i = 0U; i < minLen; ++i) {                                 \
          if (left.data[i] < right.data[i])                                    \
            return COMPARISON_CONST(LOWER);                                    \
          if (left.data[i] > right.data[i])                                    \
            return COMPARISON_CONST(HIGHER);                                   \
        }                                                                      \
        if (left.size < right.size)                                            \
          return COMPARISON_CONST(LOWER);                                      \
        if (left.size > right.size)                                            \
          return COMPARISON_CONST(HIGHER);                                     \
        return COMPARISON_CONST(EQUAL);                                        \
      }),                                                                      \
                                                                               \
      PREDICATE_INLINE(Equal,                                                  \
                       (MODULE_TYPED(Text, View, SUFFIX) left,                 \
                        MODULE_TYPED(Text, View, SUFFIX) right), {             \
        if (left.size != right.size)                                           \
          return false;                                                        \
        if (left.size == 0U)                                                   \
          return true;                                                         \
        if (left.data == NULL || right.data == NULL)                           \
          return false;                                                        \
        return memcmp(left.data, right.data, left.size * sizeof(TYPE)) == 0;   \
      }),                                                                      \
                                                                               \
      PREDICATE_INLINE(EqualCStr,                                              \
                       (MODULE_TYPED(Text, View, SUFFIX) view,                 \
                        const TYPE *cstr), {                                   \
        return MODULE_FUNC(Text, View, SUFFIX, Equal)(                         \
            view, MODULE_FUNC(Text, View, SUFFIX, FromCStr)(cstr));            \
      }),                                                                      \
                                                                               \
      OPERATION_INLINE(Find,                                                   \
                       (MODULE_TYPED(Text, View, SUFFIX) view, TYPE needle,    \
                        size_t *outIndex), {                                   \
        if (outIndex == NULL)                                                  \
          return STATUS_CONST(INVALID_ARGUMENT);                               \
        if (view.data == NULL || view.size == 0U)                              \
          return STATUS_CONST(NOT_FOUND);                                      \
        for (size_t i = 0U; i < view.size; ++i) {                              \
          if (view.data[i] == needle) {                                        \
            *outIndex = i;                                                     \
            return STATUS_CONST(SUCCESS);                                      \
          }                                                                    \
        }                                                                      \
        return STATUS_CONST(NOT_FOUND);                                        \
      }),                                                                      \
                                                                               \
      OPERATION_INLINE(FindView,                                               \
                       (MODULE_TYPED(Text, View, SUFFIX) haystack,             \
                        MODULE_TYPED(Text, View, SUFFIX) needle,               \
                        size_t *outIndex), {                                   \
        if (outIndex == NULL)                                                  \
          return STATUS_CONST(INVALID_ARGUMENT);                               \
        if (needle.size == 0U) {                                               \
          *outIndex = 0U;                                                      \
          return STATUS_CONST(SUCCESS);                                        \
        }                                                                      \
        if (haystack.data == NULL || needle.data == NULL ||                    \
            needle.size > haystack.size)                                       \
          return STATUS_CONST(NOT_FOUND);                                      \
        {                                                                      \
          size_t limit = haystack.size - needle.size;                          \
          for (size_t i = 0U; i <= limit; ++i) {                               \
            if (memcmp(haystack.data + i, needle.data,                         \
                       needle.size * sizeof(TYPE)) == 0) {                     \
              *outIndex = i;                                                   \
              return STATUS_CONST(SUCCESS);                                    \
            }                                                                  \
          }                                                                    \
        }                                                                      \
        return STATUS_CONST(NOT_FOUND);                                        \
      }),                                                                      \
                                                                               \
      OPERATION_INLINE(FindCStr,                                               \
                       (MODULE_TYPED(Text, View, SUFFIX) haystack,             \
                        const TYPE *needle, size_t *outIndex), {               \
        return MODULE_FUNC(Text, View, SUFFIX, FindView)(                      \
            haystack, MODULE_FUNC(Text, View, SUFFIX, FromCStr)(needle),       \
            outIndex);                                                         \
      }),                                                                      \
                                                                               \
      PREDICATE_INLINE(StartsWith,                                             \
                       (MODULE_TYPED(Text, View, SUFFIX) view,                 \
                        MODULE_TYPED(Text, View, SUFFIX) prefix), {            \
        if (prefix.size > view.size)                                           \
          return false;                                                        \
        if (prefix.size == 0U)                                                 \
          return true;                                                         \
        if (view.data == NULL || prefix.data == NULL)                          \
          return false;                                                        \
        return memcmp(view.data, prefix.data, prefix.size * sizeof(TYPE)) == 0;\
      }),                                                                      \
                                                                               \
      PREDICATE_INLINE(StartsWithCStr,                                         \
                       (MODULE_TYPED(Text, View, SUFFIX) view,                 \
                        const TYPE *prefix), {                                 \
        return MODULE_FUNC(Text, View, SUFFIX, StartsWith)(                    \
            view, MODULE_FUNC(Text, View, SUFFIX, FromCStr)(prefix));          \
      }),                                                                      \
                                                                               \
      PREDICATE_INLINE(EndsWith,                                               \
                       (MODULE_TYPED(Text, View, SUFFIX) view,                 \
                        MODULE_TYPED(Text, View, SUFFIX) suffix), {            \
        if (suffix.size > view.size)                                           \
          return false;                                                        \
        if (suffix.size == 0U)                                                 \
          return true;                                                         \
        if (view.data == NULL || suffix.data == NULL)                          \
          return false;                                                        \
        return memcmp(view.data + (view.size - suffix.size), suffix.data,      \
                      suffix.size * sizeof(TYPE)) == 0;                        \
      }),                                                                      \
                                                                               \
      PREDICATE_INLINE(EndsWithCStr,                                           \
                       (MODULE_TYPED(Text, View, SUFFIX) view,                 \
                        const TYPE *suffix), {                                 \
        return MODULE_FUNC(Text, View, SUFFIX, EndsWith)(                      \
            view, MODULE_FUNC(Text, View, SUFFIX, FromCStr)(suffix));          \
      })                                                                       \
  )
#endif

#if defined(SUFFIX) && defined(TYPE)
TEMPLATE_Text_View(SUFFIX, TYPE)
#undef SUFFIX
#undef TYPE
#endif
