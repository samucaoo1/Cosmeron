/* View.def - Dual Mode Engine (Zero Duplication) */

#include "../../../Core/Algorithm/Comparison.h"
#include "../../../Core/Module/Module.h"
#include "../Unicode/Codepoint.h"
#include "../Unicode/UTF8.h"
#include "../Impl/Common.inc"

#include <stdbool.h>
#include <stddef.h>
#include <stdint.h>
#include <string.h>

#ifndef TEMPLATE_Text_View
#define TEMPLATE_Text_View(SUFFIX, TYPE)                                       \
  TEMPLATE_WIDTH_STRUCT(Text, View, SUFFIX,                                          \
      FIELDS(                                                                  \
          const TYPE *data;                                                    \
          size_t size;                                                         \
      )                                                                        \
  );                                                                           \
  TEMPLATE_WIDTH_PACKAGE(Text, View, SUFFIX,                                         \
      FUNCTION_INLINE(MODULE_TYPE(Text, PP_OP_CAT2(View, SUFFIX)), Create,                \
                      (const TYPE *data, size_t size), {                       \
        MODULE_TYPE(Text, PP_OP_CAT2(View, SUFFIX)) view;                                 \
        view.data = data;                                                      \
        view.size = size;                                                      \
        return view;                                                           \
      }),                                                                      \
                                                                               \
      FUNCTION_INLINE(MODULE_TYPE(Text, PP_OP_CAT2(View, SUFFIX)), FromCStr,              \
                      (const TYPE *cstr), {                                    \
        MODULE_TYPE(Text, PP_OP_CAT2(View, SUFFIX)) view;                                 \
        size_t len = 0U;                                                       \
        view.data = NULL;                                                      \
        view.size = 0U;                                                        \
        if (cstr == NULL)                                                      \
          return view;                                                         \
        while (cstr[len] != (TYPE)0)                                           \
          len++;                                                               \
        view.data = cstr;                                                      \
        view.size = len;                                                       \
        return view;                                                           \
      }),                                                                      \
                                                                               \
      FUNCTION_INLINE(MODULE_TYPE(Text, PP_OP_CAT2(View, SUFFIX)), Empty, (), {           \
        MODULE_TYPE(Text, PP_OP_CAT2(View, SUFFIX)) view;                                 \
        view.data = NULL;                                                      \
        view.size = 0U;                                                        \
        return view;                                                           \
      }),                                                                      \
                                                                               \
      FUNCTION_INLINE(size_t, Length,                                          \
                      (MODULE_TYPE(Text, PP_OP_CAT2(View, SUFFIX)) view), {               \
        return view.size;                                                      \
      }),                                                                      \
                                                                               \
      PREDICATE_INLINE(IsEmpty,                                                \
                       (MODULE_TYPE(Text, PP_OP_CAT2(View, SUFFIX)) view), {              \
        return view.size == 0U || view.data == NULL;                           \
      }),                                                                      \
                                                                               \
      FUNCTION_INLINE(const TYPE *, Data,                                      \
                      (MODULE_TYPE(Text, PP_OP_CAT2(View, SUFFIX)) view), {               \
        return view.data;                                                      \
      }),                                                                      \
                                                                               \
      OPERATION_INLINE(At,                                                     \
                       (MODULE_TYPE(Text, PP_OP_CAT2(View, SUFFIX)) view, size_t index,   \
                        TYPE *outChar), {                                      \
        if (outChar == NULL)                                                   \
          return STATUS_CONST(INVALID_ARGUMENT);                               \
        if (index >= view.size || view.data == NULL)                           \
          return STATUS_CONST(OUT_OF_RANGE);                                   \
        *outChar = view.data[index];                                           \
        return STATUS_CONST(SUCCESS);                                          \
      }),                                                                      \
                                                                               \
      FUNCTION_INLINE(MODULE_TYPE(Text, PP_OP_CAT2(View, SUFFIX)), Slice,                 \
                      (MODULE_TYPE(Text, PP_OP_CAT2(View, SUFFIX)) view, size_t start,    \
                       size_t count), {                                        \
        if (start >= view.size || view.data == NULL)                           \
          return MODULE_FUNC(Text, PP_OP_CAT2(View, SUFFIX), Empty)();                     \
        {                                                                      \
          size_t available = view.size - start;                                \
          size_t actual = count < available ? count : available;               \
          return MODULE_FUNC(Text, PP_OP_CAT2(View, SUFFIX), Create)(view.data + start,    \
                                                         actual);              \
        }                                                                      \
      }),                                                                      \
                                                                               \
      FUNCTION_INLINE(MODULE_TYPE(Text, PP_OP_CAT2(View, SUFFIX)), Prefix,                \
                      (MODULE_TYPE(Text, PP_OP_CAT2(View, SUFFIX)) view, size_t count), { \
        return MODULE_FUNC(Text, PP_OP_CAT2(View, SUFFIX), Slice)(view, 0U, count);        \
      }),                                                                      \
                                                                               \
      FUNCTION_INLINE(MODULE_TYPE(Text, PP_OP_CAT2(View, SUFFIX)), Suffix,                \
                      (MODULE_TYPE(Text, PP_OP_CAT2(View, SUFFIX)) view, size_t count), { \
        if (count >= view.size)                                                \
          return view;                                                         \
        return MODULE_FUNC(Text, PP_OP_CAT2(View, SUFFIX), Create)(                        \
            view.data + (view.size - count), count);                           \
      }),                                                                      \
                                                                               \
      COMPARISON_INLINE(Compare,                                               \
                        (MODULE_TYPE(Text, PP_OP_CAT2(View, SUFFIX)) left,                \
                         MODULE_TYPE(Text, PP_OP_CAT2(View, SUFFIX)) right), {            \
        size_t minLen = left.size < right.size ? left.size : right.size;       \
        for (size_t i = 0U; i < minLen; ++i) {                                 \
          if (left.data[i] < right.data[i])                                    \
            return COMPARISON_CONST(LOWER);                                    \
          if (left.data[i] > right.data[i])                                    \
            return COMPARISON_CONST(HIGHER);                                   \
        }                                                                      \
        if (left.size < right.size)                                            \
          return COMPARISON_CONST(LOWER);                                      \
        if (left.size > right.size)                                            \
          return COMPARISON_CONST(HIGHER);                                     \
        return COMPARISON_CONST(EQUAL);                                        \
      }),                                                                      \
                                                                               \
      VARIANT(Equal,                                                           \
        PREDICATE_INLINE((MODULE_TYPE(Text, PP_OP_CAT2(View, SUFFIX)) left,               \
                          MODULE_TYPE(Text, PP_OP_CAT2(View, SUFFIX)) right), {           \
          if (left.size != right.size)                                         \
            return false;                                                      \
          if (left.size == 0U)                                                 \
            return true;                                                       \
          if (left.data == NULL || right.data == NULL)                         \
            return false;                                                      \
          return memcmp(left.data, right.data,                                 \
                        left.size * sizeof(TYPE)) == 0;                        \
        }),                                                                    \
        PREDICATE_INLINE(CStr, (MODULE_TYPE(Text, PP_OP_CAT2(View, SUFFIX)) view,         \
                                const TYPE *cstr), {                           \
          return MODULE_FUNC(Text, PP_OP_CAT2(View, SUFFIX), Equal)(                       \
              view, MODULE_FUNC(Text, PP_OP_CAT2(View, SUFFIX), FromCStr)(cstr));          \
        })                                                                     \
      ),                                                                       \
                                                                               \
      VARIANT(Find,                                                            \
        OPERATION_INLINE((MODULE_TYPE(Text, PP_OP_CAT2(View, SUFFIX)) view, TYPE needle,  \
                          size_t *outIndex), {                                 \
          if (outIndex == NULL)                                                \
            return STATUS_CONST(INVALID_ARGUMENT);                             \
          if (view.data == NULL || view.size == 0U)                            \
            return STATUS_CONST(NOT_FOUND);                                    \
          for (size_t i = 0U; i < view.size; ++i) {                            \
            if (view.data[i] == needle) {                                      \
              *outIndex = i;                                                   \
              return STATUS_CONST(SUCCESS);                                    \
            }                                                                  \
          }                                                                    \
          return STATUS_CONST(NOT_FOUND);                                      \
        }),                                                                    \
        OPERATION_INLINE(View,                                                 \
                         (MODULE_TYPE(Text, PP_OP_CAT2(View, SUFFIX)) haystack,           \
                          MODULE_TYPE(Text, PP_OP_CAT2(View, SUFFIX)) needle,             \
                          size_t *outIndex), {                                 \
          if (outIndex == NULL)                                                \
            return STATUS_CONST(INVALID_ARGUMENT);                             \
          if (needle.size == 0U) {                                             \
            *outIndex = 0U;                                                    \
            return STATUS_CONST(SUCCESS);                                      \
          }                                                                    \
          if (haystack.data == NULL || needle.data == NULL ||                  \
              needle.size > haystack.size)                                     \
            return STATUS_CONST(NOT_FOUND);                                    \
          {                                                                    \
            size_t limit = haystack.size - needle.size;                        \
            for (size_t i = 0U; i <= limit; ++i) {                             \
              if (memcmp(haystack.data + i, needle.data,                       \
                         needle.size * sizeof(TYPE)) == 0) {                   \
                *outIndex = i;                                                 \
                return STATUS_CONST(SUCCESS);                                  \
              }                                                                \
            }                                                                  \
          }                                                                    \
          return STATUS_CONST(NOT_FOUND);                                      \
        }),                                                                    \
        OPERATION_INLINE(CStr,                                                 \
                         (MODULE_TYPE(Text, PP_OP_CAT2(View, SUFFIX)) haystack,           \
                          const TYPE *needle, size_t *outIndex), {             \
          return MODULE_FUNC(Text, PP_OP_CAT2(View, SUFFIX), FindView)(                    \
              haystack, MODULE_FUNC(Text, PP_OP_CAT2(View, SUFFIX), FromCStr)(needle),     \
              outIndex);                                                       \
        })                                                                     \
      ),                                                                       \
                                                                               \
      VARIANT(StartsWith,                                                      \
        PREDICATE_INLINE((MODULE_TYPE(Text, PP_OP_CAT2(View, SUFFIX)) view,               \
                          MODULE_TYPE(Text, PP_OP_CAT2(View, SUFFIX)) prefix), {          \
          if (prefix.size > view.size)                                         \
            return false;                                                      \
          if (prefix.size == 0U)                                               \
            return true;                                                       \
          if (view.data == NULL || prefix.data == NULL)                        \
            return false;                                                      \
          return memcmp(view.data, prefix.data,                                \
                        prefix.size * sizeof(TYPE)) == 0;                      \
        }),                                                                    \
        PREDICATE_INLINE(CStr, (MODULE_TYPE(Text, PP_OP_CAT2(View, SUFFIX)) view,         \
                                const TYPE *prefix), {                         \
          return MODULE_FUNC(Text, PP_OP_CAT2(View, SUFFIX), StartsWith)(                  \
              view, MODULE_FUNC(Text, PP_OP_CAT2(View, SUFFIX), FromCStr)(prefix));        \
        })                                                                     \
      ),                                                                       \
                                                                               \
      VARIANT(EndsWith,                                                        \
        PREDICATE_INLINE((MODULE_TYPE(Text, PP_OP_CAT2(View, SUFFIX)) view,               \
                          MODULE_TYPE(Text, PP_OP_CAT2(View, SUFFIX)) suffix), {          \
          if (suffix.size > view.size)                                         \
            return false;                                                      \
          if (suffix.size == 0U)                                               \
            return true;                                                       \
          if (view.data == NULL || suffix.data == NULL)                        \
            return false;                                                      \
          return memcmp(view.data + (view.size - suffix.size), suffix.data,    \
                        suffix.size * sizeof(TYPE)) == 0;                      \
        }),                                                                    \
        PREDICATE_INLINE(CStr, (MODULE_TYPE(Text, PP_OP_CAT2(View, SUFFIX)) view,         \
                                const TYPE *suffix), {                         \
          return MODULE_FUNC(Text, PP_OP_CAT2(View, SUFFIX), EndsWith)(                    \
              view, MODULE_FUNC(Text, PP_OP_CAT2(View, SUFFIX), FromCStr)(suffix));        \
        })                                                                     \
      )                                                                        \
  )
#endif

#if (!defined(COSMERON_INTERNAL_NO_AUTO_INSTANTIATE) && !defined(COSMERON_INTERNAL_IN_COMMON_INC)) && defined(SUFFIX) && defined(TYPE)
TEMPLATE_Text_View(SUFFIX, TYPE);
#undef SUFFIX
#undef TYPE
#endif

/* EOF */
