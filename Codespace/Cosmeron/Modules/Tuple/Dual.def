/* Dual.def - Dual Mode Engine (Zero Duplication) */

#include "Impl/Common.inc"

#ifndef TEMPLATE_Tuple_Dual
#define TEMPLATE_Tuple_Dual(SUFFIX, TYPE)                                      \
  TEMPLATE_STRUCT(Tuple, Dual, SUFFIX,                                         \
      FIELDS(                                                                  \
          union {                                                              \
            struct {                                                           \
              union {                                                          \
                TYPE value1; TYPE a; TYPE x1; TYPE x; TYPE col;                \
                TYPE length; TYPE real; TYPE state1; TYPE begin;               \
                TYPE first; TYPE start;                                        \
              };                                                               \
              union {                                                          \
                TYPE value2; TYPE b; TYPE x2; TYPE y; TYPE row;                \
                TYPE width; TYPE imaginary; TYPE state2; TYPE end;             \
                TYPE second; TYPE last;                                        \
              };                                                               \
            };                                                                 \
            union { TYPE value[2]; TYPE values[2]; };                          \
          };                                                                   \
      )                                                                        \
  );                                                                           \
  TEMPLATE_PACKAGE(Tuple, Dual, SUFFIX,                                        \
      FUNCTION_INLINE(MODULE_TYPED(Tuple, Dual, SUFFIX), Pack,                 \
                      (TYPE first, TYPE second), {                             \
        MODULE_TYPED(Tuple, Dual, SUFFIX) tuple;                               \
        tuple.value1 = first;                                                  \
        tuple.value2 = second;                                                 \
        return tuple;                                                          \
      }),                                                                      \
      OPERATION_INLINE(Unpack,                                                 \
                       (MODULE_TYPED(Tuple, Dual, SUFFIX) tuple,               \
                        TYPE *outFirst, TYPE *outSecond), {                    \
        if (!outFirst || !outSecond) {                                         \
          return STATUS_CONST(INVALID_ARGUMENT);                               \
        }                                                                      \
        *outFirst = tuple.value1;                                              \
        *outSecond = tuple.value2;                                             \
        return STATUS_CONST(SUCCESS);                                          \
      })                                                                       \
  )
#endif

/* Mode 2 (Direct Include): Auto-instantiates and cleans up environment */
#if (!defined(COSMERON_INTERNAL_NO_AUTO_INSTANTIATE) && !defined(COSMERON_INTERNAL_IN_COMMON_INC)) && defined(SUFFIX) && defined(TYPE)
  TEMPLATE_Tuple_Dual(SUFFIX, TYPE);
  #undef SUFFIX
  #undef TYPE
#endif

/* EOF */
