/* Penta.def - Dual Mode Engine (Zero Duplication) */

#include "Impl/Common.inc"

#ifndef TEMPLATE_Tuple_Penta
#define TEMPLATE_Tuple_Penta(SUFFIX, TYPE)                                     \
  TEMPLATE_STRUCT(Tuple, Penta, SUFFIX,                                        \
      FIELDS(                                                                  \
          union {                                                              \
            struct {                                                           \
              union { TYPE value1; TYPE first; TYPE a; };                      \
              union { TYPE value2; TYPE second; TYPE b; };                     \
              union { TYPE value3; TYPE third; TYPE c; };                      \
              union { TYPE value4; TYPE fourth; TYPE d; };                     \
              union { TYPE value5; TYPE fifth; TYPE e; };                      \
            };                                                                 \
            union { TYPE value[5]; TYPE values[5]; };                          \
          };                                                                   \
      )                                                                        \
  );                                                                           \
  TEMPLATE_PACKAGE(Tuple, Penta, SUFFIX,                                       \
      FUNCTION_INLINE(MODULE_TYPED(Tuple, Penta, SUFFIX), Pack,                \
                      (TYPE first, TYPE second, TYPE third, TYPE fourth,       \
                       TYPE fifth), {                                          \
        MODULE_TYPED(Tuple, Penta, SUFFIX) tuple;                              \
        tuple.value1 = first;                                                  \
        tuple.value2 = second;                                                 \
        tuple.value3 = third;                                                  \
        tuple.value4 = fourth;                                                 \
        tuple.value5 = fifth;                                                  \
        return tuple;                                                          \
      }),                                                                      \
      OPERATION_INLINE(Unpack,                                                 \
                       (MODULE_TYPED(Tuple, Penta, SUFFIX) tuple,              \
                        TYPE *outFirst, TYPE *outSecond, TYPE *outThird,       \
                        TYPE *outFourth, TYPE *outFifth), {                    \
        if (!outFirst || !outSecond || !outThird || !outFourth || !outFifth) { \
          return STATUS_CONST(INVALID_ARGUMENT);                               \
        }                                                                      \
        *outFirst = tuple.value1;                                              \
        *outSecond = tuple.value2;                                             \
        *outThird = tuple.value3;                                              \
        *outFourth = tuple.value4;                                             \
        *outFifth = tuple.value5;                                              \
        return STATUS_CONST(SUCCESS);                                          \
      })                                                                       \
  )
#endif

/* Mode 2 (Direct Include): Auto-instantiates and cleans up environment */
#if (!defined(COSMERON_INTERNAL_NO_AUTO_INSTANTIATE) && !defined(COSMERON_INTERNAL_IN_COMMON_INC)) && defined(SUFFIX) && defined(TYPE)
  TEMPLATE_Tuple_Penta(SUFFIX, TYPE);
  #undef SUFFIX
  #undef TYPE
#endif

/* EOF */
