/* Triple.def - Dual Mode Engine (Zero Duplication) */

#include "Impl/Common.inc"

#ifndef TEMPLATE_Tuple_Triple
#define TEMPLATE_Tuple_Triple(SUFFIX, TYPE)                                    \
  TEMPLATE_STRUCT(Tuple, Triple, SUFFIX,                                       \
      FIELDS(                                                                  \
          union {                                                              \
            struct {                                                           \
              union { TYPE value1; TYPE first; TYPE a; TYPE x1; TYPE x; TYPE length; TYPE red; }; \
              union { TYPE value2; TYPE second; TYPE b; TYPE x2; TYPE y; TYPE width; TYPE green; }; \
              union { TYPE value3; TYPE third; TYPE c; TYPE x3; TYPE z; TYPE height; TYPE blue; }; \
            };                                                                 \
            union { TYPE value[3]; TYPE values[3]; };                          \
          };                                                                   \
      )                                                                        \
  );                                                                           \
  TEMPLATE_PACKAGE(Tuple, Triple, SUFFIX,                                      \
      FUNCTION_INLINE(MODULE_TYPED(Tuple, Triple, SUFFIX), Pack,               \
                      (TYPE first, TYPE second, TYPE third), {                 \
        MODULE_TYPED(Tuple, Triple, SUFFIX) tuple;                             \
        tuple.value1 = first;                                                  \
        tuple.value2 = second;                                                 \
        tuple.value3 = third;                                                  \
        return tuple;                                                          \
      }),                                                                      \
      OPERATION_INLINE(Unpack,                                                 \
                       (MODULE_TYPED(Tuple, Triple, SUFFIX) tuple,             \
                        TYPE *outFirst, TYPE *outSecond, TYPE *outThird), {    \
        if (!outFirst || !outSecond || !outThird) {                            \
          return STATUS_CONST(INVALID_ARGUMENT);                               \
        }                                                                      \
        *outFirst = tuple.value1;                                              \
        *outSecond = tuple.value2;                                             \
        *outThird = tuple.value3;                                              \
        return STATUS_CONST(SUCCESS);                                          \
      })                                                                       \
  )
#endif

/* Mode 2 (Direct Include): Auto-instantiates and cleans up environment */
#if (!defined(COSMERON_INTERNAL_NO_AUTO_INSTANTIATE) && !defined(COSMERON_INTERNAL_IN_COMMON_INC)) && defined(SUFFIX) && defined(TYPE)
  TEMPLATE_Tuple_Triple(SUFFIX, TYPE);
  #undef SUFFIX
  #undef TYPE
#endif

/* EOF */
