#pragma once

#define DATA_TYPE_IMPLEMENT_BIT_SET(TYPE, PROTOTYPE, STRUCT_NAME, SUFFIX)  \
  PROTOTYPE {                                                               \
    if (!target)                                                               \
      return STATUS_CONST(INVALID_ARGUMENT);                                   \
    const size_t bitsPerLimb = sizeof(target->limb[0]) * 8U;                   \
    const size_t limbIndex = bit / bitsPerLimb;                                \
    const uint8_t intraBit = (uint8_t)(bit % bitsPerLimb);                                 \
    if (limbIndex >= sizeof(target->limb) / sizeof(target->limb[0]))            \
      return STATUS_CONST(OUT_OF_RANGE);                                       \
    BIT_FUNC(SUFFIX, Set)(&target->limb[limbIndex], intraBit);                  \
    return STATUS_CONST(SUCCESS);                                              \
  }

#define DATA_TYPE_IMPLEMENT_BIT_CLEAR(TYPE, PROTOTYPE, STRUCT_NAME,        \
                                      SUFFIX)                                  \
  PROTOTYPE {                                                               \
    if (!target)                                                               \
      return STATUS_CONST(INVALID_ARGUMENT);                                   \
    const size_t bitsPerLimb = sizeof(target->limb[0]) * 8U;                   \
    const size_t limbIndex = bit / bitsPerLimb;                                \
    const uint8_t intraBit = (uint8_t)(bit % bitsPerLimb);                                 \
    if (limbIndex >= sizeof(target->limb) / sizeof(target->limb[0]))            \
      return STATUS_CONST(OUT_OF_RANGE);                                       \
    BIT_FUNC(SUFFIX, Clear)(&target->limb[limbIndex], intraBit);                \
    return STATUS_CONST(SUCCESS);                                              \
  }

#define DATA_TYPE_IMPLEMENT_BIT_CHECK(TYPE, PROTOTYPE, STRUCT_NAME,        \
                                      SUFFIX)                                  \
  PROTOTYPE {                                                               \
    if (!target || !outResult)                                                    \
      return STATUS_CONST(INVALID_ARGUMENT);                                   \
    const size_t bitsPerLimb = sizeof(target->limb[0]) * 8U;                   \
    const size_t limbIndex = bit / bitsPerLimb;                                \
    const uint8_t intraBit = (uint8_t)(bit % bitsPerLimb);                                 \
    if (limbIndex >= sizeof(target->limb) / sizeof(target->limb[0]))            \
      return STATUS_CONST(OUT_OF_RANGE);                                       \
    *outResult = BIT_FUNC(SUFFIX, Check)(target->limb[limbIndex], intraBit);      \
    return STATUS_CONST(SUCCESS);                                              \
  }
/* EOF */
