#pragma once

#include <string.h>

#define DATA_TYPE_IMPLEMENT_CLEAR(TYPE, PROTOTYPE, STRUCT_NAME)            \
  PROTOTYPE {                                                               \
    if (!target) \
      return STATUS_CONST(INVALID_ARGUMENT); \
    memset(target->byte, 0, sizeof(target->byte));                             \
    return STATUS_CONST(SUCCESS); \
  }

#define DATA_TYPE_IMPLEMENT_INIT(TYPE, PROTOTYPE, CLEAR_FUNC, STRUCT_NAME) \
  PROTOTYPE {                                                               \
    return CLEAR_FUNC(target);                                                 \
  }
/* EOF */
