#pragma once

#include <limits.h>
#include <string.h>

#define DATA_TYPE_IMPLEMENT_SHIFT_LEFT(TYPE, FUNCTION_NAME, STRUCT_NAME)       \
  static inline OPSTATUS FUNCTION_NAME(STRUCT_NAME *target, unsigned bitCount) {  \
    if (!target) \
      return STATUS_CONST(INVALID_ARGUMENT); \
    const size_t limbCount = sizeof(target->limb) / sizeof(target->limb[0]);  \
    const size_t bitsPerLimb = sizeof(target->limb[0]) * 8;                  \
    const size_t totalBitCapacity = limbCount * bitsPerLimb;              \
    if (bitCount >= totalBitCapacity) {                                     \
      memset(target->byte, 0, sizeof(target->byte));                           \
      return STATUS_CONST(SUCCESS); \
    } \
    const size_t wholeLimbShift = bitCount / bitsPerLimb;                 \
    const size_t intraLimbShift = bitCount % bitsPerLimb;                 \
    if (wholeLimbShift > 0) {                                                \
      for (size_t i = limbCount; i-- > wholeLimbShift;)                     \
        target->limb[i] = target->limb[i - wholeLimbShift];                  \
      memset(target->limb, 0, wholeLimbShift * sizeof(target->limb[0]));     \
    } \
    if (intraLimbShift > 0) {                                                \
      for (size_t i = limbCount; i-- > 1;)                                    \
        target->limb[i] = (target->limb[i] << intraLimbShift) |              \
                          (target->limb[i - 1] >>                              \
                           (bitsPerLimb - intraLimbShift));                \
      target->limb[0] <<= intraLimbShift;                                    \
    } \
    return STATUS_CONST(SUCCESS); \
  }

#define DATA_TYPE_IMPLEMENT_SHIFT_RIGHT(TYPE, FUNCTION_NAME, STRUCT_NAME)      \
  static inline OPSTATUS FUNCTION_NAME(STRUCT_NAME *target, unsigned bitCount) {  \
    if (!target) \
      return STATUS_CONST(INVALID_ARGUMENT); \
    const size_t limbCount = sizeof(target->limb) / sizeof(target->limb[0]);  \
    const size_t bitsPerLimb = sizeof(target->limb[0]) * 8;                  \
    const size_t totalBitCapacity = limbCount * bitsPerLimb;              \
    if (bitCount >= totalBitCapacity) {                                     \
      memset(target->byte, 0, sizeof(target->byte));                           \
      return STATUS_CONST(SUCCESS); \
    } \
    const size_t wholeLimbShift = bitCount / bitsPerLimb;                 \
    const size_t intraLimbShift = bitCount % bitsPerLimb;                 \
    if (wholeLimbShift > 0) {                                                \
      for (size_t i = 0; i < limbCount - wholeLimbShift; ++i)               \
        target->limb[i] = target->limb[i + wholeLimbShift];                  \
      memset(&target->limb[limbCount - wholeLimbShift], 0,                  \
             wholeLimbShift * sizeof(target->limb[0]));                      \
    } \
    if (intraLimbShift > 0) {                                                \
      for (size_t i = 0; i < limbCount - 1; ++i)                              \
        target->limb[i] = (target->limb[i] >> intraLimbShift) |              \
                          (target->limb[i + 1]                                 \
                           << (bitsPerLimb - intraLimbShift));             \
      target->limb[limbCount - 1] >>= intraLimbShift;                       \
    } \
    return STATUS_CONST(SUCCESS); \
  }
#define DATA_TYPE_IMPLEMENT_ROTATE_LEFT(TYPE, FUNCTION_NAME, STRUCT_NAME,      \
                                        SHIFT_LEFT_FUNC, SHIFT_RIGHT_FUNC)     \
  static inline OPSTATUS FUNCTION_NAME(STRUCT_NAME *target, unsigned shift) {      \
    if (!target) \
      return STATUS_CONST(INVALID_ARGUMENT); \
    const size_t totalBits =                                                  \
        (sizeof(target->limb) / sizeof(target->limb[0])) *                     \
        sizeof(target->limb[0]) * 8U;                                          \
    if (totalBits > (size_t)UINT_MAX)                                          \
      return STATUS_CONST(OUT_OF_RANGE);                                       \
    const unsigned totalBitsValue = (unsigned)totalBits;                       \
    if (shift == 0U || shift % totalBitsValue == 0U)                           \
      return STATUS_CONST(SUCCESS);                                            \
    shift %= totalBitsValue;                                                   \
    STRUCT_NAME temp = *target;                                                \
    SHIFT_LEFT_FUNC(target, shift);                                            \
    SHIFT_RIGHT_FUNC(&temp, totalBitsValue - shift);                               \
    const size_t limbCount = \
        sizeof(target->limb) / sizeof(target->limb[0]);                        \
    for (size_t i = 0; i < limbCount; ++i)                                    \
      target->limb[i] |= temp.limb[i];                                         \
    return STATUS_CONST(SUCCESS); \
  }

#define DATA_TYPE_IMPLEMENT_ROTATE_RIGHT(TYPE, FUNCTION_NAME, STRUCT_NAME,      \
                                         SHIFT_LEFT_FUNC, SHIFT_RIGHT_FUNC)    \
  static inline OPSTATUS FUNCTION_NAME(STRUCT_NAME *target, unsigned shift) {      \
    if (!target) \
      return STATUS_CONST(INVALID_ARGUMENT); \
    const size_t totalBits =                                                  \
        (sizeof(target->limb) / sizeof(target->limb[0])) *                     \
        sizeof(target->limb[0]) * 8U;                                          \
    if (totalBits > (size_t)UINT_MAX)                                          \
      return STATUS_CONST(OUT_OF_RANGE);                                       \
    const unsigned totalBitsValue = (unsigned)totalBits;                       \
    if (shift == 0U || shift % totalBitsValue == 0U)                           \
      return STATUS_CONST(SUCCESS);                                            \
    shift %= totalBitsValue;                                                   \
    STRUCT_NAME temp = *target;                                                \
    SHIFT_RIGHT_FUNC(target, shift);                                           \
    SHIFT_LEFT_FUNC(&temp, totalBitsValue - shift);                                \
    const size_t limbCount = \
        sizeof(target->limb) / sizeof(target->limb[0]);                        \
    for (size_t i = 0; i < limbCount; ++i)                                    \
      target->limb[i] |= temp.limb[i];                                         \
    return STATUS_CONST(SUCCESS); \
  }
/* EOF */
