#pragma once

#define TBIGINT_IMPLEMENT(SUFFIX, TYPE)                                        \
  DATA_TYPE_IMPLEMENT_CLEAR(TYPE, TBIGINT_CLEAR_PROTOTYPE(SUFFIX),                 \
                            TBIGINT_TYPE(SUFFIX))                              \
  DATA_TYPE_IMPLEMENT_INIT(TYPE, TBIGINT_INIT_PROTOTYPE(SUFFIX),                   \
                           TBIGINT_CLEAR_PROTOTYPE(SUFFIX), TBIGINT_TYPE(SUFFIX))    \
  DATA_TYPE_IMPLEMENT_ADD(TYPE, TBIGINT_ADD_PROTOTYPE(SUFFIX), TBIGINT_TYPE(SUFFIX)) \
  DATA_TYPE_IMPLEMENT_SUB(TYPE, TBIGINT_SUB_PROTOTYPE(SUFFIX), TBIGINT_TYPE(SUFFIX)) \
  DATA_TYPE_IMPLEMENT_AND(TYPE, TBIGINT_AND_PROTOTYPE(SUFFIX), TBIGINT_TYPE(SUFFIX)) \
  DATA_TYPE_IMPLEMENT_OR(TYPE, TBIGINT_OR_PROTOTYPE(SUFFIX), TBIGINT_TYPE(SUFFIX))   \
  DATA_TYPE_IMPLEMENT_XOR(TYPE, TBIGINT_XOR_PROTOTYPE(SUFFIX), TBIGINT_TYPE(SUFFIX)) \
  DATA_TYPE_IMPLEMENT_NOT(TYPE, TBIGINT_NOT_PROTOTYPE(SUFFIX), TBIGINT_TYPE(SUFFIX)) \
  DATA_TYPE_IMPLEMENT_SHIFT_LEFT(TYPE, TBIGINT_SHIFT_LEFT_PROTOTYPE(SUFFIX),          \
                                  TBIGINT_TYPE(SUFFIX))                        \
  DATA_TYPE_IMPLEMENT_SHIFT_RIGHT(TYPE, TBIGINT_SHIFT_RIGHT_PROTOTYPE(SUFFIX),      \
                                   TBIGINT_TYPE(SUFFIX))                       \
  DATA_TYPE_IMPLEMENT_ROTATE_LEFT(TYPE, TBIGINT_ROTATE_LEFT_PROTOTYPE(SUFFIX),      \
                                  TBIGINT_TYPE(SUFFIX),                        \
                                  TBIGINT_FUNC(SUFFIX, ShiftLeft),             \
                                  TBIGINT_FUNC(SUFFIX, ShiftRight))            \
  DATA_TYPE_IMPLEMENT_ROTATE_RIGHT(TYPE, TBIGINT_ROTATE_RIGHT_PROTOTYPE(SUFFIX),    \
                                   TBIGINT_TYPE(SUFFIX),                       \
                                   TBIGINT_SHIFT_LEFT_PROTOTYPE(SUFFIX),            \
                                   TBIGINT_SHIFT_RIGHT_PROTOTYPE(SUFFIX))           \
  DATA_TYPE_IMPLEMENT_BIT_SET(TYPE, TBIGINT_BIT_SET_PROTOTYPE(SUFFIX),              \
                              TBIGINT_TYPE(SUFFIX), 64)                        \
  DATA_TYPE_IMPLEMENT_BIT_CLEAR(TYPE, TBIGINT_BIT_CLEAR_PROTOTYPE(SUFFIX),          \
                                TBIGINT_TYPE(SUFFIX), 64)                      \
  DATA_TYPE_IMPLEMENT_BIT_CHECK(TYPE, TBIGINT_BIT_CHECK_PROTOTYPE(SUFFIX),          \
                                TBIGINT_TYPE(SUFFIX), 64)                      \
  DATA_TYPE_IMPLEMENT_MUL(TYPE, TBIGINT_MUL_PROTOTYPE(SUFFIX),                       \
                           TBIGINT_TYPE(SUFFIX), TBIGINT_FUNC(SUFFIX, Add),          \
                           TBIGINT_FUNC(SUFFIX, ShiftLeft))                       \
  DATA_TYPE_IMPLEMENT_DIV_MOD(TYPE, TBIGINT_INS(SUFFIX, DivMod),                \
                              TBIGINT_TYPE(SUFFIX), TBIGINT_FUNC(SUFFIX, IsZero),     \
                              TBIGINT_FUNC(SUFFIX, Compare), TBIGINT_FUNC(SUFFIX, Sub), \
                              TBIGINT_FUNC(SUFFIX, ShiftLeft))                    \
  TBIGINT_DIV_MOD_PROTOTYPE(SUFFIX) {                                           \
    if (!outQuotient || !outRemainder)                                         \
      return STATUS_CONST(INVALID_ARGUMENT);                                   \
    return TBIGINT_INS(SUFFIX, DivMod)(                                        \
        dividend, divisor, outQuotient, outRemainder);                         \
  }                                                                            \
  TBIGINT_DIV_PROTOTYPE(SUFFIX) {         \
    if (!dividendBigint || !divisorBigint)                                                 \
      return STATUS_CONST(INVALID_ARGUMENT);                                   \
    TBIGINT_TYPE(SUFFIX) quotient;                                                \
    OPSTATUS status = TBIGINT_INS(SUFFIX, DivMod)(dividendBigint, divisorBigint, &quotient, NULL); \
    if (status == STATUS_CONST(SUCCESS))                                       \
      for (size_t i = 0; i < sizeof(dividendBigint->limb) / sizeof(dividendBigint->limb[0]); ++i) \
      dividendBigint->limb[i] = quotient.limb[i];                                                    \
    return status;                                                             \
  }                                                                            \
  TBIGINT_MOD_PROTOTYPE(SUFFIX) {         \
    if (!dividendBigint || !divisorBigint)                                                 \
      return STATUS_CONST(INVALID_ARGUMENT);                                   \
    TBIGINT_TYPE(SUFFIX) remainder;                                               \
    OPSTATUS status = TBIGINT_INS(SUFFIX, DivMod)(dividendBigint, divisorBigint, NULL, &remainder); \
    if (status == STATUS_CONST(SUCCESS))                                       \
      for (size_t i = 0; i < sizeof(dividendBigint->limb) / sizeof(dividendBigint->limb[0]); ++i) \
      dividendBigint->limb[i] = remainder.limb[i];                                                   \
    return status;                                                             \
  }                                                                            \
  DATA_TYPE_IMPLEMENT_INCREMENT(TYPE, TBIGINT_INCREMENT_PROTOTYPE(SUFFIX),         \
                                TBIGINT_TYPE(SUFFIX))                          \
  DATA_TYPE_IMPLEMENT_DECREMENT(TYPE, TBIGINT_DECREMENT_PROTOTYPE(SUFFIX),         \
                                TBIGINT_TYPE(SUFFIX))                          \
  DATA_TYPE_IMPLEMENT_COMPARE(TYPE, TBIGINT_FUNC(SUFFIX, Compare),             \
                              TBIGINT_TYPE(SUFFIX))                            \
  DATA_TYPE_IMPLEMENT_EQUAL(TYPE, TBIGINT_FUNC(SUFFIX, Equal),                 \
                            TBIGINT_TYPE(SUFFIX))                              \
  DATA_TYPE_IMPLEMENT_NOT_EQUAL(TYPE, TBIGINT_NOT_EQUAL_PROTOTYPE(SUFFIX),           \
                               TBIGINT_FUNC(SUFFIX, Equal),                    \
                               TBIGINT_TYPE(SUFFIX))                           \
  DATA_TYPE_IMPLEMENT_LESS_THAN(TYPE, TBIGINT_LESS_THAN_PROTOTYPE(SUFFIX),           \
                               TBIGINT_FUNC(SUFFIX, Compare),                  \
                               TBIGINT_TYPE(SUFFIX))                           \
  DATA_TYPE_IMPLEMENT_GREATER_THAN(TYPE, TBIGINT_GREATER_THAN_PROTOTYPE(SUFFIX),     \
                                  TBIGINT_FUNC(SUFFIX, Compare),               \
                                  TBIGINT_TYPE(SUFFIX))                        \
  DATA_TYPE_IMPLEMENT_LESS_OR_EQUAL(TYPE, TBIGINT_LESS_OR_EQUAL_PROTOTYPE(SUFFIX),     \
                                  TBIGINT_FUNC(SUFFIX, Compare),               \
                                  TBIGINT_TYPE(SUFFIX))                        \
  DATA_TYPE_IMPLEMENT_GREATER_OR_EQUAL(TYPE,                                     \
                                     TBIGINT_GREATER_OR_EQUAL_PROTOTYPE(SUFFIX),     \
                                     TBIGINT_FUNC(SUFFIX, Compare),            \
                                     TBIGINT_TYPE(SUFFIX))                     \
  DATA_TYPE_IMPLEMENT_IS_ZERO(TYPE, TBIGINT_IS_ZERO_PROTOTYPE(SUFFIX),               \
                             TBIGINT_TYPE(SUFFIX)) \
  DATA_TYPE_IMPLEMENT_TO_CSTRING_BASE(TYPE, TBIGINT_FUNC(SUFFIX, ToCStringBase), \
                                       TBIGINT_TYPE(SUFFIX),                      \
                                       TBIGINT_FUNC(SUFFIX, IsZero)) \
  DATA_TYPE_IMPLEMENT_TO_CSTRING(TYPE, TBIGINT_TO_CSTRING_PROTOTYPE(SUFFIX),          \
                                  TBIGINT_FUNC(SUFFIX, ToCStringBase),            \
                                  TBIGINT_TYPE(SUFFIX))
/* EOF */
