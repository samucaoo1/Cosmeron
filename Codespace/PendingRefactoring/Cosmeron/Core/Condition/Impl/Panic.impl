#pragma once

#include <stdio.h>
#include <stdlib.h>

static _Thread_local PANIC_HANDLER_CALLBACK PANIC_INS(CustomHandler) = {0};

PACKAGE_FUNCTION_IMPLEMENT_EX(LIB_PREFIX(Condition_Panic), const char *, KindName,
                              (PANIC_TYPE(Kind) kind)) {
  switch (kind) {
  case PANIC_CONST(KIND_ASSERT):
    return "ASSERT";
  case PANIC_CONST(KIND_VERIFY):
    return "VERIFY";
  case PANIC_CONST(KIND_ENSURE):
    return "ENSURE";
  case PANIC_CONST(KIND_UNREACHABLE):
    return "UNREACHABLE";
  case PANIC_CONST(KIND_PANIC):
  default:
    return "PANIC";
  }
}

PACKAGE_PROCEDURE_IMPLEMENT_EX(LIB_PREFIX(Condition_Panic), SetHandler,
                               (PANIC_HANDLER_CALLBACK handler)) {
  PANIC_INS(CustomHandler) = handler;
}

PACKAGE_PROCEDURE_IMPLEMENT_EX(LIB_PREFIX(Condition_Panic), ResetHandler, ()) {
  PANIC_INS(CustomHandler).function = NULL;
  PANIC_INS(CustomHandler).context = NULL;
}

PACKAGE_FUNCTION_IMPLEMENT_EX(LIB_PREFIX(Condition_Panic), PANIC_HANDLER_CALLBACK,
                              GetHandler, ()) {
  return PANIC_INS(CustomHandler);
}

PACKAGE_PROCEDURE_IMPLEMENT_EX(
    LIB_PREFIX(Condition_Panic), Trigger,
    (PANIC_TYPE(Kind) kind, const char *message, const char *expression,
     const char *file, uint32_t line, const char *function)) {
  PANIC_TYPE(Info) info;
  info.kind = kind;
  info.message = message;
  info.expression = expression;
  info.file = file;
  info.line = line;
  info.function = function;

  if (CALLBACK_IS_VALID(PANIC_INS(CustomHandler))) {
    CALLBACK_INVOKE(PANIC_INS(CustomHandler), &info);
    return;
  }

  fprintf(stderr, "\n*** PANIC [%s] ***\n",
          NS(LIB_PREFIX(Condition_Panic), KindName)(kind));
  fprintf(stderr, "Message:  %s\n", info.message);
  if (info.expression != NULL) {
    fprintf(stderr, "Expr:     %s\n", info.expression);
  }
  fprintf(stderr, "Location: %s:%u (in %s)\n", info.file, info.line,
          info.function);

  DIAGNOSTIC_TYPE(Stacktrace) st;
  NS(DIAGNOSTIC_TYPE(Stacktrace), Init)(&st);
  if (OBJECT_CALL(&st, Capture, 1, 16) == STATUS_CONST(SUCCESS) &&
      OBJECT_CALL_0(&st, FrameCount) > 0) {
    char stBuffer[1024];
    size_t written = 0;
    if (OBJECT_CALL(&st, Format, stBuffer, sizeof(stBuffer), &written) ==
        STATUS_CONST(SUCCESS)) {
      fprintf(stderr, "Stacktrace:\n%s\n", stBuffer);
    }
  }

  fflush(stderr);
  abort();
}

PACKAGE_PROCEDURE_IMPLEMENT_EX(LIB_PREFIX(Condition_Panic), Now,
                               (const char *message)) {
  PANIC(message);
}

PACKAGE_IMPLEMENT(LIB_PREFIX(Condition_Panic));
