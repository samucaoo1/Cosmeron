#pragma once

OBJECT_OPERATION_IMPLEMENT_EX(DIAGNOSTIC_TYPE(Context), Create,
                             (const char *file, uint32_t line,
                              const char *function, const char *description,
                              const void *userData)) {
  if (!self)
    return STATUS_CONST(INVALID_ARGUMENT);
  NS(DIAGNOSTIC_TYPE(Context), Init)(self);
  self->file = file;
  self->line = line;
  self->function = function;
  self->description = description;
  self->userData = userData;
  return STATUS_CONST(SUCCESS);
}

OBJECT_PROCEDURE_IMPLEMENT_EX(DIAGNOSTIC_TYPE(Context), Clear, ()) {
  if (!self)
    return;
  self->file = NULL;
  self->line = 0U;
  self->function = NULL;
  self->description = NULL;
  self->userData = NULL;
}

OBJECT_IMPLEMENT(DIAGNOSTIC_TYPE(Context));
/* EOF */

