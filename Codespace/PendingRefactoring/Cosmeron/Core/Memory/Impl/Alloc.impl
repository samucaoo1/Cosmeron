#pragma once

#include <stdint.h>

PACKAGE_OPERATION_IMPLEMENT_EX(LIB_PREFIX(Memory_Alloc), Bytes, (void *outPointerObject, size_t size)) {
  void *allocated = NULL;

  if (!outPointerObject)
    return STATUS_CONST(INVALID_ARGUMENT);

  if (size == 0U) {
    MEMORY_INS(WritePointer)(outPointerObject, NULL);
    return STATUS_CONST(SUCCESS);
  }

  allocated = malloc(size);
  if (!allocated)
    return STATUS_CONST(OUT_OF_MEMORY);

  MEMORY_INS(WritePointer)(outPointerObject, allocated);
  return STATUS_CONST(SUCCESS);
}

PACKAGE_OPERATION_IMPLEMENT_EX(LIB_PREFIX(Memory_Alloc), ZeroBytes, (void *outPointerObject, size_t size)) {
  void *allocated = NULL;

  if (!outPointerObject)
    return STATUS_CONST(INVALID_ARGUMENT);

  if (size == 0U) {
    MEMORY_INS(WritePointer)(outPointerObject, NULL);
    return STATUS_CONST(SUCCESS);
  }

  allocated = calloc(1U, size);
  if (!allocated)
    return STATUS_CONST(OUT_OF_MEMORY);

  MEMORY_INS(WritePointer)(outPointerObject, allocated);
  return STATUS_CONST(SUCCESS);
}

PACKAGE_OPERATION_IMPLEMENT_EX(LIB_PREFIX(Memory_Alloc), Array, (void *outPointerObject, size_t count, size_t elementSize)) {
  size_t size = 0U;
  OPSTATUS status;

  if (!outPointerObject)
    return STATUS_CONST(INVALID_ARGUMENT);

  status = MEMORY_INS(CheckedMultiplySize)(count, elementSize, &size);
  if (status != STATUS_CONST(SUCCESS))
    return status;

  return ALLOC_FUNC(Bytes)(outPointerObject, size);
}

PACKAGE_OPERATION_IMPLEMENT_EX(LIB_PREFIX(Memory_Alloc), ZeroArray, (void *outPointerObject, size_t count, size_t elementSize)) {
  void *allocated = NULL;

  if (!outPointerObject)
    return STATUS_CONST(INVALID_ARGUMENT);

  if (count == 0U || elementSize == 0U) {
    MEMORY_INS(WritePointer)(outPointerObject, NULL);
    return STATUS_CONST(SUCCESS);
  }

  if (count > SIZE_MAX / elementSize)
    return STATUS_CONST(ARITHMETIC_OVERFLOW);

  allocated = calloc(count, elementSize);
  if (!allocated)
    return STATUS_CONST(OUT_OF_MEMORY);

  MEMORY_INS(WritePointer)(outPointerObject, allocated);
  return STATUS_CONST(SUCCESS);
}

PACKAGE_OPERATION_IMPLEMENT_EX(LIB_PREFIX(Memory_Alloc), ReallocBytes, (void *inoutPointerObject, size_t newSize)) {
  void *current = NULL;
  void *reallocated = NULL;

  if (!inoutPointerObject)
    return STATUS_CONST(INVALID_ARGUMENT);

  current = MEMORY_INS(ReadPointer)(inoutPointerObject);

  if (newSize == 0U) {
    free(current);
    MEMORY_INS(WritePointer)(inoutPointerObject, NULL);
    return STATUS_CONST(SUCCESS);
  }

  reallocated = realloc(current, newSize);
  if (!reallocated)
    return STATUS_CONST(OUT_OF_MEMORY);

  MEMORY_INS(WritePointer)(inoutPointerObject, reallocated);
  return STATUS_CONST(SUCCESS);
}

PACKAGE_OPERATION_IMPLEMENT_EX(LIB_PREFIX(Memory_Alloc), ReallocArray, (void *inoutPointerObject, size_t count, size_t elementSize)) {
  size_t size = 0U;
  OPSTATUS status;

  if (!inoutPointerObject)
    return STATUS_CONST(INVALID_ARGUMENT);

  status = MEMORY_INS(CheckedMultiplySize)(count, elementSize, &size);
  if (status != STATUS_CONST(SUCCESS))
    return status;

  return ALLOC_FUNC(ReallocBytes)(inoutPointerObject, size);
}

PACKAGE_OPERATION_IMPLEMENT_EX(LIB_PREFIX(Memory_Alloc), Free, (void *inoutPointerObject)) {
  void *current = NULL;

  if (!inoutPointerObject)
    return STATUS_CONST(INVALID_ARGUMENT);

  current = MEMORY_INS(ReadPointer)(inoutPointerObject);
  free(current);
  MEMORY_INS(WritePointer)(inoutPointerObject, NULL);
  return STATUS_CONST(SUCCESS);
}

PACKAGE_IMPLEMENT(LIB_PREFIX(Memory_Alloc));

/* EOF */
