/* Implementation included by Mixer.h. */

AUDIO_MIXER_SET_MASTER_VOLUME_PROTOTYPE {
  AUDIO_INS(Player) * state;
  if (player == NULL || player->internal == NULL ||
      !(volume >= 0.0f && volume <= 1.0f))
    return STATUS_CONST(INVALID_ARGUMENT);
  state = (AUDIO_INS(Player) *)player->internal;
  AUDIO_INS(PlayerLockAcquire)(&state->lock);
  state->masterVolume = volume;
  AUDIO_INS(PlayerLockRelease)(&state->lock);
  return STATUS_CONST(SUCCESS);
}

AUDIO_MIXER_SET_VOLUME_PROTOTYPE {
  AUDIO_INS(Player) * state;
  AUDIO_INS(Voice) * value;
  if (player == NULL || player->internal == NULL ||
      !(volume >= 0.0f && volume <= 1.0f))
    return STATUS_CONST(INVALID_ARGUMENT);
  state = (AUDIO_INS(Player) *)player->internal;
  AUDIO_INS(PlayerLockAcquire)(&state->lock);
  value = AUDIO_INS(FindVoice)(player, voice);
  if (value == NULL) {
    AUDIO_INS(PlayerLockRelease)(&state->lock);
    return STATUS_CONST(NOT_FOUND);
  }
  value->volume = volume;
  AUDIO_INS(PlayerLockRelease)(&state->lock);
  return STATUS_CONST(SUCCESS);
}

AUDIO_MIXER_SET_PAN_PROTOTYPE {
  AUDIO_INS(Player) * state;
  AUDIO_INS(Voice) * value;
  if (player == NULL || player->internal == NULL ||
      !(pan >= -1.0f && pan <= 1.0f))
    return STATUS_CONST(INVALID_ARGUMENT);
  state = (AUDIO_INS(Player) *)player->internal;
  AUDIO_INS(PlayerLockAcquire)(&state->lock);
  value = AUDIO_INS(FindVoice)(player, voice);
  if (value == NULL) {
    AUDIO_INS(PlayerLockRelease)(&state->lock);
    return STATUS_CONST(NOT_FOUND);
  }
  value->pan = pan;
  AUDIO_INS(PlayerLockRelease)(&state->lock);
  return STATUS_CONST(SUCCESS);
}
