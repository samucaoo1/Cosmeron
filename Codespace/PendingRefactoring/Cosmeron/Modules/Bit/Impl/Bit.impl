#pragma once

#include "../Bit.space"

#define COSMERON_MACRO_INTERNAL_BIT_MASK_EVEN_ODD_U64 0x5555555555555555ULL
#define COSMERON_MACRO_INTERNAL_BIT_MASK_PAIRS_U64 0x3333333333333333ULL
#define COSMERON_MACRO_INTERNAL_BIT_MASK_NIBBLES_U64 0x0F0F0F0F0F0F0F0FULL
#define COSMERON_MACRO_INTERNAL_BIT_MASK_BYTE_U8 0xFFU

#define TEMPLATE_BIT_IMPLEMENT(SUFFIX, TYPE)                                   \
  PACKAGE_OPERATION_IMPLEMENT_EX(BIT_PKG(SUFFIX), Set,                         \
                                 (TYPE *value, uint8_t bit)) {                 \
    if (value == NULL)                                                         \
      return STATUS_CONST(INVALID_ARGUMENT);                                   \
    if (bit >= (uint8_t)(sizeof(TYPE) * 8U))                                   \
      return STATUS_CONST(OUT_OF_RANGE);                                       \
    *value = (TYPE)(*value | (TYPE)((TYPE)1 << bit));                          \
    return STATUS_CONST(SUCCESS);                                              \
  }                                                                            \
                                                                               \
  PACKAGE_OPERATION_IMPLEMENT_EX(BIT_PKG(SUFFIX), Clear,                       \
                                 (TYPE *value, uint8_t bit)) {                 \
    if (value == NULL)                                                         \
      return STATUS_CONST(INVALID_ARGUMENT);                                   \
    if (bit >= (uint8_t)(sizeof(TYPE) * 8U))                                   \
      return STATUS_CONST(OUT_OF_RANGE);                                       \
    *value = (TYPE)(*value & (TYPE)~(TYPE)((TYPE)1 << bit));                   \
    return STATUS_CONST(SUCCESS);                                              \
  }                                                                            \
                                                                               \
  PACKAGE_OPERATION_IMPLEMENT_EX(BIT_PKG(SUFFIX), Flip,                        \
                                 (TYPE *value, uint8_t bit)) {                 \
    if (value == NULL)                                                         \
      return STATUS_CONST(INVALID_ARGUMENT);                                   \
    if (bit >= (uint8_t)(sizeof(TYPE) * 8U))                                   \
      return STATUS_CONST(OUT_OF_RANGE);                                       \
    *value = (TYPE)(*value ^ (TYPE)((TYPE)1 << bit));                          \
    return STATUS_CONST(SUCCESS);                                              \
  }                                                                            \
                                                                               \
  PACKAGE_PREDICATE_IMPLEMENT_EX(BIT_PKG(SUFFIX), Check,                       \
                                 (TYPE value, uint8_t bit)) {                  \
    return (bit < (uint8_t)(sizeof(TYPE) * 8U)) &&                            \
           ((value & (TYPE)((TYPE)1 << bit)) != 0);                            \
  }                                                                            \
                                                                               \
  PACKAGE_PROCEDURE_IMPLEMENT_EX(BIT_PKG(SUFFIX), MaskSet,                     \
                                 (TYPE *value, TYPE mask)) {                   \
    if (value != NULL)                                                         \
      *value = (TYPE)(*value | mask);                                          \
  }                                                                            \
                                                                               \
  PACKAGE_PROCEDURE_IMPLEMENT_EX(BIT_PKG(SUFFIX), MaskClear,                   \
                                 (TYPE *value, TYPE mask)) {                   \
    if (value != NULL)                                                         \
      *value = (TYPE)(*value & (TYPE)~mask);                                   \
  }                                                                            \
                                                                               \
  PACKAGE_PROCEDURE_IMPLEMENT_EX(BIT_PKG(SUFFIX), MaskFlip,                    \
                                 (TYPE *value, TYPE mask)) {                   \
    if (value != NULL)                                                         \
      *value = (TYPE)(*value ^ mask);                                          \
  }                                                                            \
                                                                               \
  PACKAGE_PREDICATE_IMPLEMENT_EX(BIT_PKG(SUFFIX), MaskCheckAll,                \
                                 (TYPE value, TYPE mask)) {                    \
    return (value & mask) == mask;                                             \
  }                                                                            \
                                                                               \
  PACKAGE_PREDICATE_IMPLEMENT_EX(BIT_PKG(SUFFIX), MaskCheckAny,                \
                                 (TYPE value, TYPE mask)) {                    \
    return (value & mask) != 0;                                                \
  }                                                                            \
                                                                               \
  PACKAGE_FUNCTION_IMPLEMENT_EX(BIT_PKG(SUFFIX), uint64_t, Popcount,           \
                                (TYPE value)) {                                \
    uint64_t temp = (uint64_t)value;                                           \
    temp -= (temp >> 1) & COSMERON_MACRO_INTERNAL_BIT_MASK_EVEN_ODD_U64;       \
    temp = (temp & COSMERON_MACRO_INTERNAL_BIT_MASK_PAIRS_U64) +               \
           ((temp >> 2) & COSMERON_MACRO_INTERNAL_BIT_MASK_PAIRS_U64);         \
    temp = (temp + (temp >> 4)) &                                              \
           COSMERON_MACRO_INTERNAL_BIT_MASK_NIBBLES_U64;                       \
    if (sizeof(TYPE) > 4U)                                                     \
      temp += temp >> 32;                                                      \
    if (sizeof(TYPE) > 2U)                                                     \
      temp += temp >> 16;                                                      \
    if (sizeof(TYPE) > 1U)                                                     \
      temp += temp >> 8;                                                       \
    return temp & COSMERON_MACRO_INTERNAL_BIT_MASK_BYTE_U8;                    \
  }                                                                            \
                                                                               \
  PACKAGE_PREDICATE_IMPLEMENT_EX(BIT_PKG(SUFFIX), IsPowerOfTwo,               \
                                 (TYPE value)) {                               \
    return (value != 0) && ((value & (TYPE)(value - 1)) == 0);                 \
  }                                                                            \
                                                                               \
  PACKAGE_OPERATION_IMPLEMENT_EX(BIT_PKG(SUFFIX), IndexLSB,                   \
                                 (TYPE value, TYPE *outIndex)) {               \
    if (outIndex == NULL)                                                      \
      return STATUS_CONST(INVALID_ARGUMENT);                                   \
    if (value == 0)                                                            \
      return STATUS_CONST(NOT_FOUND);                                          \
    TYPE position = 0;                                                         \
    TYPE temp = value;                                                         \
    while ((temp & (TYPE)1) == 0) {                                            \
      ++position;                                                              \
      temp >>= 1;                                                              \
    }                                                                          \
    *outIndex = position;                                                      \
    return STATUS_CONST(SUCCESS);                                              \
  }                                                                            \
                                                                               \
  PACKAGE_OPERATION_IMPLEMENT_EX(BIT_PKG(SUFFIX), IndexMSB,                   \
                                 (TYPE value, TYPE *outIndex)) {               \
    if (outIndex == NULL)                                                      \
      return STATUS_CONST(INVALID_ARGUMENT);                                   \
    if (value == 0)                                                            \
      return STATUS_CONST(NOT_FOUND);                                          \
    TYPE position = 0;                                                         \
    TYPE temp = value;                                                         \
    while ((temp >>= 1) != 0)                                                  \
      ++position;                                                              \
    *outIndex = position;                                                      \
    return STATUS_CONST(SUCCESS);                                              \
  }                                                                            \
                                                                               \
  PACKAGE_FUNCTION_IMPLEMENT_EX(BIT_PKG(SUFFIX), TYPE, RotateLeft,             \
                                (TYPE value, TYPE shift)) {                    \
    const uint8_t totalBits = (uint8_t)(sizeof(TYPE) * 8U);                    \
    shift = (TYPE)(shift % (TYPE)totalBits);                                   \
    if (shift == 0)                                                            \
      return value;                                                            \
    return (TYPE)((value << shift) | (value >> (totalBits - shift)));          \
  }                                                                            \
                                                                               \
  PACKAGE_FUNCTION_IMPLEMENT_EX(BIT_PKG(SUFFIX), TYPE, RotateRight,            \
                                (TYPE value, TYPE shift)) {                    \
    const uint8_t totalBits = (uint8_t)(sizeof(TYPE) * 8U);                    \
    shift = (TYPE)(shift % (TYPE)totalBits);                                   \
    if (shift == 0)                                                            \
      return value;                                                            \
    return (TYPE)((value >> shift) | (value << (totalBits - shift)));          \
  }                                                                            \
                                                                               \
  PACKAGE_OPERATION_IMPLEMENT_EX(                                              \
      BIT_PKG(SUFFIX), Extract,                                                \
      (TYPE value, uint8_t high, uint8_t low, TYPE *outField)) {               \
    const uint8_t totalBits = (uint8_t)(sizeof(TYPE) * 8U);                    \
    if (outField == NULL)                                                      \
      return STATUS_CONST(INVALID_ARGUMENT);                                   \
    if (high < low || low >= totalBits || high >= totalBits)                   \
      return STATUS_CONST(OUT_OF_RANGE);                                       \
    uint8_t width = (uint8_t)(high - low + 1U);                                \
    TYPE result;                                                               \
    if (width == totalBits) {                                                  \
      result = value;                                                          \
    } else {                                                                   \
      TYPE mask = (TYPE)(((TYPE)1 << width) - (TYPE)1);                        \
      result = (TYPE)((value >> low) & mask);                                  \
    }                                                                          \
    *outField = result;                                                        \
    return STATUS_CONST(SUCCESS);                                              \
  }                                                                            \
                                                                               \
  PACKAGE_OPERATION_IMPLEMENT_EX(                                              \
      BIT_PKG(SUFFIX), Insert,                                                 \
      (TYPE *value, uint8_t high, uint8_t low, TYPE fieldValue)) {             \
    const uint8_t totalBits = (uint8_t)(sizeof(TYPE) * 8U);                    \
    if (value == NULL)                                                         \
      return STATUS_CONST(INVALID_ARGUMENT);                                   \
    if (high < low || low >= totalBits || high >= totalBits)                   \
      return STATUS_CONST(OUT_OF_RANGE);                                       \
    uint8_t width = (uint8_t)(high - low + 1U);                                \
    if (width == totalBits) {                                                  \
      *value = fieldValue;                                                     \
      return STATUS_CONST(SUCCESS);                                            \
    }                                                                          \
    TYPE mask = (TYPE)(((TYPE)1 << width) - (TYPE)1);                          \
    fieldValue = (TYPE)(fieldValue & mask);                                    \
    TYPE shiftedMask = (TYPE)(mask << low);                                    \
    TYPE cleared = (TYPE)(*value & (TYPE)~shiftedMask);                        \
    *value = (TYPE)(cleared | (TYPE)(fieldValue << low));                      \
    return STATUS_CONST(SUCCESS);                                              \
  }                                                                            \
  PACKAGE_IMPLEMENT(BIT_PKG(SUFFIX));
/* EOF */
