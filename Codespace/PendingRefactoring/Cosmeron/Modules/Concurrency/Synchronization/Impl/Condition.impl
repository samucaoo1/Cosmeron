#pragma once

#if OS_POSIX
CONDITION_INIT_PROTOTYPE { if (condition == NULL) return STATUS_CONST(INVALID_ARGUMENT); return pthread_cond_init(&condition->native, NULL) == 0 ? STATUS_CONST(SUCCESS) : STATUS_CONST(GENERIC_ERROR); }
CONDITION_DESTROY_PROTOTYPE { if (condition == NULL) return STATUS_CONST(INVALID_ARGUMENT); return pthread_cond_destroy(&condition->native) == 0 ? STATUS_CONST(SUCCESS) : STATUS_CONST(BUSY); }
CONDITION_WAIT_PROTOTYPE { if (condition == NULL || mutex == NULL) return STATUS_CONST(INVALID_ARGUMENT); return pthread_cond_wait(&condition->native, &mutex->native) == 0 ? STATUS_CONST(SUCCESS) : STATUS_CONST(GENERIC_ERROR); }
CONDITION_NOTIFY_ONE_PROTOTYPE { if (condition == NULL) return STATUS_CONST(INVALID_ARGUMENT); return pthread_cond_signal(&condition->native) == 0 ? STATUS_CONST(SUCCESS) : STATUS_CONST(GENERIC_ERROR); }
CONDITION_NOTIFY_ALL_PROTOTYPE { if (condition == NULL) return STATUS_CONST(INVALID_ARGUMENT); return pthread_cond_broadcast(&condition->native) == 0 ? STATUS_CONST(SUCCESS) : STATUS_CONST(GENERIC_ERROR); }
#elif OS_WINDOWS
CONDITION_INIT_PROTOTYPE { if (condition == NULL) return STATUS_CONST(INVALID_ARGUMENT); InitializeConditionVariable(&condition->native); return STATUS_CONST(SUCCESS); }
CONDITION_DESTROY_PROTOTYPE { return condition == NULL ? STATUS_CONST(INVALID_ARGUMENT) : STATUS_CONST(SUCCESS); }
CONDITION_WAIT_PROTOTYPE { if (condition == NULL || mutex == NULL) return STATUS_CONST(INVALID_ARGUMENT); return SleepConditionVariableSRW(&condition->native, &mutex->native, INFINITE, 0) != 0 ? STATUS_CONST(SUCCESS) : STATUS_CONST(GENERIC_ERROR); }
CONDITION_NOTIFY_ONE_PROTOTYPE { if (condition == NULL) return STATUS_CONST(INVALID_ARGUMENT); WakeConditionVariable(&condition->native); return STATUS_CONST(SUCCESS); }
CONDITION_NOTIFY_ALL_PROTOTYPE { if (condition == NULL) return STATUS_CONST(INVALID_ARGUMENT); WakeAllConditionVariable(&condition->native); return STATUS_CONST(SUCCESS); }
#endif
