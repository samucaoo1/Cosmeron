#pragma once

#if OS_POSIX
ONCE_CALL_PROTOTYPE {
  if (once == NULL || function == NULL)
    return STATUS_CONST(INVALID_ARGUMENT);

  return pthread_once(&once->native, function) == 0
             ? STATUS_CONST(SUCCESS)
             : STATUS_CONST(GENERIC_ERROR);
}

#elif OS_WINDOWS
typedef struct CONCURRENCY_INS(OnceCall_InternalType_) {
  CONCURRENCY_TYPE(OnceFunction) function;
} CONCURRENCY_INS(OnceCall_InternalType_);

static inline BOOL CALLBACK CONCURRENCY_INS(OnceCallback)(
    PINIT_ONCE once, PVOID parameter, PVOID *context) {
  CONCURRENCY_INS(OnceCall_InternalType_) *call =
      (CONCURRENCY_INS(OnceCall_InternalType_) *)parameter;

  (void)once;
  (void)context;

  call->function();
  return TRUE;
}

ONCE_CALL_PROTOTYPE {
  CONCURRENCY_INS(OnceCall_InternalType_) call;

  if (once == NULL || function == NULL)
    return STATUS_CONST(INVALID_ARGUMENT);

  call.function = function;
  return InitOnceExecuteOnce(
             &once->native,
             CONCURRENCY_INS(OnceCallback),
             &call,
             NULL) != 0
             ? STATUS_CONST(SUCCESS)
             : STATUS_CONST(GENERIC_ERROR);
}
#endif
