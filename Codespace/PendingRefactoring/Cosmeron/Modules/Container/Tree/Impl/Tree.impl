#pragma once

#include "Iterators.impl"
#include "Lifecycle.impl"
#include "Transplant.impl"
#include "Observers.impl"

/* =============================================================
 * Aggregators — expand all common code for SET or MAP
 * ============================================================= */

#define COSMERON_MACRO_INTERNAL_TREE_COMMON_SET(T, KEY_TYPE, CMP)             \
  COSMERON_MACRO_INTERNAL_TREE_IMPLEMENT_LIFECYCLE(T)                         \
  COSMERON_MACRO_INTERNAL_TREE_IMPLEMENT_OBSERVERS(T, KEY_TYPE, CMP)          \
  COSMERON_MACRO_INTERNAL_TREE_IMPLEMENT_FIND_SET(T, KEY_TYPE)                \
  COSMERON_MACRO_INTERNAL_TREE_IMPLEMENT_ITERATORS(T)                         \
  COSMERON_MACRO_INTERNAL_TREE_IMPLEMENT_CONST_ITERATORS(T)                   \
  COSMERON_MACRO_INTERNAL_TREE_IMPLEMENT_TRANSPLANT(T)

#define COSMERON_MACRO_INTERNAL_TREE_COMMON_MAP(T, KEY_TYPE, VALUE_TYPE, CMP) \
  COSMERON_MACRO_INTERNAL_TREE_IMPLEMENT_LIFECYCLE(T)                         \
  COSMERON_MACRO_INTERNAL_TREE_IMPLEMENT_OBSERVERS(T, KEY_TYPE, CMP)          \
  COSMERON_MACRO_INTERNAL_TREE_IMPLEMENT_FIND_MAP(T, KEY_TYPE, VALUE_TYPE)    \
  COSMERON_MACRO_INTERNAL_TREE_IMPLEMENT_ITERATORS(T)                         \
  COSMERON_MACRO_INTERNAL_TREE_IMPLEMENT_CONST_ITERATORS(T)                   \
  COSMERON_MACRO_INTERNAL_TREE_IMPLEMENT_TRANSPLANT(T)

/* Compatibility aliases */
#define COSMERON_MACRO_INTERNAL_TTREE_COMMON_SET COSMERON_MACRO_INTERNAL_TREE_COMMON_SET
#define COSMERON_MACRO_INTERNAL_TTREE_COMMON_MAP COSMERON_MACRO_INTERNAL_TREE_COMMON_MAP
