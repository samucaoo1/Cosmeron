#pragma once
static inline OPSTATUS FILE_INS(Load)(const char *path, void **outData, size_t *outSize, bool text) {
  FILE_TYPE(TFile) file = {0}; OPSTATUS s, closed;
  unsigned char *data; size_t used = 0, capacity = FILE_CINS(COPY_BLOCK);
  if (!outData || !outSize) return STATUS_CONST(INVALID_ARGUMENT);
  s = FILE_FUNC(Open)(&file, path, FILE_CONST(READ));
  if (s != STATUS_CONST(SUCCESS)) return s;
  data = (unsigned char *)malloc(capacity);
  if (!data) { FILE_FUNC(Close)(&file); return STATUS_CONST(OUT_OF_MEMORY); }
  for (;;) {
    size_t count;
    if (used == capacity) {
      unsigned char *larger;
      if (capacity > SIZE_MAX / 2) { s = STATUS_CONST(OUT_OF_RANGE); break; }
      capacity *= 2; larger = (unsigned char *)realloc(data, capacity);
      if (!larger) { s = STATUS_CONST(OUT_OF_MEMORY); break; }
      data = larger;
    }
    s = FILE_FUNC(Read)(&file, data + used, capacity - used, &count);
    if (s != STATUS_CONST(SUCCESS) || !count) break;
    used += count;
  }
  closed = FILE_FUNC(Close)(&file);
  if (s == STATUS_CONST(SUCCESS)) s = closed;
  if (s != STATUS_CONST(SUCCESS)) { free(data); return s; }
  /* The EOF probe leaves at least one spare byte. */
  if (text) data[used] = '\0';
  *outData = data; *outSize = used; return STATUS_CONST(SUCCESS);
}
FILE_LOAD_PROTOTYPE { return FILE_INS(Load)(path, outData, outSize, false); }
FILE_LOAD_TEXT_PROTOTYPE {
  void *data; size_t size; OPSTATUS s;
  if (!outText || !outSize) return STATUS_CONST(INVALID_ARGUMENT);
  s = FILE_INS(Load)(path, &data, &size, true);
  if (s == STATUS_CONST(SUCCESS)) { *outText = (char *)data; *outSize = size; }
  return s;
}
static inline OPSTATUS FILE_INS(Save)(const char *path, const void *data, size_t size, bool append) {
  FILE_TYPE(TFile) file = {0}; OPSTATUS s, closed;
  if (!data && size) return STATUS_CONST(INVALID_ARGUMENT);
  s = FILE_FUNC(Open)(&file, path, FILE_CONST(WRITE) | FILE_CONST(OPEN_CREATE) |
      (append ? FILE_CONST(APPEND) : FILE_CONST(OPEN_TRUNCATE)));
  if (s != STATUS_CONST(SUCCESS)) return s;
  s = FILE_INS(WriteAll)(&file, data, size); closed = FILE_FUNC(Close)(&file);
  return s == STATUS_CONST(SUCCESS) ? closed : s;
}
FILE_SAVE_PROTOTYPE { return FILE_INS(Save)(path, data, size, false); }
FILE_APPEND_CONTENT_PROTOTYPE { return FILE_INS(Save)(path, data, size, true); }
FILE_SAVE_ATOMIC_PROTOTYPE {
  FILE_TYPE(TFile) file = {0}; OPSTATUS s = STATUS_CONST(ALREADY_EXISTS), closed;
  char *temporary; size_t length; unsigned int attempt; unsigned long process;
  const size_t suffixCapacity = 64;
  if (!FILE_INS(PathValid)(path) || (!data && size)) return STATUS_CONST(INVALID_ARGUMENT);
  length = strlen(path);
  if (length > SIZE_MAX - suffixCapacity) return STATUS_CONST(OUT_OF_RANGE);
  temporary = (char *)malloc(length + suffixCapacity);
  if (!temporary) return STATUS_CONST(OUT_OF_MEMORY);
#ifdef _WIN32
  process = (unsigned long)GetCurrentProcessId();
#else
  process = (unsigned long)getpid();
#endif
  /* Exclusive creation is the arbiter; no shared static counter or rand state. */
  for (attempt = 0; attempt < FILE_CINS(TEMP_ATTEMPTS); ++attempt) {
    int count = snprintf(temporary, length + suffixCapacity, "%s.cosmeron-%lu-%u.tmp", path, process, attempt);
    if (count < 0 || (size_t)count >= length + suffixCapacity) { s = STATUS_CONST(OUT_OF_RANGE); break; }
    s = FILE_FUNC(Open)(&file, temporary, FILE_CONST(WRITE) | FILE_CONST(OPEN_CREATE) | FILE_CONST(EXCLUSIVE));
    if (s != STATUS_CONST(ALREADY_EXISTS)) break;
  }
  if (s != STATUS_CONST(SUCCESS)) { free(temporary); return s; }
  s = FILE_INS(WriteAll)(&file, data, size);
  if (s == STATUS_CONST(SUCCESS)) s = FILE_FUNC(Sync)(&file);
  closed = FILE_FUNC(Close)(&file);
  if (s == STATUS_CONST(SUCCESS)) s = closed;
  if (s == STATUS_CONST(SUCCESS)) s = FILE_FUNC(Move)(temporary, path, true);
  if (s != STATUS_CONST(SUCCESS)) FILE_FUNC(Remove)(temporary);
  free(temporary); return s;
}
