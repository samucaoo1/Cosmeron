#pragma once

#include "../Sort.space"

PACKAGE_OPERATION_IMPLEMENT_EX(LIB_PREFIX(SORT_MOD), Stalin,
    (void *data, size_t count, size_t elementSize, TCALLBACK(Comparison) compare,
     size_t *outCount)) {
  OPSTATUS s = SORT_INS(Validate)(data, count, elementSize, CALLBACK_IS_VALID(compare));
  if (s != STATUS_CONST(SUCCESS))
    return s;
  if (!outCount)
    return STATUS_CONST(INVALID_ARGUMENT);
  unsigned char *a = data;
  size_t kept = count ? 1u : 0u;
  for (size_t i = 1; i < count; ++i) {
    if (CALLBACK_INVOKE(compare, a + (kept - 1) * elementSize,
                        a + i * elementSize) != COMPARISON_CONST(HIGHER)) {
      if (kept != i)
        memmove(a + kept * elementSize, a + i * elementSize, elementSize);
      ++kept;
    }
  }
  *outCount = kept;
  return STATUS_CONST(SUCCESS);
}

static inline uint64_t SORT_INS(NextRandom)(uint64_t *state) {
  uint64_t x = *state;
  x ^= x >> 12;
  x ^= x << 25;
  x ^= x >> 27;
  *state = x;
  return x * UINT64_C(2685821657736338717);
}

static inline bool SORT_INS(IsOrdered)(
    const unsigned char *a, size_t count, size_t size,
    TCALLBACK(Comparison) cmp) {
  for (size_t i = 1; i < count; ++i)
    if (CALLBACK_INVOKE(cmp, a + (i - 1) * size, a + i * size) ==
        COMPARISON_CONST(HIGHER))
      return false;
  return true;
}

PACKAGE_OPERATION_IMPLEMENT_EX(LIB_PREFIX(SORT_MOD), Bogo,
    (void *data, size_t count, size_t elementSize, TCALLBACK(Comparison) compare,
     uint64_t seed, size_t maxSteps)) {
  OPSTATUS s = SORT_INS(Validate)(data, count, elementSize, CALLBACK_IS_VALID(compare));
  if (s != STATUS_CONST(SUCCESS))
    return s;
  unsigned char *a = data;
  uint64_t state = seed ? seed : UINT64_C(0x9e3779b97f4a7c15);
  if (SORT_INS(IsOrdered)(a, count, elementSize, compare))
    return STATUS_CONST(SUCCESS);
  for (size_t step = 0; step < maxSteps; ++step) {
    for (size_t i = count; i > 1; --i) {
      size_t j = (size_t)(SORT_INS(NextRandom)(&state) % i);
      SORT_INS(Swap)(a + (i - 1) * elementSize,
                     a + j * elementSize, elementSize);
    }
    if (SORT_INS(IsOrdered)(a, count, elementSize, compare))
      return STATUS_CONST(SUCCESS);
  }
  return STATUS_CONST(TIMEOUT);
}

PACKAGE_OPERATION_IMPLEMENT_EX(LIB_PREFIX(SORT_MOD), Bozo,
    (void *data, size_t count, size_t elementSize, TCALLBACK(Comparison) compare,
     uint64_t seed, size_t maxSteps)) {
  OPSTATUS s = SORT_INS(Validate)(data, count, elementSize, CALLBACK_IS_VALID(compare));
  if (s != STATUS_CONST(SUCCESS))
    return s;
  unsigned char *a = data;
  uint64_t state = seed ? seed : UINT64_C(0x9e3779b97f4a7c15);
  if (SORT_INS(IsOrdered)(a, count, elementSize, compare))
    return STATUS_CONST(SUCCESS);
  for (size_t step = 0; step < maxSteps; ++step) {
    size_t i = (size_t)(SORT_INS(NextRandom)(&state) % count);
    size_t j = (size_t)(SORT_INS(NextRandom)(&state) % count);
    SORT_INS(Swap)(a + i * elementSize, a + j * elementSize, elementSize);
    if (SORT_INS(IsOrdered)(a, count, elementSize, compare))
      return STATUS_CONST(SUCCESS);
  }
  return STATUS_CONST(TIMEOUT);
}

#define COSMERON_MACRO_INTERNAL_SORT_STOOGE_LIMIT 128u
#define COSMERON_MACRO_INTERNAL_SORT_SLOW_LIMIT   20u

static inline void SORT_INS(StoogeRange)(
    unsigned char *a, size_t lo, size_t hi, size_t size,
    TCALLBACK(Comparison) cmp) {
  if (hi - lo < 2)
    return;
  if (CALLBACK_INVOKE(cmp, a + lo * size, a + (hi - 1) * size) ==
      COMPARISON_CONST(HIGHER))
    SORT_INS(Swap)(a + lo * size, a + (hi - 1) * size, size);
  if (hi - lo > 2) {
    size_t third = (hi - lo) / 3;
    SORT_INS(StoogeRange)(a, lo, hi - third, size, cmp);
    SORT_INS(StoogeRange)(a, lo + third, hi, size, cmp);
    SORT_INS(StoogeRange)(a, lo, hi - third, size, cmp);
  }
}

PACKAGE_OPERATION_IMPLEMENT_EX(LIB_PREFIX(SORT_MOD), Stooge,
    (void *data, size_t count, size_t elementSize, TCALLBACK(Comparison) compare)) {
  OPSTATUS s = SORT_INS(Validate)(data, count, elementSize, CALLBACK_IS_VALID(compare));
  if (s != STATUS_CONST(SUCCESS))
    return s;
  if (count > COSMERON_MACRO_INTERNAL_SORT_STOOGE_LIMIT)
    return STATUS_CONST(OUT_OF_RANGE);
  if (count > 1)
    SORT_INS(StoogeRange)(data, 0, count, elementSize, compare);
  return STATUS_CONST(SUCCESS);
}

static inline void SORT_INS(SlowRange)(
    unsigned char *a, size_t lo, size_t hi, size_t size,
    TCALLBACK(Comparison) cmp) {
  if (hi - lo <= 1)
    return;
  size_t mid = lo + (hi - lo) / 2;
  SORT_INS(SlowRange)(a, lo, mid, size, cmp);
  SORT_INS(SlowRange)(a, mid, hi, size, cmp);
  if (CALLBACK_INVOKE(cmp, a + (mid - 1) * size, a + (hi - 1) * size) ==
      COMPARISON_CONST(HIGHER))
    SORT_INS(Swap)(a + (mid - 1) * size, a + (hi - 1) * size, size);
  SORT_INS(SlowRange)(a, lo, hi - 1, size, cmp);
}

PACKAGE_OPERATION_IMPLEMENT_EX(LIB_PREFIX(SORT_MOD), Slow,
    (void *data, size_t count, size_t elementSize, TCALLBACK(Comparison) compare)) {
  OPSTATUS s = SORT_INS(Validate)(data, count, elementSize, CALLBACK_IS_VALID(compare));
  if (s != STATUS_CONST(SUCCESS))
    return s;
  if (count > COSMERON_MACRO_INTERNAL_SORT_SLOW_LIMIT)
    return STATUS_CONST(OUT_OF_RANGE);
  if (count > 1)
    SORT_INS(SlowRange)(data, 0, count, elementSize, compare);
  return STATUS_CONST(SUCCESS);
}

PACKAGE_OPERATION_IMPLEMENT_EX(LIB_PREFIX(SORT_MOD), Miracle,
    (const void *data, size_t count, size_t elementSize,
     TCALLBACK(Comparison) compare, size_t maxChecks)) {
  OPSTATUS s = SORT_INS(Validate)(data, count, elementSize, CALLBACK_IS_VALID(compare));
  if (s != STATUS_CONST(SUCCESS))
    return s;
  for (size_t i = 0;; ++i) {
    if (SORT_INS(IsOrdered)(data, count, elementSize, compare))
      return STATUS_CONST(SUCCESS);
    if (i == maxChecks)
      break;
  }
  return STATUS_CONST(TIMEOUT);
}

