#pragma once

#include "../Sort.space"

/* ==========================================================================
 * Radix Sort Implementation
 * ========================================================================== */

#define SORT_RADIX_IMPLEMENT_ROW(ROW)                                          \
  PACKAGE_OPERATION_IMPLEMENT_EX(                                              \
      LIB_PREFIX(SORT_MOD),                                                    \
      PP_OP_CAT2(RadixWithBuffer_, SORT_RADIX_GET(SUFFIX, ROW)),                \
      (SORT_RADIX_GET(TYPE, ROW) *data, size_t count, SORT_TYPE(Order) order,   \
       SORT_RADIX_GET(TYPE, ROW) *buffer, size_t bufferCount)) {               \
    if (order != SORT_CONST(ASCENDING) && order != SORT_CONST(DESCENDING))     \
      return STATUS_CONST(INVALID_ARGUMENT);                                   \
    if (count && !data)                                                        \
      return STATUS_CONST(INVALID_ARGUMENT);                                   \
    if (count > SIZE_MAX / sizeof(SORT_RADIX_GET(TYPE, ROW)))                  \
      return STATUS_CONST(ARITHMETIC_OVERFLOW);                                \
    if (count < 2)                                                             \
      return STATUS_CONST(SUCCESS);                                            \
    if (!buffer || bufferCount < count)                                        \
      return STATUS_CONST(INSUFFICIENT_SPACE);                                 \
    typedef SORT_RADIX_GET(TYPE, ROW) T;                                       \
    typedef SORT_RADIX_GET(UNSIGNED, ROW) U;                                   \
    const unsigned bits = SORT_RADIX_GET(BITS, ROW);                           \
    const bool isSigned = SORT_RADIX_GET(SIGNED, ROW);                         \
    T *source = data, *target = buffer;                                        \
    for (unsigned shift = 0; shift < bits; shift += 8u) {                      \
      size_t buckets[256] = {0};                                               \
      for (size_t i = 0; i < count; ++i) {                                     \
        U key = (U)source[i];                                                  \
        if (isSigned)                                                          \
          key ^= (U)1 << (bits - 1u);                                          \
        if (order == SORT_CONST(DESCENDING))                                   \
          key = ~key;                                                          \
        ++buckets[(unsigned)((key >> shift) & (U)255)];                        \
      }                                                                        \
      size_t offset = 0;                                                       \
      for (size_t i = 0; i < 256; ++i) {                                       \
        size_t frequency = buckets[i];                                         \
        buckets[i] = offset;                                                   \
        offset += frequency;                                                   \
      }                                                                        \
      for (size_t i = 0; i < count; ++i) {                                     \
        U key = (U)source[i];                                                  \
        if (isSigned)                                                          \
          key ^= (U)1 << (bits - 1u);                                          \
        if (order == SORT_CONST(DESCENDING))                                   \
          key = ~key;                                                          \
        target[buckets[(unsigned)((key >> shift) & (U)255)]++] = source[i];    \
      }                                                                        \
      T *swap = source;                                                        \
      source = target;                                                         \
      target = swap;                                                           \
    }                                                                          \
    if (source != data)                                                        \
      memcpy(data, source, count * sizeof(T));                                 \
    return STATUS_CONST(SUCCESS);                                              \
  }                                                                            \
  PACKAGE_OPERATION_IMPLEMENT_EX(                                              \
      LIB_PREFIX(SORT_MOD), PP_OP_CAT2(Radix_, SORT_RADIX_GET(SUFFIX, ROW)),  \
      (SORT_RADIX_GET(TYPE, ROW) *data, size_t count,                          \
       SORT_TYPE(Order) order)) {                                              \
    if (order != SORT_CONST(ASCENDING) && order != SORT_CONST(DESCENDING))     \
      return STATUS_CONST(INVALID_ARGUMENT);                                   \
    if (count && !data)                                                        \
      return STATUS_CONST(INVALID_ARGUMENT);                                   \
    if (count > SIZE_MAX / sizeof(SORT_RADIX_GET(TYPE, ROW)))                  \
      return STATUS_CONST(ARITHMETIC_OVERFLOW);                                \
    if (count < 2)                                                             \
      return STATUS_CONST(SUCCESS);                                            \
    void *scratch = NULL;                                                      \
    OPSTATUS status =                                                          \
        ALLOC_FUNC(Array)(&scratch, count, sizeof(SORT_RADIX_GET(TYPE, ROW))); \
    if (status != STATUS_CONST(SUCCESS))                                       \
      return status;                                                           \
    status = SORT_FUNC(                                                        \
        PP_OP_CAT2(RadixWithBuffer_, SORT_RADIX_GET(SUFFIX, ROW)))(            \
        data, count, order, (SORT_RADIX_GET(TYPE, ROW) *)scratch, count);      \
    ALLOC_FUNC(Free)(&scratch);                                                \
    return status;                                                             \
  }

SORT_RADIX_TABLE(SORT_RADIX_IMPLEMENT_ROW)

#undef SORT_RADIX_IMPLEMENT_ROW

/* EOF */
