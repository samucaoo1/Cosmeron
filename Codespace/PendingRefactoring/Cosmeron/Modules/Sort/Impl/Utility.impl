#pragma once

#include "../Sort.space"

PACKAGE_OPERATION_IMPLEMENT_EX(LIB_PREFIX(SORT_MOD), IsSorted,
    (const void *data, size_t count, size_t elementSize,
     TCALLBACK(Comparison) compare, bool *outSorted)) {
  OPSTATUS status =
      SORT_INS(Validate)(data, count, elementSize, CALLBACK_IS_VALID(compare));
  if (status != STATUS_CONST(SUCCESS))
    return status;
  if (!outSorted)
    return STATUS_CONST(INVALID_ARGUMENT);
  bool sorted = true;
  const unsigned char *bytes = data;
  for (size_t i = 1; i < count; ++i) {
    if (CALLBACK_INVOKE(compare, bytes + (i - 1) * elementSize,
                        bytes + i * elementSize) == COMPARISON_CONST(HIGHER)) {
      sorted = false;
      break;
    }
  }
  *outSorted = sorted;
  return STATUS_CONST(SUCCESS);
}

PACKAGE_OPERATION_IMPLEMENT_EX(LIB_PREFIX(SORT_MOD), Reverse,
    (void *data, size_t count, size_t elementSize)) {
  OPSTATUS status = SORT_INS(Validate)(data, count, elementSize, true);
  if (status != STATUS_CONST(SUCCESS))
    return status;
  unsigned char *bytes = data;
  for (size_t i = 0; i < count / 2; ++i)
    SORT_INS(Swap)(bytes + i * elementSize,
                   bytes + (count - i - 1) * elementSize, elementSize);
  return STATUS_CONST(SUCCESS);
}

/* EOF */
