#pragma once

#define COSMERON_MACRO_INTERNAL_TEXT_VIEW_IMPLEMENT(CHAR_TYPE, SUFFIX)        \
  TEXT_VIEW_CREATE_PROTOTYPE(CHAR_TYPE, SUFFIX) {                              \
    TEXT_VIEW_TYPE(SUFFIX) view;                                               \
    view.data = data;                                                          \
    view.size = data == NULL ? 0U : size;                                      \
    return view;                                                               \
  }                                                                            \
                                                                               \
  TEXT_VIEW_FROM_CSTR_PROTOTYPE(CHAR_TYPE, SUFFIX) {                          \
    if (cstr == NULL) {                                                        \
      return TEXT_VIEW_FUNC(SUFFIX, Empty)();                                  \
    }                                                                          \
    size_t len = 0U;                                                           \
    while (cstr[len] != (CHAR_TYPE)0) {                                        \
      ++len;                                                                   \
    }                                                                          \
    return TEXT_VIEW_FUNC(SUFFIX, Create)(cstr, len);                          \
  }                                                                            \
                                                                               \
  TEXT_VIEW_EMPTY_PROTOTYPE(SUFFIX) {                                          \
    TEXT_VIEW_TYPE(SUFFIX) view;                                               \
    view.data = NULL;                                                          \
    view.size = 0U;                                                            \
    return view;                                                               \
  }                                                                            \
                                                                               \
  TEXT_VIEW_LENGTH_PROTOTYPE(SUFFIX) {                                         \
    return view.data != NULL ? view.size : 0U;                                 \
  }                                                                            \
                                                                               \
  TEXT_VIEW_IS_EMPTY_PROTOTYPE(SUFFIX) {                                       \
    return view.data == NULL || view.size == 0U;                               \
  }                                                                            \
                                                                               \
  TEXT_VIEW_DATA_PROTOTYPE(CHAR_TYPE, SUFFIX) {                                \
    return view.data;                                                          \
  }                                                                            \
                                                                               \
  TEXT_VIEW_AT_PROTOTYPE(CHAR_TYPE, SUFFIX) {                                  \
    if (outChar == NULL) {                                                     \
      return STATUS_CONST(INVALID_ARGUMENT);                                   \
    }                                                                          \
    if (view.data == NULL || index >= view.size) {                             \
      return STATUS_CONST(OUT_OF_RANGE);                                       \
    }                                                                          \
    *outChar = &view.data[index];                                              \
    return STATUS_CONST(SUCCESS);                                              \
  }                                                                            \
                                                                               \
  TEXT_VIEW_SLICE_PROTOTYPE(SUFFIX) {                                          \
    if (view.data == NULL || pos >= view.size) {                               \
      return TEXT_VIEW_FUNC(SUFFIX, Empty)();                                  \
    }                                                                          \
    size_t available = view.size - pos;                                        \
    size_t actual = count < available ? count : available;                     \
    return TEXT_VIEW_FUNC(SUFFIX, Create)(view.data + pos, actual);            \
  }                                                                            \
                                                                               \
  TEXT_VIEW_PREFIX_PROTOTYPE(SUFFIX) {                                         \
    return TEXT_VIEW_FUNC(SUFFIX, Slice)(view, 0U, count);                     \
  }                                                                            \
                                                                               \
  TEXT_VIEW_SUFFIX_PROTOTYPE(SUFFIX) {                                         \
    if (view.data == NULL || count == 0U) {                                    \
      return TEXT_VIEW_FUNC(SUFFIX, Empty)();                                  \
    }                                                                          \
    if (count >= view.size) {                                                  \
      return view;                                                             \
    }                                                                          \
    return TEXT_VIEW_FUNC(SUFFIX, Create)(                                     \
        view.data + (view.size - count), count);                               \
  }                                                                            \
                                                                               \
  TEXT_VIEW_COMPARE_PROTOTYPE(SUFFIX) {                                        \
    if (left.data == right.data && left.size == right.size) {                  \
      return COMPARISON_EQUAL_CONST;                                           \
    }                                                                          \
    size_t minLen = left.size < right.size ? left.size : right.size;           \
    if (minLen > 0U && left.data != NULL && right.data != NULL) {              \
      for (size_t i = 0U; i < minLen; ++i) {                                   \
        size_t a = (size_t)(sizeof(CHAR_TYPE) == 1U                            \
                               ? (uint8_t)left.data[i]                         \
                               : left.data[i]);                                \
        size_t b = (size_t)(sizeof(CHAR_TYPE) == 1U                            \
                               ? (uint8_t)right.data[i]                        \
                               : right.data[i]);                               \
        if (a < b) {                                                           \
          return COMPARISON_LOWER_CONST;                                       \
        }                                                                      \
        if (a > b) {                                                           \
          return COMPARISON_HIGHER_CONST;                                      \
        }                                                                      \
      }                                                                        \
    }                                                                          \
    if (left.size < right.size) {                                              \
      return COMPARISON_LOWER_CONST;                                           \
    }                                                                          \
    if (left.size > right.size) {                                              \
      return COMPARISON_HIGHER_CONST;                                          \
    }                                                                          \
    return COMPARISON_EQUAL_CONST;                                             \
  }                                                                            \
                                                                               \
  TEXT_VIEW_EQUAL_PROTOTYPE(SUFFIX) {                                          \
    if (left.data == right.data && left.size == right.size) {                  \
      return true;                                                             \
    }                                                                          \
    if (left.size != right.size) {                                             \
      return false;                                                            \
    }                                                                          \
    if (left.size == 0U) {                                                     \
      return true;                                                             \
    }                                                                          \
    if (left.data == NULL || right.data == NULL) {                             \
      return false;                                                            \
    }                                                                          \
    return memcmp(left.data, right.data, left.size * sizeof(CHAR_TYPE)) == 0;  \
  }                                                                            \
                                                                               \
  TEXT_VIEW_EQUAL_CSTR_PROTOTYPE(CHAR_TYPE, SUFFIX) {                          \
    if (cstr == NULL) {                                                        \
      return view.data == NULL || view.size == 0U;                             \
    }                                                                          \
    TEXT_VIEW_TYPE(SUFFIX) other = TEXT_VIEW_FUNC(SUFFIX, FromCStr)(cstr);     \
    return TEXT_VIEW_FUNC(SUFFIX, Equal)(view, other);                         \
  }                                                                            \
                                                                               \
  TEXT_VIEW_FIND_PROTOTYPE(CHAR_TYPE, SUFFIX) {                                \
    if (outIndex == NULL) {                                                    \
      return STATUS_CONST(INVALID_ARGUMENT);                                   \
    }                                                                          \
    if (view.data == NULL || start >= view.size) {                             \
      return STATUS_CONST(NOT_FOUND);                                          \
    }                                                                          \
    for (size_t i = start; i < view.size; ++i) {                               \
      if (view.data[i] == ch) {                                                \
        *outIndex = i;                                                         \
        return STATUS_CONST(SUCCESS);                                          \
      }                                                                        \
    }                                                                          \
    return STATUS_CONST(NOT_FOUND);                                            \
  }                                                                            \
                                                                               \
  TEXT_VIEW_FIND_VIEW_PROTOTYPE(CHAR_TYPE, SUFFIX) {                           \
    if (outIndex == NULL) {                                                    \
      return STATUS_CONST(INVALID_ARGUMENT);                                   \
    }                                                                          \
    if (needle.size == 0U) {                                                   \
      if (start <= view.size) {                                                \
        *outIndex = start;                                                     \
        return STATUS_CONST(SUCCESS);                                          \
      }                                                                        \
      return STATUS_CONST(NOT_FOUND);                                          \
    }                                                                          \
    if (view.data == NULL || needle.data == NULL || start >= view.size) {      \
      return STATUS_CONST(NOT_FOUND);                                          \
    }                                                                          \
    if (needle.size > view.size - start) {                                     \
      return STATUS_CONST(NOT_FOUND);                                          \
    }                                                                          \
    size_t limit = view.size - needle.size;                                    \
    for (size_t i = start; i <= limit; ++i) {                                  \
      if (memcmp(view.data + i, needle.data,                                   \
                 needle.size * sizeof(CHAR_TYPE)) == 0) {                      \
        *outIndex = i;                                                         \
        return STATUS_CONST(SUCCESS);                                          \
      }                                                                        \
    }                                                                          \
    return STATUS_CONST(NOT_FOUND);                                            \
  }                                                                            \
                                                                               \
  TEXT_VIEW_FIND_CSTR_PROTOTYPE(CHAR_TYPE, SUFFIX) {                           \
    if (needle == NULL) {                                                      \
      return STATUS_CONST(INVALID_ARGUMENT);                                   \
    }                                                                          \
    TEXT_VIEW_TYPE(SUFFIX) needleView =                                        \
        TEXT_VIEW_FUNC(SUFFIX, FromCStr)(needle);                              \
    return TEXT_VIEW_FUNC(SUFFIX, FindView)(view, needleView, start,           \
                                            outIndex);                         \
  }                                                                            \
                                                                               \
  TEXT_VIEW_STARTS_WITH_PROTOTYPE(SUFFIX) {                                    \
    if (prefix.size == 0U) {                                                   \
      return true;                                                             \
    }                                                                          \
    if (view.data == NULL || prefix.data == NULL || view.size < prefix.size) { \
      return false;                                                            \
    }                                                                          \
    return memcmp(view.data, prefix.data,                                      \
                  prefix.size * sizeof(CHAR_TYPE)) == 0;                       \
  }                                                                            \
                                                                               \
  TEXT_VIEW_STARTS_WITH_CSTR_PROTOTYPE(CHAR_TYPE, SUFFIX) {                    \
    if (prefix == NULL) {                                                      \
      return false;                                                            \
    }                                                                          \
    TEXT_VIEW_TYPE(SUFFIX) prefixView =                                        \
        TEXT_VIEW_FUNC(SUFFIX, FromCStr)(prefix);                              \
    return TEXT_VIEW_FUNC(SUFFIX, StartsWith)(view, prefixView);               \
  }                                                                            \
                                                                               \
  TEXT_VIEW_ENDS_WITH_PROTOTYPE(SUFFIX) {                                      \
    if (suffix.size == 0U) {                                                   \
      return true;                                                             \
    }                                                                          \
    if (view.data == NULL || suffix.data == NULL || view.size < suffix.size) { \
      return false;                                                            \
    }                                                                          \
    return memcmp(view.data + (view.size - suffix.size), suffix.data,          \
                  suffix.size * sizeof(CHAR_TYPE)) == 0;                       \
  }                                                                            \
                                                                               \
  TEXT_VIEW_ENDS_WITH_CSTR_PROTOTYPE(CHAR_TYPE, SUFFIX) {                      \
    if (suffix == NULL) {                                                      \
      return false;                                                            \
    }                                                                          \
    TEXT_VIEW_TYPE(SUFFIX) suffixView =                                        \
        TEXT_VIEW_FUNC(SUFFIX, FromCStr)(suffix);                              \
    return TEXT_VIEW_FUNC(SUFFIX, EndsWith)(view, suffixView);                 \
  }

COSMERON_MACRO_INTERNAL_TEXT_VIEW_IMPLEMENT(char, 8)
COSMERON_MACRO_INTERNAL_TEXT_VIEW_IMPLEMENT(TEXT_TYPE(TChar16), 16)
COSMERON_MACRO_INTERNAL_TEXT_VIEW_IMPLEMENT(TEXT_TYPE(TChar32), 32)

#undef COSMERON_MACRO_INTERNAL_TEXT_VIEW_IMPLEMENT

TEXT_VIEW8_VALIDATE_PROTOTYPE {
  if (view.size == 0U) return true;
  if (view.data == NULL) return false;
  return TEXT_UTF8_FUNC(Validate)((const unsigned char *)view.data, view.size);
}

TEXT_VIEW8_COUNT_CODEPOINTS_PROTOTYPE {
  if (outCount == NULL) return STATUS_CONST(INVALID_ARGUMENT);
  if (view.size == 0U) {
    *outCount = 0U;
    return STATUS_CONST(SUCCESS);
  }
  if (view.data == NULL) return STATUS_CONST(INVALID_ARGUMENT);
  size_t units = 0U;
  return TEXT_UTF8_FUNC(Count)(
      (const unsigned char *)view.data, view.size, outCount, &units);
}

TEXT_VIEW8_NEXT_CODEPOINT_PROTOTYPE {
  if (view == NULL || outCodepoint == NULL) {
    return STATUS_CONST(INVALID_ARGUMENT);
  }
  if (view->data == NULL || view->size == 0U) {
    return STATUS_CONST(OUT_OF_RANGE);
  }
  size_t units = 0U;
  OPSTATUS status = TEXT_UTF8_FUNC(Decode)(
      (const unsigned char *)view->data, view->size, outCodepoint, &units);
  if (status != STATUS_CONST(SUCCESS)) {
    return status;
  }
  view->data += units;
  view->size -= units;
  return STATUS_CONST(SUCCESS);
}

TEXT_VIEW8_TRIM_LEFT_PROTOTYPE {
  if (view.data == NULL || view.size == 0U) {
    return view;
  }
  const unsigned char *ptr = (const unsigned char *)view.data;
  size_t remaining = view.size;
  while (remaining > 0U) {
    TEXT_TYPE(TChar32) cp = 0U;
    size_t units = 0U;
    if (TEXT_UTF8_FUNC(Decode)(ptr, remaining, &cp, &units) !=
        STATUS_CONST(SUCCESS)) {
      break;
    }
    if (!TEXT_CODEPOINT_FUNC(IsWhitespace)(cp)) {
      break;
    }
    ptr += units;
    remaining -= units;
  }
  return TEXT_VIEW_FUNC(8, Create)((const char *)ptr, remaining);
}

TEXT_VIEW8_TRIM_RIGHT_PROTOTYPE {
  if (view.data == NULL || view.size == 0U) {
    return view;
  }
  const unsigned char *bytes = (const unsigned char *)view.data;
  size_t end = view.size;
  while (end > 0U) {
    size_t cpStart = end - 1U;
    while (cpStart > 0U && (bytes[cpStart] & 0xC0U) == 0x80U &&
           (end - cpStart) < 4U) {
      --cpStart;
    }
    TEXT_TYPE(TChar32) cp = 0U;
    size_t units = 0U;
    if (TEXT_UTF8_FUNC(Decode)(bytes + cpStart, end - cpStart, &cp, &units) !=
            STATUS_CONST(SUCCESS) ||
        units != (end - cpStart)) {
      break;
    }
    if (!TEXT_CODEPOINT_FUNC(IsWhitespace)(cp)) {
      break;
    }
    end = cpStart;
  }
  return TEXT_VIEW_FUNC(8, Create)(view.data, end);
}

TEXT_VIEW8_TRIM_PROTOTYPE {
  return TEXT_VIEW_FUNC(8, TrimLeft)(TEXT_VIEW_FUNC(8, TrimRight)(view));
}

TEXT_VIEW8_SLICE_CODEPOINTS_PROTOTYPE {
  if (outView == NULL) {
    return STATUS_CONST(INVALID_ARGUMENT);
  }
  if (view.data == NULL && view.size > 0U) {
    return STATUS_CONST(INVALID_ARGUMENT);
  }
  if (codepointCount == 0U) {
    *outView = TEXT_VIEW_FUNC(8, Empty)();
    return STATUS_CONST(SUCCESS);
  }

  const unsigned char *bytes = (const unsigned char *)view.data;
  size_t offset = 0U;
  size_t currentCodepoint = 0U;
  size_t byteStart = 0U;
  bool startFound = false;

  while (offset < view.size) {
    if (currentCodepoint == codepointStart) {
      byteStart = offset;
      startFound = true;
    }
    if (startFound && currentCodepoint == codepointStart + codepointCount) {
      *outView = TEXT_VIEW_FUNC(8, Create)(
          view.data + byteStart, offset - byteStart);
      return STATUS_CONST(SUCCESS);
    }
    TEXT_TYPE(TChar32) cp = 0U;
    size_t units = 0U;
    OPSTATUS status = TEXT_UTF8_FUNC(Decode)(
        bytes + offset, view.size - offset, &cp, &units);
    if (status != STATUS_CONST(SUCCESS)) {
      return status;
    }
    offset += units;
    ++currentCodepoint;
  }

  if (currentCodepoint == codepointStart) {
    byteStart = offset;
    startFound = true;
  }

  if (!startFound) {
    return STATUS_CONST(OUT_OF_RANGE);
  }

  *outView = TEXT_VIEW_FUNC(8, Create)(
      view.data + byteStart, offset - byteStart);
  return STATUS_CONST(SUCCESS);
}
